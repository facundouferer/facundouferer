---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../../i18n/utils';
import { animations } from '../../data/animations';

import ConceptosBasicosJava from '../../components/animaciones/conceptos-basicos-java.astro';
import VariablesTiposDatosJava from '../../components/animaciones/variables-tipos-datos-java.astro';
import ControlFlujoBuclesJava from '../../components/animaciones/control-flujo-bucles-java.astro';
import ArraysStringsJava from '../../components/animaciones/arrays-strings-java.astro';
import HerenciaPolimorfismoJava from '../../components/animaciones/herencia-polimorfismo-java.astro';
import AbstractasInterfacesJava from '../../components/animaciones/abstractas-interfaces-java.astro';
import ExcepcionesJava from '../../components/animaciones/excepciones-java.astro';
import ViajeExcepcionJava from '../../components/animaciones/viaje-excepcion-java.astro';
import ViajeLlamadaPolimorficaJava from '../../components/animaciones/viaje-llamada-polimorfica-java.astro';
import ViajeContratoInterfazJava from '../../components/animaciones/viaje-contrato-interfaz-java.astro';
import ViajeClaveHashmapJava from '../../components/animaciones/viaje-clave-hashmap-java.astro';
import ViajeComparacionOrdenamientoJava from '../../components/animaciones/viaje-comparacion-ordenamiento-java.astro';
import CollectionsGenericosJava from '../../components/animaciones/collections-genericos-java.astro';
import IteradoresOrdenamientoJava from '../../components/animaciones/iteradores-ordenamiento-java.astro';
import MetodosFuncionesJava from '../../components/animaciones/metodos-funciones-java.astro';
import IntroduccionPilaresPooJava from '../../components/animaciones/introduccion-pilares-poo-java.astro';
import ClasesObjetosJava from '../../components/animaciones/clases-objetos-java.astro';
import ConstructoresEncapsulamientoJava from '../../components/animaciones/constructores-encapsulamiento-java.astro';
import ArraysObjetosJava from '../../components/animaciones/arrays-objetos-java.astro';
import TadListasJava from '../../components/animaciones/tad-listas-java.astro';
import TadPilasColasJava from '../../components/animaciones/tad-pilas-colas-java.astro';
import ArbolesBinariosJava from '../../components/animaciones/arboles-binarios-java.astro';
import GrafosJava from '../../components/animaciones/grafos-java.astro';
import ArchivosJarJava from '../../components/animaciones/archivos-jar-java.astro';
import ConcurrenciaHilosJava from '../../components/animaciones/concurrencia-hilos-java.astro';
import JdbcJava from '../../components/animaciones/jdbc-java.astro';
import AlgoritmiaComplejidadJava from '../../components/animaciones/algoritmia-complejidad-java.astro';
import ArbolesNAriosJava from '../../components/animaciones/arboles-n-arios-java.astro';

export function getStaticPaths() {
	return animations.map((animation) => ({
		params: { slug: animation.slug },
	}));
}

const { slug } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const animation = animations.find((entry) => entry.slug === slug);

if (!animation || !slug) {
	throw new Error(`Animation not found for slug: ${slug}`);
}

const componentMap: Record<string, any> = {
	'conceptos-basicos-java': ConceptosBasicosJava,
	'variables-tipos-datos-java': VariablesTiposDatosJava,
	'control-flujo-bucles-java': ControlFlujoBuclesJava,
	'arrays-strings-java': ArraysStringsJava,
	'herencia-polimorfismo-java': HerenciaPolimorfismoJava,
	'abstractas-interfaces-java': AbstractasInterfacesJava,
	'excepciones-java': ExcepcionesJava,
	'viaje-excepcion-java': ViajeExcepcionJava,
	'viaje-llamada-polimorfica-java': ViajeLlamadaPolimorficaJava,
	'viaje-contrato-interfaz-java': ViajeContratoInterfazJava,
	'viaje-clave-hashmap-java': ViajeClaveHashmapJava,
	'viaje-comparacion-ordenamiento-java': ViajeComparacionOrdenamientoJava,
	'collections-genericos-java': CollectionsGenericosJava,
	'iteradores-ordenamiento-java': IteradoresOrdenamientoJava,
	'metodos-funciones-java': MetodosFuncionesJava,
	'introduccion-pilares-poo-java': IntroduccionPilaresPooJava,
	'clases-objetos-java': ClasesObjetosJava,
	'constructores-encapsulamiento-java': ConstructoresEncapsulamientoJava,
	'arrays-objetos-java': ArraysObjetosJava,
	'tad-listas-java': TadListasJava,
	'tad-pilas-colas-java': TadPilasColasJava,
	'arboles-binarios-java': ArbolesBinariosJava,
	'grafos-java': GrafosJava,
	'archivos-jar-java': ArchivosJarJava,
	'concurrencia-hilos-java': ConcurrenciaHilosJava,
	'jdbc-java': JdbcJava,
	'algoritmia-complejidad-java': AlgoritmiaComplejidadJava,
	'arboles-n-arios-java': ArbolesNAriosJava,
};

const AnimationComponent = componentMap[slug];
---

<BaseLayout
	title={`${animation.title[lang]} — Facundo Uferer`}
	description={animation.description[lang]}
	locale={lang}
	esPath={`/animaciones/${slug}`}
	enPath={`/en/animaciones/${slug}`}
	canonicalPath={`/animaciones/${slug}`}
>
	<div class="animation-page">
		<AnimationComponent lang={lang} animation={animation} />
	</div>
</BaseLayout>

<style>
	/* Full-bleed column that fills the viewport below the sticky site header, like the
	   presentation decks, so the player can grow and pin its controls to the bottom. */
	.animation-page {
		display: flex;
		flex-direction: column;
		min-height: calc(100dvh - var(--site-header-height, 0px));
		padding-top: var(--space-4);
		padding-inline: clamp(16px, 3vw, 40px);
	}
</style>
