---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { type Locale } from '../../../i18n/utils';
import { animations } from '../../../data/animations';

import ConceptosBasicosJava from '../../../components/animaciones/conceptos-basicos-java.astro';
import VariablesTiposDatosJava from '../../../components/animaciones/variables-tipos-datos-java.astro';
import ControlFlujoBuclesJava from '../../../components/animaciones/control-flujo-bucles-java.astro';
import ArraysStringsJava from '../../../components/animaciones/arrays-strings-java.astro';

export function getStaticPaths() {
	const paths: Array<{ params: { lang: Locale; slug: string } }> = [];
	const locales: Locale[] = ['es', 'en'];
	for (const lang of locales) {
		for (const animation of animations) {
			paths.push({ params: { lang, slug: animation.slug } });
		}
	}
	return paths;
}

const { lang, slug } = Astro.params as { lang: Locale; slug: string };
const animation = animations.find((entry) => entry.slug === slug);

if (!animation) {
	throw new Error(`Animation not found for slug: ${slug}`);
}

const componentMap: Record<string, any> = {
	'conceptos-basicos-java': ConceptosBasicosJava,
	'variables-tipos-datos-java': VariablesTiposDatosJava,
	'control-flujo-bucles-java': ControlFlujoBuclesJava,
	'arrays-strings-java': ArraysStringsJava,
};

const AnimationComponent = componentMap[slug];
---

<BaseLayout
	title={`${animation.title[lang]} — Facundo Uferer`}
	description={animation.description[lang]}
	locale={lang}
	esPath={`/animaciones/${slug}`}
	enPath={`/en/animaciones/${slug}`}
	canonicalPath={lang === 'en' ? `/en/animaciones/${slug}` : `/animaciones/${slug}`}
>
	<div class="animation-page">
		<AnimationComponent lang={lang} animation={animation} />
	</div>
</BaseLayout>

<style>
	/* Full-bleed column that fills the viewport below the sticky site header, like the
	   presentation decks, so the player can grow and pin its controls to the bottom. */
	.animation-page {
		display: flex;
		flex-direction: column;
		min-height: calc(100dvh - var(--site-header-height, 0px));
		padding-top: var(--space-4);
		padding-inline: clamp(16px, 3vw, 40px);
	}
</style>
