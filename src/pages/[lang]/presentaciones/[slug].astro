---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { type Locale } from '../../../i18n/utils';
import { presentations } from '../../../data/presentations';
import PresentationLessonLink from '../../../components/PresentationLessonLink.astro';

import ArbolesBinarios from '../../../components/presentaciones/arboles-binarios.astro';
import ArreglosEnC from '../../../components/presentaciones/arreglos-en-c.astro';
import BubbleSort from '../../../components/presentaciones/bubble-sort.astro';
import ContarPalabrasCadenasC from '../../../components/presentaciones/contar-palabras-cadenas-c.astro';
import DoWhilePasoAPaso from '../../../components/presentaciones/do-while-paso-a-paso.astro';
import ForAnidadoTablaMultiplicar from '../../../components/presentaciones/for-anidado-tabla-multiplicar.astro';
import ForPasoAPaso from '../../../components/presentaciones/for-paso-a-paso.astro';
import FuncionesYProcedimientosJava from '../../../components/presentaciones/funciones_y_procedimientos_java.astro';
import IfElsePasoAPaso from '../../../components/presentaciones/if-else-paso-a-paso.astro';
import IfPasoAPaso from '../../../components/presentaciones/if-paso-a-paso.astro';
import InsertionSort from '../../../components/presentaciones/insertion-sort.astro';
import ModularidadEnC from '../../../components/presentaciones/modularidad_en_c.astro';
import OperacionesConArreglos from '../../../components/presentaciones/operaciones-con-arreglos.astro';
import PasoPorValorYReferencia from '../../../components/presentaciones/paso_por_valor_y_referencia.astro';
import PilaresPooJava from '../../../components/presentaciones/pilares-poo-java.astro';
import SelectionSort from '../../../components/presentaciones/selection-sort.astro';
import StrchrPasoAPaso from '../../../components/presentaciones/strchr-paso-a-paso.astro';
import StringNumerosPasoAPaso from '../../../components/presentaciones/string-numeros-paso-a-paso.astro';
import StringPasoAPaso from '../../../components/presentaciones/string-paso-a-paso.astro';
import SwitchPasoAPaso from '../../../components/presentaciones/switch-paso-a-paso.astro';
import TiposDeDatosEnJavascript from '../../../components/presentaciones/tipos_de_datos_en_javascript.astro';
import VariablesYConstantes from '../../../components/presentaciones/variables_y_constantes.astro';
import WhilePasoAPaso from '../../../components/presentaciones/while-paso-a-paso.astro';
import ConceptosBasicosJvmJava from '../../../components/presentaciones/conceptos-basicos-jvm-java.astro';
import VariablesTiposDatosOperadoresJava from '../../../components/presentaciones/variables-tipos-datos-operadores-java.astro';
import ControlFlujoBuclesJava from '../../../components/presentaciones/control-flujo-bucles-java.astro';
import ArraysStringsMemoriaJava from '../../../components/presentaciones/arrays-strings-memoria-java.astro';
import FundamentosPooClasesObjetosJava from '../../../components/presentaciones/fundamentos-poo-clases-objetos-java.astro';
import ConstructoresEncapsulamientoJava from '../../../components/presentaciones/constructores-encapsulamiento-java.astro';
import ArraysDeObjetosJava from '../../../components/presentaciones/arrays-de-objetos-java.astro';
import HerenciaPolimorfismoSobrecargaJava from '../../../components/presentaciones/herencia-polimorfismo-sobrecarga-java.astro';
import ClasesAbstractasInterfacesJava from '../../../components/presentaciones/clases-abstractas-interfaces-java.astro';
import ExcepcionesManejoErroresJava from '../../../components/presentaciones/excepciones-manejo-errores-java.astro';
import TadListasEnlazadasJava from '../../../components/presentaciones/tad-listas-enlazadas-java.astro';
import TadPilasColasJava from '../../../components/presentaciones/tad-pilas-colas-java.astro';
import CollectionsFrameworkGenericosJava from '../../../components/presentaciones/collections-framework-genericos-java.astro';
import IteradoresOrdenamientoEqualsHashcodeJava from '../../../components/presentaciones/iteradores-ordenamiento-equals-hashcode-java.astro';
import TadArbolesBinariosBusquedaJava from '../../../components/presentaciones/tad-arboles-binarios-busqueda-java.astro';
import GrafosAlgoritmosJava from '../../../components/presentaciones/grafos-algoritmos-java.astro';
import ArchivosPersistenciaJarJava from '../../../components/presentaciones/archivos-persistencia-jar-java.astro';
import ConcurrenciaHilosPoolsJava from '../../../components/presentaciones/concurrencia-hilos-pools-java.astro';
import AccesoDatosJdbcJava from '../../../components/presentaciones/acceso-datos-jdbc-java.astro';
import TestingJunitSpringBootJava from '../../../components/presentaciones/testing-junit-spring-boot-java.astro';
import AlgoritmiaVerificacionComplejidadJava from '../../../components/presentaciones/algoritmia-verificacion-complejidad-java.astro';
import ArbolesNAriosVectoresJava from '../../../components/presentaciones/arboles-n-arios-vectores-java.astro';
import DepuracionCodigoLimpioJava from '../../../components/presentaciones/depuracion-codigo-limpio-java.astro';
import PaquetesNamespacesJava from '../../../components/presentaciones/paquetes-namespaces-java.astro';

export function getStaticPaths() {
	const paths: Array<{ params: { lang: Locale; slug: string } }> = [];
	const locales: Locale[] = ['es', 'en'];
	for (const lang of locales) {
		for (const p of presentations) {
			paths.push({ params: { lang, slug: p.slug } });
		}
	}
	return paths;
}

const { lang, slug } = Astro.params as { lang: Locale; slug: string };
const pres = presentations.find((p) => p.slug === slug);

if (!pres) {
	throw new Error(`Presentation not found for slug: ${slug}`);
}

const componentMap: Record<string, any> = {
	'arboles-binarios': ArbolesBinarios,
	'arreglos-en-c': ArreglosEnC,
	'bubble-sort': BubbleSort,
	'contar-palabras-cadenas-c': ContarPalabrasCadenasC,
	'do-while-paso-a-paso': DoWhilePasoAPaso,
	'for-anidado-tabla-multiplicar': ForAnidadoTablaMultiplicar,
	'for-paso-a-paso': ForPasoAPaso,
	'funciones_y_procedimientos_java': FuncionesYProcedimientosJava,
	'if-else-paso-a-paso': IfElsePasoAPaso,
	'if-paso-a-paso': IfPasoAPaso,
	'insertion-sort': InsertionSort,
	'modularidad_en_c': ModularidadEnC,
	'operaciones-con-arreglos': OperacionesConArreglos,
	'paso_por_valor_y_referencia': PasoPorValorYReferencia,
	'pilares-poo-java': PilaresPooJava,
	'selection-sort': SelectionSort,
	'strchr-paso-a-paso': StrchrPasoAPaso,
	'string-numeros-paso-a-paso': StringNumerosPasoAPaso,
	'string-paso-a-paso': StringPasoAPaso,
	'switch-paso-a-paso': SwitchPasoAPaso,
	'tipos_de_datos_en_javascript': TiposDeDatosEnJavascript,
	'variables_y_constantes': VariablesYConstantes,
	'while-paso-a-paso': WhilePasoAPaso,
	'conceptos-basicos-jvm-java': ConceptosBasicosJvmJava,
	'variables-tipos-datos-operadores-java': VariablesTiposDatosOperadoresJava,
	'control-flujo-bucles-java': ControlFlujoBuclesJava,
	'arrays-strings-memoria-java': ArraysStringsMemoriaJava,
	'fundamentos-poo-clases-objetos-java': FundamentosPooClasesObjetosJava,
	'constructores-encapsulamiento-java': ConstructoresEncapsulamientoJava,
	'arrays-de-objetos-java': ArraysDeObjetosJava,
	'herencia-polimorfismo-sobrecarga-java': HerenciaPolimorfismoSobrecargaJava,
	'clases-abstractas-interfaces-java': ClasesAbstractasInterfacesJava,
	'excepciones-manejo-errores-java': ExcepcionesManejoErroresJava,
	'tad-listas-enlazadas-java': TadListasEnlazadasJava,
	'tad-pilas-colas-java': TadPilasColasJava,
	'collections-framework-genericos-java': CollectionsFrameworkGenericosJava,
	'iteradores-ordenamiento-equals-hashcode-java': IteradoresOrdenamientoEqualsHashcodeJava,
	'tad-arboles-binarios-busqueda-java': TadArbolesBinariosBusquedaJava,
	'grafos-algoritmos-java': GrafosAlgoritmosJava,
	'archivos-persistencia-jar-java': ArchivosPersistenciaJarJava,
	'concurrencia-hilos-pools-java': ConcurrenciaHilosPoolsJava,
	'acceso-datos-jdbc-java': AccesoDatosJdbcJava,
	'testing-junit-spring-boot-java': TestingJunitSpringBootJava,
	'algoritmia-verificacion-complejidad-java': AlgoritmiaVerificacionComplejidadJava,
	'arboles-n-arios-vectores-java': ArbolesNAriosVectoresJava,
	'depuracion-codigo-limpio-java': DepuracionCodigoLimpioJava,
	'paquetes-namespaces-java': PaquetesNamespacesJava,
};

const PresentationComponent = componentMap[slug];
---

<BaseLayout
	title={`${pres.title[lang]} — Facundo Uferer`}
	description={pres.description[lang]}
	locale={lang}
	esPath={`/presentaciones/${slug}`}
	enPath={`/en/presentaciones/${slug}`}
	canonicalPath={lang === 'en' ? `/en/presentaciones/${slug}` : `/presentaciones/${slug}`}
>
	<div class="presentation-lesson-link-wrap">
		<PresentationLessonLink presentationSlug={pres.slug} locale={lang} />
	</div>
	<PresentationComponent lang={lang} />
</BaseLayout>

<style>
	.presentation-lesson-link-wrap {
		padding: var(--space-3) var(--space-6) 0 var(--space-8);
	}
</style>
