---
import { getCollection, render } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { buildCourseBreadcrumbSchema } from '../../../seo/schema';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LessonsList from '../../../components/LessonsList.astro';
import LessonPresentations from '../../../components/LessonPresentations.astro';
import LessonPresentationsMenu from '../../../components/LessonPresentationsMenu.astro';
import LessonActivitiesAccess from '../../../components/LessonActivitiesAccess.astro';
import { getPresentationCountsForCourse, getPresentationsForLesson } from '../../../data/presentations';
import { getActivitiesForLesson, getActivityCountsForCourse } from '../../../utils/activities';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export async function getStaticPaths() {
	const lessons = await getCollection('lessons');
	const paths = [];

	for (const lesson of lessons) {
		if (lesson.data.published && lesson.data.lang === 'es') {
			paths.push({
				params: { course: lesson.data.course, lesson: lesson.data.slug },
			});
		}
	}

	return paths;
}

const { course: courseSlug, lesson: lessonSlug } = Astro.params;
if (!courseSlug || !lessonSlug) {
	throw new Error('Missing course or lesson slug');
}

const allCourses = await getCollection('courses');
const allLessons = await getCollection('lessons');
const course = allCourses.find((c) => c.data.slug === courseSlug && c.data.published);

const courseLessons = allLessons
	.filter((l) => l.data.course === courseSlug && l.data.lang === 'es' && l.data.published)
	.sort((a, b) => a.data.order - b.data.order);

// Get the lesson: must match course AND slug AND locale
const entry = allLessons.find(
	(l) =>
		l.data.course === courseSlug &&
		l.data.slug === lessonSlug &&
		l.data.lang === 'es' &&
		l.data.published,
);

if (!course || !entry) {
	return Astro.redirect('/cursos');
}

const { Content } = await render(entry);

const prevLesson = courseLessons.find((l) => l.data.order === entry.data.order - 1);
const nextLesson = courseLessons.find((l) => l.data.order === entry.data.order + 1);

const presentationCounts = getPresentationCountsForCourse(courseSlug);
const lessonPresentations = getPresentationsForLesson(courseSlug, lessonSlug);

const allActivities = await getCollection('activities');
const lessonActivities = getActivitiesForLesson(allActivities, courseSlug, lessonSlug, 'es');
const activityCounts = getActivityCountsForCourse(allActivities, courseSlug, 'es');

const schema = buildCourseBreadcrumbSchema({
	locale: 'es',
	courseSlug,
	courseTitle: course.data.title,
	lessonSlug,
	lessonTitle: entry.data.title,
});
---

<BaseLayout
	title={`${entry.data.title} — ${course.data.title}`}
	description={entry.data.description ?? course.data.description}
	locale={lang}
	esPath={`/cursos/${courseSlug}/${lessonSlug}`}
	enPath={`/en/courses/${courseSlug}/${lessonSlug}`}
	canonicalPath={`/cursos/${courseSlug}/${lessonSlug}`}
	schema={schema}
>
	<div class="container lesson-page">
		<button
			type="button"
			class="btn btn-primary mobile-sidebar-toggle elev-md"
			aria-haspopup="dialog"
			aria-expanded="false"
			aria-controls="lesson-sidebar-drawer"
			aria-label={t('courses.mobileNav.openButton')}
			data-mobile-sidebar-toggle
		>
			<svg
				aria-hidden="true"
				xmlns="http://www.w3.org/2000/svg"
				width="20"
				height="20"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2.75"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<line x1="8" y1="6" x2="21" y2="6"></line>
				<line x1="8" y1="12" x2="21" y2="12"></line>
				<line x1="8" y1="18" x2="21" y2="18"></line>
				<line x1="3" y1="6" x2="3.01" y2="6"></line>
				<line x1="3" y1="12" x2="3.01" y2="12"></line>
				<line x1="3" y1="18" x2="3.01" y2="18"></line>
			</svg>
			<span class="mobile-toggle-label">{t('courses.mobileNav.openButton')}</span>
		</button>
		<div class="mobile-sidebar-backdrop" data-mobile-sidebar-backdrop aria-hidden="true"></div>

		<div class="lesson-layout">
			<aside
				class="lesson-sidebar"
				id="lesson-sidebar-drawer"
				role="dialog"
				aria-modal="true"
				aria-label={t('courses.mobileNav.dialogTitle')}
				data-mobile-sidebar-drawer
			>
				<div class="sidebar-header">
					<div class="sidebar-header-titles">
						<span class="sidebar-course-name">{course.data.title}</span>
						<span class="sidebar-course-meta">{course.data.technology} · {course.data.difficulty}</span>
					</div>
					<button
						type="button"
						class="btn btn-ghost sidebar-close-btn"
						aria-label={t('courses.mobileNav.closeButton')}
						data-mobile-sidebar-close
					>
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.75"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<line x1="18" y1="6" x2="6" y2="18"></line>
							<line x1="6" y1="6" x2="18" y2="18"></line>
						</svg>
					</button>
				</div>
				<nav class="sidebar-lessons scroll-organic" aria-label="Lecciones">
					<LessonsList
						lessons={courseLessons.map((l) => ({
							slug: l.data.slug,
							title: l.data.title,
							description: l.data.description,
							order: l.data.order,
							presentationCount: presentationCounts[l.data.slug],
							activityCount: activityCounts[l.data.slug],
						}))}
						courseSlug={courseSlug}
						locale="es"
						currentSlug={lessonSlug}
						variant="list"
					/>
				</nav>
				<a href={`/cursos/${courseSlug}`} class="sidebar-back">
					← {t('courses.backToCourse')}
				</a>
			</aside>

			<main class="lesson-main">
				<article class="article-shell">
					<header>
						<p class="tag tag-accent">{course.data.technology}</p>
						<div class="lesson-title-row">
							<h1 class="section-title">{entry.data.title}</h1>
							{lessonPresentations.length > 0 && (
								<LessonPresentationsMenu presentations={lessonPresentations} locale="es" />
							)}
							{lessonActivities.length > 0 && (
								<LessonActivitiesAccess
									course={courseSlug}
									lesson={lessonSlug}
									count={lessonActivities.length}
									locale="es"
								/>
							)}
						</div>
						<p class="meta">
							{`${t('courses.lesson')} ${entry.data.order}${entry.data.description ? ` · ${entry.data.description}` : ''}`}
						</p>
					</header>
					<div class="article-body">
						<Content />
					</div>
					<LessonPresentations presentations={lessonPresentations} locale="es" />
					<footer class="lesson-footer">
						<nav class="pager" aria-label="Navegación de lecciones">
							{prevLesson && (
								<a class="btn btn-secondary" href={`/cursos/${courseSlug}/${prevLesson.data.slug}`}>
									← {prevLesson.data.title}
								</a>
							)}
							{nextLesson && (
								<a class="btn btn-secondary" href={`/cursos/${courseSlug}/${nextLesson.data.slug}`}>
									{nextLesson.data.title} →
								</a>
							)}
						</nav>
					</footer>
				</article>
			</main>
		</div>
	</div>
</BaseLayout>

<script>
	function setupMobileSidebar() {
		const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-sidebar-toggle]');
		const drawer = document.querySelector<HTMLElement>('[data-mobile-sidebar-drawer]');
		const backdrop = document.querySelector<HTMLElement>('[data-mobile-sidebar-backdrop]');
		const closeBtn = document.querySelector<HTMLButtonElement>('[data-mobile-sidebar-close]');

		if (!toggle || !drawer || !backdrop) return;

		const currentToggle = toggle;
		const currentDrawer = drawer;
		const currentBackdrop = backdrop;

		function openSidebar() {
			currentDrawer.classList.add('is-open');
			currentBackdrop.classList.add('is-open');
			currentToggle.setAttribute('aria-expanded', 'true');
			document.body.style.overflow = 'hidden';
			if (closeBtn) closeBtn.focus();
		}

		function closeSidebar() {
			currentDrawer.classList.remove('is-open');
			currentBackdrop.classList.remove('is-open');
			currentToggle.setAttribute('aria-expanded', 'false');
			document.body.style.overflow = '';
			currentToggle.focus();
		}

		currentToggle.addEventListener('click', () => {
			const isOpen = currentDrawer.classList.contains('is-open');
			if (isOpen) {
				closeSidebar();
			} else {
				openSidebar();
			}
		});

		if (closeBtn) {
			closeBtn.addEventListener('click', closeSidebar);
		}

		currentBackdrop.addEventListener('click', closeSidebar);

		const lessonLinks = currentDrawer.querySelectorAll('a');
		lessonLinks.forEach((link) => {
			link.addEventListener('click', () => {
				closeSidebar();
			});
		});

		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && currentDrawer.classList.contains('is-open')) {
				closeSidebar();
			}
		});
	}

	setupMobileSidebar();
	document.addEventListener('astro:page-load', setupMobileSidebar);
</script>

<style>
	@import '../../../styles/article-body.css';

	.lesson-page {
		padding-block: var(--space-4);
	}

	.lesson-layout {
		display: grid;
		gap: var(--space-6);
		margin-top: var(--space-4);
	}

	/* Floating Action Button for Mobile */
	.mobile-sidebar-toggle {
		position: fixed;
		bottom: var(--space-4);
		right: var(--space-4);
		z-index: 40;
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 44px;
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-full);
		box-shadow: var(--shadow-lg);
		font-weight: 600;
	}

	.mobile-sidebar-backdrop {
		position: fixed;
		inset: 0;
		z-index: 45;
		background: color-mix(in srgb, var(--color-text) 35%, transparent);
		backdrop-filter: blur(4px);
		-webkit-backdrop-filter: blur(4px);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.2s ease;
	}

	.mobile-sidebar-backdrop.is-open {
		opacity: 1;
		pointer-events: auto;
	}

	/* Sidebar base styles */
	.lesson-sidebar {
		background: var(--color-surface);
		border-radius: var(--radius-lg);
		padding: var(--space-4);
		border: 1px solid var(--color-divider);
	}

	.sidebar-header {
		margin-bottom: var(--space-3);
		padding-bottom: var(--space-3);
		border-bottom: 1px solid var(--color-divider);
	}

	.sidebar-course-name {
		display: block;
		font-weight: 700;
		font-size: 1rem;
		font-family: var(--font-heading);
	}

	.sidebar-course-meta {
		display: block;
		font-size: 0.8rem;
		color: color-mix(in srgb, var(--color-text) 60%, transparent);
		margin-top: 0.2rem;
	}

	.sidebar-back {
		display: block;
		margin-top: var(--space-3);
		padding-top: var(--space-3);
		border-top: 1px solid var(--color-divider);
		color: var(--color-accent-700);
		text-decoration: none;
		font-size: 0.85rem;
	}

	.sidebar-back:hover {
		text-decoration: underline;
	}

	/* Main content */
	.lesson-main {
		min-width: 0;
	}

	.lesson-title-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		flex-wrap: wrap;
		margin-bottom: var(--space-2);
	}

	.meta {
		margin: 0;
		color: color-mix(in srgb, var(--color-text) 55%, transparent);
		font-size: 0.85rem;
	}

	.lesson-footer {
		margin-top: var(--space-8);
		padding-top: var(--space-4);
	}

	.pager {
		display: flex;
		justify-content: space-between;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	/* Mobile styles (< 960px) */
	@media (width < 960px) {
		.lesson-sidebar {
			position: fixed;
			inset-inline: var(--space-4);
			bottom: var(--space-4);
			top: auto;
			max-height: min(560px, calc(100dvh - var(--space-12)));
			z-index: 50;
			display: flex;
			flex-direction: column;
			box-shadow: var(--shadow-xl);
			visibility: hidden;
			opacity: 0;
			pointer-events: none;
			transform: translateY(16px);
			transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
		}

		.lesson-sidebar.is-open {
			visibility: visible;
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0);
		}

		.sidebar-header {
			display: flex;
			align-items: flex-start;
			justify-content: space-between;
			gap: var(--space-2);
		}

		.sidebar-close-btn {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-width: 44px;
			min-height: 44px;
			padding: 0;
			color: var(--color-text);
			background: transparent;
			border: none;
			cursor: pointer;
			border-radius: var(--radius-sm);
		}

		.sidebar-close-btn:hover {
			background: var(--color-neutral-200);
		}

		.sidebar-lessons {
			flex: 1;
			overflow-y: auto;
			min-height: 0;
		}
	}

	/* Desktop: sidebar left, content right (>= 960px) */
	@media (width >= 960px) {
		.mobile-sidebar-toggle {
			display: none;
		}

		.mobile-sidebar-backdrop {
			display: none;
		}

		.sidebar-close-btn {
			display: none;
		}

		.lesson-layout {
			grid-template-columns: 300px 1fr;
		}

		.lesson-sidebar {
			position: sticky;
			top: 5.5rem;
			align-self: start;
			max-height: calc(100vh - 7rem - 15px);
			display: flex;
			flex-direction: column;
			visibility: visible;
			opacity: 1;
			pointer-events: auto;
			transform: none;
			box-shadow: none;
			inset: auto;
			z-index: auto;
		}

		/* Only the lesson list scrolls — course name and back link stay put. */
		.sidebar-lessons {
			flex: 1;
			min-height: 0;
			margin-right: calc(var(--space-2) * -1);
		}
	}
</style>