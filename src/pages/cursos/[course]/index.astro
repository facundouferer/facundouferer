---
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
import { getCourseSlugsForLocale, getCoursesForLocale, getLessonsForCourse } from '../../../utils/courses';
import { resolveRoadmap } from '../../../utils/roadmap';
import { buildCourseBreadcrumbSchema } from '../../../seo/schema';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LessonsList from '../../../components/LessonsList.astro';
import CourseRoadmap from '../../../components/CourseRoadmap.astro';
import { withBase } from '../../../utils/withBase';
import { getPresentationCountsForCourse } from '../../../data/presentations';
import { getActivityCountsForCourse } from '../../../utils/activities';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

export async function getStaticPaths() {
	const entries = await getCollection('courses');
	return getCourseSlugsForLocale(entries, 'es').map((slug) => ({ params: { course: slug } }));
}

const courseSlug = Astro.params.course;
if (!courseSlug) {
	throw new Error('Missing course slug');
}

const allCourses = await getCollection('courses');
const allLessons = await getCollection('lessons');
const course = getCoursesForLocale(allCourses, 'es').find((c) => c.data.slug === courseSlug);
if (!course) {
	return Astro.redirect('/cursos');
}

const lessons = getLessonsForCourse(allLessons, courseSlug, 'es');
const roadmap = resolveRoadmap(course.data.roadmap, lessons, 'es', courseSlug);
const presentationCounts = getPresentationCountsForCourse(courseSlug);
const allActivities = await getCollection('activities');
const activityCounts = getActivityCountsForCourse(allActivities, courseSlug, 'es');

const schema = buildCourseBreadcrumbSchema({
	locale: 'es',
	courseSlug,
	courseTitle: course.data.title,
});
---

<BaseLayout
	title={course.data.title}
	description={course.data.description}
	locale={lang}
	esPath={`/cursos/${courseSlug}`}
	enPath={`/en/courses/${courseSlug}`}
	canonicalPath={`/cursos/${courseSlug}`}
	schema={schema}
>
	<div class="container">
		<div class="course-header">
			{course.data.image && (
				<div class="course-logo">
					<img src={withBase(course.data.image)} alt={course.data.title} />
				</div>
			)}
			<div class="course-info">
				<h1 class="course-title">{course.data.title}</h1>
				<p class="course-description">{course.data.description}</p>
				<div class="course-meta">
					<span class="tag tag-accent">{course.data.technology}</span>
					<span class="tag tag-neutral">{course.data.difficulty}</span>
				</div>
			</div>
		</div>

		<CourseRoadmap roadmap={roadmap} locale="es" />

		<section class="lessons-section">
			<h2 class="lessons-heading">{t('courses.lessonsLabel')} ({lessons.length})</h2>
			<LessonsList
				lessons={lessons.map((l) => ({
					slug: l.data.slug,
					title: l.data.title,
					description: l.data.description,
					order: l.data.order,
					presentationCount: presentationCounts[l.data.slug],
					activityCount: activityCounts[l.data.slug],
				}))}
				courseSlug={courseSlug}
				locale="es"
				variant="cards"
			/>
		</section>
	</div>
</BaseLayout>

<style>
	.course-header {
		display: flex;
		gap: var(--space-4);
		align-items: flex-start;
		margin-block: var(--space-4);
	}

	.course-logo {
		width: 120px;
		flex-shrink: 0;
	}

	.course-logo img {
		width: 100%;
		height: auto;
	}

	.course-info {
		flex: 1;
	}

	.course-title {
		margin: 0 0 var(--space-2);
		font-size: 1.8rem;
	}

	.course-description {
		font-size: 1rem;
		margin: 0 0 var(--space-3);
		color: color-mix(in srgb, var(--color-text) 75%, transparent);
	}

	.course-meta {
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.lessons-section {
		margin-block: var(--space-6);
	}

	.lessons-heading {
		font-size: 1.2rem;
		margin: 0 0 var(--space-3);
	}

	@media (width <= 640px) {
		.course-header {
			flex-direction: column;
		}

		.course-logo {
			width: 80px;
		}
	}
</style>
