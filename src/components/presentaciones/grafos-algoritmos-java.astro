---
interface Props {
	lang?: string;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<div class="gr-screen" data-presentation="grafos-algoritmos-java">
	<div class="gr-shell">
		<nav class="gr-nav" aria-label="Controles de navegación">
			<button class="gr-btn" id="grPrevBtn" aria-label="Diapositiva anterior" disabled>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="m15 18-6-6 6-6" />
				</svg>
				<span>{isEs ? 'Anterior' : 'Previous'}</span>
			</button>
			<span class="gr-counter" id="grSlideCounter" aria-live="polite">1 / 6</span>
			<button class="gr-btn" id="grNextBtn" aria-label="Siguiente diapositiva">
				<span>{isEs ? 'Siguiente' : 'Next'}</span>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="m9 18 6-6-6-6" />
				</svg>
			</button>
		</nav>

		<main class="gr-viewport">
			<!-- Slide 1: Lenguaje de los grafos -->
			<section class="gr-slide is-active" data-slide="1">
				<div class="gr-header">
					<span class="gr-kicker">{isEs ? 'Fundamentos Estructurales' : 'Structural Foundations'}</span>
					<h2 class="gr-title">{isEs ? 'El Lenguaje de los Grafos: Vértices y Aristas' : 'The Language of Graphs: Vertices and Edges'}</h2>
					<p class="gr-lead">
						{isEs
							? 'Un grafo G = (V, E) modela relaciones arbitrarias sin jerarquía fija. V son los vértices o nodos; E son las aristas o conexiones.'
							: 'A graph G = (V, E) models arbitrary relationships without fixed hierarchy. V are vertices; E are edges or connections.'}
					</p>
				</div>

				<div class="gr-canvas-card">
					<div class="gr-mode-bar">
						<button class="gr-tab is-active" data-mode="undirected">{isEs ? 'No Dirigido' : 'Undirected'}</button>
						<button class="gr-tab" data-mode="directed">{isEs ? 'Dirigido (Dígrafo)' : 'Directed (Digraph)'}</button>
						<button class="gr-tab" data-mode="weighted">{isEs ? 'Ponderado (Con Pesos)' : 'Weighted'}</button>
					</div>

					<div class="gr-svg-wrap">
						<svg id="grIntroSvg" viewBox="0 0 540 260" class="gr-svg">
							<!-- Edges -->
							<g id="grIntroEdges">
								<!-- A-B -->
								<line x1="120" y1="70" x2="270" y2="50" class="gr-edge" />
								<!-- A-C -->
								<line x1="120" y1="70" x2="160" y2="190" class="gr-edge" />
								<!-- B-D -->
								<line x1="270" y1="50" x2="420" y2="90" class="gr-edge" />
								<!-- C-D -->
								<line x1="160" y1="190" x2="420" y2="90" class="gr-edge" />
								<!-- C-E -->
								<line x1="160" y1="190" x2="330" y2="200" class="gr-edge" />
								<!-- D-E -->
								<line x1="420" y1="90" x2="330" y2="200" class="gr-edge" />
							</g>
							<!-- Arrow markers (visible in directed mode) -->
							<defs>
								<marker id="grArrow" markerWidth="8" markerHeight="8" refX="22" refY="4" orient="auto">
									<polygon points="0 1, 7 4, 0 7" fill="var(--color-accent)" />
								</marker>
							</defs>
							<!-- Weight badges (visible in weighted mode) -->
							<g id="grIntroWeights" style="display: none;">
								<rect x="185" y="48" width="22" height="18" rx="4" class="gr-weight-box" />
								<text x="196" y="61" class="gr-weight-txt">4</text>

								<rect x="130" y="122" width="22" height="18" rx="4" class="gr-weight-box" />
								<text x="141" y="135" class="gr-weight-txt">7</text>

								<rect x="335" y="58" width="22" height="18" rx="4" class="gr-weight-box" />
								<text x="346" y="71" class="gr-weight-txt">2</text>

								<rect x="280" y="130" width="22" height="18" rx="4" class="gr-weight-box" />
								<text x="291" y="143" class="gr-weight-txt">6</text>

								<rect x="235" y="186" width="22" height="18" rx="4" class="gr-weight-box" />
								<text x="246" y="199" class="gr-weight-txt">3</text>

								<rect x="365" y="136" width="22" height="18" rx="4" class="gr-weight-box" />
								<text x="376" y="149" class="gr-weight-txt">5</text>
							</g>
							<!-- Vertices -->
							<g class="gr-nodes">
								<!-- Node A -->
								<g transform="translate(120, 70)" class="gr-node-g">
									<circle r="22" class="gr-node" />
									<text dy="6" class="gr-node-text">A</text>
								</g>
								<!-- Node B -->
								<g transform="translate(270, 50)" class="gr-node-g">
									<circle r="22" class="gr-node" />
									<text dy="6" class="gr-node-text">B</text>
								</g>
								<!-- Node C -->
								<g transform="translate(160, 190)" class="gr-node-g">
									<circle r="22" class="gr-node" />
									<text dy="6" class="gr-node-text">C</text>
								</g>
								<!-- Node D -->
								<g transform="translate(420, 90)" class="gr-node-g">
									<circle r="22" class="gr-node" />
									<text dy="6" class="gr-node-text">D</text>
								</g>
								<!-- Node E -->
								<g transform="translate(330, 200)" class="gr-node-g">
									<circle r="22" class="gr-node" />
									<text dy="6" class="gr-node-text">E</text>
								</g>
							</g>
						</svg>
					</div>

					<div class="gr-info-box" id="grIntroDesc">
						<strong>{isEs ? 'Grafo No Dirigido' : 'Undirected Graph'}:</strong> {isEs ? 'Las conexiones son bidireccionales. (u, v) equivale a (v, u). Redes de amistad o carreteras doble mano.' : 'Connections are bidirectional. (u, v) is identical to (v, u). Friendship networks or two-way roads.'}
					</div>
				</div>
			</section>

			<!-- Slide 2: Matriz vs Lista de Adyacencia -->
			<section class="gr-slide" data-slide="2">
				<div class="gr-header">
					<span class="gr-kicker">{isEs ? 'Estructuras de Memoria' : 'Memory Structures'}</span>
					<h2 class="gr-title">{isEs ? 'Matriz de Adyacencia vs Lista de Adyacencia' : 'Adjacency Matrix vs Adjacency List'}</h2>
					<p class="gr-lead">
						{isEs
							? 'La elección depende de la densidad del grafo. Grafos densos (|E| ≈ |V|²) prefieren matrices; grafos dispersos (|E| ≪ |V|²) optimizan memoria con listas.'
							: 'Representation depends on density. Dense graphs (|E| ≈ |V|²) fit matrices; sparse graphs (|E| ≪ |V|²) save memory with lists.'}
					</p>
				</div>

				<div class="gr-dual-grid">
					<!-- Interactive Graph -->
					<div class="gr-panel">
						<div class="gr-panel-head">
							<strong>{isEs ? 'Grafo de 4 Nodos' : '4-Node Graph'}</strong>
							<span class="gr-pill">{isEs ? 'Click en aristas para activar/desactivar' : 'Click edges to toggle'}</span>
						</div>
						<svg id="grRepSvg" viewBox="0 0 280 200" class="gr-svg">
							<!-- 4 Nodes: 0:A (60,50), 1:B (220,50), 2:C (60,150), 3:D (220,150) -->
							<line id="edge-0-1" x1="60" y1="50" x2="220" y2="50" class="gr-rep-edge is-on" data-u="0" data-v="1" />
							<line id="edge-0-2" x1="60" y1="50" x2="60" y2="150" class="gr-rep-edge is-on" data-u="0" data-v="2" />
							<line id="edge-1-3" x1="220" y1="50" x2="220" y2="150" class="gr-rep-edge is-on" data-u="1" data-v="3" />
							<line id="edge-2-3" x1="60" y1="150" x2="220" y2="150" class="gr-rep-edge is-off" data-u="2" data-v="3" />
							<line id="edge-0-3" x1="60" y1="50" x2="220" y2="150" class="gr-rep-edge is-off" data-u="0" data-v="3" />

							<circle cx="60" cy="50" r="18" class="gr-node" />
							<text x="60" y="55" class="gr-node-text">A (0)</text>

							<circle cx="220" cy="50" r="18" class="gr-node" />
							<text x="220" y="55" class="gr-node-text">B (1)</text>

							<circle cx="60" cy="150" r="18" class="gr-node" />
							<text x="60" y="155" class="gr-node-text">C (2)</text>

							<circle cx="220" cy="150" r="18" class="gr-node" />
							<text x="220" y="155" class="gr-node-text">D (3)</text>
						</svg>
					</div>

					<!-- Memory Viewers -->
					<div class="gr-panel">
						<div class="gr-mode-bar">
							<button class="gr-tab is-active" id="grShowMatrix">{isEs ? 'Matriz boolean[][]' : 'Matrix boolean[][]'}</button>
							<button class="gr-tab" id="grShowList">{isEs ? 'Lista List<List<Integer>>' : 'List List<List<Integer>>'}</button>
						</div>

						<!-- Matrix View -->
						<div id="grMatrixBox" class="gr-repr-content">
							<table class="gr-mat-table">
								<thead>
									<tr>
										<th></th>
										<th>A (0)</th>
										<th>B (1)</th>
										<th>C (2)</th>
										<th>D (3)</th>
									</tr>
								</thead>
								<tbody id="grMatrixBody">
									<!-- Generated by JS -->
								</tbody>
							</table>
							<p class="gr-subtext">{isEs ? 'Espacio: O(V²). Consulta de adyacencia: O(1).' : 'Space: O(V²). Adjacency lookup: O(1).'}</p>
						</div>

						<!-- List View -->
						<div id="grListBox" class="gr-repr-content" style="display: none;">
							<div class="gr-adj-list" id="grAdjListContent">
								<!-- Generated by JS -->
							</div>
							<p class="gr-subtext">{isEs ? 'Espacio: O(V + E). Consulta de adyacencia: O(grado(v)).' : 'Space: O(V + E). Adjacency lookup: O(degree(v)).'}</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Slide 3: BFS (Breadth-First Search) -->
			<section class="gr-slide" data-slide="3">
				<div class="gr-header">
					<span class="gr-kicker">{isEs ? 'Recorridos en Amplitud' : 'Breadth Traversals'}</span>
					<h2 class="gr-title">{isEs ? 'BFS (Breadth-First Search): La Onda Expansiva' : 'BFS (Breadth-First Search): The Expanding Wave'}</h2>
					<p class="gr-lead">
						{isEs
							? 'BFS expande capa por capa desde el origen usando una Cola FIFO. Encuentra el camino mínimo en cantidad de saltos.'
							: 'BFS expands layer by layer from root using a FIFO Queue. Finds the shortest path in number of hops.'}
					</p>
				</div>

				<div class="gr-sim-box">
					<div class="gr-sim-toolbar">
						<button class="gr-action-btn" id="grBfsNextBtn">{isEs ? 'Siguiente Paso (Paso a Paso)' : 'Next Step'}</button>
						<button class="gr-reset-btn" id="grBfsResetBtn">{isEs ? 'Reiniciar' : 'Reset'}</button>
						<span class="gr-state-status" id="grBfsStatus">{isEs ? 'Listo para iniciar BFS desde nodo 0 (A)' : 'Ready to start BFS from node 0 (A)'}</span>
					</div>

					<div class="gr-canvas-split">
						<!-- BFS Graph SVG -->
						<div class="gr-svg-holder">
							<svg id="grBfsSvg" viewBox="0 0 380 230" class="gr-svg">
								<!-- Concentric layers rings -->
								<circle cx="60" cy="115" r="30" class="gr-ring gr-ring-0" />
								<ellipse cx="180" cy="115" rx="45" ry="95" class="gr-ring gr-ring-1" />
								<ellipse cx="300" cy="115" rx="55" ry="105" class="gr-ring gr-ring-2" />

								<!-- Edges -->
								<line x1="60" y1="115" x2="180" y2="50" class="gr-edge-static" />
								<line x1="60" y1="115" x2="180" y2="180" class="gr-edge-static" />
								<line x1="180" y1="50" x2="180" y2="180" class="gr-edge-static" />
								<line x1="180" y1="50" x2="300" y2="50" class="gr-edge-static" />
								<line x1="180" y1="180" x2="300" y2="180" class="gr-edge-static" />
								<line x1="300" y1="50" x2="300" y2="180" class="gr-edge-static" />

								<!-- Nodes: 0:A(60,115), 1:B(180,50), 2:C(180,180), 3:D(300,50), 4:E(300,180) -->
								<g id="grBfsNode0" transform="translate(60, 115)">
									<circle r="18" class="gr-node-bfs is-visited" />
									<text dy="5" class="gr-node-text">A (0)</text>
								</g>
								<g id="grBfsNode1" transform="translate(180, 50)">
									<circle r="18" class="gr-node-bfs" />
									<text dy="5" class="gr-node-text">B (1)</text>
								</g>
								<g id="grBfsNode2" transform="translate(180, 180)">
									<circle r="18" class="gr-node-bfs" />
									<text dy="5" class="gr-node-text">C (2)</text>
								</g>
								<g id="grBfsNode3" transform="translate(300, 50)">
									<circle r="18" class="gr-node-bfs" />
									<text dy="5" class="gr-node-text">D (3)</text>
								</g>
								<g id="grBfsNode4" transform="translate(300, 180)">
									<circle r="18" class="gr-node-bfs" />
									<text dy="5" class="gr-node-text">E (4)</text>
								</g>

								<text x="60" y="25" class="gr-layer-label">Nivel 0</text>
								<text x="180" y="25" class="gr-layer-label">Nivel 1</text>
								<text x="300" y="25" class="gr-layer-label">Nivel 2</text>
							</svg>
						</div>

						<!-- Queue visualizer -->
						<div class="gr-tracker-col">
							<div class="gr-tracker-card">
								<strong class="gr-tracker-title">{isEs ? 'Cola FIFO (Queue<Integer>)' : 'FIFO Queue'}</strong>
								<div class="gr-queue-display" id="grQueueBox">
									<!-- Items added by JS -->
									<div class="gr-q-item is-head">[A]</div>
								</div>
								<div class="gr-legend-row">
									<span class="gr-dot gr-dot-active"></span> {isEs ? 'En proceso' : 'Processing'}
									<span class="gr-dot gr-dot-done"></span> {isEs ? 'Visitado' : 'Visited'}
									<span class="gr-dot gr-dot-pending"></span> {isEs ? 'No visitado' : 'Unvisited'}
								</div>
							</div>

							<div class="gr-tracker-card">
								<strong class="gr-tracker-title">{isEs ? 'Orden de Visita' : 'Visit Order'}</strong>
								<div class="gr-order-track" id="grBfsOrder">
									<span>A</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Slide 4: DFS (Depth-First Search) -->
			<section class="gr-slide" data-slide="4">
				<div class="gr-header">
					<span class="gr-kicker">{isEs ? 'Recorridos en Profundidad' : 'Depth Traversals'}</span>
					<h2 class="gr-title">{isEs ? 'DFS (Depth-First Search): El Hilo de Ariadna' : 'DFS (Depth-First Search): Ariadne’s Thread'}</h2>
					<p class="gr-lead">
						{isEs
							? 'DFS avanza por una rama hasta topar con un callejón sin salida y luego retrocede (backtracking). Utiliza una Pila LIFO o la pila de llamadas (Call Stack).'
							: 'DFS plunges deep into one path until reaching a dead end and then backtracks. Uses a LIFO Stack or the recursion call stack.'}
					</p>
				</div>

				<div class="gr-sim-box">
					<div class="gr-sim-toolbar">
						<button class="gr-action-btn" id="grDfsNextBtn">{isEs ? 'Avanzar / Backtracking' : 'Step / Backtrack'}</button>
						<button class="gr-reset-btn" id="grDfsResetBtn">{isEs ? 'Reiniciar' : 'Reset'}</button>
						<span class="gr-state-status" id="grDfsStatus">{isEs ? 'Listo para explorar en profundidad' : 'Ready to explore depth-first'}</span>
					</div>

					<div class="gr-canvas-split">
						<div class="gr-svg-holder">
							<svg id="grDfsSvg" viewBox="0 0 380 230" class="gr-svg">
								<line id="dfs-e-0-1" x1="60" y1="115" x2="180" y2="50" class="gr-edge-static" />
								<line id="dfs-e-0-2" x1="60" y1="115" x2="180" y2="180" class="gr-edge-static" />
								<line id="dfs-e-1-3" x1="180" y1="50" x2="300" y2="50" class="gr-edge-static" />
								<line id="dfs-e-3-4" x1="300" y1="50" x2="300" y2="180" class="gr-edge-static" />
								<line id="dfs-e-4-2" x1="300" y1="180" x2="180" y2="180" class="gr-edge-static" />

								<g id="grDfsNode0" transform="translate(60, 115)">
									<circle r="18" class="gr-node-dfs is-current" />
									<text dy="5" class="gr-node-text">A (0)</text>
								</g>
								<g id="grDfsNode1" transform="translate(180, 50)">
									<circle r="18" class="gr-node-dfs" />
									<text dy="5" class="gr-node-text">B (1)</text>
								</g>
								<g id="grDfsNode2" transform="translate(180, 180)">
									<circle r="18" class="gr-node-dfs" />
									<text dy="5" class="gr-node-text">C (2)</text>
								</g>
								<g id="grDfsNode3" transform="translate(300, 50)">
									<circle r="18" class="gr-node-dfs" />
									<text dy="5" class="gr-node-text">D (3)</text>
								</g>
								<g id="grDfsNode4" transform="translate(300, 180)">
									<circle r="18" class="gr-node-dfs" />
									<text dy="5" class="gr-node-text">E (4)</text>
								</g>
							</svg>
						</div>

						<div class="gr-tracker-col">
							<div class="gr-tracker-card">
								<strong class="gr-tracker-title">{isEs ? 'Call Stack / Pila LIFO (Stack<Integer>)' : 'Call Stack / LIFO Stack'}</strong>
								<div class="gr-stack-display" id="grStackBox">
									<div class="gr-stack-item is-top">dfs(A)</div>
								</div>
							</div>

							<div class="gr-tracker-card">
								<strong class="gr-tracker-title">{isEs ? 'Acción Actual' : 'Current Action'}</strong>
								<p class="gr-subtext" id="grDfsActionDesc">{isEs ? 'Iniciamos en el nodo raíz A' : 'Starting at root node A'}</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Slide 5: Algoritmo de Dijkstra -->
			<section class="gr-slide" data-slide="5">
				<div class="gr-header">
					<span class="gr-kicker">{isEs ? 'Caminos Mínimos con Pesos' : 'Weighted Shortest Paths'}</span>
					<h2 class="gr-title">{isEs ? 'Algoritmo de Dijkstra: Relajación con PriorityQueue' : 'Dijkstra’s Algorithm: Relaxation with PriorityQueue'}</h2>
					<p class="gr-lead">
						{isEs
							? 'Calcula la distancia mínima desde un nodo origen a todos los demás con pesos no negativos. Voraz (Greedy) con relajación de aristas.'
							: 'Computes single-source shortest paths on non-negative weighted graphs. Greedy paradigm with edge relaxation.'}
					</p>
				</div>

				<div class="gr-dijkstra-grid">
					<!-- Graph SVG with weights -->
					<div class="gr-dijk-canvas">
						<svg id="grDijkSvg" viewBox="0 0 360 210" class="gr-svg">
							<!-- Edges -->
							<!-- A(40,105) -> B(140,40) [4] -->
							<line id="dijk-e-A-B" x1="40" y1="105" x2="140" y2="40" class="gr-dijk-edge" />
							<!-- A(40,105) -> C(140,170) [2] -->
							<line id="dijk-e-A-C" x1="40" y1="105" x2="140" y2="170" class="gr-dijk-edge" />
							<!-- B(140,40) -> C(140,170) [1] -->
							<line id="dijk-e-B-C" x1="140" y1="40" x2="140" y2="170" class="gr-dijk-edge" />
							<!-- B(140,40) -> D(240,40) [5] -->
							<line id="dijk-e-B-D" x1="140" y1="40" x2="240" y2="40" class="gr-dijk-edge" />
							<!-- C(140,170) -> D(240,40) [8] -->
							<line id="dijk-e-C-D" x1="140" y1="170" x2="240" y2="40" class="gr-dijk-edge" />
							<!-- C(140,170) -> E(240,170) [10] -->
							<line id="dijk-e-C-E" x1="140" y1="170" x2="240" y2="170" class="gr-dijk-edge" />
							<!-- D(240,40) -> F(320,105) [2] -->
							<line id="dijk-e-D-F" x1="240" y1="40" x2="320" y2="105" class="gr-dijk-edge" />
							<!-- E(240,170) -> F(320,105) [3] -->
							<line id="dijk-e-E-F" x1="240" y1="170" x2="320" y2="105" class="gr-dijk-edge" />

							<!-- Weights -->
							<text x="80" y="65" class="gr-dijk-w">4</text>
							<text x="80" y="150" class="gr-dijk-w">2</text>
							<text x="148" y="110" class="gr-dijk-w">1</text>
							<text x="190" y="32" class="gr-dijk-w">5</text>
							<text x="180" y="100" class="gr-dijk-w">8</text>
							<text x="190" y="185" class="gr-dijk-w">10</text>
							<text x="285" y="65" class="gr-dijk-w">2</text>
							<text x="285" y="150" class="gr-dijk-w">3</text>

							<!-- Nodes: A, B, C, D, E, F -->
							<g id="dijk-n-A" transform="translate(40, 105)">
								<circle r="16" class="gr-node" />
								<text dy="5" class="gr-node-text">A</text>
							</g>
