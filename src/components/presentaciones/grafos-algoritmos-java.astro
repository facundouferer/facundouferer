		text-align: center;
	}

	@media (min-width: 1440px) { .gr-viewport { zoom: 1.08; } }
	@media (min-width: 1680px) { .gr-viewport { zoom: 1.16; } }
	@media (min-width: 1920px) { .gr-viewport { zoom: 1.25; } }
</style>

<script>
	// Presentation core navigation
	let currentSlide = 1;
	const totalSlides = 6;

	const prevBtn = document.getElementById('grPrevBtn') as HTMLButtonElement;
	const nextBtn = document.getElementById('grNextBtn') as HTMLButtonElement;
	const counter = document.getElementById('grSlideCounter') as HTMLElement;
	const slides = document.querySelectorAll<HTMLElement>('.gr-slide');

	function updateSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;
		slides.forEach((s) => s.classList.remove('is-active'));
		document.querySelector(`.gr-slide[data-slide="${currentSlide}"]`)?.classList.add('is-active');

		if (counter) counter.textContent = `${currentSlide} / ${totalSlides}`;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	prevBtn?.addEventListener('click', () => updateSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => updateSlide(currentSlide + 1));

	// Slide 1: Mode toggles
	const introTabs = document.querySelectorAll<HTMLButtonElement>('.gr-mode-bar .gr-tab');
	const introWeights = document.getElementById('grIntroWeights');
	const introDesc = document.getElementById('grIntroDesc');
	const introEdges = document.querySelectorAll<SVGLineElement>('#grIntroEdges line');

	introTabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			introTabs.forEach((t) => t.classList.remove('is-active'));
			tab.classList.add('is-active');
			const mode = tab.getAttribute('data-mode');

			if (mode === 'undirected') {
				if (introWeights) introWeights.style.display = 'none';
				introEdges.forEach((e) => e.removeAttribute('marker-end'));
				if (introDesc) {
					introDesc.innerHTML = '<strong>Grafo No Dirigido:</strong> Las conexiones son bidireccionales. (u, v) equivale a (v, u). Redes de amistad o carreteras doble mano.';
				}
			} else if (mode === 'directed') {
				if (introWeights) introWeights.style.display = 'none';
				introEdges.forEach((e) => e.setAttribute('marker-end', 'url(#grArrow)'));
				if (introDesc) {
					introDesc.innerHTML = '<strong>Grafo Dirigido (Dígrafo):</strong> Las aristas tienen sentido u → v. Siguiendo en Twitter/Instagram, flujos de tráfico o dependencias de compilación.';
				}
			} else if (mode === 'weighted') {
				if (introWeights) introWeights.style.display = 'block';
				introEdges.forEach((e) => e.removeAttribute('marker-end'));
				if (introDesc) {
					introDesc.innerHTML = '<strong>Grafo Ponderado:</strong> Cada arista tiene un costo numérico (distancia en km, latencia en ms, costo de combustible). Fundamental en Dijkstra.';
				}
			}
		});
	});

	// Slide 2: Matrix vs List
	const matrixBtn = document.getElementById('grShowMatrix');
	const listBtn = document.getElementById('grShowList');
	const matrixBox = document.getElementById('grMatrixBox');
	const listBox = document.getElementById('grListBox');
	const matrixBody = document.getElementById('grMatrixBody');
	const adjListContent = document.getElementById('grAdjListContent');

	// Graph edges adjacency 4x4
	const adjMatrix = [
		[0, 1, 1, 0], // A
		[1, 0, 0, 1], // B
		[1, 0, 0, 0], // C
		[0, 1, 0, 0], // D
	];

	const nodeLabels = ['A', 'B', 'C', 'D'];

	function renderMatrixAndList() {
		if (matrixBody) {
			matrixBody.innerHTML = '';
			for (let i = 0; i < 4; i++) {
				const tr = document.createElement('tr');
				const th = document.createElement('th');
				th.textContent = `${nodeLabels[i]} (${i})`;
				tr.appendChild(th);
				for (let j = 0; j < 4; j++) {
					const td = document.createElement('td');
					td.textContent = String(adjMatrix[i][j]);
					if (adjMatrix[i][j] === 1) td.className = 'gr-mat-cell-1';
					tr.appendChild(td);
				}
				matrixBody.appendChild(tr);
			}
		}

		if (adjListContent) {
			adjListContent.innerHTML = '';
			for (let i = 0; i < 4; i++) {
				const row = document.createElement('div');
				row.className = 'gr-adj-row';
				const nodeSpan = document.createElement('span');
				nodeSpan.className = 'gr-adj-node';
				nodeSpan.textContent = `[${nodeLabels[i]}] ->`;
				row.appendChild(nodeSpan);

				const targetsSpan = document.createElement('div');
				targetsSpan.className = 'gr-adj-targets';
				let hasNeighbors = false;
				for (let j = 0; j < 4; j++) {
					if (adjMatrix[i][j] === 1) {
						hasNeighbors = true;
						const p = document.createElement('span');
						p.className = 'gr-adj-pill';
						p.textContent = `${nodeLabels[j]} (${j})`;
						targetsSpan.appendChild(p);
					}
				}
				if (!hasNeighbors) {
					const p = document.createElement('span');
					p.className = 'gr-adj-pill';
					p.textContent = 'null';
					targetsSpan.appendChild(p);
				}
				row.appendChild(targetsSpan);
				adjListContent.appendChild(row);
			}
		}
	}

	renderMatrixAndList();

	matrixBtn?.addEventListener('click', () => {
		matrixBtn.classList.add('is-active');
		listBtn?.classList.remove('is-active');
		if (matrixBox) matrixBox.style.display = 'block';
		if (listBox) listBox.style.display = 'none';
	});

	listBtn?.addEventListener('click', () => {
		listBtn.classList.add('is-active');
		matrixBtn?.classList.remove('is-active');
		if (matrixBox) matrixBox.style.display = 'none';
		if (listBox) listBox.style.display = 'block';
	});

	document.querySelectorAll<SVGLineElement>('.gr-rep-edge').forEach((line) => {
		line.addEventListener('click', () => {
			const u = parseInt(line.getAttribute('data-u') || '0', 10);
			const v = parseInt(line.getAttribute('data-v') || '0', 10);
			const isOn = line.classList.contains('is-on');

			if (isOn) {
				line.classList.remove('is-on');
				line.classList.add('is-off');
				adjMatrix[u][v] = 0;
				adjMatrix[v][u] = 0;
			} else {
				line.classList.remove('is-off');
				line.classList.add('is-on');
				adjMatrix[u][v] = 1;
				adjMatrix[v][u] = 1;
			}
			renderMatrixAndList();
		});
	});

	// Slide 3: BFS Simulator
	let bfsStep = 0;
	const bfsSteps = [
		{ q: ['A'], visited: [0], current: 0, status: 'Encolamos nodo origen A (Nivel 0)' },
		{ q: ['B', 'C'], visited: [0, 1, 2], current: 0, status: 'Desencolamos A. Vecinos no visitados: B y C (Nivel 1)' },
		{ q: ['C', 'D'], visited: [0, 1, 2, 3], current: 1, status: 'Desencolamos B. Vecino no visitado de B: D (Nivel 2)' },
		{ q: ['D', 'E'], visited: [0, 1, 2, 3, 4], current: 2, status: 'Desencolamos C. Vecino no visitado de C: E (Nivel 2)' },
		{ q: ['E'], visited: [0, 1, 2, 3, 4], current: 3, status: 'Desencolamos D. Todos sus vecinos ya fueron visitados.' },
		{ q: [], visited: [0, 1, 2, 3, 4], current: 4, status: 'Desencolamos E. ¡Cola vacía! BFS completado.' },
	];

	const bfsNextBtn = document.getElementById('grBfsNextBtn');
	const bfsResetBtn = document.getElementById('grBfsResetBtn');
	const bfsStatus = document.getElementById('grBfsStatus');
	const queueBox = document.getElementById('grQueueBox');
	const bfsOrder = document.getElementById('grBfsOrder');

	function renderBfs() {
		const s = bfsSteps[bfsStep];
		if (bfsStatus) bfsStatus.textContent = s.status;

		if (queueBox) {
			queueBox.innerHTML = '';
			if (s.q.length === 0) {
				queueBox.innerHTML = '<span class="gr-subtext">Cola vacía</span>';
			} else {
				s.q.forEach((item, idx) => {
					const div = document.createElement('div');
					div.className = `gr-q-item ${idx === 0 ? 'is-head' : ''}`;
					div.textContent = `[${item}]`;
					queueBox.appendChild(div);
				});
			}
		}

		for (let i = 0; i < 5; i++) {
			const nodeElem = document.querySelector(`#grBfsNode${i} .gr-node-bfs`);
			if (nodeElem) {
				nodeElem.className.baseVal = 'gr-node-bfs';
				if (s.visited.includes(i)) {
					nodeElem.classList.add('is-visited');
				}
				if (s.q.includes(nodeLabels[i])) {
					nodeElem.classList.add('is-queued');
				}
			}
		}

		if (bfsOrder) {
			const orderNodes = ['A', 'B', 'C', 'D', 'E'].slice(0, Math.min(bfsStep + 1, 5));
			bfsOrder.innerHTML = orderNodes.map((n) => `<span>${n}</span>`).join(' → ');
		}
	}

	bfsNextBtn?.addEventListener('click', () => {
		if (bfsStep < bfsSteps.length - 1) {
			bfsStep++;
			renderBfs();
		}
	});

	bfsResetBtn?.addEventListener('click', () => {
		bfsStep = 0;
		renderBfs();
	});

	// Slide 4: DFS Simulator
	let dfsStep = 0;
	const dfsSteps = [
		{ stack: ['dfs(A)'], curr: 0, desc: 'Iniciamos en A (raíz). Llamamos dfs(A)' },
		{ stack: ['dfs(A)', 'dfs(B)'], curr: 1, desc: 'Avanzamos al primer vecino no visitado: B. Llamamos dfs(B)' },
		{ stack: ['dfs(A)', 'dfs(B)', 'dfs(D)'], curr: 3, desc: 'Avanzamos de B hacia D. Llamamos dfs(D)' },
		{ stack: ['dfs(A)', 'dfs(B)', 'dfs(D)', 'dfs(E)'], curr: 4, desc: 'Avanzamos de D hacia E. Llamamos dfs(E)' },
		{ stack: ['dfs(A)', 'dfs(B)', 'dfs(D)', 'dfs(E)', 'dfs(C)'], curr: 2, desc: 'Avanzamos de E hacia C. Llamamos dfs(C)' },
		{ stack: ['dfs(A)', 'dfs(B)', 'dfs(D)', 'dfs(E)'], curr: 4, desc: 'C no tiene más vecinos sin visitar. Desapilamos C (Backtrack a E)' },
		{ stack: [], curr: -1, desc: 'Backtracking sucesivo hasta vaciar el Call Stack. Fin del DFS.' },
	];

	const dfsNextBtn = document.getElementById('grDfsNextBtn');
	const dfsResetBtn = document.getElementById('grDfsResetBtn');
	const dfsStatus = document.getElementById('grDfsStatus');
	const stackBox = document.getElementById('grStackBox');
	const dfsActionDesc = document.getElementById('grDfsActionDesc');

	function renderDfs() {
		const s = dfsSteps[dfsStep];
		if (dfsStatus) dfsStatus.textContent = s.desc;
		if (dfsActionDesc) dfsActionDesc.textContent = s.desc;

		if (stackBox) {
			stackBox.innerHTML = '';
			if (s.stack.length === 0) {
				stackBox.innerHTML = '<span class="gr-subtext">Call Stack vacío</span>';
			} else {
				s.stack.forEach((item, idx) => {
					const div = document.createElement('div');
					div.className = `gr-stack-item ${idx === s.stack.length - 1 ? 'is-top' : ''}`;
					div.textContent = item;
					stackBox.appendChild(div);
				});
			}
		}

		for (let i = 0; i < 5; i++) {
			const nodeElem = document.querySelector(`#grDfsNode${i} .gr-node-dfs`);
			if (nodeElem) {
				nodeElem.className.baseVal = 'gr-node-dfs';
				if (s.curr === i) {
					nodeElem.classList.add('is-current');
				} else if (dfsStep > 0) {
					nodeElem.classList.add('is-done');
				}
			}
		}
	}

	dfsNextBtn?.addEventListener('click', () => {
		if (dfsStep < dfsSteps.length - 1) {
			dfsStep++;
			renderDfs();
		}
	});

	dfsResetBtn?.addEventListener('click', () => {
		dfsStep = 0;
		renderDfs();
	});

	// Slide 5: Dijkstra Simulator
	let dijkStep = 0;
	const dijkstraSteps = [
		{
			pq: '(A, 0)',
			table: [
				{ v: 'A', d: '0', p: '-', s: 'Sí' },
				{ v: 'B', d: '∞', p: '-', s: 'No' },
				{ v: 'C', d: '∞', p: '-', s: 'No' },
				{ v: 'D', d: '∞', p: '-', s: 'No' },
				{ v: 'E', d: '∞', p: '-', s: 'No' },
				{ v: 'F', d: '∞', p: '-', s: 'No' },
			],
			updated: [],
			edges: [],
			msg: 'Extraemos A (dist 0). Relajamos aristas salientes: (A,B peso 4) y (A,C peso 2).',
		},
		{
			pq: '(C, 2), (B, 4)',
			table: [
				{ v: 'A', d: '0', p: '-', s: 'Sí' },
				{ v: 'B', d: '4', p: 'A', s: 'No' },
				{ v: 'C', d: '2', p: 'A', s: 'No' },
				{ v: 'D', d: '∞', p: '-', s: 'No' },
				{ v: 'E', d: '∞', p: '-', s: 'No' },
				{ v: 'F', d: '∞', p: '-', s: 'No' },
			],
			updated: ['B', 'C'],
			edges: ['dijk-e-A-C'],
			msg: 'Menor en PQ es C (dist 2). Extraemos C y cerramos. Relajamos vecinos de C: B(2+1=3 < 4) actualiza B! E(2+10=12).',
		},
		{
			pq: '(B, 3), (D, 8), (E, 12)',
			table: [
				{ v: 'A', d: '0', p: '-', s: 'Sí' },
				{ v: 'B', d: '3', p: 'C', s: 'Sí' },
				{ v: 'C', d: '2', p: 'A', s: 'Sí' },
				{ v: 'D', d: '8', p: 'B', s: 'No' },
				{ v: 'E', d: '12', p: 'C', s: 'No' },
				{ v: 'F', d: '∞', p: '-', s: 'No' },
			],
			updated: ['B', 'D'],
			edges: ['dijk-e-A-C', 'dijk-e-B-C'],
			msg: 'Extraemos B (dist 3). Relajamos vecino D: dist[B] + 5 = 8.',
		},
		{
			pq: '(D, 8), (E, 12)',
			table: [
				{ v: 'A', d: '0', p: '-', s: 'Sí' },
				{ v: 'B', d: '3', p: 'C', s: 'Sí' },
				{ v: 'C', d: '2', p: 'A', s: 'Sí' },
				{ v: 'D', d: '8', p: 'B', s: 'Sí' },
				{ v: 'E', d: '12', p: 'C', s: 'No' },
				{ v: 'F', d: '10', p: 'D', s: 'No' },
			],
			updated: ['D', 'F'],
			edges: ['dijk-e-A-C', 'dijk-e-B-C', 'dijk-e-B-D'],
			msg: 'Extraemos D (dist 8). Relajamos F: dist[D] + 2 = 10. PQ contiene (F, 10), (E, 12).',
		},
		{
			pq: 'Vacía',
			table: [
				{ v: 'A', d: '0', p: '-', s: 'Sí' },
				{ v: 'B', d: '3', p: 'C', s: 'Sí' },
				{ v: 'C', d: '2', p: 'A', s: 'Sí' },
				{ v: 'D', d: '8', p: 'B', s: 'Sí' },
				{ v: 'E', d: '12', p: 'C', s: 'Sí' },
				{ v: 'F', d: '10', p: 'D', s: 'Sí' },
			],
			updated: ['F'],
			edges: ['dijk-e-A-C', 'dijk-e-B-C', 'dijk-e-B-D', 'dijk-e-D-F'],
			msg: 'Extraemos F (dist 10). Reconstrucción de camino mínimo A → C → B → D → F (costo total = 10).',
		},
	];

	const dijkStepBtn = document.getElementById('grDijkStepBtn');
	const dijkResetBtn = document.getElementById('grDijkResetBtn');
	const dijkTableBody = document.getElementById('grDijkTableBody');
	const pqContent = document.getElementById('grPqContent');
	const dijkExplanation = document.getElementById('grDijkExplanation');

	function renderDijkstra() {
		const s = dijkstraSteps[dijkStep];
		if (pqContent) pqContent.textContent = s.pq;
		if (dijkExplanation) dijkExplanation.textContent = s.msg;

		if (dijkTableBody) {
			dijkTableBody.innerHTML = '';
			s.table.forEach((row) => {
				const tr = document.createElement('tr');
				if (s.updated.includes(row.v)) tr.className = 'gr-dijk-updated';
				tr.innerHTML = `
					<td><strong>${row.v}</strong></td>
					<td>${row.d}</td>
					<td>${row.p}</td>
					<td>${row.s}</td>
				`;
				dijkTableBody.appendChild(tr);
			});
		}

		document.querySelectorAll<SVGLineElement>('.gr-dijk-edge').forEach((line) => {
			const id = line.id;
			if (s.edges.includes(id)) {
				line.classList.add('is-path');
			} else {
				line.classList.remove('is-path');
			}
		});
	}

	renderDijkstra();

	dijkStepBtn?.addEventListener('click', () => {
		if (dijkStep < dijkstraSteps.length - 1) {
			dijkStep++;
			renderDijkstra();
		}
	});

	dijkResetBtn?.addEventListener('click', () => {
		dijkStep = 0;
		renderDijkstra();
	});

	// Slide 6: Floyd-Warshall
	const floydMatrices = [
		{
			mat: [
				[0, 4, 11],
				[6, 0, 2],
				[3, '∞', 0],
			],
			note: 'k = 0: Matriz inicial de pesos directos sin intermediarios.',
		},
		{
			mat: [
				[0, 4, 11],
				[6, 0, 2],
				[3, 7, 0],
			],
			note: 'k = A: Evaluamos pasar por A. D[C][B] mejora de ∞ a 3 + 4 = 7.',
		},
		{
			mat: [
				[0, 4, 6],
				[6, 0, 2],
				[3, 7, 0],
			],
			note: 'k = B: Evaluamos pasar por B. D[A][C] mejora de 11 a 4 + 2 = 6.',
		},
		{
			mat: [
				[0, 4, 6],
				[5, 0, 2],
				[3, 7, 0],
			],
			note: 'k = C: Evaluamos pasar por C. D[B][A] mejora de 6 a 2 + 3 = 5. Matriz final óptima.',
		},
	];

	const floydBody = document.getElementById('grFloydBody');
	const floydNote = document.getElementById('grFloydNote');
	const floydTabs = document.querySelectorAll<HTMLButtonElement>('.gr-floyd-controls button');

	function renderFloyd(k: number) {
		const data = floydMatrices[k];
		if (floydBody) {
			floydBody.innerHTML = '';
			const nodes = ['A', 'B', 'C'];
			for (let i = 0; i < 3; i++) {
				const tr = document.createElement('tr');
				const th = document.createElement('th');
				th.textContent = nodes[i];
				tr.appendChild(th);
				for (let j = 0; j < 3; j++) {
					const td = document.createElement('td');
					td.textContent = String(data.mat[i][j]);
					if (i === j) td.style.color = 'var(--color-text-muted)';
					tr.appendChild(td);
				}
				floydBody.appendChild(tr);
			}
		}
		if (floydNote) floydNote.innerHTML = `<strong>Paso ${k}:</strong> ${data.note}`;
	}

	renderFloyd(0);

	floydTabs.forEach((tab, index) => {
		tab.addEventListener('click', () => {
			floydTabs.forEach((t) => t.classList.remove('is-active'));
			tab.classList.add('is-active');
			renderFloyd(index);
		});
	});
</script>
