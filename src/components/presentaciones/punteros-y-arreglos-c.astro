	const assess: AssessItem[] = [
		{
			code: ['int v[5] = {2, 4, 6, 8, 10};', 'int *p = v + 1;', 'printf("%d %d\\n", *p + 1, *(p + 1));'],
			q: { es: '¿Qué imprime este fragmento?', en: 'What does this fragment print?' },
			options: ['6 6', '5 6', '5 5'],
			answer: 1,
			why: { es: '*p + 1 suma al valor (4 + 1 = 5); *(p + 1) primero avanza a v[2] y lee 6.', en: '*p + 1 adds to the value (4 + 1 = 5); *(p + 1) first moves to v[2] and reads 6.' },
		},
		{
			code: {
				es: ['double promedio(const int *v, size_t n);', '', 'int notas[] = {7, 4, 9, 6, 8};', 'size_t n = sizeof notas / sizeof notas[0];', 'double r = promedio(notas, n);'],
				en: ['double average(const int *v, size_t n);', '', 'int grades[] = {7, 4, 9, 6, 8};', 'size_t n = sizeof grades / sizeof grades[0];', 'double r = average(grades, n);'],
			},
			q: { es: 'Con int de 4 bytes y punteros de 8, ¿cuánto vale sizeof v dentro de promedio?', en: 'With 4-byte int and 8-byte pointers, what is sizeof v inside average?' },
			options: ['20', '5', '8'],
			answer: 2,
			why: { es: 'Al pasarlo, el arreglo decae: v es un puntero y sizeof v mide un puntero (8). Por eso n viaja aparte.', en: 'When passed, the array decays: v is a pointer and sizeof v measures a pointer (8). That is why n travels separately.' },
		},
		{
			code: { es: ['int ultimo(const int *v, size_t n) {', '    const int *fin = v + n;', '    return *fin;', '}'], en: ['int last(const int *v, size_t n) {', '    const int *end = v + n;', '    return *end;', '}'] },
			q: { es: 'Esta función debería devolver el último elemento, pero a veces devuelve basura. ¿Cuál es el error?', en: 'This function should return the last element, but sometimes returns garbage. What is the mistake?' },
			options: [
				{ es: 'Calcular v + n ya es comportamiento indefinido.', en: 'Computing v + n is already undefined behavior.' },
				{ es: 'Desreferenciar v + n es comportamiento indefinido: el último elemento está en v + n - 1.', en: 'Dereferencing v + n is undefined behavior: the last element is at v + n - 1.' },
				{ es: 'const int * impide leer los elementos del arreglo.', en: 'const int * prevents reading the array elements.' },
			],
			answer: 1,
			why: { es: 'v + n es el puntero una posición después del final: se puede calcular y comparar, pero no desreferenciar. El último está en v + n - 1 (con n > 0).', en: 'v + n is the pointer one past the end: you may compute and compare it, but not dereference it. The last one is at v + n - 1 (with n > 0).' },
		},
		{
			code: ['int v[6] = {5, 8, 3, 9, 1, 7};', 'int *a = v + 1;', 'int *b = v + 5;', 'printf("%td\\n", b - a);'],
			q: { es: '¿Qué imprime este fragmento?', en: 'What does this fragment print?' },
			options: ['4', '16', '5'],
			answer: 0,
			why: { es: 'Restar punteros del mismo arreglo da elementos, no bytes: 5 - 1 = 4, de tipo ptrdiff_t.', en: 'Subtracting pointers into the same array gives elements, not bytes: 5 - 1 = 4, of type ptrdiff_t.' },
		},
		{
			code: ['int x = 5;', 'int *p = &x;', 'int **pp = &p;', '**pp = 6;', 'printf("%d\\n", x);'],
			q: { es: '¿Qué imprime este fragmento?', en: 'What does this fragment print?' },
			options: ['5', '6', { es: 'La dirección de p', en: 'The address of p' }],
			answer: 1,
			why: { es: '*pp es p y **pp es x: la asignación sigue las dos flechas y cambia x a 6.', en: '*pp is p and **pp is x: the assignment follows both arrows and changes x to 6.' },
		},
		{
			code: { es: ['int a[3] = {1, 2, 3};', '/* ¿cuál de estas líneas es comportamiento indefinido? */'], en: ['int a[3] = {1, 2, 3};', '/* which of these lines is undefined behavior? */'] },
			q: { es: 'Solo una de estas líneas es comportamiento indefinido. ¿Cuál?', en: 'Only one of these lines is undefined behavior. Which one?' },
			options: [
				{ es: 'int *fin = a + 3;', en: 'int *end = a + 3;' },
				{ es: 'for (int *p = a; p < a + 3; p++) {}', en: 'for (int *p = a; p < a + 3; p++) {}' },
				{ es: 'int *antes = a - 1;', en: 'int *before = a - 1;' },
			],
			answer: 2,
			why: { es: 'a + 3 se puede calcular y comparar (el ciclo lo hace); a - 1 es comportamiento indefinido aunque solo se calcule.', en: 'a + 3 may be computed and compared (the loop does it); a - 1 is undefined behavior even if it is only computed.' },
		},
	];

	// ───────── Learn wiring ─────────
	root?.querySelectorAll<HTMLElement>('.pa-slide[data-mode="learn"]').forEach((slide) => {
		const data = learn[Number(slide.dataset.item)];
		const labHost = slide.querySelector<HTMLElement>('[data-lab]');
		const stepHost = slide.querySelector<HTMLElement>('[data-stepper]');
		if (!data || !labHost || !stepHost) return;
		const lab = buildLab(labHost);

		const bar = el('div', 'pa-stepbar');
		const prev = el('button', 'btn btn-secondary', tr('Paso anterior', 'Previous step'));
		const next = el('button', 'btn btn-primary', tr('Siguiente paso', 'Next step'));
		const reset = el('button', 'btn btn-ghost', tr('Reiniciar', 'Restart'));
		[prev, next, reset].forEach((b) => (b.type = 'button'));
		const count = el('span', 'pa-step-count');
		const explain = el('p', 'pa-explain');
		explain.setAttribute('aria-live', 'polite');
		bar.append(prev, next, count, reset);
		stepHost.replaceChildren(bar, explain);

		let step = 0;
		const show = () => {
			const s = data.steps[step];
			render(lab, s, data.codes);
			count.textContent = `${tr('Paso', 'Step')} ${step + 1} / ${data.steps.length}`;
			explain.textContent = txt(s.text);
			prev.disabled = step === 0;
			next.disabled = step === data.steps.length - 1;
		};
		prev.addEventListener('click', () => { if (step > 0) { step--; show(); } });
		next.addEventListener('click', () => { if (step < data.steps.length - 1) { step++; show(); } });
		reset.addEventListener('click', () => { step = 0; show(); });
		show();
	});

	// ───────── Practice wiring ─────────
	root?.querySelectorAll<HTMLElement>('.pa-slide[data-mode="practice"]').forEach((slide) => {
		const item = practice[Number(slide.dataset.item)];
		const labHost = slide.querySelector<HTMLElement>('[data-lab]');
		const host = slide.querySelector<HTMLElement>('[data-practice]');
		const qEl = slide.querySelector<HTMLElement>('[data-q]');
		if (!item || !labHost || !host) return;
		if (qEl) qEl.textContent = txt(item.q);
		const lab = buildLab(labHost);

		const opts = el('div', 'pa-opts');
		opts.setAttribute('role', 'group');
		opts.setAttribute('aria-label', tr('Opciones', 'Options'));
		const feedback = el('p', 'pa-feedback');
		feedback.setAttribute('aria-live', 'polite');
		const actions = el('div', 'pa-actions');
		const play = el('button', 'btn btn-primary', tr('Ver la transición', 'Show the transition'));
		const retry = el('button', 'btn btn-secondary', tr('Intentar de nuevo', 'Try again'));
		play.type = 'button';
		retry.type = 'button';
		actions.append(play, retry);
		host.replaceChildren(opts, feedback, actions);

		const buttons = item.options.map((o) => {
			const b = el('button', 'pa-opt', txt(o.t));
			b.type = 'button';
			b.addEventListener('click', () => {
				buttons.forEach((x, i) => {
					x.disabled = true;
					if (item.options[i].ok) x.classList.add('is-right');
				});
				if (!o.ok) b.classList.add('is-wrong');
				feedback.textContent = `${o.ok ? '' : tr('No es así. ', 'Not quite. ')}${txt(o.why)}`;
				play.disabled = false;
			});
			return b;
		});
		opts.replaceChildren(...buttons);

		const start = () => {
			buttons.forEach((b) => {
				b.disabled = false;
				b.classList.remove('is-right', 'is-wrong');
			});
			feedback.textContent = '';
			play.disabled = true;
			render(lab, item.before, item.codes);
		};
		play.addEventListener('click', () => {
			render(lab, item.after, item.codes);
			play.disabled = true;
		});
		retry.addEventListener('click', start);
		start();
	});

	// ───────── Assess wiring ─────────
	const picks: (number | null)[] = assess.map(() => null);
	const assessButtons: HTMLButtonElement[][] = [];
	root?.querySelectorAll<HTMLElement>('.pa-slide[data-mode="assess"]').forEach((slide) => {
		const idx = Number(slide.dataset.item);
		const item = assess[idx];
		const host = slide.querySelector<HTMLElement>('[data-assess]');
		const qEl = slide.querySelector<HTMLElement>('[data-q]');
		if (!item || !host) return;
		if (qEl) qEl.textContent = txt(item.q);
		const pre = el('pre', 'pa-code pa-assess-code');
		pre.replaceChildren(...codeOf(item.code).map((line, i) => {
			const span = el('span', 'pa-line');
			span.append(el('span', 'pa-line-no', String(i + 1)), document.createTextNode(line));
			return span;
		}));
		const opts = el('div', 'pa-opts');
		opts.setAttribute('role', 'group');
		opts.setAttribute('aria-label', tr('Respuestas posibles', 'Possible answers'));
		const buttons = item.options.map((o, i) => {
			const b = el('button', 'pa-opt', txt(o));
			b.type = 'button';
			b.setAttribute('aria-pressed', 'false');
			b.addEventListener('click', () => {
				picks[idx] = i;
				buttons.forEach((x, j) => x.setAttribute('aria-pressed', String(j === i)));
			});
			return b;
		});
		assessButtons[idx] = buttons;
		opts.replaceChildren(...buttons);
		host.replaceChildren(pre, opts);
	});

	const gradeBtn = document.getElementById('paGradeBtn') as HTMLButtonElement | null;
	const retryBtn = document.getElementById('paRetryBtn') as HTMLButtonElement | null;
	const scoreEl = document.getElementById('paScore');
	const resultsEl = document.getElementById('paResults');

	gradeBtn?.addEventListener('click', () => {
		let score = 0;
		const items = assess.map((item, i) => {
			const ok = picks[i] === item.answer;
			if (ok) score++;
			const li = el('li');
			const tag = el('span', ok ? 'tag tag-accent' : 'tag tag-outline', ok ? tr('Correcta', 'Correct') : picks[i] === null ? tr('Sin responder', 'Unanswered') : tr('Incorrecta', 'Incorrect'));
			li.append(tag, document.createTextNode(`${txt(item.q)} ${tr('Respuesta', 'Answer')}: `), el('code', '', txt(item.options[item.answer])), document.createTextNode(`. ${txt(item.why)}`));
			return li;
		});
		resultsEl?.replaceChildren(...items);
		if (scoreEl) scoreEl.textContent = `${tr('Puntaje', 'Score')}: ${score} / ${assess.length}`;
		assessButtons.forEach((group) => group.forEach((b) => (b.disabled = true)));
		if (gradeBtn) gradeBtn.disabled = true;
	});

	retryBtn?.addEventListener('click', () => {
		picks.fill(null);
		assessButtons.forEach((group) => group.forEach((b) => {
			b.disabled = false;
			b.setAttribute('aria-pressed', 'false');
		}));
		resultsEl?.replaceChildren();
		if (scoreEl) scoreEl.textContent = '';
		if (gradeBtn) gradeBtn.disabled = false;
	});

	// ───────── Modes and slide navigation ─────────
	type Mode = 'learn' | 'practice' | 'assess';
	let mode: Mode = 'learn';
	const position: Record<Mode, number> = { learn: 0, practice: 0, assess: 0 };
	const prevBtn = document.getElementById('paPrevBtn') as HTMLButtonElement | null;
	const nextBtn = document.getElementById('paNextBtn') as HTMLButtonElement | null;
	const counter = document.getElementById('paSlideCounter');
	const allSlides = root ? [...root.querySelectorAll<HTMLElement>('.pa-slide')] : [];
	const slidesOf = (m: Mode) => allSlides.filter((s) => s.dataset.mode === m);

	function showSlide(target: number) {
		const list = slidesOf(mode);
		if (target < 0 || target >= list.length) return;
		position[mode] = target;
		allSlides.forEach((s) => s.classList.remove('is-active'));
		list[target].classList.add('is-active');
		if (counter) counter.textContent = `${target + 1} / ${list.length}`;
		if (prevBtn) prevBtn.disabled = target === 0;
		if (nextBtn) nextBtn.disabled = target === list.length - 1;
	}

	root?.querySelectorAll<HTMLInputElement>('input[name="paMode"]').forEach((input) => {
		input.addEventListener('change', () => {
			if (!input.checked) return;
			mode = input.value as Mode;
			showSlide(position[mode]);
		});
	});

	prevBtn?.addEventListener('click', () => showSlide(position[mode] - 1));
	nextBtn?.addEventListener('click', () => showSlide(position[mode] + 1));

	window.addEventListener('keydown', (e) => {
		const t = e.target as HTMLElement | null;
		if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
		if (e.key === 'ArrowRight') showSlide(position[mode] + 1);
		if (e.key === 'ArrowLeft') showSlide(position[mode] - 1);
	});

	showSlide(0);
</script>
