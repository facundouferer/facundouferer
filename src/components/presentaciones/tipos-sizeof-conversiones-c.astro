---
interface Props {
	lang?: string;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
const L = (es: string, en: string) => (isEs ? es : en);

type Tone = 'base' | 'new' | 'warn' | 'ok';
interface Box {
	name: string;
	type: string;
	bytes: number;
	value: string;
	addr?: string;
	tone?: Tone;
}
interface Step {
	line: number;
	boxes: Box[];
	text: string;
	out?: string;
}
interface LearnSlide {
	title: string;
	lead: string;
	code: string;
	steps: Step[];
}

// Learn mode: one mechanism per slide, every step changes the state of the boxes.
const learn: LearnSlide[] = [
	{
		title: L('Un tipo es una caja de bytes', 'A type is a box of bytes'),
		lead: L(
			'El tipo decide qué valores caben, cuánta memoria se usa y cómo se interpretan los bits.',
			'The type decides which values fit, how much memory is used and how the bits are read.',
		),
		code: L(
			`#include <stdio.h>

int main(void) {
    char letra = 'A';
    short pasos = 1200;
    int edad = 18;
    long long bytesDisco = 512000000000LL;

    printf("%c %d %d %lld\\n", letra, pasos, edad, bytesDisco);
    return 0;
}`,
			`#include <stdio.h>

int main(void) {
