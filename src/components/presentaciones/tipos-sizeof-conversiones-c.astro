									))}
								</div>
								<p class="ts-feedback" aria-live="polite"></p>
								<p class="ts-reason" hidden>{item.reason}</p>
							</div>
							<div class="ts-vizcol">
								<span class="ts-state-label">{L('Estado actual', 'Current state')}</span>
								<div class="ts-boxes ts-before">
									{item.before.map((b) => (
										<div class:list={['ts-box', `ts-tone-${b.tone ?? 'base'}`]}>
											<div class="ts-box-head">
												<span class="ts-box-type">{b.type}</span>
												<span class="ts-box-name">{b.name}</span>
												<span class="ts-box-size">{b.bytes} {b.bytes === 1 ? 'byte' : 'bytes'}</span>
											</div>
											<div class="ts-bytes" aria-hidden="true">
												{Array.from({ length: b.bytes }).map(() => <span class="ts-byte" />)}
											</div>
											<div class="ts-box-foot">
												<span class="ts-addr">{b.addr ?? ' '}</span>
												<span class="ts-value">{b.value}</span>
											</div>
										</div>
									))}
								</div>
								<div class="ts-after" hidden>
									<span class="ts-state-label">{L('Estado siguiente', 'Next state')}</span>
									<div class="ts-boxes">
										{item.after.map((b) => (
											<div class:list={['ts-box', `ts-tone-${b.tone ?? 'base'}`]}>
												<div class="ts-box-head">
													<span class="ts-box-type">{b.type}</span>
													<span class="ts-box-name">{b.name}</span>
													<span class="ts-box-size">{b.bytes} {b.bytes === 1 ? 'byte' : 'bytes'}</span>
												</div>
												<div class="ts-bytes" aria-hidden="true">
													{Array.from({ length: b.bytes }).map(() => <span class="ts-byte" />)}
												</div>
												<div class="ts-box-foot">
													<span class="ts-addr">{b.addr ?? ' '}</span>
													<span class="ts-value">{b.value}</span>
												</div>
											</div>
										))}
									</div>
									<div class="ts-row-actions">
										<button class="ts-btn ts-replay">
											<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg>
											<span>{L('Ver la transición otra vez', 'Replay the transition')}</span>
										</button>
										<button class="ts-btn ts-retry">{L('Reintentar', 'Try again')}</button>
									</div>
								</div>
							</div>
						</div>
					</section>
				))}
			</div>

			<!-- Assess: no hints, graded at the end -->
			<div class="ts-mode" data-mode="assess" hidden>
				{assess.map((q, qi) => (
					<section class:list={['ts-q', { 'is-active': qi === 0 }]} data-q={qi + 1} data-answer={q.answer} data-code={q.code}>
						<div class="ts-head">
							<span class="ts-kicker">{L('Evaluar', 'Assess')} · {qi + 1} / {assess.length}</span>
							<h2 class="ts-title">{q.question}</h2>
						</div>
						<pre class="ts-code"><code>{lines(q.code).map((ln, li) => (
							<span class="ts-line" data-line={li + 1}><span class="ts-ln" aria-hidden="true">{li + 1}</span>{ln}</span>
						))}</code></pre>
						<div class="ts-options ts-options-col" role="group" aria-label={q.question}>
							{q.options.map((opt, oi) => (
