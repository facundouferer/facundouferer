<script>
	const root = document.querySelector<HTMLElement>('.ts-screen');

	if (root) {
		type Mode = 'learn' | 'practice' | 'assess';
		const d = root.dataset;
		const totals: Record<Mode, number> = {
			learn: Number(d.totalLearn),
			practice: Number(d.totalPractice),
			assess: Number(d.totalAssess),
		};
		const selectors: Record<Mode, string> = { learn: '.ts-slide', practice: '.ts-item', assess: '.ts-q' };
		const current: Record<Mode, number> = { learn: 1, practice: 1, assess: 1 };
		let mode: Mode = 'learn';

		const prevBtn = root.querySelector<HTMLButtonElement>('#tsPrevBtn');
		const nextBtn = root.querySelector<HTMLButtonElement>('#tsNextBtn');
		const counter = root.querySelector<HTMLElement>('#tsCounter');

		const panel = (m: Mode) => root.querySelector<HTMLElement>(`.ts-mode[data-mode="${m}"]`);

		function show(target: number) {
			if (target < 1 || target > totals[mode]) return;
			current[mode] = target;
			const items = panel(mode)?.querySelectorAll<HTMLElement>(selectors[mode]) ?? [];
			items.forEach((el, i) => el.classList.toggle('is-active', i + 1 === target));
			if (counter) counter.textContent = `${target} / ${totals[mode]}`;
			if (prevBtn) prevBtn.disabled = target === 1;
			if (nextBtn) nextBtn.disabled = target === totals[mode];
		}

		function setMode(m: Mode) {
			mode = m;
			(['learn', 'practice', 'assess'] as Mode[]).forEach((k) => {
				const p = panel(k);
				if (!p) return;
				p.hidden = k !== m;
				p.classList.toggle('is-active', k === m);
			});
			show(current[m]);
		}

		root.querySelectorAll<HTMLInputElement>('input[name="ts-mode"]').forEach((input) => {
			input.addEventListener('change', () => setMode(input.value as Mode));
		});

		prevBtn?.addEventListener('click', () => show(current[mode] - 1));
		nextBtn?.addEventListener('click', () => show(current[mode] + 1));

		window.addEventListener('keydown', (e) => {
			const t = e.target as HTMLElement | null;
			if (t && t.closest('input, textarea, select')) return;
			if (e.key === 'ArrowRight') show(current[mode] + 1);
			if (e.key === 'ArrowLeft') show(current[mode] - 1);
		});

		// Learn: step control per slide
		root.querySelectorAll<HTMLElement>('.ts-slide').forEach((slide) => {
			const total = Number(slide.dataset.steps);
			const steps = slide.querySelectorAll<HTMLElement>('.ts-step');
			const outs = slide.querySelectorAll<HTMLElement>('[data-step-out]');
			const codeLines = slide.querySelectorAll<HTMLElement>('.ts-line');
			const prev = slide.querySelector<HTMLButtonElement>('.ts-step-prev');
			const next = slide.querySelector<HTMLButtonElement>('.ts-step-next');
			const count = slide.querySelector<HTMLElement>('.ts-step-count');
			const live = slide.querySelector<HTMLElement>('.ts-sr');
			let k = 0;
			let ready = false;

			function render() {
				steps.forEach((s, i) => (s.hidden = i !== k));
				outs.forEach((o, i) => (o.hidden = i !== k));
				const line = steps[k]?.dataset.line;
				codeLines.forEach((l) => l.classList.toggle('is-current', l.dataset.line === line));
				if (count) count.textContent = `${d.step} ${k + 1} / ${total}`;
				if (live && ready) live.textContent = steps[k]?.querySelector('.ts-explain')?.textContent ?? '';
				if (prev) prev.disabled = k === 0;
				if (next) next.disabled = k === total - 1;
			}

			prev?.addEventListener('click', () => { if (k > 0) { k -= 1; render(); } });
			next?.addEventListener('click', () => { if (k < total - 1) { k += 1; render(); } });
			render();
			ready = true;
		});

		// Practice: predict, get feedback, watch the transition
		root.querySelectorAll<HTMLElement>('.ts-item').forEach((item) => {
			const answer = Number(item.dataset.answer);
			const opts = item.querySelectorAll<HTMLButtonElement>('.ts-opt');
			const feedback = item.querySelector<HTMLElement>('.ts-feedback');
			const reason = item.querySelector<HTMLElement>('.ts-reason');
			const after = item.querySelector<HTMLElement>('.ts-after');

			function play() {
				if (!after) return;
				after.hidden = false;
				after.classList.remove('ts-play');
				void after.offsetWidth;
				after.classList.add('ts-play');
			}

			opts.forEach((opt) => {
				opt.addEventListener('click', () => {
					const chosen = Number(opt.dataset.index);
					const ok = chosen === answer;
					opts.forEach((o) => {
						o.disabled = true;
						if (Number(o.dataset.index) === answer) o.classList.add('is-right');
					});
					if (!ok) opt.classList.add('is-wrong');
					if (feedback) {
						feedback.textContent = ok ? d.ok ?? '' : d.ko ?? '';
						feedback.classList.toggle('is-right', ok);
						feedback.classList.toggle('is-wrong', !ok);
					}
					if (reason) reason.hidden = false;
					play();
				});
			});

			item.querySelector('.ts-replay')?.addEventListener('click', play);
			item.querySelector('.ts-retry')?.addEventListener('click', () => {
				opts.forEach((o) => {
					o.disabled = false;
					o.classList.remove('is-right', 'is-wrong');
				});
				if (feedback) {
					feedback.textContent = '';
					feedback.classList.remove('is-right', 'is-wrong');
				}
				if (reason) reason.hidden = true;
				if (after) after.hidden = true;
				opts[0]?.focus();
			});
		});

		// Assess: answers are only revealed when grading
		const questions = Array.from(root.querySelectorAll<HTMLElement>('.ts-q'));
		const chosen: (number | null)[] = questions.map(() => null);
		const gradeBtn = root.querySelector<HTMLButtonElement>('#tsGradeBtn');
		const resetBtn = root.querySelector<HTMLButtonElement>('#tsResetBtn');
		const result = root.querySelector<HTMLElement>('#tsResult');

		questions.forEach((q, qi) => {
			q.querySelectorAll<HTMLButtonElement>('.ts-opt').forEach((opt) => {
				opt.addEventListener('click', () => {
					chosen[qi] = Number(opt.dataset.index);
					q.querySelectorAll<HTMLButtonElement>('.ts-opt').forEach((o) => o.setAttribute('aria-pressed', String(o === opt)));
				});
			});
		});

		gradeBtn?.addEventListener('click', () => {
			if (!result) return;
			let score = 0;
			const list = document.createElement('ol');
			questions.forEach((q, qi) => {
				const answer = Number(q.dataset.answer);
				const opts = Array.from(q.querySelectorAll<HTMLButtonElement>('.ts-opt'));
				const ok = chosen[qi] === answer;
				if (ok) score += 1;
				opts.forEach((o, oi) => {
					o.disabled = true;
					if (oi === answer) o.classList.add('is-right');
					else if (oi === chosen[qi]) o.classList.add('is-wrong');
				});
				q.querySelector<HTMLElement>('.ts-reason')?.removeAttribute('hidden');

				const li = document.createElement('li');
				const title = document.createElement('strong');
				title.textContent = q.querySelector('.ts-title')?.textContent ?? '';
				const snippet = document.createElement('code');
				snippet.className = 'ts-res-code';
				snippet.textContent = q.dataset.code ?? '';
				const mine = document.createElement('div');
				mine.className = ok ? 'ts-res-right' : 'ts-res-wrong';
				mine.textContent = `${d.your}: ${chosen[qi] === null ? d.none : opts[chosen[qi] as number]?.textContent}`;
				const right = document.createElement('div');
				right.textContent = `${d.right}: ${opts[answer]?.textContent}`;
				const why = document.createElement('div');
				why.textContent = q.querySelector('.ts-reason')?.textContent ?? '';
				li.append(title, snippet, mine, right, why);
				list.append(li);
			});
			const heading = document.createElement('h3');
			heading.textContent = `${d.score}: ${score} / ${questions.length}`;
			result.replaceChildren(heading, list);
			result.hidden = false;
			gradeBtn.hidden = true;
			if (resetBtn) resetBtn.hidden = false;
			result.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});

		resetBtn?.addEventListener('click', () => {
			questions.forEach((q, qi) => {
				chosen[qi] = null;
				q.querySelectorAll<HTMLButtonElement>('.ts-opt').forEach((o) => {
					o.disabled = false;
					o.classList.remove('is-right', 'is-wrong');
					o.setAttribute('aria-pressed', 'false');
				});
				q.querySelector<HTMLElement>('.ts-reason')?.setAttribute('hidden', '');
			});
			if (result) {
				result.hidden = true;
				result.replaceChildren();
			}
			resetBtn.hidden = true;
			if (gradeBtn) gradeBtn.hidden = false;
			show(1);
		});

		setMode('learn');
	}
</script>
