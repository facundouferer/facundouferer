							))}
						</div>
						<p class="ts-reason" hidden>{q.reason}</p>
					</section>
				))}
				<div class="ts-grade">
					<button class="ts-btn ts-btn-primary" id="tsGradeBtn">{L('Calificar', 'Grade')}</button>
					<button class="ts-btn" id="tsResetBtn" hidden>{L('Reintentar la evaluación', 'Retake the assessment')}</button>
				</div>
				<div class="ts-result" id="tsResult" aria-live="polite" hidden></div>
			</div>
		</main>
	</div>
</div>

