	data-lang={lang}
	data-total-learn={totals.learn}
	data-total-practice={totals.practice}
	data-total-assess={totals.assess}
	data-ok={L('¡Correcto!', 'Correct!')}
	data-ko={L('No es así.', 'Not quite.')}
	data-score={L('Puntaje', 'Score')}
	data-your={L('Tu respuesta', 'Your answer')}
	data-right={L('Respuesta correcta', 'Correct answer')}
	data-none={L('Sin responder', 'Not answered')}
	data-step={L('Paso', 'Step')}
>
	<div class="ts-shell">
		<nav class="ts-nav" aria-label={L('Controles de navegación', 'Navigation controls')}>
