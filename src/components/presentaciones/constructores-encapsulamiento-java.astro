	}

	.deck-svg-title {
		font-size: 12px;
		font-weight: 700;
		fill: var(--color-text);
	}

	.deck-svg-title-accent {
		font-size: 12px;
		font-weight: 700;
		fill: var(--color-accent-700);
	}

	.deck-svg-mono {
		font-family: monospace;
		font-size: 11px;
		fill: var(--color-text);
	}

	.deck-svg-mono-sm {
		font-family: monospace;
		font-size: 9.5px;
		fill: color-mix(in srgb, var(--color-text) 70%, transparent);
	}

	.deck-svg-bold {
		font-size: 11.5px;
		font-weight: 700;
		fill: var(--color-text);
	}

	.deck-svg-sub {
		font-size: 10px;
		fill: color-mix(in srgb, var(--color-text) 60%, transparent);
	}

	.deck-ground-card {
		fill: var(--color-surface);
	}

	/* Interactive card styling */
	.deck-interactive-card {
		background: var(--color-neutral-100);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-lg);
		padding: var(--space-4);
	}

	.deck-card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: var(--space-3);
	}

	.deck-badge {
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--color-accent-700);
