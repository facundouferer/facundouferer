---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="sw-screen">
	<div class="sw-shell">
		<header class="sw-header">
			<span class="sw-badge">{isEs ? 'Selección Múltiple' : 'Pattern Matching'}</span>
			<h1 class="sw-title">
				{isEs ? 'Switch-Case y Pattern Matching' : 'Switch-Case & Pattern Matching'}
			</h1>
			<p class="sw-sub">
				{isEs 
					? 'Mecanismos de selección por caso en C, Java, JavaScript y Python.' 
					: 'Case selection mechanisms in C, Java, JavaScript, and Python.'}
			</p>
		</header>

		<div class="sw-deck-card">
			<div class="sw-nav-bar">
				<div class="sw-slide-indicator">
					<span class="sw-step-dot"></span>
					<span id="sw-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="sw-pills">
					<button class="sw-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="sw-pill-btn" data-target-slide="2">2. C</button>
					<button class="sw-pill-btn" data-target-slide="3">3. Java</button>
					<button class="sw-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="sw-pill-btn" data-target-slide="5">5. Python</button>
					<button class="sw-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="sw-viewport">
				<div class="sw-slide active" data-slide="1">
					<div class="sw-slide-grid">
						<div class="sw-col">
							<h2 class="sw-slide-title">1. {isEs ? 'Evaluación de Múltiples Casos' : 'Multiple Case Evaluation'}</h2>
							<p class="sw-text">
								{isEs 
									? 'Un `switch` evalúa una expresión y busca coincidencia directa entre múltiples etiquetas `case`, evitando cadenas extensas de `if-else`.'
									: 'A `switch` evaluates an expression matching against multiple `case` labels, avoiding long `if-else` chains.'}
							</p>
						</div>
						<div class="sw-col">
							<div class="sw-card-box">
								<div class="sw-card-head">{isEs ? 'MECANISMO DE MATCH' : 'MATCHING MECHANISM'}</div>
								<div class="sw-cell"><span>case 'A':</span><span class="sw-tag">Acción A + break</span></div>
								<div class="sw-cell"><span>default:</span><span class="sw-tag">Fallback por defecto</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="sw-slide" data-slide="2">
					<div class="sw-slide-grid">
						<div class="sw-col">
							<h2 class="sw-slide-title">2. C: Switch con Enteros y Chars</h2>
							<p class="sw-text">En C `switch` solo acepta expresiones enteras o caracteres (`int`, `char`, `enum`). Requiere `break` obligatorio para evitar fallthrough.</p>
						</div>
						<div class="sw-col">
							<div class="sw-code-card">
								<div class="sw-code-title">switch.c</div>
								<pre class="sw-code-block"><code><span class="token-type">char</span> opcion = <span class="token-string">'B'</span>;
<span class="token-keyword">switch</span> (opcion) &#123;
    <span class="token-keyword">case</span> <span class="token-string">'A'</span>: printf(<span class="token-string">"Opción A\n"</span>); <span class="token-keyword">break</span>;
    <span class="token-keyword">case</span> <span class="token-string">'B'</span>: printf(<span class="token-string">"Opción B\n"</span>); <span class="token-keyword">break</span>;
    <span class="token-keyword">default</span>: printf(<span class="token-string">"Desconocido\n"</span>);
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="sw-slide" data-slide="3">
					<div class="sw-slide-grid">
						<div class="sw-col">
							<h2 class="sw-slide-title">3. Java: Switch Expressions (Arrow Syntax)</h2>
							<p class="sw-text">Java moderno incorpora expresiones switch con sintaxis `case X -&gt;`, eliminando el riesgo de fallthrough.</p>
						</div>
						<div class="sw-col">
							<div class="sw-code-card">
								<div class="sw-code-title">SwitchExpr.java</div>
								<pre class="sw-code-block"><code>String dia = <span class="token-string">"LUNES"</span>;
String tipo = <span class="token-keyword">switch</span> (dia) &#123;
    <span class="token-keyword">case</span> <span class="token-string">"SABADO"</span>, <span class="token-string">"DOMINGO"</span> -&gt; <span class="token-string">"Finde"</span>;
    <span class="token-keyword">default</span> -&gt; <span class="token-string">"Laboral"</span>;
&#125;;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="sw-slide" data-slide="4">
					<div class="sw-slide-grid">
						<div class="sw-col">
							<h2 class="sw-slide-title">4. JavaScript: Switch con Comparación Estricta (===)</h2>
							<p class="sw-text">JS evalúa expresiones arbitrarias mediante comparación estricta de tipo y valor (`===`).</p>
						</div>
						<div class="sw-col">
							<div class="sw-code-card">
								<div class="sw-code-title">switch.js</div>
								<pre class="sw-code-block"><code><span class="token-keyword">const</span> estado = <span class="token-number">200</span>;
<span class="token-keyword">switch</span> (estado) &#123;
    <span class="token-keyword">case</span> <span class="token-number">200</span>: console.log(<span class="token-string">"OK"</span>); <span class="token-keyword">break</span>;
    <span class="token-keyword">case</span> <span class="token-number">404</span>: console.log(<span class="token-string">"Not Found"</span>); <span class="token-keyword">break</span>;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="sw-slide" data-slide="5">
					<div class="pv-slide-grid">
						<div class="sw-col">
							<h2 class="sw-slide-title">5. Python: Structural Pattern Matching (match-case)</h2>
							<p class="sw-text">Python 3.10+ introdujo `match-case` permitiendo Pattern Matching avanzado sobre tuplas, diccionarios y tipos.</p>
						</div>
						<div class="sw-col">
							<div class="sw-code-card">
								<div class="sw-code-title">pattern_matching.py</div>
								<pre class="sw-code-block"><code>command = [<span class="token-string">"quit"</span>]
<span class="token-keyword">match</span> command:
    <span class="token-keyword">case</span> [<span class="token-string">"load"</span>, filename]: print(f<span class="token-string">"Cargando &#123;filename&#125;"</span>)
    <span class="token-keyword">case</span> [<span class="token-string">"quit"</span>]: print(<span class="token-string">"Saliendo..."</span>)
    <span class="token-keyword">case</span> _: print(<span class="token-string">"Comando invalido"</span>)</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="sw-slide" data-slide="6">
					<div class="sw-sim-container">
						<h2 class="sw-slide-title center">{isEs ? '6. Simulador Interactivo de Casos' : '6. Case Match Simulator'}</h2>
						<p class="sw-sub center">{isEs ? 'Seleccioná una opción para simular el caso ejecutado:' : 'Select an option to simulate the matched case:'}</p>

						<div class="sw-sim-selector">
							<button class="sw-opt-btn active" data-opt="200">Estado HTTP = 200</button>
							<button class="sw-opt-btn" data-opt="404">Estado HTTP = 404</button>
							<button class="sw-opt-btn" data-opt="500">Estado HTTP = 500</button>
						</div>

						<div class="sw-inspector-grid">
							<div class="sw-lang-box"><span class="sw-lang-name">C</span><div class="sw-exp-res" id="sw-res-c">case 200: printf("OK"); break;</div></div>
							<div class="sw-lang-box"><span class="sw-lang-name">Java</span><div class="sw-exp-res" id="sw-res-java">case 200 -&gt; "OK";</div></div>
							<div class="sw-lang-box"><span class="sw-lang-name">JavaScript</span><div class="sw-exp-res" id="sw-res-js">case 200: console.log("OK"); break;</div></div>
							<div class="sw-lang-box"><span class="sw-lang-name">Python</span><div class="sw-exp-res" id="sw-res-py">case 200: print("OK")</div></div>
						</div>
					</div>
				</div>
			</div>

			<div class="sw-footer">
				<button class="btn btn-secondary" id="btn-prev-sw" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="sw-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-sw">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.sw-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.sw-shell { max-width: var(--container-max); margin: 0 auto; }
	.sw-header { margin-bottom: 1.5rem; }
	.sw-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.sw-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.sw-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.sw-sub.center { text-align: center; }
	.sw-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.sw-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.sw-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.sw-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.sw-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.sw-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.sw-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.sw-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.sw-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.sw-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.sw-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.sw-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.sw-col { grid-column: span 12; }
	@media (min-width: 900px) { .sw-col { grid-column: span 6; } }
	.sw-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.sw-slide-title.center { text-align: center; }
	.sw-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.sw-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.sw-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.sw-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.sw-tag { color: var(--color-accent-700); font-weight: 600; }
	.sw-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.sw-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.sw-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.sw-sim-container { max-width: 800px; margin: 0 auto; }
	.sw-sim-selector { display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 1.2rem; flex-wrap: wrap; }
	.sw-opt-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.35rem 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease; }
	.sw-opt-btn:hover { background: var(--color-accent-100); color: var(--color-accent-700); }
	.sw-opt-btn.active { background: var(--color-accent-700); border-color: var(--color-accent-700); color: #ffffff; }
	.sw-inspector-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
	@media (max-width: 600px) { .sw-inspector-grid { grid-template-columns: repeat(1, minmax(0, 1fr)); } }
	.sw-lang-box { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.8rem; }
	.sw-lang-name { font-family: 'Fira Code', monospace; font-size: 0.75rem; font-weight: 700; color: #e59866; display: block; margin-bottom: 0.4rem; }
	.sw-exp-res { font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #f9f4ed; background: #141210; padding: 0.5rem 0.7rem; border-radius: var(--radius-sm); }
	.sw-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.sw-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const switchData = {
		200: {
			c: 'case 200: printf("OK"); break;',
			java: 'case 200 -> "OK";',
			js: 'case 200: console.log("OK"); break;',
			py: 'case 200: print("OK")'
		},
		404: {
			c: 'case 404: printf("Not Found"); break;',
			java: 'case 404 -> "Not Found";',
			js: 'case 404: console.log("Not Found"); break;',
			py: 'case 404: print("Not Found")'
		},
		500: {
			c: 'default: printf("Error");',
			java: 'default -> "Error";',
			js: 'default: console.log("Error");',
			py: 'case _: print("Error")'
		}
	};

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.sw-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.sw-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('sw-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-sw') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-sw') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.sw-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-sw')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-sw')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	document.querySelectorAll('.sw-opt-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			document.querySelectorAll('.sw-opt-btn').forEach(b => b.classList.remove('active'));
			const targetBtn = e.currentTarget as HTMLElement;
			targetBtn.classList.add('active');
			const optKey = Number(targetBtn.dataset.opt) as keyof typeof switchData;
			const data = switchData[optKey];
			if (data) {
				const resC = document.getElementById('sw-res-c');
				const resJava = document.getElementById('sw-res-java');
				const resJs = document.getElementById('sw-res-js');
				const resPy = document.getElementById('sw-res-py');
				if (resC) resC.textContent = data.c;
				if (resJava) resJava.textContent = data.java;
				if (resJs) resJs.textContent = data.js;
				if (resPy) resPy.textContent = data.py;
			}
		});
	});

	goToSlide(1);
</script>
