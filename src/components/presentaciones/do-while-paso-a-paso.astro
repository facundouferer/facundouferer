---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="dw-screen">
	<div class="dw-shell">
		<header class="dw-header">
			<span class="dw-badge">{isEs ? 'Ciclos Post-Prueba' : 'Post-Test Loops'}</span>
			<h1 class="dw-title">
				{isEs ? 'Ciclo Do-While Paso a Paso' : 'Do-While Loop Step by Step'}
			</h1>
			<p class="dw-sub">
				{isEs 
					? 'Garantía de ejecución mínima e iteración post-evaluada en C, Java, JavaScript y Python.' 
					: 'Guaranteed minimum single execution and post-evaluated iteration in C, Java, JS, and Python.'}
			</p>
		</header>

		<div class="dw-deck-card">
			<div class="dw-nav-bar">
				<div class="dw-slide-indicator">
					<span class="dw-step-dot"></span>
					<span id="dw-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="dw-pills">
					<button class="dw-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="dw-pill-btn" data-target-slide="2">2. C</button>
					<button class="dw-pill-btn" data-target-slide="3">3. Java</button>
					<button class="dw-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="dw-pill-btn" data-target-slide="5">5. Python (Emulación)</button>
					<button class="dw-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="dw-viewport">
				<div class="dw-slide active" data-slide="1">
					<div class="dw-slide-grid">
						<div class="dw-col">
							<h2 class="dw-slide-title">1. {isEs ? 'Garantía de Ejecución Mínima (At least once)' : 'At Least Once Guarantee'}</h2>
							<p class="dw-text">
								{isEs 
									? 'A diferencia de `while`, el ciclo `do-while` ejecuta su bloque de código al menos una vez antes de verificar la condición.'
									: 'Unlike `while`, the `do-while` loop executes its code block at least once before checking the condition.'}
							</p>
						</div>
						<div class="dw-col">
							<div class="dw-card-box">
								<div class="dw-card-head">{isEs ? 'ORDEN DE PASOS' : 'STEP ORDER'}</div>
								<div class="dw-cell"><span>1. Ejecutar Cuerpo</span><span class="dw-tag">Garantizado</span></div>
								<div class="dw-cell"><span>2. Evaluar Condición</span><span class="dw-tag">Post-Prueba</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="dw-slide" data-slide="2">
					<div class="dw-slide-grid">
						<div class="dw-col">
							<h2 class="dw-slide-title">2. C: do &#123; ... &#125; while(cond);</h2>
							<p class="dw-text">En C requiere punto y coma final `;` tras la condición `while(cond);`.</p>
						</div>
						<div class="dw-col">
							<div class="dw-code-card">
								<div class="dw-code-title">do_while.c</div>
								<pre class="dw-code-block"><code><span class="token-type">int</span> opcion;
<span class="token-keyword">do</span> &#123;
    printf(<span class="token-string">"Ingrese opcion (0 para salir): "</span>);
    scanf(<span class="token-string">"%d"</span>, &amp;opcion);
&#125; <span class="token-keyword">while</span> (opcion != <span class="token-number">0</span>);</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="dw-slide" data-slide="3">
					<div class="dw-slide-grid">
						<div class="dw-col">
							<h2 class="dw-slide-title">3. Java: Menús Interactivos</h2>
							<p class="dw-text">Ideal para validación de entrada de usuario y menús interactivos donde se necesita al menos una interacción inicial.</p>
						</div>
						<div class="dw-col">
							<div class="dw-code-card">
								<div class="dw-code-title">DoWhileTest.java</div>
								<pre class="dw-code-block"><code><span class="token-type">int</span> input;
<span class="token-keyword">do</span> &#123;
    input = readInput();
&#125; <span class="token-keyword">while</span> (input &lt; <span class="token-number">0</span>);</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="dw-slide" data-slide="4">
					<div class="dw-slide-grid">
						<div class="dw-col">
							<h2 class="dw-slide-title">4. JavaScript: do &#123; ... &#125; while</h2>
							<p class="dw-text">JS soporta `do-while` nativo para reintentos de red o promesas con al menos un intento primario.</p>
						</div>
						<div class="dw-col">
							<div class="dw-code-card">
								<div class="dw-code-title">do_while.js</div>
								<pre class="dw-code-block"><code><span class="token-keyword">let</span> intentos = <span class="token-number">0</span>;
<span class="token-keyword">do</span> &#123;
    intentos++;
    console.log(<span class="token-string">`Intento $&#123;intentos&#125;`</span>);
&#125; <span class="token-keyword">while</span> (intentos &lt; <span class="token-number">3</span>);</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="dw-slide" data-slide="5">
					<div class="dw-slide-grid">
						<div class="dw-col">
							<h2 class="dw-slide-title">5. Python: Emulación de do-while (while True + break)</h2>
							<p class="dw-text">Python NO tiene `do-while` nativo. Se emula usando `while True:` con una condición `if ...: break` al final del cuerpo.</p>
						</div>
						<div class="dw-col">
							<div class="dw-code-card">
								<div class="dw-code-title">do_while_emulated.py</div>
								<pre class="dw-code-block"><code><span class="token-keyword">while</span> <span class="token-keyword">True</span>:
    user_input = input(<span class="token-string">"Password: "</span>)
    <span class="token-keyword">if</span> user_input == <span class="token-string">"secret"</span>:
        <span class="token-keyword">break</span> <span class="token-comment"># Post-condición de salida</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="dw-slide" data-slide="6">
					<div class="dw-sim-container">
						<h2 class="dw-slide-title center">{isEs ? '6. Simulador Comparativo (while vs do-while)' : '6. Comparative Simulator'}</h2>
						<p class="dw-sub center">{isEs ? 'Mirá la diferencia cuando la condición inicial es falsa (condicion = false):' : 'Observe the difference when initial condition is false:'}</p>

						<div class="dw-inspector-grid">
							<div class="dw-lang-box"><span class="dw-lang-name">While Loop (Pre-prueba)</span><div class="dw-exp-res">Ejecuciones del cuerpo: 0 veces (Se saltea inmediatamente)</div></div>
							<div class="dw-lang-box"><span class="dw-lang-name">Do-While Loop (Post-prueba)</span><div class="dw-exp-res">Ejecuciones del cuerpo: 1 vez (Garantizado)</div></div>
						</div>
					</div>
				</div>
			</div>

			<div class="dw-footer">
				<button class="btn btn-secondary" id="btn-prev-dw" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="dw-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-dw">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.dw-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.dw-shell { max-width: var(--container-max); margin: 0 auto; }
	.dw-header { margin-bottom: 1.5rem; }
	.dw-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.dw-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.dw-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.dw-sub.center { text-align: center; }
	.dw-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.dw-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.dw-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.dw-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.dw-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.dw-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.dw-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.dw-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.dw-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.dw-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.dw-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.dw-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.dw-col { grid-column: span 12; }
	@media (min-width: 900px) { .dw-col { grid-column: span 6; } }
	.dw-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.dw-slide-title.center { text-align: center; }
	.dw-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.dw-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.dw-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.dw-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.dw-tag { color: var(--color-accent-700); font-weight: 600; }
	.dw-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.dw-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.dw-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.dw-sim-container { max-width: 800px; margin: 0 auto; }
	.dw-inspector-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
	@media (max-width: 600px) { .dw-inspector-grid { grid-template-columns: repeat(1, minmax(0, 1fr)); } }
	.dw-lang-box { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.8rem; }
	.dw-lang-name { font-family: 'Fira Code', monospace; font-size: 0.75rem; font-weight: 700; color: #e59866; display: block; margin-bottom: 0.4rem; }
	.dw-exp-res { font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #f9f4ed; background: #141210; padding: 0.5rem 0.7rem; border-radius: var(--radius-sm); }
	.dw-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.dw-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.dw-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.dw-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('dw-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-dw') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-dw') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.dw-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-dw')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-dw')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	goToSlide(1);
</script>
