	@media (min-width: 1440px) { .co-viewport { zoom: 1.08; } }
	@media (min-width: 1680px) { .co-viewport { zoom: 1.16; } }
	@media (min-width: 1920px) { .co-viewport { zoom: 1.25; } }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 5;

	const prevBtn = document.getElementById('coPrevBtn') as HTMLButtonElement;
	const nextBtn = document.getElementById('coNextBtn') as HTMLButtonElement;
	const counter = document.getElementById('coSlideCounter') as HTMLElement;
	const slides = document.querySelectorAll<HTMLElement>('.co-slide');

	function updateSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;
		slides.forEach((s) => s.classList.remove('is-active'));
		document.querySelector(`.co-slide[data-slide="${currentSlide}"]`)?.classList.add('is-active');

		if (counter) counter.textContent = `${currentSlide} / ${totalSlides}`;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	prevBtn?.addEventListener('click', () => updateSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => updateSlide(currentSlide + 1));

	// Slide 1: Hardware toggle
	const modeSingle = document.getElementById('coModeSingle');
	const modeMulti = document.getElementById('coModeMulti');
	const core1Box = document.getElementById('coCore1Box');
	const core1Status = document.getElementById('coCore1Status');

	modeSingle?.addEventListener('click', () => {
		modeSingle.classList.add('is-active');
		modeMulti?.classList.remove('is-active');
		if (core1Box) core1Box.style.opacity = '0.35';
		if (core1Status) core1Status.textContent = 'Inactivo (Modo 1 Core)';
	});

	modeMulti?.addEventListener('click', () => {
		modeMulti.classList.add('is-active');
		modeSingle?.classList.remove('is-active');
		if (core1Box) core1Box.style.opacity = '1';
		if (core1Status) core1Status.textContent = 'Hilo-2 (Paralelo Simultáneo)';
	});

	// Slide 2: Race Condition Simulator
	let raceStep = 0;
	const raceStepBtn = document.getElementById('coRaceStepBtn');
	const raceResetBtn = document.getElementById('coRaceResetBtn');
	const raceStatus = document.getElementById('coRaceStatus');
	const sharedCount = document.getElementById('coSharedCount');
	const lostUpdateMsg = document.getElementById('coLostUpdateMsg');

	const t1Steps = [
		document.getElementById('coT1Step1'),
		document.getElementById('coT1Step2'),
		document.getElementById('coT1Step3'),
	];
	const t2Steps = [
		document.getElementById('coT2Step1'),
		document.getElementById('coT2Step2'),
		document.getElementById('coT2Step3'),
	];

	function renderRace() {
		t1Steps.forEach((el) => el?.classList.remove('is-active'));
		t2Steps.forEach((el) => el?.classList.remove('is-active'));

		if (raceStep === 0) {
			if (sharedCount) sharedCount.textContent = '5';
			if (raceStatus) raceStatus.textContent = 'T0: Variable count = 5 en memoria compartida';
			if (lostUpdateMsg) lostUpdateMsg.textContent = '...';
		} else if (raceStep === 1) {
			t1Steps[0]?.classList.add('is-active');
			if (raceStatus) raceStatus.textContent = 'T1: Hilo 1 lee count (5) a su registro local';
		} else if (raceStep === 2) {
			t1Steps[0]?.classList.add('is-active');
			t2Steps[0]?.classList.add('is-active');
			if (raceStatus) raceStatus.textContent = 'T2: Hilo 2 lee count (5) a su registro local (¡Antes de que Hilo 1 actualice!)';
		} else if (raceStep === 3) {
			t1Steps[1]?.classList.add('is-active');
			t2Steps[1]?.classList.add('is-active');
			if (raceStatus) raceStatus.textContent = 'T3: Ambos hilos calculan localmente 5 + 1 = 6';
		} else if (raceStep === 4) {
			t1Steps[2]?.classList.add('is-active');
			if (sharedCount) sharedCount.textContent = '6';
			if (raceStatus) raceStatus.textContent = 'T4: Hilo 1 escribe 6 en el Heap compartido';
		} else if (raceStep === 5) {
			t1Steps[2]?.classList.add('is-active');
			t2Steps[2]?.classList.add('is-active');
			if (sharedCount) sharedCount.textContent = '6';
			if (raceStatus) raceStatus.textContent = 'T5: Hilo 2 escribe su 6, sobreescribiendo el Heap. ¡Se perdió 1 incremento!';
			if (lostUpdateMsg) {
				lostUpdateMsg.textContent = '❌ ¡Condición de Carrera! count = 6 en vez de 7 (Lost Update).';
				lostUpdateMsg.style.color = 'var(--color-accent)';
			}
		}
	}

	raceStepBtn?.addEventListener('click', () => {
		if (raceStep < 5) {
			raceStep++;
			renderRace();
		}
	});

	raceResetBtn?.addEventListener('click', () => {
		raceStep = 0;
		renderRace();
	});

	// Slide 4: Deadlock Toggle
	const deadlockCycleBtn = document.getElementById('coDeadlockCycleBtn');
	const deadlockFixBtn = document.getElementById('coDeadlockFixBtn');
	const cycleArrows = document.getElementById('coCycleArrows');
	const deadlockExplanation = document.getElementById('coDeadlockExplanation');

	deadlockCycleBtn?.addEventListener('click', () => {
		deadlockCycleBtn.classList.add('is-active');
		deadlockFixBtn?.classList.remove('is-active');
		if (cycleArrows) {
			cycleArrows.innerHTML = `
				<line x1="120" y1="50" x2="185" y2="35" class="co-arrow-holds" />
				<text x="145" y="35" class="co-edge-lbl">Retiene</text>
				<line x1="105" y1="90" x2="190" y2="140" class="co-arrow-waits" />
				<text x="125" y="130" class="co-edge-lbl co-text-accent">Espera</text>
				<line x1="320" y1="70" x2="255" y2="140" class="co-arrow-holds" />
				<text x="290" y="125" class="co-edge-lbl">Retiene</text>
				<line x1="320" y1="50" x2="255" y2="35" class="co-arrow-waits" />
				<text x="290" y="35" class="co-edge-lbl co-text-accent">Espera</text>
			`;
		}
		if (deadlockExplanation) {
			deadlockExplanation.innerHTML = '<strong>Condición de Espera Circular:</strong> El Hilo A no liberará Lock 1 hasta obtener Lock 2; el Hilo B no liberará Lock 2 hasta obtener Lock 1. Congelamiento total de la aplicación.';
		}
	});

	deadlockFixBtn?.addEventListener('click', () => {
		deadlockFixBtn.classList.add('is-active');
		deadlockCycleBtn?.classList.remove('is-active');
		if (cycleArrows) {
			cycleArrows.innerHTML = `
				<line x1="120" y1="50" x2="185" y2="35" class="co-arrow-holds" />
				<text x="145" y="35" class="co-edge-lbl">Retiene</text>
				<line x1="105" y1="90" x2="190" y2="140" class="co-arrow-holds" />
				<text x="135" y="125" class="co-edge-lbl">Adquiere Lock 2</text>
				<line x1="320" y1="50" x2="255" y2="35" class="co-arrow-waits" />
				<text x="280" y="35" class="co-edge-lbl co-text-accent">Espera Lock 1</text>
			`;
		}
		if (deadlockExplanation) {
			deadlockExplanation.innerHTML = '<strong>Orden Canónico de Adquisición (Solución):</strong> Ambos hilos siempre piden Lock 1 antes que Lock 2. El ciclo circular se rompe por completo y el Deadlock es matemáticamente imposible.';
		}
	});
</script>
