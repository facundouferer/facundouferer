---
interface Props {
	lang?: string;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
const t = (es: string, en: string) => (isEs ? es : en);
// C programs shown in the deck. Each pair has the same line structure in both
// languages, so the step line numbers below apply to either one.
const code = (es: string, en: string) => (isEs ? es : en);

type Kind = 'owner' | 'borrow' | 'dangling' | 'null' | 'value';
type Slot = { name: string; value: string; kind: Kind; target?: string };
type Frame = { label: string; vars: Slot[] };
type Cell = { v: string; out?: boolean };
type Block = {
	id: string;
	addr: string;
	size: string;
	label: string;
	status: 'live' | 'freed' | 'leaked' | 'static';
	owner?: string;
	fields?: Slot[];
	cells?: Cell[];
	value?: string;
};
type Alert = { kind: 'error' | 'leak' | 'ok'; text: string };
type State = { frames: Frame[]; blocks: Block[]; alert?: Alert };
type Step = { lines: number[]; text: string; state: State };

const ptr = (name: string, value: string, kind: Kind, target?: string): Slot => ({ name, value, kind, target });
const val = (name: string, value: string): Slot => ({ name, value, kind: 'value' });
const nul = (name: string): Slot => ({ name, value: 'NULL', kind: 'null' });

const programs = {
	persona: code(
		String.raw`#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char *nombre;
    int edad;
} Persona;

// Crea una persona con una copia de nombre.
// Propiedad: el llamador es dueño del resultado y debe liberarlo con
// destruir_persona. Devuelve NULL si no hay memoria.
Persona *crear_persona(const char *nombre, int edad) {
    Persona *p = malloc(sizeof *p);
    if (p == NULL) {
        return NULL;
    }
    size_t largo = strlen(nombre) + 1;
    p->nombre = malloc(largo);
    if (p->nombre == NULL) {
        free(p);                   // deshacer lo que ya se reservó
        return NULL;
    }
    memcpy(p->nombre, nombre, largo);
    p->edad = edad;
    return p;
}

// Libera la persona y todo lo que le pertenece. Acepta NULL.
void destruir_persona(Persona *p) {
    if (p == NULL) {
        return;
    }
    free(p->nombre);               // primero las partes...
    free(p);                       // ...después el contenedor
}

// Propiedad: solo toma prestada p.
void imprimir_persona(const Persona *p) {
    printf("%s (%d)\n", p->nombre, p->edad);
}

int main(void) {
    Persona *ana = crear_persona("Ana", 31);
    if (ana == NULL) {
        fprintf(stderr, "No hay memoria suficiente\n");
        return 1;
    }
    imprimir_persona(ana);         // préstamo
    destruir_persona(ana);         // main era la dueña: main libera
    ana = NULL;
    return 0;
}`,
		String.raw`#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char *name;
    int age;
} Person;

// Creates a person with a copy of name.
// Ownership: the caller owns the result and must release it with
// destroy_person. Returns NULL if out of memory.
Person *create_person(const char *name, int age) {
    Person *p = malloc(sizeof *p);
    if (p == NULL) {
        return NULL;
    }
    size_t length = strlen(name) + 1;
    p->name = malloc(length);
    if (p->name == NULL) {
        free(p);                   // undo what was already allocated
        return NULL;
    }
    memcpy(p->name, name, length);
    p->age = age;
    return p;
}

// Frees the person and everything it owns. Accepts NULL.
void destroy_person(Person *p) {
    if (p == NULL) {
        return;
    }
    free(p->name);                 // first the parts...
    free(p);                       // ...then the container
}

// Ownership: only borrows p.
void print_person(const Person *p) {
    printf("%s (%d)\n", p->name, p->age);
}

int main(void) {
    Person *ann = create_person("Ann", 31);
    if (ann == NULL) {
        fprintf(stderr, "Not enough memory\n");
        return 1;
    }
    print_person(ann);             // borrowing
    destroy_person(ann);           // main was the owner: main frees
    ann = NULL;
    return 0;
}`,
	),
	transfer: code(
		String.raw`#include <stdio.h>
#include <stdlib.h>

#define CAPACIDAD_AGENDA 8

typedef struct {
    int edad;
} Persona;

typedef struct {
    Persona *personas[CAPACIDAD_AGENDA];
    size_t cantidad;
} Agenda;

// Propiedad: si devuelve true, la agenda pasa a ser dueña de p y el llamador
// no debe liberarla. Si devuelve false, el llamador sigue siendo el dueño.
bool agenda_agregar(Agenda *a, Persona *p) {
    if (a->cantidad == CAPACIDAD_AGENDA) {
        return false;
    }
    a->personas[a->cantidad] = p;
    a->cantidad++;
    return true;
}

int main(void) {
    Agenda agenda = { .cantidad = 0 };
    Persona *p = malloc(sizeof *p);
    if (p == NULL) {
        return 1;
    }
    p->edad = 31;
    if (!agenda_agregar(&agenda, p)) {
        free(p);                   // la agenda no la aceptó: sigue siendo nuestra
        return 1;
    }
    printf("%d\n", p->edad);       // préstamo: la agenda la mantiene viva
    for (size_t i = 0; i < agenda.cantidad; i++) {
        free(agenda.personas[i]);  // la agenda libera lo que le pertenece
        agenda.personas[i] = NULL;
    }
    agenda.cantidad = 0;
    return 0;
}`,
		String.raw`#include <stdio.h>
#include <stdlib.h>

#define CONTACTS_CAPACITY 8

typedef struct {
    int age;
} Person;

typedef struct {
    Person *people[CONTACTS_CAPACITY];
    size_t count;
} Contacts;

// Ownership: if it returns true, the contacts become the owner of p and the
// caller must not free it. If it returns false, the caller is still the owner.
bool contacts_add(Contacts *c, Person *p) {
    if (c->count == CONTACTS_CAPACITY) {
        return false;
    }
    c->people[c->count] = p;
    c->count++;
    return true;
}

int main(void) {
    Contacts contacts = { .count = 0 };
    Person *p = malloc(sizeof *p);
    if (p == NULL) {
        return 1;
    }
    p->age = 31;
    if (!contacts_add(&contacts, p)) {
        free(p);                   // not accepted: it is still ours
        return 1;
    }
    printf("%d\n", p->age);        // borrowing: the contacts keep it alive
    for (size_t i = 0; i < contacts.count; i++) {
        free(contacts.people[i]);  // the contacts free what they own
        contacts.people[i] = NULL;
    }
    contacts.count = 0;
    return 0;
}`,
	),
	leak: code(
		String.raw`#include <stdio.h>
#include <stdlib.h>

int main(void) {
    for (int i = 0; i < 3; i++) {
        char *linea = malloc(32);
        if (linea == NULL) {
            return 1;
        }
        snprintf(linea, 32, "Linea %d", i);
        printf("%s\n", linea);
    }                              // linea muere aquí; el bloque, no
    return 0;
}`,
		String.raw`#include <stdio.h>
#include <stdlib.h>

int main(void) {
    for (int i = 0; i < 3; i++) {
        char *line = malloc(32);
        if (line == NULL) {
            return 1;
        }
        snprintf(line, 32, "Line %d", i);
        printf("%s\n", line);
    }                              // line dies here; the block does not
    return 0;
}`,
	),
	doubleFree: code(
		String.raw`#include <stdlib.h>

int main(void) {
    int *datos = malloc(4 * sizeof *datos);
    if (datos == NULL) {
        return 1;
    }
    int *alias = datos;            // dos punteros, un solo bloque
    free(datos);
    free(alias);                   // ERROR: el bloque ya estaba liberado
    return 0;
}`,
		String.raw`#include <stdlib.h>

int main(void) {
    int *data = malloc(4 * sizeof *data);
    if (data == NULL) {
        return 1;
    }
    int *alias = data;             // two pointers, one block
    free(data);
    free(alias);                   // ERROR: the block was already freed
    return 0;
}`,
	),
	useAfterFree: code(
		String.raw`#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int *puntaje = malloc(sizeof *puntaje);
    if (puntaje == NULL) {
        return 1;
    }
    *puntaje = 100;
    free(puntaje);
    printf("%d\n", *puntaje);      // ERROR: el bloque ya no existe
    return 0;
}`,
		String.raw`#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int *score = malloc(sizeof *score);
    if (score == NULL) {
        return 1;
    }
    *score = 100;
    free(score);
    printf("%d\n", *score);        // ERROR: the block no longer exists
    return 0;
}`,
	),
	dangling: code(
		String.raw`#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char *nombre;
} Persona;

int main(void) {
    Persona *p = malloc(sizeof *p);
    if (p == NULL) {
        return 1;
    }
    p->nombre = malloc(4);
    if (p->nombre == NULL) {
        free(p);
        return 1;
    }
    strcpy(p->nombre, "Ana");

    char *nombre = p->nombre;      // préstamo
    free(p->nombre);
    free(p);                       // el dueño desaparece
    printf("%s\n", nombre);        // ERROR: nombre es colgante
    return 0;
}`,
		String.raw`#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char *name;
} Person;

int main(void) {
    Person *p = malloc(sizeof *p);
    if (p == NULL) {
        return 1;
    }
    p->name = malloc(4);
    if (p->name == NULL) {
        free(p);
        return 1;
    }
    strcpy(p->name, "Ann");

    char *name = p->name;          // borrow
    free(p->name);
    free(p);                       // the owner goes away
    printf("%s\n", name);          // ERROR: name is dangling
    return 0;
}`,
	),
	overflow: code(
		String.raw`#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void) {
    const char *nombre = "Ana";
    char *copia = malloc(strlen(nombre));    // ERROR: falta el lugar del '\0'
    if (copia == NULL) {
        return 1;
    }
    strcpy(copia, nombre);                   // escribe 4 bytes en un bloque de 3
    printf("%s\n", copia);
    free(copia);
    return 0;
}`,
		String.raw`#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int main(void) {
    const char *name = "Ann";
    char *copy = malloc(strlen(name));       // ERROR: no room for the '\0'
    if (copy == NULL) {
        return 1;
    }
    strcpy(copy, name);                      // writes 4 bytes into a 3-byte block
    printf("%s\n", copy);
    free(copy);
    return 0;
}`,
	),
	realloc: code(
		String.raw`#include <stdlib.h>

int main(void) {
    size_t capacidad = 4;
    int *datos = malloc(capacidad * sizeof *datos);
    if (datos == NULL) {
        return 1;
    }
    capacidad *= 2;
    datos = realloc(datos, capacidad * sizeof *datos);   // ERROR si falla
    if (datos == NULL) {
        return 1;                  // el bloque original quedó sin dueño
    }
    free(datos);
    return 0;
}`,
		String.raw`#include <stdlib.h>

int main(void) {
    size_t capacity = 4;
    int *data = malloc(capacity * sizeof *data);
    if (data == NULL) {
        return 1;
    }
    capacity *= 2;
    data = realloc(data, capacity * sizeof *data);   // ERROR if it fails
    if (data == NULL) {
        return 1;                  // the original block was left without an owner
    }
    free(data);
    return 0;
}`,
	),
};

type ProgramKey = keyof typeof programs;

/* ---------- Learn: one mechanism per slide, advanced step by step ---------- */

const nm = isEs ? 'nombre' : 'name';
const pName = isEs ? '"Ana\\0"' : '"Ann\\0"';
const ana = isEs ? 'ana' : 'ann';
const personaLbl = isEs ? 'Persona' : 'Person';
const ownedByPerson = t('la persona 0x1000', 'the person 0x1000');

// Persona program states
const ps1: State = {
	frames: [{ label: 'main', vars: [] }, { label: t('crear_persona', 'create_person'), vars: [ptr('p', '0x1000', 'owner', 'P')] }],
	blocks: [{ id: 'P', addr: '0x1000', size: '16 B', label: personaLbl, status: 'live', owner: 'p', fields: [val(nm, '?'), val(t('edad', 'age'), '?')] }],
};
const ps2: State = {
	frames: ps1.frames,
	blocks: [
		{ id: 'P', addr: '0x1000', size: '16 B', label: personaLbl, status: 'live', owner: 'p', fields: [ptr(nm, '0x2000', 'owner', 'N'), val(t('edad', 'age'), '31')] },
		{ id: 'N', addr: '0x2000', size: '4 B', label: 'char[4]', status: 'live', owner: ownedByPerson, value: pName },
	],
};
const ps3: State = {
	frames: [{ label: 'main', vars: [ptr(ana, '0x1000', 'owner', 'P')] }],
	blocks: [{ ...ps2.blocks[0], owner: ana }, ps2.blocks[1]],
};
const ps4: State = {
	frames: [ps3.frames[0], { label: t('imprimir_persona', 'print_person'), vars: [ptr('p', '0x1000', 'borrow', 'P')] }],
	blocks: ps3.blocks,
};
const ps5: State = {
	frames: ps3.frames,
	blocks: [
		{ ...ps3.blocks[0], fields: [ptr(nm, '0x2000', 'dangling', 'N'), val(t('edad', 'age'), '31')] },
		{ ...ps3.blocks[1], status: 'freed', owner: undefined },
	],
};
const ps6: State = {
	frames: [{ label: 'main', vars: [ptr(ana, '0x1000', 'dangling', 'P')] }],
	blocks: [{ ...ps5.blocks[0], status: 'freed', owner: undefined }, ps5.blocks[1]],
};
const ps7: State = {
	frames: [{ label: 'main', vars: [nul(ana)] }],
	blocks: ps6.blocks,
	alert: { kind: 'ok', text: t('0 fugas · 0 dobles liberaciones', '0 leaks · 0 double frees') },
};

// Transfer program states
const ag = isEs ? 'agenda' : 'contacts';
const agSlot = isEs ? 'agenda.personas[0]' : 'contacts.people[0]';
const agCount = isEs ? 'agenda.cantidad' : 'contacts.count';
const ageField = t('edad', 'age');
const ts1: State = {
	frames: [{ label: 'main', vars: [val(agCount, '0'), ptr('p', '0x1000', 'owner', 'T')] }],
	blocks: [{ id: 'T', addr: '0x1000', size: '4 B', label: personaLbl, status: 'live', owner: 'p', fields: [val(ageField, '?')] }],
};
const ts2: State = {
	frames: ts1.frames,
	blocks: [{ ...ts1.blocks[0], fields: [val(ageField, '31')] }],
};
const ts3: State = {
	frames: [{ label: 'main', vars: [ptr(agSlot, '0x1000', 'owner', 'T'), val(agCount, '1'), ptr('p', '0x1000', 'borrow', 'T')] }],
	blocks: [{ ...ts2.blocks[0], owner: ag }],
};
const ts5: State = {
	frames: [{ label: 'main', vars: [nul(agSlot), val(agCount, '1'), ptr('p', '0x1000', 'dangling', 'T')] }],
	blocks: [{ ...ts3.blocks[0], status: 'freed', owner: undefined }],
};

// Leak program states
const ln = isEs ? 'linea' : 'line';
const lineText = (i: number) => (isEs ? `"Linea ${i}"` : `"Line ${i}"`);
const leakBlock = (id: string, addr: string, i: number, status: Block['status'], owner?: string): Block => ({
	id,
	addr,
	size: '32 B',
	label: 'char[32]',
	status,
	owner,
	value: lineText(i),
});
const ls1: State = {
	frames: [{ label: 'main', vars: [val('i', '0'), ptr(ln, '0x1000', 'owner', 'A')] }],
	blocks: [{ ...leakBlock('A', '0x1000', 0, 'live', ln), value: '?' }],
};
const ls2: State = { frames: ls1.frames, blocks: [leakBlock('A', '0x1000', 0, 'live', ln)] };
const ls3: State = { frames: [{ label: 'main', vars: [val('i', '0')] }], blocks: [leakBlock('A', '0x1000', 0, 'leaked')] };
const ls4: State = {
	frames: [{ label: 'main', vars: [val('i', '1'), ptr(ln, '0x1040', 'owner', 'B')] }],
	blocks: [leakBlock('A', '0x1000', 0, 'leaked'), { ...leakBlock('B', '0x1040', 1, 'live', ln), value: '?' }],
};
const ls5: State = {
	frames: [{ label: 'main', vars: [val('i', '1')] }],
	blocks: [leakBlock('A', '0x1000', 0, 'leaked'), leakBlock('B', '0x1040', 1, 'leaked')],
};
const ls6: State = {
	frames: [{ label: 'main', vars: [] }],
	blocks: [leakBlock('A', '0x1000', 0, 'leaked'), leakBlock('B', '0x1040', 1, 'leaked'), leakBlock('C', '0x1080', 2, 'leaked')],
	alert: { kind: 'leak', text: 'LeakSanitizer: Direct leak of 96 byte(s) in 3 object(s)' },
};

// Double free states
const dt = isEs ? 'datos' : 'data';
const dfBlock: Block = { id: 'D', addr: '0x1000', size: '16 B', label: 'int[4]', status: 'live', owner: dt, value: '? ? ? ?' };
const ds1: State = { frames: [{ label: 'main', vars: [ptr(dt, '0x1000', 'owner', 'D')] }], blocks: [dfBlock] };
const ds2: State = { frames: [{ label: 'main', vars: [ptr(dt, '0x1000', 'owner', 'D'), ptr('alias', '0x1000', 'borrow', 'D')] }], blocks: [dfBlock] };
const ds3: State = {
	frames: [{ label: 'main', vars: [ptr(dt, '0x1000', 'dangling', 'D'), ptr('alias', '0x1000', 'dangling', 'D')] }],
	blocks: [{ ...dfBlock, status: 'freed', owner: undefined }],
};
const ds4: State = { ...ds3, alert: { kind: 'error', text: 'AddressSanitizer: attempting double-free on 0x1000' } };

// Use after free states
const sc = isEs ? 'puntaje' : 'score';
const uBlock: Block = { id: 'U', addr: '0x1000', size: '4 B', label: 'int', status: 'live', owner: sc, value: '?' };
const us1: State = { frames: [{ label: 'main', vars: [ptr(sc, '0x1000', 'owner', 'U')] }], blocks: [uBlock] };
const us2: State = { frames: us1.frames, blocks: [{ ...uBlock, value: '100' }] };
const us3: State = {
	frames: [{ label: 'main', vars: [ptr(sc, '0x1000', 'dangling', 'U')] }],
	blocks: [{ ...uBlock, value: '100', status: 'freed', owner: undefined }],
};
const us4: State = { ...us3, alert: { kind: 'error', text: 'AddressSanitizer: heap-use-after-free · READ of size 4 · programa.c:11' } };

// Dangling borrow states
const dgP = (status: Block['status'], field: Slot): Block => ({
	id: 'P',
	addr: '0x1000',
	size: '8 B',
	label: personaLbl,
	status,
	owner: status === 'live' ? 'p' : undefined,
	fields: [field],
});
const dgN = (status: Block['status']): Block => ({
	id: 'N',
	addr: '0x2000',
	size: '4 B',
	label: 'char[4]',
	status,
	owner: status === 'live' ? ownedByPerson : undefined,
	value: pName,
});
const gs1: State = { frames: [{ label: 'main', vars: [ptr('p', '0x1000', 'owner', 'P')] }], blocks: [dgP('live', val(nm, '?'))] };
const gs2: State = { frames: gs1.frames, blocks: [dgP('live', ptr(nm, '0x2000', 'owner', 'N')), dgN('live')] };
const gs3: State = {
	frames: [{ label: 'main', vars: [ptr('p', '0x1000', 'owner', 'P'), ptr(nm, '0x2000', 'borrow', 'N')] }],
	blocks: gs2.blocks,
};
const gs4: State = {
	frames: [{ label: 'main', vars: [ptr('p', '0x1000', 'owner', 'P'), ptr(nm, '0x2000', 'dangling', 'N')] }],
	blocks: [dgP('live', ptr(nm, '0x2000', 'dangling', 'N')), dgN('freed')],
};
const gs5: State = {
	frames: [{ label: 'main', vars: [ptr('p', '0x1000', 'dangling', 'P'), ptr(nm, '0x2000', 'dangling', 'N')] }],
	blocks: [dgP('freed', ptr(nm, '0x2000', 'dangling', 'N')), dgN('freed')],
};
const gs6: State = { ...gs5, alert: { kind: 'error', text: 'AddressSanitizer: heap-use-after-free · programa.c:24' } };

// Off-by-one overflow states
const cp = isEs ? 'copia' : 'copy';
const letters = isEs ? ['A', 'n', 'a'] : ['A', 'n', 'n'];
const literal: Block = {
	id: 'L',
	addr: '0x0400',
	size: '4 B',
	label: t('literal de cadena', 'string literal'),
	status: 'static',
	cells: [...letters.map((v) => ({ v })), { v: '\\0' }],
};
const os1: State = { frames: [{ label: 'main', vars: [ptr(nm, '0x0400', 'borrow', 'L')] }], blocks: [literal] };
const os2: State = {
	frames: [{ label: 'main', vars: [ptr(nm, '0x0400', 'borrow', 'L'), ptr(cp, '0x1000', 'owner', 'C')] }],
	blocks: [literal, { id: 'C', addr: '0x1000', size: '3 B', label: 'char[3]', status: 'live', owner: cp, cells: [{ v: '?' }, { v: '?' }, { v: '?' }] }],
};
const os3: State = {
	frames: os2.frames,
	blocks: [literal, { ...os2.blocks[1], cells: [...letters.map((v) => ({ v })), { v: '\\0', out: true }] }],
	alert: { kind: 'error', text: 'AddressSanitizer: heap-buffer-overflow · WRITE of size 4 · located 0 bytes after 3-byte region' },
};
const os4: State = {
	frames: [{ label: 'main', vars: [ptr(nm, '0x0400', 'borrow', 'L'), ptr(cp, '0x1000', 'dangling', 'C')] }],
	blocks: [literal, { ...os3.blocks[1], status: 'freed', owner: undefined }],
};

// realloc states
const cap = isEs ? 'capacidad' : 'capacity';
const rBlock: Block = { id: 'R', addr: '0x1000', size: '16 B', label: 'int[4]', status: 'live', owner: dt, value: '? ? ? ?' };
const rs1: State = { frames: [{ label: 'main', vars: [val(cap, '4'), ptr(dt, '0x1000', 'owner', 'R')] }], blocks: [rBlock] };
const rs2: State = { frames: [{ label: 'main', vars: [val(cap, '8'), ptr(dt, '0x1000', 'owner', 'R')] }], blocks: [rBlock] };
const rs3: State = { frames: [{ label: 'main', vars: [val(cap, '8'), nul(dt)] }], blocks: [{ ...rBlock, status: 'leaked', owner: undefined }] };
const rs4: State = { ...rs3, alert: { kind: 'leak', text: t('Fuga: 16 bytes sin dueño en 0x1000', 'Leak: 16 bytes without an owner at 0x1000') } };

type LearnSlide = { kicker: string; title: string; lead: string; program: ProgramKey; steps: Step[] };

const learn: LearnSlide[] = [
	{
		kicker: t('Propiedad', 'Ownership'),
		title: t('Un bloque, un dueño: crear, prestar, destruir', 'One block, one owner: create, borrow, destroy'),
