    int values[3] = { 1, 2, 3 };
    int *p = values;
    free(p);
    return 0;
}`,
		),
		options: errorOpts,
		correct: 4,
		reason: t(
			'p apunta a un arreglo con duración automática. Solo se puede pasar a free lo que devolvieron malloc, calloc o realloc (o NULL).',
			'p points to an array with automatic storage duration. You may only pass to free what malloc, calloc or realloc returned (or NULL).',
		),
	},
	{
		prompt: t('Si realloc falla, ¿qué error aparece?', 'If realloc fails, which error appears?'),
		snippet: code(
			String.raw`#include <stdlib.h>

int main(void) {
    int *datos = malloc(8 * sizeof *datos);
    if (datos == NULL) {
        return 1;
    }
    datos = realloc(datos, 16 * sizeof *datos);
    if (datos == NULL) {
        return 1;
    }
    free(datos);
    return 0;
}`,
			String.raw`#include <stdlib.h>

int main(void) {
    int *data = malloc(8 * sizeof *data);
    if (data == NULL) {
        return 1;
    }
    data = realloc(data, 16 * sizeof *data);
    if (data == NULL) {
        return 1;
    }
    free(data);
    return 0;
}`,
		),
		options: errorOpts,
		correct: 0,
		reason: t(
			'NULL pisa la única dirección del bloque original, que queda sin dueño: una fuga. Usa un puntero temporal para el resultado de realloc.',
			'NULL overwrites the only address of the original block, which is left without an owner: a leak. Use a temporary pointer for the result of realloc.',
		),
	},
];

const labels = {
	kind: {
		owner: t('dueño', 'owner'),
		borrow: t('préstamo', 'borrow'),
		dangling: t('colgante', 'dangling'),
		null: 'NULL',
		value: '',
	},
	status: {
		live: t('vivo', 'live'),
		freed: t('liberado', 'freed'),
		leaked: t('fuga: sin dueño', 'leak: no owner'),
		static: t('estático: no vino de malloc', 'static: not from malloc'),
	},
	ownerPrefix: t('Dueño: ', 'Owner: '),
	stepOf: t('Paso {n} de {m}', 'Step {n} of {m}'),
	correct: t('Correcto. ', 'Correct. '),
	wrong: t('No es así. ', 'Not quite. '),
	showAfter: t('Ver transición', 'Show transition'),
	showBefore: t('Volver al estado anterior', 'Back to the previous state'),
	score: t('Respondiste bien {n} de {m}.', 'You got {n} of {m} right.'),
	yourAnswer: t('Tu respuesta: ', 'Your answer: '),
	noAnswer: t('sin responder', 'no answer'),
	rightAnswer: t('Respuesta correcta: ', 'Correct answer: '),
	answered: t('Respondidas: {n} de {m}', 'Answered: {n} of {m}'),
	modes: { learn: t('Aprender', 'Learn'), practice: t('Practicar', 'Practice'), assess: t('Evaluar', 'Assess') },
};

const data = {
	learn: learn.map((s) => ({ steps: s.steps })),
	practice: practice.map((p) => ({ before: p.before, after: p.after, correct: p.correct, reason: p.reason, options: p.options })),
	assess: assess.map((a) => ({ correct: a.correct, reason: a.reason, options: a.options, prompt: a.prompt })),
	labels,
};
const dataJson = JSON.stringify(data).replace(/</g, '\\u003c');

const lines = (src: string) => src.split('\n');
const modes = [
	{ id: 'learn', label: labels.modes.learn },
	{ id: 'practice', label: labels.modes.practice },
	{ id: 'assess', label: labels.modes.assess },
];
---

<div class="cv-screen" data-presentation="ciclo-de-vida-objetos-c" data-lang={lang}>
	<div class="cv-shell">
		<nav class="cv-nav" aria-label={t('Controles de navegación', 'Navigation controls')}>
			<div class="cv-seg" role="radiogroup" aria-label={t('Modo de la presentación', 'Presentation mode')}>
				{
					modes.map((m, i) => (
						<label class="cv-seg-opt">
							<input type="radio" name="cvMode" value={m.id} checked={i === 0} />
							<span>{m.label}</span>
						</label>
					))
				}
			</div>
			<div class="cv-nav-group">
				<button class="cv-btn" id="cvPrevBtn" aria-label={t('Diapositiva anterior', 'Previous slide')} disabled>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="m15 18-6-6 6-6"></path>
					</svg>
					<span>{t('Anterior', 'Previous')}</span>
				</button>
				<span class="cv-counter" id="cvCounter" aria-live="polite">{labels.modes.learn} · 1 / {learn.length}</span>
				<button class="cv-btn" id="cvNextBtn" aria-label={t('Siguiente diapositiva', 'Next slide')}>
					<span>{t('Siguiente', 'Next')}</span>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="m9 18 6-6-6-6"></path>
					</svg>
				</button>
			</div>
		</nav>

		<main class="cv-viewport">
			<!-- Aprender / Learn -->
			<div class="cv-mode" data-mode="learn">
				{
					learn.map((s, i) => (
						<section class:list={['cv-slide', { 'is-active': i === 0 }]} data-slide={i + 1} data-kind="learn" data-index={i}>
							<div class="cv-head">
								<span class="cv-kicker">{t('Aprender', 'Learn')} · {s.kicker}</span>
								<h2 class="cv-title">{s.title}</h2>
								<p class="cv-lead">{s.lead}</p>
							</div>
							<div class="cv-grid">
								<pre class="cv-code" aria-label={t('Código del programa', 'Program code')}><code>{lines(programs[s.program]).map((l, n) => <span class="cv-line" data-line={n + 1}><span class="cv-ln" aria-hidden="true">{n + 1}</span>{l || ' '}</span>)}</code></pre>
								<div class="cv-mem" data-mem>
									<div class="cv-col">
										<span class="cv-col-label">{t('Pila (variables)', 'Stack (variables)')}</span>
										<div data-stack></div>
									</div>
									<div class="cv-col">
										<span class="cv-col-label">{t('Bloques', 'Blocks')}</span>
										<div data-heap></div>
									</div>
									<svg class="cv-arrows" aria-hidden="true"></svg>
								</div>
							</div>
							<div class="cv-alert" data-alert hidden></div>
							<div class="cv-steps">
								<button class="cv-btn" data-act="prev" aria-label={t('Paso anterior', 'Previous step')}>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="m15 18-6-6 6-6"></path>
									</svg>
								</button>
								<span class="cv-step-label" data-step-label></span>
								<button class="cv-btn cv-btn-primary" data-act="next" aria-label={t('Siguiente paso', 'Next step')}>
									<span>{t('Siguiente paso', 'Next step')}</span>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="m9 18 6-6-6-6"></path>
									</svg>
								</button>
								<button class="cv-btn" data-act="reset" aria-label={t('Reiniciar los pasos', 'Restart the steps')}>
									<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
										<path d="M3 3v5h5"></path>
									</svg>
								</button>
							</div>
							<p class="cv-explain" data-explain aria-live="polite"></p>
						</section>
					))
				}
				<p class="cv-note">{t('Las direcciones (0x1000, 0x2000…) son ilustrativas: cambian en cada ejecución.', 'Addresses (0x1000, 0x2000…) are illustrative: they change on every run.')}</p>
			</div>

			<!-- Practicar / Practice -->
			<div class="cv-mode" data-mode="practice" hidden>
				{
					practice.map((p, i) => (
						<section class:list={['cv-slide', { 'is-active': i === 0 }]} data-slide={i + 1} data-kind="practice" data-index={i}>
							<div class="cv-head">
								<span class="cv-kicker">{t('Practicar', 'Practice')} · {t('Predice el siguiente estado', 'Predict the next state')}</span>
								<h2 class="cv-title">{p.prompt}</h2>
							</div>
							<div class="cv-grid">
								<pre class="cv-code" aria-label={t('Código del programa', 'Program code')}><code>{lines(programs[p.program]).map((l, n) => <span class:list={['cv-line', { 'is-current': n + 1 === p.line }]} data-line={n + 1}><span class="cv-ln" aria-hidden="true">{n + 1}</span>{l || ' '}</span>)}</code></pre>
								<div class="cv-mem" data-mem>
									<div class="cv-col">
										<span class="cv-col-label">{t('Pila (variables)', 'Stack (variables)')}</span>
										<div data-stack></div>
									</div>
									<div class="cv-col">
										<span class="cv-col-label">{t('Bloques', 'Blocks')}</span>
										<div data-heap></div>
									</div>
									<svg class="cv-arrows" aria-hidden="true"></svg>
								</div>
							</div>
							<div class="cv-options" role="group" aria-label={t('Opciones', 'Options')}>
								{p.options.map((o, k) => (
									<button class="cv-opt" data-opt={k}>{o}</button>
								))}
							</div>
							<p class="cv-feedback" data-feedback aria-live="polite"></p>
							<button class="cv-btn" data-act="transition" disabled>{labels.showAfter}</button>
						</section>
					))
				}
			</div>

			<!-- Evaluar / Assess -->
			<div class="cv-mode" data-mode="assess" hidden>
				{
					assess.map((a, i) => (
						<section class:list={['cv-slide', { 'is-active': i === 0 }]} data-slide={i + 1} data-kind="assess" data-index={i}>
							<div class="cv-head">
								<span class="cv-kicker">{t('Evaluar', 'Assess')} · {t('Pregunta', 'Question')} {i + 1} / {assess.length}</span>
								<h2 class="cv-title">{a.prompt}</h2>
							</div>
							<pre class="cv-code cv-code-static"><code>{lines(a.snippet).map((l, n) => <span class="cv-line"><span class="cv-ln" aria-hidden="true">{n + 1}</span>{l || ' '}</span>)}</code></pre>
							<div class="cv-options" role="group" aria-label={t('Opciones', 'Options')}>
								{a.options.map((o, k) => (
									<button class="cv-opt" data-pick={k} aria-pressed="false">{o}</button>
								))}
							</div>
						</section>
					))
				}
				<section class="cv-slide" data-slide={assess.length + 1} data-kind="result">
					<div class="cv-head">
						<span class="cv-kicker">{t('Evaluar', 'Assess')} · {t('Resultado', 'Result')}</span>
						<h2 class="cv-title">{t('Califica tus respuestas', 'Grade your answers')}</h2>
						<p class="cv-lead" data-answered></p>
					</div>
					<div class="cv-steps">
						<button class="cv-btn cv-btn-primary" data-act="grade">{t('Calificar', 'Grade')}</button>
						<button class="cv-btn" data-act="retry">{t('Reiniciar la evaluación', 'Restart the assessment')}</button>
					</div>
					<div aria-live="polite">
						<p class="cv-score" data-score></p>
						<ol class="cv-results" data-results></ol>
					</div>
				</section>
			</div>
		</main>
	</div>
</div>

<script is:inline type="application/json" id="cvData" set:html={dataJson}></script>

<style>
	.cv-shell {
		width: 100%;
		max-width: none;
		margin: 0;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.cv-screen {
		min-height: calc(100dvh - var(--site-header-height, 0px));
		display: flex;
		flex-direction: column;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-body);
	}

	.cv-viewport { display: flex; flex-direction: column; justify-content: center; }

	.cv-viewport {
		flex: 1;
	}

	@media (min-width: 1440px) { .cv-viewport { zoom: 1.08; } }
	@media (min-width: 1680px) { .cv-viewport { zoom: 1.16; } }
	@media (min-width: 1920px) { .cv-viewport { zoom: 1.25; } }

	.cv-nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-3);
		padding: var(--space-3) var(--space-6);
		background: var(--color-surface);
	}

	.cv-nav-group {
		display: flex;
		align-items: center;
		gap: var(--space-3);
	}

	/* Segmented control ported from Organic/styles.css (.seg / .seg-opt). */
	.cv-seg {
		display: inline-flex;
		overflow: hidden;
		border: 1px solid var(--color-divider);
		border-radius: 999px;
		background: var(--color-bg);
	}

	.cv-seg-opt {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		padding: var(--space-2) var(--space-4);
		font-size: 13px;
		font-weight: 600;
		cursor: pointer;
	}

	.cv-seg-opt input {
		position: absolute;
		opacity: 0;
		width: 0;
		height: 0;
		pointer-events: none;
	}

	.cv-seg-opt + .cv-seg-opt { border-left: 1px solid var(--color-divider); }
	.cv-seg-opt:has(input:checked) { background: var(--color-accent); color: var(--color-bg); }
	.cv-seg-opt:not(:has(input:checked)):hover { background: color-mix(in srgb, var(--color-text) 7%, transparent); }
	.cv-seg-opt:has(input:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: -2px; }

	.cv-btn {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-4);
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 600;
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-divider);
		border-radius: 999px;
		cursor: pointer;
		transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
	}

	.cv-btn:hover:not(:disabled) {
		border-color: var(--color-accent);
		color: var(--color-accent-700);
	}

	.cv-btn:focus-visible,
	.cv-opt:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.cv-btn:disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}

	.cv-btn-primary {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-bg);
	}

	.cv-btn-primary:hover:not(:disabled) {
		background: var(--color-accent-600);
		border-color: var(--color-accent-600);
		color: var(--color-bg);
	}

	.cv-counter {
		font-size: 13px;
		font-weight: 700;
		color: color-mix(in srgb, var(--color-text) 60%, transparent);
	}

	.cv-mode[hidden] { display: none; }

	.cv-slide {
		display: none;
		padding: var(--space-6) var(--space-8);
		width: 100%;
	}

	.cv-slide.is-active {
		display: block;
		animation: cvFade 0.25s ease-out;
	}

	@keyframes cvFade {
		from { opacity: 0; transform: translateY(6px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.cv-head { margin-bottom: var(--space-4); }

	.cv-kicker {
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent-700);
	}

	.cv-title {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: 26px;
		line-height: 1.2;
		margin: var(--space-1) 0 var(--space-2);
	}

	.cv-lead {
		font-size: 15px;
		line-height: 1.5;
		margin: 0;
		max-width: 72ch;
		color: color-mix(in srgb, var(--color-text) 75%, transparent);
	}

	.cv-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
		gap: var(--space-4);
		align-items: start;
	}

	.cv-code {
		position: relative;
		margin: 0;
		max-height: 420px;
		overflow: auto;
		padding: var(--space-3) 0;
		background: var(--color-surface);
		border-radius: var(--radius-lg);
		font-family: monospace;
		font-size: 12.5px;
		line-height: 1.55;
	}

	.cv-code-static {
		max-height: none;
		margin-bottom: var(--space-4);
	}

	.cv-line {
		display: block;
		padding: 0 var(--space-3) 0 0;
		white-space: pre;
		transition: background 0.2s ease;
	}

	.cv-line.is-current {
		background: color-mix(in srgb, var(--color-accent) 18%, transparent);
		box-shadow: inset 3px 0 0 var(--color-accent);
	}

	.cv-ln {
		display: inline-block;
		width: 3.5ch;
		margin-right: var(--space-2);
		text-align: right;
		color: var(--color-neutral-600);
		user-select: none;
	}

	.cv-mem {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: var(--space-8);
		padding: var(--space-4) var(--space-8) var(--space-4) var(--space-4);
		background: var(--color-surface);
		border-radius: var(--radius-lg);
		min-height: 220px;
	}

	.cv-col { display: flex; flex-direction: column; gap: var(--space-2); }

	.cv-col > div { display: flex; flex-direction: column; gap: var(--space-3); }

	.cv-col-label {
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-neutral-600);
	}

	.cv-arrows {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}

</style>

<style is:global>
	/* Elements built by the script carry no scope attribute, so their styles live here. */
	.cv-arrows path { fill: none; stroke-width: 2.25; stroke-linecap: round; }
	.cv-arrows path.is-head { stroke-linejoin: round; }
	.cv-arrows .k-owner { stroke: var(--color-accent-2-700); }
	.cv-arrows .k-borrow { stroke: var(--color-accent-2); stroke-dasharray: 6 5; }
	.cv-arrows .k-dangling { stroke: var(--color-accent); stroke-dasharray: 3 5; }
	.cv-arrows .is-head { stroke-dasharray: none; }

	.cv-frame {
		border-radius: var(--radius-md);
		background: var(--color-bg);
		padding: var(--space-2) var(--space-3);
		box-shadow: var(--shadow-sm);
	}

	.cv-frame-label {
		display: block;
		font-size: 11px;
		font-weight: 700;
		color: var(--color-accent-700);
		margin-bottom: var(--space-1);
		font-family: monospace;
	}

	.cv-var,
	.cv-field {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-1) var(--space-2);
		padding: var(--space-1) 0;
		font-size: 13px;
	}

	.cv-var-name { font-family: monospace; font-weight: 700; }
	.cv-var-value { font-family: monospace; }

	.cv-tag {
		font-size: 11px;
		font-weight: 700;
		padding: 0 var(--space-2);
		border-radius: 999px;
		background: var(--color-neutral-200);
		color: var(--color-neutral-800);
	}

	[data-kind='owner'] > .cv-tag { background: var(--color-accent-2-100); color: var(--color-accent-2-800); }
	[data-kind='borrow'] > .cv-tag { background: var(--color-accent-2-100); color: var(--color-accent-2-700); }
	[data-kind='dangling'] > .cv-tag { background: var(--color-accent-100); color: var(--color-accent-800); }
	[data-kind='dangling'] > .cv-var-value { color: var(--color-accent-700); text-decoration: line-through; }

	.cv-block {
		border-radius: var(--radius-md);
		background: var(--color-bg);
		border: 2px solid var(--color-accent-2);
		padding: var(--space-2) var(--space-3);
		transition: border-color 0.3s ease, opacity 0.3s ease, background 0.3s ease;
	}

	.cv-block[data-status='freed'] {
		border-style: dashed;
		border-color: var(--color-neutral-400);
		opacity: 0.6;
	}

	.cv-block[data-status='leaked'] {
		border-color: var(--color-accent);
		background: var(--color-accent-100);
	}

	.cv-block[data-status='static'] {
		border-color: var(--color-neutral-400);
	}

	.cv-block-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-2);
		font-size: 12px;
	}

	.cv-block-addr { font-family: monospace; font-weight: 700; }
	.cv-block-meta { color: var(--color-neutral-600); }

	.cv-block-status {
		display: block;
		font-size: 11px;
		font-weight: 700;
		margin-top: var(--space-1);
		color: var(--color-accent-2-700);
	}

	.cv-block[data-status='freed'] .cv-block-status { color: var(--color-neutral-600); }
	.cv-block[data-status='leaked'] .cv-block-status { color: var(--color-accent-800); }
	.cv-block[data-status='static'] .cv-block-status { color: var(--color-neutral-600); }

	.cv-block-value {
		font-family: monospace;
		font-size: 14px;
		margin-top: var(--space-1);
	}

	.cv-cells { display: flex; gap: var(--space-1); margin-top: var(--space-2); }

	.cv-cell {
		min-width: 2.2em;
		padding: var(--space-1);
		text-align: center;
		font-family: monospace;
		font-size: 13px;
		border-radius: var(--radius-sm);
		background: var(--color-surface);
	}

	.cv-cell.is-out {
		background: var(--color-accent);
		color: var(--color-bg);
		outline: 2px dashed var(--color-accent-700);
		outline-offset: 2px;
	}

	.cv-flash .cv-block,
	.cv-flash .cv-frame {
		animation: cvPulse 0.6s ease-out;
	}

	@keyframes cvPulse {
		from { transform: scale(0.97); opacity: 0.4; }
		to { transform: scale(1); opacity: 1; }
	}

	.cv-alert {
		margin-top: var(--space-3);
		padding: var(--space-2) var(--space-4);
		border-radius: var(--radius-md);
		font-family: monospace;
		font-size: 13px;
		background: var(--color-accent-100);
		color: var(--color-accent-800);
	}

	.cv-alert[data-kind='ok'] { background: var(--color-accent-2-100); color: var(--color-accent-2-800); }

	.cv-steps {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3);
		margin-top: var(--space-4);
	}

	.cv-step-label { font-size: 13px; font-weight: 700; color: var(--color-neutral-600); }

	.cv-explain {
		margin: var(--space-3) 0 0;
		max-width: 80ch;
		font-size: 15px;
		line-height: 1.55;
	}

	.cv-note {
		padding: 0 var(--space-8) var(--space-4);
		margin: 0;
		font-size: 12px;
		color: var(--color-neutral-600);
	}

	.cv-options {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}

	.cv-opt {
		padding: var(--space-2) var(--space-4);
		font-family: var(--font-body);
		font-size: 14px;
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-divider);
		border-radius: 999px;
		cursor: pointer;
	}

	.cv-opt:hover:not(:disabled) { border-color: var(--color-accent); color: var(--color-accent-700); }
	.cv-opt:disabled { cursor: default; }
	.cv-opt[aria-pressed='true'] { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-bg); }
	.cv-opt.is-right { background: var(--color-accent-2-100); border-color: var(--color-accent-2-700); color: var(--color-accent-2-800); }
	.cv-opt.is-wrong { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-800); }

	.cv-feedback {
		min-height: 1.5em;
		margin: var(--space-3) 0;
		max-width: 80ch;
		font-size: 15px;
		line-height: 1.55;
	}

	.cv-score {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: 22px;
		margin: var(--space-4) 0 var(--space-2);
	}

	.cv-results {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding-left: var(--space-6);
		max-width: 80ch;
		font-size: 14px;
		line-height: 1.5;
	}

	.cv-results li.is-right::marker { color: var(--color-accent-2-700); }
	.cv-results li.is-wrong::marker { color: var(--color-accent); }
	.cv-results strong { display: block; }

	@media (max-width: 900px) {
		.cv-grid { grid-template-columns: minmax(0, 1fr); }
		.cv-code { max-height: 260px; }
	}

	@media (max-width: 640px) {
		.cv-nav { padding: var(--space-3) var(--space-4); }
		.cv-slide { padding: var(--space-4); }
		.cv-note { padding: 0 var(--space-4) var(--space-4); }
		.cv-title { font-size: 21px; }
		.cv-mem { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); }
		.cv-btn span { display: none; }
	}
</style>

<script>
	type Kind = 'owner' | 'borrow' | 'dangling' | 'null' | 'value';
	type Slot = { name: string; value: string; kind: Kind; target?: string };
	type Block = {
		id: string;
		addr: string;
		size: string;
		label: string;
		status: 'live' | 'freed' | 'leaked' | 'static';
		owner?: string;
		fields?: Slot[];
		cells?: { v: string; out?: boolean }[];
		value?: string;
	};
	type State = { frames: { label: string; vars: Slot[] }[]; blocks: Block[]; alert?: { kind: string; text: string } };
	type Data = {
		learn: { steps: { lines: number[]; text: string; state: State }[] }[];
		practice: { before: State; after: State; correct: number; reason: string; options: string[] }[];
		assess: { correct: number; reason: string; options: string[]; prompt: string }[];
		labels: {
			kind: Record<Kind, string>;
			status: Record<Block['status'], string>;
			ownerPrefix: string;
			stepOf: string;
			correct: string;
			wrong: string;
			showAfter: string;
			showBefore: string;
			score: string;
			yourAnswer: string;
			noAnswer: string;
			rightAnswer: string;
			answered: string;
			modes: Record<string, string>;
		};
	};

	const screen = document.querySelector<HTMLElement>('.cv-screen');
	const dataEl = document.getElementById('cvData');

	if (screen && dataEl?.textContent) {
		const data = JSON.parse(dataEl.textContent) as Data;
		const L = data.labels;
		const SVG_NS = 'http://www.w3.org/2000/svg';
		const fill = (tpl: string, n: number, m: number) => tpl.replace('{n}', String(n)).replace('{m}', String(m));

		function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
			const node = document.createElement(tag);
			if (cls) node.className = cls;
			if (text !== undefined) node.textContent = text;
			return node;
		}

		function slotRow(slot: Slot, cls: string) {
			const row = el('div', cls);
			row.dataset.kind = slot.kind;
			if (slot.target && slot.kind !== 'null') row.dataset.target = slot.target;
			row.append(el('span', 'cv-var-name', slot.name), el('span', 'cv-var-value', slot.value));
			const tag = L.kind[slot.kind];
			if (tag) row.append(el('span', 'cv-tag', tag));
			return row;
		}

		function drawArrows(mem: HTMLElement) {
			const svg = mem.querySelector('svg');
			if (!svg) return;
			svg.replaceChildren();
			const box = mem.getBoundingClientRect();
			if (!box.width || !mem.offsetWidth) return;
			// CSS zoom on the viewport scales client rects; normalize back to layout pixels.
			const scale = box.width / mem.offsetWidth;
			svg.setAttribute('viewBox', `0 0 ${mem.offsetWidth} ${mem.offsetHeight}`);
			mem.querySelectorAll<HTMLElement>('[data-target]').forEach((src) => {
				const target = mem.querySelector<HTMLElement>(`[data-block="${src.dataset.target}"]`);
				if (!target) return;
				const r = src.getBoundingClientRect();
				const tr = target.getBoundingClientRect();
				const sx = (r.right - box.left) / scale;
				const sy = (r.top + r.height / 2 - box.top) / scale;
				const tl = (tr.left - box.left) / scale;
				const trr = (tr.right - box.left) / scale;
				const ty = (tr.top - box.top) / scale + 16;
				let d: string;
				let head: string;
				if (tl > sx + 12) {
					const dx = Math.max(24, (tl - sx) / 2);
					d = `M ${sx} ${sy} C ${sx + dx} ${sy}, ${tl - dx} ${ty}, ${tl - 2} ${ty}`;
					head = `M ${tl - 10} ${ty - 6} L ${tl - 2} ${ty} L ${tl - 10} ${ty + 6}`;
				} else {
					const ex = Math.max(sx, trr) + 26;
					d = `M ${sx} ${sy} C ${ex} ${sy}, ${ex} ${ty}, ${trr + 2} ${ty}`;
					head = `M ${trr + 10} ${ty - 6} L ${trr + 2} ${ty} L ${trr + 10} ${ty + 6}`;
				}
				const kind = `k-${src.dataset.kind}`;
				const line = document.createElementNS(SVG_NS, 'path');
				line.setAttribute('d', d);
				line.setAttribute('class', kind);
				const tip = document.createElementNS(SVG_NS, 'path');
				tip.setAttribute('d', head);
				tip.setAttribute('class', `${kind} is-head`);
				svg.append(line, tip);
			});
		}

		function renderState(slide: HTMLElement, state: State, flash = false) {
			const mem = slide.querySelector<HTMLElement>('[data-mem]');
			const stack = mem?.querySelector<HTMLElement>('[data-stack]');
			const heap = mem?.querySelector<HTMLElement>('[data-heap]');
			if (!mem || !stack || !heap) return;
			stack.replaceChildren(
				...state.frames.map((f) => {
					const frame = el('div', 'cv-frame');
					frame.append(el('span', 'cv-frame-label', f.label));
					f.vars.forEach((v) => frame.append(slotRow(v, 'cv-var')));
					return frame;
				}),
			);
			heap.replaceChildren(
				...state.blocks.map((b) => {
					const block = el('div', 'cv-block');
					block.dataset.block = b.id;
					block.dataset.status = b.status;
					const head = el('div', 'cv-block-head');
					head.append(el('span', 'cv-block-addr', b.addr), el('span', 'cv-block-meta', `${b.label} · ${b.size}`));
					block.append(head);
					const status = b.owner ? `${L.status[b.status]} · ${L.ownerPrefix}${b.owner}` : L.status[b.status];
					block.append(el('span', 'cv-block-status', status));
					b.fields?.forEach((f) => block.append(slotRow(f, 'cv-field')));
					if (b.cells) {
						const cells = el('div', 'cv-cells');
						b.cells.forEach((c) => cells.append(el('span', c.out ? 'cv-cell is-out' : 'cv-cell', c.v)));
						block.append(cells);
					}
					if (b.value !== undefined) block.append(el('div', 'cv-block-value', b.value));
					return block;
				}),
			);
			const alert = slide.querySelector<HTMLElement>('[data-alert]');
			if (alert) {
				alert.hidden = !state.alert;
				alert.textContent = state.alert?.text ?? '';
				alert.dataset.kind = state.alert?.kind ?? '';
			}
			mem.classList.remove('cv-flash');
			if (flash) {
				void mem.offsetWidth;
				mem.classList.add('cv-flash');
			}
			requestAnimationFrame(() => drawArrows(mem));
		}

		/* ---- Learn ---- */
		const learnStep = data.learn.map(() => 0);

		function renderLearn(slide: HTMLElement) {
			const i = Number(slide.dataset.index);
			const steps = data.learn[i].steps;
			const s = learnStep[i];
			const step = steps[s];
			slide.querySelectorAll<HTMLElement>('.cv-line').forEach((line) => {
				line.classList.toggle('is-current', step.lines.includes(Number(line.dataset.line)));
			});
			const code = slide.querySelector<HTMLElement>('.cv-code');
			const first = slide.querySelector<HTMLElement>(`.cv-line[data-line="${step.lines[0]}"]`);
			if (code && first) code.scrollTop = Math.max(0, first.offsetTop - code.clientHeight / 3);
			const label = slide.querySelector('[data-step-label]');
			if (label) label.textContent = fill(L.stepOf, s + 1, steps.length);
			const explain = slide.querySelector('[data-explain]');
			if (explain) explain.textContent = step.text;
			(slide.querySelector('[data-act="prev"]') as HTMLButtonElement).disabled = s === 0;
			(slide.querySelector('[data-act="next"]') as HTMLButtonElement).disabled = s === steps.length - 1;
			renderState(slide, step.state, true);
		}

		screen.querySelectorAll<HTMLElement>('.cv-slide[data-kind="learn"]').forEach((slide) => {
			const i = Number(slide.dataset.index);
			const max = data.learn[i].steps.length - 1;
			slide.querySelector('[data-act="prev"]')?.addEventListener('click', () => {
				learnStep[i] = Math.max(0, learnStep[i] - 1);
				renderLearn(slide);
			});
			slide.querySelector('[data-act="next"]')?.addEventListener('click', () => {
				learnStep[i] = Math.min(max, learnStep[i] + 1);
				renderLearn(slide);
			});
			slide.querySelector('[data-act="reset"]')?.addEventListener('click', () => {
				learnStep[i] = 0;
				renderLearn(slide);
			});
		});

		/* ---- Practice ---- */
		const showingAfter = data.practice.map(() => false);

		function renderPractice(slide: HTMLElement) {
			const i = Number(slide.dataset.index);
			const item = data.practice[i];
			renderState(slide, showingAfter[i] ? item.after : item.before, showingAfter[i]);
		}

		screen.querySelectorAll<HTMLElement>('.cv-slide[data-kind="practice"]').forEach((slide) => {
			const i = Number(slide.dataset.index);
			const item = data.practice[i];
			const opts = slide.querySelectorAll<HTMLButtonElement>('[data-opt]');
			const feedback = slide.querySelector('[data-feedback]');
			const transition = slide.querySelector<HTMLButtonElement>('[data-act="transition"]');
			opts.forEach((btn) => {
				btn.addEventListener('click', () => {
					const pick = Number(btn.dataset.opt);
					const ok = pick === item.correct;
					opts.forEach((o) => {
						o.disabled = true;
						if (Number(o.dataset.opt) === item.correct) o.classList.add('is-right');
					});
					if (!ok) btn.classList.add('is-wrong');
					if (feedback) feedback.textContent = (ok ? L.correct : L.wrong) + item.reason;
					if (transition) transition.disabled = false;
				});
			});
			transition?.addEventListener('click', () => {
				showingAfter[i] = !showingAfter[i];
				transition.textContent = showingAfter[i] ? L.showBefore : L.showAfter;
				renderPractice(slide);
			});
		});

		/* ---- Assess ---- */
		const answers: (number | null)[] = data.assess.map(() => null);
		const resultSlide = screen.querySelector<HTMLElement>('.cv-slide[data-kind="result"]');

		function updateAnswered() {
			const el2 = resultSlide?.querySelector('[data-answered]');
			if (el2) el2.textContent = fill(L.answered, answers.filter((a) => a !== null).length, answers.length);
		}

		screen.querySelectorAll<HTMLElement>('.cv-slide[data-kind="assess"]').forEach((slide) => {
			const i = Number(slide.dataset.index);
			const opts = slide.querySelectorAll<HTMLButtonElement>('[data-pick]');
			opts.forEach((btn) => {
				btn.addEventListener('click', () => {
					answers[i] = Number(btn.dataset.pick);
					opts.forEach((o) => o.setAttribute('aria-pressed', String(o === btn)));
					updateAnswered();
				});
			});
		});

		resultSlide?.querySelector('[data-act="grade"]')?.addEventListener('click', () => {
			const list = resultSlide!.querySelector('[data-results]');
			const score = resultSlide!.querySelector('[data-score]');
			let right = 0;
			const items = data.assess.map((q, i) => {
				const a = answers[i];
				const ok = a === q.correct;
				if (ok) right++;
				const li = el('li', ok ? 'is-right' : 'is-wrong');
				li.append(
					el('strong', '', q.prompt),
					el('span', '', `${L.yourAnswer}${a === null ? L.noAnswer : q.options[a]}. `),
					el('span', '', `${L.rightAnswer}${q.options[q.correct]}. `),
					el('span', '', q.reason),
				);
				return li;
			});
			list?.replaceChildren(...items);
			if (score) score.textContent = fill(L.score, right, data.assess.length);
		});

		resultSlide?.querySelector('[data-act="retry"]')?.addEventListener('click', () => {
			answers.fill(null);
			screen.querySelectorAll('[data-pick]').forEach((o) => o.setAttribute('aria-pressed', 'false'));
			resultSlide!.querySelector('[data-results]')?.replaceChildren();
			const score = resultSlide!.querySelector('[data-score]');
			if (score) score.textContent = '';
			updateAnswered();
			showSlide(1);
		});

		/* ---- Modes and slide navigation ---- */
		const prevBtn = document.getElementById('cvPrevBtn') as HTMLButtonElement | null;
		const nextBtn = document.getElementById('cvNextBtn') as HTMLButtonElement | null;
		const counter = document.getElementById('cvCounter');
		const current: Record<string, number> = { learn: 1, practice: 1, assess: 1 };
		let mode = 'learn';

		function panel() {
			return screen!.querySelector<HTMLElement>(`.cv-mode[data-mode="${mode}"]`);
		}

		function showSlide(target: number) {
			const slides = panel()?.querySelectorAll<HTMLElement>('.cv-slide');
			if (!slides || target < 1 || target > slides.length) return;
			current[mode] = target;
			slides.forEach((s) => s.classList.toggle('is-active', Number(s.dataset.slide) === target));
			const active = slides[target - 1];
			if (counter) counter.textContent = `${L.modes[mode]} · ${target} / ${slides.length}`;
			if (prevBtn) prevBtn.disabled = target === 1;
			if (nextBtn) nextBtn.disabled = target === slides.length;
			if (active.dataset.kind === 'learn') renderLearn(active);
			if (active.dataset.kind === 'practice') renderPractice(active);
			if (active.dataset.kind === 'result') updateAnswered();
		}

		screen.querySelectorAll<HTMLInputElement>('input[name="cvMode"]').forEach((input) => {
			input.addEventListener('change', () => {
				if (!input.checked) return;
				mode = input.value;
				screen.querySelectorAll<HTMLElement>('.cv-mode').forEach((p) => {
					p.hidden = p.dataset.mode !== mode;
				});
				showSlide(current[mode]);
			});
		});

		prevBtn?.addEventListener('click', () => showSlide(current[mode] - 1));
		nextBtn?.addEventListener('click', () => showSlide(current[mode] + 1));

		window.addEventListener('keydown', (e) => {
			const target = e.target as HTMLElement | null;
			if (target && (target.closest('input, textarea, select') || target.isContentEditable)) return;
			if (e.key === 'ArrowRight') showSlide(current[mode] + 1);
			if (e.key === 'ArrowLeft') showSlide(current[mode] - 1);
		});

		window.addEventListener('resize', () => {
			const mem = panel()?.querySelector<HTMLElement>('.cv-slide.is-active [data-mem]');
			if (mem) drawArrows(mem);
		});

		showSlide(1);
	}
</script>
