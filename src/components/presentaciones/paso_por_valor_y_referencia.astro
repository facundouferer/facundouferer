	let selectedLang: keyof typeof traceData = 'c';

	const updateTraceView = () => {
		const langInfo = traceData[selectedLang];
		const stepEl = document.getElementById('pv-sim-step');
		const stackEl = document.getElementById('pv-sim-stack');
		const resultEl = document.getElementById('pv-sim-result');
		const titleEl = document.getElementById('pv-sim-title');

		if (titleEl) titleEl.textContent = langInfo.title;
		if (stepEl) stepEl.textContent = langInfo.steps[currentTraceIndex];
		if (stackEl) stackEl.textContent = langInfo.stacks[currentTraceIndex];
		if (resultEl) resultEl.textContent = langInfo.results[currentTraceIndex];
	};

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;

		document.querySelectorAll('.pv-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});

		document.querySelectorAll('.pv-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});

		const labelEl = document.getElementById('pv-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;

		const prevBtn = document.getElementById('btn-prev-pv') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-pv') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.pv-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-pv')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-pv')?.addEventListener('click', () => goToSlide(currentSlide + 1));

	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	document.querySelectorAll('.pv-lang-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			document.querySelectorAll('.pv-lang-btn').forEach(b => b.classList.remove('active'));
			const targetBtn = e.currentTarget as HTMLElement;
			targetBtn.classList.add('active');
			selectedLang = (targetBtn.dataset.lang || 'c') as keyof typeof traceData;
			currentTraceIndex = 0;
			updateTraceView();
		});
	});

	document.getElementById('btn-next-trace')?.addEventListener('click', () => {
		currentTraceIndex = (currentTraceIndex + 1) % traceData[selectedLang].steps.length;
		updateTraceView();
	});

	goToSlide(1);
	updateTraceView();
</script>
