			stacks: [
				'[main: d=>#101] -> [modify: d=>#101]',
				'[Heap #101: Dog name="Max"]',
				'[main: d=>#101 (Dog name="Max")] (re-assignment local destruida)'
			],
			results: [
				'En proceso...',
				'En proceso...',
				'Resultado final en caller: Dog name="Max" (Atributo mutó, reasignación ignorada)'
			]
		},
		js: {
			title: 'JavaScript: update(user) - Value of Reference',
			steps: [
				'Paso 1: main invoca update(user) pasando la copia de la referencia del objeto.',
				'Paso 2: user.age = 30 modifica las propiedades de la referencia compartida.',
				'Paso 3: user = { age: 99 } reasigna el parámetro local. La referencia externa u no cambia.'
