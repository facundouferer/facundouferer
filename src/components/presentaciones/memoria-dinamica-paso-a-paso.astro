				</div>
				<div class="md-actions">
					<button class="md-btn md-btn-primary" type="button" data-grade>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
						<span>{t('Calificar', 'Grade')}</span>
					</button>
					<button class="md-btn" type="button" data-assess-reset>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg>
						<span>{t('Empezar de nuevo', 'Start over')}</span>
					</button>
				</div>
				<div class="md-results" data-results aria-live="polite"></div>
			</section>
		</main>

		<p class="md-legend">{t('Direcciones ilustrativas: 0x7f.. en la pila, 0x1000 y 0x2000 en el montículo. Se asume que un int ocupa 4 bytes; ? es un valor indeterminado.', 'Illustrative addresses: 0x7f.. on the stack, 0x1000 and 0x2000 on the heap. An int is assumed to take 4 bytes; ? is an indeterminate value.')}</p>
	</div>
</div>

