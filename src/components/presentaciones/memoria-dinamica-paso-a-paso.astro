		padding: var(--space-3) var(--space-4);
		font-family: var(--font-body);
		font-size: 15px;
		color: var(--color-text);
		background: var(--color-bg);
		border: 2px solid var(--color-divider);
		border-radius: var(--radius-md);
		cursor: pointer;
		transition: border-color 0.2s ease, background 0.2s ease;
	}

	.md-opt:hover:not(:disabled) { border-color: var(--color-accent); }
	.md-opt:disabled { cursor: default; }
	.md-opt:disabled:not(.is-right):not(.is-wrong) { opacity: 0.45; }
	.md-opt[aria-pressed='true'] { border-color: var(--color-accent); background: var(--color-accent-100); }
	.md-opt.is-right { border-color: var(--color-accent-2); background: var(--color-accent-2-100); }
	.md-opt.is-wrong { border-color: var(--color-accent); background: var(--color-accent-100); }

	.md-results :global(.md-score) {
		margin: var(--space-4) 0 var(--space-3);
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: 24px;
	}

	.md-results :global(.md-result-list) { display: flex; flex-direction: column; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }

	.md-results :global(.md-result) {
		padding: var(--space-3) var(--space-4);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		border-left: 4px solid var(--color-accent-2);
		font-size: 15px;
		line-height: 1.5;
	}

	.md-results :global(.md-result.is-wrong) { border-left-color: var(--color-accent); }
	.md-results :global(.md-result p) { margin: var(--space-1) 0 0; }
	.md-results :global(.md-result strong) { color: var(--color-accent-2-700); }
	.md-results :global(.md-result.is-wrong strong) { color: var(--color-accent-700); }

	.md-legend {
		margin: 0;
		padding: 0 var(--space-6) var(--space-4);
		font-size: 13px;
		color: color-mix(in srgb, var(--color-text) 60%, transparent);
	}

	@media (max-width: 960px) {
		.md-grid { grid-template-columns: minmax(0, 1fr); }
	}

	@media (max-width: 640px) {
		.md-nav { padding: var(--space-2) var(--space-3); }
		.md-btn span { display: none; }
		.md-modebar { padding: var(--space-3) var(--space-3) 0; }
		.md-slide { padding: var(--space-4) var(--space-3); }
		.md-title { font-size: 23px; }
		.md-memory { grid-template-columns: minmax(0, 1fr); }
		.md-legend { padding: 0 var(--space-3) var(--space-4); }
	}
</style>

<script>
	type Var = { name: string; addr: string; value: string; ptr: boolean };
	type Block = { addr: string; cells: string[]; status: 'live' | 'freed' | 'lost' };
	type MemState = { stack: Var[]; heap: Block[]; out?: string };
	type Step = MemState & { line: number; note: string };
	type Mode = 'learn' | 'practice' | 'assess';

	const screen = document.querySelector<HTMLElement>('.md-screen');

	if (screen) {
		const ui = JSON.parse(screen.dataset.ui ?? '{}') as Record<string, string>;
		const hints = JSON.parse(screen.dataset.hints ?? '{}') as Record<Mode, string>;
		const totals = JSON.parse(screen.dataset.totals ?? '{}') as Record<Mode, number>;
		const fmt = (s: string, vars: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_m, k: string) => String(vars[k] ?? ''));

		const ARROW = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>';

		function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) {
			const node = document.createElement(tag);
			if (cls) node.className = cls;
			if (text !== undefined) node.textContent = text;
			return node;
		}

		// Renders text where `code` spans are delimited by backticks.
		function richText(target: HTMLElement, text: string) {
			target.replaceChildren();
			text.split('`').forEach((part, i) => {
				target.append(i % 2 ? el('code', undefined, part) : document.createTextNode(part));
			});
		}

		function cellAddr(base: string, i: number) {
			return `0x${(parseInt(base, 16) + 4 * i).toString(16)}`;
		}

		function renderMemory(container: HTMLElement, state: MemState, prev?: MemState) {
			container.replaceChildren();
			const freedAddrs = new Set(state.heap.filter((b) => b.status === 'freed').map((b) => b.addr));
			const liveAddrs = new Set(state.heap.filter((b) => b.status === 'live').map((b) => b.addr));

			const stackCol = el('div', 'md-col');
			stackCol.append(el('p', 'md-col-title', ui.stack));
			if (state.stack.length === 0) stackCol.append(el('p', 'md-empty', ui.emptyStack));
			state.stack.forEach((v) => {
				const before = prev?.stack.find((p) => p.name === v.name);
				const card = el('div', 'md-var');
				if (v.ptr) card.classList.add('is-ptr');
				if (v.ptr && v.value === 'NULL') card.classList.add('is-null');
				const dangling = v.ptr && freedAddrs.has(v.value) && !liveAddrs.has(v.value);
				if (dangling) card.classList.add('is-dangling');
				if (prev && (!before || before.value !== v.value)) card.classList.add('is-changed');
				card.append(el('span', 'md-var-name', v.name), el('span', 'md-var-addr', v.addr));
				const value = el('span', 'md-var-value');
				if (v.ptr && v.value !== 'NULL') value.insertAdjacentHTML('beforeend', ARROW);
				value.append(document.createTextNode(v.value));
				if (dangling) value.append(el('span', 'md-tag', ui.dangling));
				card.append(value);
				stackCol.append(card);
			});

			const heapCol = el('div', 'md-col');
			heapCol.append(el('p', 'md-col-title', ui.heap));
			if (state.heap.length === 0) heapCol.append(el('p', 'md-empty', ui.emptyHeap));
			state.heap.forEach((b) => {
				const before = prev?.heap.find((p) => p.addr === b.addr);
				const block = el('div', `md-block is-${b.status}`);
				if (prev && (!before || before.status !== b.status)) block.classList.add('is-changed');
				const head = el('div', 'md-block-head');
				head.append(el('span', undefined, b.addr), el('span', 'md-badge', ui[b.status]));
				const owners = state.stack.filter((v) => v.ptr && v.value === b.addr).map((v) => v.name);
				if (owners.length && b.status === 'live') head.append(el('span', 'md-owner', `${ui.pointedBy} ${owners.join(', ')}`));
				const cells = el('div', 'md-cells');
				b.cells.forEach((value, i) => {
					const cell = el('div', `md-cell${value === '?' ? ' is-unknown' : ''}`);
					if (prev && before && before.status === b.status && before.cells[i] !== value) cell.classList.add('is-changed');
					cell.append(el('span', 'md-cell-addr', `[${i}] ${cellAddr(b.addr, i)}`), el('span', 'md-cell-value', value));
					cells.append(cell);
				});
				block.append(head, cells);
				heapCol.append(block);
			});

			container.append(stackCol, heapCol);
			if (state.out) {
				const out = el('p', 'md-out', `${ui.output}: ${state.out}`);
				if (prev && prev.out !== state.out) out.classList.add('is-changed');
				container.append(out);
			}
		}

		function highlightLine(pre: HTMLElement | null, line: number) {
			if (!pre) return;
			pre.querySelectorAll('.md-line').forEach((l) => l.classList.remove('is-current'));
			const current = pre.querySelector<HTMLElement>(`.md-line[data-line="${line}"]`);
			if (!current) return;
			current.classList.add('is-current');
			const top = current.offsetTop - pre.clientHeight / 2 + current.offsetHeight / 2;
			pre.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
		}

		// Learn: stepped visualizations.
		screen.querySelectorAll<HTMLElement>('.md-slide[data-mode="learn"]').forEach((slide) => {
			const steps = JSON.parse(slide.dataset.steps ?? '[]') as Step[];
			const memory = slide.querySelector<HTMLElement>('[data-memory]');
			const pre = slide.querySelector<HTMLElement>('[data-code]');
			const note = slide.querySelector<HTMLElement>('[data-note]');
			const count = slide.querySelector<HTMLElement>('[data-step-count]');
			const prevBtn = slide.querySelector<HTMLButtonElement>('[data-step-prev]');
			const nextBtn = slide.querySelector<HTMLButtonElement>('[data-step-next]');
			let index = 0;

			function show(i: number, animate: boolean) {
				index = Math.max(0, Math.min(steps.length - 1, i));
				const step = steps[index];
				if (memory) renderMemory(memory, step, animate && index > 0 ? steps[index - 1] : undefined);
				highlightLine(pre, step.line);
				if (note) richText(note, step.note);
				if (count) count.textContent = fmt(ui.step, { n: index + 1, t: steps.length });
				if (prevBtn) prevBtn.disabled = index === 0;
				if (nextBtn) nextBtn.disabled = index === steps.length - 1;
			}

			prevBtn?.addEventListener('click', () => show(index - 1, false));
			nextBtn?.addEventListener('click', () => show(index + 1, true));
			slide.querySelector('[data-step-reset]')?.addEventListener('click', () => show(0, false));
			show(0, false);
		});

		// Practice: predict the next state.
		screen.querySelectorAll<HTMLElement>('.md-slide[data-mode="practice"]').forEach((slide) => {
			const data = JSON.parse(slide.dataset.practice ?? '{}') as { before: MemState; after: MemState; correct: number; reason: string };
			const memory = slide.querySelector<HTMLElement>('[data-memory]');
			const feedback = slide.querySelector<HTMLElement>('[data-feedback]');
			const replay = slide.querySelector<HTMLButtonElement>('[data-replay]');
			const retry = slide.querySelector<HTMLButtonElement>('[data-retry]');
			const options = Array.from(slide.querySelectorAll<HTMLButtonElement>('.md-opt'));
			let timer: number | undefined;

			function transition() {
				if (!memory) return;
				window.clearTimeout(timer);
				renderMemory(memory, data.before);
				timer = window.setTimeout(() => renderMemory(memory, data.after, data.before), 650);
			}

			function reset() {
				window.clearTimeout(timer);
				if (memory) renderMemory(memory, data.before);
				options.forEach((o) => {
					o.disabled = false;
					o.classList.remove('is-right', 'is-wrong');
				});
				if (feedback) {
					feedback.textContent = '';
					feedback.classList.remove('is-right', 'is-wrong');
				}
				if (replay) replay.hidden = true;
				if (retry) retry.hidden = true;
			}

			options.forEach((opt) => {
				opt.addEventListener('click', () => {
					const chosen = Number(opt.dataset.index);
					const ok = chosen === data.correct;
					options.forEach((o) => {
						o.disabled = true;
						if (Number(o.dataset.index) === data.correct) o.classList.add('is-right');
					});
					if (!ok) opt.classList.add('is-wrong');
					if (feedback) {
						richText(feedback, `${ok ? ui.correct : ui.incorrect} ${data.reason}`);
						feedback.classList.toggle('is-right', ok);
						feedback.classList.toggle('is-wrong', !ok);
					}
					if (replay) replay.hidden = false;
					if (retry) retry.hidden = false;
					transition();
				});
			});

			replay?.addEventListener('click', transition);
			retry?.addEventListener('click', () => {
				reset();
				options[0]?.focus();
			});
			reset();
		});

		// Assess: answers are stored silently and graded at the end.
		const answers: (number | null)[] = [];
		const questionSlides = Array.from(screen.querySelectorAll<HTMLElement>('.md-slide[data-question]'));
		questionSlides.forEach((slide) => {
			const q = Number(slide.dataset.question);
			answers[q] = null;
			const saved = slide.querySelector<HTMLElement>('[data-saved]');
			const options = Array.from(slide.querySelectorAll<HTMLButtonElement>('.md-opt'));
			options.forEach((opt) => {
				opt.addEventListener('click', () => {
					answers[q] = Number(opt.dataset.index);
					options.forEach((o) => o.setAttribute('aria-pressed', String(o === opt)));
					if (saved) saved.textContent = ui.selected;
				});
			});
		});

		const resultsSlide = screen.querySelector<HTMLElement>('[data-results-slide]');
		const results = resultsSlide?.querySelector<HTMLElement>('[data-results]');
		const assessData = JSON.parse(resultsSlide?.dataset.assess ?? '[]') as { options: string[]; correct: number; reason: string }[];

		resultsSlide?.querySelector('[data-grade]')?.addEventListener('click', () => {
			if (!results) return;
			results.replaceChildren();
			const missing = answers.filter((a) => a === null).length;
			const score = assessData.filter((q, i) => answers[i] === q.correct).length;
			results.append(el('p', 'md-score', fmt(ui.score, { s: score, t: assessData.length })));
			if (missing > 0) results.append(el('p', 'md-empty', fmt(ui.pending, { n: missing })));
			const list = el('ol', 'md-result-list');
			assessData.forEach((q, i) => {
				const answer = answers[i];
				const ok = answer === q.correct;
				const item = el('li', `md-result${ok ? '' : ' is-wrong'}`);
				item.append(el('strong', undefined, `${ui.question} ${i + 1}: ${ok ? ui.right : ui.wrong}`));
				const mine = el('p');
				richText(mine, `${ui.yourAnswer} ${answer === null ? ui.unanswered : q.options[answer]}`);
				const correct = el('p');
				richText(correct, `${ui.answerWas} ${q.options[q.correct]}`);
				const reason = el('p');
				richText(reason, q.reason);
				item.append(mine, correct, reason);
				list.append(item);
			});
			results.append(list);
		});

		resultsSlide?.querySelector('[data-assess-reset]')?.addEventListener('click', () => {
			answers.fill(null);
			questionSlides.forEach((slide) => {
				slide.querySelectorAll('.md-opt').forEach((o) => o.setAttribute('aria-pressed', 'false'));
				const saved = slide.querySelector<HTMLElement>('[data-saved]');
				if (saved) saved.textContent = '';
			});
			results?.replaceChildren();
			goTo('assess', 1);
		});

		// Deck navigation: one position per mode.
		const prevBtn = screen.querySelector<HTMLButtonElement>('#mdPrevBtn');
		const nextBtn = screen.querySelector<HTMLButtonElement>('#mdNextBtn');
		const counter = screen.querySelector<HTMLElement>('#mdSlideCounter');
		const hint = screen.querySelector<HTMLElement>('#mdModeHint');
		const position: Record<Mode, number> = { learn: 1, practice: 1, assess: 1 };
		let mode: Mode = 'learn';

		function goTo(m: Mode, n: number) {
			const total = totals[m];
			if (n < 1 || n > total) return;
			mode = m;
			position[m] = n;
			screen?.querySelectorAll('.md-slide').forEach((s) => s.classList.remove('is-active'));
			screen?.querySelector(`.md-slide[data-slide="${m}-${n}"]`)?.classList.add('is-active');
			if (counter) counter.textContent = `${n} / ${total}`;
			if (prevBtn) prevBtn.disabled = n === 1;
			if (nextBtn) nextBtn.disabled = n === total;
			if (hint) hint.textContent = hints[m];
		}

		prevBtn?.addEventListener('click', () => goTo(mode, position[mode] - 1));
		nextBtn?.addEventListener('click', () => goTo(mode, position[mode] + 1));

		screen.querySelectorAll<HTMLInputElement>('input[name="mdMode"]').forEach((input) => {
			input.addEventListener('change', () => {
				if (input.checked) goTo(input.value as Mode, position[input.value as Mode]);
			});
		});

		window.addEventListener('keydown', (e) => {
			const target = e.target as HTMLElement | null;
			if (target?.closest('input, textarea, select, [contenteditable="true"]')) return;
			if (e.key === 'ArrowRight') goTo(mode, position[mode] + 1);
			if (e.key === 'ArrowLeft') goTo(mode, position[mode] - 1);
		});

		goTo('learn', 1);
	}
</script>
