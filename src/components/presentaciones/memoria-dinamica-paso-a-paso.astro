								<button class="md-opt" type="button" data-index={k}>{parts(o).map((x, j) => (j % 2 ? <code>{x}</code> : x))}</button>
							))}
						</div>
					</fieldset>
					<p class="md-feedback" data-feedback aria-live="polite"></p>
					<div class="md-actions">
