			{assess.map((a, i) => (
				<section class="md-slide" data-mode="assess" data-slide={`assess-${i + 1}`} data-question={i}>
					<div class="md-head">
						<span class="md-kicker">{t('Evaluar', 'Assess')} · {a.kind} · {i + 1} / {assess.length}</span>
						<h2 class="md-title">{t('Pregunta', 'Question')} {i + 1}</h2>
					</div>
					<div class={`md-card${a.code ? ' md-grid' : ''}`}>
						{a.code && (
							<div class="md-code-panel">
								<span class="md-panel-label">C</span>
								<pre class="md-code"><code>{code[a.code].map((l, n) => <span class="md-line" data-line={n + 1}><span class="md-ln" aria-hidden="true">{n + 1}</span>{l}</span>)}</code></pre>
							</div>
						)}
						<fieldset class="md-quiz">
							<legend class="md-prompt">{parts(a.prompt).map((x, k) => (k % 2 ? <code>{x}</code> : x))}</legend>
							<div class="md-options">
