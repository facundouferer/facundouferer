						</fieldset>
						<p class="md-feedback" data-saved aria-live="polite"></p>
					</div>
				</section>
			))}

			<section
				class="md-slide"
				data-mode="assess"
				data-slide={`assess-${assess.length + 1}`}
				data-results-slide
				data-assess={JSON.stringify(assess.map((a) => ({ options: a.options, correct: a.correct, reason: a.reason })))}
			>
				<div class="md-head">
					<span class="md-kicker">{t('Evaluar', 'Assess')} · {t('Resultado', 'Result')}</span>
					<h2 class="md-title">{t('Tu resultado', 'Your result')}</h2>
