---
interface Props {
	lang?: string;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
const t = (es: string, en: string) => (isEs ? es : en);

// <md-data>
// Identifiers and string literals are localized like the lesson does.
const N: Record<string, string> = {
	numeros: t('numeros', 'numbers'),
	nuevo: t('nuevo', 'bigger'),
	capacidad: t('capacidad', 'capacity'),
	cantidad: t('cantidad', 'count'),
	nuevaCap: t('nueva_capacidad', 'new_capacity'),
	valor: t('valor', 'value'),
	suma: t('suma', 'sum'),
	ventas: t('ventas', 'sales'),
	dias: t('dias', 'days'),
	datos: t('datos', 'data'),
	contadores: t('contadores', 'counters'),
	noMem: t('No hay memoria suficiente\\n', 'Not enough memory\\n'),
	noGrow: t('No se pudo agrandar el arreglo\\n', 'Could not grow the array\\n'),
	report: t('Leidos: %zu (capacidad %zu), suma: %lld\\n', 'Read: %zu (capacity %zu), sum: %lld\\n'),
	wrong: t('Incorrecto: si realloc falla, se pierde el bloque', 'Wrong: if realloc fails, the block is lost'),
	right: t('Correcto: puntero temporal', 'Right: temporary pointer'),
	freeC1: t('ya no apunta a un bloque muerto', 'no longer points to a dead block'),
	freeC2: t('free(NULL): no hace nada, no es un error', 'free(NULL): does nothing, not an error'),
};
const sub = (s: string) => s.replace(/\{(\w+)\}/g, (_m: string, k: string) => N[k] ?? `{${k}}`);
const lines = (rows: string[]) => rows.map(sub);

const code: Record<string, string[]> = {
	malloc: lines([
		'size_t n = 5;',
		'int *{numeros} = malloc(n * sizeof *{numeros});',
		'if ({numeros} == NULL) {',
		'    fprintf(stderr, "{noMem}");',
		'    return 1;',
		'}',
		'for (size_t i = 0; i < n; i++) {',
		'    {numeros}[i] = (int)(i * i);',
		'}',
	]),
	calloc: lines([
		'size_t {dias} = 7;',
		'int *{ventas} = calloc({dias}, sizeof *{ventas});',
		'if ({ventas} == NULL) {',
		'    fprintf(stderr, "{noMem}");',
		'    return 1;',
		'}',
		'{ventas}[2] = 15;',
		'free({ventas});',
	]),
	grow: lines([
		'size_t {nuevaCap} = {capacidad} * 2;',
		'int *{nuevo} = realloc({numeros}, {nuevaCap} * sizeof *{numeros});',
		'if ({nuevo} == NULL) {',
		'    free({numeros});',
		'    return 1;',
		'}',
		'{numeros} = {nuevo};',
		'{capacidad} = {nuevaCap};',
	]),
	lost: lines([
		'// {wrong}',
		'{numeros} = realloc({numeros}, {nuevaCap} * sizeof *{numeros});',
		'',
		'// {right}',
		'int *{nuevo} = realloc({numeros}, {nuevaCap} * sizeof *{numeros});',
		'if ({nuevo} == NULL) {',
		'    free({numeros});',
		'    return 1;',
		'}',
	]),
	free: lines([
		'free({numeros});',
		'{numeros} = NULL;    // {freeC1}',
		'free({numeros});     // {freeC2}',
	]),
	vector: lines([
		'size_t {capacidad} = 4;',
		'size_t {cantidad} = 0;',
		'int *{numeros} = malloc({capacidad} * sizeof *{numeros});',
		'if ({numeros} == NULL) {',
		'    fprintf(stderr, "{noMem}");',
		'    return 1;',
		'}',
		'int {valor};',
		'while (scanf("%d", &{valor}) == 1 && {valor} != 0) {',
		'    if ({cantidad} == {capacidad}) {',
		'        size_t {nuevaCap} = {capacidad} * 2;',
		'        int *{nuevo} = realloc({numeros}, {nuevaCap} * sizeof *{numeros});',
		'        if ({nuevo} == NULL) {',
		'            fprintf(stderr, "{noGrow}");',
		'            free({numeros});',
		'            return 1;',
		'        }',
		'        {numeros} = {nuevo};',
		'        {capacidad} = {nuevaCap};',
		'    }',
		'    {numeros}[{cantidad}] = {valor};',
		'    {cantidad}++;',
		'}',
		'long long {suma} = 0;',
		'for (size_t i = 0; i < {cantidad}; i++) {',
		'    {suma} += {numeros}[i];',
		'}',
		'printf("{report}", {cantidad}, {capacidad}, {suma});',
		'free({numeros});',
		'{numeros} = NULL;',
	]),
	p1: lines(['int *{numeros} = malloc(3 * sizeof *{numeros});']),
	p2: lines(['int *{ventas} = calloc(4, sizeof *{ventas});']),
	p3: lines(['int *{nuevo} = realloc({numeros}, 8 * sizeof *{numeros});']),
	p5: lines(['free({numeros});']),
	p6: lines(['{numeros} = NULL;', 'free({numeros});']),
	a2: lines([
		'size_t n = 10;',
		'int *{datos} = malloc(n * sizeof *{datos});',
		'for (size_t i = 0; i < n; i++) {',
		'    {datos}[i] = 0;',
		'}',
		'free({datos});',
	]),
	a3: lines([
		'int *{numeros} = malloc(4 * sizeof *{numeros});',
		'if ({numeros} == NULL) {',
		'    return 1;',
		'}',
		'{numeros} = realloc({numeros}, 8 * sizeof *{numeros});',
	]),
	a4: lines([
		'int *{numeros} = malloc(4 * sizeof *{numeros});',
		'if ({numeros} == NULL) {',
		'    return 1;',
		'}',
		'int *{nuevo} = realloc({numeros}, 8 * sizeof *{numeros});',
		'if ({nuevo} == NULL) {',
		'    return 1;',
		'}',
		'{numeros} = {nuevo};',
		'free({numeros});',
		'return 0;',
	]),
};
// </md-data>

// Memory states: stack variables (name, illustrative address, value) and heap blocks.
type Var = { name: string; addr: string; value: string; ptr: boolean };
type Block = { addr: string; cells: string[]; status: 'live' | 'freed' | 'lost' };
type MemState = { stack: Var[]; heap: Block[]; out?: string };
type Step = MemState & { line: number; note: string };

const sv = (name: string, addr: string, value: string): Var => ({ name, addr, value, ptr: false });
const pv = (name: string, addr: string, value: string): Var => ({ name, addr, value, ptr: true });
const hb = (addr: string, cells: string[], status: Block['status'] = 'live'): Block => ({ addr, cells, status });
const unknown = (n: number) => Array.from({ length: n }, () => '?');
const full4 = ['5', '8', '13', '2'];
const grown = ['5', '8', '13', '2', '?', '?', '?', '?'];
const reportOut = t('Leidos: 5 (capacidad 8), suma: 35', 'Read: 5 (capacity 8), sum: 35');

const learn: { kicker: string; title: string; lead: string; code: string; steps: Step[] }[] = [
	{
		kicker: t('1 · El montículo', '1 · The heap'),
		title: t('Un puntero en la pila, un bloque en el montículo', 'A pointer on the stack, a block on the heap'),
		lead: t(
			'La memoria dinámica se pide cuando hace falta, del tamaño que hace falta, y vive hasta que la liberas con `free`.',
			'Dynamic memory is requested when you need it, at the size you need, and it lives until you release it with `free`.',
		),
		code: 'malloc',
		steps: [
			{ line: 1, stack: [sv('n', '0x7f00', '5')], heap: [], note: t('`n` es una variable automática: vive en la pila y muere al salir de su bloque. El montículo todavía está vacío.', '`n` is an automatic variable: it lives on the stack and dies when its block ends. The heap is still empty.') },
			{ line: 2, stack: [sv('n', '0x7f00', '5'), pv(N.numeros, '0x7f08', '0x1000')], heap: [hb('0x1000', unknown(5))], note: t('`malloc` reserva `n * sizeof *numeros` bytes en el montículo (20 si un `int` ocupa 4) y devuelve la dirección del bloque, que se guarda en `numeros`.', '`malloc` reserves `n * sizeof *numbers` bytes on the heap (20 if an `int` takes 4) and returns the block address, which is stored in `numbers`.') },
			{ line: 2, stack: [sv('n', '0x7f00', '5'), pv(N.numeros, '0x7f08', '0x1000')], heap: [hb('0x1000', unknown(5))], note: t('El contenido no está inicializado: cada celda muestra `?`. Y el bloque no muere con ninguna llave de cierre: vive desde que lo pides hasta que llamas a `free`.', 'The contents are not initialized: every cell shows `?`. And no closing brace kills the block: it lives from the moment you request it until you call `free`.') },
		],
	},
	{
		kicker: t('2 · malloc', '2 · malloc'),
		title: t('Reservar y comprobar NULL antes de usar', 'Allocate and check for NULL before use'),
		lead: t(
			'`malloc` devuelve un `void *` con la dirección del bloque, o `NULL` si no pudo reservarlo. Por eso cada reserva se comprueba.',
			'`malloc` returns a `void *` with the block address, or `NULL` if it could not reserve it. That is why every allocation is checked.',
		),
		code: 'malloc',
		steps: [
			{ line: 2, stack: [sv('n', '0x7f00', '5'), pv(N.numeros, '0x7f08', '0x1000')], heap: [hb('0x1000', unknown(5))], note: t('No hace falta convertir el resultado: `void *` se convierte solo a `int *`. Escribir `sizeof *numeros` ajusta el tamaño si cambias el tipo del puntero.', 'No cast is needed: `void *` converts to `int *` on its own. Writing `sizeof *numbers` keeps the size right if you change the pointer type.') },
			{ line: 3, stack: [sv('n', '0x7f00', '5'), pv(N.numeros, '0x7f08', '0x1000')], heap: [hb('0x1000', unknown(5))], note: t('`numeros` vale 0x1000, no `NULL`: la condición es falsa y el programa sigue.', '`numbers` holds 0x1000, not `NULL`: the condition is false and the program goes on.') },
			{ line: 8, stack: [sv('n', '0x7f00', '5'), pv(N.numeros, '0x7f08', '0x1000')], heap: [hb('0x1000', ['0', '1', '4', '9', '16'])], note: t('El bloque se usa como un arreglo: `numeros[i]` es lo mismo que `*(numeros + i)`. Ahora cada celda tiene un valor definido.', 'The block is used like an array: `numbers[i]` is the same as `*(numbers + i)`. Now every cell holds a defined value.') },
		],
	},
	{
		kicker: t('3 · Cuando la reserva falla', '3 · When allocation fails'),
		title: t('Si malloc devuelve NULL, no hay bloque', 'If malloc returns NULL, there is no block'),
		lead: t(
			'Usar el puntero sin comprobarlo es comportamiento indefinido. La comprobación convierte el fallo en un mensaje y una salida ordenada.',
			'Using the pointer without checking it is undefined behavior. The check turns the failure into a message and an orderly exit.',
		),
		code: 'malloc',
		steps: [
			{ line: 1, stack: [sv('n', '0x7f00', '5')], heap: [], note: t('Supón que esta vez el sistema no tiene memoria disponible.', 'Suppose that this time the system has no memory available.') },
			{ line: 2, stack: [sv('n', '0x7f00', '5'), pv(N.numeros, '0x7f08', 'NULL')], heap: [], note: t('`malloc` no reserva nada y devuelve `NULL`.', '`malloc` reserves nothing and returns `NULL`.') },
			{ line: 3, stack: [sv('n', '0x7f00', '5'), pv(N.numeros, '0x7f08', 'NULL')], heap: [], note: t('La comprobación detecta el fallo. Escribir `numeros[i]` ahora sería comportamiento indefinido.', 'The check catches the failure. Writing `numbers[i]` now would be undefined behavior.') },
			{ line: 5, stack: [sv('n', '0x7f00', '5'), pv(N.numeros, '0x7f08', 'NULL')], heap: [], out: t('No hay memoria suficiente', 'Not enough memory'), note: t('El programa avisa por `stderr` y termina con `return 1`. No hay nada que liberar: el bloque nunca existió.', 'The program reports on `stderr` and ends with `return 1`. There is nothing to free: the block never existed.') },
		],
	},
	{
		kicker: t('4 · calloc', '4 · calloc'),
		title: t('Reservar con todos los bytes en cero', 'Allocate with every byte set to zero'),
		lead: t(
			'`calloc(cantidad, tamaño)` reserva espacio para `cantidad` elementos y los deja en cero. Además comprueba que la multiplicación no desborde.',
			'`calloc(count, size)` reserves room for `count` elements and leaves them at zero. It also checks that the multiplication does not overflow.',
		),
		code: 'calloc',
		steps: [
			{ line: 1, stack: [sv(N.dias, '0x7f00', '7')], heap: [], note: t('`dias` vive en la pila.', '`days` lives on the stack.') },
			{ line: 2, stack: [sv(N.dias, '0x7f00', '7'), pv(N.ventas, '0x7f08', '0x1000')], heap: [hb('0x1000', ['0', '0', '0', '0', '0', '0', '0'])], note: t('A diferencia de `malloc`, cada celda empieza en `0`: no hay valores indeterminados.', 'Unlike `malloc`, every cell starts at `0`: there are no indeterminate values.') },
			{ line: 3, stack: [sv(N.dias, '0x7f00', '7'), pv(N.ventas, '0x7f08', '0x1000')], heap: [hb('0x1000', ['0', '0', '0', '0', '0', '0', '0'])], note: t('Igual que con `malloc`, se comprueba `NULL` antes de usar el bloque.', 'Just like with `malloc`, check for `NULL` before using the block.') },
			{ line: 7, stack: [sv(N.dias, '0x7f00', '7'), pv(N.ventas, '0x7f08', '0x1000')], heap: [hb('0x1000', ['0', '0', '15', '0', '0', '0', '0'])], note: t('Solo escribes lo que cambia: el resto ya vale `0`.', 'You only write what changes: the rest is already `0`.') },
			{ line: 8, stack: [sv(N.dias, '0x7f00', '7'), pv(N.ventas, '0x7f08', '0x1000')], heap: [hb('0x1000', ['0', '0', '15', '0', '0', '0', '0'], 'freed')], note: t('`free` devuelve el bloque. `ventas` sigue guardando 0x1000, pero ese bloque ya está muerto.', '`free` gives the block back. `sales` still holds 0x1000, but that block is now dead.') },
		],
	},
	{
		kicker: t('5 · realloc', '5 · realloc'),
		title: t('Crecer a través de un puntero temporal', 'Growing through a temporary pointer'),
		lead: t(
			'`realloc` puede agrandar el bloque en su lugar o mover los datos a un bloque nuevo. Por eso devuelve la dirección que hay que usar a partir de ahora.',
			'`realloc` may grow the block in place or move the data to a new block. That is why it returns the address you must use from now on.',
		),
		code: 'grow',
		steps: [
			{ line: 0, stack: [sv(N.capacidad, '0x7f00', '4'), pv(N.numeros, '0x7f08', '0x1000')], heap: [hb('0x1000', full4)], note: t('Estado inicial: el bloque de 4 enteros está lleno con 5, 8, 13 y 2.', 'Initial state: the 4-int block is full with 5, 8, 13 and 2.') },
			{ line: 1, stack: [sv(N.capacidad, '0x7f00', '4'), pv(N.numeros, '0x7f08', '0x1000'), sv(N.nuevaCap, '0x7f10', '8')], heap: [hb('0x1000', full4)], note: t('Se duplica la capacidad: el nuevo tamaño será de 8 enteros.', 'The capacity doubles: the new size will be 8 ints.') },
			{ line: 2, stack: [sv(N.capacidad, '0x7f00', '4'), pv(N.numeros, '0x7f08', '0x1000'), sv(N.nuevaCap, '0x7f10', '8'), pv(N.nuevo, '0x7f18', '0x2000')], heap: [hb('0x1000', full4, 'freed'), hb('0x2000', grown)], note: t('Aquí no había lugar para crecer en el mismo sitio: `realloc` reservó un bloque en 0x2000, copió los 4 valores y liberó el bloque viejo. Las celdas nuevas quedan sin inicializar.', 'There was no room to grow in place: `realloc` reserved a block at 0x2000, copied the 4 values and freed the old block. The new cells are left uninitialized.') },
			{ line: 3, stack: [sv(N.capacidad, '0x7f00', '4'), pv(N.numeros, '0x7f08', '0x1000'), sv(N.nuevaCap, '0x7f10', '8'), pv(N.nuevo, '0x7f18', '0x2000')], heap: [hb('0x1000', full4, 'freed'), hb('0x2000', grown)], note: t('`nuevo` no es `NULL`: el crecimiento funcionó. Mientras tanto, `numeros` todavía guarda la dirección vieja.', '`bigger` is not `NULL`: growing worked. Meanwhile, `numbers` still holds the old address.') },
			{ line: 7, stack: [sv(N.capacidad, '0x7f00', '4'), pv(N.numeros, '0x7f08', '0x2000'), sv(N.nuevaCap, '0x7f10', '8'), pv(N.nuevo, '0x7f18', '0x2000')], heap: [hb('0x1000', full4, 'freed'), hb('0x2000', grown)], note: t('Solo ahora se reemplaza `numeros`, cuando ya sabes que `realloc` tuvo éxito.', 'Only now is `numbers` replaced, once you know that `realloc` succeeded.') },
			{ line: 8, stack: [sv(N.capacidad, '0x7f00', '8'), pv(N.numeros, '0x7f08', '0x2000'), sv(N.nuevaCap, '0x7f10', '8'), pv(N.nuevo, '0x7f18', '0x2000')], heap: [hb('0x1000', full4, 'freed'), hb('0x2000', grown)], note: t('La capacidad registrada coincide con el bloque real: 8 lugares, 4 ocupados.', 'The recorded capacity matches the real block: 8 slots, 4 in use.') },
		],
	},
	{
		kicker: t('6 · El realloc perdido', '6 · The lost realloc'),
		title: t('¿Por qué nunca se escribe p = realloc(p, ...)?', 'Why you never write p = realloc(p, ...)'),
		lead: t(
			'Si `realloc` falla, devuelve `NULL` y el bloque original sigue vivo y sin cambios. Lo que importa es no perder su dirección.',
			'If `realloc` fails, it returns `NULL` and the original block stays alive and unchanged. What matters is not losing its address.',
		),
		code: 'lost',
		steps: [
			{ line: 0, stack: [pv(N.numeros, '0x7f00', '0x1000')], heap: [hb('0x1000', full4)], note: t('Supón que esta vez `realloc` no consigue memoria y devuelve `NULL`.', 'Suppose that this time `realloc` cannot get memory and returns `NULL`.') },
			{ line: 2, stack: [pv(N.numeros, '0x7f00', 'NULL')], heap: [hb('0x1000', full4, 'lost')], note: t('Con la asignación directa, `NULL` pisa la única dirección del bloque. Sigue reservado, pero nadie puede usarlo ni liberarlo: es una fuga de memoria.', 'With the direct assignment, `NULL` overwrites the only address of the block. It is still reserved, but nobody can use it or free it: it is a memory leak.') },
			{ line: 5, stack: [pv(N.numeros, '0x7f00', '0x1000'), pv(N.nuevo, '0x7f08', 'NULL')], heap: [hb('0x1000', full4)], note: t('Con el patrón seguro, el resultado va a `nuevo`. `numeros` conserva la dirección y el bloque queda intacto.', 'With the safe pattern, the result goes to `bigger`. `numbers` keeps the address and the block stays intact.') },
			{ line: 6, stack: [pv(N.numeros, '0x7f00', '0x1000'), pv(N.nuevo, '0x7f08', 'NULL')], heap: [hb('0x1000', full4)], note: t('La comprobación detecta el fallo.', 'The check catches the failure.') },
			{ line: 7, stack: [pv(N.numeros, '0x7f00', '0x1000'), pv(N.nuevo, '0x7f08', 'NULL')], heap: [hb('0x1000', full4, 'freed')], note: t('Como todavía tienes la dirección, puedes liberar el bloque antes de salir. Nada se pierde.', 'Since you still have the address, you can free the block before leaving. Nothing is lost.') },
		],
	},
	{
		kicker: t('7 · free', '7 · free'),
		title: t('Liberar y dejar el puntero en NULL', 'Free, then set the pointer to NULL'),
		lead: t(
			'Solo se pasa a `free` un puntero que vino de `malloc`, `calloc` o `realloc` (o `NULL`), y cada bloque se libera una sola vez.',
			'Only pass to `free` a pointer that came from `malloc`, `calloc` or `realloc` (or `NULL`), and free each block exactly once.',
		),
		code: 'free',
		steps: [
			{ line: 0, stack: [pv(N.numeros, '0x7f00', '0x2000')], heap: [hb('0x2000', ['5', '8', '13', '2', '7', '?', '?', '?'])], note: t('Estado inicial: `numeros` apunta a un bloque vivo de 8 enteros.', 'Initial state: `numbers` points to a live block of 8 ints.') },
			{ line: 1, stack: [pv(N.numeros, '0x7f00', '0x2000')], heap: [hb('0x2000', ['5', '8', '13', '2', '7', '?', '?', '?'], 'freed')], note: t('`free` devuelve el bloque. `numeros` sigue guardando 0x2000: es un puntero colgante.', '`free` gives the block back. `numbers` still holds 0x2000: it is a dangling pointer.') },
			{ line: 2, stack: [pv(N.numeros, '0x7f00', 'NULL')], heap: [hb('0x2000', ['5', '8', '13', '2', '7', '?', '?', '?'], 'freed')], note: t('Con `NULL`, un uso posterior falla de forma predecible al comprobar `NULL`, en lugar de leer memoria muerta.', 'With `NULL`, a later use fails predictably on a `NULL` check instead of reading dead memory.') },
			{ line: 3, stack: [pv(N.numeros, '0x7f00', 'NULL')], heap: [hb('0x2000', ['5', '8', '13', '2', '7', '?', '?', '?'], 'freed')], note: t('`free(NULL)` no hace nada: el estándar lo garantiza. No es una doble liberación.', '`free(NULL)` does nothing: the standard guarantees it. It is not a double free.') },
		],
	},
	{
		kicker: t('8 · Un arreglo que crece', '8 · An array that grows'),
		title: t('El ejemplo de la lección con la entrada 5 8 13 2 7 0', 'The lesson example with the input 5 8 13 2 7 0'),
		lead: t(
			'El programa no sabe cuántos números llegarán: empieza con capacidad 4 y la duplica cada vez que se llena.',
			'The program does not know how many numbers will arrive: it starts with capacity 4 and doubles it each time it fills up.',
		),
		code: 'vector',
		steps: [
			{ line: 3, stack: [sv(N.capacidad, '0x7f00', '4'), sv(N.cantidad, '0x7f08', '0'), pv(N.numeros, '0x7f10', '0x1000')], heap: [hb('0x1000', unknown(4))], note: t('Reserva inicial: lugar para 4 enteros, ninguno ocupado.', 'Initial allocation: room for 4 ints, none in use.') },
			{ line: 22, stack: [sv(N.capacidad, '0x7f00', '4'), sv(N.cantidad, '0x7f08', '4'), pv(N.numeros, '0x7f10', '0x1000'), sv(N.valor, '0x7f18', '2')], heap: [hb('0x1000', full4)], note: t('Lee 5, 8, 13 y 2: cada vuelta guarda el valor en `numeros[cantidad]` y suma 1 a `cantidad`. El bloque está lleno.', 'It reads 5, 8, 13 and 2: each pass stores the value in `numbers[count]` and adds 1 to `count`. The block is full.') },
