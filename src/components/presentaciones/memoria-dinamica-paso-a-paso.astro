							<span>{t('Ver la transición', 'Watch the transition')}</span>
						</button>
						<button class="md-btn" type="button" data-retry hidden>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg>
							<span>{t('Intentar de nuevo', 'Try again')}</span>
