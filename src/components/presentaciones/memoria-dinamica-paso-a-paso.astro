								<span>{t('Paso anterior', 'Previous step')}</span>
							</button>
							<span class="md-step-count" data-step-count></span>
							<button class="md-btn md-btn-primary" type="button" data-step-next aria-label={t('Siguiente paso', 'Next step')}>
								<span>{t('Siguiente paso', 'Next step')}</span>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
							</button>
							<button class="md-btn" type="button" data-step-reset aria-label={t('Reiniciar los pasos', 'Restart the steps')}>
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg>
								<span>{t('Reiniciar', 'Restart')}</span>
							</button>
						</div>
						<p class="md-note" data-note aria-live="polite"></p>
					</div>
				</section>
			))}

			{practice.map((p, i) => (
				<section class="md-slide" data-mode="practice" data-slide={`practice-${i + 1}`} data-practice={JSON.stringify({ before: p.before, after: p.after, correct: p.correct, reason: p.reason })}>
					<div class="md-head">
						<span class="md-kicker">{t('Practicar', 'Practice')} · {i + 1} / {practice.length}</span>
						<h2 class="md-title">{p.title}</h2>
						<p class="md-lead">{parts(p.context).map((x, k) => (k % 2 ? <code>{x}</code> : x))}</p>
					</div>
					<div class="md-card md-grid">
						<div class="md-code-panel">
							<span class="md-panel-label">C</span>
							<pre class="md-code"><code>{code[p.code].map((l, n) => <span class={`md-line${n + 1 === p.line ? ' is-current' : ''}`} data-line={n + 1}><span class="md-ln" aria-hidden="true">{n + 1}</span>{l}</span>)}</code></pre>
						</div>
						<div class="md-memory" data-memory role="group" aria-label={t('Estado de la memoria', 'Memory state')}></div>
					</div>
					<fieldset class="md-quiz">
