---

<div
	class="md-screen"
	data-presentation="memoria-dinamica-paso-a-paso"
	data-lang={lang}
	data-ui={JSON.stringify(ui)}
	data-hints={JSON.stringify(modeHints)}
	data-totals={JSON.stringify(totals)}
>
	<div class="md-shell">
		<nav class="md-nav" aria-label={t('Controles de navegación', 'Navigation controls')}>
			<button class="md-btn" id="mdPrevBtn" type="button" aria-label={t('Diapositiva anterior', 'Previous slide')} disabled>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
				<span>{t('Anterior', 'Previous')}</span>
			</button>
			<span class="md-counter" id="mdSlideCounter" aria-live="polite">1 / {totals.learn}</span>
			<button class="md-btn" id="mdNextBtn" type="button" aria-label={t('Siguiente diapositiva', 'Next slide')}>
				<span>{t('Siguiente', 'Next')}</span>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
			</button>
		</nav>

		<div class="md-modebar">
			<span class="md-modes-label" id="mdModesLabel">{t('Modo', 'Mode')}</span>
			<div class="md-seg" role="radiogroup" aria-labelledby="mdModesLabel">
				<label class="md-seg-opt">
					<input type="radio" name="mdMode" value="learn" checked />
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 7v14" /><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" /></svg>
					{t('Aprender', 'Learn')}
				</label>
				<label class="md-seg-opt">
					<input type="radio" name="mdMode" value="practice" />
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z" /><path d="m15 5 4 4" /></svg>
					{t('Practicar', 'Practice')}
				</label>
				<label class="md-seg-opt">
					<input type="radio" name="mdMode" value="assess" />
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1" /><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><path d="m9 14 2 2 4-4" /></svg>
					{t('Evaluar', 'Assess')}
				</label>
			</div>
			<p class="md-mode-hint" id="mdModeHint">{modeHints.learn}</p>
		</div>

		<main class="md-viewport">
			{learn.map((s, i) => (
				<section class={`md-slide${i === 0 ? ' is-active' : ''}`} data-mode="learn" data-slide={`learn-${i + 1}`} data-steps={JSON.stringify(s.steps)}>
					<div class="md-head">
						<span class="md-kicker">{t('Aprender', 'Learn')} · {s.kicker}</span>
						<h2 class="md-title">{s.title}</h2>
