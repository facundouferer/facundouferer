---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="sn-screen">
	<div class="sn-shell">
		<header class="sn-header">
			<span class="sn-badge">{isEs ? 'Conversión de Tipos' : 'Type Conversion'}</span>
			<h1 class="sn-title">
				{isEs ? 'Conversión entre Cadenas y Números' : 'String to Number Conversions'}
			</h1>
			<p class="sn-sub">
				{isEs 
					? 'Parsing, atoi, parseInt, Integer.parseInt e int() en C, Java, JavaScript y Python.' 
					: 'Parsing, atoi, parseInt, Integer.parseInt, and int() in C, Java, JS, and Python.'}
			</p>
		</header>

		<div class="sn-deck-card">
			<div class="sn-nav-bar">
				<div class="sn-slide-indicator">
					<span class="sn-step-dot"></span>
					<span id="sn-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="sn-pills">
					<button class="sn-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="sn-pill-btn" data-target-slide="2">2. C</button>
					<button class="sn-pill-btn" data-target-slide="3">3. Java</button>
					<button class="sn-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="sn-pill-btn" data-target-slide="5">5. Python</button>
					<button class="sn-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="sn-viewport">
				<div class="sn-slide active" data-slide="1">
					<div class="sn-slide-grid">
						<div class="sn-col">
							<h2 class="sn-slide-title">1. {isEs ? 'Parsing y Formateo' : 'Parsing & Formatting'}</h2>
							<p class="sn-text">
								{isEs 
									? 'Convertir texto `"123"` a valor numérico `123` requiere analizar los caracteres ASCII/Unicode y calcular el valor posicional base 10.'
									: 'Converting string `"123"` to integer `123` requires parsing digits and accumulating base 10 values.'}
							</p>
						</div>
						<div class="sn-col">
							<div class="sn-card-box">
								<div class="sn-card-head">{isEs ? 'MANEJO DE ERRORES' : 'ERROR HANDLING'}</div>
								<div class="sn-cell"><span>"123abc"</span><span class="sn-tag">Retorna 123 (C/JS) o Excepción (Java/Python)</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="sn-slide" data-slide="2">
					<div class="sn-slide-grid">
						<div class="sn-col">
							<h2 class="sn-slide-title">2. C: atoi y strtol</h2>
							<p class="sn-text">`atoi` convierte cadenas a enteros, mientras `strtol` provee detección avanzada de errores con puntero `endptr`.</p>
						</div>
						<div class="sn-col">
							<div class="sn-code-card">
								<div class="sn-code-title">parse.c</div>
								<pre class="sn-code-block"><code><span class="token-type">char</span> text[] = <span class="token-string">"456"</span>;
<span class="token-type">int</span> num = atoi(text); <span class="token-comment">// 456</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="sn-slide" data-slide="3">
					<div class="sn-slide-grid">
						<div class="sn-col">
							<h2 class="sn-slide-title">3. Java: Integer.parseInt y String.valueOf</h2>
							<p class="sn-text">`Integer.parseInt("123")` parsea la cadena o lanza `NumberFormatException` si contiene caracteres inválidos.</p>
						</div>
						<div class="sn-col">
							<div class="sn-code-card">
								<div class="sn-code-title">Parse.java</div>
								<pre class="sn-code-block"><code><span class="token-type">int</span> val = Integer.parseInt(<span class="token-string">"789"</span>);
String str = String.valueOf(val);</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="sn-slide" data-slide="4">
					<div class="sn-slide-grid">
						<div class="sn-col">
							<h2 class="sn-slide-title">4. JavaScript: parseInt, parseFloat y Number()</h2>
							<p class="sn-text">JS ofrece `parseInt("123", 10)` o el operador unario `+"123"`. Retorna `NaN` ante fallos de parseo.</p>
						</div>
						<div class="sn-col">
							<div class="sn-code-card">
								<div class="sn-code-title">parse.js</div>
								<pre class="sn-code-block"><code><span class="token-keyword">const</span> n1 = parseInt(<span class="token-string">"100px"</span>, <span class="token-number">10</span>); <span class="token-comment">// 100</span>
<span class="token-keyword">const</span> n2 = Number(<span class="token-string">"100px"</span>); <span class="token-comment">// NaN</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="sn-slide" data-slide="5">
					<div class="sn-slide-grid">
						<div class="sn-col">
							<h2 class="sn-slide-title">5. Python: int(), float() y str()</h2>
							<p class="sn-text">En Python `int("123")` realiza la conversión directa. Si la cadena es inválida lanza `ValueError`.</p>
						</div>
						<div class="sn-col">
							<div class="sn-code-card">
								<div class="sn-code-title">parse.py</div>
								<pre class="sn-code-block"><code>num = int(<span class="token-string">"42"</span>)
s = str(<span class="token-number">42</span>)</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="sn-slide" data-slide="6">
					<div class="sn-sim-container">
						<h2 class="sn-slide-title center">{isEs ? '6. Inspector de Conversión' : '6. Conversion Inspector'}</h2>
						<div class="sn-inspector-grid">
							<div class="sn-lang-box"><span class="sn-lang-name">Entrada: "123"</span><div class="sn-exp-res">C: 123 | Java: 123 | JS: 123 | Python: 123</div></div>
							<div class="sn-lang-box"><span class="sn-lang-name">Entrada: "123abc"</span><div class="sn-exp-res">C (atoi): 123 | Java: Exception | JS (parseInt): 123 | Python: ValueError</div></div>
						</div>
					</div>
				</div>
			</div>

			<div class="sn-footer">
				<button class="btn btn-secondary" id="btn-prev-sn" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="sn-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-sn">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.sn-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.sn-shell { max-width: var(--container-max); margin: 0 auto; }
	.sn-header { margin-bottom: 1.5rem; }
	.sn-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.sn-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.sn-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.sn-sub.center { text-align: center; }
	.sn-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.sn-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.sn-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.sn-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.sn-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.sn-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.sn-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.sn-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.sn-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.sn-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.sn-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.sn-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.sn-col { grid-column: span 12; }
	@media (min-width: 900px) { .sn-col { grid-column: span 6; } }
	.sn-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.sn-slide-title.center { text-align: center; }
	.sn-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.sn-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.sn-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.sn-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.sn-tag { color: var(--color-accent-700); font-weight: 600; }
	.sn-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.sn-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.sn-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.sn-sim-container { max-width: 800px; margin: 0 auto; }
	.sn-inspector-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
	@media (max-width: 600px) { .sn-inspector-grid { grid-template-columns: repeat(1, minmax(0, 1fr)); } }
	.sn-lang-box { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.8rem; }
	.sn-lang-name { font-family: 'Fira Code', monospace; font-size: 0.75rem; font-weight: 700; color: #e59866; display: block; margin-bottom: 0.4rem; }
	.sn-exp-res { font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #f9f4ed; background: #141210; padding: 0.5rem 0.7rem; border-radius: var(--radius-sm); }
	.sn-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.sn-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.sn-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.sn-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('sn-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-sn') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-sn') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.sn-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-sn')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-sn')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	goToSlide(1);
</script>
