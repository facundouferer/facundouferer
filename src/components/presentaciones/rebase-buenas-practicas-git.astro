		font-family: monospace;
		font-size: 12px;
		color: var(--color-accent-700);
	}
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const screenEl = document.querySelector('.gb-screen');
	const pageLang = screenEl?.getAttribute('data-lang') === 'en' ? 'en' : 'es';

	const prevBtn = document.getElementById('gbPrevBtn') as HTMLButtonElement;
	const nextBtn = document.getElementById('gbNextBtn') as HTMLButtonElement;
	const counter = document.getElementById('gbSlideCounter') as HTMLElement;
	const slides = document.querySelectorAll<HTMLElement>('.gb-slide');

	function updateSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;
		slides.forEach((s) => s.classList.remove('is-active'));
		document.querySelector(`.gb-slide[data-slide="${currentSlide}"]`)?.classList.add('is-active');

		if (counter) counter.textContent = `${currentSlide} / ${totalSlides}`;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	prevBtn?.addEventListener('click', () => updateSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => updateSlide(currentSlide + 1));

	window.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') updateSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') updateSlide(currentSlide - 1);
	});

	// Slide 1: Replay animation
	const btnReplay = document.getElementById('gbBtnReplay');
	const btnResetReplay = document.getElementById('gbBtnResetReplay');
	const graphBefore = document.getElementById('gbGraphBefore');
	const graphAfter = document.getElementById('gbGraphAfter');

	btnReplay?.addEventListener('click', () => {
		if (graphBefore) graphBefore.hidden = true;
		if (graphAfter) graphAfter.hidden = false;
	});

	btnResetReplay?.addEventListener('click', () => {
		if (graphBefore) graphBefore.hidden = false;
		if (graphAfter) graphAfter.hidden = true;
	});

	// Slide 5: Conventional Commit Builder
	const typeChips = document.querySelectorAll<HTMLButtonElement>('.gb-type-btn');
	const commitPreview = document.getElementById('gbCommitPreview');
	const commitFeedback = document.getElementById('gbCommitFeedback');

	const messagesByType: Record<string, { msg: string; impact: string }> = {
		feat: {
			msg: 'feat(auth): validate JWT bearer token expiration',
			impact: 'feat dispara una versión MINOR en SemVer (0.1.0 -> 0.2.0)',
		},
		fix: {
			msg: 'fix(checkout): handle zero decimal currencies correctly',
			impact: 'fix dispara una versión PATCH en SemVer (0.1.0 -> 0.1.1)',
		},
		refactor: {
			msg: 'refactor(db): extract query builder into dedicated service',
			impact: 'refactor no altera versión pública ni comportamiento externo',
		},
		test: {
			msg: 'test(auth): add integration tests for expired tokens',
			impact: 'test asegura cobertura sin impacto en el bundle de producción',
		},
		docs: {
			msg: 'docs(api): document rate limiting headers and retry policy',
			impact: 'docs mantiene la documentación técnica alineada con el código',
		},
		chore: {
			msg: 'chore(deps): bump typescript from 5.4 to 5.5 in package.json',
			impact: 'chore actualiza tooling o dependencias internas sin tocar lógica',
		},
	};

	typeChips.forEach((chip) => {
		chip.addEventListener('click', () => {
			const type = chip.getAttribute('data-type') || 'feat';
			typeChips.forEach((c) => c.classList.remove('is-active'));
			chip.classList.add('is-active');

			const item = messagesByType[type];
			if (item) {
				if (commitPreview) commitPreview.textContent = item.msg;
				if (commitFeedback) {
					commitFeedback.innerHTML = `<span>✓ ${item.impact}</span>`;
				}
			}
		});
	});
</script>
