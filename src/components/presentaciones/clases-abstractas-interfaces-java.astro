					payCanRefund.style.color = gw.refundOk ? 'var(--color-accent-2-700)' : 'rgb(239, 68, 68)';
				}
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initPresentation);
	} else {
