										<span class="state-val mono" id="pay-fee-txt">+$35.00 (3.5%)</span>
									</div>
									<div class="state-row">
										<span class="state-label">{isEs ? 'Permite Reembolso:' : 'Allows Refund:'}</span>
										<span class="state-val" id="pay-can-refund" style="color: var(--color-accent-2-700); font-weight: 700;">SÍ</span>
