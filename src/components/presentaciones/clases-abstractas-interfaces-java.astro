									</div>
								</div>
								<pre class="deck-code-snippet"><code><span class="tok-comment">// Composición: la Factura crea y posee sus items</span>
<span class="tok-kw">public class</span> Factura &#123;
  <span class="tok-kw">private final</span> List&lt;Item&gt; items = <span class="tok-kw">new</span> ArrayList&lt;&gt;();
&#125;</code></pre>
