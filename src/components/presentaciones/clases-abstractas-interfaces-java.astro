<script>
	function initPresentation() {
		const screen = document.querySelector('.ci-screen');
		if (!screen) return;

		let currentSlide = 1;
		const totalSlides = 7;

		const slideLabel = document.getElementById('deck-slide-label');
		const prevBtn = screen.querySelector('.deck-nav-prev') as HTMLButtonElement;
		const nextBtn = screen.querySelector('.deck-nav-next') as HTMLButtonElement;
		const pills = screen.querySelectorAll('.deck-pill-btn');
		const dots = screen.querySelectorAll('.deck-dot');
		const slides = screen.querySelectorAll('.deck-slide');

		function goToSlide(target: number) {
			if (target < 1 || target > totalSlides) return;
			currentSlide = target;

			if (slideLabel) {
				slideLabel.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
			}

			slides.forEach((sl) => {
				const sNum = parseInt(sl.getAttribute('data-slide') || '0', 10);
				sl.classList.toggle('active', sNum === currentSlide);
			});

			pills.forEach((p) => {
				const tNum = parseInt(p.getAttribute('data-target-slide') || '0', 10);
				p.classList.toggle('active', tNum === currentSlide);
			});

			dots.forEach((d) => {
				const tNum = parseInt(d.getAttribute('data-target-slide') || '0', 10);
				d.classList.toggle('active', tNum === currentSlide);
			});

			if (prevBtn) prevBtn.disabled = currentSlide === 1;
			if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
		}

		prevBtn?.addEventListener('click', () => goToSlide(currentSlide - 1));
		nextBtn?.addEventListener('click', () => goToSlide(currentSlide + 1));

		pills.forEach((p) => {
			p.addEventListener('click', () => {
				const t = parseInt(p.getAttribute('data-target-slide') || '1', 10);
				goToSlide(t);
			});
		});

		dots.forEach((d) => {
			d.addEventListener('click', () => {
				const t = parseInt(d.getAttribute('data-target-slide') || '1', 10);
				goToSlide(t);
			});
		});

		window.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
			if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
		});

		// --- SLIDE 1: Figure area calculator ---
		const figBtns = screen.querySelectorAll('.fig-btn');
		const figResArea = document.getElementById('fig-res-area');
		const figCodeTxt = document.getElementById('fig-code-txt');
		const boxCirculo = document.getElementById('fig-box-circulo');
		const boxRect = document.getElementById('fig-box-rect');

		figBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				figBtns.forEach((b) => b.classList.remove('active'));
				btn.classList.add('active');
				const fig = btn.getAttribute('data-fig');

				if (fig === 'circulo') {
					if (figResArea) figResArea.textContent = '78.54 u²';
					if (figCodeTxt) {
						figCodeTxt.textContent = 'public class Circulo extends Figura {\n  private double radio = 5.0;\n  @Override\n  public double calcularArea() {\n    return Math.PI * radio * radio;\n  }\n}';
					}
					if (boxCirculo) {
						boxCirculo.setAttribute('stroke', 'var(--color-accent)');
						boxCirculo.setAttribute('stroke-width', '2');
					}
					if (boxRect) {
						boxRect.setAttribute('stroke', 'var(--color-divider)');
						boxRect.setAttribute('stroke-width', '1');
					}
				} else {
					if (figResArea) figResArea.textContent = '24.00 u²';
					if (figCodeTxt) {
						figCodeTxt.textContent = 'public class Rectangulo extends Figura {\n  private double base = 4.0, altura = 6.0;\n  @Override\n  public double calcularArea() {\n    return base * altura;\n  }\n}';
					}
					if (boxCirculo) {
						boxCirculo.setAttribute('stroke', 'var(--color-divider)');
						boxCirculo.setAttribute('stroke-width', '1');
					}
					if (boxRect) {
						boxRect.setAttribute('stroke', 'var(--color-accent)');
						boxRect.setAttribute('stroke-width', '2');
					}
				}
			});
		});

		// --- SLIDE 2: Interfaces Socket ---
		const plugBtns = screen.querySelectorAll('.plug-btn');
		const plugWireTxt = document.getElementById('plug-wire-txt');
		const plugOutTxt = document.getElementById('plug-out-txt');

		plugBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				plugBtns.forEach((b) => b.classList.remove('active'));
				btn.classList.add('active');
				const plugKey = btn.getAttribute('data-plug');

				const plugs = ['pdf', 'excel', 'json'];
				plugs.forEach((k) => {
					const el = document.getElementById(`plug-${k}`);
					const rect = el?.querySelector('rect');
					if (rect) {
						rect.setAttribute('stroke', k === plugKey ? 'var(--color-accent)' : 'var(--color-divider)');
						rect.setAttribute('stroke-width', k === plugKey ? '2' : '1');
					}
				});

				if (plugKey === 'pdf') {
					if (plugWireTxt) plugWireTxt.textContent = 'Exportable exp = new DocumentoPDF()';
					if (plugOutTxt) plugOutTxt.textContent = 'application/pdf (%PDF-1.4 bytes)';
				} else if (plugKey === 'excel') {
					if (plugWireTxt) plugWireTxt.textContent = 'Exportable exp = new ReporteExcel()';
					if (plugOutTxt) plugOutTxt.textContent = 'application/vnd.ms-excel (XLSX)';
				} else {
					if (plugWireTxt) plugWireTxt.textContent = 'Exportable exp = new MensajeJSON()';
					if (plugOutTxt) plugOutTxt.textContent = 'application/json (UTF-8 bytes)';
				}
			});
		});

		// --- SLIDE 3: Diamond conflict resolver ---
		const diamBtns = screen.querySelectorAll('.diam-btn');
		const diamSolTxt = document.getElementById('diam-sol-txt');
		const diamCodeSnippet = document.getElementById('diam-code-snippet');

		diamBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				diamBtns.forEach((b) => b.classList.remove('active'));
				btn.classList.add('active');
				const pick = btn.getAttribute('data-pick');

				if (pick === 'a') {
					if (diamSolTxt) diamSolTxt.textContent = 'ImpresoraA.super.imprimir();';
					if (diamCodeSnippet) diamCodeSnippet.textContent = '@Override\npublic void imprimir() {\n  ImpresoraA.super.imprimir(); // Elige rama A\n}';
				} else if (pick === 'b') {
					if (diamSolTxt) diamSolTxt.textContent = 'ImpresoraB.super.imprimir();';
					if (diamCodeSnippet) diamCodeSnippet.textContent = '@Override\npublic void imprimir() {\n  ImpresoraB.super.imprimir(); // Elige rama B\n}';
				} else {
					if (diamSolTxt) diamSolTxt.textContent = 'Lógica completamente propia';
					if (diamCodeSnippet) diamCodeSnippet.textContent = '@Override\npublic void imprimir() {\n  System.out.println("Impresión híbrida propia");\n}';
				}
			});
		});

		// --- SLIDE 6: UML Lifecycle & GC ---
		const btnKill = document.getElementById('btn-kill-container');
		const btnReset = document.getElementById('btn-reset-container');
		const gcItemTxt = document.getElementById('gc-item-txt');
		const compBox = document.getElementById('comp-box');

		btnKill?.addEventListener('click', () => {
			if (gcItemTxt) {
				gcItemTxt.textContent = '⚡ ELIMINADO por Garbage Collector';
				gcItemTxt.style.color = 'rgb(239, 68, 68)';
				gcItemTxt.style.fontWeight = '700';
			}
			if (compBox) {
				compBox.setAttribute('stroke', 'rgb(239, 68, 68)');
			}
		});

		btnReset?.addEventListener('click', () => {
			if (gcItemTxt) {
				gcItemTxt.textContent = 'Intacto en Heap';
				gcItemTxt.style.color = 'var(--color-text)';
				gcItemTxt.style.fontWeight = '600';
			}
			if (compBox) {
				compBox.setAttribute('stroke', 'var(--color-accent-700)');
			}
		});

		// --- SLIDE 7: Payment Simulator ---
		const payBtns = screen.querySelectorAll('.pay-btn');
		const payCardTitle = document.getElementById('pay-card-title');
		const payCardContract = document.getElementById('pay-card-contract');
		const payCardCalc = document.getElementById('pay-card-calc');
		const payResStatus = document.getElementById('pay-res-status');
		const payResRefund = document.getElementById('pay-res-refund');
		const payFeeTxt = document.getElementById('pay-fee-txt');
		const payCanRefund = document.getElementById('pay-can-refund');

		const payGateways: Record<string, { title: string; contract: string; calc: string; status: string; refund: string; fee: string; canRefund: string; refundOk: boolean }> = {
			card: {
				title: 'Tarjeta de Crédito (Visa/Mastercard)',
				contract: 'implements Reembolsable, Notificable',
				calc: 'Comisión: 3.5% | Proceso bancario',
				status: '✓ Pago APROBADO: $1,035.00 debitado',
				refund: 'instanceof Reembolsable: SÍ -> Reembolso habilitado',
				fee: '+$35.00 (3.5%)',
				canRefund: 'SÍ',
				refundOk: true,
			},
			mp: {
				title: 'MercadoPago QR / Wallet',
				contract: 'implements Reembolsable',
				calc: 'Comisión: 1.0% | Wallet digital',
				status: '✓ Pago APROBADO: $1,010.00 debitado',
				refund: 'instanceof Reembolsable: SÍ -> Reembolso habilitado',
				fee: '+$10.00 (1.0%)',
				canRefund: 'SÍ',
				refundOk: true,
			},
			crypto: {
				title: 'Crypto Transfer (USDT / Bitcoin)',
				contract: 'NO implements Reembolsable (Inmutable en Blockchain)',
				calc: 'Comisión de red: $2.50 fija',
				status: '✓ Transacción confirmada en bloque 840,112',
				refund: 'instanceof Reembolsable: NO -> Reembolso imposible',
				fee: '+$2.50 (Red)',
				canRefund: 'NO',
				refundOk: false,
			},
		};

		payBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				payBtns.forEach((b) => b.classList.remove('active'));
				btn.classList.add('active');
				const gwKey = btn.getAttribute('data-gw') || 'card';
				const gw = payGateways[gwKey];

				if (payCardTitle) payCardTitle.textContent = gw.title;
				if (payCardContract) payCardContract.textContent = gw.contract;
				if (payCardCalc) payCardCalc.textContent = gw.calc;
				if (payResStatus) payResStatus.textContent = gw.status;
				if (payResRefund) {
					payResRefund.textContent = gw.refund;
