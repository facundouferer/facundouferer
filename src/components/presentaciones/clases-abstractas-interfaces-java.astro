									<div class="state-row">
										<span class="state-label">{isEs ? 'Estado Profesor (Agregación):' : 'Professor State (Aggregation):'}</span>
										<span class="state-val" id="gc-prof-txt" style="color: var(--color-accent-2-700);">VIVO en Heap (independiente)</span>
									</div>
