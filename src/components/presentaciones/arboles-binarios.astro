---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="bt-screen">
	<div class="bt-shell">
		<header class="bt-header">
			<span class="bt-badge">{isEs ? 'Estructuras No Lineales' : 'Non-Linear Structures'}</span>
			<h1 class="bt-title">
				{isEs ? 'Árboles Binarios de Búsqueda (BST)' : 'Binary Search Trees (BST)'}
			</h1>
			<p class="bt-sub">
				{isEs 
					? 'Nodos, punteros, referencias e in-order traversal en C, Java, JavaScript y Python.' 
					: 'Nodes, pointers, references, and in-order traversal in C, Java, JS, and Python.'}
			</p>
		</header>

		<div class="bt-deck-card">
			<div class="bt-nav-bar">
				<div class="bt-slide-indicator">
					<span class="bt-step-dot"></span>
					<span id="bt-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="bt-pills">
					<button class="bt-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="bt-pill-btn" data-target-slide="2">2. C</button>
					<button class="bt-pill-btn" data-target-slide="3">3. Java</button>
					<button class="bt-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="bt-pill-btn" data-target-slide="5">5. Python</button>
					<button class="bt-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="bt-viewport">
				<div class="bt-slide active" data-slide="1">
					<div class="bt-slide-grid">
						<div class="bt-col">
							<h2 class="bt-slide-title">1. {isEs ? 'Propiedad Fundamental del BST' : 'BST Fundamental Property'}</h2>
							<p class="bt-text">
								{isEs 
									? 'En un BST, para todo nodo X: los valores del subárbol izquierdo son menores (< X) y los del subárbol derecho son mayores (> X). El recorrido In-Order produce los elementos ordenados.'
									: 'In a BST, for any node X: left subtree values are smaller (< X) and right subtree values are larger (> X). In-order traversal yields sorted elements.'}
							</p>
						</div>
						<div class="bt-col">
							<div class="bt-card-box">
								<div class="bt-card-head">{isEs ? 'ESTRUCTURA DE UN NODO' : 'NODE STRUCTURE'}</div>
								<div class="bt-cell"><span>Valor / Key</span><span class="bt-tag">Dato del nodo</span></div>
								<div class="bt-cell"><span>Puntero / Ref Izquierda</span><span class="bt-tag">Subárbol &lt; Key</span></div>
								<div class="bt-cell"><span>Puntero / Ref Derecha</span><span class="bt-tag">Subárbol &gt; Key</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="bt-slide" data-slide="2">
					<div class="bt-slide-grid">
						<div class="bt-col">
							<h2 class="bt-slide-title">2. C: struct Node con Punteros</h2>
							<p class="bt-text">En C se define con `struct Node` y punteros auto-referenciados `struct Node *left, *right`.</p>
						</div>
						<div class="bt-col">
							<div class="bt-code-card">
								<div class="bt-code-title">bst.c</div>
								<pre class="bt-code-block"><code><span class="token-keyword">typedef struct</span> Node &#123;
    <span class="token-type">int</span> data;
    <span class="token-keyword">struct</span> Node *left;
    <span class="token-keyword">struct</span> Node *right;
&#125; Node;

Node* createNode(<span class="token-type">int</span> val) &#123;
    Node* n = (Node*)malloc(<span class="token-keyword">sizeof</span>(Node));
    n-&gt;data = val; n-&gt;left = n-&gt;right = NULL;
    <span class="token-keyword">return</span> n;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="bt-slide" data-slide="3">
					<div class="bt-slide-grid">
						<div class="bt-col">
							<h2 class="bt-slide-title">3. Java: Clase TreeNode</h2>
							<p class="bt-text">Java maneja las conexiones del árbol mediante referencias a objetos en el Heap.</p>
						</div>
						<div class="bt-col">
							<div class="bt-code-card">
								<div class="bt-code-title">BST.java</div>
								<pre class="bt-code-block"><code><span class="token-keyword">class</span> TreeNode &#123;
    <span class="token-type">int</span> val;
    TreeNode left, right;
    TreeNode(<span class="token-type">int</span> val) &#123; <span class="token-keyword">this</span>.val = val; &#125;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="bt-slide" data-slide="4">
					<div class="bt-slide-grid">
						<div class="bt-col">
							<h2 class="bt-slide-title">4. JavaScript: Clases ES6</h2>
							<p class="bt-text">JS implementa la estructura con clases de ES6 y punteros `null` para hojas.</p>
						</div>
						<div class="bt-col">
							<div class="bt-code-card">
								<div class="bt-code-title">bst.js</div>
								<pre class="bt-code-block"><code><span class="token-keyword">class</span> Node &#123;
    constructor(value) &#123;
        <span class="token-keyword">this</span>.value = value;
        <span class="token-keyword">this</span>.left = <span class="token-keyword">null</span>;
        <span class="token-keyword">this</span>.right = <span class="token-keyword">null</span>;
    &#125;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="bt-slide" data-slide="5">
					<div class="bt-slide-grid">
						<div class="bt-col">
							<h2 class="bt-slide-title">5. Python: Recorrido In-Order Recursivo</h2>
							<p class="bt-text">El recorrido In-Order (Izquierda ➔ Raíz ➔ Derecha) visita los nodos de menor a mayor valor.</p>
						</div>
						<div class="bt-col">
							<div class="bt-code-card">
								<div class="bt-code-title">bst.py</div>
								<pre class="bt-code-block"><code><span class="token-keyword">class</span> Node:
    <span class="token-keyword">def</span> __init__(self, val):
        self.val = val
        self.left = None
        self.right = None

<span class="token-keyword">def</span> in_order(root):
    <span class="token-keyword">if</span> root:
        in_order(root.left)
        print(root.val)
        in_order(root.right)</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="bt-slide" data-slide="6">
					<div class="bt-sim-container">
						<h2 class="bt-slide-title center">{isEs ? '6. Inspector de Árbol BST' : '6. BST Inspector'}</h2>
						<div class="bt-inspector-grid">
							<div class="bt-lang-box"><span class="bt-lang-name">Árbol con Raíz 10, Izq 5, Der 15</span><div class="bt-exp-res">Recorrido In-Order ➔ 5, 10, 15 (Secuencia Ordenada)</div></div>
						</div>
					</div>
				</div>
			</div>

			<div class="bt-footer">
				<button class="btn btn-secondary" id="btn-prev-bt" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="bt-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-bt">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.bt-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.bt-shell { max-width: var(--container-max); margin: 0 auto; }
	.bt-header { margin-bottom: 1.5rem; }
	.bt-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.bt-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.bt-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.bt-sub.center { text-align: center; }
	.bt-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.bt-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.bt-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.bt-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.bt-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.bt-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.bt-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.bt-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.bt-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.bt-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.bt-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.bt-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.bt-col { grid-column: span 12; }
	@media (min-width: 900px) { .bt-col { grid-column: span 6; } }
	.bt-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.bt-slide-title.center { text-align: center; }
	.bt-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.bt-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.bt-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.bt-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.bt-tag { color: var(--color-accent-700); font-weight: 600; }
	.bt-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.bt-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.bt-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.bt-sim-container { max-width: 800px; margin: 0 auto; }
	.bt-inspector-grid { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 0.8rem; }
	.bt-lang-box { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.8rem; }
	.bt-lang-name { font-family: 'Fira Code', monospace; font-size: 0.75rem; font-weight: 700; color: #e59866; display: block; margin-bottom: 0.4rem; }
	.bt-exp-res { font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #f9f4ed; background: #141210; padding: 0.5rem 0.7rem; border-radius: var(--radius-sm); }
	.bt-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.bt-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.bt-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.bt-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('bt-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-bt') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-bt') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.bt-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-bt')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-bt')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	goToSlide(1);
</script>
