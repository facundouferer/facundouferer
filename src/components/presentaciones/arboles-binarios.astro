		let currentStep = 0;

		const prevBtn = document.getElementById('bt-prev') as HTMLButtonElement;
		const nextBtn = document.getElementById('bt-next') as HTMLButtonElement;
		const stepBadge = document.getElementById('bt-step') as HTMLElement;
		const funcBadge = document.getElementById('bt-func-badge') as HTMLElement;
		const copyEl = document.getElementById('bt-copy') as HTMLElement;
		const valEl = document.getElementById('bt-state-val') as HTMLElement;
		const raizEl = document.getElementById('bt-state-raiz') as HTMLElement;
		const compEl = document.getElementById('bt-state-comp') as HTMLElement;
		const consoleEl = document.getElementById('bt-console') as HTMLElement;
		const fillEl = document.getElementById('bt-fill') as HTMLElement;

		const codeInsertar = document.getElementById('code-insertar') as HTMLElement;
		const codeInorden = document.getElementById('code-inorden') as HTMLElement;
		const codeMain = document.getElementById('code-main') as HTMLElement;

		const isEnglish = document.documentElement.lang === 'en';

		function renderStep(): void {
			const step = steps[currentStep];

			// 1. Mostrar/Ocultar paneles de código según corresponda
			codeInsertar.classList.add('hidden');
			codeInorden.classList.add('hidden');
			codeMain.classList.add('hidden');

			let activePanel: HTMLElement;
			if (step.codeType === 'insertar') {
				activePanel = codeInsertar;
				funcBadge.textContent = 'insertar()';
			} else if (step.codeType === 'inorden') {
				activePanel = codeInorden;
				funcBadge.textContent = 'inorden()';
			} else {
				activePanel = codeMain;
				funcBadge.textContent = 'main()';
			}
			activePanel.classList.remove('hidden');

			// Resaltar línea de código activa
			activePanel.querySelectorAll('.bt-row').forEach((row) => {
				row.classList.toggle('active', Number((row as HTMLElement).dataset.line) === step.line);
			});

			// 2. Controlar la visibilidad de los nodos y conexiones SVG
			const allNodes = [50, 30, 70, 40];
			allNodes.forEach((id) => {
				const nodeEl = document.getElementById(`node-${id}`);
				if (nodeEl) {
					if (step.visibleNodes.includes(id)) {
						nodeEl.classList.remove('opacity-0', 'scale-50');
						nodeEl.style.opacity = '1';
						nodeEl.style.transform = 'scale(1)';
					} else {
						nodeEl.classList.add('opacity-0', 'scale-50');
						nodeEl.style.opacity = '0';
						nodeEl.style.transform = 'scale(0.5)';
					}

					// Resetear estilos de círculos
					const circle = nodeEl.querySelector('.node-circle');
					if (circle) {
						circle.classList.remove('active', 'printing');
						if (step.activeNode === id) {
							if (step.nodeStatus === 'active') circle.classList.add('active');
							if (step.nodeStatus === 'printing') circle.classList.add('printing');
						}
					}
				}
			});

			const allEdges = ['50-30', '50-70', '30-40'];
			allEdges.forEach((edgeId) => {
				const edgeEl = document.getElementById(`edge-${edgeId}`);
				if (edgeEl) {
					if (step.visibleEdges.includes(edgeId)) {
						edgeEl.classList.remove('opacity-0');
						edgeEl.classList.add('visible');
						edgeEl.style.opacity = '1';
					} else {
						edgeEl.classList.add('opacity-0');
						edgeEl.classList.remove('visible');
						edgeEl.style.opacity = '0';
					}
				}
			});

			// 3. Actualizar textos, estados e inputs
			stepBadge.textContent = isEnglish ? `Step ${currentStep + 1} / ${steps.length}` : `Paso ${currentStep + 1} / ${steps.length}`;
			copyEl.innerHTML = `<strong>${isEnglish ? 'Step' : 'Paso'} ${currentStep + 1}:</strong> ${step.message[isEnglish ? 'en' : 'es']}`;

			valEl.textContent = step.stateVars.valor;
			raizEl.textContent = step.stateVars.raiz;
			compEl.textContent = step.stateVars.comparacion;

			// Actualizar la consola
			consoleEl.innerHTML = '';
			step.consoleLines.forEach((line, index) => {
				const entry = document.createElement('div');
				entry.className = 'bt-log';
				entry.style.animationDelay = `${index * 80}ms`;
				entry.textContent = line.includes('\n') ? line : `> ${line}`;
				consoleEl.appendChild(entry);
			});

			// Progress bar
			fillEl.style.width = `${((currentStep + 1) / steps.length) * 100}%`;
			prevBtn.disabled = currentStep === 0;
			nextBtn.disabled = currentStep === steps.length - 1;
		}

		prevBtn.addEventListener('click', () => {
			if (currentStep > 0) {
				currentStep -= 1;
				renderStep();
			}
		});

		nextBtn.addEventListener('click', () => {
			if (currentStep < steps.length - 1) {
				currentStep += 1;
				renderStep();
			}
		});

		document.addEventListener('keydown', (event: KeyboardEvent) => {
			if (event.key === 'ArrowRight') nextBtn.click();
			if (event.key === 'ArrowLeft') prevBtn.click();
		});

		renderStep();
	</script>

