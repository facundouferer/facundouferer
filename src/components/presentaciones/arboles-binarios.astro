---
import Icon from '../Icon.astro';
import { withBase } from '../../utils/withBase';

type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
---


	<style is:global>
		@import url('https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Fira+Code:wght@400;500;700&display=swap');

		.bt-screen {
			--bt-bg: #0b1510;
			--bt-panel: #112216;
			--bt-primary: #0df259;
			--bt-cyan: #3b82f6;
			--bt-danger: #fb7185;
			min-height: 100vh;
			font-family: 'Chakra Petch', sans-serif;
			background:
				radial-gradient(circle at 85% 15%, rgba(13, 242, 89, 0.12), transparent 40%),
				radial-gradient(circle at 10% 80%, rgba(59, 130, 246, 0.10), transparent 42%),
				linear-gradient(150deg, #050a06 0%, var(--bt-bg) 100%);
			color: #ffeedd;
		}

		.bt-shell { max-width: 1200px; margin: 0 auto; padding: 2.5rem 1rem 3rem; }
		.bt-title { font-size: clamp(1.5rem, 3vw, 2.2rem); line-height: 1.05; font-weight: 700; }
		.bt-sub { max-width: 65ch; color: rgba(255, 238, 221, 0.84); }

		.bt-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1rem; }
		.bt-card { border-radius: 1rem; border: 1px solid rgba(13, 242, 89, 0.3); background: linear-gradient(155deg, rgba(17, 34, 22, 0.9), rgba(8, 16, 10, 0.95)); padding: 1rem; }
		.bt-code { grid-column: span 12; }
		.bt-viz { grid-column: span 12; }
		.bt-state { grid-column: span 12; }
		.bt-console { grid-column: span 12; }
		@media (min-width: 1100px) {
			.bt-code { grid-column: span 6; }
			.bt-viz { grid-column: span 6; }
			.bt-state { grid-column: span 6; }
			.bt-console { grid-column: span 6; }
		}

		.bt-badge { border: 1px solid rgba(13, 242, 89, 0.4); background: rgba(13, 242, 89, 0.12); border-radius: 999px; padding: 0.2rem 0.6rem; font-size: 0.72rem; font-family: 'Fira Code', monospace; }
		.bt-head { display: flex; justify-content: space-between; align-items: center; gap: 0.7rem; margin-bottom: 0.75rem; }

		.bt-code-panel { background: rgba(5, 10, 6, 0.88); border: 1px solid rgba(13, 242, 89, 0.24); border-radius: 0.8rem; padding: 0.75rem; min-height: 290px; }
		.bt-row { display: grid; grid-template-columns: 2rem 1fr; gap: 0.8rem; border-radius: 0.55rem; padding: 0.25rem 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; transition: all 0.2s ease; color: rgba(255, 238, 221, 0.86); }
		.bt-row.active { background: linear-gradient(90deg, rgba(13, 242, 89, 0.26), rgba(13, 242, 89, 0.06)); outline: 1px solid rgba(13, 242, 89, 0.4); transform: translateX(3px); }
		.bt-ln { color: rgba(13, 242, 89, 0.45); text-align: right; }

		.bt-state-item { display: flex; justify-content: space-between; align-items: center; border: 1px solid rgba(13, 242, 89, 0.24); background: rgba(13, 242, 89, 0.07); border-radius: 0.65rem; padding: 0.62rem 0.7rem; font-family: 'Fira Code', monospace; margin-bottom: 0.5rem; font-size: 0.84rem; }
		.bt-value { color: var(--bt-primary); font-weight: 700; font-size: 1.02rem; }

		.bt-console-win { border: 1px solid rgba(13, 242, 89, 0.36); border-radius: 0.8rem; overflow: hidden; background: rgba(5, 10, 6, 0.88); }
		.bt-console-head { display: flex; justify-content: space-between; padding: 0.5rem 0.75rem; font-family: 'Fira Code', monospace; font-size: 0.72rem; background: rgba(13, 242, 89, 0.12); border-bottom: 1px solid rgba(13, 242, 89, 0.3); }
		.bt-console-body { min-height: 120px; padding: 0.75rem; font-family: 'Fira Code', monospace; font-size: 0.83rem; }
		.bt-log { opacity: 0; transform: translateY(8px); animation: bt-log-in 0.4s ease forwards; color: #a3f4b8; }
		@keyframes bt-log-in { to { opacity: 1; transform: translateY(0); } }

		.bt-copy { margin-top: 0.85rem; border: 1px solid rgba(13, 242, 89, 0.32); background: rgba(13, 242, 89, 0.11); border-radius: 0.7rem; padding: 0.75rem; font-size: 0.95rem; line-height: 1.4; }
		.bt-controls { margin-top: 0.9rem; display: flex; gap: 0.7rem; flex-wrap: wrap; align-items: center; }
		.bt-btn { border: 1px solid rgba(13, 242, 89, 0.45); background: rgba(13, 242, 89, 0.13); color: #ffeedd; padding: 0.58rem 1rem; border-radius: 0.7rem; font-weight: 600; transition: all 0.2s ease; cursor: pointer; }
		.bt-btn:hover:not(:disabled) { background: rgba(13, 242, 89, 0.26); transform: translateY(-1px); box-shadow: 0 0 18px rgba(13, 242, 89, 0.24); }
		.bt-btn:disabled { opacity: 0.4; cursor: not-allowed; }

		.bt-track { margin-top: 0.8rem; height: 0.55rem; border-radius: 999px; background: rgba(255, 238, 221, 0.14); overflow: hidden; }
		.bt-fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--bt-primary), var(--bt-cyan)); transition: width 0.25s ease; }

		.bt-back { display: inline-block; margin-top: 1.5rem; color: var(--bt-primary); text-decoration: none; border-bottom: 1px dashed rgba(13, 242, 89, 0.5); font-family: monospace; font-size: 0.9rem; }

		/* Animaciones de Nodos */
		.node-g {
			transition: opacity 0.4s ease, transform 0.4s ease;
		}
		.node-circle {
			transition: fill 0.3s ease, stroke 0.3s ease, filter 0.3s ease;
		}
		.node-circle.active {
			fill: var(--bt-primary) !important;
			stroke: #fff !important;
			filter: drop-shadow(0 0 8px var(--bt-primary));
		}
		.node-circle.printing {
			fill: var(--bt-cyan) !important;
			stroke: #fff !important;
			filter: drop-shadow(0 0 8px var(--bt-cyan));
		}
		.edge-line {
			transition: opacity 0.4s ease, stroke-dashoffset 0.6s ease;
			stroke-dasharray: 100;
			stroke-dashoffset: 100;
		}
		.edge-line.visible {
			stroke-dashoffset: 0;
		}
	</style>

	<div class="bt-screen">
		<main class="bt-shell">
			<header class="mb-6">
				<p class="bt-badge">{lang === 'en' ? 'C / Binary Search Tree (BST) Simulation' : 'C / Simulacion de Arbol Binario de Busqueda'}</p>
				<h1 class="bt-title mt-3">{lang === 'en' ? <>Binary Trees<br/>step by step</> : <>Árboles Binarios<br/>paso a paso</>}</h1>
				<p class="bt-sub mt-3">
					{lang === 'en' 
						? 'See graphically how nodes are created and connected in a BST using recursion, followed by an in-order traversal.' 
						: 'Mira graficamente como se crean y conectan los nodos en un BST usando recursividad, y como funciona el recorrido inorden.'
					}
				</p>
			</header>

			<section class="bt-grid" aria-live="polite">
				<!-- Panel de Código C -->
				<article class="bt-card bt-code">
					<div class="bt-head">
						<strong>{lang === 'en' ? '1) Code & Execution Context' : '1) Codigo y Contexto de Ejecucion'}</strong>
						<span class="bt-badge" id="bt-func-badge">main()</span>
					</div>
					
					<!-- Código de insertar() -->
					<div class="bt-code-panel" id="code-insertar">
						<div class="bt-row" data-line="1"><span class="bt-ln">1</span><span>struct Nodo* insertar(struct Nodo* raiz, int valor) &#123;</span></div>
						<div class="bt-row" data-line="2"><span class="bt-ln">2</span><span>&nbsp;&nbsp;if (raiz == NULL) &#123;</span></div>
						<div class="bt-row" data-line="3"><span class="bt-ln">3</span><span>&nbsp;&nbsp;&nbsp;&nbsp;return crearNodo(valor);</span></div>
						<div class="bt-row" data-line="4"><span class="bt-ln">4</span><span>&nbsp;&nbsp;&#125;</span></div>
						<div class="bt-row" data-line="5"><span class="bt-ln">5</span><span>&nbsp;&nbsp;if (valor &lt; raiz-&gt;dato) &#123;</span></div>
						<div class="bt-row" data-line="6"><span class="bt-ln">6</span><span>&nbsp;&nbsp;&nbsp;&nbsp;raiz-&gt;izquierdo = insertar(raiz-&gt;izquierdo, valor);</span></div>
						<div class="bt-row" data-line="7"><span class="bt-ln">7</span><span>&nbsp;&nbsp;&#125; else if (valor &gt; raiz-&gt;dato) &#123;</span></div>
						<div class="bt-row" data-line="8"><span class="bt-ln">8</span><span>&nbsp;&nbsp;&nbsp;&nbsp;raiz-&gt;derecho = insertar(raiz-&gt;derecho, valor);</span></div>
						<div class="bt-row" data-line="9"><span class="bt-ln">9</span><span>&nbsp;&nbsp;&#125;</span></div>
						<div class="bt-row" data-line="10"><span class="bt-ln">10</span><span>&nbsp;&nbsp;return raiz;</span></div>
						<div class="bt-row" data-line="11"><span class="bt-ln">11</span><span>&#125;</span></div>
					</div>

					<!-- Código de inorden() -->
					<div class="bt-code-panel hidden" id="code-inorden">
						<div class="bt-row" data-line="12"><span class="bt-ln">12</span><span>void inorden(struct Nodo* raiz) &#123;</span></div>
						<div class="bt-row" data-line="13"><span class="bt-ln">13</span><span>&nbsp;&nbsp;if (raiz != NULL) &#123;</span></div>
						<div class="bt-row" data-line="14"><span class="bt-ln">14</span><span>&nbsp;&nbsp;&nbsp;&nbsp;inorden(raiz-&gt;izquierdo);</span></div>
						<div class="bt-row" data-line="15"><span class="bt-ln">15</span><span>&nbsp;&nbsp;&nbsp;&nbsp;printf("%d ", raiz-&gt;dato);</span></div>
						<div class="bt-row" data-line="16"><span class="bt-ln">16</span><span>&nbsp;&nbsp;&nbsp;&nbsp;inorden(raiz-&gt;derecho);</span></div>
						<div class="bt-row" data-line="17"><span class="bt-ln">17</span><span>&nbsp;&nbsp;&#125;</span></div>
						<div class="bt-row" data-line="18"><span class="bt-ln">18</span><span>&#125;</span></div>
					</div>

					<!-- Código de main() -->
					<div class="bt-code-panel hidden" id="code-main">
						<div class="bt-row" data-line="19"><span class="bt-ln">19</span><span>int main() &#123;</span></div>
						<div class="bt-row" data-line="20"><span class="bt-ln">20</span><span>&nbsp;&nbsp;struct Nodo* raiz = NULL;</span></div>
						<div class="bt-row" data-line="21"><span class="bt-ln">21</span><span>&nbsp;&nbsp;raiz = insertar(raiz, 50);</span></div>
						<div class="bt-row" data-line="22"><span class="bt-ln">22</span><span>&nbsp;&nbsp;insertar(raiz, 30);</span></div>
						<div class="bt-row" data-line="23"><span class="bt-ln">23</span><span>&nbsp;&nbsp;insertar(raiz, 70);</span></div>
						<div class="bt-row" data-line="24"><span class="bt-ln">24</span><span>&nbsp;&nbsp;insertar(raiz, 40);</span></div>
						<div class="bt-row" data-line="25"><span class="bt-ln">25</span><span>&nbsp;&nbsp;inorden(raiz);</span></div>
						<div class="bt-row" data-line="26"><span class="bt-ln">26</span><span>&nbsp;&nbsp;return 0;</span></div>
						<div class="bt-row" data-line="27"><span class="bt-ln">27</span><span>&#125;</span></div>
					</div>

					<div class="bt-copy" id="bt-copy"><strong>Paso 1:</strong> ...</div>
					<div class="bt-track"><div class="bt-fill" id="bt-fill"></div></div>

					<div class="bt-controls">
						<button id="bt-prev" class="bt-btn" type="button">{lang === 'en' ? '⬅ Back' : '⬅ Retroceder'}</button>
						<button id="bt-next" class="bt-btn" type="button">{lang === 'en' ? 'Next ➡' : 'Avanzar ➡'}</button>
						<span class="bt-badge" id="bt-step">{lang === 'en' ? 'Step 1 / 19' : 'Paso 1 / 19'}</span>
					</div>
				</article>

				<!-- Visualización Gráfica SVG -->
				<article class="bt-card bt-viz flex flex-col justify-between">
					<div class="bt-head">
						<strong>{lang === 'en' ? '2) Visual Tree Representation' : '2) Representacion Visual del Arbol'}</strong>
						<span class="text-xs text-primary font-mono">// BST</span>
					</div>
					
					<div class="flex-1 flex items-center justify-center p-4 bg-black/40 rounded-lg min-h-[300px]">
						<svg viewBox="0 0 400 300" class="w-full h-full max-w-[400px]">
							<!-- Conexiones (Edges) -->
							<line id="edge-50-30" x1="200" y1="60" x2="100" y2="140" stroke="rgba(13, 242, 89, 0.4)" stroke-width="3" class="edge-line opacity-0" />
							<line id="edge-50-70" x1="200" y1="60" x2="300" y2="140" stroke="rgba(13, 242, 89, 0.4)" stroke-width="3" class="edge-line opacity-0" />
							<line id="edge-30-40" x1="100" y1="140" x2="170" y2="220" stroke="rgba(13, 242, 89, 0.4)" stroke-width="3" class="edge-line opacity-0" />

							<!-- Nodos -->
							<g id="node-50" class="node-g opacity-0 scale-50" style="transform-origin: 200px 60px;">
								<circle cx="200" cy="60" r="22" fill="#050a06" stroke="#0df259" stroke-width="3" class="node-circle" />
								<text x="200" y="66" fill="#fff" font-family="monospace" font-size="14" font-weight="bold" text-anchor="middle">50</text>
							</g>

							<g id="node-30" class="node-g opacity-0 scale-50" style="transform-origin: 100px 140px;">
								<circle cx="100" cy="140" r="22" fill="#050a06" stroke="#0df259" stroke-width="3" class="node-circle" />
								<text x="100" y="146" fill="#fff" font-family="monospace" font-size="14" font-weight="bold" text-anchor="middle">30</text>
							</g>

							<g id="node-70" class="node-g opacity-0 scale-50" style="transform-origin: 300px 140px;">
								<circle cx="300" cy="140" r="22" fill="#050a06" stroke="#0df259" stroke-width="3" class="node-circle" />
								<text x="300" y="146" fill="#fff" font-family="monospace" font-size="14" font-weight="bold" text-anchor="middle">70</text>
							</g>

							<g id="node-40" class="node-g opacity-0 scale-50" style="transform-origin: 170px 220px;">
								<circle cx="170" cy="220" r="22" fill="#050a06" stroke="#0df259" stroke-width="3" class="node-circle" />
								<text x="170" y="226" fill="#fff" font-family="monospace" font-size="14" font-weight="bold" text-anchor="middle">40</text>
							</g>
						</svg>
					</div>
				</article>

				<!-- Estado Interno -->
				<article class="bt-card bt-state">
					<div class="bt-head"><strong>{lang === 'en' ? '3) Memory & Scope State' : '3) Estado de Memoria y Scope'}</strong></div>
					<div class="bt-state-item"><span>{lang === 'en' ? 'Parameter: valor' : 'Parametro: valor'}</span><span id="bt-state-val" class="bt-value">-</span></div>
					<div class="bt-state-item"><span>{lang === 'en' ? 'Parameter: raiz' : 'Parametro: raiz'}</span><span id="bt-state-raiz" class="bt-value">-</span></div>
					<div class="bt-state-item"><span>{lang === 'en' ? 'Comparison / Action' : 'Comparacion / Accion'}</span><span id="bt-state-comp" class="bt-value">-</span></div>
				</article>

				<!-- Consola Simulada -->
				<article class="bt-card bt-console">
					<div class="bt-head"><strong>{lang === 'en' ? '4) Standard Output (stdout)' : '4) Salida Estandar (stdout)'}</strong></div>
					<div class="bt-console-win">
						<div class="bt-console-head"><span>./arboles-binarios-demo</span><span>stdout</span></div>
						<div class="bt-console-body" id="bt-console"></div>
					</div>
				</article>
			</section>

			<a href={withBase(lang === 'en' ? '/en/presentaciones' : '/presentaciones')} class="bt-back">
				[ {lang === 'en' ? 'BACK TO DIRECTORY' : 'VOLVER AL DIRECTORIO'} ]
			</a>
		</main>
	</div>

	<script>
		type Step = {
			line: number;
			codeType: 'insertar' | 'inorden' | 'main';
			message: { es: string; en: string };
			activeNode: number | null;
			nodeStatus: 'active' | 'printing' | null;
			visibleNodes: number[];
			visibleEdges: string[];
			consoleLines: string[];
			stateVars: {
				valor: string;
				raiz: string;
				comparacion: string;
			};
		};

		const steps: Step[] = [
			{
				line: 20,
				codeType: 'main',
				message: {
					es: 'Inicializamos la raíz del árbol en NULL. El árbol está completamente vacío.',
					en: 'We initialize the tree root to NULL. The tree is completely empty.'
				},
				activeNode: null,
				nodeStatus: null,
				visibleNodes: [],
				visibleEdges: [],
				consoleLines: [],
				stateVars: { valor: '-', raiz: 'NULL', comparacion: '-' }
			},
			{
				line: 2,
				codeType: 'insertar',
				message: {
					es: 'Llamamos a insertar(raiz, 50). Como raiz es NULL, la condición se cumple y creamos el nodo.',
					en: 'We call insert(root, 50). Since root is NULL, the condition is met and we create the node.'
				},
				activeNode: 50,
				nodeStatus: 'active',
				visibleNodes: [50],
				visibleEdges: [],
				consoleLines: [],
				stateVars: { valor: '50', raiz: 'NULL', comparacion: 'raiz == NULL -> TRUE' }
			},
			{
				line: 21,
				codeType: 'main',
				message: {
					es: 'El nodo 50 se asigna a "raiz" en la función main. Ya tenemos la raíz del árbol.',
					en: 'Node 50 is assigned to "root" in the main function. We now have the root of the tree.'
				},
				activeNode: 50,
				nodeStatus: null,
				visibleNodes: [50],
				visibleEdges: [],
				consoleLines: [],
				stateVars: { valor: '-', raiz: '50', comparacion: 'Asignacion en main' }
			},
			{
				line: 5,
				codeType: 'insertar',
				message: {
					es: 'Llamamos a insertar(raiz, 30). Comparamos: 30 < 50. Es verdadero, navegamos al subárbol izquierdo.',
					en: 'We call insert(root, 30). We compare: 30 < 50. This is true, so we navigate to the left subtree.'
				},
				activeNode: 50,
				nodeStatus: 'active',
				visibleNodes: [50],
				visibleEdges: [],
				consoleLines: [],
				stateVars: { valor: '30', raiz: '50', comparacion: '30 < 50 -> TRUE (Izquierda)' }
			},
			{
				line: 2,
				codeType: 'insertar',
				message: {
					es: 'Llamada recursiva con raiz->izquierdo (que es NULL). Como es NULL, creamos el nodo 30 aquí.',
					en: 'Recursive call with root->left (which is NULL). Since it is NULL, we create node 30 here.'
				},
				activeNode: 30,
				nodeStatus: 'active',
				visibleNodes: [50, 30],
				visibleEdges: ['50-30'],
				consoleLines: [],
				stateVars: { valor: '30', raiz: 'NULL', comparacion: 'raiz == NULL -> TRUE' }
			},
			{
				line: 22,
				codeType: 'main',
				message: {
					es: 'El nodo 30 queda enlazado como hijo izquierdo de 50. Regresamos a la función main.',
					en: 'Node 30 is linked as the left child of 50. We return to the main function.'
				},
				activeNode: null,
				nodeStatus: null,
				visibleNodes: [50, 30],
				visibleEdges: ['50-30'],
				consoleLines: [],
				stateVars: { valor: '-', raiz: '50', comparacion: 'Insercion de 30 lista' }
			},
			{
				line: 7,
				codeType: 'insertar',
				message: {
					es: 'Llamamos a insertar(raiz, 70). Comparamos: 70 > 50. Es verdadero, vamos al subárbol derecho.',
					en: 'We call insert(root, 70). We compare: 70 > 50. This is true, so we go to the right subtree.'
				},
				activeNode: 50,
				nodeStatus: 'active',
				visibleNodes: [50, 30],
				visibleEdges: ['50-30'],
				consoleLines: [],
				stateVars: { valor: '70', raiz: '50', comparacion: '70 > 50 -> TRUE (Derecha)' }
			},
			{
				line: 2,
				codeType: 'insertar',
				message: {
					es: 'Llamada recursiva con raiz->derecho (NULL). Creamos el nodo 70 en esa posición.',
					en: 'Recursive call with root->right (NULL). We create node 70 in that position.'
				},
				activeNode: 70,
				nodeStatus: 'active',
				visibleNodes: [50, 30, 70],
				visibleEdges: ['50-30', '50-70'],
				consoleLines: [],
				stateVars: { valor: '70', raiz: 'NULL', comparacion: 'raiz == NULL -> TRUE' }
			},
			{
				line: 23,
				codeType: 'main',
				message: {
					es: 'El nodo 70 queda enlazado como hijo derecho de 50. Volvemos a main.',
					en: 'Node 70 is linked as the right child of 50. We return to main.'
				},
				activeNode: null,
				nodeStatus: null,
				visibleNodes: [50, 30, 70],
				visibleEdges: ['50-30', '50-70'],
				consoleLines: [],
				stateVars: { valor: '-', raiz: '50', comparacion: 'Insercion de 70 lista' }
			},
			{
				line: 5,
				codeType: 'insertar',
				message: {
					es: 'Insertamos 40. Primera comparación en la raíz: 40 < 50. Vamos hacia el hijo izquierdo (30).',
					en: 'We insert 40. First comparison at root: 40 < 50. We go towards the left child (30).'
				},
				activeNode: 50,
				nodeStatus: 'active',
				visibleNodes: [50, 30, 70],
				visibleEdges: ['50-30', '50-70'],
				consoleLines: [],
				stateVars: { valor: '40', raiz: '50', comparacion: '40 < 50 -> TRUE (Izquierda)' }
			},
			{
				line: 7,
				codeType: 'insertar',
				message: {
					es: 'Segunda comparación (en el nodo 30): 40 > 30. Es verdadero, navegamos hacia la derecha de 30.',
					en: 'Second comparison (at node 30): 40 > 30. This is true, so we navigate to the right of 30.'
				},
				activeNode: 30,
				nodeStatus: 'active',
				visibleNodes: [50, 30, 70],
				visibleEdges: ['50-30', '50-70'],
				consoleLines: [],
				stateVars: { valor: '40', raiz: '30', comparacion: '40 > 30 -> TRUE (Derecha)' }
			},
			{
				line: 2,
				codeType: 'insertar',
				message: {
					es: 'Llamada recursiva con el hijo derecho de 30 (que es NULL). Creamos el nodo 40 aquí.',
