---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="is-screen">
	<div class="is-shell">
		<header class="is-header">
			<span class="is-badge">{isEs ? 'Algoritmos de Ordenamiento' : 'Sorting Algorithms'}</span>
			<h1 class="is-title">
				{isEs ? 'Insertion Sort (Inserción) Paso a Paso' : 'Insertion Sort Step by Step'}
			</h1>
			<p class="is-sub">
				{isEs 
					? 'Inserción adaptativa, listas semi-ordenadas y O(N) mejor caso en C, Java, JavaScript y Python.' 
					: 'Adaptive insertion, semi-sorted lists, and O(N) best case in C, Java, JS, and Python.'}
			</p>
		</header>

		<div class="is-deck-card">
			<div class="is-nav-bar">
				<div class="is-slide-indicator">
					<span class="is-step-dot"></span>
					<span id="is-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="is-pills">
					<button class="is-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="is-pill-btn" data-target-slide="2">2. C</button>
					<button class="is-pill-btn" data-target-slide="3">3. Java</button>
					<button class="is-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="is-pill-btn" data-target-slide="5">5. Python</button>
					<button class="is-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="is-viewport">
				<div class="is-slide active" data-slide="1">
					<div class="is-slide-grid">
						<div class="is-col">
							<h2 class="is-slide-title">1. {isEs ? 'Mecánica de Inserción Adaptativa' : 'Adaptive Insertion Mechanics'}</h2>
							<p class="is-text">
								{isEs 
									? 'Insertion Sort funciona de forma similar a ordenar cartas en la mano: toma un elemento y lo desplaza hacia la izquierda hasta insertarlo en su posición correcta.'
									: 'Insertion Sort builds the final sorted array one item at a time, sliding elements leftward like sorting playing cards.'}
							</p>
						</div>
						<div class="is-col">
							<div class="is-card-box">
								<div class="is-card-head">{isEs ? 'ANÁLISIS ALGORÍTMICO' : 'ALGORITHMIC ANALYSIS'}</div>
								<div class="is-cell"><span>Mejor Caso (Array Casi Ordenado)</span><span class="is-tag">O(N) lineal</span></div>
								<div class="is-cell"><span>Peor Caso (Invertido)</span><span class="is-tag">O(N²)</span></div>
								<div class="is-cell"><span>Estabilidad</span><span class="is-tag">Estable (preserva orden)</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="is-slide" data-slide="2">
					<div class="is-slide-grid">
						<div class="is-col">
							<h2 class="is-slide-title">2. C: Insertion Sort</h2>
							<p class="is-text">Ideal para conjuntos pequeños de datos o vectores casi ordenados.</p>
						</div>
						<div class="is-col">
							<div class="is-code-card">
								<div class="is-code-title">insertion.c</div>
								<pre class="is-code-block"><code><span class="token-keyword">void</span> insertionSort(<span class="token-type">int</span> arr[], <span class="token-type">int</span> n) &#123;
    <span class="token-keyword">for</span> (<span class="token-type">int</span> i = <span class="token-number">1</span>; i &lt; n; i++) &#123;
        <span class="token-type">int</span> key = arr[i];
        <span class="token-type">int</span> j = i - <span class="token-number">1</span>;
        <span class="token-keyword">while</span> (j &gt;= <span class="token-number">0</span> &amp;&amp; arr[j] &gt; key) &#123;
            arr[j + <span class="token-number">1</span>] = arr[j];
            j--;
        &#125;
        arr[j + <span class="token-number">1</span>] = key;
    &#125;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="is-slide" data-slide="3">
					<div class="is-slide-grid">
						<div class="is-col">
							<h2 class="is-slide-title">3. Java: Insertion Sort</h2>
							<p class="is-text">Utilizado internamente como subrutina en algoritmos híbridos de ordenamiento (Timsort / Dual-Pivot Quicksort) para particiones pequeñas.</p>
						</div>
						<div class="is-col">
							<div class="is-code-card">
								<div class="is-code-title">InsertionSort.java</div>
								<pre class="is-code-block"><code><span class="token-keyword">public static void</span> insertionSort(<span class="token-type">int</span>[] arr) &#123;
    <span class="token-keyword">for</span> (<span class="token-type">int</span> i = <span class="token-number">1</span>; i &lt; arr.length; i++) &#123;
        <span class="token-type">int</span> key = arr[i];
        <span class="token-type">int</span> j = i - <span class="token-number">1</span>;
        <span class="token-keyword">while</span> (j &gt;= <span class="token-number">0</span> &amp;&amp; arr[j] &gt; key) &#123;
            arr[j + <span class="token-number">1</span>] = arr[j]; j--;
        &#125;
        arr[j + <span class="token-number">1</span>] = key;
    &#125;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="is-slide" data-slide="4">
					<div class="is-slide-grid">
						<div class="is-col">
							<h2 class="is-slide-title">4. JavaScript: Insertion Sort</h2>
							<p class="is-text">Procesamiento eficiente de desplazamiento de claves mediante bucle `while`.</p>
						</div>
						<div class="is-col">
							<div class="is-code-card">
								<div class="is-code-title">insertion.js</div>
								<pre class="is-code-block"><code><span class="token-keyword">function</span> insertionSort(arr) &#123;
    <span class="token-keyword">for</span> (<span class="token-keyword">let</span> i = <span class="token-number">1</span>; i &lt; arr.length; i++) &#123;
        <span class="token-keyword">let</span> key = arr[i];
        <span class="token-keyword">let</span> j = i - <span class="token-number">1</span>;
        <span class="token-keyword">while</span> (j &gt;= <span class="token-number">0</span> &amp;&amp; arr[j] &gt; key) &#123;
            arr[j + <span class="token-number">1</span>] = arr[j];
            j--;
        &#125;
        arr[j + <span class="token-number">1</span>] = key;
    &#125;
    <span class="token-keyword">return</span> arr;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="is-slide" data-slide="5">
					<div class="is-slide-grid">
						<div class="is-col">
							<h2 class="is-slide-title">5. Python: Insertion Sort</h2>
							<p class="is-text">Sintaxis directa con bucle `while` decrementando el índice `j`.</p>
						</div>
						<div class="is-col">
							<div class="is-code-card">
								<div class="is-code-title">insertion.py</div>
								<pre class="is-code-block"><code><span class="token-keyword">def</span> insertion_sort(arr):
    <span class="token-keyword">for</span> i <span class="token-keyword">in</span> range(<span class="token-number">1</span>, len(arr)):
        key = arr[i]
        j = i - <span class="token-number">1</span>
        <span class="token-keyword">while</span> j &gt;= <span class="token-number">0</span> <span class="token-keyword">and</span> arr[j] &gt; key:
            arr[j + <span class="token-number">1</span>] = arr[j]
            j -= <span class="token-number">1</span>
        arr[j + <span class="token-number">1</span>] = key
    <span class="token-keyword">return</span> arr</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="is-slide" data-slide="6">
					<div class="is-sim-container">
						<h2 class="is-slide-title center">{isEs ? '6. Inspector de Inserción de Clave' : '6. Key Insertion Inspector'}</h2>
						<div class="is-inspector-grid">
							<div class="is-lang-box"><span class="is-lang-name">Array: [12, 11, 13]</span><div class="is-exp-res">Clave key=11 ➔ Desplaza 12 a pos 1 ➔ Inserta 11 en pos 0 ➔ [11, 12, 13]</div></div>
						</div>
					</div>
				</div>
			</div>

			<div class="is-footer">
				<button class="btn btn-secondary" id="btn-prev-is" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="is-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-is">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.is-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.is-shell { max-width: var(--container-max); margin: 0 auto; }
	.is-header { margin-bottom: 1.5rem; }
	.is-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.is-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.is-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.is-sub.center { text-align: center; }
	.is-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.is-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.is-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.is-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.is-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.is-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.is-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.is-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.is-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.is-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.is-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.is-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.is-col { grid-column: span 12; }
	@media (min-width: 900px) { .is-col { grid-column: span 6; } }
	.is-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.is-slide-title.center { text-align: center; }
	.is-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.is-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.is-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.is-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.is-tag { color: var(--color-accent-700); font-weight: 600; }
	.is-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.is-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.is-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.is-sim-container { max-width: 800px; margin: 0 auto; }
	.is-inspector-grid { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 0.8rem; }
	.is-lang-box { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.8rem; }
	.is-lang-name { font-family: 'Fira Code', monospace; font-size: 0.75rem; font-weight: 700; color: #e59866; display: block; margin-bottom: 0.4rem; }
	.is-exp-res { font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #f9f4ed; background: #141210; padding: 0.5rem 0.7rem; border-radius: var(--radius-sm); }
	.is-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.is-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.is-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.is-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('is-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-is') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-is') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.is-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-is')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-is')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	goToSlide(1);
</script>
