---
interface Props {
	lang?: string;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
const t = (es: string, en: string) => (isEs ? es : en);

// The C programs shown in the deck. Every program compiles with
// `cc -std=c23 -Wall -Wextra -Wpedantic`; the ones that hold a lifetime bug
// on purpose (dangling, record, largest, formatPrice) are marked as such in the slides.
// c-code:start
const C_CODE = {
	es: {
		auto: String.raw`#include <stdio.h>

void mostrar_cuadrado(int n) {
    int cuadrado = n * n;
    printf("%d al cuadrado es %d\n", n, cuadrado);
}

int main(void) {
    for (int i = 1; i <= 3; i++) {
        int doble = i * 2;
        printf("doble de %d: %d\n", i, doble);
    }
    mostrar_cuadrado(4);
    mostrar_cuadrado(5);
    return 0;
}`,
		static: String.raw`#include <stdio.h>

int llamadas_totales = 0;

int siguiente_turno(void) {
    static int turno = 0;
    turno++;
    llamadas_totales++;
    return turno;
}

int main(void) {
    printf("Turno %d\n", siguiente_turno());
    printf("Turno %d\n", siguiente_turno());
    printf("Turno %d\n", siguiente_turno());
    printf("Llamadas: %d\n", llamadas_totales);
    return 0;
}`,
		dangling: String.raw`#include <stdio.h>

int *calcular_doble(int n) {
    int resultado = n * 2;
    return &resultado;
}

int main(void) {
    int *p = calcular_doble(21);
    printf("%d\n", *p);
    return 0;
}`,
		block: String.raw`#include <stdio.h>

int main(void) {
    int *p = NULL;
    {
        int temporal = 42;
        p = &temporal;
        printf("Dentro del bloque: %d\n", *p);
    }
    printf("Fuera del bloque: %d\n", *p);
    return 0;
}`,
		buffer: String.raw`#include <stdio.h>

bool armar_saludo(char *destino, size_t capacidad, const char *nombre) {
    int escritos = snprintf(destino, capacidad, "Hola, %s", nombre);
    return escritos >= 0 && (size_t)escritos < capacidad;
}

int main(void) {
    char saludo[32];
    if (armar_saludo(saludo, sizeof saludo, "Ana")) {
        printf("%s\n", saludo);
    }
    return 0;
}`,
		count: String.raw`#include <stdio.h>

int contar(void) {
    static int veces = 0;
    int local = 0;
    veces++;
    local++;
    return veces * 10 + local;
}

int main(void) {
    printf("%d\n", contar());
    printf("%d\n", contar());
    printf("%d\n", contar());
    return 0;
}`,
		day: String.raw`#include <stdio.h>

const char *nombre_del_dia(int dia) {
    static char texto[16];
    snprintf(texto, sizeof texto, "Dia %d", dia);
    return texto;
}

int main(void) {
    const char *a = nombre_del_dia(1);
    const char *b = nombre_del_dia(2);
    printf("%s / %s\n", a, b);
    return 0;
}`,
		record: String.raw`#include <stdio.h>

struct registro {
    int *dato;
};

struct registro registro_global = { NULL };

void guardar(void) {
    int valor = 7;
    registro_global.dato = &valor;
}

int main(void) {
    guardar();
    return 0;
}`,
		process: String.raw`int total = 0;

void procesar(int x) {
    static int contador = 0;
    char buffer[8] = "";
    for (int i = 0; i < x; i++) {
        contador++;
    }
    total += contador + buffer[0];
}`,
		largest: String.raw`#include <stddef.h>

int *mayor(const int *valores, size_t n) {
    int maximo = valores[0];
    for (size_t i = 1; i < n; i++) {
        if (valores[i] > maximo) {
            maximo = valores[i];
        }
    }
    return &maximo;
}`,
		formatPrice: String.raw`#include <stdio.h>

const char *formatear_precio(double precio) {
    char texto[32];
    snprintf(texto, sizeof texto, "$ %.2f", precio);
    return texto;
}`,
	},
	en: {
		auto: String.raw`#include <stdio.h>

void show_square(int n) {
    int square = n * n;
    printf("%d squared is %d\n", n, square);
}

int main(void) {
    for (int i = 1; i <= 3; i++) {
        int twice = i * 2;
        printf("twice %d: %d\n", i, twice);
    }
    show_square(4);
    show_square(5);
    return 0;
}`,
		static: String.raw`#include <stdio.h>

int total_calls = 0;

int next_turn(void) {
    static int turn = 0;
    turn++;
    total_calls++;
    return turn;
}

int main(void) {
    printf("Turn %d\n", next_turn());
    printf("Turn %d\n", next_turn());
    printf("Turn %d\n", next_turn());
    printf("Calls: %d\n", total_calls);
    return 0;
}`,
		dangling: String.raw`#include <stdio.h>

int *compute_double(int n) {
    int result = n * 2;
    return &result;
}

int main(void) {
    int *p = compute_double(21);
    printf("%d\n", *p);
    return 0;
}`,
		block: String.raw`#include <stdio.h>

int main(void) {
    int *p = NULL;
    {
        int temporary = 42;
        p = &temporary;
        printf("Inside the block: %d\n", *p);
    }
    printf("Outside the block: %d\n", *p);
    return 0;
}`,
		buffer: String.raw`#include <stdio.h>

bool build_greeting(char *destination, size_t capacity, const char *name) {
    int written = snprintf(destination, capacity, "Hello, %s", name);
    return written >= 0 && (size_t)written < capacity;
}

int main(void) {
    char greeting[32];
    if (build_greeting(greeting, sizeof greeting, "Ana")) {
        printf("%s\n", greeting);
    }
    return 0;
}`,
		count: String.raw`#include <stdio.h>

int count(void) {
    static int times = 0;
    int local = 0;
    times++;
    local++;
    return times * 10 + local;
}

int main(void) {
    printf("%d\n", count());
    printf("%d\n", count());
    printf("%d\n", count());
    return 0;
}`,
		day: String.raw`#include <stdio.h>

const char *day_name(int day) {
    static char text[16];
    snprintf(text, sizeof text, "Day %d", day);
    return text;
}

int main(void) {
    const char *a = day_name(1);
    const char *b = day_name(2);
    printf("%s / %s\n", a, b);
    return 0;
}`,
		record: String.raw`#include <stdio.h>

struct record {
    int *data;
};

struct record global_record = { NULL };

void save(void) {
    int value = 7;
    global_record.data = &value;
}

int main(void) {
    save();
    return 0;
}`,
		process: String.raw`int total = 0;

void process(int x) {
    static int counter = 0;
    char buffer[8] = "";
    for (int i = 0; i < x; i++) {
        counter++;
    }
    total += counter + buffer[0];
}`,
		largest: String.raw`#include <stddef.h>

int *largest(const int *values, size_t n) {
    int maximum = values[0];
    for (size_t i = 1; i < n; i++) {
        if (values[i] > maximum) {
            maximum = values[i];
        }
    }
    return &maximum;
}`,
		formatPrice: String.raw`#include <stdio.h>

const char *format_price(double price) {
    char text[32];
    snprintf(text, sizeof text, "$ %.2f", price);
    return text;
}`,
	},
};
// c-code:end

type CodeKey = keyof (typeof C_CODE)['es'];
const code = (key: CodeKey) => C_CODE[isEs ? 'es' : 'en'][key].split('\n');

type Var = { n: string; a: string; v: string; st?: 'new' | 'chg' | 'dead'; p?: string; bad?: boolean };
type Frame = { fn: string; v: Var[]; st?: 'new' | 'dead' };
type State = { s?: Var[]; f?: Frame[]; h?: Var[]; out?: string[]; focus?: 'static' | 'stack' | 'heap' };
type Step = State & { ln?: number; note: string };

const V = (n: string, a: string, v: string, st?: Var['st'], extra: Partial<Var> = {}): Var => ({ n, a, v, st, ...extra });
const F = (fn: string, v: Var[], st?: Frame['st']): Frame => ({ fn, v, st });

// Identifiers, localized like the lesson does.
const id = {
	square: t('cuadrado', 'square'),
	showSquare: t('mostrar_cuadrado', 'show_square'),
	twice: t('doble', 'twice'),
	totalCalls: t('llamadas_totales', 'total_calls'),
	turn: t('turno', 'turn'),
	nextTurn: t('siguiente_turno', 'next_turn'),
	result: t('resultado', 'result'),
	computeDouble: t('calcular_doble', 'compute_double'),
	temporary: t('temporal', 'temporary'),
	greeting: t('saludo', 'greeting'),
	buildGreeting: t('armar_saludo', 'build_greeting'),
	destination: t('destino', 'destination'),
	capacity: t('capacidad', 'capacity'),
	name: t('nombre', 'name'),
	written: t('escritos', 'written'),
	count: t('contar', 'count'),
	times: t('veces', 'times'),
	dayName: t('nombre_del_dia', 'day_name'),
	text: t('texto', 'text'),
	globalRecord: t('registro_global.dato', 'global_record.data'),
	save: t('guardar', 'save'),
	value: t('valor', 'value'),
	block: t('bloque', 'block'),
};

const sq = (n: number) => (isEs ? `${n} al cuadrado es ${n * n}` : `${n} squared is ${n * n}`);
const tw = (i: number) => (isEs ? `doble de ${i}: ${i * 2}` : `twice ${i}: ${i * 2}`);
const turnOut = (n: number) => t(`Turno ${n}`, `Turn ${n}`);

const learn: { kicker: string; title: string; lead: string; code?: CodeKey; buggy?: boolean; steps: Step[] }[] = [
	{
		kicker: t('Objetos y tiempo de vida', 'Objects and lifetime'),
		title: t('Cuatro duraciones, tres zonas para imaginarlas', 'Four durations, three regions to picture them'),
		lead: t(
			'Un objeto es una región de memoria que guarda un valor. Su tiempo de vida es el intervalo de la ejecución en que existe, tiene una dirección fija y conserva su último valor. La duración de almacenamiento decide ese intervalo.',
			'An object is a region of memory that holds a value. Its lifetime is the part of the execution during which it exists, has a fixed address and keeps its last stored value. The storage duration decides that interval.',
		),
		steps: [
			{
				focus: 'stack',
				f: [F('main', [V(id.twice, '0x2004', '2', 'new')])],
				note: t(
					'Duración automática: variables locales y parámetros. Empieza al entrar al bloque y termina en su llave de cierre. En el modelo viven en un marco de la pila.',
					'Automatic duration: local variables and parameters. It starts on entering the block and ends at its closing brace. In the model they live in a stack frame.',
				),
			},
			{
				focus: 'static',
				s: [V(id.totalCalls, '0x1000', '0', 'new'), V(id.turn, '0x1004', '0', 'new')],
				f: [F('main', [V(id.twice, '0x2004', '2')])],
				note: t(
					'Duración estática: globales y locales static. Empieza antes de que empiece main y termina cuando termina el programa. Suelen ir en una zona preparada al cargar el programa.',
					'Static duration: globals and static locals. It starts before main starts and ends when the program ends. They usually go in a region prepared when the program is loaded.',
				),
			},
			{
				focus: 'heap',
				s: [V(id.totalCalls, '0x1000', '0'), V(id.turn, '0x1004', '0')],
				f: [F('main', [V(id.twice, '0x2004', '2')])],
				h: [V(id.block, '0x3000', '…', 'new')],
				note: t(
					'Duración asignada: el programa pide memoria en tiempo de ejecución y decide cuándo devolverla. El modelo la ubica en el montículo. Cómo se pide es el tema de la próxima lección.',
					'Allocated duration: the program requests memory at run time and decides when to give it back. The model places it in the heap. How to request it is the topic of the next lesson.',
				),
			},
			{
				s: [V(id.totalCalls, '0x1000', '0'), V(id.turn, '0x1004', '0')],
				f: [F('main', [V(id.twice, '0x2004', '2')])],
				h: [V(id.block, '0x3000', '…')],
				note: t(
					'Duración de hilo: una variable thread_local tiene una copia por hilo, que vive mientras vive ese hilo. Se estudia en el módulo avanzado de concurrencia.',
					'Thread duration: a thread_local variable has one copy per thread, alive while that thread lives. It is covered in the advanced concurrency module.',
				),
			},
		],
	},
	{
		kicker: t('Duración automática', 'Automatic duration'),
		title: t('Marcos que se apilan y se desapilan', 'Frames pushed and popped'),
		lead: t(
			'Cada llamada a función apila un marco con sus parámetros y variables locales. Al volver, el marco se desapila y esa memoria se reutiliza.',
			'Each function call pushes a frame with its parameters and local variables. On return, the frame is popped and that memory is reused.',
		),
		code: 'auto',
		steps: [
			{ ln: 8, focus: 'stack', f: [F('main', [], 'new')], note: t('Empieza main: se apila su marco. Todavía no hay variables vivas porque no se ejecutó ninguna declaración.', 'main starts: its frame is pushed. There are no live variables yet because no declaration has run.') },
			{ ln: 9, focus: 'stack', f: [F('main', [V('i', '0x2000', '1', 'new')])], note: t('Al entrar al for nace i, con duración automática y valor 1. Vive mientras dure el for.', 'Entering the for creates i, with automatic duration and value 1. It lives as long as the for runs.') },
			{ ln: 10, focus: 'stack', f: [F('main', [V('i', '0x2000', '1'), V(id.twice, '0x2004', '2', 'new')])], note: t('Dentro del cuerpo nace doble, que vale 2.', 'Inside the body twice is created, with value 2.') },
			{ ln: 12, focus: 'stack', f: [F('main', [V('i', '0x2000', '1'), V(id.twice, '0x2004', '2', 'dead')])], out: [tw(1)], note: t('Llave de cierre: termina la vuelta y doble deja de existir.', 'Closing brace: the iteration ends and twice stops existing.') },
			{ ln: 10, focus: 'stack', f: [F('main', [V('i', '0x2000', '2', 'chg'), V(id.twice, '0x2004', '4', 'new')])], out: [tw(1)], note: t('Segunda vuelta: i vale 2 y nace otro doble, que vale 4. Es un objeto nuevo, aunque el modelo reutilice su lugar.', 'Second iteration: i is 2 and another twice is created, with value 4. It is a new object, even if the model reuses its place.') },
			{ ln: 13, focus: 'stack', f: [F('main', [V('i', '0x2000', '4', 'dead')])], out: [tw(1), tw(2), tw(3)], note: t('Terminó el for: también i deja de existir. Ahora main llama a mostrar_cuadrado(4).', 'The for is over: i stops existing too. Now main calls show_square(4).') },
			{ ln: 5, focus: 'stack', f: [F('main', []), F(`${id.showSquare}(4)`, [V('n', '0x2010', '4', 'new'), V(id.square, '0x2014', '16', 'new')], 'new')], out: [tw(1), tw(2), tw(3)], note: t('La llamada apila un marco nuevo con el parámetro n y la variable cuadrado.', 'The call pushes a new frame with the parameter n and the variable square.') },
			{ ln: 6, focus: 'stack', f: [F('main', []), F(`${id.showSquare}(4)`, [V('n', '0x2010', '4', 'dead'), V(id.square, '0x2014', '16', 'dead')], 'dead')], out: [tw(1), tw(2), tw(3), sq(4)], note: t('La función vuelve: su marco se desapila y n y cuadrado dejan de existir.', 'The function returns: its frame is popped and n and square stop existing.') },
			{ ln: 5, focus: 'stack', f: [F('main', []), F(`${id.showSquare}(5)`, [V('n', '0x2010', '5', 'new'), V(id.square, '0x2014', '25', 'new')], 'new')], out: [tw(1), tw(2), tw(3), sq(4)], note: t('Otra llamada, otros objetos. En el modelo ocupan el mismo lugar que los anteriores: la memoria de la pila se reutiliza.', 'Another call, other objects. In the model they take the same place as the previous ones: stack memory is reused.') },
		],
	},
	{
		kicker: t('Duración estática', 'Static duration'),
		title: t('Lo que sobrevive a cada llamada', 'What survives every call'),
		lead: t(
			'Las globales y las locales static existen durante toda la ejecución. Se inicializan una sola vez, antes de main, y si no tienen valor inicial empiezan en cero.',
			'Globals and static locals exist for the whole execution. They are initialized only once, before main, and start at zero when they have no initial value.',
		),
		code: 'static',
		steps: [
			{ ln: 3, focus: 'static', s: [V(id.totalCalls, '0x1000', '0', 'new'), V(id.turn, '0x1004', '0', 'new')], note: t('Antes de que empiece main ya existen las dos variables estáticas, inicializadas una sola vez. turno también, aunque se declare dentro de la función.', 'Before main starts both static variables already exist, initialized only once. turn too, even though it is declared inside the function.') },
			{ ln: 9, focus: 'static', s: [V(id.totalCalls, '0x1000', '1', 'chg'), V(id.turn, '0x1004', '1', 'chg')], f: [F('main', []), F(id.nextTurn, [], 'new')], note: t('La primera llamada apila un marco sin variables automáticas. turno y llamadas_totales no están en el marco: viven en la zona estática y pasan a 1.', 'The first call pushes a frame with no automatic variables. turn and total_calls are not in the frame: they live in the static region and become 1.') },
			{ ln: 9, focus: 'static', s: [V(id.totalCalls, '0x1000', '2', 'chg'), V(id.turn, '0x1004', '2', 'chg')], f: [F('main', []), F(id.nextTurn, [], 'new')], out: [turnOut(1)], note: t('El marco anterior se desapiló, pero turno conservó su valor: la línea 6 no vuelve a inicializarlo. Ahora vale 2.', 'The previous frame was popped, but turn kept its value: line 6 does not initialize it again. Now it is 2.') },
			{ ln: 9, focus: 'static', s: [V(id.totalCalls, '0x1000', '3', 'chg'), V(id.turn, '0x1004', '3', 'chg')], f: [F('main', []), F(id.nextTurn, [], 'new')], out: [turnOut(1), turnOut(2)], note: t('Tercera llamada: otro marco nuevo, pero las mismas dos variables estáticas, que llegan a 3.', 'Third call: another new frame, but the same two static variables, which reach 3.') },
			{ ln: 16, focus: 'static', s: [V(id.totalCalls, '0x1000', '3'), V(id.turn, '0x1004', '3')], f: [F('main', [])], out: [turnOut(1), turnOut(2), turnOut(3)], note: t('Desde main puedes leer llamadas_totales porque es global. turno sigue vivo, pero su alcance es el bloque de siguiente_turno: aquí no puedes escribir su nombre. Alcance y tiempo de vida son ideas distintas.', 'From main you can read total_calls because it is global. turn is still alive, but its scope is the block of next_turn: here you cannot write its name. Scope and lifetime are different ideas.') },
			{ ln: 17, focus: 'static', s: [V(id.totalCalls, '0x1000', '3'), V(id.turn, '0x1004', '3')], f: [F('main', [])], out: [turnOut(1), turnOut(2), turnOut(3), t('Llamadas: 3', 'Calls: 3')], note: t('Las variables estáticas viven hasta que termina el programa.', 'Static variables live until the program ends.') },
		],
	},
	{
		kicker: t('Punteros colgantes', 'Dangling pointers'),
		title: t('Devolver la dirección de una variable local', 'Returning the address of a local variable'),
		lead: t(
			'Este programa tiene un error a propósito: la función devuelve la dirección de un objeto automático, que deja de existir en cuanto la función termina.',
			'This program has a bug on purpose: the function returns the address of an automatic object, which stops existing as soon as the function ends.',
		),
		code: 'dangling',
		buggy: true,
		steps: [
			{ ln: 9, focus: 'stack', f: [F('main', []), F(id.computeDouble, [V('n', '0x2010', '21', 'new')], 'new')], note: t('main llama a calcular_doble(21): se apila un marco con el parámetro n.', 'main calls compute_double(21): a frame with the parameter n is pushed.') },
			{ ln: 4, focus: 'stack', f: [F('main', []), F(id.computeDouble, [V('n', '0x2010', '21'), V(id.result, '0x2014', '42', 'new')])], note: t('Nace resultado, con duración automática, en el marco de la función.', 'result is created, with automatic duration, in the function frame.') },
			{ ln: 5, focus: 'stack', f: [F('main', []), F(id.computeDouble, [V('n', '0x2010', '21'), V(id.result, '0x2014', '42')])], note: t('return &resultado entrega la dirección 0x2014. El problema es lo que pasa justo después.', 'return &result hands back the address 0x2014. The problem is what happens right after.') },
			{ ln: 9, focus: 'stack', f: [F('main', [V('p', '0x2000', '0x2014', 'new', { p: id.result, bad: true })]), F(id.computeDouble, [V('n', '0x2010', '21', 'dead'), V(id.result, '0x2014', '42', 'dead')], 'dead')], note: t('El marco se desapiló y resultado ya no existe, pero p guarda su dirección: p es un puntero colgante.', 'The frame was popped and result no longer exists, but p holds its address: p is a dangling pointer.') },
			{ ln: 10, focus: 'stack', f: [F('main', [V('p', '0x2000', '0x2014', undefined, { p: id.result, bad: true })])], note: t('Leer *p es comportamiento indefinido. Por suerte el compilador suele avisar: gcc con -Wreturn-local-addr, clang con -Wreturn-stack-address. Con -Werror ni siquiera compila.', 'Reading *p is undefined behavior. Luckily the compiler usually warns: gcc with -Wreturn-local-addr, clang with -Wreturn-stack-address. With -Werror it does not even compile.') },
		],
	},
	{
		kicker: t('Punteros colgantes', 'Dangling pointers'),
		title: t('Un puntero que sobrevive a su bloque', 'A pointer that outlives its block'),
		lead: t(
			'El compilador no siempre puede avisarte. Este programa compila sin ninguna advertencia y aun así la segunda lectura de *p es incorrecta.',
			'The compiler cannot always warn you. This program compiles without any warning, and still the second read of *p is wrong.',
		),
		code: 'block',
		buggy: true,
		steps: [
			{ ln: 4, focus: 'stack', f: [F('main', [V('p', '0x2000', 'NULL', 'new')], 'new')], note: t('p nace en el marco de main con el valor NULL.', 'p is created in the frame of main with the value NULL.') },
			{ ln: 6, focus: 'stack', f: [F('main', [V('p', '0x2000', 'NULL'), V(id.temporary, '0x2008', '42', 'new')])], note: t('Al entrar al bloque interno nace temporal, con valor 42.', 'Entering the inner block creates temporary, with value 42.') },
