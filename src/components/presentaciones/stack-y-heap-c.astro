<script>
	type Var = { n: string; a: string; v: string; st?: string; p?: string; bad?: boolean };
	type Frame = { fn: string; v: Var[]; st?: string };
	type State = { s?: Var[]; f?: Frame[]; h?: Var[]; out?: string[]; focus?: string };
	type Step = State & { ln?: number; note: string };
	type Option = { text: string; ok?: boolean; why: string };
	type Deck = {
		learn: Step[][];
		practice: { before: State; after: State; options: Option[]; afterNote: string }[];
		assess: { options: string[]; answer: number; why: string; question: string }[];
		ui: Record<string, string>;
	};

	const root = document.querySelector<HTMLElement>('.sh-screen');
	const deck: Deck = JSON.parse(document.getElementById('shDeckData')?.textContent ?? '{}');
	const ui = deck.ui;

	function el(tag: string, cls?: string, text?: string) {
		const node = document.createElement(tag);
		if (cls) node.className = cls;
		if (text !== undefined) node.textContent = text;
		return node;
	}

	function cell(v: Var) {
		const c = el('div', 'sh-cell');
		if (v.st) c.classList.add(`is-${v.st}`);
		if (v.bad) c.classList.add('is-bad');
		c.append(el('span', 'sh-cell-name', v.n), el('span', 'sh-cell-addr', v.a));
		const value = el('span', 'sh-cell-value', v.p ? `${v.v} → ${v.bad ? '✕ ' : ''}${v.p}` : v.v);
		if (v.bad) value.append(' ', el('span', 'sh-tag', `(${ui.dangling})`));
		if (v.st === 'dead') value.append(' ', el('span', 'sh-tag', `(${ui.dead})`));
		c.append(value);
		return c;
	}

	function region(kind: string, title: string, focus?: string) {
		const r = el('section', `sh-region sh-region-${kind}`);
		if (focus === kind) r.classList.add('is-focus');
		r.setAttribute('aria-label', title);
		r.append(el('span', 'sh-region-title', title));
		return r;
	}

	function renderMemory(target: Element | null, state: State) {
		if (!target) return;
		const statics = region('static', ui.static, state.focus);
		if (state.s?.length) state.s.forEach((v) => statics.append(cell(v)));
		else statics.append(el('span', 'sh-empty', ui.emptyStatic));

		const stack = region('stack', ui.stack, state.focus);
		const list = el('div', 'sh-stack-list');
		if (state.f?.length) {
			state.f.forEach((frame) => {
				const f = el('div', 'sh-frame');
				if (frame.st) f.classList.add(`is-${frame.st}`);
				const head = el('span', 'sh-frame-name', frame.fn);
				if (frame.st === 'dead') head.append(el('span', 'sh-tag', ui.popped));
				f.append(head);
				if (frame.v.length) frame.v.forEach((v) => f.append(cell(v)));
				else f.append(el('span', 'sh-empty', ui.emptyFrame));
				list.append(f);
			});
		} else {
			list.append(el('span', 'sh-empty', ui.emptyStack));
		}
		stack.append(list);

		const heap = region('heap', ui.heap, state.focus);
		if (state.h?.length) state.h.forEach((v) => heap.append(cell(v)));
		else heap.append(el('span', 'sh-empty', ui.emptyHeap));

		target.replaceChildren(statics, stack, heap);
	}

	function renderOutput(slide: Element, out?: string[]) {
		const box = slide.querySelector('[data-out]');
		if (box) box.textContent = out?.length ? out.join('\n') : ui.noOutput;
	}

	// Mode and slide navigation
	const modes = ['learn', 'practice', 'assess'] as const;
	type Mode = (typeof modes)[number];
	let mode: Mode = 'learn';
	const current: Record<Mode, number> = { learn: 1, practice: 1, assess: 1 };
	const prevBtn = document.getElementById('shPrevBtn') as HTMLButtonElement | null;
	const nextBtn = document.getElementById('shNextBtn') as HTMLButtonElement | null;
	const counter = document.getElementById('shSlideCounter');

	function slidesOf(m: Mode) {
		return Array.from(root?.querySelectorAll<HTMLElement>(`.sh-slide[data-mode="${m}"]`) ?? []);
	}

	function show(target: number) {
		const list = slidesOf(mode);
		if (target < 1 || target > list.length) return;
		current[mode] = target;
		root?.querySelectorAll('.sh-slide').forEach((s) => s.classList.remove('is-active'));
		list[target - 1].classList.add('is-active');
		if (counter) counter.textContent = `${target} / ${list.length}`;
		if (prevBtn) prevBtn.disabled = target === 1;
		if (nextBtn) nextBtn.disabled = target === list.length;
		if (list[target - 1].hasAttribute('data-results')) updateProgress();
	}

	root?.querySelectorAll<HTMLInputElement>('input[name="shMode"]').forEach((input) => {
		input.addEventListener('change', () => {
			if (!input.checked) return;
			mode = input.value as Mode;
			show(current[mode]);
		});
	});

	prevBtn?.addEventListener('click', () => show(current[mode] - 1));
	nextBtn?.addEventListener('click', () => show(current[mode] + 1));

	window.addEventListener('keydown', (e) => {
		const tag = (e.target as HTMLElement | null)?.tagName;
		if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;
		if (e.key === 'ArrowRight') show(current[mode] + 1);
		if (e.key === 'ArrowLeft') show(current[mode] - 1);
	});

	// Learn: step through each slide's states
	root?.querySelectorAll<HTMLElement>('[data-learn]').forEach((slide) => {
		const steps = deck.learn[Number(slide.dataset.learn)];
		let index = 0;
		const note = slide.querySelector('[data-note]');
		const count = slide.querySelector('[data-step-count]');
		const prev = slide.querySelector<HTMLButtonElement>('[data-step="prev"]');
		const next = slide.querySelector<HTMLButtonElement>('[data-step="next"]');

		function render() {
			const step = steps[index];
			renderMemory(slide.querySelector('[data-mem]'), step);
			renderOutput(slide, step.out);
			slide.querySelectorAll('.sh-line').forEach((line) => {
				line.classList.toggle('is-current', Number((line as HTMLElement).dataset.ln) === step.ln);
			});
			if (note) note.textContent = step.note;
			if (count) count.textContent = `${ui.step} ${index + 1} ${ui.of} ${steps.length}`;
			if (prev) prev.disabled = index === 0;
			if (next) next.disabled = index === steps.length - 1;
		}

		prev?.addEventListener('click', () => { if (index > 0) { index--; render(); } });
		next?.addEventListener('click', () => { if (index < steps.length - 1) { index++; render(); } });
		slide.querySelector('[data-step="reset"]')?.addEventListener('click', () => { index = 0; render(); });
		render();
	});

	// Practice: pick the next state, get the reason, watch the transition
	root?.querySelectorAll<HTMLElement>('[data-practice]').forEach((slide) => {
		const item = deck.practice[Number(slide.dataset.practice)];
		const mem = slide.querySelector('[data-mem]');
		const feedback = slide.querySelector<HTMLElement>('[data-feedback]');
		const transition = slide.querySelector<HTMLButtonElement>('[data-transition]');
		const retry = slide.querySelector<HTMLButtonElement>('[data-retry]');
		const buttons = Array.from(slide.querySelectorAll<HTMLButtonElement>('[data-option]'));

		function reset() {
			renderMemory(mem, item.before);
			buttons.forEach((b) => { b.disabled = false; b.classList.remove('is-right', 'is-wrong'); });
			if (feedback) { feedback.textContent = ''; feedback.className = 'sh-feedback'; }
			if (transition) transition.hidden = true;
			if (retry) retry.hidden = true;
		}

		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				const option = item.options[Number(button.dataset.option)];
				buttons.forEach((b) => { b.disabled = true; });
				button.classList.add(option.ok ? 'is-right' : 'is-wrong');
				if (feedback) {
					feedback.textContent = option.why;
					feedback.className = `sh-feedback ${option.ok ? 'is-ok' : 'is-bad'}`;
				}
				if (option.ok) { if (transition) transition.hidden = false; }
				else if (retry) retry.hidden = false;
			});
		});

		transition?.addEventListener('click', () => {
			renderMemory(mem, item.after);
			if (feedback) feedback.textContent = item.afterNote;
			transition.hidden = true;
			if (retry) retry.hidden = false;
		});
		retry?.addEventListener('click', reset);
		reset();
	});

	// Assess: answers stay hidden until grading
	const answers: (number | null)[] = deck.assess.map(() => null);
	root?.querySelectorAll<HTMLElement>('[data-assess]').forEach((slide) => {
		const qi = Number(slide.dataset.assess);
		const buttons = Array.from(slide.querySelectorAll<HTMLButtonElement>('[data-choice]'));
		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				answers[qi] = Number(button.dataset.choice);
				buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
			});
		});
	});

	const results = root?.querySelector<HTMLElement>('[data-results]');
	function updateProgress() {
		const progress = results?.querySelector('[data-progress]');
		const done = answers.filter((a) => a !== null).length;
		if (progress) progress.textContent = `${done} / ${answers.length} ${ui.answered}`;
	}

	results?.querySelector('[data-grade]')?.addEventListener('click', () => {
		const review = results.querySelector('[data-review]');
		const score = results.querySelector('[data-score]');
		let right = 0;
		const items = deck.assess.map((q, i) => {
			const ok = answers[i] === q.answer;
			if (ok) right++;
			const li = el('li', ok ? 'is-ok' : 'is-bad');
			li.append(el('strong', undefined, q.question));
			li.append(el('div', undefined, `${ui.yourAnswer}: ${answers[i] === null ? ui.noAnswer : q.options[answers[i] as number]}`));
			li.append(el('div', undefined, `${ui.correctAnswer}: ${q.options[q.answer]}`));
			li.append(el('div', undefined, q.why));
			return li;
		});
		review?.replaceChildren(...items);
		if (score) score.textContent = `${ui.score}: ${right} / ${deck.assess.length}`;
	});

	results?.querySelector('[data-restart]')?.addEventListener('click', () => {
		answers.fill(null);
		root?.querySelectorAll('[data-choice]').forEach((b) => b.setAttribute('aria-pressed', 'false'));
		results.querySelector('[data-review]')?.replaceChildren();
		const score = results.querySelector('[data-score]');
		if (score) score.textContent = '';
		show(1);
	});

	show(1);
</script>
