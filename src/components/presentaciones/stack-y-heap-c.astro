					<path d="m15 18-6-6 6-6" />
				</svg>
				<span>{t('Anterior', 'Previous')}</span>
			</button>
			<div class="seg sh-modes" role="radiogroup" aria-label={t('Modo didáctico', 'Learning mode')}>
				{modes.map((m, i) => (
					<label class="seg-opt">
						<input type="radio" name="shMode" value={m.id} checked={i === 0} />
						<span>{m.label}</span>
					</label>
				))}
			</div>
			<span class="sh-counter" id="shSlideCounter" aria-live="polite">1 / {learn.length}</span>
			<button class="sh-btn" id="shNextBtn" aria-label={t('Siguiente diapositiva', 'Next slide')}>
				<span>{t('Siguiente', 'Next')}</span>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="m9 18 6-6-6-6" />
				</svg>
			</button>
		</nav>

		<main class="sh-viewport">
			<!-- Learn: guided steps over the memory model -->
			{learn.map((slide, i) => (
				<section class:list={['sh-slide', i === 0 && 'is-active']} data-mode="learn" data-slide={i + 1} data-learn={i}>
					<div class="sh-head">
						<span class="sh-kicker">{t('Aprender', 'Learn')} · {slide.kicker}</span>
						<h2 class="sh-title">{slide.title}</h2>
						<p class="sh-lead">{slide.lead}</p>
					</div>
					<div class:list={['sh-lab', !slide.code && 'is-wide']}>
						{slide.code && (
							<div class="sh-code-col">
								{slide.buggy && <span class="sh-flag">{t('Contiene un error a propósito', 'Contains a bug on purpose')}</span>}
								<pre class="sh-code" aria-label={t('Código C', 'C code')}><code>{code(slide.code).map((line, n) => <span class="sh-line" data-ln={n + 1}><span class="sh-ln" aria-hidden="true">{n + 1}</span>{line || ' '}</span>)}</code></pre>
								<div class="sh-out-box">
									<span class="sh-out-label">{t('Salida', 'Output')}</span>
									<pre class="sh-out" data-out></pre>
								</div>
							</div>
						)}
						<div class="sh-mem-col">
							<div class="sh-mem" data-mem></div>
							<p class="sh-addr-note">{t('Direcciones ilustrativas: cambian en cada máquina y en cada ejecución.', 'Illustrative addresses: they change on every machine and every run.')}</p>
						</div>
					</div>
					<div class="sh-stepper">
						<button class="sh-step-btn" data-step="prev" aria-label={t('Paso anterior', 'Previous step')}>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
						</button>
						<button class="sh-step-btn is-primary" data-step="next">
							<span>{t('Siguiente paso', 'Next step')}</span>
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
						</button>
						<button class="sh-step-btn" data-step="reset">
							<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg>
							<span>{t('Reiniciar', 'Restart')}</span>
						</button>
						<span class="sh-step-count" data-step-count></span>
					</div>
					<p class="sh-note" data-note aria-live="polite"></p>
				</section>
			))}

			<!-- Practice: predict the next state -->
			{practice.map((item, i) => (
				<section class="sh-slide" data-mode="practice" data-slide={i + 1} data-practice={i}>
					<div class="sh-head">
						<span class="sh-kicker">{t('Practicar', 'Practice')} · {t('Predice el siguiente estado', 'Predict the next state')} {i + 1}/{practice.length}</span>
						<h2 class="sh-title">{item.question}</h2>
					</div>
					<div class="sh-lab">
						<div class="sh-code-col">
							<pre class="sh-code" aria-label={t('Código C', 'C code')}><code>{code(item.code).map((line, n) => <span class:list={['sh-line', n + 1 === item.mark && 'is-marked']} data-ln={n + 1}><span class="sh-ln" aria-hidden="true">{n + 1}</span>{line || ' '}</span>)}</code></pre>
							<p class="sh-mark-hint">{t(`Línea marcada: ${item.mark}`, `Marked line: ${item.mark}`)}</p>
						</div>
						<div class="sh-mem-col">
							<div class="sh-mem" data-mem></div>
							<p class="sh-addr-note">{t('Estado antes de la línea marcada. Direcciones ilustrativas.', 'State before the marked line. Illustrative addresses.')}</p>
						</div>
					</div>
					<div class="sh-options" role="group" aria-label={t('Opciones', 'Options')}>
						{item.options.map((opt, k) => (
							<button class="sh-option" data-option={k}>{opt.text}</button>
						))}
					</div>
					<p class="sh-feedback" data-feedback aria-live="polite"></p>
					<div class="sh-practice-actions">
						<button class="sh-step-btn is-primary" data-transition hidden>{t('Ver la transición', 'Show the transition')}</button>
						<button class="sh-step-btn" data-retry hidden>{t('Intentar de nuevo', 'Try again')}</button>
					</div>
				</section>
			))}

			<!-- Assess: no hints, graded at the end -->
			{assess.map((q, i) => (
				<section class="sh-slide" data-mode="assess" data-slide={i + 1} data-assess={i}>
					<div class="sh-head">
						<span class="sh-kicker">{t('Evaluar', 'Assess')} · {ui.question} {i + 1}/{assess.length}</span>
						<h2 class="sh-title">{q.question}</h2>
					</div>
					{q.code && (
						<pre class="sh-code sh-code-solo" aria-label={t('Código C', 'C code')}><code>{code(q.code).map((line, n) => <span class="sh-line" data-ln={n + 1}><span class="sh-ln" aria-hidden="true">{n + 1}</span>{line || ' '}</span>)}</code></pre>
					)}
					<div class="sh-options" role="group" aria-label={t('Opciones', 'Options')}>
						{q.options.map((opt, k) => (
							<button class="sh-option" data-choice={k} aria-pressed="false">{opt}</button>
						))}
					</div>
				</section>
			))}
			<section class="sh-slide" data-mode="assess" data-slide={assess.length + 1} data-results>
				<div class="sh-head">
					<span class="sh-kicker">{t('Evaluar', 'Assess')} · {t('Resultado', 'Result')}</span>
					<h2 class="sh-title">{t('Califica tus respuestas', 'Grade your answers')}</h2>
					<p class="sh-lead" data-progress></p>
				</div>
				<div class="sh-practice-actions">
					<button class="sh-step-btn is-primary" data-grade>{t('Calificar', 'Grade')}</button>
					<button class="sh-step-btn" data-restart>{t('Empezar de nuevo', 'Start over')}</button>
				</div>
				<p class="sh-score" data-score aria-live="polite"></p>
				<ol class="sh-review" data-review></ol>
			</section>
		</main>
	</div>
	<script is:inline type="application/json" id="shDeckData" set:html={deckJson} />
</div>

