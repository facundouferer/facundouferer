---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="vt-screen" data-lang={lang}>
	<div class="vt-shell">
		<div class="deck-card">
			<div class="deck-nav-bar">
				<div class="deck-slide-indicator">
					<span class="deck-step-dot"></span>
					<span id="deck-slide-label">SLIDE 1 / 5</span>
				</div>
				<div class="deck-pills">
					<button class="deck-pill-btn active" data-target-slide="1">1. {isEs ? '8 Primitivos' : '8 Primitives'}</button>
					<button class="deck-pill-btn" data-target-slide="2">2. {isEs ? 'Casting y Truncado' : 'Casting & Truncation'}</button>
					<button class="deck-pill-btn" data-target-slide="3">3. {isEs ? 'División Entera y %' : 'Integer Division & %'}</button>
					<button class="deck-pill-btn" data-target-slide="4">4. {isEs ? 'Cortocircuito Lógico' : 'Short-Circuit Logic'}</button>
					<button class="deck-pill-btn" data-target-slide="5">5. {isEs ? 'Constantes con final' : 'Constants with final'}</button>
				</div>
			</div>

			<div class="vt-viewport">
				<!-- SLIDE 1: 8 PRIMITIVES -->
				<div class="deck-slide active" data-slide="1">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">1. {isEs ? 'Los 8 Tipos Primitivos en Memoria' : 'The 8 Primitive Types in Memory'}</h2>
							<p class="deck-text">
								{isEs
									? 'Java no guarda objetos para todo. Los primitivos son valores matemáticos directos almacenados en la pila de ejecución, sin sobrecarga de punteros. Se dividen en enteros, punto flotante, carácter y booleano.'
									: 'Java does not use objects for everything. Primitives are raw mathematical values held directly on the execution stack without pointer overhead. They divide into integers, floating point, character, and boolean.'}
							</p>

							<div class="deck-figure">
								<svg viewBox="0 0 560 260" width="100%" role="img" aria-label={isEs ? 'Los 8 tipos de datos primitivos en Java y sus tamaños en bits' : 'The 8 Java primitive types and their bit sizes'}>
									<!-- Integers Category -->
									<rect x="10" y="20" width="260" height="225" rx="14" class="deck-panel" />
									<text x="25" y="44" class="deck-svg-title">{isEs ? 'Enteros (con signo)' : 'Signed Integers'}</text>

									<!-- byte -->
									<rect x="25" y="60" width="115" height="38" rx="8" class="deck-sub-block prim-item active" data-prim="byte" />
									<text x="35" y="82" class="deck-svg-bold">byte</text>
									<text x="125" y="82" class="deck-svg-chip" text-anchor="end">8 bits</text>

									<!-- short -->
									<rect x="145" y="60" width="115" height="38" rx="8" class="deck-sub-block prim-item" data-prim="short" />
									<text x="155" y="82" class="deck-svg-bold">short</text>
									<text x="245" y="82" class="deck-svg-chip" text-anchor="end">16 bits</text>

									<!-- int -->
									<rect x="25" y="105" width="235" height="42" rx="8" class="deck-sub-block-accent prim-item" data-prim="int" />
									<text x="35" y="130" class="deck-svg-title-accent">int (estándar)</text>
									<text x="245" y="130" class="deck-svg-chip-accent" text-anchor="end">32 bits</text>

									<!-- long -->
									<rect x="25" y="155" width="235" height="42" rx="8" class="deck-sub-block prim-item" data-prim="long" />
									<text x="35" y="180" class="deck-svg-bold">long (sufijo L)</text>
									<text x="245" y="180" class="deck-svg-chip" text-anchor="end">64 bits</text>

									<text x="25" y="225" class="deck-svg-sub">{isEs ? 'Complemento a dos · Números exactos' : 'Two\'s complement · Exact numbers'}</text>

									<!-- Floats, Char, Boolean -->
									<rect x="290" y="20" width="260" height="225" rx="14" class="deck-panel-subtle" />
									<text x="305" y="44" class="deck-svg-title">{isEs ? 'Flotantes, Char y Boolean' : 'Floating, Char, Boolean'}</text>

									<!-- float -->
									<rect x="305" y="60" width="115" height="38" rx="8" class="deck-sub-block prim-item" data-prim="float" />
									<text x="315" y="82" class="deck-svg-bold">float (F)</text>
									<text x="405" y="82" class="deck-svg-chip" text-anchor="end">32 bits</text>

									<!-- double -->
									<rect x="425" y="60" width="115" height="38" rx="8" class="deck-sub-block prim-item" data-prim="double" />
									<text x="435" y="82" class="deck-svg-bold">double</text>
									<text x="525" y="82" class="deck-svg-chip" text-anchor="end">64 bits</text>

									<!-- char -->
									<rect x="305" y="105" width="235" height="42" rx="8" class="deck-sub-block prim-item" data-prim="char" />
									<text x="315" y="130" class="deck-svg-bold">char (UTF-16 sin signo)</text>
									<text x="525" y="130" class="deck-svg-chip" text-anchor="end">16 bits</text>

									<!-- boolean -->
									<rect x="305" y="155" width="235" height="42" rx="8" class="deck-sub-block prim-item" data-prim="boolean" />
									<text x="315" y="180" class="deck-svg-bold">boolean (true / false)</text>
									<text x="525" y="180" class="deck-svg-chip" text-anchor="end">1 bit (JVM flag)</text>

									<text x="305" y="225" class="deck-svg-sub">IEEE 754 &amp; Unicode estándar</text>
								</svg>
							</div>
						</div>

						<div class="deck-col">
							<div class="deck-interactive-card">
								<div class="deck-card-head">
									<span class="deck-badge" id="prim-badge">byte (8 bits)</span>
									<span class="deck-subtext">{isEs ? 'Ficha técnica en memoria' : 'Memory specification'}</span>
								</div>
								<div class="deck-info-box">
									<div class="state-row">
										<span class="state-label">{isEs ? 'Rango admisible:' : 'Allowed Range:'}</span>
										<span class="state-val" id="prim-range">-128 hasta 127</span>
									</div>
									<div class="state-row">
										<span class="state-label">{isEs ? 'Valor por defecto en clase:' : 'Default value:'}</span>
										<span class="state-val" id="prim-default">0</span>
									</div>
									<div class="state-row">
										<span class="state-label">{isEs ? 'Ejemplo de declaración:' : 'Sample code:'}</span>
										<span class="state-val" id="prim-code">byte edad = 25;</span>
									</div>
									<p class="deck-caption" id="prim-desc">
										{isEs
											? 'Ideal para buffers de red o streaming de archivos donde el consumo de RAM debe ser mínimo.'
											: 'Ideal for raw network I/O buffers or audio streaming where memory conservation is paramount.'}
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 2: CASTING & TRUNCATION -->
				<div class="deck-slide" data-slide="2">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">2. {isEs ? 'Casting de Tipos: Ensanchamiento vs Truncado' : 'Type Casting: Widening vs Narrowing'}</h2>
							<p class="deck-text">
								{isEs
									? 'Cuando un tipo pequeño se asigna a uno más grande (Widening), la conversión es automática y segura. Pero al forzar un tipo mayor en uno menor (Narrowing), Java descarta los bits superiores sin avisar, produciendo desbordamientos.'
									: 'When assigning a small type into a larger one (Widening), Java converts it automatically. But forcing a larger value into a smaller bucket (Narrowing) silently chops off higher bits, causing integer overflow.'}
							</p>

							<div class="deck-figure">
								<svg viewBox="0 0 540 240" width="100%" role="img" aria-label={isEs ? 'Ilustración del truncamiento de 32 bits a 8 bits y desbordamiento' : '32-bit to 8-bit narrowing and truncation illustration'}>
									<!-- 32-bit int -->
									<rect x="20" y="30" width="500" height="60" rx="10" class="deck-panel" />
									<text x="35" y="55" class="deck-svg-title">int original = 130; (32 bits en memoria)</text>
									<text x="35" y="75" class="deck-svg-mono" font-size="12">00000000 00000000 00000000 <tspan fill="var(--color-accent-700)" font-weight="700">10000010</tspan></text>

									<!-- Scissors / Chopper -->
									<path d="M375 90 L375 140" stroke="var(--color-accent)" stroke-width="2" stroke-dasharray="4 4" />
									<text x="250" y="118" class="deck-svg-badge-accent">← {isEs ? 'Bits descartados por narrowing' : 'Discarded higher 24 bits'}</text>

									<!-- 8-bit byte result -->
									<rect x="350" y="140" width="170" height="70" rx="10" class="deck-panel-accent" />
									<text x="365" y="165" class="deck-svg-title-accent">byte res = (byte) 130;</text>
									<text x="365" y="185" class="deck-svg-mono" font-size="13">10000010</text>
									<text x="365" y="202" class="deck-svg-bold" fill="var(--color-accent-700)">{isEs ? 'Resultado = -126 !' : 'Result = -126 !'}</text>
								</svg>
							</div>
						</div>

						<div class="deck-col">
							<div class="deck-interactive-card">
								<div class="deck-card-head">
									<span class="deck-badge">{isEs ? 'Simulador de Overflow (Casting a byte)' : 'Overflow Simulator (Casting to byte)'}</span>
								</div>
								<div class="deck-cli-box">
									<label for="cast-input" class="state-label">{isEs ? 'Ingresá un valor entero:' : 'Enter integer value:'}</label>
									<input type="number" id="cast-input" class="input" value="130" />
									<button class="btn btn-primary btn-sm" id="btn-cast">{isEs ? 'Evaluar (byte) n' : 'Evaluate (byte) n'}</button>
								</div>
								<div class="deck-info-box">
									<div class="state-row">
										<span class="state-label">Valor int:</span>
										<span class="state-val" id="cast-int-val">130</span>
									</div>
									<div class="state-row">
										<span class="state-label">Valor byte resultante:</span>
										<span class="state-val" id="cast-byte-val" style="color: var(--color-accent); font-size: 1.1rem;">-126</span>
									</div>
									<div class="state-row">
										<span class="state-label">Bits conservados (8):</span>
										<span class="state-val" id="cast-bits">10000010</span>
									</div>
									<p class="deck-caption" id="cast-expl">
										{isEs
											? 'El bit más significativo es 1, indicando un número negativo en complemento a dos (-128 + 2 = -126).'
											: 'The MSB is 1, encoding a negative two\'s complement integer (-128 + 2 = -126).'}
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 3: DIVISION & MODULO -->
				<div class="deck-slide" data-slide="3">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">3. {isEs ? 'La Trampa de la División Entera y el Módulo (%)' : 'The Integer Division Trap and Modulo (%)'}</h2>
							<p class="deck-text">
								{isEs
									? 'En Java, operar entre enteros siempre da un entero. Si hacés 5 / 2, el resultado es 2, no 2.5: la parte decimal se desecha. El operador módulo (%) rescata el residuo de la división.'
									: 'Operating between integers always results in an integer. 5 / 2 produces 2, not 2.5: the fraction is truncated. The modulo operator (%) captures the integer remainder.'}
							</p>

							<div class="deck-figure">
								<svg viewBox="0 0 540 240" width="100%" role="img" aria-label={isEs ? 'Comparación de división entera frente a división decimal' : 'Integer division vs floating-point division comparison'}>
									<!-- Integer division -->
									<rect x="20" y="30" width="235" height="180" rx="14" class="deck-panel" />
									<text x="35" y="60" class="deck-svg-title">5 / 2 (Entero / Entero)</text>
									<text x="35" y="100" class="deck-svg-mono" font-size="28" font-weight="700">2</text>
									<text x="35" y="130" class="deck-svg-sub">{isEs ? 'Se trunca la fracción .5' : 'Fractional .5 is dropped'}</text>
									
									<rect x="35" y="150" width="200" height="40" rx="8" class="deck-sub-block" />
									<text x="45" y="175" class="deck-svg-mono">5 % 2 = <tspan fill="var(--color-accent-700)" font-weight="700">1</tspan> (resto)</text>

									<!-- Float division -->
									<rect x="285" y="30" width="235" height="180" rx="14" class="deck-panel-accent" />
									<text x="300" y="60" class="deck-svg-title-accent">5.0 / 2 (Double / Entero)</text>
									<text x="300" y="100" class="deck-svg-mono" font-size="28" font-weight="700" fill="var(--color-accent-700)">2.5</text>
									<text x="300" y="130" class="deck-svg-sub">{isEs ? 'El entero 2 se ensancha a 2.0' : 'Integer 2 is widened to 2.0'}</text>

									<rect x="300" y="150" width="200" height="40" rx="8" class="deck-sub-block-accent" />
									<text x="310" y="175" class="deck-svg-mono">double prom = (double) 5 / 2;</text>
								</svg>
							</div>
						</div>

						<div class="deck-col">
							<div class="deck-interactive-card">
								<div class="deck-card-head">
									<span class="deck-badge">{isEs ? 'Laboratorio de Operaciones' : 'Operation Tester'}</span>
								</div>
								<div class="deck-actions-row">
									<button class="btn btn-secondary op-btn active" data-op="int-div">5 / 2</button>
									<button class="btn btn-secondary op-btn" data-op="double-div">5.0 / 2</button>
									<button class="btn btn-secondary op-btn" data-op="mod">5 % 2</button>
								</div>
								<div class="deck-info-box">
									<div class="state-row">
										<span class="state-label">{isEs ? 'Expresión Java:' : 'Java Expression:'}</span>
										<span class="state-val" id="op-expr">int resultado = 5 / 2;</span>
									</div>
									<div class="state-row">
										<span class="state-label">{isEs ? 'Tipo inferido:' : 'Inferred Type:'}</span>
										<span class="state-val" id="op-type">int</span>
									</div>
									<div class="state-row">
										<span class="state-label">{isEs ? 'Valor en memoria:' : 'Stored Value:'}</span>
										<span class="state-val" id="op-val" style="color: var(--color-accent); font-size: 1.2rem;">2</span>
									</div>
									<p class="deck-caption" id="op-desc">
										{isEs
											? '¡Cuidado con promedios! Si sumás 3 enteros y dividís por 3, perderás los decimales salvo que dividas por 3.0.'
											: 'Beware of averages! Summing 3 integers and dividing by 3 loses precision unless dividing by 3.0.'}
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 4: SHORT-CIRCUIT LOGIC -->
				<div class="deck-slide" data-slide="4">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">4. {isEs ? 'Evaluación de Cortocircuito (&& y ||)' : 'Short-Circuit Evaluation (&& and ||)'}</h2>
							<p class="deck-text">
								{isEs
									? 'Los operadores && y || no evalúan el segundo operando si el primero ya determina el resultado global. Esto previene catástrofes como NullPointerException o divisiones por cero.'
									: 'The && and || operators never evaluate their right operand if the left operand already decides the outcome. This shields against NullPointerException and zero division.'}
							</p>

							<div class="deck-figure">
								<svg viewBox="0 0 540 240" width="100%" role="img" aria-label={isEs ? 'Circuito eléctrico que demuestra la evaluación de cortocircuito en &&' : 'Electrical circuit demonstrating short-circuit evaluation in &&'}>
									<!-- Switch 1 -->
									<rect x="20" y="50" width="140" height="120" rx="12" class="deck-panel switch-box" id="sw1-box" />
									<text x="90" y="80" class="deck-svg-title" text-anchor="middle">user != null</text>
									<circle cx="90" cy="115" r="14" fill="rgb(255, 95, 86)" id="sw1-light" />
									<text x="90" y="150" class="deck-svg-bold" text-anchor="middle" id="sw1-status">FALSE (Abierto)</text>

									<!-- Connector wire -->
									<path d="M160 115 H220" stroke="var(--color-divider)" stroke-width="4" id="wire-mid" />

									<!-- Switch 2 (Protected) -->
									<rect x="220" y="50" width="170" height="120" rx="12" class="deck-panel switch-box" id="sw2-box" opacity="0.4" />
									<text x="305" y="80" class="deck-svg-title" text-anchor="middle">user.getEdad() >= 18</text>
									<text x="305" y="115" class="deck-svg-chip" text-anchor="middle" id="sw2-status">{isEs ? '[NO EVALUADO]' : '[SKIPPED]'}</text>
									<text x="305" y="150" class="deck-svg-sub" text-anchor="middle">{isEs ? '¡Protegido de NPE!' : 'Saved from NPE!'}</text>

									<!-- Bulb -->
									<circle cx="470" cy="115" r="26" fill="var(--color-neutral-200)" stroke="var(--color-divider)" stroke-width="2" id="bulb" />
									<text x="470" y="120" class="deck-svg-bold" text-anchor="middle" id="bulb-txt">OFF</text>
									<text x="470" y="165" class="deck-svg-tag" text-anchor="middle">{isEs ? 'Resultado: false' : 'Result: false'}</text>
								</svg>
							</div>
						</div>

						<div class="deck-col">
							<div class="deck-interactive-card">
								<div class="deck-card-head">
									<span class="deck-badge">{isEs ? 'Simulador de Circuito' : 'Circuit Switcher'}</span>
								</div>
								<div class="deck-actions-row">
									<button class="btn btn-secondary sc-btn active" data-scenario="null">{isEs ? 'user = null' : 'user = null'}</button>
									<button class="btn btn-secondary sc-btn" data-scenario="young">{isEs ? 'user.edad = 16' : 'user.age = 16'}</button>
									<button class="btn btn-secondary sc-btn" data-scenario="adult">{isEs ? 'user.edad = 24' : 'user.age = 24'}</button>
								</div>
								<div class="deck-info-box">
									<div class="state-row">
										<span class="state-label">{isEs ? 'Condición:' : 'Condition:'}</span>
										<span class="state-val">user != null &amp;&amp; user.getEdad() >= 18</span>
									</div>
									<div class="state-row">
										<span class="state-label">{isEs ? 'Paso 1 (user != null):' : 'Step 1 (user != null):'}</span>
										<span class="state-val" id="sc-step1">false</span>
									</div>
									<div class="state-row">
										<span class="state-label">{isEs ? 'Paso 2 (getEdad()):' : 'Step 2 (getEdad()):'}</span>
										<span class="state-val" id="sc-step2" style="color: var(--color-accent-700);">{isEs ? 'OMITIDO (Cortocircuito)' : 'SKIPPED (Short-circuit)'}</span>
									</div>
									<p class="deck-caption" id="sc-desc">
										{isEs
											? 'Al ser el primer operando falso en un &&, Java no evalúa la derecha. Si usaras el operador simple &, Java evaluaría la derecha y lanzaría NullPointerException.'
											: 'Because the left operand is false in &&, Java stops immediately. Using single & forces evaluation of the right operand, triggering NullPointerException.'}
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 5: CONSTANTS WITH FINAL -->
				<div class="deck-slide" data-slide="5">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">5. {isEs ? 'Inmutabilidad y Constantes con final' : 'Immutability and Constants with final'}</h2>
							<p class="deck-text">
								{isEs
									? 'La palabra clave final impide que una variable sea reasignada una vez inicializada. Para verdaderas constantes universales, se combina con static y se nombra en UPPER_SNAKE_CASE.'
									: 'The final keyword locks a variable against reassignment once initialized. For universal constants, combine it with static and use UPPER_SNAKE_CASE naming.'}
							</p>

							<div class="deck-figure">
								<svg viewBox="0 0 540 240" width="100%" role="img" aria-label={isEs ? 'Bloque de memoria protegido con candado final contra reasignación' : 'final locked memory cell preventing reassignment'}>
									<!-- Memory Cell with Lock -->
									<rect x="40" y="40" width="220" height="160" rx="16" class="deck-panel-accent" />
									<text x="150" y="75" class="deck-svg-title-accent" text-anchor="middle">final double PI = 3.14159;</text>
									
									<!-- Padlock Icon -->
									<circle cx="150" cy="115" r="16" fill="var(--color-accent-700)" />
									<rect x="135" y="125" width="30" height="26" rx="4" fill="var(--color-accent)" />
									<circle cx="150" cy="138" r="3" fill="rgb(255, 255, 255)" />
									<text x="150" y="180" class="deck-svg-bold" text-anchor="middle" fill="var(--color-accent-700)">{isEs ? 'VALOR INMUTABLE' : 'IMMUTABLE VALUE'}</text>

									<!-- Attempted Assignment Rebound -->
									<path d="M480 120 L300 120" stroke="rgb(255, 95, 86)" stroke-width="3" stroke-dasharray="6 6" />
									<polygon points="300,114 290,120 300,126" fill="rgb(255, 95, 86)" />
									<rect x="320" y="60" width="180" height="40" rx="8" class="deck-panel" />
									<text x="410" y="85" class="deck-svg-mono" text-anchor="middle" fill="rgb(255, 95, 86)">PI = 3.14;</text>
									
									<rect x="310" y="145" width="200" height="50" rx="8" class="deck-ground-card" stroke="rgb(255, 95, 86)" />
									<text x="410" y="165" class="deck-svg-sub" text-anchor="middle" fill="rgb(255, 95, 86)">javac Error:</text>
									<text x="410" y="182" class="deck-svg-mono-sm" text-anchor="middle">cannot assign a value to final</text>
								</svg>
							</div>
						</div>

						<div class="deck-col">
							<div class="deck-summary-card">
								<h3 class="deck-summary-title">{isEs ? 'Buenas Prácticas de Tipos en Java' : 'Java Type Best Practices'}</h3>
								<ul class="deck-checklist">
									<li>
										<strong>Elegir int por defecto:</strong> {isEs ? 'Para números enteros, int es el tipo nativo óptimo en CPU; usar long solo para IDs o marcas de tiempo gigantes.' : 'int is optimal for CPU registers; use long only for large IDs or timestamps.'}
									</li>
									<li>
										<strong>Cuidado con Narrowing:</strong> {isEs ? 'Hacer cast manual descarta bits superiores silenciosamente en complemento a dos.' : 'Narrowing casts silently chop off MSB bits causing unexpected negative numbers.'}
									</li>
									<li>
										<strong>Divisiones exactas:</strong> {isEs ? 'Si querés decimales, asegurá que al menos un operando tenga .0 o cast a double.' : 'To keep decimals, ensure at least one operand is cast to double or has .0.'}
									</li>
									<li>
										<strong>Siempre && y ||:</strong> {isEs ? 'Usar operadores de cortocircuito para proteger llamadas sobre variables que podrían ser null.' : 'Always use short-circuit && and || to avoid NullPointerException.'}
									</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Navigation Bar Footer -->
			<div class="deck-footer-bar">
				<button class="btn btn-secondary" id="deck-prev-btn" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="deck-keys-hint">
					<span class="key-cap">←</span> <span class="key-cap">→</span> {isEs ? 'para navegar' : 'to navigate'}
				</div>
				<button class="btn btn-primary" id="deck-next-btn">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<script>
	let currentSlide = 1;
	const totalSlides = 5;

	const slideLabel = document.getElementById('deck-slide-label');
	const prevBtn = document.getElementById('deck-prev-btn') as HTMLButtonElement | null;
	const nextBtn = document.getElementById('deck-next-btn') as HTMLButtonElement | null;
	const pillBtns = document.querySelectorAll<HTMLButtonElement>('.deck-pill-btn');
	const slides = document.querySelectorAll<HTMLElement>('.deck-slide');

	function goToSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;

		slides.forEach((slide) => {
			const slideIdx = parseInt(slide.getAttribute('data-slide') || '0', 10);
			slide.classList.toggle('active', slideIdx === currentSlide);
		});

		pillBtns.forEach((btn) => {
			const targetIdx = parseInt(btn.getAttribute('data-target-slide') || '0', 10);
			btn.classList.toggle('active', targetIdx === currentSlide);
		});

		if (slideLabel) {
			slideLabel.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		}

		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	pillBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			const target = parseInt(btn.getAttribute('data-target-slide') || '1', 10);
			goToSlide(target);
		});
	});

	prevBtn?.addEventListener('click', () => goToSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => goToSlide(currentSlide + 1));

	window.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	/* Slide 1: Primitives details */
	const primData: Record<string, { badge: string; range: string; def: string; code: string; desc: string }> = {
		byte: {
			badge: 'byte (8 bits)',
			range: '-128 a 127',
			def: '0',
			code: 'byte edad = 25;',
			desc: 'Ideal para buffers de red o streaming de archivos donde el consumo de RAM debe ser mínimo.',
		},
		short: {
			badge: 'short (16 bits)',
			range: '-32.768 a 32.767',
			def: '0',
			code: 'short temperatura = -140;',
			desc: 'Raramente usado hoy en día; sobrevive por compatibilidad y arreglos numéricos compactos.',
		},
		int: {
			badge: 'int (32 bits)',
			range: '-2.147.483.648 a 2.147.483.647',
			def: '0',
			code: 'int contador = 1000;',
			desc: 'El tipo entero por defecto en Java. Es el más eficiente en la arquitectura del procesador.',
		},
		long: {
			badge: 'long (64 bits)',
			range: '-9.223.372.036.854.775.808 a 9.223.372.036.854.775.807',
			def: '0L',
			code: 'long distancia = 15000000000L;',
			desc: 'Requiere sufijo L. Imprescindible para IDs en bases de datos y marcas de tiempo (timestamps).',
		},
		float: {
			badge: 'float (32 bits)',
			range: '±1.4E-45 a ±3.4E+38 (7 dígitos precisión)',
			def: '0.0f',
			code: 'float tasa = 0.05F;',
			desc: 'Requiere sufijo F. Precisión simple IEEE 754, útil en gráficos 3D donde la memoria importa más que la precisión extrema.',
		},
		double: {
			badge: 'double (64 bits)',
			range: '±4.9E-324 a ±1.7E+308 (15 dígitos precisión)',
			def: '0.0d',
			code: 'double precio = 99.99;',
			desc: 'El tipo flotante por defecto en Java. Ideal para cálculos científicos y medidas.',
		},
		char: {
			badge: 'char (16 bits sin signo)',
			range: '0 a 65.535 (\'\\u0000\' a \'\\uffff\')',
			def: '\'\\u0000\'',
			code: 'char letra = \'A\';',
			desc: 'Modela un carácter Unicode UTF-16 con comillas simples. Es compatible numéricamente con int.',
		},
		boolean: {
			badge: 'boolean (1 bit conceptual)',
			range: 'true o false',
			def: 'false',
			code: 'boolean activo = true;',
			desc: 'Controla bifurcaciones y bucles. No se puede convertir a int como en C o C++.',
		},
	};

	document.querySelectorAll<SVGElement>('.prim-item').forEach((el) => {
		el.addEventListener('click', () => {
			document.querySelectorAll('.prim-item').forEach((b) => b.classList.remove('active'));
			el.classList.add('active');
			const key = el.getAttribute('data-prim') || 'byte';
			const item = primData[key];
			if (item) {
				const bEl = document.getElementById('prim-badge');
				const rEl = document.getElementById('prim-range');
				const dEl = document.getElementById('prim-default');
				const cEl = document.getElementById('prim-code');
				const descEl = document.getElementById('prim-desc');
				if (bEl) bEl.textContent = item.badge;
				if (rEl) rEl.textContent = item.range;
				if (dEl) dEl.textContent = item.def;
				if (cEl) cEl.textContent = item.code;
				if (descEl) descEl.textContent = item.desc;
			}
		});
	});

	/* Slide 2: Casting simulator */
	const castInput = document.getElementById('cast-input') as HTMLInputElement | null;
	const btnCast = document.getElementById('btn-cast');
	const castIntVal = document.getElementById('cast-int-val');
	const castByteVal = document.getElementById('cast-byte-val');
	const castBits = document.getElementById('cast-bits');
	const castExpl = document.getElementById('cast-expl');

	btnCast?.addEventListener('click', () => {
		if (!castInput) return;
		const n = parseInt(castInput.value, 10) || 0;
		const byteVal = (n << 24) >> 24; // Emulate 8-bit signed integer in JavaScript
		const byteBits = (n & 0xff).toString(2).padStart(8, '0');

		if (castIntVal) castIntVal.textContent = String(n);
		if (castByteVal) castByteVal.textContent = String(byteVal);
		if (castBits) castBits.textContent = byteBits;
		if (castExpl) {
			if (byteBits[0] === '1') {
				castExpl.textContent = `El bit de signo es 1: en complemento a dos representa el valor negativo ${byteVal}.`;
			} else {
				castExpl.textContent = `El bit de signo es 0: se mantiene positivo en ${byteVal}.`;
			}
		}
	});

	/* Slide 3: Operations */
	const opData: Record<string, { expr: string; type: string; val: string; desc: string }> = {
		'int-div': {
			expr: 'int resultado = 5 / 2;',
			type: 'int',
			val: '2',
			desc: 'Ambos operandos son enteros: la división trunca el decimal .5 y entrega 2 exacto.',
		},
		'double-div': {
			expr: 'double resultado = 5.0 / 2;',
			type: 'double',
			val: '2.5',
			desc: 'Al haber un operando double (5.0), Java promociona el 2 a 2.0 y entrega el resultado exacto 2.5.',
		},
		mod: {
			expr: 'int residuo = 5 % 2;',
			type: 'int',
			val: '1',
			desc: '5 dividido por 2 es 2 con residuo 1. El operador módulo rescata la fracción entera sobrante.',
		},
	};

	document.querySelectorAll<HTMLButtonElement>('.op-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.op-btn').forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
			const op = btn.getAttribute('data-op') || 'int-div';
			const item = opData[op];
			if (item) {
				const eEl = document.getElementById('op-expr');
				const tEl = document.getElementById('op-type');
				const vEl = document.getElementById('op-val');
				const dEl = document.getElementById('op-desc');
				if (eEl) eEl.textContent = item.expr;
				if (tEl) tEl.textContent = item.type;
				if (vEl) vEl.textContent = item.val;
				if (dEl) dEl.textContent = item.desc;
			}
		});
	});

	/* Slide 4: Short-circuit scenarios */
	const scBtns = document.querySelectorAll<HTMLButtonElement>('.sc-btn');
	const sw1Light = document.getElementById('sw1-light');
	const sw1Status = document.getElementById('sw1-status');
	const sw2Box = document.getElementById('sw2-box');
	const sw2Status = document.getElementById('sw2-status');
	const bulb = document.getElementById('bulb');
	const bulbTxt = document.getElementById('bulb-txt');
	const scStep1 = document.getElementById('sc-step1');
	const scStep2 = document.getElementById('sc-step2');
	const scDesc = document.getElementById('sc-desc');

	scBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			scBtns.forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
			const sc = btn.getAttribute('data-scenario');

			if (sc === 'null') {
				if (sw1Light) sw1Light.setAttribute('fill', 'rgb(255, 95, 86)');
				if (sw1Status) sw1Status.textContent = 'FALSE (Abierto)';
				if (sw2Box) sw2Box.setAttribute('opacity', '0.35');
				if (sw2Status) sw2Status.textContent = '[NO EVALUADO]';
				if (bulb) {
					bulb.setAttribute('fill', 'var(--color-neutral-200)');
					bulb.setAttribute('stroke', 'var(--color-divider)');
				}
				if (bulbTxt) bulbTxt.textContent = 'OFF';
				if (scStep1) scStep1.textContent = 'false';
				if (scStep2) scStep2.textContent = 'OMITIDO (Cortocircuito)';
				if (scDesc) scDesc.textContent = 'El primer operando es false en &&: el segundo operando jamás se evalúa, protegiendo al sistema de NullPointerException.';
			} else if (sc === 'young') {
				if (sw1Light) sw1Light.setAttribute('fill', 'rgb(39, 201, 63)');
				if (sw1Status) sw1Status.textContent = 'TRUE (Cerrado)';
				if (sw2Box) sw2Box.setAttribute('opacity', '1');
				if (sw2Status) sw2Status.textContent = '16 >= 18 → FALSE';
				if (bulb) {
					bulb.setAttribute('fill', 'var(--color-neutral-200)');
					bulb.setAttribute('stroke', 'var(--color-divider)');
				}
				if (bulbTxt) bulbTxt.textContent = 'OFF';
				if (scStep1) scStep1.textContent = 'true (objeto existe)';
				if (scStep2) scStep2.textContent = 'false (16 es menor que 18)';
				if (scDesc) scDesc.textContent = 'El primer operando fue true, así que Java avanzó al segundo operando de forma segura.';
			} else if (sc === 'adult') {
				if (sw1Light) sw1Light.setAttribute('fill', 'rgb(39, 201, 63)');
				if (sw1Status) sw1Status.textContent = 'TRUE (Cerrado)';
				if (sw2Box) sw2Box.setAttribute('opacity', '1');
				if (sw2Status) sw2Status.textContent = '24 >= 18 → TRUE';
				if (bulb) {
					bulb.setAttribute('fill', 'rgb(255, 189, 46)');
					bulb.setAttribute('stroke', 'rgb(198, 113, 57)');
				}
				if (bulbTxt) bulbTxt.textContent = 'ON';
				if (scStep1) scStep1.textContent = 'true';
				if (scStep2) scStep2.textContent = 'true';
				if (scDesc) scDesc.textContent = 'Ambos interruptores se cerraron: la condición global del if es true y la bombilla enciende.';
			}
		});
	});
</script>

<style>
