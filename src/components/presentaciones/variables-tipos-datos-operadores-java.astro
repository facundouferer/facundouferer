		min-height: calc(100dvh - var(--site-header-height, 0px));
		padding: var(--space-4) var(--space-6);
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-body);
		display: flex;
		flex-direction: column;
	}

	.vt-shell { width: 100%; max-width: none; margin: 0; flex: 1; display: flex; flex-direction: column; }

	.deck-card {
		background: var(--color-surface);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-md);
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	/* Nav bar */
	.deck-nav-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--space-3) var(--space-6);
		border-bottom: 1px solid var(--color-divider);
		background: color-mix(in srgb, var(--color-surface) 90%, var(--color-bg));
		gap: var(--space-4);
		flex-wrap: wrap;
	}

	.deck-slide-indicator {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--color-accent-700);
		letter-spacing: 0.05em;
	}

	.deck-step-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-accent);
	}

	.deck-pills {
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.deck-pill-btn {
		background: transparent;
		border: 1px solid transparent;
		padding: var(--space-1) var(--space-3);
