	}

	.deck-text {
		font-size: 0.95rem;
		line-height: 1.6;
		color: color-mix(in srgb, var(--color-text) 85%, transparent);
		margin-bottom: var(--space-4);
	}

	/* SVG styles */
	.deck-figure {
		background: var(--color-neutral-100);
		border: 1px solid var(--color-divider);
