		color: color-mix(in srgb, var(--color-text) 60%, transparent);
	}

	.deck-actions-row {
		display: flex;
		gap: var(--space-2);
		margin-bottom: var(--space-3);
		flex-wrap: wrap;
	}

	.deck-actions-row .btn.active {
		background: var(--color-accent);
