	}

	.deck-pill-btn.active {
		background: var(--color-accent-200);
		border-color: var(--color-accent);
		color: var(--color-accent-700);
		font-weight: 600;
	}

	/* Viewport & slides */
	.vt-viewport {
		padding: var(--space-6) var(--space-8);
		min-height: 480px;
	}

	.vt-viewport { display: flex; flex-direction: column; justify-content: center; }
	@media (min-width: 1440px) { .vt-viewport { zoom: 1.08; } }
	@media (min-width: 1680px) { .vt-viewport { zoom: 1.16; } }
	@media (min-width: 1920px) { .vt-viewport { zoom: 1.25; } }

	.deck-slide {
		display: none;
	}

	.deck-slide.active {
		display: block;
		animation: deckFade 0.25s ease-out;
	}

	@keyframes deckFade {
		from { opacity: 0; transform: translateY(6px); }
		to { opacity: 1; transform: translateY(0); }
