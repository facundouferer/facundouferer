		cursor: pointer;
		transition: all 0.2s;
	}

	.deck-sub-block:hover,
	.deck-sub-block.active {
		fill: var(--color-accent-200);
		stroke: var(--color-accent);
	}

	.deck-sub-block-accent {
		fill: var(--color-surface);
		stroke: var(--color-accent);
		cursor: pointer;
