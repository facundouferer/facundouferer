	.an-reset-btn {
		background: transparent;
		color: color-mix(in srgb, var(--color-text) 55%, transparent);
		font-size: 13px;
		padding: var(--space-2) var(--space-3);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-md);
		cursor: pointer;
	}

	.an-state-status {
		font-size: 12px;
		color: color-mix(in srgb, var(--color-text) 55%, transparent);
		font-style: italic;
	}

	.an-preorder-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
	}

	@media (max-width: 768px) {
		.an-preorder-row {
			grid-template-columns: 1fr;
		}
	}

	.an-preorder-col {
		background: var(--color-bg);
		border-radius: var(--radius-md);
		padding: var(--space-3);
	}

	.an-col-title {
		display: block;
		font-size: 11px;
		font-weight: 700;
		color: color-mix(in srgb, var(--color-text) 55%, transparent);
		margin-bottom: var(--space-2);
	}

	.an-po-node .an-lcrs-node {
		transition: fill 0.25s, stroke 0.25s;
	}

	.an-po-node.is-visited .an-lcrs-node {
		fill: color-mix(in srgb, var(--color-accent-2) 25%, var(--color-surface));
		stroke: var(--color-accent-2);
	}

	.an-po-node.is-current .an-lcrs-node {
		fill: var(--color-accent);
		stroke: var(--color-accent-700);
	}

	.an-po-node.is-current .an-lcrs-text {
		fill: var(--color-bg);
	}

	.an-seq-row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}

	.an-seq-chip {
		font-family: monospace;
		font-size: 11px;
		padding: 4px 8px;
		border-radius: 999px;
		border: 1px solid var(--color-divider);
		color: color-mix(in srgb, var(--color-text) 45%, transparent);
		transition: all 0.2s;
	}

	.an-seq-chip.is-visited {
		background: var(--color-accent);
		color: var(--color-bg);
		border-color: var(--color-accent);
		font-weight: 700;
	}

	/* Slide 5: parent vector */
	.an-vector-wrap {
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: var(--space-2);
		background: var(--color-bg);
		border-radius: var(--radius-md);
		padding: var(--space-3);
	}

	.an-svg-vector-tree { width: 60%; max-width: 400px; height: auto; }
	.an-svg-vector-tree-node4 { width: 16%; max-width: 100px; }

	.an-vector-edge {
		stroke: color-mix(in srgb, var(--color-text) 30%, transparent);
		transition: stroke 0.25s, stroke-width 0.25s;
	}

	.an-vector-edge.is-active {
		stroke: var(--color-accent);
		stroke-width: 4;
	}

	.an-vector-node {
		transition: fill 0.25s, stroke 0.25s;
	}

	.an-vector-node.is-active {
		fill: var(--color-accent);
		stroke: var(--color-accent-700);
	}

	.an-vector-table {
		width: 100%;
		border-collapse: collapse;
		margin-top: var(--space-4);
		font-family: monospace;
		font-size: 13px;
	}

	.an-vector-table th,
	.an-vector-table td {
		border: 1px solid var(--color-divider);
		padding: var(--space-2);
		text-align: center;
	}

	.an-vector-table th:first-child,
	.an-vector-table td:first-child {
		font-family: var(--font-body);
		font-weight: 700;
		text-align: left;
	}

	.an-vector-cell {
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}

	.an-vector-cell:hover {
		background: color-mix(in srgb, var(--color-accent) 12%, transparent);
	}

	.an-vector-cell.is-active {
		background: var(--color-accent);
		color: var(--color-bg);
		font-weight: 700;
	}

	/* Slide 6: climb / list simulator */
	.an-node-select-row {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-wrap: wrap;
		margin-bottom: var(--space-4);
	}

	.an-node-select-btn {
		width: 32px;
		height: 32px;
		border-radius: 50%;
		border: 1px solid var(--color-divider);
		background: var(--color-bg);
		font-weight: 700;
		font-size: 13px;
		cursor: pointer;
		transition: all 0.2s;
	}

	.an-node-select-btn.is-active {
		background: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-bg);
	}

	.an-array-strip {
		display: flex;
		gap: var(--space-2);
		margin-bottom: var(--space-4);
	}

	.an-array-cell {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		background: var(--color-bg);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-md);
		padding: var(--space-2);
		font-family: monospace;
		transition: all 0.25s;
	}

	.an-array-idx {
		font-size: 10px;
		color: color-mix(in srgb, var(--color-text) 55%, transparent);
	}

	.an-array-val {
		font-size: 16px;
		font-weight: 700;
	}

	.an-array-cell.is-path {
		background: color-mix(in srgb, var(--color-accent) 20%, transparent);
		border-color: var(--color-accent);
	}

	.an-array-cell.is-checking {
		border-color: var(--color-accent-2);
	}

	.an-array-cell.is-hit {
		background: color-mix(in srgb, var(--color-accent-2) 25%, transparent);
		border-color: var(--color-accent-2);
	}

	/* Slide 7: K-ary */
	.an-svg-kary { width: 100%; height: auto; }

	.an-kary-node { cursor: pointer; }

	.an-kary-node .an-lcrs-node,
	.an-kary-cell .an-array-rect {
		transition: fill 0.2s, stroke 0.2s;
	}

	.an-guide {
		stroke: color-mix(in srgb, var(--color-text) 18%, transparent);
		stroke-dasharray: 2, 3;
	}

	.an-array-rect {
		fill: var(--color-bg);
		stroke: var(--color-divider);
		stroke-width: 1.5;
		cursor: pointer;
	}

	.an-array-rect-text {
		font-family: monospace;
		font-size: 11px;
		fill: var(--color-text);
	}

	.an-kary-node.is-selected .an-lcrs-node,
	.an-kary-cell.is-selected .an-array-rect {
		fill: var(--color-accent);
		stroke: var(--color-accent-700);
	}

	.an-kary-node.is-selected .an-lcrs-text,
	.an-kary-cell.is-selected .an-array-rect-text {
		fill: var(--color-bg);
	}

	.an-kary-node.is-parent .an-lcrs-node,
	.an-kary-cell.is-parent .an-array-rect {
		stroke: var(--color-accent-2);
		stroke-width: 2.5;
	}

	.an-kary-node.is-child .an-lcrs-node,
	.an-kary-cell.is-child .an-array-rect {
		fill: color-mix(in srgb, var(--color-accent-2) 25%, transparent);
		stroke: var(--color-accent-2);
	}

	.an-kary-formulas {
		display: flex;
		gap: var(--space-3);
		flex-wrap: wrap;
		margin-top: var(--space-4);
	}

	.an-kary-formula {
		font-family: monospace;
		font-size: 12px;
		background: var(--color-bg);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-sm);
		padding: var(--space-2) var(--space-3);
		color: var(--color-accent-700);
	}

	@media (min-width: 1440px) { .an-viewport { zoom: 1.08; } }
	@media (min-width: 1680px) { .an-viewport { zoom: 1.16; } }
	@media (min-width: 1920px) { .an-viewport { zoom: 1.25; } }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 7;

	const rootEl = document.querySelector('.an-screen') as HTMLElement | null;
	const isEsGlobal = rootEl?.getAttribute('data-lang') !== 'en';

	const prevBtn = document.getElementById('anPrevBtn') as HTMLButtonElement;
	const nextBtn = document.getElementById('anNextBtn') as HTMLButtonElement;
	const counter = document.getElementById('anSlideCounter') as HTMLElement;
	const slides = document.querySelectorAll<HTMLElement>('.an-slide');

	function updateSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;
		slides.forEach((s) => s.classList.remove('is-active'));
		document.querySelector(`.an-slide[data-slide="${currentSlide}"]`)?.classList.add('is-active');

		if (counter) counter.textContent = `${currentSlide} / ${totalSlides}`;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	prevBtn?.addEventListener('click', () => updateSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => updateSlide(currentSlide + 1));

	document.addEventListener('keydown', (e) => {
		if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || e.target instanceof HTMLSelectElement) return;
		if (e.key === 'ArrowRight') updateSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') updateSlide(currentSlide - 1);
	});

	// Slide 3: LCRS slider crossfade
	const lcrsSlider = document.getElementById('anLcrsSlider') as HTMLInputElement;
	const naryGroup = document.getElementById('anNaryGroup');
	const lcrsGroup = document.getElementById('anLcrsGroup');
	const lcrsLabelNary = document.getElementById('anLcrsLabelNary');
	const lcrsLabelBinary = document.getElementById('anLcrsLabelBinary');

	function renderLcrs() {
		if (!lcrsSlider) return;
		const t = Number(lcrsSlider.value) / 100;
		if (naryGroup) {
			naryGroup.style.opacity = String(1 - t);
			naryGroup.style.transform = `translateY(${-t * 10}px)`;
		}
		if (lcrsGroup) {
			lcrsGroup.style.opacity = String(t);
			lcrsGroup.style.transform = `translateY(${(1 - t) * 10}px)`;
		}
		lcrsLabelNary?.classList.toggle('is-active', t < 0.5);
		lcrsLabelBinary?.classList.toggle('is-active', t >= 0.5);
	}

	lcrsSlider?.addEventListener('input', renderLcrs);
	renderLcrs();

	// Slide 4: preorder stepper
	const preorderNextBtn = document.getElementById('anPreorderNextBtn');
	const preorderResetBtn = document.getElementById('anPreorderResetBtn');
	const preorderStatus = document.getElementById('anPreorderStatus');
	const poNodes = document.querySelectorAll<HTMLElement>('.an-po-node');
	const seqChips = document.querySelectorAll<HTMLElement>('.an-seq-chip');
	const preorderLabels: Record<number, string> = { 1: 'A', 2: 'B', 3: 'E', 4: 'F', 5: 'C', 6: 'D' };
	let preorderStep = 0;

	function renderPreorder() {
		poNodes.forEach((node) => {
			const order = Number(node.getAttribute('data-order'));
			node.classList.toggle('is-visited', order < preorderStep);
			node.classList.toggle('is-current', order === preorderStep);
		});
		seqChips.forEach((chip) => {
			const chipOrder = Number(chip.getAttribute('data-chip'));
			chip.classList.toggle('is-visited', chipOrder <= preorderStep);
		});
		if (preorderStatus) {
			if (preorderStep === 0) {
				preorderStatus.textContent = isEsGlobal ? 'Presioná "Siguiente paso" para iniciar el recorrido' : 'Press "Next step" to start the traversal';
			} else {
				const visited = Object.entries(preorderLabels)
					.filter(([order]) => Number(order) <= preorderStep)
					.map(([, label]) => label)
					.join(' → ');
				preorderStatus.textContent = (isEsGlobal ? 'Orden de visita: ' : 'Visit order: ') + visited;
			}
		}
	}

	preorderNextBtn?.addEventListener('click', () => {
		if (preorderStep < 6) {
			preorderStep++;
			renderPreorder();
		}
	});

	preorderResetBtn?.addEventListener('click', () => {
		preorderStep = 0;
		renderPreorder();
	});

	// Slide 5: parent vector table -> tree edge highlight
	const parentVector5 = [-1, 0, 0, 0, 1];
	const vectorCells = document.querySelectorAll<HTMLElement>('.an-vector-cell');
	const vectorEdges = document.querySelectorAll<SVGPathElement>('.an-vector-edge');
	const vectorNodes = document.querySelectorAll<SVGCircleElement>('.an-vector-node');
	const vectorHint = document.getElementById('anVectorHint');

	function selectVectorIndex(index: number) {
		vectorCells.forEach((cell) => cell.classList.toggle('is-active', Number(cell.getAttribute('data-index')) === index));
		vectorEdges.forEach((edge) => edge.classList.toggle('is-active', Number(edge.getAttribute('data-index')) === index));
		vectorNodes.forEach((node) => node.classList.toggle('is-active', Number(node.getAttribute('data-node')) === index));
		const parent = parentVector5[index];
		if (vectorHint) {
			vectorHint.textContent = parent === -1
				? (isEsGlobal ? `padre[${index}] = -1 → el nodo ${index} es la raíz, no tiene padre.` : `padre[${index}] = -1 → node ${index} is the root, it has no parent.`)
				: (isEsGlobal ? `padre[${index}] = ${parent} → el nodo ${index} apunta a su padre, el nodo ${parent}.` : `padre[${index}] = ${parent} → node ${index} points to its parent, node ${parent}.`);
		}
	}

	vectorCells.forEach((cell) => {
		cell.addEventListener('click', () => selectVectorIndex(Number(cell.getAttribute('data-index'))));
	});

	// Slide 6: climb / list children simulator
	const parentVector6 = [-1, 0, 0, 0, 1];
	let climbSelected = 4;
	const nodeSelectBtns = document.querySelectorAll<HTMLElement>('.an-node-select-btn');
	const arrayCells = document.querySelectorAll<HTMLElement>('.an-array-cell');
	const climbBtn = document.getElementById('anClimbBtn');
	const listBtn = document.getElementById('anListBtn');
	const simResetBtn = document.getElementById('anSimResetBtn');
	const simLog = document.getElementById('anSimLog');

	function clearArrayClasses() {
		arrayCells.forEach((cell) => cell.classList.remove('is-path', 'is-checking', 'is-hit'));
	}

	nodeSelectBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			climbSelected = Number(btn.getAttribute('data-node'));
			nodeSelectBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
			clearArrayClasses();
			if (simLog) simLog.textContent = isEsGlobal ? `Nodo ${climbSelected} seleccionado.` : `Node ${climbSelected} selected.`;
		});
	});

	climbBtn?.addEventListener('click', () => {
		clearArrayClasses();
		const path: number[] = [climbSelected];
		let cur = climbSelected;
		while (parentVector6[cur] !== -1) {
			cur = parentVector6[cur];
			path.push(cur);
		}
		path.forEach((idx, i) => {
			setTimeout(() => {
				document.getElementById(`anArrCell-${idx}`)?.classList.add('is-path');
				if (simLog) {
					const trail = path.slice(0, i + 1).join(' → ');
					const done = i === path.length - 1;
					simLog.textContent = isEsGlobal
						? `Camino a la raíz: ${trail}${done ? ' (raíz alcanzada, O(altura))' : ''}`
						: `Path to root: ${trail}${done ? ' (root reached, O(height))' : ''}`;
				}
			}, i * 450);
		});
	});

	listBtn?.addEventListener('click', () => {
		clearArrayClasses();
		const hits: number[] = [];
		for (let j = 0; j < parentVector6.length; j++) {
			setTimeout(() => {
				const cell = document.getElementById(`anArrCell-${j}`);
				cell?.classList.add('is-checking');
				const isHit = parentVector6[j] === climbSelected;
				if (isHit) {
					hits.push(j);
					cell?.classList.add('is-hit');
				}
				if (simLog) {
					const last = j === parentVector6.length - 1;
					simLog.textContent = last
						? (isEsGlobal ? `Hijos de ${climbSelected}: [${hits.join(', ')}] — se revisaron ${parentVector6.length} celdas, O(N).` : `Children of ${climbSelected}: [${hits.join(', ')}] — scanned ${parentVector6.length} cells, O(N).`)
						: (isEsGlobal ? `Revisando índice ${j}…` : `Checking index ${j}…`);
				}
			}, j * 350);
		}
	});

	simResetBtn?.addEventListener('click', () => {
		clearArrayClasses();
		if (simLog) simLog.textContent = isEsGlobal ? 'Elegí un nodo y una operación.' : 'Pick a node and an operation.';
	});

	// Slide 7: K-ary index formulas
	const K = 3;
	const N = 7;
	const karyNodes = document.querySelectorAll<HTMLElement>('.an-kary-node');
	const karyCells = document.querySelectorAll<HTMLElement>('.an-kary-cell');
	const karyResult = document.getElementById('anKaryResult');

	function selectKary(i: number) {
		const parent = i === 0 ? null : Math.floor((i - 1) / K);
		const children = [1, 2, 3].map((j) => K * i + j).filter((c) => c <= N - 1);

		[...karyNodes, ...karyCells].forEach((el) => {
			const idx = Number(el.getAttribute('data-kary'));
			el.classList.toggle('is-selected', idx === i);
			el.classList.toggle('is-parent', parent !== null && idx === parent);
			el.classList.toggle('is-child', children.includes(idx));
		});

		if (karyResult) {
			const parentText = parent === null
				? (isEsGlobal ? 'ninguno (raíz)' : 'none (root)')
				: `${parent} = ⌊(${i}-1)/${K}⌋`;
			const childrenText = children.length
				? children.join(', ')
				: (isEsGlobal ? `ninguno (fuera de rango, N=${N})` : `none (out of range, N=${N})`);
			karyResult.textContent = isEsGlobal
				? `Nodo ${i}: padre = ${parentText} · hijos = ${childrenText}`
				: `Node ${i}: parent = ${parentText} · children = ${childrenText}`;
		}
	}

	[...karyNodes, ...karyCells].forEach((el) => {
		el.addEventListener('click', () => selectKary(Number(el.getAttribute('data-kary'))));
	});
</script>
