---
interface Props {
	lang?: string;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<div class="an-screen" data-presentation="arboles-n-arios-vectores-java" data-lang={lang}>
	<div class="an-shell">
		<nav class="an-nav" aria-label="Controles de navegación">
			<button class="an-btn" id="anPrevBtn" aria-label="Diapositiva anterior" disabled>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
					<path d="m15 18-6-6 6-6" />
				</svg>
				<span>{isEs ? 'Anterior' : 'Previous'}</span>
			</button>
			<span class="an-counter" id="anSlideCounter" aria-live="polite">1 / 7</span>
			<button class="an-btn" id="anNextBtn" aria-label="Siguiente diapositiva">
				<span>{isEs ? 'Siguiente' : 'Next'}</span>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
					<path d="m9 18 6-6-6-6" />
				</svg>
			</button>
		</nav>

		<main class="an-viewport">
			<!-- Slide 1: Árboles N-arios — el modelo del mundo real -->
			<section class="an-slide is-active" data-slide="1">
				<div class="an-header">
					<span class="an-kicker">{isEs ? 'Modelo del Mundo Real' : 'Real-World Modeling'}</span>
					<h2 class="an-title">{isEs ? 'Árboles N-arios: Más Allá del Binario' : 'N-ary Trees: Beyond Binary'}</h2>
					<p class="an-lead">
						{isEs
							? 'A diferencia de un árbol binario, un nodo puede tener 0, 1, 2… K hijos. Un sistema de archivos, el DOM de una página o una jerarquía de categorías son árboles generales.'
							: 'Unlike a binary tree, a node can have 0, 1, 2… K children. A filesystem, an HTML DOM tree, or a category hierarchy are all general trees.'}
					</p>
				</div>

				<div class="an-card">
					<div class="an-fs-viz">
						<svg viewBox="0 0 760 226" class="an-svg-tree" role="img" aria-label={isEs ? 'Árbol de directorios de un sistema de archivos' : 'Directory tree of a filesystem'}>
							<!-- edges -->
							<path d="M360,40 L80,95" class="an-edge" />
							<path d="M360,40 L270,95" class="an-edge" />
							<path d="M360,40 L470,95" class="an-edge" />
							<path d="M360,40 L670,95" class="an-edge" />
							<path d="M270,125 L210,180" class="an-edge" />
							<path d="M270,125 L330,180" class="an-edge" />
							<path d="M470,125 L400,180" class="an-edge" />
							<path d="M470,125 L460,180" class="an-edge" />
							<path d="M470,125 L520,180" class="an-edge" />
							<path d="M470,125 L596,180" class="an-edge" />
							<path d="M470,125 L668,180" class="an-edge" />

							<!-- root -->
							<rect x="335" y="10" width="50" height="30" rx="8" class="an-node-rect an-node-root" />
							<text x="360" y="30" class="an-node-text an-node-text-inverse" text-anchor="middle">/</text>

							<!-- level 2 -->
							<rect x="45" y="95" width="70" height="30" rx="8" class="an-node-rect" />
							<text x="80" y="115" class="an-node-text" text-anchor="middle">bin</text>

							<rect x="235" y="95" width="70" height="30" rx="8" class="an-node-rect" />
							<text x="270" y="115" class="an-node-text" text-anchor="middle">home</text>
							<circle cx="301" cy="93" r="9" class="an-degree-badge" /><text x="301" y="96.5" class="an-degree-text" text-anchor="middle">2</text>

							<rect x="435" y="95" width="70" height="30" rx="8" class="an-node-rect" />
							<text x="470" y="115" class="an-node-text" text-anchor="middle">etc</text>
							<circle cx="501" cy="93" r="9" class="an-degree-badge" /><text x="501" y="96.5" class="an-degree-text" text-anchor="middle">5</text>

							<rect x="635" y="95" width="70" height="30" rx="8" class="an-node-rect" />
							<text x="670" y="115" class="an-node-text" text-anchor="middle">var</text>

							<circle cx="381" cy="8" r="9" class="an-degree-badge an-degree-badge-root" /><text x="381" y="11.5" class="an-degree-text" text-anchor="middle">4</text>

							<!-- level 3: home children -->
							<rect x="168" y="180" width="84" height="30" rx="8" class="an-node-rect an-node-leaf" />
							<text x="210" y="200" class="an-node-text an-node-text-sm" text-anchor="middle">facundo</text>
							<rect x="288" y="180" width="84" height="30" rx="8" class="an-node-rect an-node-leaf" />
							<text x="330" y="200" class="an-node-text an-node-text-sm" text-anchor="middle">invitado</text>

							<!-- level 3: etc children -->
							<rect x="364" y="180" width="72" height="30" rx="8" class="an-node-rect an-node-leaf" />
							<text x="400" y="200" class="an-node-text an-node-text-sm" text-anchor="middle">nginx</text>
							<rect x="428" y="180" width="64" height="30" rx="8" class="an-node-rect an-node-leaf" />
							<text x="460" y="200" class="an-node-text an-node-text-sm" text-anchor="middle">ssh</text>
							<rect x="488" y="180" width="64" height="30" rx="8" class="an-node-rect an-node-leaf" />
							<text x="520" y="200" class="an-node-text an-node-text-sm" text-anchor="middle">hosts</text>
							<rect x="550" y="180" width="92" height="30" rx="8" class="an-node-rect an-node-leaf" />
							<text x="596" y="200" class="an-node-text an-node-text-sm" text-anchor="middle">resolv.conf</text>
							<rect x="636" y="180" width="64" height="30" rx="8" class="an-node-rect an-node-leaf" />
							<text x="668" y="200" class="an-node-text an-node-text-sm" text-anchor="middle">ssl</text>
						</svg>
					</div>
					<p class="an-caption">
						{isEs
							? 'El grado (cantidad de hijos) no está acotado ni es uniforme: home tiene 2 hijos, etc/ tiene 5, mientras que bin/ y var/ son hojas con 0 hijos. Esa asimetría es imposible de modelar con un árbol binario.'
							: 'The degree (number of children) is neither bounded nor uniform: home has 2 children, etc/ has 5, while bin/ and var/ are leaves with 0 children. That asymmetry cannot be modeled with a binary tree.'}
					</p>
				</div>
			</section>

			<!-- Slide 2: El dilema de implementación -->
			<section class="an-slide" data-slide="2">
				<div class="an-header">
					<span class="an-kicker">{isEs ? 'Dilema de Implementación' : 'Implementation Dilemma'}</span>
					<h2 class="an-title">{isEs ? 'Array Fijo de Hijos vs Lista Dinámica' : 'Fixed Children Array vs Dynamic List'}</h2>
					<p class="an-lead">
						{isEs
							? 'Nodo[] hijos = new Nodo[MAX] reserva memoria fija por adelantado: brutal en nodos hoja. List<Nodo> hijos crece según necesidad, a costa de la sobrecarga de un objeto ArrayList por nodo.'
							: 'Nodo[] hijos = new Nodo[MAX] reserves fixed memory upfront: brutal on leaf nodes. List<Nodo> hijos grows as needed, at the cost of an ArrayList object overhead per node.'}
					</p>
				</div>

				<div class="an-card">
					<div class="an-mem-grid">
						<!-- Option A -->
						<div class="an-mem-panel">
							<div class="an-mem-head">
								<span class="an-badge">{isEs ? 'Opción A · Array Fijo' : 'Option A · Fixed Array'}</span>
								<strong>Nodo[] hijos = new Nodo[8]</strong>
							</div>
							<p class="an-mem-sub">{isEs ? 'Nodo etc/ (5 hijos reales) reserva 8 punteros por adelantado:' : 'The etc/ node (5 real children) reserves 8 pointers upfront:'}</p>
							<div class="an-cell-row">
								<span class="an-mem-cell is-used">nginx</span>
								<span class="an-mem-cell is-used">ssh</span>
								<span class="an-mem-cell is-used">hosts</span>
								<span class="an-mem-cell is-used">resolv.conf</span>
								<span class="an-mem-cell is-used">ssl</span>
								<span class="an-mem-cell is-empty">null</span>
								<span class="an-mem-cell is-empty">null</span>
								<span class="an-mem-cell is-empty">null</span>
							</div>
							<p class="an-mem-stat"><strong class="an-text-accent">3 / 8</strong> {isEs ? 'celdas desperdiciadas (37,5%)' : 'wasted cells (37.5%)'}</p>
							<p class="an-mem-sub">{isEs ? 'Nodo hoja bin/ (0 hijos) reserva las mismas 8 celdas:' : 'The leaf node bin/ (0 children) reserves the same 8 cells:'}</p>
							<div class="an-cell-row">
								<span class="an-mem-cell is-empty">null</span>
								<span class="an-mem-cell is-empty">null</span>
								<span class="an-mem-cell is-empty">null</span>
								<span class="an-mem-cell is-empty">null</span>
								<span class="an-mem-cell is-empty">null</span>
								<span class="an-mem-cell is-empty">null</span>
								<span class="an-mem-cell is-empty">null</span>
								<span class="an-mem-cell is-empty">null</span>
							</div>
							<p class="an-mem-stat"><strong class="an-text-accent">8 / 8</strong> {isEs ? 'celdas desperdiciadas (100%)' : 'wasted cells (100%)'}</p>
						</div>

						<!-- Option B -->
						<div class="an-mem-panel">
							<div class="an-mem-head">
								<span class="an-badge an-badge-alt">{isEs ? 'Opción B · Lista Dinámica' : 'Option B · Dynamic List'}</span>
								<strong>List&lt;Nodo&gt; hijos = new ArrayList&lt;&gt;()</strong>
							</div>
							<p class="an-mem-sub">{isEs ? 'Nodo etc/ (5 hijos): la lista crece exactamente a 5 elementos.' : 'The etc/ node (5 children): the list grows to exactly 5 elements.'}</p>
							<div class="an-cell-row">
								<span class="an-mem-cell is-used">nginx</span>
								<span class="an-mem-cell is-used">ssh</span>
								<span class="an-mem-cell is-used">hosts</span>
								<span class="an-mem-cell is-used">resolv.conf</span>
								<span class="an-mem-cell is-used">ssl</span>
							</div>
							<p class="an-mem-stat"><strong class="an-text-accent-2">0</strong> {isEs ? 'celdas desperdiciadas, pero +overhead de objeto ArrayList por nodo' : 'wasted cells, but +ArrayList object overhead per node'}</p>
							<p class="an-mem-sub">{isEs ? 'Nodo hoja bin/ (0 hijos): la lista queda vacía.' : 'The leaf node bin/ (0 children): the list stays empty.'}</p>
							<div class="an-cell-row">
								<span class="an-mem-cell is-empty-list">{isEs ? '(vacía)' : '(empty)'}</span>
							</div>
							<p class="an-mem-stat"><strong class="an-text-accent-2">0</strong> {isEs ? 'celdas desperdiciadas, aún así carga un objeto ArrayList por hoja' : 'wasted cells, yet still carries one ArrayList object per leaf'}</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Slide 3: Transformación Primer Hijo / Siguiente Hermano (LCRS) -->
			<section class="an-slide" data-slide="3">
				<div class="an-header">
					<span class="an-kicker">{isEs ? 'Transformación Estructural' : 'Structural Transformation'}</span>
					<h2 class="an-title">{isEs ? 'Primer Hijo / Siguiente Hermano (LCRS)' : 'Left-Child Right-Sibling (LCRS)'}</h2>
					<p class="an-lead">
						{isEs
							? 'Cada nodo solo necesita dos referencias: primerHijo (el hijo más a la izquierda) y siguienteHermano (el próximo nodo a su derecha en el mismo nivel). Deslizá para transformar el árbol N-ario en un árbol binario estricto.'
							: 'Each node only needs two references: primerHijo (leftmost child) and siguienteHermano (next node to its right at the same level). Drag to transform the N-ary tree into a strict binary tree.'}
					</p>
				</div>

				<div class="an-card">
					<div class="an-lcrs-slider-row">
						<span class="an-lcrs-label" id="anLcrsLabelNary">{isEs ? 'Vista N-aria' : 'N-ary View'}</span>
						<input type="range" id="anLcrsSlider" class="an-lcrs-slider" min="0" max="100" value="0" step="1" aria-label={isEs ? 'Transición entre vista N-aria y vista LCRS binaria' : 'Transition between N-ary view and binary LCRS view'} />
						<span class="an-lcrs-label" id="anLcrsLabelBinary">{isEs ? 'Vista Binaria (LCRS)' : 'Binary View (LCRS)'}</span>
					</div>

					<div class="an-lcrs-viz">
						<svg viewBox="0 0 420 250" class="an-svg-lcrs">
							<!-- N-ary group -->
							<g id="anNaryGroup">
								<path d="M210,45 L118,102" class="an-edge an-edge-primary" />
								<path d="M210,45 L210,102" class="an-edge an-edge-primary" />
								<path d="M210,45 L302,102" class="an-edge an-edge-primary" />
								<path d="M110,125 L74,182" class="an-edge an-edge-primary" />
								<path d="M110,125 L150,182" class="an-edge an-edge-primary" />

								<circle cx="210" cy="30" r="20" class="an-lcrs-node" /><text x="210" y="35" class="an-lcrs-text" text-anchor="middle">A</text>
								<circle cx="110" cy="110" r="20" class="an-lcrs-node" /><text x="110" y="115" class="an-lcrs-text" text-anchor="middle">B</text>
								<circle cx="210" cy="110" r="20" class="an-lcrs-node" /><text x="210" y="115" class="an-lcrs-text" text-anchor="middle">C</text>
								<circle cx="310" cy="110" r="20" class="an-lcrs-node" /><text x="310" y="115" class="an-lcrs-text" text-anchor="middle">D</text>
								<circle cx="70" cy="190" r="18" class="an-lcrs-node an-lcrs-node-sm" /><text x="70" y="195" class="an-lcrs-text" text-anchor="middle">E</text>
								<circle cx="150" cy="190" r="18" class="an-lcrs-node an-lcrs-node-sm" /><text x="150" y="195" class="an-lcrs-text" text-anchor="middle">F</text>
							</g>

							<!-- LCRS binary group -->
							<g id="anLcrsGroup">
								<path d="M210,45 L145,85" class="an-edge an-edge-first" />
								<path d="M145,110 L88,165" class="an-edge an-edge-first" />
								<path d="M145,110 L275,140" class="an-edge an-edge-sibling" />
								<path d="M280,150 L345,190" class="an-edge an-edge-sibling" />
								<path d="M88,180 L175,215" class="an-edge an-edge-sibling" />

								<circle cx="210" cy="30" r="20" class="an-lcrs-node" /><text x="210" y="35" class="an-lcrs-text" text-anchor="middle">A</text>
								<circle cx="145" cy="100" r="20" class="an-lcrs-node" /><text x="145" y="105" class="an-lcrs-text" text-anchor="middle">B</text>
								<circle cx="290" cy="150" r="20" class="an-lcrs-node" /><text x="290" y="155" class="an-lcrs-text" text-anchor="middle">C</text>
								<circle cx="355" cy="200" r="18" class="an-lcrs-node an-lcrs-node-sm" /><text x="355" y="205" class="an-lcrs-text" text-anchor="middle">D</text>
								<circle cx="80" cy="175" r="20" class="an-lcrs-node" /><text x="80" y="180" class="an-lcrs-text" text-anchor="middle">E</text>
								<circle cx="185" cy="225" r="18" class="an-lcrs-node an-lcrs-node-sm" /><text x="185" y="230" class="an-lcrs-text" text-anchor="middle">F</text>
							</g>
						</svg>
					</div>

					<div class="an-lcrs-legend">
						<span class="an-legend-item"><span class="an-legend-dot an-legend-dot-first"></span>primerHijo</span>
						<span class="an-legend-item"><span class="an-legend-dot an-legend-dot-sibling"></span>siguienteHermano</span>
					</div>
					<p class="an-subtext" id="anLcrsExplain">
						{isEs
							? 'En 0%: árbol N-ario tradicional, cada nodo con una lista de hijos. En 100%: solo el hijo más izquierdo cuelga hacia abajo (primerHijo); los demás se encadenan hacia la derecha (siguienteHermano), formando un árbol binario estricto.'
							: 'At 0%: the traditional N-ary tree, each node with a list of children. At 100%: only the leftmost child hangs downward (primerHijo); the rest chain to the right (siguienteHermano), forming a strict binary tree.'}
					</p>
				</div>
			</section>

			<!-- Slide 4: Recorrido en Preorden -->
			<section class="an-slide" data-slide="4">
				<div class="an-header">
					<span class="an-kicker">{isEs ? 'Recorrido en Profundidad' : 'Depth-First Traversal'}</span>
					<h2 class="an-title">{isEs ? 'Preorden: el Padre Antes que sus Hijos' : 'Preorder: Parent Before Its Children'}</h2>
					<p class="an-lead">
						{isEs
							? 'Se visita el nodo, luego se recorre cada subárbol de izquierda a derecha. El mismo recorrido, aplicado sobre la versión LCRS, produce exactamente la misma secuencia.'
							: 'Visit the node, then walk each subtree left to right. The same traversal, applied to the LCRS version, yields the exact same sequence.'}
					</p>
				</div>

				<div class="an-card">
					<div class="an-sim-toolbar">
						<button class="an-action-btn" id="anPreorderNextBtn">{isEs ? 'Siguiente paso' : 'Next step'}</button>
						<button class="an-reset-btn" id="anPreorderResetBtn">{isEs ? 'Reiniciar' : 'Reset'}</button>
						<span class="an-state-status" id="anPreorderStatus">{isEs ? 'Presioná "Siguiente paso" para iniciar el recorrido' : 'Press "Next step" to start the traversal'}</span>
					</div>

					<div class="an-preorder-row">
						<div class="an-preorder-col">
							<span class="an-col-title">{isEs ? 'Árbol N-ario' : 'N-ary Tree'}</span>
							<svg viewBox="0 0 420 250" class="an-svg-lcrs" id="anPoNarySvg">
								<path d="M210,45 L118,102" class="an-edge an-edge-primary" />
								<path d="M210,45 L210,102" class="an-edge an-edge-primary" />
								<path d="M210,45 L302,102" class="an-edge an-edge-primary" />
								<path d="M110,125 L74,182" class="an-edge an-edge-primary" />
								<path d="M110,125 L150,182" class="an-edge an-edge-primary" />

								<g data-order="1" class="an-po-node"><circle cx="210" cy="30" r="20" class="an-lcrs-node" /><text x="210" y="35" class="an-lcrs-text" text-anchor="middle">A</text></g>
								<g data-order="2" class="an-po-node"><circle cx="110" cy="110" r="20" class="an-lcrs-node" /><text x="110" y="115" class="an-lcrs-text" text-anchor="middle">B</text></g>
								<g data-order="5" class="an-po-node"><circle cx="210" cy="110" r="20" class="an-lcrs-node" /><text x="210" y="115" class="an-lcrs-text" text-anchor="middle">C</text></g>
								<g data-order="6" class="an-po-node"><circle cx="310" cy="110" r="20" class="an-lcrs-node" /><text x="310" y="115" class="an-lcrs-text" text-anchor="middle">D</text></g>
								<g data-order="3" class="an-po-node"><circle cx="70" cy="190" r="18" class="an-lcrs-node an-lcrs-node-sm" /><text x="70" y="195" class="an-lcrs-text" text-anchor="middle">E</text></g>
								<g data-order="4" class="an-po-node"><circle cx="150" cy="190" r="18" class="an-lcrs-node an-lcrs-node-sm" /><text x="150" y="195" class="an-lcrs-text" text-anchor="middle">F</text></g>
							</svg>
						</div>
						<div class="an-preorder-col">
							<span class="an-col-title">{isEs ? 'Árbol LCRS (binario)' : 'LCRS Tree (binary)'}</span>
							<svg viewBox="0 0 420 250" class="an-svg-lcrs" id="anPoLcrsSvg">
								<path d="M210,45 L145,85" class="an-edge an-edge-first" />
								<path d="M145,110 L88,165" class="an-edge an-edge-first" />
								<path d="M145,110 L275,140" class="an-edge an-edge-sibling" />
								<path d="M280,150 L345,190" class="an-edge an-edge-sibling" />
								<path d="M88,180 L175,215" class="an-edge an-edge-sibling" />

								<g data-order="1" class="an-po-node"><circle cx="210" cy="30" r="20" class="an-lcrs-node" /><text x="210" y="35" class="an-lcrs-text" text-anchor="middle">A</text></g>
								<g data-order="2" class="an-po-node"><circle cx="145" cy="100" r="20" class="an-lcrs-node" /><text x="145" y="105" class="an-lcrs-text" text-anchor="middle">B</text></g>
								<g data-order="5" class="an-po-node"><circle cx="290" cy="150" r="20" class="an-lcrs-node" /><text x="290" y="155" class="an-lcrs-text" text-anchor="middle">C</text></g>
								<g data-order="6" class="an-po-node"><circle cx="355" cy="200" r="18" class="an-lcrs-node an-lcrs-node-sm" /><text x="355" y="205" class="an-lcrs-text" text-anchor="middle">D</text></g>
								<g data-order="3" class="an-po-node"><circle cx="80" cy="175" r="20" class="an-lcrs-node" /><text x="80" y="180" class="an-lcrs-text" text-anchor="middle">E</text></g>
								<g data-order="4" class="an-po-node"><circle cx="185" cy="225" r="18" class="an-lcrs-node an-lcrs-node-sm" /><text x="185" y="230" class="an-lcrs-text" text-anchor="middle">F</text></g>
							</svg>
						</div>
					</div>

					<div class="an-seq-row" id="anPreorderSequence" aria-live="polite">
						<span class="an-seq-chip" data-chip="1">1: A</span>
						<span class="an-seq-chip" data-chip="2">2: B</span>
						<span class="an-seq-chip" data-chip="3">3: E</span>
						<span class="an-seq-chip" data-chip="4">4: F</span>
						<span class="an-seq-chip" data-chip="5">5: C</span>
						<span class="an-seq-chip" data-chip="6">6: D</span>
					</div>
				</div>
			</section>

			<!-- Slide 5: Vector de padres -->
			<section class="an-slide" data-slide="5">
				<div class="an-header">
					<span class="an-kicker">{isEs ? 'Representación Compacta en Memoria' : 'Compact Memory Representation'}</span>
