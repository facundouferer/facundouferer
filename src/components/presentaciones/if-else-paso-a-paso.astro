---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="ie-screen">
	<div class="ie-shell">
		<header class="ie-header">
			<span class="ie-badge">{isEs ? 'Bifurcaciones de Flujo' : 'Branching Flow'}</span>
			<h1 class="ie-title">
				{isEs ? 'If-Else y Else-If Paso a Paso' : 'If-Else and Else-If Step by Step'}
			</h1>
			<p class="ie-sub">
				{isEs 
					? 'Ramificación alternativa y cadenas relacionales en C, JavaScript, Python y Java.' 
					: 'Alternative branching and relational chains in C, JavaScript, Python, and Java.'}
			</p>
		</header>

		<div class="ie-deck-card">
			<div class="ie-nav-bar">
				<div class="ie-slide-indicator">
					<span class="ie-step-dot"></span>
					<span id="ie-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="ie-pills">
					<button class="ie-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="ie-pill-btn" data-target-slide="2">2. C</button>
					<button class="ie-pill-btn" data-target-slide="3">3. Java</button>
					<button class="ie-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="ie-pill-btn" data-target-slide="5">5. Python</button>
					<button class="ie-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="ie-viewport">
				<div class="ie-slide active" data-slide="1">
					<div class="ie-slide-grid">
						<div class="ie-col">
							<h2 class="ie-slide-title">1. {isEs ? 'Ramificación Alternativa (If-Else)' : 'Alternative Branching (If-Else)'}</h2>
							<p class="ie-text">
								{isEs 
									? 'La estructura `if-else` garantiza que exactamente un único bloque de código se ejecute según si la condición es verdadera o falsa.'
									: 'The `if-else` structure guarantees that exactly one code block executes depending on true/false evaluation.'}
							</p>
						</div>
						<div class="ie-col">
							<div class="ie-card-box">
								<div class="ie-card-head">{isEs ? 'FLUJO MUTUAMENTE EXCLUYENTE' : 'MUTUALLY EXCLUSIVE FLOW'}</div>
								<div class="ie-cell"><span>Condición True</span><span class="ie-tag">Ejecuta bloque IF</span></div>
								<div class="ie-cell"><span>Condición False</span><span class="ie-tag">Ejecuta bloque ELSE</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="ie-slide" data-slide="2">
					<div class="ie-slide-grid">
						<div class="ie-col">
							<h2 class="ie-slide-title">2. C: else if</h2>
							<p class="ie-text">En C las cadenas de else-if evalúan secuencialmente hasta encontrar el primer match verdadero.</p>
						</div>
						<div class="ie-col">
							<div class="ie-code-card">
								<div class="ie-code-title">if_else.c</div>
								<pre class="ie-code-block"><code><span class="token-type">int</span> nota = <span class="token-number">85</span>;
<span class="token-keyword">if</span> (nota &gt;= <span class="token-number">90</span>) &#123;
    printf(<span class="token-string">"A\n"</span>);
&#125; <span class="token-keyword">else if</span> (nota &gt;= <span class="token-number">80</span>) &#123;
    printf(<span class="token-string">"B\n"</span>); <span class="token-comment">// Match</span>
&#125; <span class="token-keyword">else</span> &#123;
    printf(<span class="token-string">"C\n"</span>);
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="ie-slide" data-slide="3">
					<div class="ie-slide-grid">
						<div class="ie-col">
							<h2 class="ie-slide-title">3. Java: Operador Ternario</h2>
							<p class="ie-text">Java permite el operador ternario `condicion ? valTrue : valFalse` como expresión que retorna un valor.</p>
						</div>
						<div class="ie-col">
							<div class="ie-code-card">
								<div class="ie-code-title">Ternary.java</div>
								<pre class="ie-code-block"><code><span class="token-type">int</span> edad = <span class="token-number">20</span>;
String estado = (edad &gt;= <span class="token-number">18</span>) ? <span class="token-string">"Mayor"</span> : <span class="token-string">"Menor"</span>;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="ie-slide" data-slide="4">
					<div class="ie-slide-grid">
						<div class="ie-col">
							<h2 class="ie-slide-title">4. JavaScript: Short-Circuit</h2>
							<p class="ie-text">JS usa cortocircuito con `&&` y `||` como alternativas concisas a estructuras `if-else` tradicionales.</p>
						</div>
						<div class="ie-col">
							<div class="ie-code-card">
								<div class="ie-code-title">short_circuit.js</div>
								<pre class="ie-code-block"><code><span class="token-keyword">const</span> usuario = &#123; nombre: <span class="token-string">"Ana"</span> &#125;;
<span class="token-keyword">const</span> nombre = usuario &amp;&amp; usuario.nombre; <span class="token-comment">// "Ana"</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="ie-slide" data-slide="5">
					<div class="ie-slide-grid">
						<div class="ie-col">
							<h2 class="ie-slide-title">5. Python: elif</h2>
							<p class="ie-text">Python usa la palabra clave explícita `elif` para encadenar condiciones alternativas con elegancia sintáctica.</p>
						</div>
						<div class="ie-col">
							<div class="ie-code-card">
								<div class="ie-code-title">if_else.py</div>
								<pre class="ie-code-block"><code>score = <span class="token-number">85</span>
<span class="token-keyword">if</span> score &gt;= <span class="token-number">90</span>:
    grade = <span class="token-string">"A"</span>
<span class="token-keyword">elif</span> score &gt;= <span class="token-number">80</span>:
    grade = <span class="token-string">"B"</span>
<span class="token-keyword">else</span>:
    grade = <span class="token-string">"C"</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="ie-slide" data-slide="6">
					<div class="ie-sim-container">
						<h2 class="ie-slide-title center">{isEs ? '6. Evaluador Interactivo de Ramas' : '6. Branching Evaluator'}</h2>
						<p class="ie-sub center">{isEs ? 'Seleccioná un puntaje para simular la rama elegida:' : 'Select a score to simulate the chosen branch:'}</p>

						<div class="ie-sim-selector">
							<button class="ie-score-btn active" data-score="95">Puntaje = 95</button>
							<button class="ie-score-btn" data-score="82">Puntaje = 82</button>
							<button class="ie-score-btn" data-score="60">Puntaje = 60</button>
						</div>

						<div class="ie-inspector-grid">
							<div class="ie-lang-box"><span class="ie-lang-name">C / C++</span><div class="ie-exp-res" id="ie-res-c">Rama elegida: IF (nota &gt;= 90) ➔ Imprime "A"</div></div>
							<div class="ie-lang-box"><span class="ie-lang-name">Java</span><div class="ie-exp-res" id="ie-res-java">Rama elegida: IF (nota &gt;= 90) ➔ Asigna "A"</div></div>
							<div class="ie-lang-box"><span class="ie-lang-name">JavaScript</span><div class="ie-exp-res" id="ie-res-js">Rama elegida: IF (nota &gt;= 90) ➔ Retorna "A"</div></div>
							<div class="ie-lang-box"><span class="ie-lang-name">Python</span><div class="ie-exp-res" id="ie-res-py">Rama elegida: IF (nota &gt;= 90) ➔ grade = "A"</div></div>
						</div>
					</div>
				</div>
			</div>

			<div class="ie-footer">
				<button class="btn btn-secondary" id="btn-prev-ie" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="ie-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-ie">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.ie-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.ie-shell { max-width: var(--container-max); margin: 0 auto; }
	.ie-header { margin-bottom: 1.5rem; }
	.ie-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.ie-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.ie-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.ie-sub.center { text-align: center; }
	.ie-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.ie-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.ie-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.ie-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.ie-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.ie-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.ie-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.ie-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.ie-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.ie-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.ie-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.ie-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.ie-col { grid-column: span 12; }
	@media (min-width: 900px) { .ie-col { grid-column: span 6; } }
	.ie-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.ie-slide-title.center { text-align: center; }
	.ie-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.ie-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.ie-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.ie-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.ie-tag { color: var(--color-accent-700); font-weight: 600; }
	.ie-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.ie-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.ie-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.ie-sim-container { max-width: 800px; margin: 0 auto; }
	.ie-sim-selector { display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 1.2rem; flex-wrap: wrap; }
	.ie-score-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.35rem 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease; }
	.ie-score-btn:hover { background: var(--color-accent-100); color: var(--color-accent-700); }
	.ie-score-btn.active { background: var(--color-accent-700); border-color: var(--color-accent-700); color: #ffffff; }
	.ie-inspector-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
	@media (max-width: 600px) { .ie-inspector-grid { grid-template-columns: repeat(1, minmax(0, 1fr)); } }
	.ie-lang-box { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.8rem; }
	.ie-lang-name { font-family: 'Fira Code', monospace; font-size: 0.75rem; font-weight: 700; color: #e59866; display: block; margin-bottom: 0.4rem; }
	.ie-exp-res { font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #f9f4ed; background: #141210; padding: 0.5rem 0.7rem; border-radius: var(--radius-sm); }
	.ie-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.ie-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const scoreData = {
		95: {
			c: 'Rama elegida: IF (nota >= 90) ➔ Imprime "A"',
			java: 'Rama elegida: IF (nota >= 90) ➔ Asigna "A"',
			js: 'Rama elegida: IF (nota >= 90) ➔ Retorna "A"',
			py: 'Rama elegida: IF (score >= 90) ➔ grade = "A"'
		},
		82: {
			c: 'Rama elegida: ELSE IF (nota >= 80) ➔ Imprime "B"',
			java: 'Rama elegida: ELSE IF (nota >= 80) ➔ Asigna "B"',
			js: 'Rama elegida: ELSE IF (nota >= 80) ➔ Retorna "B"',
			py: 'Rama elegida: ELIF (score >= 80) ➔ grade = "B"'
		},
		60: {
			c: 'Rama elegida: ELSE ➔ Imprime "C"',
			java: 'Rama elegida: ELSE ➔ Asigna "C"',
			js: 'Rama elegida: ELSE ➔ Retorna "C"',
			py: 'Rama elegida: ELSE ➔ grade = "C"'
		}
	};

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.ie-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.ie-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('ie-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-ie') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-ie') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.ie-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-ie')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-ie')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	document.querySelectorAll('.ie-score-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			document.querySelectorAll('.ie-score-btn').forEach(b => b.classList.remove('active'));
			const targetBtn = e.currentTarget as HTMLElement;
			targetBtn.classList.add('active');
			const scoreKey = Number(targetBtn.dataset.score) as keyof typeof scoreData;
			const data = scoreData[scoreKey];
			if (data) {
				const resC = document.getElementById('ie-res-c');
				const resJava = document.getElementById('ie-res-java');
				const resJs = document.getElementById('ie-res-js');
				const resPy = document.getElementById('ie-res-py');
				if (resC) resC.textContent = data.c;
				if (resJava) resJava.textContent = data.java;
				if (resJs) resJs.textContent = data.js;
				if (resPy) resPy.textContent = data.py;
			}
		});
	});

	goToSlide(1);
</script>
