<script>
	let currentSlide = 1;
	const totalSlides = 7;

	const prevBtn = document.getElementById('apPrevBtn') as HTMLButtonElement;
	const nextBtn = document.getElementById('apNextBtn') as HTMLButtonElement;
	const counter = document.getElementById('apSlideCounter') as HTMLElement;
	const slides = document.querySelectorAll<HTMLElement>('.ap-slide');

	function updateSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;
		slides.forEach((s) => s.classList.remove('is-active'));
		document.querySelector(`.ap-slide[data-slide="${currentSlide}"]`)?.classList.add('is-active');

		if (counter) counter.textContent = `${currentSlide} / ${totalSlides}`;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	prevBtn?.addEventListener('click', () => updateSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => updateSlide(currentSlide + 1));

	// Slide 1: Charset toggler
	const utf8Btn = document.getElementById('apUtf8Btn');
	const isoBtn = document.getElementById('apIsoBtn');
	const encodingResult = document.getElementById('apEncodingResult');

	utf8Btn?.addEventListener('click', () => {
		utf8Btn.classList.add('is-active');
		isoBtn?.classList.remove('is-active');
		if (encodingResult) {
			encodingResult.innerHTML = `
				<span class="ap-code-sample">Canción</span>
				<span class="ap-tag-ok">✓ Decodificación Correcta (2 bytes para 'ó' interpretados como 1 char)</span>
			`;
		}
	});

	isoBtn?.addEventListener('click', () => {
		isoBtn.classList.add('is-active');
		utf8Btn?.classList.remove('is-active');
		if (encodingResult) {
			encodingResult.innerHTML = `
				<span class="ap-code-sample" style="color: var(--color-accent);">CanciÃ³n</span>
				<span class="ap-tag-err">⚠ Fallo de Encoding: Bytes de UTF-8 forzados en ISO-8859-1</span>
			`;
		}
	});

	// Slide 2: Buffer toggle
	const toggleBuffer = document.getElementById('apToggleBuffer') as HTMLInputElement;
	const bufferLayer = document.getElementById('apBufferLayer');
	const bufferTitle = document.getElementById('apBufferTitle');
	const perfBar = document.getElementById('apPerfBar');
	const perfStats = document.getElementById('apPerfStats');
	const perfExplanation = document.getElementById('apPerfExplanation');

	toggleBuffer?.addEventListener('change', () => {
		const isChecked = toggleBuffer.checked;
		if (isChecked) {
			bufferLayer?.classList.remove('is-off');
			if (bufferTitle) bufferTitle.style.display = 'block';
			if (perfBar) {
				perfBar.className = 'ap-bar-fill ap-bar-fast';
				perfBar.style.width = '95%';
			}
			if (perfStats) {
				perfStats.innerHTML = `
					<span>Llamadas a Disco: 2 llamadas</span>
					<strong class="ap-text-accent">1.8 ms (¡Ultra Rápido!)</strong>
				`;
			}
			if (perfExplanation) {
				perfExplanation.textContent = 'El buffer acumula 8192 bytes en RAM en una sola llamada al kernel. Las siguientes 8191 lecturas se resuelven en memoria.';
			}
		} else {
			bufferLayer?.classList.add('is-off');
			if (bufferTitle) bufferTitle.style.display = 'none';
			if (perfBar) {
				perfBar.className = 'ap-bar-fill ap-bar-slow';
				perfBar.style.width = '12%';
			}
			if (perfStats) {
				perfStats.innerHTML = `
					<span>Llamadas a Disco: 10.000 llamadas</span>
					<strong class="ap-text-accent">450.0 ms (¡Extremadamente Lento!)</strong>
				`;
			}
			if (perfExplanation) {
				perfExplanation.textContent = 'Sin buffer: cada byte leído ejecuta una interrupción y syscall al kernel del sistema operativo para leer el disco físico.';
			}
		}
	});
</script>
