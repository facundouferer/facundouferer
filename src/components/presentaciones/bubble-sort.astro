---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="bs-screen">
	<div class="bs-shell">
		<header class="bs-header">
			<span class="bs-badge">{isEs ? 'Algoritmos de Ordenamiento' : 'Sorting Algorithms'}</span>
			<h1 class="bs-title">
				{isEs ? 'Bubble Sort (Burbuja) Paso a Paso' : 'Bubble Sort Step by Step'}
			</h1>
			<p class="bs-sub">
				{isEs 
					? 'Comparación de adyacentes, burbujeo y complejidad O(N²) en C, Java, JavaScript y Python.' 
					: 'Adjacent comparison, bubbling, and O(N²) complexity in C, Java, JS, and Python.'}
			</p>
		</header>

		<div class="bs-deck-card">
			<div class="bs-nav-bar">
				<div class="bs-slide-indicator">
					<span class="bs-step-dot"></span>
					<span id="bs-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="bs-pills">
					<button class="bs-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="bs-pill-btn" data-target-slide="2">2. C</button>
					<button class="bs-pill-btn" data-target-slide="3">3. Java</button>
					<button class="bs-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="bs-pill-btn" data-target-slide="5">5. Python</button>
					<button class="bs-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="bs-viewport">
				<div class="bs-slide active" data-slide="1">
					<div class="bs-slide-grid">
						<div class="bs-col">
							<h2 class="bs-slide-title">1. {isEs ? 'Mecánica de Burbujeo' : 'Bubbling Mechanics'}</h2>
							<p class="bs-text">
								{isEs 
									? 'Bubble Sort compara pares de elementos adyacentes e intercambia sus posiciones si están en orden incorrecto. El elemento mayor "burbujea" hasta el final de la lista en cada pasada.'
									: 'Bubble Sort repeatedly compares adjacent elements swapping them if out of order. The largest element bubbles up to the end in each pass.'}
							</p>
						</div>
						<div class="bs-col">
							<div class="bs-card-box">
								<div class="bs-card-head">{isEs ? 'ANÁLISIS ALGORÍTMICO' : 'ALGORITHMIC ANALYSIS'}</div>
								<div class="bs-cell"><span>Peor Caso / Promedio</span><span class="bs-tag">O(N²)</span></div>
								<div class="bs-cell"><span>Mejor Caso (Optimizado con flag)</span><span class="bs-tag">O(N)</span></div>
								<div class="bs-cell"><span>Espacio Auxiliar</span><span class="bs-tag">O(1) in-place</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="bs-slide" data-slide="2">
					<div class="bs-slide-grid">
						<div class="bs-col">
							<h2 class="bs-slide-title">2. C: Bubble Sort In-Place</h2>
							<p class="bs-text">Implementación clásica con punteros o arreglos y variable auxiliar de swap.</p>
						</div>
						<div class="bs-col">
							<div class="bs-code-card">
								<div class="bs-code-title">bubble.c</div>
								<pre class="bs-code-block"><code><span class="token-keyword">void</span> bubbleSort(<span class="token-type">int</span> arr[], <span class="token-type">int</span> n) &#123;
    <span class="token-keyword">for</span> (<span class="token-type">int</span> i = <span class="token-number">0</span>; i &lt; n - <span class="token-number">1</span>; i++) &#123;
        <span class="token-keyword">for</span> (<span class="token-type">int</span> j = <span class="token-number">0</span>; j &lt; n - i - <span class="token-number">1</span>; j++) &#123;
            <span class="token-keyword">if</span> (arr[j] &gt; arr[j + <span class="token-number">1</span>]) &#123;
                <span class="token-type">int</span> temp = arr[j];
                arr[j] = arr[j + <span class="token-number">1</span>];
                arr[j + <span class="token-number">1</span>] = temp;
            &#125;
        &#125;
    &#125;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="bs-slide" data-slide="3">
					<div class="bs-slide-grid">
						<div class="bs-col">
							<h2 class="bs-slide-title">3. Java: Optimización con Flag swapped</h2>
							<p class="bs-text">Si en una pasada no se realiza ningún intercambio, el arreglo ya está ordenado y podemos cortar tempranamente.</p>
						</div>
						<div class="bs-col">
							<div class="bs-code-card">
								<div class="bs-code-title">BubbleSort.java</div>
								<pre class="bs-code-block"><code><span class="token-keyword">public static void</span> bubbleSort(<span class="token-type">int</span>[] arr) &#123;
    <span class="token-type">boolean</span> swapped;
    <span class="token-keyword">for</span> (<span class="token-type">int</span> i = <span class="token-number">0</span>; i &lt; arr.length - <span class="token-number">1</span>; i++) &#123;
        swapped = <span class="token-keyword">false</span>;
        <span class="token-keyword">for</span> (<span class="token-type">int</span> j = <span class="token-number">0</span>; j &lt; arr.length - i - <span class="token-number">1</span>; j++) &#123;
            <span class="token-keyword">if</span> (arr[j] &gt; arr[j + <span class="token-number">1</span>]) &#123;
                <span class="token-type">int</span> tmp = arr[j]; arr[j] = arr[j+<span class="token-number">1</span>]; arr[j+<span class="token-number">1</span>] = tmp;
                swapped = <span class="token-keyword">true</span>;
            &#125;
        &#125;
        <span class="token-keyword">if</span> (!swapped) <span class="token-keyword">break</span>;
    &#125;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="bs-slide" data-slide="4">
					<div class="bs-slide-grid">
						<div class="bs-col">
							<h2 class="bs-slide-title">4. JavaScript: Destructuring Swap</h2>
							<p class="bs-text">JS permite intercambiar dos posiciones usando sintaxis de desestructuración `[a, b] = [b, a]`.</p>
						</div>
						<div class="bs-col">
							<div class="bs-code-card">
								<div class="bs-code-title">bubble.js</div>
								<pre class="bs-code-block"><code><span class="token-keyword">function</span> bubbleSort(arr) &#123;
    <span class="token-keyword">const</span> n = arr.length;
    <span class="token-keyword">for</span> (<span class="token-keyword">let</span> i = <span class="token-number">0</span>; i &lt; n - <span class="token-number">1</span>; i++) &#123;
        <span class="token-keyword">for</span> (<span class="token-keyword">let</span> j = <span class="token-number">0</span>; j &lt; n - i - <span class="token-number">1</span>; j++) &#123;
            <span class="token-keyword">if</span> (arr[j] &gt; arr[j + <span class="token-number">1</span>]) &#123;
                [arr[j], arr[j + <span class="token-number">1</span>]] = [arr[j + <span class="token-number">1</span>], arr[j]];
            &#125;
        &#125;
    &#125;
    <span class="token-keyword">return</span> arr;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="bs-slide" data-slide="5">
					<div class="bs-slide-grid">
						<div class="bs-col">
							<h2 class="bs-slide-title">5. Python: Tuple Swapping</h2>
							<p class="bs-text">Python realiza el intercambio de elementos en una sola línea `arr[j], arr[j+1] = arr[j+1], arr[j]`.</p>
						</div>
						<div class="bs-col">
							<div class="bs-code-card">
								<div class="bs-code-title">bubble.py</div>
								<pre class="bs-code-block"><code><span class="token-keyword">def</span> bubble_sort(arr):
    n = len(arr)
    <span class="token-keyword">for</span> i <span class="token-keyword">in</span> range(n - <span class="token-number">1</span>):
        <span class="token-keyword">for</span> j <span class="token-keyword">in</span> range(n - i - <span class="token-number">1</span>):
            <span class="token-keyword">if</span> arr[j] &gt; arr[j + <span class="token-number">1</span>]:
                arr[j], arr[j + <span class="token-number">1</span>] = arr[j + <span class="token-number">1</span>], arr[j]
    <span class="token-keyword">return</span> arr</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="bs-slide" data-slide="6">
					<div class="bs-sim-container">
						<h2 class="bs-slide-title center">{isEs ? '6. Simulador' : '6. Simulator'}</h2>
						<p class="bs-sub center">{isEs ? 'Visualización espacial 3D del burbujeo de barras en tiempo real:' : 'Real-time 3D spatial visualization of bubbling bars:'}</p>

						<div class="bs-3d-wrapper">
							<div id="three-bubble-container" class="bs-three-canvas-container"></div>
							
							<div class="bs-sim-console">
								<div class="bs-sim-head">
									<span class="bs-console-label" id="bs-3d-array-label">Array: [5, 2, 8, 1, 4]</span>
								</div>
								<div class="bs-sim-body">
									<div class="bs-trace-step" id="bs-sim-step">Hacé clic en "Siguiente Paso" o "Auto Play" para iniciar el ordenamiento 3D.</div>
									<div class="bs-stack-display" id="bs-sim-state">Estado: Listo</div>
								</div>
								<div class="bs-sim-actions">
									<button class="btn btn-secondary" id="btn-shuffle-bs">🔀 {isEs ? 'Mezclar' : 'Shuffle'}</button>
									<button class="btn btn-secondary" id="btn-autoplay-bs">▶ {isEs ? 'Auto Play' : 'Auto Play'}</button>
									<button class="btn btn-primary" id="btn-next-bs-step">⏭ {isEs ? 'Siguiente Paso' : 'Next Step'}</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="bs-footer">
				<button class="btn btn-secondary" id="btn-prev-bs" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="bs-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-bs">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.bs-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.bs-shell { max-width: var(--container-max); margin: 0 auto; }
	.bs-header { margin-bottom: 1.5rem; }
	.bs-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.bs-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.bs-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.bs-sub.center { text-align: center; }
	.bs-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.bs-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.bs-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.bs-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.bs-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.bs-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.bs-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.bs-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.bs-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.bs-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.bs-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.bs-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.bs-col { grid-column: span 12; }
	@media (min-width: 900px) { .bs-col { grid-column: span 6; } }
	.bs-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.bs-slide-title.center { text-align: center; }
	.bs-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.bs-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.bs-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.bs-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.bs-tag { color: var(--color-accent-700); font-weight: 600; }
	.bs-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.bs-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.bs-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.bs-sim-container { max-width: 840px; margin: 0 auto; }
	.bs-3d-wrapper { display: flex; flex-direction: column; gap: 1rem; }
	.bs-three-canvas-container { width: 100%; height: 280px; background: #181512; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-md); position: relative; }
	.bs-sim-console { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-md); }
	.bs-sim-head { background: #2b2722; padding: 0.5rem 0.8rem; }
	.bs-console-label { color: #c0b6a5; font-family: 'Fira Code', monospace; font-size: 0.75rem; }
	.bs-sim-body { padding: 1rem; display: flex; flex-direction: column; gap: 0.8rem; }
	.bs-trace-step { font-size: 0.88rem; line-height: 1.5; color: #f9f4ed; background: #2a2520; padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); }
	.bs-stack-display { font-family: 'Fira Code', monospace; font-size: 0.8rem; color: #76d7c4; background: #141210; padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); }
	.bs-sim-actions { padding: 0.8rem 1rem; background: #25211d; display: flex; justify-content: flex-end; gap: 0.5rem; flex-wrap: wrap; border-top: 1px solid #3a352e; }
	.bs-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.bs-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	import * as THREE from 'three';

	let currentSlide = 1;
	const totalSlides = 6;

	// Slide Navigation Logic
	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.bs-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.bs-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('bs-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-bs') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-bs') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;

		if (currentSlide === 6) {
			initThreeScene();
		}
	};

	document.querySelectorAll('.bs-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-bs')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-bs')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	// --- THREE.JS BUBBLE SORT 3D ENGINE ---
	let scene: THREE.Scene, camera: THREE.PerspectiveCamera, renderer: THREE.WebGLRenderer;
	let barMeshes: THREE.Mesh[] = [];
	let isSceneInitialized = false;
	let autoPlayInterval: number | null = null;

	let arrayData = [5, 2, 8, 1, 4];
	let iIdx = 0;
	let jIdx = 0;
	let isSorted = false;

	const COLOR_NEUTRAL = 0xebddc5;  // Warm Cream / Organic surface
	const COLOR_COMPARE_J = 0xc67139; // Organic Terracota Accent
	const COLOR_COMPARE_J1 = 0x7a8a5e; // Organic Sabia Accent 2
	const COLOR_SORTED = 0x5b9b73;    // Sealed Green

	const initThreeScene = () => {
		const container = document.getElementById('three-bubble-container');
		if (!container || isSceneInitialized) return;

		isSceneInitialized = true;
		const width = container.clientWidth || 700;
		const height = container.clientHeight || 280;

		// 1. Scene & Camera
		scene = new THREE.Scene();
		scene.background = new THREE.Color(0x181512);

		camera = new THREE.PerspectiveCamera(45, width / height, 0.1, 1000);
		camera.position.set(0, 5.5, 9);
		camera.lookAt(0, 1.2, 0);

		// 2. Lights
		const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
		scene.add(ambientLight);

		const dirLight = new THREE.DirectionalLight(0xffffff, 0.9);
		dirLight.position.set(5, 10, 7);
		dirLight.castShadow = true;
		scene.add(dirLight);

		// 3. Ground plane
		const groundGeo = new THREE.PlaneGeometry(16, 8);
		const groundMat = new THREE.MeshStandardMaterial({ color: 0x221e1a, roughness: 0.8 });
		const ground = new THREE.Mesh(groundGeo, groundMat);
		ground.rotation.x = -Math.PI / 2;
		ground.position.y = 0;
		scene.add(ground);

		// 4. Renderer
		renderer = new THREE.WebGLRenderer({ antialias: true });
		renderer.setSize(width, height);
		renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
		renderer.shadowMap.enabled = true;
		container.appendChild(renderer.domElement);

		// 5. Create 3D Bars
		buildBars();

		// 6. Animation Loop
		const animate = () => {
			requestAnimationFrame(animate);
			// Smooth position interpolation for bars
			barMeshes.forEach((mesh, index) => {
				const targetX = (index - (arrayData.length - 1) / 2) * 1.3;
				mesh.position.x += (targetX - mesh.position.x) * 0.15;
			});
			renderer.render(scene, camera);
		};
		animate();

		// Handle Window Resize
		window.addEventListener('resize', () => {
			if (!container) return;
			const w = container.clientWidth;
			const h = container.clientHeight;
			camera.aspect = w / h;
			camera.updateProjectionMatrix();
			renderer.setSize(w, h);
		});
	};

	const buildBars = () => {
		// Remove existing bars
		barMeshes.forEach(mesh => scene.remove(mesh));
		barMeshes = [];

		const spacing = 1.3;

		arrayData.forEach((val, index) => {
			const height = val * 0.55;
			const geo = new THREE.BoxGeometry(0.85, height, 0.85);
			const mat = new THREE.MeshStandardMaterial({
				color: COLOR_NEUTRAL,
				roughness: 0.35,
				metalness: 0.1
			});
			const mesh = new THREE.Mesh(geo, mat);
			mesh.position.x = (index - (arrayData.length - 1) / 2) * spacing;
			mesh.position.y = height / 2;
			mesh.position.z = 0;
			mesh.castShadow = true;
			mesh.receiveShadow = true;

			scene.add(mesh);
			barMeshes.push(mesh);
		});

		updateLabels(`Array actual: [${arrayData.join(', ')}]`, `Estado: Listo para iniciar`, `Hacé clic en "Siguiente Paso"`);
	};

	const highlightBars = () => {
		barMeshes.forEach((mesh, idx) => {
			const mat = mesh.material as THREE.MeshStandardMaterial;
			if (isSorted || idx >= arrayData.length - iIdx) {
				mat.color.setHex(COLOR_SORTED);
			} else if (idx === jIdx) {
				mat.color.setHex(COLOR_COMPARE_J);
			} else if (idx === jIdx + 1) {
				mat.color.setHex(COLOR_COMPARE_J1);
			} else {
				mat.color.setHex(COLOR_NEUTRAL);
			}
		});
	};

	const stepBubbleSort = () => {
		if (isSorted) return;

		const n = arrayData.length;
		if (iIdx < n - 1) {
			if (jIdx < n - iIdx - 1) {
				const valA = arrayData[jIdx];
				const valB = arrayData[jIdx + 1];

				highlightBars();

				if (valA > valB) {
					// Swap in array data
					arrayData[jIdx] = valB;
					arrayData[jIdx + 1] = valA;

					// Swap 3D meshes reference
					const tempMesh = barMeshes[jIdx];
					barMeshes[jIdx] = barMeshes[jIdx + 1];
					barMeshes[jIdx + 1] = tempMesh;

					updateLabels(
						`Array: [${arrayData.join(', ')}]`,
						`Pasada i=${iIdx}, j=${jIdx}`,
						`Comparar ${valA} > ${valB} ➔ SWAP de posiciones`
					);
				} else {
					updateLabels(
						`Array: [${arrayData.join(', ')}]`,
						`Pasada i=${iIdx}, j=${jIdx}`,
						`Comparar ${valA} <= ${valB} ➔ Mantener orden`
					);
				}

				jIdx++;
			} else {
				jIdx = 0;
				iIdx++;
				if (iIdx >= n - 1) {
					isSorted = true;
					highlightBars();
					updateLabels(
						`Array Final: [${arrayData.join(', ')}]`,
						`¡Ordenamiento Completado!`,
						`Todas las barras se encuentran ordenadas.`
					);
					if (autoPlayInterval) {
						clearInterval(autoPlayInterval);
						autoPlayInterval = null;
					}
				}
			}
		}
	};

	const updateLabels = (arrayStr: string, stateStr: string, stepStr: string) => {
		const arrLabel = document.getElementById('bs-3d-array-label');
		const stateLabel = document.getElementById('bs-sim-state');
		const stepLabel = document.getElementById('bs-sim-step');
		if (arrLabel) arrLabel.textContent = arrayStr;
		if (stateLabel) stateLabel.textContent = stateStr;
		if (stepLabel) stepLabel.textContent = stepStr;
	};

	// Button Listeners
	document.getElementById('btn-next-bs-step')?.addEventListener('click', stepBubbleSort);

	document.getElementById('btn-shuffle-bs')?.addEventListener('click', () => {
		if (autoPlayInterval) {
			clearInterval(autoPlayInterval);
			autoPlayInterval = null;
		}
		arrayData = [Math.floor(Math.random() * 8) + 2, Math.floor(Math.random() * 8) + 2, Math.floor(Math.random() * 8) + 2, Math.floor(Math.random() * 8) + 2, Math.floor(Math.random() * 8) + 2];
		iIdx = 0;
		jIdx = 0;
		isSorted = false;
		if (isSceneInitialized) buildBars();
	});

	document.getElementById('btn-autoplay-bs')?.addEventListener('click', () => {
		if (autoPlayInterval) {
			clearInterval(autoPlayInterval);
			autoPlayInterval = null;
		} else {
			autoPlayInterval = window.setInterval(stepBubbleSort, 600);
		}
	});

	goToSlide(1);
</script>
