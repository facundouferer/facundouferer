---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="ss-screen">
	<div class="ss-shell">
		<header class="ss-header">
			<span class="ss-badge">{isEs ? 'Algoritmos de Ordenamiento' : 'Sorting Algorithms'}</span>
			<h1 class="ss-title">
				{isEs ? 'Selection Sort (Selección) Paso a Paso' : 'Selection Sort Step by Step'}
			</h1>
			<p class="ss-sub">
				{isEs 
					? 'Búsqueda del mínimo, intercambios mínimos (N-1) en C, Java, JavaScript y Python.' 
					: 'Minimum element lookup, minimal swaps (N-1) in C, Java, JS, and Python.'}
			</p>
		</header>

		<div class="ss-deck-card">
			<div class="ss-nav-bar">
				<div class="ss-slide-indicator">
					<span class="ss-step-dot"></span>
					<span id="ss-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="ss-pills">
					<button class="ss-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="ss-pill-btn" data-target-slide="2">2. C</button>
					<button class="ss-pill-btn" data-target-slide="3">3. Java</button>
					<button class="ss-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="ss-pill-btn" data-target-slide="5">5. Python</button>
					<button class="ss-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="ss-viewport">
				<div class="ss-slide active" data-slide="1">
					<div class="ss-slide-grid">
						<div class="ss-col">
							<h2 class="ss-slide-title">1. {isEs ? 'Mecánica de Selección del Mínimo' : 'Minimum Selection Mechanics'}</h2>
							<p class="ss-text">
								{isEs 
									? 'Selection Sort divide la lista en dos partes: la sublista ordenada y la desordenada. En cada paso busca el elemento mínimo de la parte desordenada y lo intercambia con la primera posición disponible.'
									: 'Selection Sort divides the list into sorted and unsorted sublists. In each step it finds the minimum in the unsorted part and swaps it to the front.'}
							</p>
						</div>
						<div class="ss-col">
							<div class="ss-card-box">
								<div class="ss-card-head">{isEs ? 'ANÁLISIS ALGORÍTMICO' : 'ALGORITHMIC ANALYSIS'}</div>
								<div class="ss-cell"><span>Comparaciones</span><span class="ss-tag">O(N²) siempre</span></div>
								<div class="ss-cell"><span>Intercambios (Swaps)</span><span class="ss-tag">O(N) máximo (exactamente N-1)</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="ss-slide" data-slide="2">
					<div class="ss-slide-grid">
						<div class="ss-col">
							<h2 class="ss-slide-title">2. C: Selection Sort</h2>
							<p class="ss-text">Ideal cuando el costo de escritura en memoria/flash es alto, ya que realiza como máximo `N-1` escrituras.</p>
						</div>
						<div class="ss-col">
							<div class="ss-code-card">
								<div class="ss-code-title">selection.c</div>
								<pre class="ss-code-block"><code><span class="token-keyword">void</span> selectionSort(<span class="token-type">int</span> arr[], <span class="token-type">int</span> n) &#123;
    <span class="token-keyword">for</span> (<span class="token-type">int</span> i = <span class="token-number">0</span>; i &lt; n - <span class="token-number">1</span>; i++) &#123;
        <span class="token-type">int</span> minIdx = i;
        <span class="token-keyword">for</span> (<span class="token-type">int</span> j = i + <span class="token-number">1</span>; j &lt; n; j++) &#123;
            <span class="token-keyword">if</span> (arr[j] &lt; arr[minIdx]) minIdx = j;
        &#125;
        <span class="token-type">int</span> temp = arr[minIdx];
        arr[minIdx] = arr[i];
        arr[i] = temp;
    &#125;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="ss-slide" data-slide="3">
					<div class="ss-slide-grid">
						<div class="ss-col">
							<h2 class="ss-slide-title">3. Java: Selección con Búsqueda de Mínimo</h2>
							<p class="ss-text">Mantiene `minIdx` actualizado durante el bucle interno antes de llamar a la rutina de swap.</p>
						</div>
						<div class="ss-col">
							<div class="ss-code-card">
								<div class="ss-code-title">SelectionSort.java</div>
								<pre class="ss-code-block"><code><span class="token-keyword">public static void</span> sort(<span class="token-type">int</span>[] arr) &#123;
    <span class="token-keyword">for</span> (<span class="token-type">int</span> i = <span class="token-number">0</span>; i &lt; arr.length - <span class="token-number">1</span>; i++) &#123;
        <span class="token-type">int</span> min = i;
        <span class="token-keyword">for</span> (<span class="token-type">int</span> j = i + <span class="token-number">1</span>; j &lt; arr.length; j++) &#123;
            <span class="token-keyword">if</span> (arr[j] &lt; arr[min]) min = j;
        &#125;
        <span class="token-type">int</span> t = arr[min]; arr[min] = arr[i]; arr[i] = t;
    &#125;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="ss-slide" data-slide="4">
					<div class="ss-slide-grid">
						<div class="ss-col">
							<h2 class="ss-slide-title">4. JavaScript: Selection Sort</h2>
							<p class="ss-text">Implemetación directa en JS manteniendo legibilidad en el seguimiento de índices.</p>
						</div>
						<div class="ss-col">
							<div class="ss-code-card">
								<div class="ss-code-title">selection.js</div>
								<pre class="ss-code-block"><code><span class="token-keyword">function</span> selectionSort(arr) &#123;
    <span class="token-keyword">for</span> (<span class="token-keyword">let</span> i = <span class="token-number">0</span>; i &lt; arr.length - <span class="token-number">1</span>; i++) &#123;
        <span class="token-keyword">let</span> min = i;
        <span class="token-keyword">for</span> (<span class="token-keyword">let</span> j = i + <span class="token-number">1</span>; j &lt; arr.length; j++) &#123;
            <span class="token-keyword">if</span> (arr[j] &lt; arr[min]) min = j;
        &#125;
        <span class="token-keyword">if</span> (min !== i) [arr[i], arr[min]] = [arr[min], arr[i]];
    &#125;
    <span class="token-keyword">return</span> arr;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="ss-slide" data-slide="5">
					<div class="ss-slide-grid">
						<div class="ss-col">
							<h2 class="ss-slide-title">5. Python: Selection Sort</h2>
							<p class="ss-text">En Python el ordenamiento in-place por selección reduce las escrituras en la estructura.</p>
						</div>
						<div class="ss-col">
							<div class="ss-code-card">
								<div class="ss-code-title">selection.py</div>
								<pre class="ss-code-block"><code><span class="token-keyword">def</span> selection_sort(arr):
    n = len(arr)
    <span class="token-keyword">for</span> i <span class="token-keyword">in</span> range(n - <span class="token-number">1</span>):
        min_idx = i
        <span class="token-keyword">for</span> j <span class="token-keyword">in</span> range(i + <span class="token-number">1</span>, n):
            <span class="token-keyword">if</span> arr[j] &lt; arr[min_idx]:
                min_idx = j
        arr[i], arr[min_idx] = arr[min_idx], arr[i]
    <span class="token-keyword">return</span> arr</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="ss-slide" data-slide="6">
					<div class="ss-sim-container">
						<h2 class="ss-slide-title center">{isEs ? '6. Inspector de Selección de Mínimo' : '6. Minimum Inspector'}</h2>
						<div class="ss-inspector-grid">
							<div class="ss-lang-box"><span class="ss-lang-name">Array: [29, 10, 14]</span><div class="ss-exp-res">Busca mínimo ➔ 10 (pos 1) ➔ Swap con pos 0 ➔ [10, 29, 14]</div></div>
						</div>
					</div>
				</div>
			</div>

			<div class="ss-footer">
				<button class="btn btn-secondary" id="btn-prev-ss" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="ss-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-ss">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.ss-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.ss-shell { max-width: var(--container-max); margin: 0 auto; }
	.ss-header { margin-bottom: 1.5rem; }
	.ss-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.ss-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.ss-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.ss-sub.center { text-align: center; }
	.ss-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.ss-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.ss-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.ss-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.ss-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.ss-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.ss-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.ss-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.ss-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.ss-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.ss-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.ss-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.ss-col { grid-column: span 12; }
	@media (min-width: 900px) { .ss-col { grid-column: span 6; } }
	.ss-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.ss-slide-title.center { text-align: center; }
	.ss-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.ss-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.ss-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.ss-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.ss-tag { color: var(--color-accent-700); font-weight: 600; }
	.ss-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.ss-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.ss-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.ss-sim-container { max-width: 800px; margin: 0 auto; }
	.ss-inspector-grid { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 0.8rem; }
	.ss-lang-box { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.8rem; }
	.ss-lang-name { font-family: 'Fira Code', monospace; font-size: 0.75rem; font-weight: 700; color: #e59866; display: block; margin-bottom: 0.4rem; }
	.ss-exp-res { font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #f9f4ed; background: #141210; padding: 0.5rem 0.7rem; border-radius: var(--radius-sm); }
	.ss-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.ss-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.ss-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.ss-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('ss-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-ss') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-ss') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.ss-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-ss')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-ss')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	goToSlide(1);
</script>
