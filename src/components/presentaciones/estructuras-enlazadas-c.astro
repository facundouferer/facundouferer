	.le-step-label { font-size: 13px; font-weight: 700; color: var(--color-neutral-600); }

	.le-explain {
		margin: var(--space-3) 0 0;
		max-width: 80ch;
		font-size: 15px;
		line-height: 1.55;
	}

	.le-note {
		padding: 0 var(--space-8) var(--space-4);
		margin: 0;
		font-size: 12px;
		color: var(--color-neutral-600);
	}

	.le-options {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}

	.le-opt {
		padding: var(--space-2) var(--space-4);
		font-family: var(--font-body);
		font-size: 14px;
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-divider);
		border-radius: 999px;
		cursor: pointer;
	}

	.le-opt:hover:not(:disabled) { border-color: var(--color-accent); color: var(--color-accent-700); }
	.le-opt:disabled { cursor: default; }
	.le-opt[aria-pressed='true'] { background: var(--color-accent); border-color: var(--color-accent); color: var(--color-bg); }
	.le-opt.is-right { background: var(--color-accent-2-100); border-color: var(--color-accent-2-700); color: var(--color-accent-2-800); }
	.le-opt.is-wrong { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-800); }

	.le-feedback {
		min-height: 1.5em;
		margin: var(--space-3) 0;
		max-width: 80ch;
		font-size: 15px;
