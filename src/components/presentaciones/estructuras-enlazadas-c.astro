	}

	.le-block-addr { font-family: monospace; font-weight: 700; }
	.le-block-meta { color: var(--color-neutral-600); }

	.le-block-status {
		display: block;
		font-size: 11px;
		font-weight: 700;
		margin-top: var(--space-1);
		color: var(--color-accent-2-700);
	}

	.le-block[data-status='freed'] .le-block-status { color: var(--color-neutral-600); }
	.le-block[data-status='leaked'] .le-block-status { color: var(--color-accent-800); }
	.le-block[data-status='static'] .le-block-status { color: var(--color-neutral-600); }

	.le-block-value {
		font-family: monospace;
		font-size: 14px;
		margin-top: var(--space-1);
	}

	.le-cells { display: flex; gap: var(--space-1); margin-top: var(--space-2); }

	.le-cell {
		min-width: 2.2em;
		padding: var(--space-1);
		text-align: center;
		font-family: monospace;
		font-size: 13px;
		border-radius: var(--radius-sm);
		background: var(--color-surface);
