	}

	.le-score {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: 22px;
		margin: var(--space-4) 0 var(--space-2);
	}

	.le-results {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		padding-left: var(--space-6);
