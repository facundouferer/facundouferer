---
interface Props {
	lang?: string;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
const t = (es: string, en: string) => (isEs ? es : en);

type Kind = 'owner' | 'borrow' | 'dangling' | 'null' | 'value';
type Slot = { name: string; value: string; kind: Kind; target?: string };
type Frame = { label: string; vars: Slot[] };
type Cell = { v: string; out?: boolean };
type Block = {
	id: string;
	addr: string;
	size: string;
	label: string;
	status: 'live' | 'freed' | 'leaked' | 'static';
	owner?: string;
	fields?: Slot[];
	cells?: Cell[];
	value?: string;
};
type Alert = { kind: 'error' | 'leak' | 'ok'; text: string };
type State = { frames: Frame[]; blocks: Block[]; alert?: Alert };
type Step = { lines: number[]; text: string; state: State };

const ptr = (name: string, value: string, kind: Kind, target?: string): Slot => ({ name, value, kind, target });
const val = (name: string, value: string): Slot => ({ name, value, kind: 'value' });
const nul = (name: string): Slot => ({ name, value: 'NULL', kind: 'null' });

/* ---------- Identifiers of the C programs, localized ---------- */

const I = isEs
	? { Node: 'Nodo', value: 'dato', next: 'siguiente', head: 'cabeza', create: 'crear_nodo', front: 'insertar_al_inicio', back: 'insertar_al_final', sorted: 'insertar_ordenado', find: 'buscar', del: 'eliminar', destroy: 'destruir_lista', print: 'imprimir_lista', length: 'longitud', nw: 'nuevo', last: 'ultimo', prev: 'anterior', cur: 'actual', first: 'primero', hit: 'encontrado', none: 'ausente', arr: 'arreglo', count: 'cantidad' }
	: { Node: 'Node', value: 'value', next: 'next', head: 'head', create: 'create_node', front: 'insert_front', back: 'insert_back', sorted: 'insert_sorted', find: 'find', del: 'delete_value', destroy: 'destroy_list', print: 'print_list', length: 'length', nw: 'new_node', last: 'last', prev: 'previous', cur: 'current', first: 'first', hit: 'hit', none: 'none', arr: 'array', count: 'count' };
const { Node: N, value: v, next: nx, head: h, create, front, back, sorted, find, del, destroy, print, length, nw, last, prev, cur, first, hit, none, arr, count } = I;
const nextv = nx;

const hdr = (stdio = false) => String.raw`${stdio ? '#include <stdio.h>\n' : ''}#include <stdlib.h>

typedef struct ${N} {
    int ${v};
    struct ${N} *${nx};
} ${N};

`;

const pCreate = String.raw`${N} *${create}(int ${v}) {
    ${N} *${nw} = malloc(sizeof *${nw});
    if (${nw} == NULL) {
        return NULL;
    }
    ${nw}->${v} = ${v};
    ${nw}->${nx} = NULL;
    return ${nw};
}

`;

const pFront = String.raw`bool ${front}(${N} **${h}, int ${v}) {
    ${N} *${nw} = ${create}(${v});
    if (${nw} == NULL) {
        return false;
    }
    ${nw}->${nx} = *${h};
    *${h} = ${nw};
    return true;
}

`;

const pBack = String.raw`bool ${back}(${N} **${h}, int ${v}) {
    ${N} *${nw} = ${create}(${v});
    if (${nw} == NULL) {
        return false;
    }
    if (*${h} == NULL) {
        *${h} = ${nw};
        return true;
    }
    ${N} *${last} = *${h};
    while (${last}->${nx} != NULL) {
        ${last} = ${last}->${nx};
    }
    ${last}->${nx} = ${nw};
    return true;
}

`;

const pSorted = String.raw`bool ${sorted}(${N} **${h}, int ${v}) {
    ${N} *${nw} = ${create}(${v});
    if (${nw} == NULL) {
        return false;
    }
    if (*${h} == NULL || ${v} <= (*${h})->${v}) {
        ${nw}->${nx} = *${h};
        *${h} = ${nw};
        return true;
    }
    ${N} *${prev} = *${h};
    while (${prev}->${nx} != NULL && ${prev}->${nx}->${v} < ${v}) {
        ${prev} = ${prev}->${nx};
    }
    ${nw}->${nx} = ${prev}->${nx};
    ${prev}->${nx} = ${nw};
    return true;
}

`;

const pFind = String.raw`const ${N} *${find}(const ${N} *${h}, int ${v}) {
    for (const ${N} *${cur} = ${h}; ${cur} != NULL; ${cur} = ${cur}->${nx}) {
        if (${cur}->${v} == ${v}) {
            return ${cur};
        }
    }
    return NULL;
}

`;

const pLength = String.raw`size_t ${length}(const ${N} *${h}) {
    size_t ${count} = 0;
    for (const ${N} *${cur} = ${h}; ${cur} != NULL; ${cur} = ${cur}->${nx}) {
        ${count}++;
    }
    return ${count};
}

`;

const pPrint = String.raw`void ${print}(const ${N} *${h}) {
    for (const ${N} *${cur} = ${h}; ${cur} != NULL; ${cur} = ${cur}->${nx}) {
        printf("%d -> ", ${cur}->${v});
    }
    printf("NULL\n");
}

`;

const pDel = String.raw`bool ${del}(${N} **${h}, int ${v}) {
    ${N} *${cur} = *${h};
    ${N} *${prev} = NULL;
    while (${cur} != NULL && ${cur}->${v} != ${v}) {
        ${prev} = ${cur};
        ${cur} = ${cur}->${nx};
    }
    if (${cur} == NULL) {
        return false;
    }
    if (${prev} == NULL) {
        *${h} = ${cur}->${nx};
    } else {
        ${prev}->${nx} = ${cur}->${nx};
    }
    free(${cur});
    return true;
}

`;

const pDestroy = String.raw`void ${destroy}(${N} **${h}) {
    ${N} *${cur} = *${h};
    while (${cur} != NULL) {
        ${N} *${nextv} = ${cur}->${nx};
        free(${cur});
        ${cur} = ${nextv};
    }
    *${h} = NULL;
}

`;

const fail = String.raw`        ${destroy}(&${h});
        return 1;
    }`;
const end = String.raw`    ${destroy}(&${h});
    return 0;
}`;

const proto = String.raw`${N} *${create}(int ${v});   // ${t('definida en otro archivo', 'defined elsewhere')}

`;

const delMain = (n: number) => String.raw`int main(void) {
    ${N} *${h} = NULL;
    if (!${front}(&${h}, 9) || !${front}(&${h}, 7) || !${front}(&${h}, 3)) {
${fail}
    ${del}(&${h}, ${n});
${end}`;

const programs = {
	first: String.raw`${hdr()}${pCreate}int main(void) {
    ${N} *${h} = NULL;                 // ${t('lista vacía', 'empty list')}
    ${N} *${first} = ${create}(3);
    if (${first} == NULL) {
        return 1;
    }
    ${h} = ${first};                   // ${t('la lista toma el nodo', 'the list takes the node')}
    free(${h});
    return 0;
}`,
	front: String.raw`${hdr()}${pCreate}${pFront}${pDestroy}int main(void) {
    ${N} *${h} = NULL;
    if (!${front}(&${h}, 7) || !${front}(&${h}, 3)) {
${fail}
${end}`,
	back: String.raw`${hdr()}${pCreate}${pBack}${pDestroy}int main(void) {
    ${N} *${h} = NULL;
    if (!${back}(&${h}, 7) || !${back}(&${h}, 9)) {
${fail}
${end}`,
	sorted: String.raw`${hdr()}${pCreate}${pSorted}${pDestroy}int main(void) {
    ${N} *${h} = NULL;
    if (!${sorted}(&${h}, 3) || !${sorted}(&${h}, 9) || !${sorted}(&${h}, 7)) {
${fail}
${end}`,
	find: String.raw`${hdr(true)}${pCreate}${pFront}${pFind}${pLength}${pDestroy}int main(void) {
    ${N} *${h} = NULL;
    if (!${front}(&${h}, 9) || !${front}(&${h}, 7) || !${front}(&${h}, 3)) {
${fail}
    const ${N} *${hit} = ${find}(${h}, 9);
    const ${N} *${none} = ${find}(${h}, 42);
    printf("%zu %d %d\n", ${length}(${h}), ${hit} != NULL, ${none} != NULL);
${end}`,
	del: String.raw`${hdr()}${pCreate}${pFront}${pDel}${pDestroy}${delMain(7)}`,
	delHead: String.raw`${hdr()}${pCreate}${pFront}${pDel}${pDestroy}${delMain(3)}`,
	destroy: String.raw`${hdr()}${pCreate}${pFront}${pDestroy}int main(void) {
    ${N} *${h} = NULL;
    if (!${front}(&${h}, 7) || !${front}(&${h}, 3)) {
${fail}
${end}`,
	compare: String.raw`${hdr()}${pCreate}${pFront}${pDestroy}int main(void) {
    ${N} *${h} = NULL;
    if (!${front}(&${h}, 9) || !${front}(&${h}, 7)) {
${fail}
    int ${arr}[4] = {7, 9};            // ${t('arreglo contiguo', 'contiguous array')}
    size_t ${count} = 2;
    for (size_t i = ${count}; i > 0; i--) {
        ${arr}[i] = ${arr}[i - 1];     // ${t('correr cada elemento', 'shift every element')}
    }
    ${arr}[0] = 3;
    ${count}++;
    if (!${front}(&${h}, 3)) {         // ${t('lista: sin correr nada', 'list: nothing shifts')}
${fail}
${end}`,
	asFront: String.raw`${hdr()}${proto}bool ${front}(${N} **${h}, int ${v}) {
    ${N} *${nw} = ${create}(${v});
    if (${nw} == NULL) {
        return false;
    }
    *${h} = ${nw};
    ${nw}->${nx} = *${h};
    return true;
}`,
	asLeak: String.raw`${hdr()}bool ${del}(${N} **${h}, int ${v}) {
    ${N} *${cur} = *${h};
    ${N} *${prev} = NULL;
    while (${cur} != NULL && ${cur}->${v} != ${v}) {
        ${prev} = ${cur};
        ${cur} = ${cur}->${nx};
    }
    if (${cur} == NULL) {
        return false;
    }
    if (${prev} == NULL) {
        *${h} = ${cur}->${nx};
    } else {
        ${prev}->${nx} = ${cur}->${nx};
    }
    return true;
}`,
	asUaf: String.raw`${hdr()}void ${destroy}(${N} *${h}) {
    for (${N} *${cur} = ${h}; ${cur} != NULL; ${cur} = ${cur}->${nx}) {
        free(${cur});
    }
}`,
	asSorted: String.raw`${hdr()}${proto}${pSorted.trimEnd()}`,
	asOutput: String.raw`${hdr(true)}${pCreate}${pFront}${pBack}${pPrint}${pDestroy}int main(void) {
    ${N} *${h} = NULL;
    if (!${front}(&${h}, 1) || !${back}(&${h}, 2) || !${front}(&${h}, 3)) {
${fail}
    ${print}(${h});
${end}`,
	asNoHead: String.raw`${hdr()}bool ${del}(${N} **${h}, int ${v}) {
    ${N} *${cur} = *${h};
    ${N} *${prev} = NULL;
    while (${cur} != NULL && ${cur}->${v} != ${v}) {
        ${prev} = ${cur};
        ${cur} = ${cur}->${nx};
    }
    if (${cur} == NULL) {
        return false;
    }
    ${prev}->${nx} = ${cur}->${nx};
    free(${cur});
    return true;
}`,
};

type ProgramKey = keyof typeof programs;

// Line number (1-based) of the first, nth or last line of a program containing needle.
// Throws at build time if the needle is missing, so a step can never point at a wrong line.
const at = (key: ProgramKey, needle: string, nth: number | 'last' = 1): number => {
	const hits: number[] = [];
	programs[key].split('\n').forEach((l, i) => {
		if (l.includes(needle)) hits.push(i + 1);
	});
	const n = nth === 'last' ? hits.length : nth;
	if (!hits[n - 1]) throw new Error(`line not found in ${key}: ${needle}`);
	return hits[n - 1];
};

/* ---------- State builders ---------- */

const ADDR: Record<string, string> = { A: '0x5010', B: '0x5080', C: '0x5030' };
const LISTOWN = t('la lista', 'the list');
const F = { value: t('dato', 'value'), next: t('siguiente', 'next') };

type NodeOpts = { status?: Block['status']; owner?: string | null; kind?: Kind };
const node = (id: string, value: string | number, next: string | null, o: NodeOpts = {}): Block => {
	const status = o.status ?? 'live';
	const nextField: Slot =
		status === 'freed'
			? val(F.next, next === null ? 'NULL' : ADDR[next])
			: next === null
				? nul(F.next)
				: ptr(F.next, ADDR[next], o.kind ?? 'owner', next);
	return {
		id,
		addr: ADDR[id],
		size: '16 B',
		label: N,
		status,
		owner: status === 'freed' || o.owner === null ? undefined : (o.owner ?? LISTOWN),
		fields: [val(F.value, String(value)), nextField],
	};
};
const ref = (name: string, to: string, kind: Kind = 'borrow') => ptr(name, ADDR[to], kind, to);
const hd = (to: string | null, kind: Kind = 'owner') => (to === null ? nul(h) : ref(h, to, kind));
const hRef = ptr(h, `&${h}`, 'borrow');
const mainF = (...vars: Slot[]): Frame => ({ label: 'main', vars });
const fr = (label: string, ...vars: Slot[]): Frame => ({ label, vars });
const st = (frames: Frame[], blocks: Block[], alert?: Alert): State => ({ frames, blocks, alert });
const noLeaks: Alert = { kind: 'ok', text: t('0 fugas · 0 dobles liberaciones', '0 leaks · 0 double frees') };
const L379 = [node('A', 3, 'B'), node('B', 7, 'C'), node('C', 9, null)];

/* ---------- 1. A node and the head ---------- */

const s1a = st([mainF(nul(h))], []);
const f1b = fr(create, val(F.value, '3'), ref(nw, 'A', 'owner'));
const s1b = st([mainF(nul(h)), f1b], [node('A', '?', '?', { owner: nw })]);
const s1c = st([mainF(nul(h)), f1b], [node('A', 3, null, { owner: nw })]);
const s1d = st([mainF(nul(h), ref(first, 'A', 'owner'))], [node('A', 3, null, { owner: first })]);
const s1e = st([mainF(hd('A'), ref(first, 'A'))], [node('A', 3, null)]);
const s1f = st([mainF(hd('A', 'dangling'), ref(first, 'A', 'dangling'))], [node('A', 3, null, { status: 'freed' })]);

/* ---------- 2. Insert at the head through a double pointer ---------- */

const frontF = (...extra: Slot[]) => fr(front, hRef, val(F.value, '3'), ...extra);
const f1 = st([mainF(hd('B'))], [node('B', 7, null)]);
const f2 = st([mainF(hd('B')), frontF()], f1.blocks);
const f3 = st([mainF(hd('B')), frontF(ref(nw, 'A', 'owner'))], [node('A', 3, null, { owner: nw }), node('B', 7, null)]);
const f4 = st([mainF(hd('B')), frontF(ref(nw, 'A', 'owner'))], [node('A', 3, 'B', { owner: nw, kind: 'borrow' }), node('B', 7, null)]);
const f5 = st([mainF(hd('A')), frontF(ref(nw, 'A'))], [node('A', 3, 'B'), node('B', 7, null)]);
const f6 = st([mainF(hd('A'))], f5.blocks);

/* ---------- 3. Insert at the tail ---------- */

const backF = (value: string, ...extra: Slot[]) => fr(back, hRef, val(F.value, value), ...extra);
const b1 = st([mainF(nul(h))], []);
const b2 = st([mainF(nul(h)), backF('7', ref(nw, 'B', 'owner'))], [node('B', 7, null, { owner: nw })]);
const b3 = st([mainF(hd('B')), backF('7', ref(nw, 'B'))], [node('B', 7, null)]);
const b4 = st([mainF(hd('B')), backF('9', ref(nw, 'C', 'owner'))], [node('B', 7, null), node('C', 9, null, { owner: nw })]);
const b5 = st([mainF(hd('B')), backF('9', ref(nw, 'C', 'owner'), ref(last, 'B'))], b4.blocks);
const b6 = st([mainF(hd('B')), backF('9', ref(nw, 'C'), ref(last, 'B'))], [node('B', 7, 'C'), node('C', 9, null)]);
const b7 = st([mainF(hd('B'))], b6.blocks);

/* ---------- 4. Insert in order ---------- */

const sortedF = (...extra: Slot[]) => fr(sorted, hRef, val(F.value, '7'), ...extra);
const sA = [node('A', 3, 'C'), node('C', 9, null)];
const o1 = st([mainF(hd('A'))], sA);
const o2 = st([mainF(hd('A')), sortedF(ref(nw, 'B', 'owner'))], [...sA, node('B', 7, null, { owner: nw })]);
const o3 = st([mainF(hd('A')), sortedF(ref(nw, 'B', 'owner'), ref(prev, 'A'))], o2.blocks);
const o5 = st(o3.frames, [node('A', 3, 'C'), node('C', 9, null), node('B', 7, 'C', { owner: nw, kind: 'borrow' })]);
const o6 = st([mainF(hd('A')), sortedF(ref(nw, 'B'), ref(prev, 'A'))], [node('A', 3, 'B'), node('B', 7, 'C'), node('C', 9, null)]);
const o7 = st([mainF(hd('A'))], o6.blocks);

/* ---------- 5. Search ---------- */

const findF = (to: string | null) => fr(find, ref(h, 'A'), to === null ? nul(cur) : ref(cur, to), val(F.value, '9'));
const q1 = st([mainF(hd('A'))], L379);
const q2 = st([mainF(hd('A')), findF('A')], L379);
const q3 = st([mainF(hd('A')), findF('B')], L379);
const q4 = st([mainF(hd('A')), findF('C')], L379);
const q5 = st([mainF(hd('A'), ref(hit, 'C'))], L379);
const q6 = st([mainF(hd('A'), ref(hit, 'C'), nul(none))], L379);

/* ---------- 6. Delete by value ---------- */

const delF = (curVar: Slot, prevVar: Slot, value = '7') => fr(del, hRef, val(F.value, value), curVar, prevVar);
const d1 = st([mainF(hd('A'))], L379);
const d2 = st([mainF(hd('A')), delF(ref(cur, 'A'), nul(prev))], L379);
const d3 = st([mainF(hd('A')), delF(ref(cur, 'B'), ref(prev, 'A'))], L379);
const d4 = st(d3.frames, [node('A', 3, 'C'), node('B', 7, 'C', { owner: cur, kind: 'borrow' }), node('C', 9, null)]);
const d5 = st([mainF(hd('A')), delF(ref(cur, 'B', 'dangling'), ref(prev, 'A'))], [node('A', 3, 'C'), node('B', 7, 'C', { status: 'freed' }), node('C', 9, null)]);
const d6 = st([mainF(hd('A'))], [node('A', 3, 'C'), node('C', 9, null)]);
const dh1 = st([mainF(hd('A')), delF(ref(cur, 'A'), nul(prev), '3')], L379);
const dh2 = st([mainF(hd('B')), delF(ref(cur, 'A'), nul(prev), '3')], [node('A', 3, 'B', { owner: cur, kind: 'borrow' }), node('B', 7, 'C'), node('C', 9, null)]);

/* ---------- 7. Destroy the list ---------- */

const destroyF = (...vars: Slot[]) => fr(destroy, hRef, ...vars);
const nodes2 = [node('A', 3, 'B'), node('B', 7, null)];
const y1 = st([mainF(hd('A'))], nodes2);
const y2 = st([mainF(hd('A')), destroyF(ref(cur, 'A'))], nodes2);
const y3 = st([mainF(hd('A')), destroyF(ref(cur, 'A'), ref(nextv, 'B'))], nodes2);
const y4 = st([mainF(hd('A', 'dangling')), destroyF(ref(cur, 'A', 'dangling'), ref(nextv, 'B'))], [node('A', 3, 'B', { status: 'freed' }), node('B', 7, null)]);
const y5 = st([mainF(hd('A', 'dangling')), destroyF(ref(cur, 'B'), ref(nextv, 'B'))], y4.blocks);
const y6 = st([mainF(hd('A', 'dangling')), destroyF(ref(cur, 'B', 'dangling'), nul(nextv))], [node('A', 3, 'B', { status: 'freed' }), node('B', 7, null, { status: 'freed' })]);
const y7 = st([mainF(hd('A', 'dangling')), destroyF(nul(cur), nul(nextv))], y6.blocks);
const y8 = st([mainF(nul(h))], y6.blocks, noLeaks);

/* ---------- 8. Array against list ---------- */

const arrB = (cells: string[], hi?: number): Block => ({
	id: 'R',
	addr: '0x2000',
	size: '16 B',
	label: 'int[4]',
	status: 'live',
	owner: 'main',
	cells: cells.map((c, i) => ({ v: c, out: i === hi })),
});
const list79 = [node('B', 7, 'C'), node('C', 9, null)];
const c1 = st([mainF(hd('B'), val(count, '2'))], [...list79, arrB(['7', '9', '0', '0'])]);
const c2 = st([mainF(hd('B'), val(count, '2'), val('i', '2'))], [...list79, arrB(['7', '9', '9', '0'], 2)]);
const c3 = st([mainF(hd('B'), val(count, '2'), val('i', '1'))], [...list79, arrB(['7', '7', '9', '0'], 1)]);
const c4 = st([mainF(hd('B'), val(count, '3'))], [...list79, arrB(['3', '7', '9', '0'], 0)]);
const c5 = st(
	[mainF(hd('B'), val(count, '3')), fr(front, hRef, val(F.value, '3'), ref(nw, 'A', 'owner'))],
	[node('A', 3, null, { owner: nw }), ...list79, arrB(['3', '7', '9', '0'])],
);
const c6 = st([mainF(hd('A'), val(count, '3'))], [node('A', 3, 'B'), ...list79, arrB(['3', '7', '9', '0'])]);

/* ---------- Learn: one mechanism per slide, advanced step by step ---------- */

type LearnSlide = { kicker: string; title: string; lead: string; program: ProgramKey; steps: Step[] };

const learn: LearnSlide[] = [
	{
		kicker: t('Nodos', 'Nodes'),
		title: t('Un nodo, un puntero a la cabeza', 'A node and a head pointer'),
		lead: t(
			'Una lista enlazada es una cadena de nodos. La variable cabeza guarda la dirección del primero; una lista vacía es una cabeza que vale NULL.',
			'A linked list is a chain of nodes. The head variable holds the address of the first one; an empty list is a head that is NULL.',
		),
		program: 'first',
		steps: [
			{
				lines: [at('first', `${N} *${h} = NULL`)],
				text: t(
					'cabeza vive en la pila de main y vale NULL: la lista está vacía. Todavía no existe ningún nodo.',
					'head lives on the stack of main and is NULL: the list is empty. No node exists yet.',
				),
				state: s1a,
			},
			{
				lines: [at('first', 'malloc')],
				text: t(
					'crear_nodo reserva un bloque del heap con malloc(sizeof *nuevo). Sus campos todavía no tienen valor: el dueño del bloque es la variable nuevo.',
					'create_node allocates a heap block with malloc(sizeof *new_node). Its fields have no value yet: the owner of the block is the variable new_node.',
				),
				state: s1b,
			},
			{
				lines: [at('first', `${nw}->${v} = ${v};`), at('first', `${nw}->${nx} = NULL;`)],
				text: t(
					'La función completa el nodo: dato vale 3 y siguiente vale NULL, porque todavía no hay nadie después de él.',
					'The function fills in the node: value is 3 and next is NULL, because nothing follows it yet.',
				),
				state: s1c,
			},
			{
				lines: [at('first', `return ${nw};`)],
