	}

	.dc-nested-panel.is-active {
		display: flex;
	}

	.dc-ide-inspect {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.dc-panel-block {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--space-3);
	}

	.dc-panel-head {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin-bottom: var(--space-2);
		color: var(--color-accent-700, var(--color-accent));
	}

	.dc-panel-head strong {
		font-size: var(--text-xs);
		color: var(--color-text-muted);
	}

	.dc-var-row {
		display: flex;
		justify-content: space-between;
		gap: var(--space-2);
		font-size: 11px;
		padding: 2px 0;
	}

	.dc-var-row code {
		font-family: monospace;
		color: var(--color-accent-700, var(--color-accent));
	}

	/* Slide 3: Code smells */
	.dc-smell-tabs {
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
	}

	.dc-smell-panel {
		display: none;
		flex-direction: column;
		gap: var(--space-3);
	}

	.dc-smell-panel.is-active {
		display: flex;
	}

	/* Slide 4: Refactor cycle + guard clauses */
	.dc-refactor-steps {
		display: grid;
		grid-template-columns: 1fr 1fr 1.3fr;
		gap: var(--space-3);
	}

	@media (max-width: 768px) {
		.dc-refactor-steps {
			grid-template-columns: 1fr;
		}
	}

	.dc-refactor-step {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--space-3);
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.dc-refactor-step-final {
		gap: var(--space-2);
	}

	.dc-step-badge {
		display: inline-block;
		align-self: flex-start;
		font-size: 10px;
		font-weight: 700;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		padding: 2px 6px;
		border-radius: var(--radius-full);
	}

	.dc-outcome {
		display: none;
		align-items: center;
		gap: var(--space-2);
		font-size: 11px;
		font-weight: 600;
		padding: var(--space-2);
		border-radius: var(--radius-sm);
	}

	.dc-outcome.is-active {
		display: flex;
	}

	.dc-outcome[data-outcome='green'] {
		color: var(--color-accent-2-700, var(--color-accent-2));
		background: color-mix(in srgb, var(--color-accent-2, rgb(100, 140, 90)) 15%, transparent);
	}

	.dc-outcome[data-outcome='red'] {
		color: var(--color-accent-700, var(--color-accent));
		background: color-mix(in srgb, var(--color-accent) 12%, transparent);
	}

	.dc-guard-compare {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
	}

	@media (max-width: 768px) {
		.dc-guard-compare {
			grid-template-columns: 1fr;
		}
	}

	.dc-guard-column {
		display: flex;
		flex-direction: column;
	}

	/* Slide 5: Diff comparator */
	.dc-diff-toolbar {
		display: flex;
		justify-content: flex-end;
	}

	.dc-diff-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
	}

	@media (max-width: 768px) {
		.dc-diff-grid {
			grid-template-columns: 1fr;
		}
	}

	.dc-diff-column {
		display: flex;
		flex-direction: column;
	}

	.dc-smell-mark {
		border-radius: 3px;
		transition: all 0.2s;
	}

	.dc-smell-mark.is-highlighted {
		background: color-mix(in srgb, var(--color-accent) 25%, transparent);
		color: var(--color-accent-700, var(--color-accent));
		font-weight: 700;
	}

	@media (min-width: 1440px) { .dc-viewport { zoom: 1.08; } }
	@media (min-width: 1680px) { .dc-viewport { zoom: 1.16; } }
	@media (min-width: 1920px) { .dc-viewport { zoom: 1.25; } }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 5;

	const prevBtn = document.getElementById('dcPrevBtn') as HTMLButtonElement;
	const nextBtn = document.getElementById('dcNextBtn') as HTMLButtonElement;
	const counter = document.getElementById('dcSlideCounter') as HTMLElement;
	const slides = document.querySelectorAll<HTMLElement>('.dc-slide');

	function updateSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;
		slides.forEach((s) => s.classList.remove('is-active'));
		document.querySelector(`.dc-slide[data-slide="${currentSlide}"]`)?.classList.add('is-active');

		if (counter) counter.textContent = `${currentSlide} / ${totalSlides}`;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	prevBtn?.addEventListener('click', () => updateSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => updateSlide(currentSlide + 1));

	window.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') updateSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') updateSlide(currentSlide - 1);
	});

	// Slide 1: Debugging loop steps
	const loopSteps = document.querySelectorAll<HTMLElement>('.dc-loop-step');
	const loopDescs = document.querySelectorAll<HTMLElement>('.dc-loop-desc');

	function activateLoopStep(step: string) {
		loopSteps.forEach((s) => s.classList.toggle('is-active', s.dataset.step === step));
		loopDescs.forEach((d) => d.classList.toggle('is-active', d.dataset.step === step));
	}

	loopSteps.forEach((step) => {
		step.addEventListener('click', () => activateLoopStep(step.dataset.step ?? '1'));
		step.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' || e.key === ' ') {
				e.preventDefault();
				activateLoopStep(step.dataset.step ?? '1');
			}
		});
	});

	// Slide 1: Stack trace anatomy tabs
	const traceTabs = document.querySelectorAll<HTMLElement>('.dc-trace-tabs .dc-tab');
	const traceParts = document.querySelectorAll<HTMLElement>('.dc-part');
	const explainDescs = document.querySelectorAll<HTMLElement>('.dc-explain-desc');

	traceTabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			const part = tab.dataset.part ?? 'type';
			traceTabs.forEach((t) => t.classList.toggle('is-active', t === tab));
			traceParts.forEach((p) => p.classList.toggle('is-focused', p.dataset.part === part));
			explainDescs.forEach((d) => d.classList.toggle('is-active', d.dataset.part === part));
		});
	});

	// Slide 2: Stepping simulator
	const stepOverBtn = document.getElementById('dcStepOverBtn');
	const stepIntoBtn = document.getElementById('dcStepIntoBtn');
	const stepOutBtn = document.getElementById('dcStepOutBtn');
	const resumeBtn = document.getElementById('dcResumeBtn');
	const nestedPanel = document.getElementById('dcNestedPanel');
	const varSubtotal = document.getElementById('dcVarSubtotal');
	const execStatus = document.getElementById('dcExecStatus');
	const codeRows = document.querySelectorAll<SVGRectElement>('.dc-row-bg');

	const breakpointLines = [3, 5];
	const subtotalByLine: Record<number, string> = {
		3: '0.0',
		4: '0.0',
		5: '45.9',
		6: '45.9',
		7: '41.31',
		8: '41.31',
		9: '41.31',
	};
	let line = 3;
	let nested = false;

	function renderState() {
		codeRows.forEach((row) => {
			const rowLine = Number(row.dataset.line);
			row.classList.toggle('is-current', !nested && rowLine === line);
		});
		nestedPanel?.classList.toggle('is-active', nested);
		if (varSubtotal) varSubtotal.textContent = subtotalByLine[line] ?? '0.0';
		if (execStatus) {
			if (nested) {
				execStatus.textContent = 'Dentro de applyBulkDiscount(int subtotal)';
			} else if (breakpointLines.includes(line)) {
				execStatus.textContent = `Detenido en breakpoint · línea ${line}`;
			} else if (line >= 9) {
				execStatus.textContent = 'Ejecución finalizada';
			} else {
				execStatus.textContent = `Ejecutando · línea ${line}`;
			}
		}
	}

	stepOverBtn?.addEventListener('click', () => {
		nested = false;
		line = Math.min(line + 1, 9);
		renderState();
	});

	stepIntoBtn?.addEventListener('click', () => {
		if (line === 6) {
			nested = true;
		} else {
			line = Math.min(line + 1, 9);
		}
		renderState();
	});

	stepOutBtn?.addEventListener('click', () => {
		if (nested) {
			nested = false;
			line = 7;
		} else {
			line = Math.min(line + 1, 9);
		}
		renderState();
	});

	resumeBtn?.addEventListener('click', () => {
		nested = false;
		line = line < 5 ? 5 : 9;
		renderState();
	});

	// Slide 3: Code smells gallery
	const smellTabs = document.querySelectorAll<HTMLElement>('.dc-smell-tabs .dc-tab');
	const smellPanels = document.querySelectorAll<HTMLElement>('.dc-smell-panel');

	smellTabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			const smell = tab.dataset.smell ?? 'long-method';
			smellTabs.forEach((t) => t.classList.toggle('is-active', t === tab));
			smellPanels.forEach((p) => p.classList.toggle('is-active', p.dataset.smell === smell));
		});
	});

	// Slide 4: Refactor cycle outcome simulator
	const runTestsBtn = document.getElementById('dcRunTestsBtn');
	const outcomes = document.querySelectorAll<HTMLElement>('.dc-outcome');
	let lastOutcome: 'green' | 'red' = 'green';

	runTestsBtn?.addEventListener('click', () => {
		lastOutcome = lastOutcome === 'green' ? 'red' : 'green';
		outcomes.forEach((o) => o.classList.toggle('is-active', o.dataset.outcome === lastOutcome));
	});

	// Slide 5: Highlight code smells toggle
	const highlightBtn = document.getElementById('dcHighlightBtn');
	const smellMarks = document.querySelectorAll<HTMLElement>('.dc-smell-mark');

	highlightBtn?.addEventListener('click', () => {
		const isHighlighted = smellMarks[0]?.classList.toggle('is-highlighted');
		smellMarks.forEach((mark, i) => {
			if (i === 0) return;
			mark.classList.toggle('is-highlighted', isHighlighted);
		});
	});
</script>
