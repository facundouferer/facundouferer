---
interface Props {
	lang?: string;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<div class="gs-screen" data-presentation="sincronizacion-remota-pull-push-git" data-lang={lang}>
	<div class="gs-shell">
		<nav class="gs-nav" aria-label={isEs ? 'Controles de navegación' : 'Navigation controls'}>
			<button class="gs-btn" id="gsPrevBtn" aria-label={isEs ? 'Diapositiva anterior' : 'Previous slide'} disabled>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
					<path d="m15 18-6-6 6-6" />
				</svg>
				<span>{isEs ? 'Anterior' : 'Previous'}</span>
			</button>
			<span class="gs-counter" id="gsSlideCounter" aria-live="polite">1 / 6</span>
			<button class="gs-btn" id="gsNextBtn" aria-label={isEs ? 'Siguiente diapositiva' : 'Next slide'}>
				<span>{isEs ? 'Siguiente' : 'Next'}</span>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
					<path d="m9 18 6-6-6-6" />
				</svg>
			</button>
		</nav>

		<main class="gs-viewport">
			<!-- Slide 1: Modelo Distribuido: Local vs Remoto -->
			<section class="gs-slide is-active" data-slide="1">
				<div class="gs-header">
					<span class="gs-kicker">{isEs ? 'Arquitectura distribuida' : 'Distributed architecture'}</span>
					<h2 class="gs-title">{isEs ? 'Tu PC no depende de la nube: el repositorio completo vive en tu disco' : 'Your PC does not rely on the cloud: the entire repository lives on disk'}</h2>
					<p class="gs-lead">
						{isEs
							? 'A diferencia de los sistemas centralizados obsoletos (como SVN), Git es peer-to-peer. Tu clon local posee el grafo completo de commits, tags y ramas. Los servidores como GitHub son simplemente repositorios remotos con un alias convencional: origin.'
							: 'Unlike obsolete centralized systems (like SVN), Git is peer-to-peer. Your local clone holds the complete graph of commits, tags, and branches. Platforms like GitHub are simply remote repositories with a conventional alias: origin.'}
					</p>
				</div>

				<div class="gs-card">
					<div class="gs-toolbar">
						<button class="gs-action-btn" id="gsModeToggle">{isEs ? 'Simular desconexión (Modo Offline)' : 'Simulate disconnection (Offline mode)'}</button>
						<span class="gs-hint">{isEs ? 'Observa qué operaciones son 100% locales sin internet y cuáles requieren red.' : 'See which operations are 100% local without network and which require internet.'}</span>
					</div>

					<div class="gs-stage-grid">
						<div class="gs-panel">
							<div class="gs-panel-head">
								<span class="gs-panel-badge is-local">💻 {isEs ? 'Repositorio Local' : 'Local Repository'}</span>
								<span class="gs-network-status" id="gsNetStatus">🟢 {isEs ? 'Conectado a Internet' : 'Connected to Internet'}</span>
							</div>
							<ul class="gs-feature-list">
								<li>✓ <code>git commit</code> ({isEs ? 'inmediato, sin latencia de red' : 'instant, zero network latency'})</li>
								<li>✓ <code>git branch</code> &amp; <code>git switch</code> ({isEs ? 'creación y cambio de ramas en milisegundos' : 'sub-millisecond branch operations'})</li>
								<li>✓ <code>git log</code> &amp; <code>git diff</code> ({isEs ? 'consulta del historial histórico completo offline' : 'full offline history queries'})</li>
								<li>✓ <code>git merge</code> &amp; <code>git rebase</code> ({isEs ? 'integración local autónoma' : 'autonomous local integration'})</li>
							</ul>
						</div>

						<div class="gs-panel is-remote" id="gsRemotePanel">
							<div class="gs-panel-head">
								<span class="gs-panel-badge is-remote">☁️ {isEs ? 'Remoto (GitHub - origin)' : 'Remote (GitHub - origin)'}</span>
								<span class="gs-remote-url">https://github.com/org/repo.git</span>
							</div>
							<p class="gs-panel-text">
								{isEs
									? 'Almacena la copia canónica de referencia para el equipo. Se sincroniza exclusivamente mediante protocolos de red (SSH o HTTPS).'
									: 'Stores the authoritative canonical copy for the team. Synchronized strictly over network protocols (SSH or HTTPS).'}
							</p>
							<div class="gs-sync-pills">
								<span class="gs-pill">git push (subir)</span>
								<span class="gs-pill">git fetch (descargar)</span>
								<span class="gs-pill">git pull (descargar + unir)</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Slide 2: Publicación de cambios con git push -->
			<section class="gs-slide" data-slide="2">
				<div class="gs-header">
					<span class="gs-kicker">{isEs ? 'Publicación de código' : 'Code publishing'}</span>
					<h2 class="gs-title">{isEs ? 'git push: transfiriendo tus commits confirmados a la nube' : 'git push: transferring your confirmed commits to the cloud'}</h2>
					<p class="gs-lead">
						{isEs
							? 'Hacer git commit guarda los cambios en tu PC. Para compartirlos con tu equipo o respaldarlos en GitHub, necesitas ejecutar git push. Esto envía los paquetes de objetos y avanza la referencia origin/main en el servidor.'
							: 'Running git commit saves changes on your computer. To share them with your team or back them up to GitHub, you run git push. This sends object packs and advances origin/main on the server.'}
					</p>
				</div>

				<div class="gs-card">
					<div class="gs-controls-row">
						<button class="gs-action-btn" id="gsBtnCommitLocal">{isEs ? '+ Hacer commit local (C3)' : '+ Make local commit (C3)'}</button>
						<button class="gs-action-btn is-secondary" id="gsBtnPush" disabled>{isEs ? 'git push origin main' : 'git push origin main'}</button>
						<button class="gs-action-btn is-secondary" id="gsBtnResetPush">{isEs ? 'Reiniciar' : 'Reset'}</button>
					</div>

					<div class="gs-sync-stage">
						<!-- Local branch -->
						<div class="gs-sync-box">
							<div class="gs-box-header">
								<span class="gs-box-title">💻 Local: main</span>
								<span class="gs-box-status" id="gsLocalStatusText">{isEs ? 'Sincronizado' : 'In sync'}</span>
							</div>
							<div class="gs-nodes-track" id="gsLocalNodes">
								<div class="gs-node">C1</div>
								<div class="gs-line"></div>
								<div class="gs-node">C2</div>
								<div class="gs-line" id="gsLocalLine3" hidden></div>
								<div class="gs-node is-new" id="gsLocalNode3" hidden>C3</div>
							</div>
						</div>

						<!-- Sync Arrow -->
						<div class="gs-arrow-indicator" id="gsPushArrow">
							<span class="gs-arrow-label">git push</span>
							<span class="gs-arrow-sym">→</span>
						</div>

						<!-- Remote branch -->
						<div class="gs-sync-box">
							<div class="gs-box-header">
								<span class="gs-box-title">☁️ origin: refs/heads/main</span>
								<span class="gs-box-status" id="gsRemoteStatusText">{isEs ? 'Sincronizado' : 'In sync'}</span>
							</div>
							<div class="gs-nodes-track" id="gsRemoteNodes">
								<div class="gs-node">C1</div>
								<div class="gs-line"></div>
								<div class="gs-node">C2</div>
								<div class="gs-line" id="gsRemoteLine3" hidden></div>
								<div class="gs-node is-new" id="gsRemoteNode3" hidden>C3</div>
							</div>
						</div>
					</div>

					<div class="gs-terminal-log" id="gsPushTerminal">
						<span class="gs-prompt">$</span> <span id="gsPushLogText">{isEs ? 'Ambos repositorios están en el commit C2. Haz clic en "Hacer commit local" para avanzar.' : 'Both repositories are at commit C2. Click "Make local commit" to advance.'}</span>
					</div>
				</div>
			</section>

			<!-- Slide 3: git fetch vs git pull -->
			<section class="gs-slide" data-slide="3">
				<div class="gs-header">
					<span class="gs-kicker">{isEs ? 'Descarga segura' : 'Safe download'}</span>
					<h2 class="gs-title">{isEs ? 'La gran diferencia: git fetch vs git pull' : 'The key difference: git fetch vs git pull'}</h2>
					<p class="gs-lead">
						{isEs
							? 'Muchos principiantes confunden estos comandos: git fetch es pasivo y seguro (descarga objetos y actualiza origin/main sin tocar tus archivos de trabajo). git pull es agresivo: hace fetch y ejecuta un merge inmediato sobre tu rama actual.'
							: 'Many developers confuse these commands: git fetch is safe and non-intrusive (downloads objects and updates origin/main without touching your working tree). git pull is aggressive: it fetches and immediately merges into your current branch.'}
					</p>
				</div>

				<div class="gs-card">
					<div class="gs-controls-row">
						<button class="gs-action-btn" id="gsBtnFetch">{isEs ? 'Ejecutar git fetch' : 'Run git fetch'}</button>
						<button class="gs-action-btn is-secondary" id="gsBtnPull">{isEs ? 'Ejecutar git pull (fetch + merge)' : 'Run git pull (fetch + merge)'}</button>
						<button class="gs-action-btn is-secondary" id="gsBtnResetFetch">{isEs ? 'Restablecer' : 'Reset'}</button>
					</div>

					<div class="gs-fetch-diagram">
						<div class="gs-fetch-col">
							<span class="gs-col-badge is-remote">origin (GitHub)</span>
							<div class="gs-fetch-card">
								<p><strong>Commit C4</strong> {isEs ? 'subido por tu compañero en la nube.' : 'pushed by your teammate in cloud.'}</p>
							</div>
						</div>

						<div class="gs-fetch-middle">
							<div class="gs-fetch-track" id="gsFetchTrackRef">
								<span class="gs-flow-label">1. git fetch</span>
								<span class="gs-flow-sub">{isEs ? 'Solo actualiza puntero local' : 'Only updates local tracking pointer'}</span>
								<div class="gs-flow-arrow">→</div>
							</div>
							<div class="gs-fetch-track is-merge" id="gsFetchTrackMerge">
								<span class="gs-flow-label">2. git merge origin/main</span>
								<span class="gs-flow-sub">{isEs ? 'Fusiona en tu Working Tree' : 'Merges into your Working Tree'}</span>
								<div class="gs-flow-arrow">↓↓</div>
							</div>
						</div>

						<div class="gs-fetch-col">
							<span class="gs-col-badge is-local">Local PC</span>
							<div class="gs-fetch-card" id="gsLocalRefCard">
								<p><strong>origin/main (ref):</strong> <span id="gsRefStatus">{isEs ? 'Apunta a C2' : 'Points to C2'}</span></p>
								<p><strong>Working Tree (archivos):</strong> <span id="gsWorkingStatus">{isEs ? 'Apunta a C2 (Limpio)' : 'Points to C2 (Clean)'}</span></p>
							</div>
						</div>
					</div>

					<p class="gs-status is-info" id="gsFetchExpl">
						<span>💡 {isEs ? 'Usa git fetch cuando quieras revisar qué cambios hay antes de integrarlos a ciegas.' : 'Use git fetch when you want to review changes before blindly merging them.'}</span>
					</p>
				</div>
			</section>

			<!-- Slide 4: Upstream Tracking (-u) -->
			<section class="gs-slide" data-slide="4">
				<div class="gs-header">
					<span class="gs-kicker">{isEs ? 'Ramas de seguimiento' : 'Tracking branches'}</span>
					<h2 class="gs-title">{isEs ? 'Por qué usamos git push -u origin main y qué hace el upstream' : 'Why we use git push -u origin main and what upstream does'}</h2>
					<p class="gs-lead">
						{isEs
							? 'La primera vez que subes una rama, Git no sabe a qué rama remota vincularla. La bandera -u (--set-upstream) crea un enlace permanente en tu configuración local. A partir de ese momento, basta con escribir git push o git pull a secas.'
							: 'The first time you push a branch, Git does not know which remote branch to link it to. The -u (--set-upstream) flag creates a permanent link in your local config. From then on, simply typing git push or git pull suffices.'}
					</p>
				</div>

				<div class="gs-card">
					<div class="gs-toolbar">
						<button class="gs-action-btn" id="gsToggleUpstream">{isEs ? 'Alternar enlace Upstream' : 'Toggle Upstream link'}</button>
						<span class="gs-hint">{isEs ? 'Observa cómo cambia la respuesta de terminal según si configuraste -u o no.' : 'See how terminal output changes whether -u was configured or not.'}</span>
					</div>

					<div class="gs-upstream-grid">
						<div class="gs-config-panel">
							<span class="gs-panel-label">{isEs ? 'Configuración interna (.git/config)' : 'Internal configuration (.git/config)'}</span>
							<pre class="gs-code-block" id="gsConfigCode"><code>[core]
	repositoryformatversion = 0
[remote "origin"]
	url = git@github.com:facundo/proyecto.git
	fetch = +refs/heads/*:refs/remotes/origin/*
<span id="gsUpstreamSection" class="gs-tc-green">[branch "main"]
	remote = origin
	merge = refs/heads/main</span></code></pre>
						</div>

						<div class="gs-terminal-panel">
							<span class="gs-panel-label">{isEs ? 'Comando sin argumentos: $ git push' : 'Bare command: $ git push'}</span>
							<div class="gs-terminal-box" id="gsUpstreamTerminal">
								<p class="gs-term-line" id="gsUpstreamTermResult">
									<span class="gs-tc-green">Everything up-to-date</span><br />
									<small>Branch 'main' set up to track remote branch 'main' from 'origin'.</small>
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Slide 5: Rechazo de Push y Divergencia Remota -->
			<section class="gs-slide" data-slide="5">
				<div class="gs-header">
					<span class="gs-kicker">{isEs ? 'Divergencia y conflictos' : 'Divergence and conflicts'}</span>
					<h2 class="gs-title">{isEs ? 'Error: [rejected - non-fast-forward] y cómo resolverlo' : 'Error: [rejected - non-fast-forward] and how to recover'}</h2>
					<p class="gs-lead">
						{isEs
							? 'Si tu compañero publicó cambios en GitHub mientras tú trabajabas en local, sus historias divergen. Git te bloquea el push para proteger el código ajeno. La solución obligatoria es descargar (pull), integrar y volver a empujar.'
							: 'If a teammate pushed changes to GitHub while you worked locally, your histories diverge. Git blocks your push to protect their code. The mandatory remedy is to pull, integrate, and push again.'}
					</p>
				</div>

				<div class="gs-card">
					<div class="gs-divergence-sim">
						<div class="gs-step-buttons">
							<button class="gs-step-btn is-active" id="gsStep1Btn">1. {isEs ? 'Intentar push directo' : 'Attempt direct push'}</button>
							<button class="gs-step-btn" id="gsStep2Btn" disabled>2. {isEs ? 'Ejecutar git pull' : 'Run git pull'}</button>
							<button class="gs-step-btn" id="gsStep3Btn" disabled>3. {isEs ? 'Hacer git push final' : 'Run final git push'}</button>
						</div>

						<div class="gs-divergence-visual">
							<div class="gs-diverge-graph">
								<div class="gs-diverge-line">
									<span class="gs-diverge-tag">origin:</span>
									<span class="gs-node-pill">C1</span> → <span class="gs-node-pill">C2</span> → <span class="gs-node-pill is-remote">C3 (remoto)</span>
								</div>
								<div class="gs-diverge-line">
									<span class="gs-diverge-tag">local:</span>
									<span class="gs-node-pill">C1</span> → <span class="gs-node-pill">C2</span> → <span class="gs-node-pill is-local">C4 (local)</span>
								</div>
								<div class="gs-diverge-line is-merge-line" id="gsMergeLine" hidden>
									<span class="gs-diverge-tag">integrado:</span>
									<span class="gs-node-pill is-merge">M (Merge C3 + C4)</span>
								</div>
							</div>
						</div>

						<div class="gs-terminal-shell">
							<div class="gs-terminal-body" id="gsDivergeTerm">
								<code><span class="gs-tc-red">! [rejected]        main -> main (non-fast-forward)</span>
error: failed to push some refs to 'github.com:org/repo.git'
<span class="gs-tc-bold">hint: Updates were rejected because the remote contains work that you do</span>
<span class="gs-tc-bold">hint: not have locally. This is usually caused by another repository pushing</span>
<span class="gs-tc-bold">hint: to the same ref. You may want to first integrate the remote changes</span>
<span class="gs-tc-bold">hint: (e.g., 'git pull ...') before pushing again.</span></code>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Slide 6: Protocolo diario de sincronización -->
			<section class="gs-slide" data-slide="6">
				<div class="gs-header">
					<span class="gs-kicker">{isEs ? 'Protocolo profesional' : 'Professional protocol'}</span>
					<h2 class="gs-title">{isEs ? 'El ritual diario de sincronización en 5 pasos' : 'The 5-step daily synchronization ritual'}</h2>
					<p class="gs-lead">
						{isEs
							? 'Seguir esta rutina técnica al inicio y final de cada jornada de desarrollo evita el 95% de los conflictos y desincronizaciones en equipos de software.'
							: 'Following this technical routine at the start and end of every development day prevents 95% of conflicts and divergence in software teams.'}
					</p>
				</div>

				<div class="gs-card">
					<div class="gs-protocol-grid">
						<div class="gs-step-card">
							<span class="gs-step-num">01</span>
							<h3 class="gs-step-title">{isEs ? 'Bajar cambios antes de tocar nada' : 'Pull changes before touching code'}</h3>
							<p class="gs-step-desc">{isEs ? 'Comienza tu día actualizando main con los cambios que tus compañeros integraron mientras descansabas.' : 'Start your day updating main with changes your team merged overnight.'}</p>
							<code>git switch main<br />git pull</code>
						</div>

						<div class="gs-step-card">
							<span class="gs-step-num">02</span>
							<h3 class="gs-step-title">{isEs ? 'Crea una rama específica' : 'Branch out with purpose'}</h3>
							<p class="gs-step-desc">{isEs ? 'Nunca desarrolles directamente sobre main. Aísla tu objetivo en una rama feature bien nombrada.' : 'Never code directly on main. Isolate your work in a well-named feature branch.'}</p>
							<code>git switch -c feat/user-auth</code>
						</div>

						<div class="gs-step-card">
							<span class="gs-step-num">03</span>
							<h3 class="gs-step-title">{isEs ? 'Commits pequeños y frecuentes' : 'Small and frequent commits'}</h3>
							<p class="gs-step-desc">{isEs ? 'No acumules 5 días de trabajo en un único commit gigante. Haz commits atómicos y testeables.' : 'Do not pile 5 days of work in one giant commit. Make atomic, testable commits.'}</p>
							<code>git add -p<br />git commit -m "feat(auth): validate token"</code>
						</div>

						<div class="gs-step-card">
							<span class="gs-step-num">04</span>
							<h3 class="gs-step-title">{isEs ? 'Publica con upstream tracking' : 'Push with upstream tracking'}</h3>
							<p class="gs-step-desc">{isEs ? 'Publica tu rama en el repositorio remoto configurando el seguimiento con la bandera -u.' : 'Publish your branch to the remote repository configuring tracking with -u.'}</p>
							<code>git push -u origin feat/user-auth</code>
						</div>

						<div class="gs-step-card is-span-all">
							<span class="gs-step-num">05</span>
							<h3 class="gs-step-title">{isEs ? 'Abre el Pull Request para revisión del equipo' : 'Open Pull Request for peer review'}</h3>
							<p class="gs-step-desc">{isEs ? 'En GitHub, crea el PR hacia main, describe el contexto, enlaza el ticket o issue correspondiente y espera la aprobación de CI/CD.' : 'On GitHub, open the PR against main, describe context, link the issue, and await CI/CD.'}</p>
						</div>
					</div>
				</div>
			</section>
		</main>
	</div>
</div>

<style>
	.gs-shell {
		width: 100%;
		max-width: none;
		margin: 0;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.gs-screen {
		min-height: calc(100dvh - var(--site-header-height, 0px));
		display: flex;
		flex-direction: column;
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-body);
	}

	.gs-viewport { display: flex; flex-direction: column; justify-content: center; }

	@media (min-width: 1440px) { .gs-viewport { zoom: 1.08; } }
	@media (min-width: 1680px) { .gs-viewport { zoom: 1.16; } }
	@media (min-width: 1920px) { .gs-viewport { zoom: 1.25; } }

	.gs-nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: var(--space-3) var(--space-6);
		border-bottom: 1px solid var(--color-divider);
		background: var(--color-surface);
	}

	.gs-btn {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-4);
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 600;
		color: var(--color-text);
		background: var(--color-bg);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-md);
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.gs-btn:hover:not(:disabled) {
		border-color: var(--color-accent);
		color: var(--color-accent-700);
	}

	.gs-btn:disabled {
		opacity: 0.45;
		cursor: not-allowed;
	}

	.gs-counter {
		font-size: 13px;
		font-weight: 700;
		color: color-mix(in srgb, var(--color-text) 55%, transparent);
	}

	.gs-slide {
		display: none;
		padding: var(--space-6) var(--space-8);
		max-width: 1100px;
		margin: 0 auto;
		width: 100%;
	}

	.gs-slide.is-active {
		display: block;
		animation: gsFade 0.25s ease-out;
	}

	@keyframes gsFade {
		from { opacity: 0; transform: translateY(6px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.gs-header { margin-bottom: var(--space-5); }

	.gs-kicker {
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent-700);
	}

	.gs-title {
		font-size: 26px;
		color: var(--color-text);
		margin: var(--space-1) 0 var(--space-2);
	}

	.gs-lead {
		font-size: 15px;
		color: color-mix(in srgb, var(--color-text) 70%, transparent);
		line-height: 1.5;
		margin: 0;
		max-width: 72ch;
	}

	.gs-card {
		background: var(--color-surface);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-lg);
		padding: var(--space-5);
		box-shadow: var(--shadow-sm);
