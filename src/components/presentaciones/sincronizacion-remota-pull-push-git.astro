</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const screenEl = document.querySelector('.gs-screen');
	const pageLang = screenEl?.getAttribute('data-lang') === 'en' ? 'en' : 'es';

	const prevBtn = document.getElementById('gsPrevBtn') as HTMLButtonElement;
	const nextBtn = document.getElementById('gsNextBtn') as HTMLButtonElement;
	const counter = document.getElementById('gsSlideCounter') as HTMLElement;
	const slides = document.querySelectorAll<HTMLElement>('.gs-slide');

	function updateSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;
		slides.forEach((s) => s.classList.remove('is-active'));
		document.querySelector(`.gs-slide[data-slide="${currentSlide}"]`)?.classList.add('is-active');

		if (counter) counter.textContent = `${currentSlide} / ${totalSlides}`;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	prevBtn?.addEventListener('click', () => updateSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => updateSlide(currentSlide + 1));

	window.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') updateSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') updateSlide(currentSlide - 1);
	});

	// Slide 1: Offline mode toggle
	const modeToggle = document.getElementById('gsModeToggle');
	const netStatus = document.getElementById('gsNetStatus');
	const remotePanel = document.getElementById('gsRemotePanel');
	let isOffline = false;

	modeToggle?.addEventListener('click', () => {
		isOffline = !isOffline;
		remotePanel?.classList.toggle('is-offline', isOffline);
		if (netStatus) {
			netStatus.textContent = isOffline
				? (pageLang === 'es' ? '🔴 Sin conexión (Modo Avión)' : '🔴 Offline (Airplane Mode)')
				: (pageLang === 'es' ? '🟢 Conectado a Internet' : '🟢 Connected to Internet');
		}
		if (modeToggle) {
			modeToggle.textContent = isOffline
				? (pageLang === 'es' ? 'Reconectar a Internet' : 'Reconnect to Internet')
				: (pageLang === 'es' ? 'Simular desconexión (Modo Offline)' : 'Simulate disconnection (Offline mode)');
		}
	});

	// Slide 2: Git push interactive
	const btnCommitLocal = document.getElementById('gsBtnCommitLocal') as HTMLButtonElement;
	const btnPush = document.getElementById('gsBtnPush') as HTMLButtonElement;
	const btnResetPush = document.getElementById('gsBtnResetPush') as HTMLButtonElement;

	const localLine3 = document.getElementById('gsLocalLine3');
	const localNode3 = document.getElementById('gsLocalNode3');
	const remoteLine3 = document.getElementById('gsRemoteLine3');
	const remoteNode3 = document.getElementById('gsRemoteNode3');

	const localStatusText = document.getElementById('gsLocalStatusText');
	const remoteStatusText = document.getElementById('gsRemoteStatusText');
	const pushLogText = document.getElementById('gsPushLogText');

	btnCommitLocal?.addEventListener('click', () => {
		if (localLine3) localLine3.hidden = false;
		if (localNode3) localNode3.hidden = false;
		if (localStatusText) {
			localStatusText.textContent = pageLang === 'es' ? '1 commit por delante (ahead 1)' : '1 commit ahead';
		}
		btnCommitLocal.disabled = true;
		if (btnPush) btnPush.disabled = false;
		if (pushLogText) {
			pushLogText.textContent = pageLang === 'es'
				? 'Commit C3 creado localmente. Tu rama está adelantada. Ejecuta "git push origin main" para subirlo.'
				: 'Commit C3 created locally. Your branch is ahead. Run "git push origin main" to publish.';
		}
	});

	btnPush?.addEventListener('click', () => {
		if (remoteLine3) remoteLine3.hidden = false;
		if (remoteNode3) remoteNode3.hidden = false;
		if (localStatusText) localStatusText.textContent = pageLang === 'es' ? 'Sincronizado' : 'In sync';
		if (remoteStatusText) remoteStatusText.textContent = pageLang === 'es' ? 'Actualizado en C3' : 'Updated to C3';
		if (btnPush) btnPush.disabled = true;
		if (pushLogText) {
			pushLogText.textContent = pageLang === 'es'
				? 'git push completado con éxito: origin/main ahora apunta a C3 en GitHub.'
				: 'git push succeeded: origin/main now points to C3 on GitHub.';
		}
	});

	btnResetPush?.addEventListener('click', () => {
		if (localLine3) localLine3.hidden = true;
		if (localNode3) localNode3.hidden = true;
		if (remoteLine3) remoteLine3.hidden = true;
		if (remoteNode3) remoteNode3.hidden = true;
		if (localStatusText) localStatusText.textContent = pageLang === 'es' ? 'Sincronizado' : 'In sync';
		if (remoteStatusText) remoteStatusText.textContent = pageLang === 'es' ? 'Sincronizado' : 'In sync';
		if (btnCommitLocal) btnCommitLocal.disabled = false;
		if (btnPush) btnPush.disabled = true;
		if (pushLogText) {
			pushLogText.textContent = pageLang === 'es' ? 'Simulador reiniciado a C2.' : 'Simulator reset to C2.';
		}
	});

	// Slide 3: Fetch vs Pull
	const btnFetch = document.getElementById('gsBtnFetch') as HTMLButtonElement;
	const btnPull = document.getElementById('gsBtnPull') as HTMLButtonElement;
	const btnResetFetch = document.getElementById('gsBtnResetFetch') as HTMLButtonElement;
	const refStatus = document.getElementById('gsRefStatus');
	const workingStatus = document.getElementById('gsWorkingStatus');
	const fetchExpl = document.getElementById('gsFetchExpl');

	btnFetch?.addEventListener('click', () => {
		if (refStatus) refStatus.textContent = pageLang === 'es' ? 'Apunta a C4 (¡Actualizado!)' : 'Points to C4 (Updated!)';
		if (workingStatus) workingStatus.textContent = pageLang === 'es' ? 'Aún en C2 (Tus archivos NO cambiaron)' : 'Still at C2 (Files NOT changed)';
		if (fetchExpl) {
			fetchExpl.innerHTML = `<span>✓ ${pageLang === 'es' ? 'git fetch descargó los metadatos de C4. Ahora puedes hacer "git log origin/main" para revisarlos antes de fusionar.' : 'git fetch downloaded C4 metadata. You can now run "git log origin/main" to review before merging.'}</span>`;
		}
	});

	btnPull?.addEventListener('click', () => {
		if (refStatus) refStatus.textContent = pageLang === 'es' ? 'Apunta a C4 (Actualizado)' : 'Points to C4 (Updated)';
		if (workingStatus) workingStatus.textContent = pageLang === 'es' ? 'Apunta a C4 (¡Archivos actualizados!)' : 'Points to C4 (Files updated!)';
		if (fetchExpl) {
			fetchExpl.innerHTML = `<span>✓ ${pageLang === 'es' ? 'git pull descargó C4 y fusionó directamente en tu Working Tree (Fast-Forward a C4).' : 'git pull fetched C4 and immediately merged into your Working Tree (Fast-Forward to C4).'}</span>`;
		}
	});

	btnResetFetch?.addEventListener('click', () => {
		if (refStatus) refStatus.textContent = pageLang === 'es' ? 'Apunta a C2' : 'Points to C2';
		if (workingStatus) workingStatus.textContent = pageLang === 'es' ? 'Apunta a C2 (Limpio)' : 'Points to C2 (Clean)';
		if (fetchExpl) {
			fetchExpl.innerHTML = `<span>💡 ${pageLang === 'es' ? 'Usa git fetch cuando quieras revisar qué cambios hay antes de integrarlos a ciegas.' : 'Use git fetch when you want to review changes before blindly merging them.'}</span>`;
		}
	});

	// Slide 4: Upstream Tracking
	const toggleUpstream = document.getElementById('gsToggleUpstream');
	const upstreamSection = document.getElementById('gsUpstreamSection');
	const upstreamTermResult = document.getElementById('gsUpstreamTermResult');
	let hasUpstream = true;

	toggleUpstream?.addEventListener('click', () => {
		hasUpstream = !hasUpstream;
		if (upstreamSection) upstreamSection.hidden = !hasUpstream;
		if (upstreamTermResult) {
			upstreamTermResult.innerHTML = hasUpstream
				? `<span class="gs-tc-green">Everything up-to-date</span><br /><small>Branch 'main' set up to track remote branch 'main' from 'origin'.</small>`
				: `<span class="gs-tc-red">fatal: The current branch main has no upstream branch.</span><br /><small>To push the current branch and set the remote as upstream, use:<br />    git push --set-upstream origin main</small>`;
		}
	});

	// Slide 5: Divergence simulation
	const step1Btn = document.getElementById('gsStep1Btn') as HTMLButtonElement;
	const step2Btn = document.getElementById('gsStep2Btn') as HTMLButtonElement;
	const step3Btn = document.getElementById('gsStep3Btn') as HTMLButtonElement;
	const mergeLine = document.getElementById('gsMergeLine');
	const divergeTerm = document.getElementById('gsDivergeTerm');

	step1Btn?.addEventListener('click', () => {
		step1Btn.classList.add('is-active');
		step2Btn.classList.remove('is-active');
		step3Btn.classList.remove('is-active');
		step2Btn.disabled = false;
		if (mergeLine) mergeLine.hidden = true;
		if (divergeTerm) {
			divergeTerm.innerHTML = `<code><span class="gs-tc-red">! [rejected]        main -> main (non-fast-forward)</span>\nerror: failed to push some refs to 'github.com:org/repo.git'\n<span class="gs-tc-bold">hint: Updates were rejected because the remote contains work that you do</span>\n<span class="gs-tc-bold">hint: not have locally. First integrate with git pull.</span></code>`;
		}
	});

	step2Btn?.addEventListener('click', () => {
		step1Btn.classList.remove('is-active');
		step2Btn.classList.add('is-active');
		step3Btn.classList.remove('is-active');
		step3Btn.disabled = false;
		if (mergeLine) mergeLine.hidden = false;
		if (divergeTerm) {
			divergeTerm.innerHTML = `<code><span class="gs-tc-green">$ git pull origin main</span>\nAuto-merging src/index.ts\nMerge made by the 'ort' strategy.\n<span class="gs-tc-bold">✓ Creado commit de fusión M (integrando C3 y C4). Listo para empujar.</span></code>`;
		}
	});

	step3Btn?.addEventListener('click', () => {
		step1Btn.classList.remove('is-active');
		step2Btn.classList.remove('is-active');
		step3Btn.classList.add('is-active');
		if (divergeTerm) {
			divergeTerm.innerHTML = `<code><span class="gs-tc-green">$ git push origin main</span>\nEnumerating objects: 10, done.\nTo github.com:org/repo.git\n   c2a10..m781b  main -> main\n<span class="gs-tc-bold">✓ ¡Éxito! Ambos historiales quedaron integrados en el remoto.</span></code>`;
		}
	});
</script>
