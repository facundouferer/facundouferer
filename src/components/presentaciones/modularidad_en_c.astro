<span class="code-comment">// BY REFERENCE: duplicates the original</span><br>
<span class="code-keyword">void</span> <span class="code-func">duplicar</span>(<span class="code-type">int</span> *<span class="code-var" style="color:#f0abfc">p</span>) &lbrace;<br>
<span style="padding-left:16px">*<span class="code-var" style="color:#f0abfc">p</span> *= <span class="code-number">2</span>;</span><br>
&rbrace;<br><br>
<span class="code-type">int</span> <span class="code-func">main</span>() &lbrace;<br>
<span style="padding-left:16px"><span class="code-comment">// formals: base, altura — actuals: 5, 10</span></span><br>
<span style="padding-left:16px"><span class="code-type">int</span> <span class="code-var">area</span> = <span class="code-func">areaRectangulo</span>(<span class="code-number">5</span>, <span class="code-number">10</span>);</span><br>
<span style="padding-left:16px"><span class="code-func">imprimirResultado</span>(<span class="code-var">area</span>); <span class="code-comment">// 50</span></span><br><br>
<span style="padding-left:16px"><span class="code-func">duplicar</span>(&amp;<span class="code-var">area</span>);          <span class="code-comment">// passes address — by reference</span></span><br>
<span style="padding-left:16px"><span class="code-func">imprimirResultado</span>(<span class="code-var">area</span>); <span class="code-comment">// 100</span></span><br><br>
<span style="padding-left:16px"><span class="code-func">printf</span>(<span class="code-string">"Llamadas: %d\n"</span>, <span class="code-var" style="color:#fcd34d">llamadas</span>); <span class="code-comment">// 1</span></span><br>
<span style="padding-left:16px"><span class="code-keyword">return</span> <span class="code-number">0</span>;</span><br>
&rbrace;
					</div>

					<div class="flex gap-4 mt-6 flex-wrap">
						<div class="anim-item type-card flex-1" style="--delay: 300ms; min-width:200px">
							<p class="text-xs opacity-50 mb-1" style="color:#fcd34d">{lang === 'en' ? 'GLOBAL' : 'GLOBAL'}</p>
							<p class="text-xs"><code style="color:#fcd34d">llamadas</code> &mdash; {lang === 'en' ? 'visible in all functions' : 'visible en todas las funciones'}</p>
						</div>
						<div class="anim-item type-card flex-1" style="--delay: 380ms; min-width:200px">
							<p class="text-xs opacity-50 mb-1" style="color:#a5f3fc">{lang === 'en' ? 'LOCAL' : 'LOCAL'}</p>
							<p class="text-xs"><code>area</code> {lang === 'en' ? 'inside' : 'dentro de'} <code style="color:#98c379">areaRectangulo</code> &mdash; {lang === 'en' ? 'only there' : 'solo ahí'}</p>
						</div>
						<div class="anim-item type-card flex-1" style="--delay: 460ms; min-width:200px">
							<p class="text-xs opacity-50 mb-1" style="color:#f0abfc">{lang === 'en' ? 'POINTER' : 'PUNTERO'}</p>
							<p class="text-xs"><code style="color:#f0abfc">*p</code> {lang === 'en' ? 'in' : 'en'} <code style="color:#98c379">duplicar</code> &mdash; {lang === 'en' ? 'modifies the original' : 'modifica el original'}</p>
						</div>
					</div>
				</div>
			</section>

			<hr class="section-divider" />

			<!-- ======================== SECTION 13: REGLAS DE ORO ======================== -->
			<section class="section section-hidden" id="sec-reglas">
				<div class="section-inner">
					<div class="anim-item text-center mb-10" style="--delay: 0ms">
						<h2 class="font-retro text-4xl md:text-6xl uppercase tracking-tight">{lang === 'en' ? 'Golden Rules' : 'Reglas de Oro'}</h2>
						<p class="text-sm opacity-50 mt-2">{lang === 'en' ? 'Burn them into memory. Forever.' : 'Grabátelas. Para siempre.'}</p>
					</div>

					<div class="space-y-4">
						<div class="rule-card anim-item" style="--delay: 100ms">
							<span class="rule-num">01</span>
							<div>
								<p class="font-retro text-xl">{lang === 'en' ? 'Modularize: short functions that do ONE thing' : 'Modularizá: funciones cortas que hacen UNA cosa'}</p>
								<p class="text-xs opacity-50 mt-1">{lang === 'en' ? 'If your function needs a comment explaining what it does, its too long.' : 'Si tu función necesita un comentario explicando qué hace, es demasiado larga.'}</p>
							</div>
						</div>

						<div class="rule-card anim-item" style="--delay: 200ms">
							<span class="rule-num">02</span>
							<div>
								<p class="font-retro text-xl">{lang === 'en' ? 'Prefer local variables over globals' : 'Preferí variables locales sobre globales'}</p>
								<p class="text-xs opacity-50 mt-1">{lang === 'en' ? 'Globals create hidden dependencies and impossible-to-track bugs.' : 'Las globales crean dependencias ocultas y bugs imposibles de rastrear.'}</p>
							</div>
						</div>

						<div class="rule-card anim-item" style="--delay: 300ms">
							<span class="rule-num">03</span>
							<div>
								<p class="font-retro text-xl">{lang === 'en' ? 'Pass by value: safe, the original does not change' : 'Paso por valor: seguro, el original no cambia'}</p>
								<p class="text-xs opacity-50 mt-1">{lang === 'en' ? 'Use it when you only need to read or calculate something from the data.' : 'Usálo cuando solo necesitás leer o calcular algo a partir del dato.'}</p>
							</div>
						</div>

						<div class="rule-card anim-item" style="--delay: 400ms">
							<span class="rule-num">04</span>
							<div>
								<p class="font-retro text-xl">{lang === 'en' ? 'Pass by reference (*pointers): when you NEED to modify the original' : 'Paso por referencia (*punteros): cuando NECESITÁS modificar el original'}</p>
								<p class="text-xs opacity-50 mt-1">{lang === 'en' ? 'Be explicit. Whoever reads the code needs to know the function has side effects.' : 'Sé explícito. Quien lee el código necesita saber que la función tiene efectos secundarios.'}</p>
							</div>
						</div>

						<div class="rule-card anim-item" style="--delay: 500ms">
							<span class="rule-num">05</span>
							<div>
								<p class="font-retro text-xl">{lang === 'en' ? 'Formal parameters = definition, actuals = call' : 'Parámetros nominales = definición, efectivos = llamada'}</p>
								<p class="text-xs opacity-50 mt-1">{lang === 'en' ? 'The order of actuals must match the order of formals. Always.' : 'El orden de los efectivos tiene que coincidir con el de los nominales. Siempre.'}</p>
							</div>
						</div>

						<div class="rule-card anim-item" style="--delay: 600ms">
							<span class="rule-num">06</span>
							<div>
								<p class="font-retro text-xl">{lang === 'en' ? 'Each function = one responsibility' : 'Cada función = una responsabilidad'}</p>
								<p class="text-xs opacity-50 mt-1">{lang === 'en' ? 'Single Responsibility Principle. It applies in C, in any language, in any paradigm.' : 'Single Responsibility Principle. Vale en C, vale en cualquier lenguaje, vale en cualquier paradigma.'}</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<hr class="section-divider" />

			<!-- ======================== SECTION 14: FIN ======================== -->
			<section class="section section-hidden" id="sec-fin">
				<div class="section-inner text-center">
					<div class="anim-item" style="--delay: 0ms">
						<div class="text-xs tracking-widest opacity-30 font-retro text-lg mb-8">EOF // END_OF_PRESENTATION</div>
					</div>

					<div class="anim-item" style="--delay: 150ms">
						<div class="font-retro" style="font-size:clamp(3rem,10vw,8rem); text-shadow: 0 0 30px rgba(13,242,89,0.6); animation: float-slow 4s ease-in-out infinite">
							&gt;_
						</div>
					</div>

					<div class="anim-item mt-4" style="--delay: 300ms">
						<h2 class="font-retro text-4xl md:text-6xl uppercase tracking-tight">{lang === 'en' ? 'SESSION ENDED' : 'SESIÓN FINALIZADA'}</h2>
					</div>

					<div class="anim-item mt-4 mb-10" style="--delay: 450ms">
						<p class="text-sm opacity-50">{lang === 'en' ? 'Now you know how to modularize in C. Now think in modules.' : 'Ahora sabés modularizar en C. Ahora pensá en módulos.'}</p>
					</div>

					<div class="anim-item" style="--delay: 600ms">
						<a href={withBase(lang === 'en' ? '/en/presentaciones' : '/presentaciones')} class="terminal-btn">
							&#x2190; {lang === 'en' ? 'Back to Presentations' : 'Volver a Presentaciones'}
						</a>
					</div>

					<div class="anim-item mt-16 opacity-20" style="--delay: 800ms">
						<p class="font-retro text-sm tracking-widest">PROGRAMIERDS &mdash; 2026</p>
					</div>
				</div>
			</section>

		</main>
	</div>

	<script>
		// ==================== PROGRESS BAR ====================
		const progressBar = document.getElementById('progress-bar') as HTMLElement;

		function updateProgressBar(): void {
			const scrollTop = window.scrollY;
			const docHeight = document.documentElement.scrollHeight - window.innerHeight;
			const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
			progressBar.style.width = `${pct}%`;
		}

		window.addEventListener('scroll', updateProgressBar, { passive: true });

		// ==================== INTRO TYPING ====================
		function initIntroTyping(): void {
			const el = document.getElementById('intro-subtitle');
			if (el) el.classList.add('typing-active');
		}

		// ==================== INTERSECTION OBSERVER ====================
		const hiddenSections = document.querySelectorAll<HTMLElement>('.section-hidden');

		let valorAnimTriggered = false;
		let refAnimTriggered   = false;

		function triggerValorAnimation(): void {
			if (valorAnimTriggered) return;
			valorAnimTriggered = true;

			const stepIds = ['valor-step-0', 'valor-step-1', 'valor-step-2', 'valor-step-3', 'valor-step-4'];

			const boxN   = document.getElementById('box-inc-n') as HTMLElement | null;
			const valN   = document.getElementById('val-inc-n') as HTMLElement | null;
			const incFrm = document.getElementById('inc-frame') as HTMLElement | null;
			const mainB  = document.getElementById('box-main-x') as HTMLElement | null;

			setTimeout(() => {
				const s = document.getElementById(stepIds[0]);
				if (s) { s.classList.remove('step-hidden'); s.classList.add('step-active'); }
			}, 300);

			setTimeout(() => {
				const s = document.getElementById(stepIds[1]);
				if (s) { s.classList.remove('step-hidden'); s.classList.add('step-active'); }
				if (boxN) boxN.style.animation = 'appear 0.6s ease forwards';
			}, 1200);

			setTimeout(() => {
				const s = document.getElementById(stepIds[2]);
				if (s) { s.classList.remove('step-hidden'); s.classList.add('step-active'); }
				if (valN) { valN.textContent = '6'; valN.style.color = '#e06c75'; }
				if (boxN) { boxN.style.borderColor = '#e06c75'; }
			}, 2200);

			setTimeout(() => {
				const s = document.getElementById(stepIds[3]);
				if (s) { s.classList.remove('step-hidden'); s.classList.add('step-active'); }
				if (incFrm) incFrm.style.animation = 'dissolve 1s ease forwards';
			}, 3200);

			setTimeout(() => {
				const s = document.getElementById(stepIds[4]);
				if (s) { s.classList.remove('step-hidden'); s.classList.add('step-active'); }
				if (mainB) {
					mainB.style.borderColor = '#0df259';
					mainB.style.boxShadow = '0 0 16px rgba(13,242,89,0.5)';
				}
			}, 4400);
		}

		function triggerRefAnimation(): void {
			if (refAnimTriggered) return;
			refAnimTriggered = true;

			const stepIds = ['ref-step-0', 'ref-step-1', 'ref-step-2', 'ref-step-3', 'ref-step-4'];

			const refX    = document.getElementById('box-ref-x') as HTMLElement | null;
			const valRefX = document.getElementById('val-ref-x') as HTMLElement | null;
			const refP    = document.getElementById('box-ref-p') as HTMLElement | null;
			const refFrm  = document.getElementById('ref-frame') as HTMLElement | null;

			setTimeout(() => {
				const s = document.getElementById(stepIds[0]);
				if (s) { s.classList.remove('step-hidden'); s.classList.add('step-active'); }
			}, 300);

			setTimeout(() => {
				const s = document.getElementById(stepIds[1]);
				if (s) { s.classList.remove('step-hidden'); s.classList.add('step-active'); }
				if (refP) refP.style.animation = 'appear 0.6s ease forwards';
			}, 1200);

			setTimeout(() => {
				const s = document.getElementById(stepIds[2]);
				if (s) { s.classList.remove('step-hidden'); s.classList.add('step-active'); }
				if (refP) refP.style.boxShadow = '0 0 20px rgba(217,70,239,0.8)';
			}, 2200);

			setTimeout(() => {
				const s = document.getElementById(stepIds[3]);
				if (s) { s.classList.remove('step-hidden'); s.classList.add('step-active'); }
				if (refFrm) refFrm.style.animation = 'dissolve 1s ease forwards';
			}, 3200);

			setTimeout(() => {
				const s = document.getElementById(stepIds[4]);
				if (s) { s.classList.remove('step-hidden'); s.classList.add('step-active'); }
				if (valRefX) { valRefX.textContent = '10'; valRefX.style.color = '#fca5a5'; }
				if (refX) {
					refX.style.borderColor = '#fca5a5';
					refX.style.boxShadow = '0 0 16px rgba(252,165,165,0.5)';
				}
			}, 4400);
		}

		function triggerSectionAnimations(sectionId: string): void {
			switch (sectionId) {
				case 'sec-intro':
					initIntroTyping();
					break;
				case 'sec-por-valor':
					setTimeout(triggerValorAnimation, 400);
					break;
				case 'sec-por-ref':
					setTimeout(triggerRefAnimation, 400);
					break;
				default:
					break;
			}
		}

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const section = entry.target as HTMLElement;
						section.classList.remove('section-hidden');
						section.classList.add('section-visible');
						triggerSectionAnimations(section.id);
					}
				});
			},
			{ threshold: 0.2 }
		);

		hiddenSections.forEach((section) => observer.observe(section));

		// Initial check for sections already visible on load
		hiddenSections.forEach((section) => {
			const rect = section.getBoundingClientRect();
			if (rect.top < window.innerHeight * 0.85) {
				section.classList.remove('section-hidden');
				section.classList.add('section-visible');
				triggerSectionAnimations(section.id);
			}
		});

		updateProgressBar();
	</script>
