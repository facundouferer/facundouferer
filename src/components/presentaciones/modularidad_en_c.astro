---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="mc-screen">
	<div class="mc-shell">
		<header class="mc-header">
			<span class="mc-badge">{isEs ? 'Arquitectura de Software' : 'Software Architecture'}</span>
			<h1 class="mc-title">
				{isEs ? 'Modularidad, Funciones y Alcance' : 'Modularity, Functions & Scope'}
			</h1>
			<p class="mc-sub">
				{isEs 
					? 'Diseño modular y gestión del Call Stack en C, JavaScript, Python y Java.' 
					: 'Modular design and Call Stack management in C, JavaScript, Python, and Java.'}
			</p>
		</header>

		<div class="mc-deck-card">
			<div class="mc-nav-bar">
				<div class="mc-slide-indicator">
					<span class="mc-step-dot"></span>
					<span id="mc-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="mc-pills">
					<button class="mc-pill-btn active" data-target-slide="1">1. {isEs ? 'Principios' : 'Principles'}</button>
					<button class="mc-pill-btn" data-target-slide="2">2. {isEs ? 'Funciones vs Procedimientos' : 'Functions vs Procedures'}</button>
					<button class="mc-pill-btn" data-target-slide="3">3. {isEs ? 'Alcance (Scope)' : 'Scope Rules'}</button>
					<button class="mc-pill-btn" data-target-slide="4">4. {isEs ? 'Firmas & Overloading' : 'Signatures'}</button>
					<button class="mc-pill-btn" data-target-slide="5">5. {isEs ? 'Call Stack' : 'Call Stack'}</button>
					<button class="mc-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador Stack' : 'Stack Sim'}</button>
				</div>
			</div>

			<div class="mc-viewport">
				<!-- SLIDE 1: PRINCIPLES -->
				<div class="mc-slide active" data-slide="1">
					<div class="mc-slide-grid">
						<div class="mc-col">
							<h2 class="mc-slide-title">1. {isEs ? 'Principios de la Modularidad' : 'Principles of Modularity'}</h2>
							<p class="mc-text">
								{isEs 
									? 'La modularidad consiste en dividir un sistema complejo en partes independientes (módulos o subprogramas) con responsabilidades únicas.'
									: 'Modularity divides complex systems into independent modules/subprograms with single responsibilities.'}
							</p>
							<div class="mc-concept-box">
								<div class="mc-concept-item">
									<strong class="mc-accent-text">{isEs ? 'Reusabilidad:' : 'Reusability:'}</strong>
									<span>{isEs ? 'Escribir una solución una vez e invocarla múltiples veces.' : 'Write once, invoke anywhere.'}</span>
								</div>
								<div class="mc-concept-item">
									<strong class="mc-accent-text">{isEs ? 'Abstracción:' : 'Abstraction:'}</strong>
									<span>{isEs ? 'Ocultar los detalles de implementación detrás de una interfaz clara.' : 'Hide implementation details behind clean interfaces.'}</span>
								</div>
							</div>
						</div>
						<div class="mc-col">
							<div class="mc-arch-card">
								<div class="mc-arch-head">{isEs ? 'ARQUITECTURA DE MÓDULOS' : 'MODULE ARCHITECTURE'}</div>
								<div class="mc-module-root">[Main Application]</div>
								<div class="mc-module-tree">
									<span>├── [Math Module]</span>
									<span>├── [Auth Module]</span>
									<span>└── [UI Renderer]</span>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 2: FUNCTIONS VS PROCEDURES -->
				<div class="mc-slide" data-slide="2">
					<div class="mc-slide-grid">
						<div class="mc-col">
							<h2 class="mc-slide-title">2. {isEs ? 'Funciones vs Procedimientos' : 'Functions vs Procedures'}</h2>
							<ul class="mc-list">
								<li><strong>{isEs ? 'Función Pura:' : 'Pure Function:'}</strong> {isEs ? 'Procesa argumentos y retorna un valor calculado sin efectos secundarios.' : 'Computes and returns a value without side effects.'}</li>
								<li><strong>{isEs ? 'Procedimiento (Void):' : 'Procedure (Void):'}</strong> {isEs ? 'Ejecuta acciones (E/S, mutaciones) y retorna void (o None/undefined).' : 'Executes actions (I/O, mutations) and returns void (or None/undefined).'}</li>
							</ul>
						</div>
						<div class="mc-col">
							<div class="mc-code-card">
								<div class="mc-code-title">modularity.c</div>
								<pre class="mc-code-block"><code><span class="token-comment">// Función (Retorna int)</span>
<span class="token-type">int</span> sumar(<span class="token-type">int</span> a, <span class="token-type">int</span> b) &#123;
    <span class="token-keyword">return</span> a + b;
&#125;

<span class="token-comment">// Procedimiento (Efecto secundario)</span>
<span class="token-keyword">void</span> imprimir_reporte() &#123;
    printf(<span class="token-string">"Proceso completado\n"</span>);
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 3: SCOPE RULES -->
				<div class="mc-slide" data-slide="3">
					<div class="mc-slide-grid">
						<div class="mc-col">
							<h2 class="mc-slide-title">3. {isEs ? 'Reglas de Alcance (Scope)' : 'Scope Rules'}</h2>
							<p class="mc-text">
								{isEs 
									? 'El alcance define la visibilidad y vida útil de una variable dentro del programa.'
									: 'Scope defines variable visibility and lifetime within the program.'}
							</p>
							<div class="mc-concept-box">
								<div class="mc-concept-item"><strong class="mc-accent-text">C / Java:</strong> {isEs ? 'Alcance de bloque {...} y ámbito global/clase.' : 'Block scope {...} and global/class scope.'}</div>
								<div class="mc-concept-item"><strong class="mc-accent-text">JavaScript:</strong> {isEs ? 'Scope de bloque (let/const), función (var) y Lexical Closures.' : 'Block scope (let/const), function scope (var), and Lexical Closures.'}</div>
								<div class="mc-concept-item"><strong class="mc-accent-text">Python:</strong> {isEs ? 'Regla LEGB (Local, Enclosing, Global, Built-in).' : 'LEGB Rule (Local, Enclosing, Global, Built-in).'}</div>
							</div>
						</div>
						<div class="mc-col">
							<div class="mc-code-card">
								<div class="mc-code-title">scope.js</div>
								<pre class="mc-code-block"><code><span class="token-keyword">let</span> globalVar = <span class="token-string">"Global"</span>;

<span class="token-keyword">function</span> testScope() &#123;
    <span class="token-keyword">let</span> localVar = <span class="token-string">"Local"</span>;
    <span class="token-keyword">if</span> (<span class="token-keyword">true</span>) &#123;
        <span class="token-keyword">let</span> blockVar = <span class="token-string">"Block"</span>;
    &#125;
    <span class="token-comment">// blockVar no es accesible aquí</span>
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 4: SIGNATURES & OVERLOADING -->
				<div class="mc-slide" data-slide="4">
					<div class="mc-slide-grid">
						<div class="mc-col">
							<h2 class="mc-slide-title">4. {isEs ? 'Firmas y Funciones de Primera Clase' : 'Signatures & First-Class Functions'}</h2>
							<ul class="mc-list">
								<li><strong>Java:</strong> {isEs ? 'Sobrecarga estricta (mismo nombre, distintos parámetros).' : 'Strict overloading (same name, different parameter types).'}</li>
								<li><strong>C:</strong> {isEs ? 'Prototipos únicos. No permite sobrecarga nativa.' : 'Unique prototypes. No native overloading.'}</li>
								<li><strong>JS / Python:</strong> {isEs ? 'Funciones como ciudadanos de primera clase (se pasan como argumentos).' : 'First-class functions (passed as arguments/higher-order).'}</li>
							</ul>
						</div>
						<div class="mc-col">
							<div class="mc-code-card">
								<div class="mc-code-title">Overloading.java</div>
								<pre class="mc-code-block"><code><span class="token-keyword">public class</span> MathUtils &#123;
    <span class="token-keyword">public static int</span> add(<span class="token-type">int</span> a, <span class="token-type">int</span> b) &#123; <span class="token-keyword">return</span> a + b; &#125;
    <span class="token-keyword">public static double</span> add(<span class="token-type">double</span> a, <span class="token-type">double</span> b) &#123; <span class="token-keyword">return</span> a + b; &#125;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 5: CALL STACK -->
				<div class="mc-slide" data-slide="5">
					<div class="mc-slide-grid">
						<div class="mc-col">
							<h2 class="mc-slide-title">5. {isEs ? 'El Call Stack y Recursión' : 'The Call Stack & Recursion'}</h2>
							<p class="mc-text">
								{isEs 
									? 'Cada llamada a función crea un marco (Stack Frame) con sus parámetros y variables locales. Al retornar, el marco se destruye (LIFO).'
									: 'Each function call creates a Stack Frame with parameters and local variables. On return, frame is popped (LIFO).'}
							</p>
							<div class="mc-concept-box">
								<div class="mc-concept-item"><strong class="mc-accent-text">Recursión:</strong> {isEs ? 'Función que se llama a sí misma. Requiere caso base para evitar StackOverflow.' : 'Function calling itself. Requires base case to prevent StackOverflow.'}</div>
							</div>
						</div>
						<div class="mc-col">
							<div class="mc-code-card">
								<div class="mc-code-title">recursion.py</div>
								<pre class="mc-code-block"><code><span class="token-keyword">def</span> factorial(n):
    <span class="token-keyword">if</span> n &lt;= <span class="token-number">1</span>:
        <span class="token-keyword">return</span> <span class="token-number">1</span> <span class="token-comment"># Caso base</span>
    <span class="token-keyword">return</span> n * factorial(n - <span class="token-number">1</span>)

print(factorial(<span class="token-number">3</span>)) <span class="token-comment"># 3 * 2 * 1 = 6</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 6: STACK SIMULATOR -->
				<div class="mc-slide" data-slide="6">
					<div class="mc-sim-container">
						<h2 class="mc-slide-title center">{isEs ? '6. Simulador Interactivo de Call Stack' : '6. Call Stack Simulator'}</h2>
						<p class="mc-sub center">{isEs ? 'Simulá la pila de llamadas durante la ejecución:' : 'Simulate stack frame push/pop during execution:'}</p>

						<div class="mc-sim-selector">
							<button class="mc-lang-btn active" data-lang="c">C (Nested Functions)</button>
							<button class="mc-lang-btn" data-lang="js">JavaScript (Closures)</button>
							<button class="mc-lang-btn" data-lang="py">Python (Recursion)</button>
							<button class="mc-lang-btn" data-lang="java">Java (Static Call)</button>
						</div>

						<div class="mc-sim-console">
							<div class="mc-sim-head">
								<span class="mc-console-label" id="mc-sim-title">C Execution Trace</span>
							</div>
							<div class="mc-sim-body">
								<div class="mc-trace-step" id="mc-sim-step">
									Paso 1: main() es empujado al Call Stack.
								</div>
								<div class="mc-stack-display" id="mc-sim-stack">
									[CALL STACK: main()]
								</div>
							</div>
							<div class="mc-sim-actions">
								<button class="btn btn-primary" id="btn-next-mc-step">
									▶ {isEs ? 'Siguiente Paso (Push/Pop)' : 'Next Step (Push/Pop)'}
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="mc-footer">
				<button class="btn btn-secondary" id="btn-prev-mc" disabled>
					← {isEs ? 'Anterior' : 'Previous'}
				</button>
				<div class="mc-footer-meta">
					<span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span>
				</div>
				<button class="btn btn-primary" id="btn-next-mc">
					{isEs ? 'Siguiente' : 'Next'} →
				</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');

	.mc-screen {
		min-height: 80vh;
		font-family: var(--font-body);
		color: var(--color-text);
		padding: 1.5rem 1rem 4rem;
	}

	.mc-shell { max-width: var(--container-max); margin: 0 auto; }
	.mc-header { margin-bottom: 1.5rem; }

	.mc-badge {
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--color-accent-2-300);
		background: var(--color-accent-2-100);
		color: var(--color-accent-2-700);
		border-radius: 999px;
		padding: 0.25rem 0.8rem;
		font-size: 0.75rem;
		font-family: 'Fira Code', monospace;
		font-weight: 600;
	}

	.mc-title {
		font-family: var(--font-heading);
		font-size: clamp(1.8rem, 3.5vw, 2.5rem);
		font-weight: 400;
		line-height: 1.15;
		color: var(--color-text);
		margin: 0.5rem 0 0.25rem;
	}

	.mc-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.mc-sub.center { text-align: center; }

	.mc-deck-card {
		background: var(--color-surface);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-md);
		overflow: hidden;
	}

	.mc-nav-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		padding: 0.8rem 1.2rem;
		border-bottom: 1px solid var(--color-divider);
		background: color-mix(in srgb, var(--color-bg) 60%, transparent);
	}

	.mc-slide-indicator {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: 'Fira Code', monospace;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--color-accent-700);
	}

	.mc-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.mc-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }

	.mc-pill-btn {
		border: 1px solid var(--color-divider);
		background: var(--color-bg);
		color: var(--color-text);
		border-radius: 999px;
		padding: 0.3rem 0.75rem;
		font-size: 0.78rem;
		font-family: var(--font-body);
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.mc-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.mc-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }

	.mc-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.mc-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.mc-slide.active { display: block; opacity: 1; transform: translateY(0); }

	.mc-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.mc-col { grid-column: span 12; }
	@media (min-width: 900px) { .mc-col { grid-column: span 6; } }

	.mc-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.mc-slide-title.center { text-align: center; }

	.mc-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.mc-concept-box { display: flex; flex-direction: column; gap: 0.6rem; }
	.mc-concept-item { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.65rem 0.9rem; font-size: 0.88rem; line-height: 1.5; }
	.mc-accent-text { color: var(--color-accent-700); }

	.mc-list { padding-left: 1.2rem; margin: 0 0 1.2rem; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.9rem; }

	.mc-arch-card { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.mc-arch-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.mc-module-root { font-family: 'Fira Code', monospace; font-size: 0.85rem; font-weight: 700; color: var(--color-accent-700); margin-bottom: 0.5rem; }
	.mc-module-tree { display: flex; flex-direction: column; gap: 0.3rem; font-family: 'Fira Code', monospace; font-size: 0.8rem; color: var(--color-text); padding-left: 0.5rem; }

	.mc-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.mc-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.mc-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }

	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }

	/* Simulator */
	.mc-sim-container { max-width: 800px; margin: 0 auto; }
	.mc-sim-selector { display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap; }
	.mc-lang-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.35rem 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease; }
	.mc-lang-btn:hover { background: var(--color-accent-100); color: var(--color-accent-700); }
	.mc-lang-btn.active { background: var(--color-accent-700); border-color: var(--color-accent-700); color: #ffffff; }

	.mc-sim-console { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-md); }
	.mc-sim-head { background: #2b2722; padding: 0.5rem 0.8rem; }
	.mc-console-label { color: #c0b6a5; font-family: 'Fira Code', monospace; font-size: 0.75rem; }
	.mc-sim-body { padding: 1rem; display: flex; flex-direction: column; gap: 0.8rem; }
	.mc-trace-step { font-size: 0.88rem; line-height: 1.5; color: #f9f4ed; background: #2a2520; padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); }
	.mc-stack-display { font-family: 'Fira Code', monospace; font-size: 0.8rem; color: #76d7c4; background: #141210; padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); }
	.mc-sim-actions { padding: 0.8rem 1rem; background: #25211d; display: flex; justify-content: flex-end; border-top: 1px solid #3a352e; }

	.mc-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.mc-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;
	let currentMcStep = 0;

	const mcTraceData = {
		c: {
			title: 'C: Nested Modular Calls',
			steps: [
				'Paso 1: main() entra a la pila.',
				'Paso 2: main() invoca calcularTotal(). PUSH al Call Stack.',
				'Paso 3: calcularTotal() invoca aplicarDescuento(). PUSH al Call Stack.',
				'Paso 4: aplicarDescuento() retorna el valor. POP del Call Stack.',
				'Paso 5: calcularTotal() y main() finalizan su ejecución.'
			],
			stacks: [
				'[CALL STACK: main()]',
				'[CALL STACK: main() -> calcularTotal()]',
				'[CALL STACK: main() -> calcularTotal() -> aplicarDescuento()]',
				'[CALL STACK: main() -> calcularTotal()] (aplicarDescuento POP)',
				'[CALL STACK: (vacio)]'
			]
		},
		js: {
			title: 'JavaScript: Lexical Closures in Stack',
			steps: [
				'Paso 1: Global Execution Context creado.',
				'Paso 2: crearContador() invocado. Marco de función creado.',
				'Paso 3: Retorna función interna cerrando sobre la variable de alcance Lexical.',
				'Paso 4: contador() invocado resolviendo variable retenida en memoria.'
			],
			stacks: [
				'[Global Context]',
				'[Global] -> [crearContador()]',
				'[Global] (crearContador retorne closure)',
				'[Global] -> [incrementar() -> Closure scope]'
			]
		},
		py: {
			title: 'Python: Recursive Factorial Call Stack',
			steps: [
				'Paso 1: factorial(3) PUSH al Call Stack.',
				'Paso 2: factorial(2) PUSH al Call Stack.',
				'Paso 3: factorial(1) PUSH al Call Stack (Caso Base alcanzado).',
				'Paso 4: Retornos en cadena: POP factorial(1), POP factorial(2), POP factorial(3).'
			],
			stacks: [
				'[factorial(3)]',
				'[factorial(3) -> factorial(2)]',
				'[factorial(3) -> factorial(2) -> factorial(1)]',
				'[factorial(3) -> 6] (POP completado)'
			]
		},
		java: {
			title: 'Java: Static Class Method Invocation',
			steps: [
				'Paso 1: Main.main() entra a la pila.',
				'Paso 2: Invoca MathUtils.add(a, b). PUSH marco estático.',
				'Paso 3: Retorna el resultado primitivo y destruye el marco.'
			],
			stacks: [
				'[Main.main()]',
				'[Main.main() -> MathUtils.add()]',
				'[Main.main()]'
			]
		}
	};

	let selectedMcLang: keyof typeof mcTraceData = 'c';

	const updateMcTraceView = () => {
		const langInfo = mcTraceData[selectedMcLang];
		const stepEl = document.getElementById('mc-sim-step');
		const stackEl = document.getElementById('mc-sim-stack');
		const titleEl = document.getElementById('mc-sim-title');

		if (titleEl) titleEl.textContent = langInfo.title;
		if (stepEl) stepEl.textContent = langInfo.steps[currentMcStep];
		if (stackEl) stackEl.textContent = langInfo.stacks[currentMcStep];
	};

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;

		document.querySelectorAll('.mc-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});

		document.querySelectorAll('.mc-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});

		const labelEl = document.getElementById('mc-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;

		const prevBtn = document.getElementById('btn-prev-mc') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-mc') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.mc-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-mc')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-mc')?.addEventListener('click', () => goToSlide(currentSlide + 1));

	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	document.querySelectorAll('.mc-lang-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			document.querySelectorAll('.mc-lang-btn').forEach(b => b.classList.remove('active'));
			const targetBtn = e.currentTarget as HTMLElement;
			targetBtn.classList.add('active');
			selectedMcLang = (targetBtn.dataset.lang || 'c') as keyof typeof mcTraceData;
			currentMcStep = 0;
			updateMcTraceView();
		});
	});

	document.getElementById('btn-next-mc-step')?.addEventListener('click', () => {
		currentMcStep = (currentMcStep + 1) % mcTraceData[selectedMcLang].steps.length;
		updateMcTraceView();
	});

	goToSlide(1);
	updateMcTraceView();
</script>
