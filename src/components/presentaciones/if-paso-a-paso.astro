---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="if-screen">
	<div class="if-shell">
		<header class="if-header">
			<span class="if-badge">{isEs ? 'Control de Flujo' : 'Control Flow'}</span>
			<h1 class="if-title">
				{isEs ? 'Condicional If Paso a Paso' : 'If Conditional Step by Step'}
			</h1>
			<p class="if-sub">
				{isEs 
					? 'Evaluación booleana y ramas condicionales en C, JavaScript, Python y Java.' 
					: 'Boolean evaluation and conditional branching in C, JavaScript, Python, and Java.'}
			</p>
		</header>

		<div class="if-deck-card">
			<div class="if-nav-bar">
				<div class="if-slide-indicator">
					<span class="if-step-dot"></span>
					<span id="if-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="if-pills">
					<button class="if-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="if-pill-btn" data-target-slide="2">2. C</button>
					<button class="if-pill-btn" data-target-slide="3">3. Java</button>
					<button class="if-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="if-pill-btn" data-target-slide="5">5. Python</button>
					<button class="if-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="if-viewport">
				<!-- SLIDE 1 -->
				<div class="if-slide active" data-slide="1">
					<div class="if-slide-grid">
						<div class="if-col">
							<h2 class="if-slide-title">1. {isEs ? 'Bifurcaciones Condicionales' : 'Conditional Branching'}</h2>
							<p class="if-text">
								{isEs 
									? 'La sentencia `if` evalúa una expresión booleana. Si el resultado es verdadero (true / no-cero), ejecuta el bloque de código.'
									: 'The `if` statement evaluates a boolean expression. If true (non-zero), it executes the code block.'}
							</p>
						</div>
						<div class="if-col">
							<div class="if-card-box">
								<div class="if-card-head">{isEs ? 'EVALUACIÓN VERDADERO / FALSO' : 'TRUE / FALSE EVALUATION'}</div>
								<div class="if-cell"><span>Condición (edad &gt;= 18)</span><span class="if-tag">TRUE ➔ Entra</span></div>
								<div class="if-cell"><span>Condición (edad &lt; 18)</span><span class="if-tag">FALSE ➔ Saltea</span></div>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 2: C -->
				<div class="if-slide" data-slide="2">
					<div class="if-slide-grid">
						<div class="if-col">
							<h2 class="if-slide-title">2. C: {isEs ? 'Truthiness Numérico (0 es Falso)' : 'Numeric Truthiness (0 is False)'}</h2>
							<p class="if-text">En C cualquier valor distinto de 0 es verdadero (`1`, `-5`), y `0` es falso.</p>
						</div>
						<div class="if-col">
							<div class="if-code-card">
								<div class="if-code-title">if_demo.c</div>
								<pre class="if-code-block"><code><span class="token-type">int</span> puntos = <span class="token-number">100</span>;
<span class="token-keyword">if</span> (puntos) &#123;
    printf(<span class="token-string">"Tiene puntos!\n"</span>);
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 3: JAVA -->
				<div class="if-slide" data-slide="3">
					<div class="if-slide-grid">
						<div class="if-col">
							<h2 class="if-slide-title">3. Java: {isEs ? 'Booleano Estricto' : 'Strict Boolean Type'}</h2>
							<p class="if-text">Java exige explícitamente un tipo `boolean` (`true`/`false`). No acepta números directos (`if (1)` da error de compilación).</p>
						</div>
						<div class="if-col">
							<div class="if-code-card">
								<div class="if-code-title">IfTest.java</div>
								<pre class="if-code-block"><code><span class="token-keyword">boolean</span> esMayor = edad &gt;= <span class="token-number">18</span>;
<span class="token-keyword">if</span> (esMayor) &#123;
    System.out.println(<span class="token-string">"Acceso permitido"</span>);
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 4: JAVASCRIPT -->
				<div class="if-slide" data-slide="4">
					<div class="if-slide-grid">
						<div class="if-col">
							<h2 class="if-slide-title">4. JavaScript: Truthy & Falsy</h2>
							<p class="if-text">Valores Falsy en JS: `false`, `0`, `""`, `null`, `undefined`, `NaN`. Todo lo demás es Truthy.</p>
						</div>
						<div class="if-col">
							<div class="if-code-card">
								<div class="if-code-title">if_demo.js</div>
								<pre class="if-code-block"><code><span class="token-keyword">const</span> nombre = <span class="token-string">"Ana"</span>;
<span class="token-keyword">if</span> (nombre) &#123;
    console.log(<span class="token-string">`Hola $&#123;nombre&#125;`</span>);
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 5: PYTHON -->
				<div class="if-slide" data-slide="5">
					<div class="if-slide-grid">
						<div class="if-col">
							<h2 class="if-slide-title">5. Python: Indentación y Truthiness</h2>
							<p class="if-text">Python usa indentación en lugar de llaves `{}`. Colecciones vacías `[]`, `{}`, `""` se evalúan como False.</p>
						</div>
						<div class="if-col">
							<div class="if-code-card">
								<div class="if-code-title">if_demo.py</div>
								<pre class="if-code-block"><code>items = [<span class="token-number">1</span>, <span class="token-number">2</span>]
<span class="token-keyword">if</span> items:
    print(<span class="token-string">"La lista tiene elementos"</span>)</code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 6: SIMULATOR -->
				<div class="if-slide" data-slide="6">
					<div class="if-sim-container">
						<h2 class="if-slide-title center">{isEs ? '6. Evaluador Interactivo de Condicionales' : '6. Conditional Evaluator'}</h2>
						<p class="if-sub center">{isEs ? 'Probá distintas expresiones de control de flujo:' : 'Test different control flow expressions:'}</p>

						<div class="if-sim-selector">
							<button class="if-exp-btn active" data-exp="gt">edad &gt;= 18 (edad=20)</button>
							<button class="if-exp-btn" data-exp="zero">if (0) / if ("")</button>
						</div>

						<div class="if-inspector-grid">
							<div class="if-lang-box">
								<span class="if-lang-name">C</span>
								<div class="if-exp-res" id="if-res-c">Evaluación: 1 (True) ➔ Entra al bloque</div>
							</div>
							<div class="if-lang-box">
								<span class="if-lang-name">Java</span>
								<div class="if-exp-res" id="if-res-java">Evaluación: true ➔ Entra al bloque</div>
							</div>
							<div class="if-lang-box">
								<span class="if-lang-name">JavaScript</span>
								<div class="if-exp-res" id="if-res-js">Truthy ➔ Entra al bloque</div>
							</div>
							<div class="if-lang-box">
								<span class="if-lang-name">Python</span>
								<div class="if-exp-res" id="if-res-py">True ➔ Entra al bloque</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="if-footer">
				<button class="btn btn-secondary" id="btn-prev-if" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="if-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-if">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.if-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.if-shell { max-width: var(--container-max); margin: 0 auto; }
	.if-header { margin-bottom: 1.5rem; }
	.if-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.if-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.if-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.if-sub.center { text-align: center; }
	.if-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.if-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.if-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.if-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.if-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.if-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.if-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.if-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.if-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.if-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.if-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.if-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.if-col { grid-column: span 12; }
	@media (min-width: 900px) { .if-col { grid-column: span 6; } }
	.if-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.if-slide-title.center { text-align: center; }
	.if-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.if-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.if-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.if-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.if-tag { color: var(--color-accent-700); font-weight: 600; }
	.if-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.if-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.if-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.if-sim-container { max-width: 800px; margin: 0 auto; }
	.if-sim-selector { display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 1.2rem; flex-wrap: wrap; }
	.if-exp-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.35rem 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease; }
	.if-exp-btn:hover { background: var(--color-accent-100); color: var(--color-accent-700); }
	.if-exp-btn.active { background: var(--color-accent-700); border-color: var(--color-accent-700); color: #ffffff; }
	.if-inspector-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
	@media (max-width: 600px) { .if-inspector-grid { grid-template-columns: repeat(1, minmax(0, 1fr)); } }
	.if-lang-box { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.8rem; }
	.if-lang-name { font-family: 'Fira Code', monospace; font-size: 0.75rem; font-weight: 700; color: #e59866; display: block; margin-bottom: 0.4rem; }
	.if-exp-res { font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #f9f4ed; background: #141210; padding: 0.5rem 0.7rem; border-radius: var(--radius-sm); }
	.if-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.if-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const ifData = {
		gt: {
			c: 'Evaluación: 1 (True) ➔ Entra al bloque',
			java: 'Evaluación: true ➔ Entra al bloque',
			js: 'Evaluación: true ➔ Entra al bloque',
			py: 'Evaluación: True ➔ Entra al bloque'
		},
		zero: {
			c: 'if (0) ➔ 0 es Falso ➔ Se saltea el bloque',
			java: 'Error de compilación: int no se convierte a boolean',
			js: 'if ("") ➔ Falsy ➔ Se saltea el bloque',
			py: 'if [] ➔ Lista vacía es Falsy ➔ Se saltea el bloque'
		}
	};

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.if-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.if-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('if-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-if') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-if') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.if-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-if')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-if')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	document.querySelectorAll('.if-exp-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			document.querySelectorAll('.if-exp-btn').forEach(b => b.classList.remove('active'));
			const targetBtn = e.currentTarget as HTMLElement;
			targetBtn.classList.add('active');
			const expKey = targetBtn.dataset.exp as keyof typeof ifData;
			const data = ifData[expKey];
			if (data) {
				const resC = document.getElementById('if-res-c');
				const resJava = document.getElementById('if-res-java');
				const resJs = document.getElementById('if-res-js');
				const resPy = document.getElementById('if-res-py');
				if (resC) resC.textContent = data.c;
				if (resJava) resJava.textContent = data.java;
				if (resJs) resJs.textContent = data.js;
				if (resPy) resPy.textContent = data.py;
			}
		});
	});

	goToSlide(1);
</script>
