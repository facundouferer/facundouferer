---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="wh-screen">
	<div class="wh-shell">
		<header class="wh-header">
			<span class="wh-badge">{isEs ? 'Ciclos de Repetición' : 'Iteration Loops'}</span>
			<h1 class="wh-title">
				{isEs ? 'Ciclo While Paso a Paso' : 'While Loop Step by Step'}
			</h1>
			<p class="wh-sub">
				{isEs 
					? 'Pre-evaluación condicional e iteración indeterminada en C, JavaScript, Python y Java.' 
					: 'Pre-condition evaluation and indeterminate iteration in C, JavaScript, Python, and Java.'}
			</p>
		</header>

		<div class="wh-deck-card">
			<div class="wh-nav-bar">
				<div class="wh-slide-indicator">
					<span class="wh-step-dot"></span>
					<span id="wh-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="wh-pills">
					<button class="wh-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="wh-pill-btn" data-target-slide="2">2. C</button>
					<button class="wh-pill-btn" data-target-slide="3">3. Java</button>
					<button class="wh-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="wh-pill-btn" data-target-slide="5">5. Python</button>
					<button class="wh-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="wh-viewport">
				<div class="wh-slide active" data-slide="1">
					<div class="wh-slide-grid">
						<div class="wh-col">
							<h2 class="wh-slide-title">1. {isEs ? 'Mecanismo del Ciclo While' : 'While Loop Mechanics'}</h2>
							<p class="wh-text">
								{isEs 
									? 'El ciclo `while` es una estructura de control con pre-prueba. La condición se evalúa ANTES de cada iteración.'
									: 'The `while` loop is a pre-tested control structure. The condition is evaluated BEFORE each iteration.'}
							</p>
						</div>
						<div class="wh-col">
							<div class="wh-card-box">
								<div class="wh-card-head">{isEs ? 'PASOS DE EJECUCIÓN' : 'EXECUTION STEPS'}</div>
								<div class="wh-cell"><span>1. Evaluar Condición</span><span class="wh-tag">¿Es True?</span></div>
								<div class="wh-cell"><span>2. Ejecutar Cuerpo</span><span class="wh-tag">Iteración</span></div>
								<div class="wh-cell"><span>3. Incrementar / Modificar</span><span class="wh-tag">Evita bucle infinito</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="wh-slide" data-slide="2">
					<div class="wh-slide-grid">
						<div class="wh-col">
							<h2 class="wh-slide-title">2. C: While Loop</h2>
							<p class="wh-text">En C se inicializa la variable de control antes del `while` y se actualiza manualmente en el cuerpo.</p>
						</div>
						<div class="wh-col">
							<div class="wh-code-card">
								<div class="wh-code-title">while_demo.c</div>
								<pre class="wh-code-block"><code><span class="token-type">int</span> i = <span class="token-number">1</span>;
<span class="token-keyword">while</span> (i &lt;= <span class="token-number">3</span>) &#123;
    printf(<span class="token-string">"i = %d\n"</span>, i);
    i++; <span class="token-comment">// Incremento</span>
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="wh-slide" data-slide="3">
					<div class="wh-slide-grid">
						<div class="wh-col">
							<h2 class="wh-slide-title">3. Java: Control de Bucle</h2>
							<p class="wh-text">Java exige una condición booleana estricta. Soporta sentencias `break` y `continue` para alterar el flujo.</p>
						</div>
						<div class="wh-col">
							<div class="wh-code-card">
								<div class="wh-code-title">WhileTest.java</div>
								<pre class="wh-code-block"><code><span class="token-type">int</span> count = <span class="token-number">0</span>;
<span class="token-keyword">while</span> (count &lt; <span class="token-number">5</span>) &#123;
    System.out.println(count);
    count++;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="wh-slide" data-slide="4">
					<div class="wh-slide-grid">
						<div class="wh-col">
							<h2 class="wh-slide-title">4. JavaScript: While e Iteración sobre Colecciones</h2>
							<p class="wh-text">JS permite evaluar expresiones truthy/falsy en la condición del `while` para procesar arrays y colas.</p>
						</div>
						<div class="wh-col">
							<div class="wh-code-card">
								<div class="wh-code-title">while_demo.js</div>
								<pre class="wh-code-block"><code><span class="token-keyword">const</span> queue = [<span class="token-string">"task1"</span>, <span class="token-string">"task2"</span>];
<span class="token-keyword">while</span> (queue.length &gt; <span class="token-number">0</span>) &#123;
    <span class="token-keyword">const</span> item = queue.shift();
    console.log(item);
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="wh-slide" data-slide="5">
					<div class="wh-slide-grid">
						<div class="wh-col">
							<h2 class="wh-slide-title">5. Python: While con cláusula Else</h2>
							<p class="wh-text">Python soporta una cláusula opcional `else` en los ciclos `while` que se ejecuta al finalizar la condición sin `break`.</p>
						</div>
						<div class="wh-col">
							<div class="wh-code-card">
								<div class="wh-code-title">while_else.py</div>
								<pre class="wh-code-block"><code>n = <span class="token-number">3</span>
<span class="token-keyword">while</span> n &gt; <span class="token-number">0</span>:
    print(n)
    n -= <span class="token-number">1</span>
<span class="token-keyword">else</span>:
    print(<span class="token-string">"Bucle completado sin break"</span>)</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="wh-slide" data-slide="6">
					<div class="wh-sim-container">
						<h2 class="wh-slide-title center">{isEs ? '6. Simulador Interactivo Iteración por Iteración' : '6. Iteration Simulator'}</h2>
						<p class="wh-sub center">{isEs ? 'Avanzá paso a paso en el ciclo while:' : 'Step through while loop iterations:'}</p>

						<div class="wh-sim-console">
							<div class="wh-sim-head"><span class="wh-console-label">While Trace: count &lt;= 3</span></div>
							<div class="wh-sim-body">
								<div class="wh-trace-step" id="wh-sim-step">Iteración 1: count=1. Condición (1 &lt;= 3) es TRUE ➔ Imprime y count++</div>
								<div class="wh-stack-display" id="wh-sim-state">Estado actual: count = 2</div>
							</div>
							<div class="wh-sim-actions">
								<button class="btn btn-primary" id="btn-next-wh-step">▶ {isEs ? 'Siguiente Iteración' : 'Next Iteration'}</button>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="wh-footer">
				<button class="btn btn-secondary" id="btn-prev-wh" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="wh-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-wh">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.wh-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.wh-shell { max-width: var(--container-max); margin: 0 auto; }
	.wh-header { margin-bottom: 1.5rem; }
	.wh-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.wh-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.wh-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.wh-sub.center { text-align: center; }
	.wh-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.wh-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.wh-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.wh-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.wh-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.wh-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.wh-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.wh-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.wh-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.wh-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.wh-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.wh-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.wh-col { grid-column: span 12; }
	@media (min-width: 900px) { .wh-col { grid-column: span 6; } }
	.wh-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.wh-slide-title.center { text-align: center; }
	.wh-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.wh-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.wh-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.wh-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.wh-tag { color: var(--color-accent-700); font-weight: 600; }
	.wh-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.wh-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.wh-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.wh-sim-container { max-width: 800px; margin: 0 auto; }
	.wh-sim-console { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-md); }
	.wh-sim-head { background: #2b2722; padding: 0.5rem 0.8rem; }
	.wh-console-label { color: #c0b6a5; font-family: 'Fira Code', monospace; font-size: 0.75rem; }
	.wh-sim-body { padding: 1rem; display: flex; flex-direction: column; gap: 0.8rem; }
	.wh-trace-step { font-size: 0.88rem; line-height: 1.5; color: #f9f4ed; background: #2a2520; padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); }
	.wh-stack-display { font-family: 'Fira Code', monospace; font-size: 0.8rem; color: #76d7c4; background: #141210; padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); }
	.wh-sim-actions { padding: 0.8rem 1rem; background: #25211d; display: flex; justify-content: flex-end; border-top: 1px solid #3a352e; }
	.wh-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.wh-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;
	let whStep = 0;

	const whSteps = [
		{ step: 'Iteración 1: count=1. Condición (1 <= 3) es TRUE ➔ Imprime y count++', state: 'Estado actual: count = 2' },
		{ step: 'Iteración 2: count=2. Condición (2 <= 3) es TRUE ➔ Imprime y count++', state: 'Estado actual: count = 3' },
		{ step: 'Iteración 3: count=3. Condición (3 <= 3) es TRUE ➔ Imprime y count++', state: 'Estado actual: count = 4' },
		{ step: 'Iteración 4: count=4. Condición (4 <= 3) es FALSE ➔ Salida del bucle', state: 'Bucle finalizado' }
	];

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.wh-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.wh-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('wh-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-wh') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-wh') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.wh-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-wh')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-wh')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	document.getElementById('btn-next-wh-step')?.addEventListener('click', () => {
		whStep = (whStep + 1) % whSteps.length;
		const stepEl = document.getElementById('wh-sim-step');
		const stateEl = document.getElementById('wh-sim-state');
		if (stepEl) stepEl.textContent = whSteps[whStep].step;
		if (stateEl) stateEl.textContent = whSteps[whStep].state;
	});

	goToSlide(1);
</script>
