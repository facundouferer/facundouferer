---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="st-screen">
	<div class="st-shell">
		<header class="st-header">
			<span class="st-badge">{isEs ? 'Procesamiento de Cadenas' : 'String Processing'}</span>
			<h1 class="st-title">
				{isEs ? 'Cadenas de Texto Paso a Paso' : 'Strings Step by Step'}
			</h1>
			<p class="st-sub">
				{isEs 
					? 'Arrays de caracteres, terminadores nulos y objetos String en C, Java, JavaScript y Python.' 
					: 'Character arrays, null terminators, and String objects in C, Java, JS, and Python.'}
			</p>
		</header>

		<div class="st-deck-card">
			<div class="st-nav-bar">
				<div class="st-slide-indicator">
					<span class="st-step-dot"></span>
					<span id="st-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="st-pills">
					<button class="st-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="st-pill-btn" data-target-slide="2">2. C</button>
					<button class="st-pill-btn" data-target-slide="3">3. Java</button>
					<button class="st-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="st-pill-btn" data-target-slide="5">5. Python</button>
					<button class="st-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="st-viewport">
				<div class="st-slide active" data-slide="1">
					<div class="st-slide-grid">
						<div class="st-col">
							<h2 class="st-slide-title">1. {isEs ? 'Representación Interna de Texto' : 'Internal Text Representation'}</h2>
							<p class="st-text">
								{isEs 
									? 'Una cadena de texto es una secuencia de caracteres (ASCII / UTF-8 / UTF-16). En C termina con un carácter nulo (`\\0`), mientras que en Java/JS/Python son objetos con longitud explícita.'
									: 'A string is a sequence of characters (ASCII/UTF-8/UTF-16). In C it ends with null `\\0`, whereas Java/JS/Python use explicit length objects.'}
							</p>
						</div>
						<div class="st-col">
							<div class="st-card-box">
								<div class="st-card-head">{isEs ? 'CADENA "HOLA" EN C' : '"HOLA" STRING IN C'}</div>
								<div class="st-cell"><span>[0] 'H' | [1] 'o' | [2] 'l' | [3] 'a'</span><span class="st-tag">['\0' en pos 4]</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="st-slide" data-slide="2">
					<div class="st-slide-grid">
						<div class="st-col">
							<h2 class="st-slide-title">2. C: Arrays de char y '\0'</h2>
							<p class="st-text">En C las cadenas son mutables si se declaran como `char str[]`, pero requieren `strlen` para calcular longitud hasta encontrar `\0`.</p>
						</div>
						<div class="st-col">
							<div class="st-code-card">
								<div class="st-code-title">string.c</div>
								<pre class="st-code-block"><code><span class="token-type">char</span> saludo[] = <span class="token-string">"Hola"</span>; <span class="token-comment">// 5 bytes en RAM (con \0)</span>
saludo[<span class="token-number">0</span>] = <span class="token-string">'h'</span>; <span class="token-comment">// Mutación directa</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="st-slide" data-slide="3">
					<div class="st-slide-grid">
						<div class="st-col">
							<h2 class="st-slide-title">3. Java: String Pool e Inmutabilidad</h2>
							<p class="st-text">Java almacena literales en el String Pool y sus instancias son 100% inmutables. Modificar un String crea un objeto nuevo.</p>
						</div>
						<div class="st-col">
							<div class="st-code-card">
								<div class="st-code-title">StringPool.java</div>
								<pre class="st-code-block"><code>String s1 = <span class="token-string">"Hola"</span>;
String s2 = s1.concat(<span class="token-string">" Mundo"</span>); <span class="token-comment">// Nuevo objeto</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="st-slide" data-slide="4">
					<div class="st-slide-grid">
						<div class="st-col">
							<h2 class="st-slide-title">4. JavaScript: Template Literals</h2>
							<p class="st-text">JS soporta interpolación directa con template literals (`"Hola " + usuario`) e inmutabilidad de caracteres primarios.</p>
						</div>
						<div class="st-col">
							<div class="st-code-card">
								<div class="st-code-title">template.js</div>
								<pre class="st-code-block"><code><span class="token-keyword">const</span> user = <span class="token-string">"Ana"</span>;
<span class="token-keyword">const</span> msg = <span class="token-string">`Bienvenido $&#123;user&#125;`</span>;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="st-slide" data-slide="5">
					<div class="st-slide-grid">
						<div class="st-col">
							<h2 class="st-slide-title">5. Python: Slicing e Inmutabilidad</h2>
							<p class="st-text">Python ofrece slicing súper expresivo `str[::-1]` para revertir cadenas de forma inmutable.</p>
						</div>
						<div class="st-col">
							<div class="st-code-card">
								<div class="st-code-title">slicing.py</div>
								<pre class="st-code-block"><code>texto = <span class="token-string">"Python"</span>
reversed_text = texto[::-<span class="token-number">1</span>] <span class="token-comment"># "nohtyP"</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="st-slide" data-slide="6">
					<div class="st-sim-container">
						<h2 class="st-slide-title center">{isEs ? '6. Inspector de Terminador Nulo' : '6. Null Terminator Inspector'}</h2>
						<div class="st-inspector-grid">
							<div class="st-lang-box"><span class="st-lang-name">C String</span><div class="st-exp-res">['H', 'o', 'l', 'a', '\0'] ➔ Longitud: 4 (5 bytes)</div></div>
							<div class="st-lang-box"><span class="st-lang-name">Java / JS / Python</span><div class="st-exp-res">Objeto Inmutable con atributo `length` o `len()`</div></div>
						</div>
					</div>
				</div>
			</div>

			<div class="st-footer">
				<button class="btn btn-secondary" id="btn-prev-st" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="st-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-st">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.st-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.st-shell { max-width: var(--container-max); margin: 0 auto; }
	.st-header { margin-bottom: 1.5rem; }
	.st-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.st-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.st-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.st-sub.center { text-align: center; }
	.st-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.st-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.st-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.st-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.st-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.st-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.st-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.st-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.st-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.st-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.st-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.st-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.st-col { grid-column: span 12; }
	@media (min-width: 900px) { .st-col { grid-column: span 6; } }
	.st-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.st-slide-title.center { text-align: center; }
	.st-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.st-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.st-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.st-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.st-tag { color: var(--color-accent-700); font-weight: 600; }
	.st-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.st-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.st-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.st-sim-container { max-width: 800px; margin: 0 auto; }
	.st-inspector-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
	@media (max-width: 600px) { .st-inspector-grid { grid-template-columns: repeat(1, minmax(0, 1fr)); } }
	.st-lang-box { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.8rem; }
	.st-lang-name { font-family: 'Fira Code', monospace; font-size: 0.75rem; font-weight: 700; color: #e59866; display: block; margin-bottom: 0.4rem; }
	.st-exp-res { font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #f9f4ed; background: #141210; padding: 0.5rem 0.7rem; border-radius: var(--radius-sm); }
	.st-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.st-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.st-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.st-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('st-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-st') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-st') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.st-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-st')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-st')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	goToSlide(1);
</script>
