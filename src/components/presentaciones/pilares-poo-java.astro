	.po-poly-item { display: flex; flex-direction: column; gap: var(--space-1); background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: var(--space-2) var(--space-3); transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease; }
