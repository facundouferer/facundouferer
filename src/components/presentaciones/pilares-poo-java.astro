	.po-output { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: var(--space-3); min-height: 116px; }
	.po-out-line { margin: 0 0 var(--space-2); font-family: 'Fira Code', monospace; font-size: 0.82rem; color: var(--color-accent-2-800); opacity: 0; transform: translateX(-6px); transition: opacity 0.3s ease, transform 0.3s ease; }
	.po-out-line.is-visible { opacity: 1; transform: translateX(0); }
	.po-out-hint { margin: 0; font-size: 0.8rem; font-style: italic; color: color-mix(in srgb, var(--color-text) 58%, transparent); opacity: 0; transition: opacity 0.3s ease; }
	.po-out-hint.is-visible { opacity: 1; }

	/* Checklist, recap and mistakes */
	.po-checklist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
	.po-check-item { display: flex; align-items: flex-start; gap: var(--space-2); background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: var(--space-2) var(--space-3); font-size: 0.88rem; line-height: 1.5; }
	.po-check-item svg { flex: none; margin-top: 3px; color: var(--color-accent-2-700); }

	.po-recap-grid { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: var(--space-3); margin-bottom: var(--space-4); }
	@media (min-width: 640px) { .po-recap-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (min-width: 1100px) { .po-recap-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
	.po-recap-card { position: relative; background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); padding: var(--space-4); }
	.po-recap-index { font-family: 'Fira Code', monospace; font-size: 0.76rem; font-weight: 700; color: color-mix(in srgb, var(--color-accent) 50%, transparent); }
	.po-recap-title { font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 1.05rem; margin: var(--space-1) 0 var(--space-2); }
	.po-recap-q { margin: 0 0 var(--space-1); font-size: 0.86rem; font-weight: 700; color: var(--color-accent-700); }
	.po-recap-a { margin: 0; font-size: 0.85rem; line-height: 1.5; color: color-mix(in srgb, var(--color-text) 78%, transparent); }

	.po-errors { display: flex; flex-direction: column; gap: var(--space-2); }
	.po-error-item { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2); background: var(--color-accent-100); border: 1px solid color-mix(in srgb, var(--color-accent) 40%, transparent); border-radius: var(--radius-md); padding: var(--space-2) var(--space-3); font-size: 0.86rem; line-height: 1.5; }
	.po-error-tag { font-family: 'Fira Code', monospace; font-size: 0.74rem; font-weight: 700; color: var(--color-accent-800); text-transform: uppercase; letter-spacing: 0.06em; }

	/* Code cards */
	.po-code-card { background: color-mix(in srgb, var(--color-neutral-900) 88%, var(--color-text)); border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.po-code-title { background: color-mix(in srgb, var(--color-neutral-900) 72%, var(--color-text)); color: var(--color-neutral-400); padding: var(--space-1) var(--space-3); font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid color-mix(in srgb, var(--color-neutral-100) 14%, transparent); }
	.po-code-block { margin: 0; padding: var(--space-3); font-family: 'Fira Code', monospace; font-size: 0.8rem; line-height: 1.6; color: var(--color-neutral-100); overflow-x: auto; }

	.po-k { color: var(--color-accent-400); font-weight: 600; }
	.po-t { color: var(--color-neutral-300); }
	.po-n { color: var(--color-accent-300); }
	.po-s { color: var(--color-accent-2-300); }
	.po-a { color: var(--color-accent-2-400); font-weight: 600; }
	.po-c { color: var(--color-neutral-500); font-style: italic; }

	/* Footer */
	.po-sim-container { max-width: none; width: 100%; }
	.po-footer { display: flex; align-items: center; justify-content: space-between; padding: var(--space-2) var(--space-4); border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.po-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }

	/* Fill the viewport: center the active slide and scale it up on wide screens. */
	.po-viewport { display: flex; flex-direction: column; justify-content: center; }
	.po-slide.active { width: 100%; }
	@media (min-width: 1440px) { .po-viewport { zoom: 1.15; } }
	@media (min-width: 1800px) { .po-viewport { zoom: 1.35; } }
	@media (min-width: 2300px) { .po-viewport { zoom: 1.6; } }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 8;

	const deckRoot = document.querySelector('.po-screen') as HTMLElement | null;
	const isEsDeck = deckRoot?.dataset.lang !== 'en';

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;

		document.querySelectorAll('.po-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});

		document.querySelectorAll('.po-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});

		const labelEl = document.getElementById('po-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;

		const prevBtn = document.getElementById('btn-prev-po') as HTMLButtonElement | null;
		const nextBtn = document.getElementById('btn-next-po') as HTMLButtonElement | null;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.po-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.querySelectorAll('.po-pillar-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.goto;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-po')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-po')?.addEventListener('click', () => goToSlide(currentSlide + 1));

	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	/* --- Slide 4: encapsulated CuentaBancaria ------------------------------ */
	const INITIAL_BALANCE = 300;
	const MAX_BALANCE = 1000;
	let saldo = INITIAL_BALANCE;

	const balanceEl = document.getElementById('po-bank-balance');
	const barEl = document.getElementById('po-bank-bar');
	const logEl = document.getElementById('po-bank-log');

	const renderBank = (message: string, state: 'ok' | 'err' | 'idle') => {
		if (balanceEl) balanceEl.textContent = String(saldo);
		if (barEl) barEl.style.width = `${Math.min(100, (saldo / MAX_BALANCE) * 100)}%`;
		if (logEl) {
			logEl.textContent = message;
			logEl.classList.remove('is-ok', 'is-err');
			if (state === 'ok') logEl.classList.add('is-ok');
			if (state === 'err') logEl.classList.add('is-err');
		}
	};

	document.getElementById('po-bank-deposit')?.addEventListener('click', () => {
		const monto = 100;
		if (monto > 0) {
			saldo += monto;
			renderBank(
				isEsDeck
					? `depositar(${monto}) → validación superada. El método actualiza saldo a ${saldo}.`
					: `depositar(${monto}) → validation passed. The method updates saldo to ${saldo}.`,
				'ok',
			);
		}
	});

	document.getElementById('po-bank-withdraw')?.addEventListener('click', () => {
		const monto = 500;
		if (monto > 0 && monto <= saldo) {
			saldo -= monto;
			renderBank(
				isEsDeck
					? `retirar(${monto}) → validación superada. Saldo restante: ${saldo}.`
					: `retirar(${monto}) → validation passed. Remaining saldo: ${saldo}.`,
				'ok',
			);
		} else {
			renderBank(
				isEsDeck
					? `retirar(${monto}) → rechazado: el monto supera el saldo (${saldo}). El estado privado no cambia.`
					: `retirar(${monto}) → rejected: the amount exceeds saldo (${saldo}). Private state is untouched.`,
				'err',
			);
		}
	});

	document.getElementById('po-bank-reset')?.addEventListener('click', () => {
		saldo = INITIAL_BALANCE;
		renderBank(
			isEsDeck
				? 'Cuenta reiniciada con saldo 300. Probá de nuevo los métodos públicos.'
				: 'Account reset with saldo 300. Try the public methods again.',
			'idle',
		);
	});

	/* --- Slide 5: inheritance step-through --------------------------------- */
	let inheritStep = 0;
	const inheritFigure = document.getElementById('po-inherit-figure');
	const inheritStepEl = document.getElementById('po-inherit-step');
	const inheritBtn = document.getElementById('po-inherit-btn');

	const inheritLabels = [
		isEsDeck ? 'Paso 0 / 3 — solo miembros propios' : 'Step 0 / 3 — own members only',
		isEsDeck ? 'Paso 1 / 3 — atributos heredados' : 'Step 1 / 3 — inherited fields',
		isEsDeck ? 'Paso 2 / 3 — métodos heredados' : 'Step 2 / 3 — inherited methods',
		isEsDeck ? 'Paso 3 / 3 — super(...) inicializa la base' : 'Step 3 / 3 — super(...) initialises the base',
	];

	const renderInherit = () => {
		if (inheritFigure) inheritFigure.setAttribute('data-step', String(inheritStep));
		document.querySelectorAll('.po-reveal').forEach(node => {
			const el = node as SVGElement;
			const step = parseInt(el.getAttribute('data-step') || '0');
			el.classList.toggle('is-visible', step <= inheritStep);
		});
		if (inheritStepEl) inheritStepEl.textContent = inheritLabels[inheritStep];
		if (inheritBtn) {
			inheritBtn.textContent = inheritStep === 3
				? (isEsDeck ? '↺ Reiniciar' : '↺ Reset')
				: (isEsDeck ? 'Revelar lo heredado →' : 'Reveal what is inherited →');
		}
	};

	inheritBtn?.addEventListener('click', () => {
		inheritStep = inheritStep >= 3 ? 0 : inheritStep + 1;
		renderInherit();
	});

	/* --- Slide 6: polymorphic dispatch ------------------------------------- */
	const polyRunBtn = document.getElementById('po-poly-run') as HTMLButtonElement | null;
	const polyOutput = document.getElementById('po-poly-output');
	const polyTimers: ReturnType<typeof setTimeout>[] = [];

	const clearPoly = () => {
		polyTimers.splice(0).forEach(clearTimeout);
		document.querySelectorAll('.po-out-line').forEach(line => line.classList.remove('is-visible'));
		document.querySelectorAll('.po-poly-item').forEach(item => item.classList.remove('is-active'));
		polyOutput?.querySelector('.po-out-hint')?.classList.remove('is-visible');
		if (polyRunBtn) polyRunBtn.disabled = false;
	};

	polyRunBtn?.addEventListener('click', () => {
		clearPoly();
		if (polyRunBtn) polyRunBtn.disabled = true;
		for (let i = 0; i < 3; i++) {
			polyTimers.push(setTimeout(() => {
				document.querySelector(`.po-out-line[data-index="${i}"]`)?.classList.add('is-visible');
				document.querySelector(`.po-poly-item[data-index="${i}"]`)?.classList.add('is-active');
				if (i === 2) {
					polyOutput?.querySelector('.po-out-hint')?.classList.add('is-visible');
					if (polyRunBtn) polyRunBtn.disabled = false;
				}
			}, 420 * (i + 1)));
		}
	});

	document.getElementById('po-poly-reset')?.addEventListener('click', clearPoly);

	goToSlide(1);
	renderBank(
		isEsDeck
			? 'Probá los métodos públicos: el saldo solo cambia si la validación pasa.'
			: 'Try the public methods: the balance only changes when validation passes.',
		'idle',
	);
	renderInherit();
</script>
