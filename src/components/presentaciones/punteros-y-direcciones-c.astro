---
interface Props {
	lang?: string;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
const t = (es: string, en: string) => (isEs ? es : en);

/*
 * Memory model shared by the three modes. Every scene is a set of cells (an
 * object with a name, an illustrative address and a value), optional frames
 * (main, a called function, static storage) and a list of states. A state
 * says which code line runs, which cells exist and hold what value, which
 * pointers point where (arrows) and what changed. The client script draws the
 * state as SVG and animates the differences between two states.
 */
type Cell = { id: string; name: string; addr: string; x: number; y: number; w?: number; bytes?: number; ptr?: boolean };
type Frame = { id: string; label: string; x: number; y: number; w: number; h: number };
type State = {
	line: number;
	vals: Record<string, string>;
	arrows?: [string, string][];
	frames?: string[];
	hl?: string[];
	bad?: string[];
	out?: string;
	text?: string;
};
type Scene = { id: string; kicker: string; title: string; lead: string; code: string[]; cells: Cell[]; frames?: Frame[]; ghost?: boolean; steps: State[] };
type PracticeItem = {
	id: string;
	title: string;
	code: string[];
	cells: Cell[];
	frames?: Frame[];
	before: State;
	after: State;
	question: string;
	options: string[];
	correct: number;
	why: string;
};
type AssessItem = { id: string; title: string; code: string[]; question: string; options: string[]; correct: number; why: string };

const swapCode = [
	'#include <stdio.h>',
	'',
	t('void intercambiar(int *a, int *b) {', 'void swap(int *a, int *b) {'),
	'    int aux = *a;',
	'    *a = *b;',
	'    *b = aux;',
	'}',
	'',
	'int main(void) {',
	'    int x = 3;',
	'    int y = 8;',
	t('    intercambiar(&x, &y);', '    swap(&x, &y);'),
	'    printf("x = %d, y = %d\\n", x, y);',
	'    return 0;',
	'}',
];
const swapFrames: Frame[] = [
	{ id: 'main', label: 'main', x: 20, y: 15, w: 270, h: 320 },
	{ id: 'fn', label: t('intercambiar', 'swap'), x: 320, y: 15, w: 300, h: 320 },
];
const swapCells: Cell[] = [
	{ id: 'x', name: 'x', addr: '0x1000', x: 70, y: 75 },
	{ id: 'y', name: 'y', addr: '0x1004', x: 70, y: 215 },
	{ id: 'a', name: 'a', addr: '0x2000', x: 460, y: 55, ptr: true },
	{ id: 'b', name: 'b', addr: '0x2008', x: 460, y: 155, ptr: true },
	{ id: 'aux', name: 'aux', addr: '0x2010', x: 460, y: 255 },
];

