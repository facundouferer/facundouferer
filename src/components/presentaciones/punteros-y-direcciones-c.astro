<script>
	type Cell = { id: string; name: string; addr: string; x: number; y: number; w?: number; bytes?: number; ptr?: boolean };
	type Frame = { id: string; label: string; x: number; y: number; w: number; h: number };
	type State = {
		line: number;
		vals: Record<string, string>;
		arrows?: [string, string][];
		frames?: string[];
		hl?: string[];
		bad?: string[];
		out?: string;
		text?: string;
	};
	type Scene = { cells: Cell[]; frames?: Frame[]; ghost?: boolean; steps?: State[] };
	type Practice = Scene & { before: State; after: State; options: string[]; correct: number; why: string };
	type Assess = { question: string; options: string[]; correct: number; why: string };
	type Data = {
		learn: Scene[];
		practice: Practice[];
		assess: Assess[];
		ui: Record<string, string>;
	};

	const screen = document.querySelector<HTMLElement>('.pd-screen');
	const raw = document.getElementById('pdData')?.textContent;

	if (screen && raw) {
		const data = JSON.parse(raw) as Data;
		const ui = data.ui;
		const CELL_W = 140;
		const CELL_H = 52;

		const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

		const box = (c: Cell) => ({ x: c.x, y: c.y, w: c.w ?? CELL_W, h: CELL_H });

		function edge(b: { x: number; y: number; w: number; h: number }, tx: number, ty: number) {
			const cx = b.x + b.w / 2;
			const cy = b.y + b.h / 2;
			const dx = tx - cx;
			const dy = ty - cy;
			if (!dx && !dy) return { x: cx, y: cy };
			const sx = dx ? b.w / 2 / Math.abs(dx) : Infinity;
			const sy = dy ? b.h / 2 / Math.abs(dy) : Infinity;
			const s = Math.min(sx, sy);
			return { x: cx + dx * s, y: cy + dy * s };
		}

		function arrowPath(from: Cell, to: Cell) {
			const a = box(from);
			const b = box(to);
			const start = edge(a, b.x + b.w / 2, b.y + b.h / 2);
			const end = edge(b, a.x + a.w / 2, a.y + a.h / 2);
			const mx = (start.x + end.x) / 2;
			const my = (start.y + end.y) / 2;
			const len = Math.hypot(end.x - start.x, end.y - start.y) || 1;
			const nx = -(end.y - start.y) / len;
			const ny = (end.x - start.x) / len;
			const bend = Math.min(40, len / 6);
			const qx = mx + nx * bend;
			const qy = my + ny * bend;
			const ux = (end.x - qx) / (Math.hypot(end.x - qx, end.y - qy) || 1);
			const uy = (end.y - qy) / (Math.hypot(end.x - qx, end.y - qy) || 1);
			const tip = { x: end.x - ux * 4, y: end.y - uy * 4 };
			const left = { x: tip.x - ux * 14 - uy * 8, y: tip.y - uy * 14 + ux * 8 };
			const right = { x: tip.x - ux * 14 + uy * 8, y: tip.y - uy * 14 - ux * 8 };
			const f = (n: number) => n.toFixed(1);
			return (
				`M${f(start.x)} ${f(start.y)} Q${f(qx)} ${f(qy)} ${f(tip.x)} ${f(tip.y)} ` +
				`M${f(left.x)} ${f(left.y)} L${f(tip.x)} ${f(tip.y)} L${f(right.x)} ${f(right.y)}`
			);
		}

		function draw(svg: SVGSVGElement, scene: Scene, state: State, prev?: State) {
			let html = '';
			const frames = scene.frames ?? [];
			for (const fr of frames) {
				if (!state.frames?.includes(fr.id)) continue;
				html += `<rect class="pd-frame" x="${fr.x}" y="${fr.y}" width="${fr.w}" height="${fr.h}" rx="24"/>`;
				html += `<text class="pd-frame-label" x="${fr.x + 18}" y="${fr.y + 26}">${esc(fr.label)}</text>`;
			}
			for (const c of scene.cells) {
				const b = box(c);
				const visible = Object.prototype.hasOwnProperty.call(state.vals, c.id);
				if (!visible) {
					if (scene.ghost) {
						html += `<g class="pd-cell is-ghost"><rect x="${b.x}" y="${b.y}" width="${b.w}" height="${b.h}" rx="14"/>`;
						html += addresses(c, b);
						html += '</g>';
					}
					continue;
				}
				const cls = ['pd-cell'];
				if (c.ptr) cls.push('is-ptr');
				if (state.hl?.includes(c.id)) cls.push('is-hl');
				if (state.bad?.includes(c.id)) cls.push('is-bad');
				if (prev && prev.vals[c.id] !== state.vals[c.id]) cls.push('is-changed');
				html += `<g class="${cls.join(' ')}">`;
				html += `<rect x="${b.x}" y="${b.y}" width="${b.w}" height="${b.h}" rx="14"/>`;
				html += dividers(c, b);
				html += `<text class="pd-cell-name" x="${b.x + 6}" y="${b.y - 10}">${esc(c.name)}</text>`;
				html += `<text class="pd-cell-val" x="${b.x + b.w / 2}" y="${b.y + b.h / 2 + 8}" text-anchor="middle">${esc(state.vals[c.id])}</text>`;
				html += addresses(c, b);
				html += '</g>';
			}
			const byId = new Map(scene.cells.map((c) => [c.id, c]));
			const before = new Set((prev?.arrows ?? []).map(([a, b]) => `${a}>${b}`));
			for (const [from, to] of state.arrows ?? []) {
				const a = byId.get(from);
				const b = byId.get(to);
				if (!a || !b) continue;
				const isNew = prev && !before.has(`${from}>${to}`) ? ' is-new' : '';
				html += `<path class="pd-arrow${isNew}" d="${arrowPath(a, b)}"/>`;
			}
			svg.innerHTML = html;
		}

		function dividers(c: Cell, b: { x: number; y: number; w: number; h: number }) {
			if (!c.bytes || c.bytes < 2) return '';
			let html = '';
			const slot = b.w / c.bytes;
			for (let i = 1; i < c.bytes; i++) {
				html += `<line class="pd-divider" x1="${b.x + slot * i}" y1="${b.y + 6}" x2="${b.x + slot * i}" y2="${b.y + b.h - 6}"/>`;
			}
			return html;
		}

		function addresses(c: Cell, b: { x: number; y: number; w: number; h: number }) {
			if (!c.bytes) {
				return `<text class="pd-cell-addr" x="${b.x + 6}" y="${b.y + b.h + 18}">${esc(c.addr)}</text>`;
			}
			let html = '';
			const base = parseInt(c.addr, 16);
			const slot = b.w / c.bytes;
			for (let i = 0; i < c.bytes; i++) {
				html += `<text class="pd-cell-addr" x="${b.x + slot * i + slot / 2}" y="${b.y + b.h + 18}" text-anchor="middle">0x${(base + i).toString(16)}</text>`;
			}
			return html;
		}

		function markLine(slide: HTMLElement, line: number) {
			slide.querySelectorAll<HTMLElement>('.pd-code li').forEach((li) => {
				li.classList.toggle('is-current', Number(li.dataset.line) === line);
			});
		}

		function showOut(slide: HTMLElement, out?: string) {
			const el = slide.querySelector<HTMLElement>('[data-out]');
			if (!el) return;
			el.hidden = !out;
			el.textContent = out ?? '';
		}

		// Learn mode: each slide walks its states with the step controls.
		const learnSlides = screen.querySelectorAll<HTMLElement>('[data-learn]');
		learnSlides.forEach((slide) => {
			const scene = data.learn[Number(slide.dataset.learn)];
			const steps = scene.steps ?? [];
			const svg = slide.querySelector<SVGSVGElement>('.pd-canvas');
			const text = slide.querySelector<HTMLElement>('[data-text]');
			const count = slide.querySelector<HTMLElement>('[data-step-count]');
			const prevBtn = slide.querySelector<HTMLButtonElement>('[data-step="prev"]');
			const nextBtn = slide.querySelector<HTMLButtonElement>('[data-step="next"]');
			let index = 0;

			const render = (prev?: State) => {
				const state = steps[index];
				if (svg) draw(svg, scene, state, prev);
				markLine(slide, state.line);
				showOut(slide, state.out);
				if (text) text.textContent = state.text ?? '';
				if (count) count.textContent = `${ui.step} ${index + 1} / ${steps.length}`;
				if (prevBtn) prevBtn.disabled = index === 0;
				if (nextBtn) nextBtn.disabled = index === steps.length - 1;
			};

			const go = (target: number) => {
				if (target < 0 || target >= steps.length) return;
				const prev = steps[index];
				index = target;
				render(target > 0 ? prev : undefined);
			};

			prevBtn?.addEventListener('click', () => go(index - 1));
			nextBtn?.addEventListener('click', () => go(index + 1));
			slide.querySelector('[data-step="reset"]')?.addEventListener('click', () => go(0));
			render();
		});

		// Practice mode: predict, get feedback, watch the transition.
		const practiceSlides = screen.querySelectorAll<HTMLElement>('[data-practice]');
		practiceSlides.forEach((slide) => {
			const item = data.practice[Number(slide.dataset.practice)];
			const svg = slide.querySelector<SVGSVGElement>('.pd-canvas');
			const options = slide.querySelectorAll<HTMLButtonElement>('.pd-option');
			const feedback = slide.querySelector<HTMLElement>('[data-feedback]');
			const replay = slide.querySelector<HTMLButtonElement>('[data-replay]');
			const retry = slide.querySelector<HTMLButtonElement>('[data-retry]');
			let timer = 0;

			const showBefore = () => {
				if (svg) draw(svg, item, item.before);
				markLine(slide, item.before.line);
				showOut(slide, item.before.out);
			};

			const showAfter = () => {
				if (svg) draw(svg, item, item.after, item.before);
				markLine(slide, item.after.line);
				showOut(slide, item.after.out);
			};

			const reset = () => {
				window.clearTimeout(timer);
				options.forEach((o) => {
					o.disabled = false;
					o.classList.remove('is-right', 'is-wrong');
				});
				if (feedback) {
					feedback.textContent = '';
					feedback.className = 'pd-feedback';
				}
				if (replay) replay.hidden = true;
				if (retry) retry.hidden = true;
				showBefore();
			};

			options.forEach((option) => {
				option.addEventListener('click', () => {
					const chosen = Number(option.dataset.option);
					const right = chosen === item.correct;
					options.forEach((o) => {
						o.disabled = true;
						if (Number(o.dataset.option) === item.correct) o.classList.add('is-right');
					});
					if (!right) option.classList.add('is-wrong');
					if (feedback) {
						feedback.className = `pd-feedback ${right ? 'is-right' : 'is-wrong'}`;
						feedback.innerHTML = `<strong>${esc(right ? ui.correct : ui.wrong)}</strong> ${esc(item.why)}`;
					}
					if (replay) replay.hidden = false;
					if (retry) retry.hidden = right;
					showAfter();
				});
			});

			replay?.addEventListener('click', () => {
				window.clearTimeout(timer);
				showBefore();
				timer = window.setTimeout(showAfter, 700);
			});
			retry?.addEventListener('click', reset);
			reset();
		});

		// Assess mode: no feedback until the student grades the whole set.
		const resultsSlide = screen.querySelector<HTMLElement>('[data-results]');
		const gradeBtn = resultsSlide?.querySelector<HTMLButtonElement>('[data-grade]');
		const regradeBtn = resultsSlide?.querySelector<HTMLButtonElement>('[data-regrade]');
		const scoreEl = resultsSlide?.querySelector<HTMLElement>('[data-score]');
		const listEl = resultsSlide?.querySelector<HTMLElement>('[data-results-list]');

		gradeBtn?.addEventListener('click', () => {
			let score = 0;
			let html = '';
			data.assess.forEach((q, i) => {
				const picked = screen.querySelector<HTMLInputElement>(`input[name="pdA${i}"]:checked`);
				const chosen = picked ? Number(picked.value) : -1;
				const right = chosen === q.correct;
				if (right) score++;
				const yours = chosen >= 0 ? q.options[chosen] : ui.none;
				html +=
					`<li><span class="${right ? 'is-right' : 'is-wrong'}">${esc(right ? ui.correct : ui.wrong)}</span> ` +
					`${esc(q.question)}<br>${esc(ui.yours)}: <code>${esc(yours)}</code> · ${esc(ui.answer)}: <code>${esc(q.options[q.correct])}</code><br>${esc(q.why)}</li>`;
			});
			if (scoreEl) scoreEl.textContent = `${ui.score}: ${score} / ${data.assess.length}`;
			if (listEl) listEl.innerHTML = html;
			screen.querySelectorAll<HTMLInputElement>('[data-assess] input').forEach((input) => (input.disabled = true));
			gradeBtn.disabled = true;
			if (regradeBtn) regradeBtn.hidden = false;
		});

		regradeBtn?.addEventListener('click', () => {
			screen.querySelectorAll<HTMLInputElement>('[data-assess] input').forEach((input) => {
				input.disabled = false;
				input.checked = false;
			});
			if (scoreEl) scoreEl.textContent = '';
			if (listEl) listEl.innerHTML = '';
			if (gradeBtn) gradeBtn.disabled = false;
			regradeBtn.hidden = true;
			goTo(1);
		});

		// Slide navigation inside the active mode.
		const prevBtn = document.getElementById('pdPrevBtn') as HTMLButtonElement | null;
		const nextBtn = document.getElementById('pdNextBtn') as HTMLButtonElement | null;
		const counter = document.getElementById('pdSlideCounter');
		const current: Record<string, number> = { learn: 1, practice: 1, assess: 1 };
		let mode = 'learn';

		const activePanel = () => screen.querySelector<HTMLElement>(`.pd-mode[data-mode="${mode}"]`);

		function goTo(target: number) {
			const panel = activePanel();
			if (!panel) return;
			const slides = panel.querySelectorAll<HTMLElement>('.pd-slide');
			const total = slides.length;
			if (target < 1 || target > total) return;
			current[mode] = target;
			slides.forEach((s) => s.classList.toggle('is-active', Number(s.dataset.slide) === target));
			if (counter) counter.textContent = `${target} / ${total}`;
			if (prevBtn) prevBtn.disabled = target === 1;
			if (nextBtn) nextBtn.disabled = target === total;
		}

		prevBtn?.addEventListener('click', () => goTo(current[mode] - 1));
		nextBtn?.addEventListener('click', () => goTo(current[mode] + 1));

		screen.querySelectorAll<HTMLInputElement>('input[name="pdMode"]').forEach((input) => {
			input.addEventListener('change', () => {
				if (!input.checked) return;
				mode = input.value;
				screen.querySelectorAll<HTMLElement>('.pd-mode').forEach((panel) => {
					panel.hidden = panel.dataset.mode !== mode;
				});
				goTo(current[mode]);
			});
		});

		window.addEventListener('keydown', (e) => {
			const target = e.target as HTMLElement | null;
			if (target && (target.closest('input, textarea, select') || target.isContentEditable)) return;
			if (e.altKey || e.ctrlKey || e.metaKey) return;
			if (e.key === 'ArrowRight') goTo(current[mode] + 1);
			if (e.key === 'ArrowLeft') goTo(current[mode] - 1);
		});

		goTo(1);
	}
</script>
