---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="cb-screen" data-lang={lang}>
	<div class="cb-shell">
		<div class="deck-card">
			<div class="deck-nav-bar">
				<div class="deck-slide-indicator">
					<span class="deck-step-dot"></span>
					<span id="deck-slide-label">SLIDE 1 / 5</span>
				</div>
				<div class="deck-pills">
					<button class="deck-pill-btn active" data-target-slide="1">1. {isEs ? 'Write Once, Run Anywhere' : 'Write Once, Run Anywhere'}</button>
					<button class="deck-pill-btn" data-target-slide="2">2. {isEs ? 'Arquitectura JVM' : 'JVM Architecture'}</button>
					<button class="deck-pill-btn" data-target-slide="3">3. {isEs ? 'Anatomía de main()' : 'Anatomy of main()'}</button>
					<button class="deck-pill-btn" data-target-slide="4">4. {isEs ? 'I/O y Scanner' : 'I/O & Scanner'}</button>
					<button class="deck-pill-btn" data-target-slide="5">5. {isEs ? 'Stack vs Heap' : 'Stack vs Heap'}</button>
				</div>
			</div>

			<div class="cb-viewport">
				<!-- SLIDE 1: WRITE ONCE, RUN ANYWHERE -->
				<div class="deck-slide active" data-slide="1">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">1. {isEs ? 'El Lema: Write Once, Run Anywhere' : 'The Motto: Write Once, Run Anywhere'}</h2>
							<p class="deck-text">
								{isEs
									? 'En lenguajes compilados tradicionales como C, el compilador genera código máquina atado a un procesador específico. En Java, el código fuente se compila a Bytecode (.class): un conjunto de instrucciones universal que cualquier máquina virtual (JVM) puede ejecutar en cualquier sistema operativo.'
									: 'In traditional compiled languages like C, the compiler produces machine code tied to a specific processor. In Java, source code compiles to Bytecode (.class): a universal instruction set that any Java Virtual Machine (JVM) can execute on any operating system.'}
							</p>

							<div class="deck-figure">
								<svg viewBox="0 0 580 260" width="100%" role="img" aria-label={isEs ? 'Pipeline de compilación de Java a Bytecode y ejecución en múltiples JVM' : 'Java compilation pipeline to Bytecode and multi-platform JVM execution'}>
									<!-- Step 1: Source -->
									<rect x="10" y="30" width="110" height="150" rx="16" class="deck-panel" />
									<text x="65" y="60" class="deck-svg-title" text-anchor="middle">Hola.java</text>
									<rect x="25" y="80" width="80" height="8" rx="4" class="deck-wire-dim" />
									<rect x="25" y="96" width="65" height="8" rx="4" class="deck-wire-dim" />
									<rect x="25" y="112" width="75" height="8" rx="4" class="deck-wire-dim" />
									<text x="65" y="160" class="deck-svg-badge" text-anchor="middle">{isEs ? 'Código Fuente' : 'Source Code'}</text>

									<!-- Arrow javac -->
									<path d="M125 105 H175" class="deck-svg-arrow-line" />
									<polygon points="175,99 185,105 175,111" class="deck-svg-arrow-head" />
									<text x="155" y="95" class="deck-svg-tag" text-anchor="middle">javac</text>

									<!-- Step 2: Bytecode -->
									<rect x="190" y="30" width="120" height="150" rx="16" class="deck-panel-accent" />
									<text x="250" y="60" class="deck-svg-title-accent" text-anchor="middle">Hola.class</text>
									<text x="250" y="90" class="deck-svg-mono" text-anchor="middle">0xCAFEBABE</text>
									<text x="250" y="110" class="deck-svg-mono" text-anchor="middle">aload_0</text>
									<text x="250" y="126" class="deck-svg-mono" text-anchor="middle">invokespecial</text>
									<text x="250" y="160" class="deck-svg-badge-accent" text-anchor="middle">{isEs ? 'Bytecode Universal' : 'Universal Bytecode'}</text>

									<!-- Diverging Arrows to Platforms -->
									<path d="M315 70 Q350 70 380 45" class="deck-svg-arrow-line" />
									<polygon points="380,40 388,44 382,50" class="deck-svg-arrow-head" />

									<path d="M315 105 H380" class="deck-svg-arrow-line" />
									<polygon points="380,99 390,105 380,111" class="deck-svg-arrow-head" />

									<path d="M315 140 Q350 140 380 165" class="deck-svg-arrow-line" />
									<polygon points="382,160 388,166 380,170" class="deck-svg-arrow-head" />

									<!-- Platforms -->
									<!-- Windows x86 -->
									<rect x="395" y="20" width="170" height="50" rx="12" class="deck-panel-subtle platform-box" data-platform="win" />
									<text x="410" y="42" class="deck-svg-bold">JVM Windows (x86)</text>
									<text x="410" y="58" class="deck-svg-sub">Intel / AMD instructions</text>

									<!-- macOS ARM -->
									<rect x="395" y="80" width="170" height="50" rx="12" class="deck-panel-subtle platform-box" data-platform="mac" />
									<text x="410" y="102" class="deck-svg-bold">JVM macOS (ARM64)</text>
									<text x="410" y="118" class="deck-svg-sub">Apple Silicon M-Series</text>

									<!-- Linux Server -->
									<rect x="395" y="140" width="170" height="50" rx="12" class="deck-panel-subtle platform-box" data-platform="linux" />
									<text x="410" y="162" class="deck-svg-bold">JVM Linux Server</text>
									<text x="410" y="178" class="deck-svg-sub">ELF binaries & cloud kernel</text>

									<!-- Summary banner -->
									<rect x="10" y="200" width="555" height="42" rx="10" class="deck-ground-card" />
									<text x="287" y="226" class="deck-svg-banner" text-anchor="middle">
										{isEs
											? 'Un solo archivo .class corre inalterado en todas las plataformas gracias a su JVM local.'
											: 'A single .class file runs unmodified across every OS through its local JVM.'}
									</text>
								</svg>
							</div>
						</div>

						<div class="deck-col">
							<div class="deck-interactive-card">
								<div class="deck-card-head">
									<span class="deck-badge">{isEs ? 'Simulador de Bytecode' : 'Bytecode Inspector'}</span>
									<span class="deck-subtext">{isEs ? 'Seleccioná la arquitectura' : 'Select target platform'}</span>
								</div>
								<div class="deck-actions-row">
									<button class="btn btn-secondary platform-btn active" data-arch="win">Windows x86_64</button>
									<button class="btn btn-secondary platform-btn" data-arch="mac">macOS ARM64</button>
									<button class="btn btn-secondary platform-btn" data-arch="linux">Linux Server</button>
								</div>
								<div class="deck-console" id="platform-console">
									<div class="console-head">
										<span class="console-dot dot-red"></span>
										<span class="console-dot dot-yellow"></span>
										<span class="console-dot dot-green"></span>
										<span class="console-title" id="arch-title">JVM Windows (x86_64)</span>
									</div>
									<pre class="console-body" id="arch-body"><code>// Bytecode (.class) es IDÉNTICO:
0: getstatic #2 // System.out
3: ldc #3       // "Hola Mundo"
5: invokevirtual #4 // println

// Instrucciones emitidas por la JVM nativa:
mov eax, [rcx+0x10]
lea rdx, [rel str_hola]
call qword ptr [rax+0x28]</code></pre>
								</div>
								<p class="deck-caption" id="arch-caption">
									{isEs
										? 'El compilador javac nunca interactúa con la arquitectura final: la JVM nativa traduce el bytecode en caliente.'
										: 'The javac compiler never talks to the target chip: the local native JVM translates bytecode at runtime.'}
								</p>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 2: JVM INTERNAL ARCHITECTURE -->
				<div class="deck-slide" data-slide="2">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">2. {isEs ? 'Anatomía Interna de la JVM' : 'JVM Internal Architecture'}</h2>
							<p class="deck-text">
								{isEs
									? 'La Máquina Virtual de Java se divide en tres subsistemas fundamentales: Carga de Clases (ClassLoader), Áreas de Memoria en Tiempo de Ejecución (Runtime Data Areas) y el Motor de Ejecución (Execution Engine).'
									: 'The Java Virtual Machine is split into three foundational subsystems: ClassLoader, Runtime Data Areas, and Execution Engine.'}
							</p>

							<div class="deck-figure">
								<svg viewBox="0 0 560 300" width="100%" role="img" aria-label={isEs ? 'Diagrama de bloques de la arquitectura JVM' : 'JVM Architecture Block Diagram'}>
									<!-- ClassLoader -->
									<rect x="10" y="20" width="160" height="260" rx="16" class="deck-panel jvm-block" data-info="classloader" />
									<text x="90" y="50" class="deck-svg-title" text-anchor="middle">ClassLoader</text>
									<rect x="25" y="70" width="130" height="35" rx="8" class="deck-sub-block" />
									<text x="90" y="92" class="deck-svg-chip" text-anchor="middle">1. Loading (.class)</text>
									<rect x="25" y="115" width="130" height="35" rx="8" class="deck-sub-block" />
									<text x="90" y="137" class="deck-svg-chip" text-anchor="middle">2. Linking / Verifier</text>
									<rect x="25" y="160" width="130" height="35" rx="8" class="deck-sub-block" />
									<text x="90" y="182" class="deck-svg-chip" text-anchor="middle">3. Initialization</text>
									<text x="90" y="240" class="deck-svg-sub" text-anchor="middle">{isEs ? 'Valida seguridad de bytecode' : 'Verifies bytecode security'}</text>

									<!-- Memory Areas -->
									<rect x="190" y="20" width="170" height="260" rx="16" class="deck-panel-accent jvm-block" data-info="memory" />
									<text x="275" y="50" class="deck-svg-title-accent" text-anchor="middle">Runtime Memory</text>
									<rect x="205" y="70" width="140" height="35" rx="8" class="deck-sub-block-accent" />
									<text x="275" y="92" class="deck-svg-chip-accent" text-anchor="middle">Method Area (Clases)</text>
									<rect x="205" y="115" width="140" height="45" rx="8" class="deck-sub-block-accent" />
									<text x="275" y="135" class="deck-svg-chip-accent" text-anchor="middle">HEAP</text>
									<text x="275" y="150" class="deck-svg-mono-sm" text-anchor="middle">{isEs ? 'Objetos vivos' : 'Live objects'}</text>
									<rect x="205" y="170" width="140" height="45" rx="8" class="deck-sub-block-accent" />
									<text x="275" y="190" class="deck-svg-chip-accent" text-anchor="middle">JVM Stacks</text>
									<text x="275" y="205" class="deck-svg-mono-sm" text-anchor="middle">{isEs ? 'Hilos y métodos' : 'Threads & frames'}</text>
									<rect x="205" y="225" width="140" height="35" rx="8" class="deck-sub-block-accent" />
									<text x="275" y="247" class="deck-svg-chip-accent" text-anchor="middle">PC Registers</text>

									<!-- Execution Engine -->
									<rect x="380" y="20" width="170" height="260" rx="16" class="deck-panel jvm-block" data-info="engine" />
									<text x="465" y="50" class="deck-svg-title" text-anchor="middle">Execution Engine</text>
									<rect x="395" y="70" width="140" height="45" rx="8" class="deck-sub-block" />
									<text x="465" y="90" class="deck-svg-chip" text-anchor="middle">{isEs ? 'Intérprete' : 'Interpreter'}</text>
									<text x="465" y="105" class="deck-svg-mono-sm" text-anchor="middle">{isEs ? 'Línea a línea' : 'Line by line'}</text>

									<rect x="395" y="125" width="140" height="60" rx="8" class="deck-sub-block highlight" />
									<text x="465" y="147" class="deck-svg-bold" text-anchor="middle">JIT Compiler</text>
									<text x="465" y="162" class="deck-svg-mono-sm" text-anchor="middle">{isEs ? 'Compila código caliente' : 'HotSpot native compiler'}</text>
									<text x="465" y="176" class="deck-svg-mono-sm" text-anchor="middle">{isEs ? 'a velocidad C++' : 'to C++ speed'}</text>

									<rect x="395" y="195" width="140" height="45" rx="8" class="deck-sub-block" />
									<text x="465" y="215" class="deck-svg-chip" text-anchor="middle">Garbage Collector</text>
									<text x="465" y="230" class="deck-svg-mono-sm" text-anchor="middle">{isEs ? 'Libera memoria huérfana' : 'Reclaims dead memory'}</text>
								</svg>
							</div>
						</div>

						<div class="deck-col">
							<div class="deck-interactive-card">
								<div class="deck-card-head">
									<span class="deck-badge">{isEs ? 'Explorador de Componentes' : 'Subsystem Deep Dive'}</span>
									<span class="deck-subtext">{isEs ? 'Seleccioná un bloque' : 'Click a module'}</span>
								</div>
								<div class="deck-actions-row">
									<button class="btn btn-secondary jvm-btn active" data-target="classloader">ClassLoader</button>
									<button class="btn btn-secondary jvm-btn" data-target="memory">{isEs ? 'Memoria Runtime' : 'Runtime Memory'}</button>
									<button class="btn btn-secondary jvm-btn" data-target="engine">{isEs ? 'Motor de Ejecución' : 'Execution Engine'}</button>
								</div>
								<div class="deck-info-box" id="jvm-info-box">
									<h4 class="info-title" id="jvm-info-title">ClassLoader Subsystem</h4>
									<p class="info-desc" id="jvm-info-desc">
										{isEs
											? 'Se encarga de localizar y cargar los archivos .class en memoria. El Bytecode Verifier analiza la estructura binaria para asegurar que no contenga punteros ilegales, accesos prohibidos ni desbordamientos de pila antes de permitir su ejecución.'
											: 'Locates and loads .class files into memory. The Bytecode Verifier inspects the binary structure to ensure no illegal pointers, forbidden memory access, or stack overflows occur before running.'}
									</p>
									<div class="info-highlight" id="jvm-info-tag">
										{isEs ? '✓ Garantía de Seguridad de Java' : '✓ Java Security Sandbox Guarantee'}
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 3: ANATOMY OF MAIN() -->
				<div class="deck-slide" data-slide="3">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">3. {isEs ? 'Anatomía de public static void main(String[] args)' : 'Anatomy of public static void main(String[] args)'}</h2>
							<p class="deck-text">
								{isEs
									? 'Cada palabra en la firma del método de entrada tiene una razón técnica indiscutible en la arquitectura de Java.'
									: 'Every single keyword in the entry method signature has a precise technical purpose in the Java architecture.'}
							</p>

							<div class="deck-keyword-list">
								<div class="kw-item" data-kw="public">
									<span class="kw-name">public</span>
									<span class="kw-desc">{isEs ? 'Visible para el cargador de la JVM desde cualquier parte fuera de la clase.' : 'Visible to the JVM launcher from outside any package.'}</span>
								</div>
								<div class="kw-item" data-kw="static">
									<span class="kw-name">static</span>
									<span class="kw-desc">{isEs ? 'La JVM puede ejecutarlo directamente sin necesidad de crear un objeto previo con new.' : 'Executable directly by the JVM without allocating an instance first.'}</span>
								</div>
								<div class="kw-item" data-kw="void">
									<span class="kw-name">void</span>
									<span class="kw-desc">{isEs ? 'No devuelve ningún valor. Los errores se señalan mediante excepciones o códigos de salida.' : 'Returns nothing to the caller. Errors exit via exceptions or system exit codes.'}</span>
								</div>
								<div class="kw-item" data-kw="main">
									<span class="kw-name">main</span>
									<span class="kw-desc">{isEs ? 'Nombre canónico e identificador reservado por convención que busca el runtime para arrancar.' : 'Canonical entry point identifier sought by the JVM launcher.'}</span>
								</div>
								<div class="kw-item" data-kw="args">
									<span class="kw-name">String[] args</span>
									<span class="kw-desc">{isEs ? 'Arreglo de cadenas de texto con los argumentos pasados por consola al iniciar.' : 'String array containing command-line arguments supplied at startup.'}</span>
								</div>
							</div>
						</div>

						<div class="deck-col">
							<div class="deck-interactive-card">
								<div class="deck-card-head">
									<span class="deck-badge">{isEs ? 'Simulador de Argumentos CLI' : 'CLI Arguments Simulator'}</span>
									<span class="deck-subtext">{isEs ? 'Probá pasar parámetros' : 'Test passing parameters'}</span>
								</div>
								<div class="deck-cli-box">
									<div class="cli-input-row">
										<span class="cli-prompt">$ java MiApp</span>
										<input type="text" id="cli-input" class="input" value="servidor.cfg 8080 --debug" placeholder="arg1 arg2 arg3" />
									</div>
									<button class="btn btn-primary btn-sm" id="btn-run-cli">{isEs ? 'Ejecutar main(args)' : 'Run main(args)'}</button>
								</div>
								<div class="deck-memory-dump" id="cli-memory-dump">
									<div class="dump-header">{isEs ? 'Memoria del arreglo args en Stack/Heap:' : 'args array memory layout:'}</div>
									<div class="dump-content" id="dump-output">
										<div class="dump-row"><span class="dump-idx">args[0] =</span> <span class="dump-val">"servidor.cfg"</span></div>
										<div class="dump-row"><span class="dump-idx">args[1] =</span> <span class="dump-val">"8080"</span></div>
										<div class="dump-row"><span class="dump-idx">args[2] =</span> <span class="dump-val">"--debug"</span></div>
										<div class="dump-row"><span class="dump-idx">args.length =</span> <span class="dump-val dump-num">3</span></div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 4: I/O & SCANNER -->
				<div class="deck-slide" data-slide="4">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">4. {isEs ? 'Flujos de Entrada y Salida (I/O) y Scanner' : 'Standard I/O Streams and Scanner'}</h2>
							<p class="deck-text">
								{isEs
									? 'La clase System conecta el programa con los tres descriptores estándar del sistema operativo: entrada estándar (in), salida estándar (out) y salida de error (err). Scanner envuelve el stream de bytes y lo parsea en tipos tipados.'
									: 'The System class wires Java to standard OS file descriptors: standard in, out, and err. Scanner wraps raw byte streams into typed tokens.'}
							</p>

							<div class="deck-figure">
								<svg viewBox="0 0 540 240" width="100%" role="img" aria-label={isEs ? 'Flujo de datos entre el sistema operativo, System.in, Scanner y System.out' : 'Data flow between OS, System.in, Scanner, and System.out'}>
									<!-- User Terminal -->
									<rect x="10" y="40" width="120" height="150" rx="14" class="deck-panel" />
									<text x="70" y="70" class="deck-svg-title" text-anchor="middle">Terminal</text>
									<text x="70" y="100" class="deck-svg-mono" text-anchor="middle">"42 Juan\n"</text>
									<text x="70" y="150" class="deck-svg-badge" text-anchor="middle">Teclado / Consola</text>

									<!-- System.in Pipe -->
									<path d="M130 90 H200" class="deck-svg-arrow-line" />
									<polygon points="200,84 210,90 200,96" class="deck-svg-arrow-head" />
									<text x="165" y="80" class="deck-svg-tag" text-anchor="middle">System.in</text>

									<!-- Scanner Parser -->
									<rect x="210" y="40" width="140" height="150" rx="16" class="deck-panel-accent" />
									<text x="280" y="70" class="deck-svg-title-accent" text-anchor="middle">Scanner</text>
									<rect x="225" y="85" width="110" height="28" rx="6" class="deck-sub-block-accent" />
									<text x="280" y="103" class="deck-svg-chip-accent" text-anchor="middle">nextInt() → 42</text>
									<rect x="225" y="120" width="110" height="28" rx="6" class="deck-sub-block-accent" />
									<text x="280" y="138" class="deck-svg-chip-accent" text-anchor="middle">next() → "Juan"</text>

									<!-- System.out Pipe -->
									<path d="M350 90 H420" class="deck-svg-arrow-line" />
									<polygon points="420,84 430,90 420,96" class="deck-svg-arrow-head" />
									<text x="385" y="80" class="deck-svg-tag" text-anchor="middle">System.out</text>

									<!-- Output Display -->
									<rect x="420" y="40" width="110" height="150" rx="14" class="deck-panel" />
									<text x="475" y="70" class="deck-svg-title" text-anchor="middle">Display</text>
									<text x="475" y="110" class="deck-svg-mono" text-anchor="middle">println()</text>
									<text x="475" y="150" class="deck-svg-badge" text-anchor="middle">{isEs ? 'Salida limpia' : 'Screen Output'}</text>
								</svg>
							</div>
						</div>

						<div class="deck-col">
							<div class="deck-interactive-card">
								<div class="deck-card-head">
									<span class="deck-badge">{isEs ? 'Laboratorio Scanner' : 'Scanner Tokenizer Demo'}</span>
									<span class="deck-subtext">{isEs ? 'Paso a paso de lectura' : 'Token consumption'}</span>
								</div>
								<div class="deck-scanner-demo">
									<div class="scanner-buffer">
										<span class="buf-label">Buffer:</span>
										<span class="buf-token consumed" id="tok-1">19</span>
										<span class="buf-token active" id="tok-2">3.1415</span>
										<span class="buf-token" id="tok-3">true</span>
									</div>
									<div class="scanner-controls">
										<button class="btn btn-secondary btn-sm" id="btn-scan-next">{isEs ? 'Leer siguiente token' : 'Read next token'}</button>
										<button class="btn btn-ghost btn-sm" id="btn-scan-reset">{isEs ? 'Reiniciar' : 'Reset'}</button>
									</div>
									<div class="scanner-state-card">
										<div class="state-row">
											<span class="state-label">{isEs ? 'Método usado:' : 'Invoked method:'}</span>
											<span class="state-val" id="scanner-method">scanner.nextDouble()</span>
										</div>
										<div class="state-row">
											<span class="state-label">{isEs ? 'Variable Java asignada:' : 'Assigned Java variable:'}</span>
											<span class="state-val" id="scanner-var">double pi = 3.1415;</span>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 5: STACK VS HEAP FIRST LOOK -->
				<div class="deck-slide" data-slide="5">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">5. {isEs ? 'Stack vs Heap: Primer Vistazo a la Memoria' : 'Stack vs Heap: First Look at Memory'}</h2>
							<p class="deck-text">
								{isEs
