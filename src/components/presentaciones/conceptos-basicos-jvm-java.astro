<script>
	let currentSlide = 1;
	const totalSlides = 5;

	const slideLabel = document.getElementById('deck-slide-label');
	const prevBtn = document.getElementById('deck-prev-btn') as HTMLButtonElement | null;
	const nextBtn = document.getElementById('deck-next-btn') as HTMLButtonElement | null;
	const pillBtns = document.querySelectorAll<HTMLButtonElement>('.deck-pill-btn');
	const slides = document.querySelectorAll<HTMLElement>('.deck-slide');

	function goToSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;

		slides.forEach((slide) => {
			const slideIdx = parseInt(slide.getAttribute('data-slide') || '0', 10);
			slide.classList.toggle('active', slideIdx === currentSlide);
		});

		pillBtns.forEach((btn) => {
			const targetIdx = parseInt(btn.getAttribute('data-target-slide') || '0', 10);
			btn.classList.toggle('active', targetIdx === currentSlide);
		});

		if (slideLabel) {
			slideLabel.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		}

		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	pillBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			const target = parseInt(btn.getAttribute('data-target-slide') || '1', 10);
			goToSlide(target);
		});
	});

	prevBtn?.addEventListener('click', () => goToSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => goToSlide(currentSlide + 1));

	window.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	/* Slide 1: Platform switcher */
	const platformData: Record<string, { title: string; code: string; desc: string }> = {
		win: {
			title: 'JVM Windows (x86_64)',
			code: `// Bytecode (.class) es IDÉNTICO:\n0: getstatic #2 // System.out\n3: ldc #3       // "Hola Mundo"\n5: invokevirtual #4 // println\n\n// Instrucciones emitidas por la JVM nativa x86_64:\nmov eax, [rcx+0x10]\nlea rdx, [rel str_hola]\ncall qword ptr [rax+0x28]`,
			desc: 'En Windows x86_64, el JIT traduce el bytecode a instrucciones Intel/AMD de 64 bits utilizando registros RAX, RDX y RCX.',
		},
		mac: {
			title: 'JVM macOS (Apple Silicon ARM64)',
			code: `// Bytecode (.class) es IDÉNTICO:\n0: getstatic #2 // System.out\n3: ldc #3       // "Hola Mundo"\n5: invokevirtual #4 // println\n\n// Instrucciones emitidas por la JVM nativa ARM64:\nadrp x0, str_hola@PAGE\nadd  x0, x0, str_hola@PAGEOFF\nbl   _printf_bridge`,
			desc: 'En Apple Silicon (M1/M2/M3), la JVM emite instrucciones RISC ARM64 de tamaño fijo (32 bits) usando registros X0-X30.',
		},
		linux: {
			title: 'JVM Linux Server (x86_64 Cloud)',
			code: `// Bytecode (.class) es IDÉNTICO:\n0: getstatic #2 // System.out\n3: ldc #3       // "Hola Mundo"\n5: invokevirtual #4 // println\n\n// Instrucciones emitidas bajo convención System V AMD64:\nmov rdi, [rip+stdout_offset]\nlea rsi, [rip+str_msg]\ncall [rip+fn_vtable]`,
			desc: 'En servidores Linux, la JVM optimiza intensamente el bytecode bajo perfiles de servidor con recolección de basura paralela.',
		},
	};

	document.querySelectorAll<HTMLButtonElement>('.platform-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.platform-btn').forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
			const arch = btn.getAttribute('data-arch') || 'win';
			const data = platformData[arch];
			if (data) {
				const titleEl = document.getElementById('arch-title');
				const bodyEl = document.getElementById('arch-body');
				const captionEl = document.getElementById('arch-caption');
				if (titleEl) titleEl.textContent = data.title;
				if (bodyEl) bodyEl.innerHTML = `<code>${data.code}</code>`;
				if (captionEl) captionEl.textContent = data.desc;
			}
		});
	});

	/* Slide 2: JVM modules */
	const jvmData: Record<string, { title: string; desc: string; tag: string }> = {
		classloader: {
			title: 'ClassLoader Subsystem',
			desc: 'Se encarga de localizar y cargar los archivos .class en memoria. El Bytecode Verifier analiza la estructura binaria para asegurar que no contenga punteros ilegales, accesos prohibidos ni desbordamientos de pila antes de permitir su ejecución.',
			tag: '✓ Garantía de Seguridad de Java',
		},
		memory: {
			title: 'Runtime Data Areas',
			desc: 'El Heap aloja todos los objetos instanciados compartidos por la aplicación. Cada hilo posee su propio Stack privado con marcos de método (variables locales primitivas y direcciones de retorno). El Method Area guarda metadatos de clases y constantes.',
			tag: '⚡ Gestión Dinámica de Memoria',
		},
		engine: {
			title: 'Execution Engine & JIT',
			desc: 'El Intérprete ejecuta el bytecode instrucción por instrucción al arrancar. El compilador JIT (Just-In-Time) detecta qué partes del código se llaman repetidamente (hotspots) y las compila directamente a código máquina nativo del procesador.',
			tag: '🚀 Rendimiento Máximo en Caliente',
		},
	};

	document.querySelectorAll<HTMLButtonElement>('.jvm-btn').forEach((btn) => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.jvm-btn').forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
			const target = btn.getAttribute('data-target') || 'classloader';
			const item = jvmData[target];
			if (item) {
				const titleEl = document.getElementById('jvm-info-title');
				const descEl = document.getElementById('jvm-info-desc');
				const tagEl = document.getElementById('jvm-info-tag');
				if (titleEl) titleEl.textContent = item.title;
				if (descEl) descEl.textContent = item.desc;
				if (tagEl) tagEl.textContent = item.tag;
			}
		});
	});

	/* Slide 3: CLI args simulation */
	const runCliBtn = document.getElementById('btn-run-cli');
	const cliInput = document.getElementById('cli-input') as HTMLInputElement | null;
	const dumpOutput = document.getElementById('dump-output');

	runCliBtn?.addEventListener('click', () => {
		if (!cliInput || !dumpOutput) return;
		const raw = cliInput.value.trim();
		const tokens = raw.length > 0 ? raw.split(/\s+/) : [];
		dumpOutput.innerHTML = '';

		tokens.forEach((tok, idx) => {
			const row = document.createElement('div');
			row.className = 'dump-row';
			row.innerHTML = `<span class="dump-idx">args[${idx}] =</span> <span class="dump-val">"${tok}"</span>`;
			dumpOutput.appendChild(row);
		});

		const lenRow = document.createElement('div');
		lenRow.className = 'dump-row';
		lenRow.innerHTML = `<span class="dump-idx">args.length =</span> <span class="dump-val dump-num">${tokens.length}</span>`;
		dumpOutput.appendChild(lenRow);
	});

	/* Slide 4: Scanner token simulation */
	let scanStep = 0;
	const scanSteps = [
		{ method: 'scanner.nextInt()', variable: 'int edad = 19;', tokActive: 1 },
		{ method: 'scanner.nextDouble()', variable: 'double pi = 3.1415;', tokActive: 2 },
		{ method: 'scanner.nextBoolean()', variable: 'boolean esValido = true;', tokActive: 3 },
	];

	const btnScanNext = document.getElementById('btn-scan-next');
	const btnScanReset = document.getElementById('btn-scan-reset');
	const methodEl = document.getElementById('scanner-method');
	const varEl = document.getElementById('scanner-var');

	function updateScannerUI() {
		for (let i = 1; i <= 3; i++) {
			const tokEl = document.getElementById(`tok-${i}`);
			if (!tokEl) continue;
			tokEl.classList.remove('active', 'consumed');
			if (i < scanStep + 1) tokEl.classList.add('consumed');
			else if (i === scanStep + 1) tokEl.classList.add('active');
		}

		if (scanStep < scanSteps.length) {
			const cur = scanSteps[scanStep];
			if (methodEl) methodEl.textContent = cur.method;
			if (varEl) varEl.textContent = cur.variable;
		} else {
			if (methodEl) methodEl.textContent = 'scanner.hasNext() → false';
			if (varEl) varEl.textContent = '// Fin del stream de entrada';
		}
	}

	btnScanNext?.addEventListener('click', () => {
		if (scanStep < scanSteps.length) {
			scanStep++;
			updateScannerUI();
		}
	});

	btnScanReset?.addEventListener('click', () => {
		scanStep = 0;
		updateScannerUI();
	});
</script>

