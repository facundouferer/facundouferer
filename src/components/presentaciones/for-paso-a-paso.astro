---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="fo-screen">
	<div class="fo-shell">
		<header class="fo-header">
			<span class="fo-badge">{isEs ? 'Iteración Determinada' : 'Determinate Iteration'}</span>
			<h1 class="fo-title">
				{isEs ? 'Ciclo For Paso a Paso' : 'For Loop Step by Step'}
			</h1>
			<p class="fo-sub">
				{isEs 
					? 'Contadores, rangos e iteradores en C, Java, JavaScript y Python.' 
					: 'Counters, ranges, and iterators in C, Java, JavaScript, and Python.'}
			</p>
		</header>

		<div class="fo-deck-card">
			<div class="fo-nav-bar">
				<div class="fo-slide-indicator">
					<span class="fo-step-dot"></span>
					<span id="fo-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="fo-pills">
					<button class="fo-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="fo-pill-btn" data-target-slide="2">2. C</button>
					<button class="fo-pill-btn" data-target-slide="3">3. Java</button>
					<button class="fo-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="fo-pill-btn" data-target-slide="5">5. Python</button>
					<button class="fo-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="fo-viewport">
				<div class="fo-slide active" data-slide="1">
					<div class="fo-slide-grid">
						<div class="fo-col">
							<h2 class="fo-slide-title">1. {isEs ? 'Anatomía del Ciclo For' : 'Anatomy of the For Loop'}</h2>
							<p class="fo-text">
								{isEs 
									? 'El ciclo `for` agrupa inicialización, condición de parada e incremento en una sola línea compacta.'
									: 'The `for` loop combines initialization, stop condition, and step increment in one line.'}
							</p>
						</div>
						<div class="fo-col">
							<div class="fo-card-box">
								<div class="fo-card-head">{isEs ? 'FASES DEL FOR' : 'FOR PHASES'}</div>
								<div class="fo-cell"><span>1. Inicialización</span><span class="fo-tag">i = 0 (1 sola vez)</span></div>
								<div class="fo-cell"><span>2. Condición</span><span class="fo-tag">i &lt; N (Antes de cada paso)</span></div>
								<div class="fo-cell"><span>3. Pasos / Incremento</span><span class="fo-tag">i++ (Tras cada paso)</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="fo-slide" data-slide="2">
					<div class="fo-slide-grid">
						<div class="fo-col">
							<h2 class="fo-slide-title">2. C: for(int i=0; i&lt;n; i++)</h2>
							<p class="fo-text">En C99+ se declara la variable directamente en la inicialización del `for`.</p>
						</div>
						<div class="fo-col">
							<div class="fo-code-card">
								<div class="fo-code-title">for.c</div>
								<pre class="fo-code-block"><code><span class="token-keyword">for</span> (<span class="token-type">int</span> i = <span class="token-number">0</span>; i &lt; <span class="token-number">5</span>; i++) &#123;
    printf(<span class="token-string">"Contador: %d\n"</span>, i);
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="fo-slide" data-slide="3">
					<div class="fo-slide-grid">
						<div class="fo-col">
							<h2 class="fo-slide-title">3. Java: For Tradicional y Enhanced For (For-Each)</h2>
							<p class="fo-text">Java incluye `for(Type x : collection)` para iterar colecciones y arrays limpiamente.</p>
						</div>
						<div class="fo-col">
							<div class="fo-code-card">
								<div class="fo-code-title">ForEach.java</div>
								<pre class="fo-code-block"><code>String[] frutas = &#123;<span class="token-string">"Manzana"</span>, <span class="token-string">"Banana"</span>&#125;;
<span class="token-keyword">for</span> (String f : frutas) &#123;
    System.out.println(f);
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="fo-slide" data-slide="4">
					<div class="fo-slide-grid">
						<div class="fo-col">
							<h2 class="fo-slide-title">4. JavaScript: for...of y for...in</h2>
							<p class="fo-text">`for...of` itera valores de iterables; `for...in` itera claves/propiedades de objetos.</p>
						</div>
						<div class="fo-col">
							<div class="fo-code-card">
								<div class="fo-code-title">for_of.js</div>
								<pre class="fo-code-block"><code><span class="token-keyword">const</span> nums = [<span class="token-number">10</span>, <span class="token-number">20</span>, <span class="token-number">30</span>];
<span class="token-keyword">for</span> (<span class="token-keyword">const</span> num <span class="token-keyword">of</span> nums) &#123;
    console.log(num);
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="fo-slide" data-slide="5">
					<div class="fo-slide-grid">
						<div class="fo-col">
							<h2 class="fo-slide-title">5. Python: for in range()</h2>
							<p class="fo-text">En Python `for` es intrínsecamente un iterador de colecciones o secuencias producidas por `range(start, stop, step)`.</p>
						</div>
						<div class="fo-col">
							<div class="fo-code-card">
								<div class="fo-code-title">for_range.py</div>
								<pre class="fo-code-block"><code><span class="token-keyword">for</span> i <span class="token-keyword">in</span> range(<span class="token-number">0</span>, <span class="token-number">5</span>, <span class="token-number">1</span>):
    print(f<span class="token-string">"i = &#123;i&#125;"</span>)</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="fo-slide" data-slide="6">
					<div class="fo-sim-container">
						<h2 class="fo-slide-title center">{isEs ? '6. Simulador Interactivo de Contador' : '6. Counter Simulator'}</h2>
						<p class="fo-sub center">{isEs ? 'Avanzá paso a paso en el incremento del contador:' : 'Step through counter increments:'}</p>

						<div class="fo-sim-console">
							<div class="fo-sim-head"><span class="fo-console-label">For Trace: i = 0 a 4</span></div>
							<div class="fo-sim-body">
								<div class="fo-trace-step" id="fo-sim-step">Fase 1: Inicialización i = 0. Condición (0 &lt; 5) es TRUE ➔ Ejecuta cuerpo</div>
								<div class="fo-stack-display" id="fo-sim-state">i = 0</div>
							</div>
							<div class="fo-sim-actions">
								<button class="btn btn-primary" id="btn-next-fo-step">▶ {isEs ? 'Siguiente Paso (i++)' : 'Next Step (i++)'}</button>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="fo-footer">
				<button class="btn btn-secondary" id="btn-prev-fo" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="fo-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-fo">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.fo-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.fo-shell { max-width: var(--container-max); margin: 0 auto; }
	.fo-header { margin-bottom: 1.5rem; }
	.fo-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.fo-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.fo-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.fo-sub.center { text-align: center; }
	.fo-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.fo-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.fo-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.fo-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.fo-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.fo-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.fo-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.fo-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.fo-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.fo-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.fo-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.fo-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.fo-col { grid-column: span 12; }
	@media (min-width: 900px) { .fo-col { grid-column: span 6; } }
	.fo-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.fo-slide-title.center { text-align: center; }
	.fo-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.fo-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.fo-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.fo-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.fo-tag { color: var(--color-accent-700); font-weight: 600; }
	.fo-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.fo-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.fo-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.fo-sim-container { max-width: 800px; margin: 0 auto; }
	.fo-sim-console { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-md); }
	.fo-sim-head { background: #2b2722; padding: 0.5rem 0.8rem; }
	.fo-console-label { color: #c0b6a5; font-family: 'Fira Code', monospace; font-size: 0.75rem; }
	.fo-sim-body { padding: 1rem; display: flex; flex-direction: column; gap: 0.8rem; }
	.fo-trace-step { font-size: 0.88rem; line-height: 1.5; color: #f9f4ed; background: #2a2520; padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); }
	.fo-stack-display { font-family: 'Fira Code', monospace; font-size: 0.8rem; color: #76d7c4; background: #141210; padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); }
	.fo-sim-actions { padding: 0.8rem 1rem; background: #25211d; display: flex; justify-content: flex-end; border-top: 1px solid #3a352e; }
	.fo-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.fo-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;
	let foStep = 0;

	const foSteps = [
		{ step: 'Inicialización: i = 0. Condición (0 < 5) es TRUE ➔ Ejecuta cuerpo', state: 'i = 0' },
		{ step: 'Incremento: i++ ➔ i = 1. Condición (1 < 5) es TRUE ➔ Ejecuta cuerpo', state: 'i = 1' },
		{ step: 'Incremento: i++ ➔ i = 2. Condición (2 < 5) es TRUE ➔ Ejecuta cuerpo', state: 'i = 2' },
		{ step: 'Incremento: i++ ➔ i = 3. Condición (3 < 5) es TRUE ➔ Ejecuta cuerpo', state: 'i = 3' },
		{ step: 'Incremento: i++ ➔ i = 4. Condición (4 < 5) es TRUE ➔ Ejecuta cuerpo', state: 'i = 4' },
		{ step: 'Incremento: i++ ➔ i = 5. Condición (5 < 5) es FALSE ➔ Salida del for', state: 'For completado' }
	];

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.fo-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.fo-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('fo-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-fo') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-fo') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.fo-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-fo')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-fo')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	document.getElementById('btn-next-fo-step')?.addEventListener('click', () => {
		foStep = (foStep + 1) % foSteps.length;
		const stepEl = document.getElementById('fo-sim-step');
		const stateEl = document.getElementById('fo-sim-state');
		if (stepEl) stepEl.textContent = foSteps[foStep].step;
		if (stateEl) stateEl.textContent = foSteps[foStep].state;
	});

	goToSlide(1);
</script>
