						<div class="pc-expr-work-area">
							<!-- Mini visual stack for algorithm -->
							<div class="pc-algo-stack-wrapper">
								<span class="pc-algo-stack-label">Pila de Aperturas:</span>
								<div class="pc-algo-stack-slots" id="pc-algo-stack-slots">
									<div class="pc-algo-stack-empty">Vacia</div>
								</div>
