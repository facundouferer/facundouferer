</section>

<script>
	function setupTadPilasColas() {
		// --- NAVIGATION ---
		const slides = document.querySelectorAll<HTMLElement>('.pc-slide');
		const prevBtn = document.getElementById('pc-prev-btn') as HTMLButtonElement | null;
		const nextBtn = document.getElementById('pc-next-btn') as HTMLButtonElement | null;
		const counter = document.getElementById('pc-slide-counter');
		const progressBar = document.getElementById('pc-progress-bar');
		let currentSlide = 1;
		const totalSlides = slides.length;

		function goToSlide(index: number) {
			if (index < 1 || index > totalSlides) return;
			currentSlide = index;
			slides.forEach((s) => {
				const sIndex = Number(s.dataset.slide);
				s.classList.toggle('active', sIndex === currentSlide);
			});

			if (prevBtn) prevBtn.disabled = currentSlide === 1;
			if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
			if (counter) counter.textContent = `${currentSlide} de ${totalSlides}`;
			if (progressBar) {
				const pct = (currentSlide / totalSlides) * 100;
				progressBar.style.width = `${pct}%`;
			}
		}

		prevBtn?.addEventListener('click', () => goToSlide(currentSlide - 1));
		nextBtn?.addEventListener('click', () => goToSlide(currentSlide + 1));

		document.addEventListener('keydown', (e) => {
			if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || e.target instanceof HTMLSelectElement) return;
			if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
			if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
		});

		// --- SLIDE 1: PILA LIFO SIMULATION ---
		let stackData = [10, 20, 30];
		const maxStackCap = 5;

		const stackSlots = document.getElementById('pc-stack-slots');
		const stackBadge = document.getElementById('pc-stack-badge');
		const readoutTop = document.getElementById('pc-readout-top');
		const readoutSize = document.getElementById('pc-readout-size');
		const readoutEmpty = document.getElementById('pc-readout-empty');
		const stackStatus = document.getElementById('pc-stack-status');
		const stackInput = document.getElementById('pc-stack-input') as HTMLInputElement | null;

		function renderStack() {
			if (!stackSlots) return;
			stackSlots.innerHTML = '';

			// Stack items rendered from top to bottom
			for (let i = stackData.length - 1; i >= 0; i--) {
				const val = stackData[i];
				const isTop = i === stackData.length - 1;
				const div = document.createElement('div');
				div.className = `pc-stack-item ${isTop ? 'is-top' : ''}`;
				div.innerHTML = `<span class="pc-item-val">${val}</span>${isTop ? '<span class="pc-item-tag">Top</span>' : ''}`;
				stackSlots.appendChild(div);
			}

			if (stackBadge) stackBadge.textContent = `Capacidad: ${maxStackCap} / En uso: ${stackData.length}`;
			if (readoutSize) readoutSize.textContent = String(stackData.length);
			if (readoutEmpty) readoutEmpty.textContent = stackData.length === 0 ? 'true' : 'false';
			if (readoutTop) readoutTop.textContent = stackData.length > 0 ? String(stackData[stackData.length - 1]) : 'null';
		}

		document.getElementById('pc-btn-push')?.addEventListener('click', () => {
			if (stackData.length >= maxStackCap) {
				if (stackStatus) stackStatus.textContent = '¡Error StackOverflow! Capacidad máxima alcanzada (5 elementos).';
				return;
			}
			const val = parseInt(stackInput?.value || '40', 10);
			stackData.push(val);
			renderStack();
			if (stackStatus) stackStatus.textContent = `push(${val}) completado. ${val} se posa en la cima y ahora es el nuevo tope.`;
			if (stackInput) stackInput.value = String(val + 10);
		});

		document.getElementById('pc-btn-pop')?.addEventListener('click', () => {
			if (stackData.length === 0) {
				if (stackStatus) stackStatus.textContent = '¡Error EmptyStackException (Underflow)! La pila ya está vacía.';
				return;
			}
			const popped = stackData.pop();
			renderStack();
			if (stackStatus) stackStatus.textContent = `pop() retornó ${popped}. El elemento superior salió de la estructura.`;
		});

		document.getElementById('pc-btn-peek')?.addEventListener('click', () => {
			if (stackData.length === 0) {
				if (stackStatus) stackStatus.textContent = 'peek() en pila vacía lanza excepción o retorna null.';
				return;
			}
			const topVal = stackData[stackData.length - 1];
			if (stackStatus) stackStatus.textContent = `peek() inspecciona ${topVal} sin desapilarlo. El tamaño sigue siendo ${stackData.length}.`;
		});

		document.getElementById('pc-btn-reset-stack')?.addEventListener('click', () => {
			stackData = [10, 20, 30];
			renderStack();
			if (stackStatus) stackStatus.textContent = 'Pila reiniciada a [10, 20, 30].';
		});

		// --- SLIDE 2: COLA FIFO SIMULATION ---
		let queueData = ['Ana', 'Beto', 'Caro'];
		const maxQueueCap = 6;
		const queueItems = document.getElementById('pc-queue-items');
		const queueBadge = document.getElementById('pc-queue-badge');
		const qReadoutFront = document.getElementById('pc-q-readout-front');
		const qReadoutRear = document.getElementById('pc-q-readout-rear');
		const qReadoutSize = document.getElementById('pc-q-readout-size');
		const queueStatus = document.getElementById('pc-queue-status');
		const queueInput = document.getElementById('pc-queue-input') as HTMLInputElement | null;

		function renderQueue() {
			if (!queueItems) return;
			queueItems.innerHTML = '';

			queueData.forEach((name, idx) => {
				const isFront = idx === 0;
				const isRear = idx === queueData.length - 1;
				const div = document.createElement('div');
				div.className = `pc-q-item ${isFront ? 'q-front' : ''} ${isRear ? 'q-rear' : ''}`;
				div.innerHTML = `<span class="pc-q-val">"${name}"</span>${isFront ? '<span class="pc-q-role">Front</span>' : isRear ? '<span class="pc-q-role">Rear</span>' : ''}`;
				queueItems.appendChild(div);
			});

			if (queueBadge) queueBadge.textContent = `Capacidad: ${maxQueueCap} / En uso: ${queueData.length}`;
			if (qReadoutSize) qReadoutSize.textContent = String(queueData.length);
			if (qReadoutFront) qReadoutFront.textContent = queueData.length > 0 ? `"${queueData[0]}"` : 'null';
			if (qReadoutRear) qReadoutRear.textContent = queueData.length > 0 ? `"${queueData[queueData.length - 1]}"` : 'null';
		}

		document.getElementById('pc-btn-enqueue')?.addEventListener('click', () => {
			if (queueData.length >= maxQueueCap) {
				if (queueStatus) queueStatus.textContent = 'Cola llena. Espera a que se atiendan clientes antes de encolar.';
				return;
			}
			const name = queueInput?.value.trim() || 'Nuevo';
			queueData.push(name);
			renderQueue();
			if (queueStatus) queueStatus.textContent = `offer("${name}"): ingresó al final de la fila (tail/rear).`;
		});

		document.getElementById('pc-btn-dequeue')?.addEventListener('click', () => {
			if (queueData.length === 0) {
				if (queueStatus) queueStatus.textContent = 'poll(): La cola está vacía. No hay nadie para atender.';
				return;
			}
			const served = queueData.shift();
			renderQueue();
			if (queueStatus) queueStatus.textContent = `poll(): "${served}" fue atendido y sale por el frente (head).`;
		});

		document.getElementById('pc-btn-peek-queue')?.addEventListener('click', () => {
			if (queueData.length === 0) {
				if (queueStatus) queueStatus.textContent = 'peek(): Cola vacía.';
				return;
			}
			if (queueStatus) queueStatus.textContent = `peek(): El próximo en turno es "${queueData[0]}".`;
		});

		document.getElementById('pc-btn-reset-queue')?.addEventListener('click', () => {
			queueData = ['Ana', 'Beto', 'Caro'];
			renderQueue();
			if (queueStatus) queueStatus.textContent = 'Cola reiniciada con ["Ana", "Beto", "Caro"].';
		});

		// --- SLIDE 3: COLA CIRCULAR SIMULATION ---
		const circCap = 8;
		let circSlots: Array<string | null> = ['A', 'B', 'C', null, null, null, null, null];
		let circFront = 0;
		let circRear = 2;
		let circCount = 3;

		const circCalcText = document.getElementById('pc-circ-calc-text');
		const circCalcRes = document.getElementById('pc-circ-calc-res');
		const circBadge = document.getElementById('pc-circ-badge');
		const circStatus = document.getElementById('pc-circ-status');

		function renderCircularQueue() {
			for (let i = 0; i < circCap; i++) {
				const slotGroup = document.getElementById(`pc-slot-${i}`);
				if (!slotGroup) continue;
				const circle = slotGroup.querySelector('circle');
				const text = slotGroup.querySelectorAll('text')[0];

				const val = circSlots[i];
				const isOccupied = val !== null;
				const isFront = isOccupied && i === circFront;
				const isRear = isOccupied && i === circRear;

				if (circle) {
					if (isFront && isRear) {
						circle.setAttribute('fill', 'var(--color-accent)');
						circle.setAttribute('fill-opacity', '0.6');
						circle.setAttribute('stroke', 'var(--color-accent)');
					} else if (isFront) {
						circle.setAttribute('fill', 'var(--color-accent)');
						circle.setAttribute('fill-opacity', '0.4');
						circle.setAttribute('stroke', 'var(--color-accent-700)');
					} else if (isRear) {
						circle.setAttribute('fill', 'var(--color-surface)');
						circle.setAttribute('fill-opacity', '1');
						circle.setAttribute('stroke', 'var(--color-accent)');
					} else if (isOccupied) {
						circle.setAttribute('fill', 'var(--color-accent)');
						circle.setAttribute('fill-opacity', '0.2');
						circle.setAttribute('stroke', 'var(--color-divider)');
					} else {
						circle.setAttribute('fill', 'var(--color-bg)');
						circle.setAttribute('fill-opacity', '1');
						circle.setAttribute('stroke', 'var(--color-divider)');
					}
				}

				if (text) {
					text.textContent = val || '—';
					text.setAttribute('fill', isOccupied ? 'var(--color-text)' : 'var(--color-text-muted)');
				}
			}

			if (circBadge) circBadge.textContent = `frente: [${circFront}] | fin: [${circRear}] | ocupados: ${circCount}/${circCap}`;
		}

		document.getElementById('pc-circ-enqueue')?.addEventListener('click', () => {
			if (circCount >= circCap) {
				if (circStatus) circStatus.textContent = 'Cola circular llena. No se puede encolar sin sobreescribir.';
				return;
			}
			const nextVal = String.fromCharCode(65 + ((circCount + circFront) % 26));
			const oldRear = circRear;
			circRear = (circRear + 1) % circCap;
			circSlots[circRear] = nextVal;
			circCount++;

			if (circCalcText) circCalcText.textContent = `(${oldRear} + 1) % ${circCap}`;
			if (circCalcRes) circCalcRes.textContent = `Nuevo fin = [${circRear}]`;
			if (circStatus) circStatus.textContent = `Encolado '${nextVal}' en la celda [${circRear}]. Cálculo: (${oldRear} + 1) % 8 = ${circRear}.`;
			renderCircularQueue();
		});

		document.getElementById('pc-circ-dequeue')?.addEventListener('click', () => {
			if (circCount === 0) {
				if (circStatus) circStatus.textContent = 'Cola circular vacía.';
				return;
			}
			const removed = circSlots[circFront];
			circSlots[circFront] = null;
			const oldFront = circFront;
			circFront = (circFront + 1) % circCap;
			circCount--;

			if (circCalcText) circCalcText.textContent = `(${oldFront} + 1) % ${circCap}`;
			if (circCalcRes) circCalcRes.textContent = `Nuevo frente = [${circFront}]`;
			if (circStatus) circStatus.textContent = `Desencolado '${removed}' de celda [${oldFront}]. El frente avanza a [${circFront}].`;
			renderCircularQueue();
		});

		document.getElementById('pc-circ-reset')?.addEventListener('click', () => {
			circSlots = ['A', 'B', 'C', null, null, null, null, null];
			circFront = 0;
			circRear = 2;
			circCount = 3;
			if (circCalcText) circCalcText.textContent = '(fin + 1) % 8';
			if (circCalcRes) circCalcRes.textContent = 'Índice: 2 → 3';
			if (circStatus) circStatus.textContent = 'Cola circular reiniciada al estado base [A, B, C].';
			renderCircularQueue();
		});

		// --- SLIDE 5: BALANCED EXPRESSION VALIDATOR ---
		const exprSelect = document.getElementById('pc-expr-select') as HTMLSelectElement | null;
		const exprCustomInput = document.getElementById('pc-expr-custom-input') as HTMLInputElement | null;
		const charTape = document.getElementById('pc-char-tape');
		const algoStackSlots = document.getElementById('pc-algo-stack-slots');
		const algoLogBox = document.getElementById('pc-algo-log-box');
		const exprResultBadge = document.getElementById('pc-expr-result-badge');

		let currentExpr = '{ [ ( a + b ) * c ] }';
		let exprChars: string[] = [];
		let exprIndex = 0;
		let exprStack: string[] = [];
		let exprFinished = false;

		function loadExpression(expr: string) {
			currentExpr = expr;
			exprChars = expr.split('').filter((c) => c !== ' ');
			exprIndex = 0;
			exprStack = [];
			exprFinished = false;

			if (exprResultBadge) {
				exprResultBadge.textContent = 'En progreso';
				exprResultBadge.className = 'pc-badge';
			}
			if (algoLogBox) {
				algoLogBox.textContent = `Expresión cargada: "${expr}". Pulsa "Paso Siguiente" para comenzar el análisis.`;
			}

			renderExprTape();
			renderAlgoStack();
		}

		function renderExprTape() {
			if (!charTape) return;
			charTape.innerHTML = '';
			exprChars.forEach((ch, idx) => {
				const span = document.createElement('span');
				span.className = `pc-char-cell ${idx === exprIndex ? 'is-current' : idx < exprIndex ? 'is-processed' : ''}`;
				span.textContent = ch;
				charTape.appendChild(span);
			});
		}

		function renderAlgoStack() {
			if (!algoStackSlots) return;
			algoStackSlots.innerHTML = '';
			if (exprStack.length === 0) {
				algoStackSlots.innerHTML = '<div class="pc-algo-stack-empty">Pila vacía</div>';
				return;
			}
			for (let i = exprStack.length - 1; i >= 0; i--) {
				const item = document.createElement('div');
				item.className = 'pc-algo-stack-item';
				item.textContent = exprStack[i];
				algoStackSlots.appendChild(item);
			}
		}

		function matches(open: string, close: string): boolean {
			return (
				(open === '(' && close === ')') ||
				(open === '[' && close === ']') ||
				(open === '{' && close === '}')
			);
		}

		function stepExpression() {
			if (exprFinished) return;

			if (exprIndex >= exprChars.length) {
				exprFinished = true;
				if (exprStack.length === 0) {
					if (exprResultBadge) {
						exprResultBadge.textContent = '¡Válida!';
						exprResultBadge.className = 'pc-badge text-accent';
					}
					if (algoLogBox) {
						algoLogBox.innerHTML = '<strong>Éxito:</strong> Fin de la cadena alcanzado y la pila está vacía. Todos los delimitadores coincidieron perfectamente.';
					}
				} else {
					if (exprResultBadge) {
						exprResultBadge.textContent = 'Inválida';
						exprResultBadge.className = 'pc-badge is-error';
					}
					if (algoLogBox) {
						algoLogBox.innerHTML = `<strong>Fallo de apertura:</strong> Quedaron símbolos sin cerrar en la pila: <code>${exprStack.join(', ')}</code>.`;
					}
				}
				renderExprTape();
				return;
			}

			const ch = exprChars[exprIndex];

			if (ch === '(' || ch === '[' || ch === '{') {
				exprStack.push(ch);
				if (algoLogBox) {
					algoLogBox.innerHTML = `Carácter <code>'${ch}'</code> es un delimitador de apertura. Se ejecuta <code>push('${ch}')</code> a la pila.`;
				}
				exprIndex++;
			} else if (ch === ')' || ch === ']' || ch === '}') {
				if (exprStack.length === 0) {
					exprFinished = true;
					if (exprResultBadge) {
						exprResultBadge.textContent = 'Inválida';
						exprResultBadge.className = 'pc-badge is-error';
					}
					if (algoLogBox) {
						algoLogBox.innerHTML = `<strong>Error de subdesbordamiento:</strong> Se encontró un cierre <code>'${ch}'</code> pero la pila estaba vacía (cierre sin apertura previa).`;
					}
					renderExprTape();
					return;
				}
				const top = exprStack.pop()!;
				if (!matches(top, ch)) {
					exprFinished = true;
					if (exprResultBadge) {
						exprResultBadge.textContent = 'Inválida';
						exprResultBadge.className = 'pc-badge is-error';
					}
					if (algoLogBox) {
						algoLogBox.innerHTML = `<strong>Error de coincidencia:</strong> Se esperaba el cierre de <code>'${top}'</code>, pero se encontró <code>'${ch}'</code> (cruce o desorden).`;
					}
					renderExprTape();
					renderAlgoStack();
					return;
				}
				if (algoLogBox) {
					algoLogBox.innerHTML = `Carácter <code>'${ch}'</code> coincide con el tope <code>'${top}'</code>. Se desapila exitosamente con <code>pop()</code>.`;
				}
				exprIndex++;
			} else {
				// Non-delimiter operand or operator
				if (algoLogBox) {
					algoLogBox.innerHTML = `Carácter <code>'${ch}'</code> es un operando o símbolo neutral. Se ignora y continúa la lectura.`;
				}
				exprIndex++;
			}

			renderExprTape();
			renderAlgoStack();

			if (exprIndex === exprChars.length && !exprFinished) {
				stepExpression();
			}
		}

		exprSelect?.addEventListener('change', (e) => {
			const val = (e.target as HTMLSelectElement).value;
			if (val === 'custom') {
				if (exprCustomInput) {
					exprCustomInput.style.display = 'block';
					loadExpression(exprCustomInput.value || '{ [ ] }');
				}
			} else {
				if (exprCustomInput) exprCustomInput.style.display = 'none';
				loadExpression(val);
			}
		});

		exprCustomInput?.addEventListener('input', () => {
			loadExpression(exprCustomInput.value);
		});

		document.getElementById('pc-btn-expr-step')?.addEventListener('click', stepExpression);
		document.getElementById('pc-btn-expr-auto')?.addEventListener('click', () => {
			while (!exprFinished && exprIndex < exprChars.length) {
				stepExpression();
			}
			if (!exprFinished) stepExpression();
		});
		document.getElementById('pc-btn-expr-reset')?.addEventListener('click', () => {
			loadExpression(currentExpr);
		});

		// Initial expr load
		loadExpression(currentExpr);

		// --- SLIDE 6: DISCRETE EVENT SIMULATION ---
		let simTick = 0;
		let clientsServed = 0;
		let totalWaitTime = 0;

		interface Client {
			id: number;
			serviceTicksRequired: number;
			ticksWaited: number;
		}

		let nextClientId = 1;
		let fastQueue: Client[] = [];
		let generalQueue: Client[] = [];

		let desk1Serving: Client | null = null;
		let desk1Remaining = 0;

		let desk2Serving: Client | null = null;
		let desk2Remaining = 0;

		const desk1Status = document.getElementById('pc-desk1-status');
		const desk2Status = document.getElementById('pc-desk2-status');
		const desk1Client = document.getElementById('pc-desk1-client');
		const desk2Client = document.getElementById('pc-desk2-client');
		const lane1Queue = document.getElementById('pc-lane1-queue');
		const lane2Queue = document.getElementById('pc-lane2-queue');

		const simClock = document.getElementById('pc-sim-clock');
		const simServed = document.getElementById('pc-sim-served');
		const simAvgWait = document.getElementById('pc-sim-avg-wait');
		const simInQueue = document.getElementById('pc-sim-in-queue');
		const simStatus = document.getElementById('pc-sim-status');

		function renderSim() {
			if (simClock) simClock.textContent = `Reloj: T = ${simTick} seg`;
			if (simServed) simServed.textContent = String(clientsServed);
			const avg = clientsServed > 0 ? (totalWaitTime / clientsServed).toFixed(1) : '0.0';
			if (simAvgWait) simAvgWait.textContent = `${avg} s`;
			if (simInQueue) simInQueue.textContent = String(fastQueue.length + generalQueue.length);

			// Desk 1
			if (desk1Serving) {
				if (desk1Status) {
					desk1Status.textContent = `Ocupado (${desk1Remaining}s)`;
					desk1Status.className = 'pc-desk-status busy';
				}
				if (desk1Client) desk1Client.textContent = `Cliente C${desk1Serving.id}`;
			} else {
				if (desk1Status) {
					desk1Status.textContent = 'Libre';
					desk1Status.className = 'pc-desk-status idle';
				}
				if (desk1Client) desk1Client.textContent = 'Esperando';
			}

			// Desk 2
			if (desk2Serving) {
				if (desk2Status) {
					desk2Status.textContent = `Ocupado (${desk2Remaining}s)`;
					desk2Status.className = 'pc-desk-status busy';
				}
				if (desk2Client) desk2Client.textContent = `Cliente C${desk2Serving.id}`;
			} else {
				if (desk2Status) {
					desk2Status.textContent = 'Libre';
					desk2Status.className = 'pc-desk-status idle';
				}
				if (desk2Client) desk2Client.textContent = 'Esperando';
			}

			// Render queues
			if (lane1Queue) {
				lane1Queue.innerHTML = '';
				fastQueue.forEach((c) => {
					const div = document.createElement('div');
					div.className = 'pc-client-pill';
					div.textContent = `C${c.id} (${c.serviceTicksRequired}s)`;
					lane1Queue.appendChild(div);
				});
			}

			if (lane2Queue) {
				lane2Queue.innerHTML = '';
				generalQueue.forEach((c) => {
					const div = document.createElement('div');
					div.className = 'pc-client-pill';
					div.textContent = `C${c.id} (${c.serviceTicksRequired}s)`;
					lane2Queue.appendChild(div);
				});
			}
		}

		function addSimClient() {
			const isFast = Math.random() > 0.4;
			const serviceTicks = isFast ? 2 : 4;
			const client: Client = {
				id: nextClientId++,
				serviceTicksRequired: serviceTicks,
				ticksWaited: 0,
			};

			if (isFast) {
				fastQueue.push(client);
				if (simStatus) simStatus.textContent = `Nuevo Cliente C${client.id} (rápido, ${serviceTicks}s) se formó en la Caja 1.`;
			} else {
				generalQueue.push(client);
				if (simStatus) simStatus.textContent = `Nuevo Cliente C${client.id} (general, ${serviceTicks}s) se formó en la Caja 2.`;
			}
			renderSim();
		}

		function advanceTick() {
			simTick++;

			// Increment wait times
			fastQueue.forEach((c) => c.ticksWaited++);
			generalQueue.forEach((c) => c.ticksWaited++);

			// Process Desk 1
			if (desk1Serving) {
				desk1Remaining--;
				if (desk1Remaining <= 0) {
					clientsServed++;
					totalWaitTime += desk1Serving.ticksWaited;
					desk1Serving = null;
				}
			}
			if (!desk1Serving && fastQueue.length > 0) {
				desk1Serving = fastQueue.shift()!;
				desk1Remaining = desk1Serving.serviceTicksRequired;
			}

			// Process Desk 2
			if (desk2Serving) {
				desk2Remaining--;
				if (desk2Remaining <= 0) {
					clientsServed++;
					totalWaitTime += desk2Serving.ticksWaited;
					desk2Serving = null;
				}
			}
			if (!desk2Serving && generalQueue.length > 0) {
				desk2Serving = generalQueue.shift()!;
				desk2Remaining = desk2Serving.serviceTicksRequired;
			}

			// Random spontaneous arrival
			if (Math.random() > 0.6) {
				addSimClient();
			}

			renderSim();
		}

		document.getElementById('pc-sim-tick')?.addEventListener('click', advanceTick);
		document.getElementById('pc-sim-add-client')?.addEventListener('click', addSimClient);
		document.getElementById('pc-sim-reset')?.addEventListener('click', () => {
			simTick = 0;
			clientsServed = 0;
			totalWaitTime = 0;
			nextClientId = 1;
			fastQueue = [];
			generalQueue = [];
			desk1Serving = null;
			desk1Remaining = 0;
			desk2Serving = null;
			desk2Remaining = 0;
			if (simStatus) simStatus.textContent = 'Simulación reiniciada a tiempo cero.';
			renderSim();
		});

		// Initialize Slide 1 and 2
		renderStack();
		renderQueue();
		renderCircularQueue();
		renderSim();
	}

	setupTadPilasColas();
	document.addEventListener('astro:page-load', setupTadPilasColas);
</script>

