							</select>
							<input type="text" id="pc-expr-custom-input" class="pc-input" style="display: none;" placeholder="Escribe tu expresión aquí..." />
						</div>

						<!-- Tape of characters with read head -->
						<div class="pc-tape-container">
							<div class="pc-tape-label">Tira de Caracteres (Lectura Izq → Der):</div>
							<div class="pc-char-tape" id="pc-char-tape">
