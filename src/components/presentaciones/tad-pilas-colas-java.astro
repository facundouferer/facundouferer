---
interface Props {
	lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;

const t = {
	es: {
		kicker: 'Estructuras de Datos Lineales',
		title: 'TAD Pila (LIFO) y TAD Cola (FIFO) en Java',
		subtitle: 'Disciplinas de acceso restringido, aritmética circular y aplicaciones algorítmicas.',
		slide: 'Diapositiva',
		of: 'de',
		prev: 'Anterior',
		next: 'Siguiente',
		reset: 'Reiniciar',
		step: 'Paso',
		status: 'Estado',
		code: 'Código Java',
		s1Title: 'TAD Pila (LIFO): Disciplina Último en Entrar, Primero en Salir',
		s1Desc: 'En una pila solo se puede interactuar con el extremo superior ("tope"). Todo elemento insertado se apila sobre el anterior y es el primero en ser desapilado.',
		s1Push: 'Apilar (push)',
		s1Pop: 'Desapilar (pop)',
		s1Peek: 'Consultar (peek)',
		s1Top: 'tope',
		s1Empty: 'La pila está vacía (underflow si se desapila)',
		s1Full: 'Capacidad máxima alcanzada (posible overflow)',
		s2Title: 'TAD Cola (FIFO): Disciplina Primero en Entrar, Primero en Salir',
		s2Desc: 'En una cola honesta, los elementos ingresan por la parte trasera (fin / tail) y se atienden o extraen por el frente (head).',
		s2Enqueue: 'Encolar (enqueue)',
		s2Dequeue: 'Desencolar (dequeue)',
		s2Peek: 'Consultar frente',
		s2Front: 'frente',
		s2Rear: 'fin',
		s3Title: 'Cola Circular sobre Array: La Aritmética Modular',
		s3Desc: 'Un array lineal desperdicia espacio al desencolar. La cola circular reutiliza celdas conectando el índice final con el inicial mediante la fórmula: (fin + 1) % capacidad.',
		s3StepEnqueue: 'Encolar siguiente',
		s3StepDequeue: 'Desencolar',
		s3Formula: 'Cálculo del puntero:',
		s4Title: 'Pilas y Colas en la Arquitectura de Software Real',
		s4Desc: 'Dónde residen estas estructuras en los sistemas productivos que usamos todos los días.',
		s5Title: 'Algoritmo de Expresiones Balanceadas con Pila',
		s5Desc: 'Verificación de delimitadores (), [], {} mediante apilado de aperturas y validación estricta al encontrar un cierre.',
		s5Run: 'Validar paso a paso',
		s5Auto: 'Ejecutar automático',
		s5ValidBadge: 'Expresión Balanceada',
		s5InvalidBadge: 'Expresión Desbalanceada',
		s6Title: 'Simulación de Eventos Discretos: Dos Colas de Atención',
		s6Desc: 'Modelado de un sistema de atención concurrente con cola rápida y cola general avanzando en el tiempo simulado.',
		s6NextTick: 'Avanzar tiempo (Tick +1)',
		s6AddClient: 'Llegada de cliente',
	},
	en: {
		kicker: 'Linear Data Structures',
		title: 'Stack ADT (LIFO) and Queue ADT (FIFO) in Java',
		subtitle: 'Restricted access disciplines, modular circular arrays, and algorithmic applications.',
		slide: 'Slide',
		of: 'of',
		prev: 'Previous',
		next: 'Next',
		reset: 'Reset',
		step: 'Step',
		status: 'Status',
		code: 'Java Code',
		s1Title: 'Stack ADT (LIFO): Last-In, First-Out Access',
		s1Desc: 'In a stack you can only interact with the top. Elements are placed on top and are the first to be popped out.',
		s1Push: 'Push',
		s1Pop: 'Pop',
		s1Peek: 'Peek',
		s1Top: 'top',
		s1Empty: 'Stack is empty (underflow if popped)',
		s1Full: 'Maximum capacity reached (potential overflow)',
		s2Title: 'Queue ADT (FIFO): First-In, First-Out Discipline',
		s2Desc: 'In a fair queue, elements enter at the rear (tail) and are served or removed from the front (head).',
		s2Enqueue: 'Enqueue',
		s2Dequeue: 'Dequeue',
		s2Peek: 'Peek front',
		s2Front: 'front',
		s2Rear: 'rear',
		s3Title: 'Circular Queue on Arrays: Modular Arithmetic',
		s3Desc: 'A linear array wastes slots when dequeuing. The circular queue wraps indices around using: (rear + 1) % capacity.',
		s3StepEnqueue: 'Enqueue next',
		s3StepDequeue: 'Dequeue',
		s3Formula: 'Pointer computation:',
		s4Title: 'Stacks and Queues in Real Software Architecture',
		s4Desc: 'Where these structures live across everyday production platforms and runtime environments.',
		s5Title: 'Balanced Expression Validator using a Stack',
		s5Desc: 'Validating delimiters (), [], {} by pushing openings and checking matching closures against stack top.',
		s5Run: 'Step-by-step validate',
		s5Auto: 'Auto run',
		s5ValidBadge: 'Balanced Expression',
		s5InvalidBadge: 'Unbalanced Expression',
		s6Title: 'Discrete-Event Simulation: Dual Service Queues',
		s6Desc: 'Modeling concurrent service desks with fast and standard customer queues over simulated ticks.',
		s6NextTick: 'Advance time (Tick +1)',
		s6AddClient: 'Arrival of customer',
	},
}[lang];
---

<section class="pc-screen" aria-label="Presentación TAD Pila y Cola Java">
	<div class="pc-shell">
		<header class="pc-nav-top">
			<div class="pc-nav-title">
				<span class="pc-kicker">{t.kicker}</span>
				<h1 class="pc-main-title">{t.title}</h1>
			</div>
			<div class="pc-nav-controls">
				<button type="button" class="pc-btn pc-btn-secondary" id="pc-prev-btn" aria-label={t.prev}>
					← {t.prev}
				</button>
				<span class="pc-counter" id="pc-slide-counter">1 {t.of} 6</span>
				<button type="button" class="pc-btn pc-btn-secondary" id="pc-next-btn" aria-label={t.next}>
					{t.next} →
				</button>
			</div>
		</header>

		<div class="pc-progress-track" role="progressbar" aria-valuenow="1" aria-valuemin="1" aria-valuemax="6">
			<div class="pc-progress-bar" id="pc-progress-bar" style="width: 16.66%;"></div>
		</div>

		<main class="pc-viewport">
			<!-- SLIDE 1: LA PILA (LIFO) -->
			<article class="pc-slide active" data-slide="1">
				<div class="pc-slide-header">
					<span class="pc-slide-tag tag tag-accent">Slide 1 / 6 • LIFO Discipline</span>
					<h2 class="pc-slide-title">{t.s1Title}</h2>
					<p class="pc-slide-desc">{t.s1Desc}</p>
				</div>

				<div class="pc-dual-grid">
					<div class="pc-card pc-simulator-box">
						<div class="pc-card-header">
							<span class="pc-card-label">Simulador Visual de Pila (LIFO)</span>
							<span class="pc-badge" id="pc-stack-badge">Capacidad: 5 / En uso: 3</span>
						</div>

						<div class="pc-stack-visual-zone">
							<!-- Vertical Tube Container -->
							<div class="pc-stack-tube" id="pc-stack-tube">
								<div class="pc-tube-top-opening">
									<span class="pc-top-arrow-indicator" id="pc-top-arrow">↓ {t.s1Top}</span>
								</div>
								<div class="pc-stack-slots" id="pc-stack-slots">
									<!-- Elements rendered top-to-bottom or absolute -->
									<div class="pc-stack-item item-3" id="pc-item-3">
										<span class="pc-item-val">30</span>
										<span class="pc-item-tag">Top Element</span>
									</div>
									<div class="pc-stack-item item-2" id="pc-item-2">
										<span class="pc-item-val">20</span>
									</div>
									<div class="pc-stack-item item-1" id="pc-item-1">
										<span class="pc-item-val">10</span>
									</div>
								</div>
								<div class="pc-tube-bottom"></div>
							</div>

							<!-- State readout -->
							<div class="pc-stack-readout">
								<div class="pc-metric-tile">
									<span class="pc-metric-label">Tope actual</span>
									<span class="pc-metric-value text-accent" id="pc-readout-top">30</span>
								</div>
								<div class="pc-metric-tile">
									<span class="pc-metric-label">Tamaño (size)</span>
									<span class="pc-metric-value" id="pc-readout-size">3</span>
								</div>
								<div class="pc-metric-tile">
									<span class="pc-metric-label">¿Está vacía?</span>
									<span class="pc-metric-value" id="pc-readout-empty">false</span>
								</div>
							</div>
						</div>

						<div class="pc-action-bar">
							<div class="pc-input-group">
								<input type="number" id="pc-stack-input" class="pc-input" value="40" min="1" max="99" aria-label="Valor para apilar" />
								<button type="button" class="pc-btn pc-btn-primary" id="pc-btn-push">+ {t.s1Push}</button>
							</div>
							<button type="button" class="pc-btn pc-btn-secondary" id="pc-btn-pop">- {t.s1Pop}</button>
							<button type="button" class="pc-btn pc-btn-outline" id="pc-btn-peek">👁 {t.s1Peek}</button>
							<button type="button" class="pc-btn pc-btn-ghost" id="pc-btn-reset-stack">↺ {t.reset}</button>
						</div>
						<div class="pc-status-banner" id="pc-stack-status">
							Acción: Estado inicial cargado con [10, 20, 30]. Tope en 30.
						</div>
					</div>

					<div class="pc-card pc-theory-box">
						<h3 class="pc-card-title">Anatomía y Contrato en Java</h3>
						<div class="pc-code-block">
							<pre><code>// Contrato del TAD Pila
public interface Pila&lt;T&gt; &#123;
    void push(T elemento);  // O(1)
    T pop();                // O(1)
    T peek();               // O(1)
    boolean isEmpty();      // O(1)
    int size();             // O(1)
&#125;

// Ejemplo de uso:
Pila&lt;Integer&gt; p = new PilaEnlazada&lt;&gt;();
p.push(10);
p.push(20);
p.push(30);
int x = p.pop(); // Retorna 30 (LIFO)</code></pre>
						</div>
						<div class="pc-callout">
							<strong>Regla de oro:</strong> Una pila prohíbe el acceso por índice arbitrario (`p.get(1)` es ilegal). Esto garantiza que el último estado registrado siempre sea recuperado de forma predecible e instantánea.
						</div>
					</div>
				</div>
			</article>

			<!-- SLIDE 2: LA COLA (FIFO) -->
			<article class="pc-slide" data-slide="2">
				<div class="pc-slide-header">
					<span class="pc-slide-tag tag tag-accent">Slide 2 / 6 • FIFO Discipline</span>
					<h2 class="pc-slide-title">{t.s2Title}</h2>
					<p class="pc-slide-desc">{t.s2Desc}</p>
				</div>

				<div class="pc-dual-grid">
					<div class="pc-card pc-simulator-box">
						<div class="pc-card-header">
							<span class="pc-card-label">Tubería Horizontal FIFO</span>
							<span class="pc-badge" id="pc-queue-badge">Capacidad: 6 / En uso: 3</span>
						</div>

						<div class="pc-queue-visual-zone">
							<div class="pc-queue-labels">
								<span class="pc-pointer-badge pc-pointer-out">← {t.s2Front} (Salida / poll)</span>
								<span class="pc-pointer-badge pc-pointer-in">Entrada (offer) ← {t.s2Rear}</span>
							</div>

							<!-- Horizontal Pipe -->
							<div class="pc-queue-pipe" id="pc-queue-pipe">
								<div class="pc-queue-items" id="pc-queue-items">
									<div class="pc-q-item q-front" id="pc-q-0">
										<span class="pc-q-val">"Ana"</span>
										<span class="pc-q-role">Head</span>
									</div>
									<div class="pc-q-item" id="pc-q-1">
										<span class="pc-q-val">"Beto"</span>
									</div>
									<div class="pc-q-item q-rear" id="pc-q-2">
										<span class="pc-q-val">"Caro"</span>
										<span class="pc-q-role">Tail</span>
									</div>
								</div>
							</div>

							<div class="pc-stack-readout">
								<div class="pc-metric-tile">
									<span class="pc-metric-label">Próximo a salir</span>
									<span class="pc-metric-value text-accent" id="pc-q-readout-front">"Ana"</span>
								</div>
								<div class="pc-metric-tile">
									<span class="pc-metric-label">Último ingresado</span>
									<span class="pc-metric-value" id="pc-q-readout-rear">"Caro"</span>
								</div>
								<div class="pc-metric-tile">
									<span class="pc-metric-label">Tamaño</span>
									<span class="pc-metric-value" id="pc-q-readout-size">3</span>
								</div>
							</div>
						</div>

						<div class="pc-action-bar">
							<div class="pc-input-group">
								<input type="text" id="pc-queue-input" class="pc-input" value="David" maxlength="8" aria-label="Nombre para encolar" />
								<button type="button" class="pc-btn pc-btn-primary" id="pc-btn-enqueue">+ {t.s2Enqueue}</button>
							</div>
							<button type="button" class="pc-btn pc-btn-secondary" id="pc-btn-dequeue">- {t.s2Dequeue}</button>
							<button type="button" class="pc-btn pc-btn-outline" id="pc-btn-peek-queue">👁 {t.s2Peek}</button>
							<button type="button" class="pc-btn pc-btn-ghost" id="pc-btn-reset-queue">↺ {t.reset}</button>
						</div>
						<div class="pc-status-banner" id="pc-queue-status">
							Cola lista. "Ana" es atendida primero por ser la primera en llegar (FIFO).
						</div>
					</div>

					<div class="pc-card pc-theory-box">
						<h3 class="pc-card-title">El Principio de Equidad (Fairness)</h3>
						<div class="pc-code-block">
							<pre><code>// Contrato del TAD Cola
public interface Cola&lt;T&gt; &#123;
    boolean offer(T elemento); // encolar al final O(1)
    T poll();                  // extraer del frente O(1)
    T peek();                  // consultar frente O(1)
    boolean isEmpty();         // O(1)
    int size();                // O(1)
&#125;

// Disciplina en acción:
Cola&lt;String&gt; c = new ColaEnlazada&lt;&gt;();
c.offer("Ana");
c.offer("Beto");
c.offer("Caro");
String atendido = c.poll(); // Retorna "Ana"</code></pre>
						</div>
						<div class="pc-callout">
							<strong>Complejidad constante:</strong> Tanto encolar como desencolar deben resolverse en $O(1)$. En una lista enlazada mantenemos punteros `frente` y `fin`. En un array se requiere una <em>cola circular</em>.
						</div>
					</div>
				</div>
			</article>

			<!-- SLIDE 3: COLA CIRCULAR SOBRE ARRAY -->
			<article class="pc-slide" data-slide="3">
				<div class="pc-slide-header">
					<span class="pc-slide-tag tag tag-accent">Slide 3 / 6 • Circular Buffer</span>
					<h2 class="pc-slide-title">{t.s3Title}</h2>
					<p class="pc-slide-desc">{t.s3Desc}</p>
				</div>

				<div class="pc-dual-grid">
					<div class="pc-card pc-simulator-box">
						<div class="pc-card-header">
							<span class="pc-card-label">Anillo de 8 Celdas (Índices 0 a 7)</span>
							<span class="pc-badge" id="pc-circ-badge">fin = 2 | frente = 0</span>
						</div>

						<div class="pc-circular-zone">
							<!-- Circular Ring SVG Diagram -->
							<div class="pc-circ-canvas-wrap">
								<svg viewBox="0 0 320 320" class="pc-circ-svg" id="pc-circ-svg" aria-label="Diagrama de Cola Circular">
									<!-- Outer ring track -->
									<circle cx="160" cy="160" r="110" fill="none" stroke="var(--color-divider)" stroke-width="44" />
									
									<!-- 8 circular segments/cells -->
									<!-- Center circle for math display -->
									<circle cx="160" cy="160" r="75" fill="var(--color-surface)" stroke="var(--color-divider)" stroke-width="2" />
									
									<!-- Center text for formula -->
									<text x="160" y="145" text-anchor="middle" font-family="var(--font-heading)" font-size="12" fill="var(--color-text-muted)">Aritmética Modular</text>
									<text x="160" y="165" text-anchor="middle" font-family="var(--font-mono)" font-weight="700" font-size="13" fill="var(--color-accent-700)" id="pc-circ-calc-text">(fin + 1) % 8</text>
									<text x="160" y="185" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--color-text)" id="pc-circ-calc-res">Índice: 2 → 3</text>

									<!-- Slots positioned around the circle (radius 110) -->
									<!-- Angle 0 = Top (0, -110): idx 0 -->
									<g id="pc-slot-0" class="pc-circ-slot has-item">
										<circle cx="160" cy="50" r="18" fill="var(--color-accent)" fill-opacity="0.25" stroke="var(--color-accent)" stroke-width="2" />
										<text x="160" y="55" text-anchor="middle" font-family="var(--font-mono)" font-size="11" font-weight="700" fill="var(--color-text)">A</text>
										<text x="160" y="24" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">[0]</text>
									</g>
									<g id="pc-slot-1" class="pc-circ-slot has-item">
										<circle cx="237" cy="82" r="18" fill="var(--color-accent)" fill-opacity="0.25" stroke="var(--color-accent)" stroke-width="2" />
										<text x="237" y="87" text-anchor="middle" font-family="var(--font-mono)" font-size="11" font-weight="700" fill="var(--color-text)">B</text>
										<text x="258" y="70" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">[1]</text>
									</g>
									<g id="pc-slot-2" class="pc-circ-slot has-item">
										<circle cx="270" cy="160" r="18" fill="var(--color-accent)" fill-opacity="0.25" stroke="var(--color-accent)" stroke-width="2" />
										<text x="270" y="165" text-anchor="middle" font-family="var(--font-mono)" font-size="11" font-weight="700" fill="var(--color-text)">C</text>
										<text x="300" y="164" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">[2]</text>
									</g>
									<g id="pc-slot-3" class="pc-circ-slot">
										<circle cx="237" cy="237" r="18" fill="var(--color-bg)" stroke="var(--color-divider)" stroke-width="2" />
										<text x="237" y="242" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--color-text-muted)">—</text>
										<text x="258" y="258" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">[3]</text>
									</g>
									<g id="pc-slot-4" class="pc-circ-slot">
										<circle cx="160" cy="270" r="18" fill="var(--color-bg)" stroke="var(--color-divider)" stroke-width="2" />
										<text x="160" y="275" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--color-text-muted)">—</text>
										<text x="160" y="302" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">[4]</text>
									</g>
									<g id="pc-slot-5" class="pc-circ-slot">
										<circle cx="82" cy="237" r="18" fill="var(--color-bg)" stroke="var(--color-divider)" stroke-width="2" />
										<text x="82" y="242" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--color-text-muted)">—</text>
										<text x="60" y="258" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">[5]</text>
									</g>
									<g id="pc-slot-6" class="pc-circ-slot">
										<circle cx="50" cy="160" r="18" fill="var(--color-bg)" stroke="var(--color-divider)" stroke-width="2" />
										<text x="50" y="165" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--color-text-muted)">—</text>
										<text x="20" y="164" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">[6]</text>
									</g>
									<g id="pc-slot-7" class="pc-circ-slot">
										<circle cx="82" cy="82" r="18" fill="var(--color-bg)" stroke="var(--color-divider)" stroke-width="2" />
										<text x="82" y="87" text-anchor="middle" font-family="var(--font-mono)" font-size="11" fill="var(--color-text-muted)">—</text>
										<text x="60" y="70" text-anchor="middle" font-family="var(--font-mono)" font-size="9" fill="var(--color-text-muted)">[7]</text>
									</g>
								</svg>
							</div>
						</div>

						<div class="pc-action-bar">
							<button type="button" class="pc-btn pc-btn-primary" id="pc-circ-enqueue">+ {t.s3StepEnqueue}</button>
							<button type="button" class="pc-btn pc-btn-secondary" id="pc-circ-dequeue">- {t.s3StepDequeue}</button>
							<button type="button" class="pc-btn pc-btn-ghost" id="pc-circ-reset">↺ {t.reset}</button>
						</div>
						<div class="pc-status-banner" id="pc-circ-status">
							El índice de fin avanza en sentido horario. Al llegar a 7, la operación (7 + 1) % 8 regresa suavemente a 0.
						</div>
					</div>

					<div class="pc-card pc-theory-box">
						<h3 class="pc-card-title">¿Por qué el operador módulo (%)?</h3>
						<p>En un arreglo lineal sin ciclo:</p>
						<div class="pc-linear-demo">
							<div class="pc-linear-cell wasted">[0] Desperdiciado</div>
							<div class="pc-linear-cell wasted">[1] Desperdiciado</div>
							<div class="pc-linear-cell active">[2] Frente</div>
							<div class="pc-linear-cell active">[3] Fin</div>
						</div>
						<p class="pc-small-text">Si no reciclamos las celdas [0] y [1], tendríamos que mover todos los elementos $O(N)$ o agotar el arreglo prematuramente.</p>
						<div class="pc-code-block">
							<pre><code>// Inserción en Cola Circular:
fin = (fin + 1) % capacidad;
elementos[fin] = item;
size++;

// Extracción:
T item = elementos[frente];
frente = (frente + 1) % capacidad;
size--;</code></pre>
						</div>
					</div>
				</div>
			</article>

			<!-- SLIDE 4: CASOS DE USO EN EL MUNDO REAL -->
			<article class="pc-slide" data-slide="4">
				<div class="pc-slide-header">
					<span class="pc-slide-tag tag tag-accent">Slide 4 / 6 • Systems Architecture</span>
					<h2 class="pc-slide-title">{t.s4Title}</h2>
					<p class="pc-slide-desc">{t.s4Desc}</p>
				</div>

				<div class="pc-systems-grid">
					<!-- Panel 1: Stack Applications -->
					<div class="pc-card pc-system-card">
						<div class="pc-system-header">
							<span class="pc-icon-badge">🥞</span>
							<h3 class="pc-card-title">La Pila en Sistemas Reales</h3>
						</div>
						<ul class="pc-system-list">
							<li>
								<strong>Call Stack de la JVM:</strong> Cada llamada a método crea un registro de activación (Stack Frame) con sus variables locales y dirección de retorno. Al retornar, el frame se desapila.
							</li>
							<li>
								<strong>Deshacer / Rehacer (Undo / Redo):</strong> Dos pilas acopladas. Cada acción realizada se empuja en la pila `undoStack`. Al presionar Ctrl+Z, se desapila y se pasa a `redoStack`.
							</li>
							<li>
								<strong>Evaluación de Expresiones Postfijas:</strong> Conversión de notación infija `(a+b)*c` a postfija `ab+c*` y resolución con una pila de operandos.
							</li>
							<li>
								<strong>Algoritmo DFS (Búsqueda en Profundidad):</strong> Recorrido de grafos o árboles explorando ramas hasta el fondo antes de retroceder (backtracking).
							</li>
						</ul>
					</div>

					<!-- Panel 2: Queue Applications -->
					<div class="pc-card pc-system-card">
						<div class="pc-system-header">
							<span class="pc-icon-badge">🎟</span>
							<h3 class="pc-card-title">La Cola en Sistemas Reales</h3>
						</div>
						<ul class="pc-system-list">
							<li>
								<strong>Brokers de Mensajería (Kafka, RabbitMQ, SQS):</strong> Productores publican eventos en la cola sin bloquearse; consumidores procesan los mensajes en estricto orden de arribo.
							</li>
							<li>
								<strong>Spooler de Impresión del Sistema Operativo:</strong> Si 10 usuarios envían documentos al mismo tiempo a una impresora, los trabajos se encolan y despachan secuencialmente.
							</li>
							<li>
								<strong>Buffer de Paquetes en Routers:</strong> Almacena paquetes TCP/UDP cuando el ancho de banda del enlace está saturado momentáneamente.
							</li>
							<li>
								<strong>Algoritmo BFS (Búsqueda en Amplitud):</strong> Exploración de grafos nivel por nivel usando una cola para visitar nodos vecinos contiguos.
							</li>
						</ul>
