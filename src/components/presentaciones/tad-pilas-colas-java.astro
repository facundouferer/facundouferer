							<select id="pc-expr-select" class="pc-select">
								<option value="{ [ ( a + b ) * c ] }">Caso Válido 1: &#123; [ ( a + b ) * c ] &#125;</option>
								<option value="[ ( ) { } [ ( ) ] ]">Caso Válido 2: [ ( ) &#123; &#125; [ ( ) ] ]</option>
								<option value="{ [ ( ] ) }">Caso Inválido 1 (Cierre Cruzado): &#123; [ ( ] ) &#125;</option>
								<option value="{ [ ( ) ]">Caso Inválido 2 (Apertura Sobrante): &#123; [ ( ) ]</option>
