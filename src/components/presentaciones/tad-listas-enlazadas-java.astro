											<rect x="0" y="0" width="90" height="46" rx="6" class="deck-panel-accent" stroke="var(--color-accent-700)" stroke-width="2" />
											<text x="30" y="28" class="deck-svg-bold" fill="var(--color-accent-700)">"C"</text>
											<rect x="58" y="8" width="24" height="30" rx="3" fill="var(--color-surface)" />
