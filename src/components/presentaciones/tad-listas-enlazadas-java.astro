									<!-- Row 1: Acceso -->
									<text x="20" y="60" class="deck-svg-mono-sm">Acceso get(i)</text>
									<rect x="190" y="46" width="60" height="20" rx="3" fill="color-mix(in srgb, var(--color-accent-2-700) 15%, var(--color-surface))" />
									<text x="220" y="60" class="deck-svg-bold" fill="var(--color-accent-2-700)" text-anchor="middle">O(1)</text>
