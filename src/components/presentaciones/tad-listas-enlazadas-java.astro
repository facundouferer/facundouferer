									<text x="390" y="130" class="deck-svg-bold" fill="var(--color-accent-2-700)" text-anchor="middle">O(1)**</text>

									<!-- Row 4: Búsqueda -->
									<text x="20" y="165" class="deck-svg-mono-sm">Búsqueda contains()</text>
									<rect x="190" y="151" width="60" height="20" rx="3" fill="color-mix(in srgb, rgb(239, 68, 68) 15%, var(--color-surface))" />
									<text x="220" y="165" class="deck-svg-bold" fill="rgb(239, 68, 68)" text-anchor="middle">O(N)</text>
									<rect x="360" y="151" width="60" height="20" rx="3" fill="color-mix(in srgb, rgb(239, 68, 68) 15%, var(--color-surface))" />
									<text x="390" y="165" class="deck-svg-bold" fill="rgb(239, 68, 68)" text-anchor="middle">O(N)</text>

									<!-- Footnote -->
									<text x="20" y="210" class="deck-svg-sub">* Amortizado en ArrayList al duplicar. ** Con puntero tail.</text>
								</svg>
							</div>
						</div>

						<div class="deck-col">
							<div class="deck-interactive-card">
