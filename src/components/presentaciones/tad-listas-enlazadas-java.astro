									<div class="state-row">
										<span class="state-label">{isEs ? 'Condición del bucle:' : 'Loop condition:'}</span>
										<span class="state-val mono">while (actual.siguiente != null)</span>
									</div>
									<div class="state-row">
										<span class="state-label">{isEs ? 'Posición Cursor:' : 'Cursor Position:'}</span>
										<span class="state-val" id="tail-pos-txt">actual = Nodo "A"</span>
									</div>
								</div>
								<pre class="deck-code-snippet"><code><span class="tok-kw">Nodo</span> actual = cabeza;
<span class="tok-kw">while</span> (actual.siguiente != <span class="tok-kw">null</span>) &#123;
  actual = actual.siguiente; <span class="tok-comment">// Avanza O(N)</span>
&#125;
actual.siguiente = nuevo;</code></pre>
							</div>
						</div>
					</div>
