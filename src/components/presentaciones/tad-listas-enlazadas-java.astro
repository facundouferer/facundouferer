											<rect x="58" y="8" width="24" height="30" rx="3" fill="var(--color-surface)" />
											<circle cx="70" cy="23" r="3" fill="var(--color-accent)" />
										</g>

										<path d="M90 23 L130 23" stroke="var(--color-accent)" stroke-width="1.5" />

										<!-- Node 1 -->
										<g id="tail-n1" transform="translate(130, 0)">
											<rect x="0" y="0" width="90" height="46" rx="6" class="deck-panel" />
											<text x="30" y="28" class="deck-svg-bold">"B"</text>
											<rect x="58" y="8" width="24" height="30" rx="3" fill="var(--color-surface)" />
											<circle cx="70" cy="23" r="3" fill="var(--color-accent)" />
										</g>

										<path d="M220 23 L260 23" stroke="var(--color-accent)" stroke-width="1.5" />

										<!-- Node 2 (last) -->
