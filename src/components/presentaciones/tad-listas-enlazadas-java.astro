									<text x="390" y="60" class="deck-svg-bold" fill="rgb(239, 68, 68)" text-anchor="middle">O(N)</text>

									<!-- Row 2: Inserción frente -->
									<text x="20" y="95" class="deck-svg-mono-sm">Insertar al inicio</text>
									<rect x="190" y="81" width="60" height="20" rx="3" fill="color-mix(in srgb, rgb(239, 68, 68) 15%, var(--color-surface))" />
									<text x="220" y="95" class="deck-svg-bold" fill="rgb(239, 68, 68)" text-anchor="middle">O(N)</text>
									<rect x="360" y="81" width="60" height="20" rx="3" fill="color-mix(in srgb, var(--color-accent-2-700) 15%, var(--color-surface))" />
									<text x="390" y="95" class="deck-svg-bold" fill="var(--color-accent-2-700)" text-anchor="middle">O(1)</text>

									<!-- Row 3: Inserción final -->
									<text x="20" y="130" class="deck-svg-mono-sm">Insertar al final</text>
									<rect x="190" y="116" width="60" height="20" rx="3" fill="color-mix(in srgb, var(--color-accent-2-700) 15%, var(--color-surface))" />
									<text x="220" y="130" class="deck-svg-bold" fill="var(--color-accent-2-700)" text-anchor="middle">O(1)*</text>
