---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="tl-screen" data-lang={lang}>
	<div class="tl-shell">
		<div class="deck-card">
			<div class="deck-nav-bar">
				<div class="deck-slide-indicator">
					<span class="deck-step-dot"></span>
					<span id="deck-slide-label">SLIDE 1 / 8</span>
				</div>
				<div class="deck-pills">
					<button class="deck-pill-btn active" data-target-slide="1">1. {isEs ? '¿Qué es un TAD?' : 'What is an ADT?'}</button>
					<button class="deck-pill-btn" data-target-slide="2">2. {isEs ? 'Contigua vs Dispersa' : 'Contiguous vs Dispersed'}</button>
					<button class="deck-pill-btn" data-target-slide="3">3. {isEs ? 'Anatomía del Nodo' : 'Node Anatomy'}</button>
					<button class="deck-pill-btn" data-target-slide="4">4. {isEs ? 'Inserción al Inicio O(1)' : 'Insert at Head O(1)'}</button>
					<button class="deck-pill-btn" data-target-slide="5">5. {isEs ? 'Inserción al Final' : 'Insert at Tail'}</button>
					<button class="deck-pill-btn" data-target-slide="6">6. {isEs ? 'Eliminar Intermedio' : 'Delete Middle'}</button>
					<button class="deck-pill-btn" data-target-slide="7">7. {isEs ? 'Doble y Circular' : 'Doubly & Circular'}</button>
					<button class="deck-pill-btn" data-target-slide="8">8. {isEs ? 'Complejidad Big-O' : 'Big-O Matrix'}</button>
				</div>
			</div>

			<div class="tl-viewport">
				<!-- SLIDE 1: WHAT IS AN ADT -->
				<div class="deck-slide active" data-slide="1">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">1. {isEs ? '¿Qué es un TAD? La Interfaz Frente a la Memoria' : 'What is an ADT? The Contract vs Physical Memory'}</h2>
							<p class="deck-text">
								{isEs
									? 'Un Tipo Abstracto de Dato (TAD) define QUÉ operaciones se pueden hacer (contrato lógico), mientras que la estructura de datos define CÓMO se organizan los bytes en la RAM (implementación física).'
									: 'An Abstract Data Type (ADT) specifies WHAT operations are allowed (logical contract), while a data structure determines HOW bytes are physically laid out in RAM (concrete storage).'}
							</p>

							<div class="deck-figure">
								<svg viewBox="0 0 540 250" width="100%" role="img" aria-label={isEs ? 'TAD interfaz y dos implementaciones físicas' : 'ADT interface and two physical implementations'}>
									<!-- Central Abstract Contract -->
									<g transform="translate(160, 20)">
										<rect x="0" y="0" width="220" height="70" rx="10" class="deck-panel-accent" stroke-width="2" />
										<text x="110" y="24" class="deck-svg-title-accent" text-anchor="middle">TAD Lista&lt;T&gt; (Contrato)</text>
										<text x="110" y="44" class="deck-svg-mono-sm" text-anchor="middle">agregar(T) | eliminar(idx)</text>
										<text x="110" y="58" class="deck-svg-mono-sm" text-anchor="middle">obtener(idx) | tamano()</text>
									</g>

									<!-- Fork Arrows -->
									<path d="M220 90 L130 130" stroke="var(--color-accent)" stroke-width="2" />
									<path d="M320 90 L410 130" stroke="var(--color-accent-2-700)" stroke-width="2" />

									<!-- Implementation 1: ArrayList -->
									<g transform="translate(25, 130)">
										<rect x="0" y="0" width="210" height="95" rx="8" class="deck-panel" />
										<text x="105" y="24" class="deck-svg-bold" fill="var(--color-accent-700)" text-anchor="middle">Lista Secuencial (Array)</text>
										<line x1="15" y1="34" x2="195" y2="34" stroke="var(--color-divider)" />
										<text x="20" y="54" class="deck-svg-mono-sm">Memoria: Bloque contiguo</text>
										<text x="20" y="70" class="deck-svg-mono-sm">Acceso por índice: O(1)</text>
										<text x="20" y="86" class="deck-svg-sub">Inserción al frente: O(N)</text>
									</g>

									<!-- Implementation 2: LinkedList -->
									<g transform="translate(305, 130)">
										<rect x="0" y="0" width="210" height="95" rx="8" class="deck-panel" />
										<text x="105" y="24" class="deck-svg-bold" fill="var(--color-accent-2-700)" text-anchor="middle">Lista Enlazada (Nodos)</text>
										<line x1="15" y1="34" x2="195" y2="34" stroke="var(--color-divider)" />
										<text x="20" y="54" class="deck-svg-mono-sm">Memoria: Nodos dispersos</text>
										<text x="20" y="70" class="deck-svg-mono-sm">Acceso por índice: O(N)</text>
										<text x="20" y="86" class="deck-svg-sub">Inserción al frente: O(1)</text>
									</g>
								</svg>
							</div>
						</div>

						<div class="deck-col">
							<div class="deck-interactive-card">
								<div class="deck-card-head">
									<span class="deck-badge">{isEs ? 'Concepto Arquitectónico' : 'Architectural Concept'}</span>
								</div>
								<div class="deck-info-box">
									<div class="state-row">
										<span class="state-label">{isEs ? 'Contrato Lógico:' : 'Logical Contract:'}</span>
										<span class="state-val">interface List&lt;T&gt;</span>
									</div>
									<div class="state-row">
										<span class="state-label">{isEs ? 'Regla de Oro:' : 'Golden Rule:'}</span>
										<span class="state-val" style="color: var(--color-accent-700);">Programar contra la interfaz</span>
									</div>
								</div>
								<pre class="deck-code-snippet"><code><span class="tok-comment">// El cliente declara la interfaz TAD</span>
<span class="tok-kw">List</span>&lt;String&gt; lista = <span class="tok-kw">new</span> <span class="tok-kw">ArrayList</span>&lt;&gt;();
<span class="tok-comment">// O cambia la implementación física sin romper nada:</span>
<span class="tok-kw">List</span>&lt;String&gt; lista = <span class="tok-kw">new</span> <span class="tok-kw">LinkedList</span>&lt;&gt;();</code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 2: CONTIGUOUS VS DISPERSED -->
				<div class="deck-slide" data-slide="2">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">2. {isEs ? 'Memoria Contigua vs Nodos Dispersos en el Heap' : 'Contiguous Memory vs Dispersed Nodes'}</h2>
							<p class="deck-text">
								{isEs
									? 'En un array, las casillas son adyacentes: saltar al índice 3 se calcula matemáticamente en O(1). En una lista enlazada, los nodos están desparramados en direcciones aleatorias del Heap: para llegar al índice 3 hay que caminar 3 punteros en O(N).'
									: 'In an array, cells are adjacent: jumping to index 3 is an instant O(1) pointer arithmetic. In a linked list, nodes are scattered across random Heap addresses: reaching index 3 requires traversing 3 pointers in O(N).'}
							</p>

							<div class="deck-figure">
								<svg viewBox="0 0 540 250" width="100%" role="img" aria-label={isEs ? 'Array contiguo frente a lista dispersa' : 'Contiguous array vs dispersed linked list'}>
									<!-- Array Track -->
									<g transform="translate(20, 25)">
										<text x="0" y="16" class="deck-svg-title">1. Array: Memoria Contigua (Dirección base 0x1000 + i * 4)</text>
										<g transform="translate(0, 25)">
											<rect x="0" y="0" width="95" height="42" rx="4" class="deck-ground-card" stroke="var(--color-divider)" />
											<text x="12" y="18" class="deck-svg-bold">[0]</text>
											<text x="47" y="32" class="deck-svg-mono-sm" text-anchor="middle">"Ana"</text>

											<rect x="100" y="0" width="95" height="42" rx="4" class="deck-ground-card" stroke="var(--color-divider)" />
											<text x="112" y="18" class="deck-svg-bold">[1]</text>
											<text x="147" y="32" class="deck-svg-mono-sm" text-anchor="middle">"Leo"</text>

											<rect x="200" y="0" width="95" height="42" rx="4" class="deck-ground-card" stroke="var(--color-divider)" />
											<text x="212" y="18" class="deck-svg-bold">[2]</text>
											<text x="247" y="32" class="deck-svg-mono-sm" text-anchor="middle">"Dibu"</text>

											<rect x="300" y="0" width="95" height="42" rx="4" class="deck-ground-card" stroke="var(--color-accent-700)" stroke-width="2" id="arr-target-cell" />
											<text x="312" y="18" class="deck-svg-bold" fill="var(--color-accent-700)">[3]</text>
											<text x="347" y="32" class="deck-svg-mono-sm" text-anchor="middle">"Lau"</text>
										</g>
									</g>

									<!-- Linked List Track -->
									<g transform="translate(20, 130)">
										<text x="0" y="16" class="deck-svg-title">2. Lista Enlazada: Direcciones Aleatorias en el Heap</text>
										<g transform="translate(0, 25)">
											<!-- Node 0 -->
											<rect x="0" y="0" width="85" height="46" rx="6" class="deck-panel" id="lnk-node-0" />
											<text x="10" y="18" class="deck-svg-mono-sm">@0x3A20</text>
											<text x="10" y="34" class="deck-svg-bold">"Ana" →</text>

											<!-- Arrow 0 -> 1 -->
											<path d="M85 23 L120 40" stroke="var(--color-accent)" stroke-width="1.5" />

											<!-- Node 1 -->
											<rect x="120" y="15" width="85" height="46" rx="6" class="deck-panel" id="lnk-node-1" />
											<text x="130" y="33" class="deck-svg-mono-sm">@0x8F14</text>
											<text x="130" y="49" class="deck-svg-bold">"Leo" →</text>

											<!-- Arrow 1 -> 2 -->
											<path d="M205 38 L240 5" stroke="var(--color-accent)" stroke-width="1.5" />

											<!-- Node 2 -->
											<rect x="240" y="0" width="85" height="46" rx="6" class="deck-panel" id="lnk-node-2" />
											<text x="250" y="18" class="deck-svg-mono-sm">@0x10B8</text>
											<text x="250" y="34" class="deck-svg-bold">"Dibu" →</text>

											<!-- Arrow 2 -> 3 -->
											<path d="M325 23 L360 23" stroke="var(--color-accent-700)" stroke-width="2" />

											<!-- Node 3 -->
											<rect x="360" y="0" width="85" height="46" rx="6" class="deck-panel-accent" stroke="var(--color-accent-700)" stroke-width="2" id="lnk-node-3" />
											<text x="370" y="18" class="deck-svg-mono-sm">@0x9C44</text>
											<text x="370" y="34" class="deck-svg-bold">"Lau"</text>
										</g>
									</g>
								</svg>
							</div>
						</div>

						<div class="deck-col">
							<div class="deck-interactive-card">
								<div class="deck-card-head">
									<span class="deck-badge">{isEs ? 'Simulador de Acceso' : 'Access Simulator'}</span>
								</div>
								<div class="deck-actions-row">
									<button class="btn btn-secondary" id="btn-inspect-access">{isEs ? 'Buscar índice 3 (Lau)' : 'Find index 3 (Lau)'}</button>
								</div>
								<div class="deck-info-box">
									<div class="state-row">
										<span class="state-label">{isEs ? 'Array (Acceso Directo):' : 'Array (Direct Access):'}</span>
										<span class="state-val" style="color: var(--color-accent-2-700); font-weight: 700;">1 salto en O(1)</span>
									</div>
									<div class="state-row">
										<span class="state-label">{isEs ? 'Lista (Caminata de Punteros):' : 'List (Pointer Walk):'}</span>
										<span class="state-val" style="color: rgb(239, 68, 68); font-weight: 700;">3 saltos en O(N)</span>
									</div>
								</div>
								<pre class="deck-code-snippet"><code><span class="tok-comment">// Array: Aritmética de memoria directa</span>
array[<span class="tok-num">3</span>]; <span class="tok-comment">// base + 3 * sizeof(elem) -&gt; O(1)</span>

<span class="tok-comment">// Lista Enlazada: Desreferenciar punteros</span>
cabeza.siguiente.siguiente.siguiente; <span class="tok-comment">// O(N)</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 3: NODE ANATOMY -->
				<div class="deck-slide" data-slide="3">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">3. {isEs ? 'Anatomía de un Nodo en Memoria' : 'Node Anatomy in Memory'}</h2>
							<p class="deck-text">
								{isEs
									? 'Un nodo es una clase autorreferencial en el Heap con dos compartimentos: la carga útil (dato) y el puntero al próximo nodo (siguiente). El último nodo de la cadena tiene su puntero en null (tierra).'
									: 'A node is a self-referential class in the Heap with two fields: the payload data and the reference to the next node. The chain tail points to null (ground termination).'}
							</p>

							<div class="deck-figure">
								<svg viewBox="0 0 540 240" width="100%" role="img" aria-label={isEs ? 'Anatomía interna de un nodo' : 'Internal node anatomy'}>
									<!-- Node Box Detail -->
									<g transform="translate(60, 45)">
										<rect x="0" y="0" width="280" height="135" rx="10" class="deck-panel-accent" stroke-width="2" />
										<text x="140" y="24" class="deck-svg-title-accent" text-anchor="middle">Nodo&lt;String&gt; @0x4B20</text>
										<line x1="20" y1="36" x2="260" y2="36" stroke="var(--color-divider)" />

										<!-- Compartment 1: dato -->
										<g transform="translate(20, 48)">
											<rect x="0" y="0" width="120" height="65" rx="6" class="deck-ground-card" stroke="var(--color-accent)" stroke-width="1.5" />
											<text x="60" y="22" class="deck-svg-bold" text-anchor="middle">T dato</text>
											<text x="60" y="44" class="deck-svg-mono" text-anchor="middle">"Ana"</text>
										</g>

										<!-- Compartment 2: siguiente -->
										<g transform="translate(150, 48)">
											<rect x="0" y="0" width="105" height="65" rx="6" class="deck-ground-card" stroke="var(--color-accent-2-700)" stroke-width="1.5" />
											<text x="52" y="22" class="deck-svg-bold" fill="var(--color-accent-2-700)" text-anchor="middle">siguiente</text>
											<circle cx="52" cy="45" r="7" fill="var(--color-accent-2-700)" />
										</g>
									</g>

									<!-- Outgoing pointer -->
									<path d="M340 120 L400 120" stroke="var(--color-accent-2-700)" stroke-width="2.5" />

									<!-- Next Node or Ground -->
									<g transform="translate(410, 80)">
										<rect x="0" y="0" width="90" height="70" rx="6" class="deck-panel" stroke-dasharray="3 3" />
										<text x="45" y="32" class="deck-svg-mono-sm" text-anchor="middle">Próximo</text>
										<text x="45" y="50" class="deck-svg-mono-sm" text-anchor="middle">Nodo @0x5C00</text>
									</g>
								</svg>
							</div>
						</div>

						<div class="deck-col">
							<div class="deck-interactive-card">
								<div class="deck-card-head">
									<span class="deck-badge">{isEs ? 'Estructura Autorreferencial' : 'Self-Referential Struct'}</span>
								</div>
								<div class="deck-info-box">
									<div class="state-row">
										<span class="state-label">{isEs ? 'Tipo del Puntero:' : 'Pointer Type:'}</span>
										<span class="state-val mono">Nodo&lt;T&gt; siguiente</span>
									</div>
									<div class="state-row">
										<span class="state-label">{isEs ? 'Terminación:' : 'Termination:'}</span>
										<span class="state-val" style="color: var(--color-accent-700);">siguiente == null</span>
									</div>
								</div>
								<pre class="deck-code-snippet"><code><span class="tok-kw">class</span> Nodo&lt;T&gt; &#123;
  T dato;
  Nodo&lt;T&gt; siguiente; <span class="tok-comment">// Puntero al mismo tipo</span>

  <span class="tok-kw">public</span> Nodo(T dato) &#123;
    <span class="tok-kw">this</span>.dato = dato;
    <span class="tok-kw">this</span>.siguiente = <span class="tok-kw">null</span>;
  &#125;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 4: INSERTION AT HEAD O(1) -->
				<div class="deck-slide" data-slide="4">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">4. {isEs ? 'Inserción al Inicio: El Baile de Punteros en O(1)' : 'Insert at Head: O(1) Pointer Dance'}</h2>
							<p class="deck-text">
								{isEs
									? 'Insertar al frente es inmediato: 1. Crear nuevo nodo, 2. Enlazar nuevo.siguiente = cabeza, 3. Mover cabeza = nuevo. ¡Si invertís el orden de los pasos 2 y 3, perdés toda la lista existente!'
									: 'Inserting at head is instant: 1. Create new node, 2. Link nuevo.siguiente = cabeza, 3. Advance cabeza = nuevo. Reversing steps 2 and 3 loses the entire existing list to garbage collection!'}
							</p>

							<div class="deck-figure">
								<svg viewBox="0 0 540 240" width="100%" role="img" aria-label={isEs ? 'Baile de punteros inserción al frente' : 'Insert at head pointer dance'}>
									<!-- cabeza pointer -->
									<g transform="translate(30, 45)">
										<rect x="0" y="0" width="70" height="45" rx="6" class="deck-panel" stroke="var(--color-accent)" stroke-width="1.5" />
										<text x="35" y="22" class="deck-svg-bold" text-anchor="middle">cabeza</text>
										<text x="35" y="36" class="deck-svg-mono-sm" text-anchor="middle" id="head-addr-txt">@0x1000</text>
									</g>

									<!-- Arrow cabeza -> target -->
									<path d="M100 68 L150 68" stroke="var(--color-accent)" stroke-width="2" id="arr-head-link" />

									<!-- Existing Node A -->
									<g transform="translate(160, 45)">
										<rect x="0" y="0" width="100" height="50" rx="6" class="deck-ground-card" stroke="var(--color-divider)" />
										<text x="35" y="30" class="deck-svg-bold">"A"</text>
										<rect x="65" y="8" width="25" height="34" rx="3" fill="var(--color-surface-subtle)" />
										<circle cx="77" cy="25" r="3.5" fill="var(--color-accent)" />
									</g>

									<!-- Arrow Node A -> Node B -->
									<path d="M260 70 L300 70" stroke="var(--color-accent)" stroke-width="1.5" />

									<!-- Existing Node B -->
									<g transform="translate(310, 45)">
										<rect x="0" y="0" width="100" height="50" rx="6" class="deck-ground-card" stroke="var(--color-divider)" />
										<text x="35" y="30" class="deck-svg-bold">"B"</text>
										<rect x="65" y="8" width="25" height="34" rx="3" fill="var(--color-surface-subtle)" />
										<text x="77" y="28" class="deck-svg-mono-sm" text-anchor="middle">null</text>
									</g>

									<!-- New floating node X -->
									<g id="svg-new-node" transform="translate(160, 140)">
										<rect x="0" y="0" width="110" height="55" rx="8" class="deck-panel-accent" stroke="var(--color-accent-700)" stroke-width="2" />
										<text x="35" y="32" class="deck-svg-bold" fill="var(--color-accent-700)">nuevo "X"</text>
										<rect x="75" y="10" width="25" height="35" rx="3" fill="var(--color-surface)" />
										<circle cx="87" cy="27" r="4" fill="var(--color-accent-2-700)" />
									</g>

									<!-- Dynamic Connector from New Node -->
									<path id="arr-new-to-a" d="M210 140 L210 100" stroke="var(--color-accent-2-700)" stroke-width="2" stroke-dasharray="3 3" style="display: none;" />
								</svg>
							</div>
						</div>

						<div class="deck-col">
							<div class="deck-interactive-card">
								<div class="deck-card-head">
									<span class="deck-badge">{isEs ? 'Secuencia de Pasos' : 'Step Sequence'}</span>
								</div>
								<div class="deck-actions-row">
									<button class="btn btn-secondary" id="btn-step-head">{isEs ? 'Avanzar Paso' : 'Next Step'}</button>
									<button class="btn btn-secondary" id="btn-reset-head">{isEs ? 'Reiniciar' : 'Reset'}</button>
								</div>
								<div class="deck-info-box">
									<div class="state-row">
										<span class="state-label">{isEs ? 'Paso Actual:' : 'Current Step:'}</span>
										<span class="state-val" id="head-step-title">{isEs ? '1. Nace nuevo = new Nodo("X")' : '1. Instantiate new Node("X")'}</span>
									</div>
									<div class="state-row">
										<span class="state-label">{isEs ? 'Sentencia Java:' : 'Java Statement:'}</span>
										<span class="state-val mono" id="head-step-code">Nodo nuevo = new Nodo("X");</span>
									</div>
								</div>
								<pre class="deck-code-snippet"><code><span class="tok-kw">public void</span> agregarAlInicio(T dato) &#123;
  <span class="tok-kw">Nodo</span>&lt;T&gt; nuevo = <span class="tok-kw">new</span> <span class="tok-kw">Nodo</span>&lt;&gt;(dato);
  nuevo.siguiente = cabeza; <span class="tok-comment">// PASO 1: Enlazar primero</span>
  cabeza = nuevo;           <span class="tok-comment">// PASO 2: Mover cabeza</span>
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 5: INSERTION AT TAIL -->
				<div class="deck-slide" data-slide="5">
					<div class="deck-slide-grid">
						<div class="deck-col">
							<h2 class="deck-slide-title">5. {isEs ? 'Inserción al Final y Recorrido en O(N)' : 'Insert at Tail and Traversal O(N)'}</h2>
							<p class="deck-text">
								{isEs
									? 'Para agregar al final sin puntero tail, es obligatorio recorrer toda la lista usando un cursor auxiliar mientras actual.siguiente != null. El costo es O(N) proporcional a la cantidad de elementos.'
									: 'Adding at tail without a tail pointer mandates traversing the full chain with a cursor while actual.siguiente != null. Time complexity is O(N) proportional to element count.'}
							</p>

							<div class="deck-figure">
