</div>

<script>
	function initPresentation() {
		const screen = document.querySelector('.tl-screen');
		if (!screen) return;

		let currentSlide = 1;
		const totalSlides = 8;

		const slideLabel = document.getElementById('deck-slide-label');
		const prevBtn = screen.querySelector('.deck-nav-prev') as HTMLButtonElement;
		const nextBtn = screen.querySelector('.deck-nav-next') as HTMLButtonElement;
		const pills = screen.querySelectorAll('.deck-pill-btn');
		const dots = screen.querySelectorAll('.deck-dot');
		const slides = screen.querySelectorAll('.deck-slide');

		function goToSlide(target: number) {
			if (target < 1 || target > totalSlides) return;
			currentSlide = target;

			if (slideLabel) {
				slideLabel.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
			}

			slides.forEach((sl) => {
				const sNum = parseInt(sl.getAttribute('data-slide') || '0', 10);
				sl.classList.toggle('active', sNum === currentSlide);
			});

			pills.forEach((p) => {
				const tNum = parseInt(p.getAttribute('data-target-slide') || '0', 10);
				p.classList.toggle('active', tNum === currentSlide);
			});

			dots.forEach((d) => {
				const tNum = parseInt(d.getAttribute('data-target-slide') || '0', 10);
				d.classList.toggle('active', tNum === currentSlide);
			});

			if (prevBtn) prevBtn.disabled = currentSlide === 1;
			if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
		}

		prevBtn?.addEventListener('click', () => goToSlide(currentSlide - 1));
		nextBtn?.addEventListener('click', () => goToSlide(currentSlide + 1));

		pills.forEach((p) => {
			p.addEventListener('click', () => {
				const t = parseInt(p.getAttribute('data-target-slide') || '1', 10);
				goToSlide(t);
			});
		});

		dots.forEach((d) => {
			d.addEventListener('click', () => {
				const t = parseInt(d.getAttribute('data-target-slide') || '1', 10);
				goToSlide(t);
			});
		});

		window.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
			if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
		});

		// --- SLIDE 2: Access simulation ---
		const btnInspectAccess = document.getElementById('btn-inspect-access');

		btnInspectAccess?.addEventListener('click', () => {
			[0, 1, 2, 3].forEach((i) => {
				setTimeout(() => {
					const node = document.getElementById(`lnk-node-${i}`);
					if (node) {
						node.style.stroke = 'var(--color-accent)';
						node.style.strokeWidth = '2';
					}
				}, i * 300);
			});
		});

		// --- SLIDE 4: Head insertion stepper ---
		let headStep = 1;
		const btnStepHead = document.getElementById('btn-step-head');
		const btnResetHead = document.getElementById('btn-reset-head');
		const headStepTitle = document.getElementById('head-step-title');
		const headStepCode = document.getElementById('head-step-code');
		const arrNewToA = document.getElementById('arr-new-to-a');
		const headAddrTxt = document.getElementById('head-addr-txt');
		const arrHeadLink = document.getElementById('arr-head-link');

		function updateHeadView() {
			if (headStep === 1) {
				if (headStepTitle) headStepTitle.textContent = '1. Nace nuevo = new Nodo("X")';
				if (headStepCode) headStepCode.textContent = 'Nodo nuevo = new Nodo("X");';
				if (arrNewToA) arrNewToA.style.display = 'none';
				if (headAddrTxt) headAddrTxt.textContent = '@0x1000';
				if (arrHeadLink) arrHeadLink.setAttribute('d', 'M100 68 L150 68');
			} else if (headStep === 2) {
				if (headStepTitle) headStepTitle.textContent = '2. nuevo.siguiente = cabeza';
				if (headStepCode) headStepCode.textContent = 'nuevo.siguiente = cabeza; // Apunta a Nodo "A"';
				if (arrNewToA) arrNewToA.style.display = 'block';
			} else {
				if (headStepTitle) headStepTitle.textContent = '3. cabeza = nuevo';
				if (headStepCode) headStepCode.textContent = 'cabeza = nuevo; // cabeza apunta ahora a "X"';
				if (headAddrTxt) headAddrTxt.textContent = '@0x5E20';
				if (arrHeadLink) arrHeadLink.setAttribute('d', 'M70 90 L160 160');
			}
		}

		btnStepHead?.addEventListener('click', () => {
			headStep = (headStep % 3) + 1;
			updateHeadView();
		});

		btnResetHead?.addEventListener('click', () => {
			headStep = 1;
			updateHeadView();
		});

		// --- SLIDE 5: Tail cursor stepper ---
		let tailStep = 0;
		const btnStepTail = document.getElementById('btn-step-tail');
		const cursorGroup = document.getElementById('cursor-group');
		const tailPosTxt = document.getElementById('tail-pos-txt');
		const cursorPositions = [60, 190, 320];
		const cursorNames = ['"A"', '"B"', '"C" (Último nodo, actual.siguiente == null)'];

		btnStepTail?.addEventListener('click', () => {
			tailStep = (tailStep + 1) % 3;
			if (cursorGroup) {
				cursorGroup.setAttribute('transform', `translate(${cursorPositions[tailStep]}, 120)`);
			}
			if (tailPosTxt) tailPosTxt.textContent = `actual = Nodo ${cursorNames[tailStep]}`;
		});

		// --- SLIDE 6: Middle bypass ---
		const btnToggleBypass = document.getElementById('btn-toggle-bypass');
		const btnResetBypass = document.getElementById('btn-reset-bypass');
		const bridgeArc = document.getElementById('bridge-arc');
		const delTargetNode = document.getElementById('del-target-node');
		const bypassStateTxt = document.getElementById('bypass-state-txt');

		btnToggleBypass?.addEventListener('click', () => {
			if (bridgeArc) bridgeArc.style.display = 'block';
			if (delTargetNode) delTargetNode.style.opacity = '0.25';
			if (bypassStateTxt) {
				bypassStateTxt.textContent = '⚡ Puentado: huérfano para el Garbage Collector';
				bypassStateTxt.style.color = 'rgb(239, 68, 68)';
			}
		});

		btnResetBypass?.addEventListener('click', () => {
			if (bridgeArc) bridgeArc.style.display = 'none';
			if (delTargetNode) delTargetNode.style.opacity = '1';
			if (bypassStateTxt) {
				bypassStateTxt.textContent = 'Enlazado en la cadena';
				bypassStateTxt.style.color = 'var(--color-text)';
			}
		});

		// --- SLIDE 7: Variants ---
		const varBtns = screen.querySelectorAll('.var-btn');
		const arrBackAb = document.getElementById('arr-back-ab');
		const circArc = document.getElementById('circ-arc');
		const varPntTxt = document.getElementById('var-pnt-txt');
		const varAdvTxt = document.getElementById('var-adv-txt');
		const varCodeSnippet = document.getElementById('var-code-snippet');

		varBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				varBtns.forEach((b) => b.classList.remove('active'));
				btn.classList.add('active');
				const v = btn.getAttribute('data-var');

				if (v === 'double') {
					if (arrBackAb) arrBackAb.style.display = 'block';
					if (circArc) circArc.style.display = 'none';
					if (varPntTxt) varPntTxt.textContent = 'anterior + siguiente (2 punteros)';
					if (varAdvTxt) varAdvTxt.textContent = 'Recorrido bidireccional y borrado O(1)';
					if (varCodeSnippet) {
						varCodeSnippet.textContent = 'class NodoDoble<T> {\n  T dato;\n  NodoDoble<T> anterior;\n  NodoDoble<T> siguiente;\n}';
					}
				} else {
					if (arrBackAb) arrBackAb.style.display = 'none';
					if (circArc) circArc.style.display = 'block';
					if (varPntTxt) varPntTxt.textContent = 'último.siguiente == cabeza';
					if (varAdvTxt) varAdvTxt.textContent = 'Recorrido continuo cíclico sin nulls';
					if (varCodeSnippet) {
						varCodeSnippet.textContent = '// Lista Circular:\nultimo.siguiente = cabeza; // Enlace en anillo';
					}
				}
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initPresentation);
	} else {
		initPresentation();
	}
</script>

