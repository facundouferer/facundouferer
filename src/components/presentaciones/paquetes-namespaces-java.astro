	}

	.pn-code-block code { white-space: pre; }

	.pn-code-line-error {
		display: inline-block;
		background: color-mix(in srgb, var(--color-accent-800) 16%, transparent);
		color: var(--color-accent-800);
		border-radius: var(--radius-sm);
		padding: 0 4px;
	}

	.pn-resolve-list { display: flex; flex-direction: column; gap: var(--space-1); margin-bottom: var(--space-3); }

	.pn-resolve-row { display: flex; align-items: center; gap: var(--space-2); font-size: 12px; flex-wrap: wrap; }

	.pn-resolve-row code {
		font-family: monospace;
		background: var(--color-surface);
		border-radius: var(--radius-sm);
		padding: 1px 6px;
	}

	.pn-resolve-arrow { color: color-mix(in srgb, var(--color-text) 45%, transparent); }

	.pn-resolve-row.is-error code:first-child { color: var(--color-accent-800); }

	.pn-import-result {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: 12px;
		padding: var(--space-3);
		border-radius: var(--radius-md);
	}

	.pn-import-result.is-ok {
		background: color-mix(in srgb, var(--color-accent-2) 12%, transparent);
		color: var(--color-accent-2-700);
	}

	.pn-import-result.is-error {
		background: color-mix(in srgb, var(--color-accent-800) 12%, transparent);
		color: var(--color-accent-800);
	}

	/* Slide 5: visibility probe */
	.pn-package-diagram {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		flex-wrap: wrap;
		margin-bottom: var(--space-2);
	}

	.pn-package-box {
		flex: 1;
		min-width: 220px;
		background: var(--color-bg);
		border: 2px solid var(--color-accent-2-400);
		border-radius: var(--radius-md);
		padding: var(--space-3);
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.pn-package-box-outline {
		border-style: dashed;
		border-color: var(--color-divider);
		align-items: center;
		justify-content: center;
		text-align: center;
	}

	.pn-probe-arrow { color: color-mix(in srgb, var(--color-text) 45%, transparent); }

	.pn-class-chip {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		font-family: monospace;
		font-size: 12px;
		padding: var(--space-1) var(--space-2);
		border-radius: var(--radius-sm);
		transition: all 0.25s ease;
	}

	.pn-class-chip-public {
		background: color-mix(in srgb, var(--color-accent-2) 14%, transparent);
		color: var(--color-accent-2-700);
	}

	.pn-class-chip-private {
		background: var(--color-neutral-200);
		color: var(--color-neutral-700);
	}

	.pn-class-chip.is-probed {
		outline: 2px solid var(--color-accent);
		outline-offset: 2px;
	}

	.pn-probe-controls {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-5);
		margin: var(--space-4) 0;
	}

	.pn-probe-group-label {
		display: block;
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-weight: 700;
		color: color-mix(in srgb, var(--color-text) 55%, transparent);
		margin-bottom: var(--space-1);
	}

	.pn-probe-buttons { display: flex; gap: var(--space-2); flex-wrap: wrap; }

	.pn-probe-result {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: 13px;
		padding: var(--space-3);
		border-radius: var(--radius-md);
		background: var(--color-bg);
		border-left: 3px solid var(--color-accent-2);
		color: var(--color-accent-2-700);
	}

	.pn-probe-result.is-denied {
		border-left-color: var(--color-accent-800);
		color: var(--color-accent-800);
	}

	.pn-probe-result .pn-status-icon { color: var(--color-accent-2); }
	.pn-probe-result.is-denied .pn-status-icon { color: var(--color-accent-800); }

	/* Slide 6: rules checklist */
	.pn-rules-list { display: flex; flex-direction: column; gap: var(--space-3); }

	.pn-rule {
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--color-bg);
	}

	.pn-rule-toggle {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		width: 100%;
		text-align: left;
		background: transparent;
		border: none;
		padding: var(--space-3);
		cursor: pointer;
		font-family: var(--font-body);
		font-size: 14px;
		font-weight: 600;
		color: var(--color-text);
	}

	.pn-rule-toggle svg {
		transition: transform 0.2s ease;
		color: var(--color-accent-700);
		flex-shrink: 0;
	}

	.pn-rule-toggle.is-open svg { transform: rotate(90deg); }

	.pn-rule-example {
		padding: 0 var(--space-3) var(--space-3);
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.pn-example {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: 12px;
		font-family: monospace;
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-sm);
	}

	.pn-example svg { flex-shrink: 0; width: 16px; height: 16px; }

	.pn-example-bad {
		background: color-mix(in srgb, var(--color-accent-800) 10%, transparent);
		color: var(--color-accent-800);
	}

	.pn-example-good {
		background: color-mix(in srgb, var(--color-accent-2) 12%, transparent);
		color: var(--color-accent-2-700);
	}

	@media (min-width: 1440px) { .pn-viewport { zoom: 1.08; } }
	@media (min-width: 1680px) { .pn-viewport { zoom: 1.16; } }
	@media (min-width: 1920px) { .pn-viewport { zoom: 1.25; } }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const screenEl = document.querySelector('.pn-screen');
	const pageLang = screenEl?.getAttribute('data-lang') === 'en' ? 'en' : 'es';

	const prevBtn = document.getElementById('pnPrevBtn') as HTMLButtonElement;
	const nextBtn = document.getElementById('pnNextBtn') as HTMLButtonElement;
	const counter = document.getElementById('pnSlideCounter') as HTMLElement;
	const slides = document.querySelectorAll<HTMLElement>('.pn-slide');

	function updateSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;
		slides.forEach((s) => s.classList.remove('is-active'));
		document.querySelector(`.pn-slide[data-slide="${currentSlide}"]`)?.classList.add('is-active');

		if (counter) counter.textContent = `${currentSlide} / ${totalSlides}`;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	prevBtn?.addEventListener('click', () => updateSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => updateSlide(currentSlide + 1));

	window.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') updateSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') updateSlide(currentSlide - 1);
	});

	// Slide 1: collision toggle
	const collisionToggle = document.getElementById('pnCollisionToggle');
	const flatSpace = document.getElementById('pnFlatSpace');
	const splitSpace = document.getElementById('pnSplitSpace');
	const collisionStatus = document.getElementById('pnCollisionStatus');
	const collisionStatusIcon = document.getElementById('pnCollisionStatusIcon');
	const collisionStatusText = document.getElementById('pnCollisionStatusText');

	const ICON_WARNING = '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" /><path d="M12 9v4" /><path d="M12 17h.01" />';
	const ICON_CHECK = '<circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" />';
	const ICON_X = '<circle cx="12" cy="12" r="10" /><path d="m15 9-6 6" /><path d="m9 9 6 6" />';
	const ICON_LOCK = '<rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />';
	const ICON_UNLOCK = '<rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 9.9-1" />';

	let namespacesEnabled = false;

	function renderCollision() {
		if (flatSpace) flatSpace.hidden = namespacesEnabled;
		if (splitSpace) splitSpace.hidden = !namespacesEnabled;
		collisionStatus?.classList.toggle('is-ok', namespacesEnabled);
		if (collisionStatusIcon) collisionStatusIcon.innerHTML = namespacesEnabled ? ICON_CHECK : ICON_WARNING;
		if (collisionStatusText) {
			collisionStatusText.textContent = namespacesEnabled
				? (pageLang === 'es'
					? 'Sin colisiones: cada namespace es su propio contexto. Usuario y Date coexisten en paquetes distintos.'
					: 'No collisions: each namespace is its own context. Usuario and Date coexist in separate packages.')
				: (pageLang === 'es'
					? 'Colisión: el compilador no sabe qué clase Usuario (o Date) estás pidiendo.'
					: 'Collision: the compiler cannot tell which Usuario (or Date) class you mean.');
		}
		if (collisionToggle) {
			collisionToggle.textContent = namespacesEnabled
				? (pageLang === 'es' ? 'Desactivar namespaces' : 'Disable namespaces')
				: (pageLang === 'es' ? 'Activar namespaces' : 'Enable namespaces');
		}
	}

	collisionToggle?.addEventListener('click', () => {
		namespacesEnabled = !namespacesEnabled;
		renderCollision();
	});

	renderCollision();

	// Slide 2: folder tree + declaration panel
	const treeFiles = document.querySelectorAll<HTMLButtonElement>('.pn-tree-file');
	const declLine = document.getElementById('pnDeclLine');
	const declFqcn = document.getElementById('pnDeclFqcn');
	const mismatchBtn = document.getElementById('pnMismatchBtn');
	const compileResult = document.getElementById('pnCompileResult');
	const compileIcon = document.getElementById('pnCompileIcon');
	const compileText = document.getElementById('pnCompileText');

	let currentTreeFile = {
		packageName: 'com.facundouferer.tienda.dominio',
		className: 'Producto',
		folder: 'tienda/dominio/',
	};
	let mismatchActive = false;

	function renderTree() {
		const wrongPackage = 'com.facundouferer.tienda.reportes';

		if (declLine) declLine.textContent = `package ${mismatchActive ? wrongPackage : currentTreeFile.packageName};`;
		if (declFqcn) declFqcn.textContent = `FQCN: ${currentTreeFile.packageName}.${currentTreeFile.className}`;

		if (mismatchBtn) {
			mismatchBtn.textContent = mismatchActive
				? (pageLang === 'es' ? 'Corregir declaración' : 'Fix declaration')
				: (pageLang === 'es' ? 'Simular carpeta incorrecta' : 'Simulate wrong folder');
		}

		compileResult?.classList.toggle('is-ok', !mismatchActive);
		compileResult?.classList.toggle('is-error', mismatchActive);
		if (compileIcon) compileIcon.innerHTML = mismatchActive ? ICON_X : ICON_CHECK;
		if (compileText) {
			compileText.textContent = mismatchActive
				? (pageLang === 'es'
					? `No compila: la carpeta real es ${currentTreeFile.folder} pero declaraste ${wrongPackage}.`
					: `Does not compile: the real folder is ${currentTreeFile.folder} but you declared ${wrongPackage}.`)
				: (pageLang === 'es'
					? `Compila: el package coincide exactamente con la carpeta ${currentTreeFile.folder}.`
					: `Compiles: the package matches the folder ${currentTreeFile.folder} exactly.`);
		}
	}

	treeFiles.forEach((file) => {
		file.addEventListener('click', () => {
			treeFiles.forEach((f) => f.classList.remove('is-active'));
			file.classList.add('is-active');
			currentTreeFile = {
				packageName: file.dataset.package ?? '',
				className: file.dataset.class ?? '',
				folder: file.dataset.folder ?? '',
			};
			mismatchActive = false;
			renderTree();
		});
	});

	mismatchBtn?.addEventListener('click', () => {
		mismatchActive = !mismatchActive;
		renderTree();
	});

	renderTree();

	// Slide 3: FQCN assembly stepper
	const fqcnPieces = document.querySelectorAll<HTMLElement>('.pn-fqcn-piece');
	const fqcnNextBtn = document.getElementById('pnFqcnNextBtn') as HTMLButtonElement;
	const fqcnResetBtn = document.getElementById('pnFqcnResetBtn');
	const fqcnExplain = document.getElementById('pnFqcnExplain');
	const fqcnFinal = document.getElementById('pnFqcnFinal');

	let fqcnStep = 0;
	const totalFqcnPieces = fqcnPieces.length;

	const fqcnExplanations = {
		es: [
			'Tocá "Agregar siguiente pieza" para empezar a construir el FQCN.',
			'Paso 1 — Dominio invertido: facundouferer.ar se convierte en com.facundouferer. Ningún otro namespace del mundo empieza igual.',
			'Paso 2 — Proyecto: tienda identifica la aplicación dentro de tu dominio.',
			'Paso 3 — Capa: dominio agrupa por responsabilidad, no por tipo de artefacto.',
			'✓ FQCN completo: com.facundouferer.tienda.dominio.Producto — la identidad única de la clase para la JVM.',
		],
		en: [
			'Tap "Add next piece" to start building the FQCN.',
			'Step 1 — Reversed domain: facundouferer.ar becomes com.facundouferer. No other namespace in the world starts the same way.',
			'Step 2 — Project: tienda identifies the application inside your domain.',
			'Step 3 — Layer: dominio groups by responsibility, not by artifact type.',
			"Step 4 — Class: the complete FQCN com.facundouferer.tienda.dominio.Producto is the class's unique identity to the JVM.",
		],
	};

	function renderFqcn() {
		fqcnPieces.forEach((piece, idx) => {
			piece.classList.toggle('is-visible', idx < fqcnStep);
			piece.classList.toggle('is-current', idx === fqcnStep - 1);
		});
		if (fqcnExplain) {
			const messages = pageLang === 'es' ? fqcnExplanations.es : fqcnExplanations.en;
			fqcnExplain.textContent = messages[fqcnStep] ?? messages[messages.length - 1];
		}
		if (fqcnNextBtn) fqcnNextBtn.disabled = fqcnStep >= totalFqcnPieces;
		if (fqcnFinal) fqcnFinal.hidden = fqcnStep < totalFqcnPieces;
	}

	fqcnNextBtn?.addEventListener('click', () => {
		if (fqcnStep >= totalFqcnPieces) return;
		fqcnStep++;
		renderFqcn();
	});

	fqcnResetBtn?.addEventListener('click', () => {
		fqcnStep = 0;
		renderFqcn();
	});

	renderFqcn();

	// Slide 4: import scenario tabs
	const importTabs = {
		only: document.getElementById('pnImportTabOnly'),
		both: document.getElementById('pnImportTabBoth'),
		resolved: document.getElementById('pnImportTabResolved'),
	};
	const importPanels = {
		only: document.getElementById('pnImportPanelOnly'),
		both: document.getElementById('pnImportPanelBoth'),
		resolved: document.getElementById('pnImportPanelResolved'),
	};

	type ImportScenario = keyof typeof importTabs;

	function renderImportScenario(scenario: ImportScenario) {
		(Object.keys(importTabs) as ImportScenario[]).forEach((key) => {
			importTabs[key]?.classList.toggle('is-active', key === scenario);
			importTabs[key]?.setAttribute('aria-selected', key === scenario ? 'true' : 'false');
			importPanels[key]?.classList.toggle('is-active', key === scenario);
			if (importPanels[key]) (importPanels[key] as HTMLElement).hidden = key !== scenario;
		});
	}

	importTabs.only?.addEventListener('click', () => renderImportScenario('only'));
	importTabs.both?.addEventListener('click', () => renderImportScenario('both'));
	importTabs.resolved?.addEventListener('click', () => renderImportScenario('resolved'));

	renderImportScenario('only');

	// Slide 5: visibility probe
	const targetProductoBtn = document.getElementById('pnTargetProductoBtn');
	const targetValidatorBtn = document.getElementById('pnTargetValidatorBtn');
	const originSameBtn = document.getElementById('pnOriginSameBtn');
	const originOtherBtn = document.getElementById('pnOriginOtherBtn');
	const chipProducto = document.getElementById('pnChipProducto');
	const chipValidator = document.getElementById('pnChipValidator');
	const probeOriginLabel = document.getElementById('pnProbeOriginLabel');
	const probeResult = document.getElementById('pnProbeResult');
	const probeIcon = document.getElementById('pnProbeIcon');
	const probeText = document.getElementById('pnProbeText');

	type ProbeTarget = 'producto' | 'validator';
	type ProbeOrigin = 'same' | 'other';

	let probeTarget: ProbeTarget = 'producto';
	let probeOrigin: ProbeOrigin = 'same';

	function renderProbe() {
		targetProductoBtn?.classList.toggle('is-active', probeTarget === 'producto');
		targetValidatorBtn?.classList.toggle('is-active', probeTarget === 'validator');
		originSameBtn?.classList.toggle('is-active', probeOrigin === 'same');
		originOtherBtn?.classList.toggle('is-active', probeOrigin === 'other');

		chipProducto?.classList.toggle('is-probed', probeTarget === 'producto');
		chipValidator?.classList.toggle('is-probed', probeTarget === 'validator');

		if (probeOriginLabel) {
			probeOriginLabel.textContent = probeOrigin === 'same' ? 'com.tienda.dominio' : 'com.tienda.servicio';
		}

		const allowed = probeTarget === 'producto' || probeOrigin === 'same';
		probeResult?.classList.toggle('is-denied', !allowed);
		if (probeIcon) probeIcon.innerHTML = allowed ? ICON_UNLOCK : ICON_LOCK;

		if (probeText) {
			const className = probeTarget === 'producto' ? 'Producto' : 'ProductoValidator';
			if (allowed) {
				probeText.textContent = pageLang === 'es'
					? (probeTarget === 'producto'
						? `Acceso permitido: ${className} es public, visible desde cualquier paquete.`
						: `Acceso permitido: ${className} es package-private, pero el acceso viene del mismo paquete.`)
					: (probeTarget === 'producto'
						? `Access allowed: ${className} is public, visible from any package.`
						: `Access allowed: ${className} is package-private, but the access comes from the same package.`);
			} else {
				probeText.textContent = pageLang === 'es'
					? `Acceso denegado: ${className} es package-private y no es visible fuera de com.tienda.dominio.`
					: `Access denied: ${className} is package-private and is not visible outside com.tienda.dominio.`;
			}
		}
	}

	targetProductoBtn?.addEventListener('click', () => { probeTarget = 'producto'; renderProbe(); });
	targetValidatorBtn?.addEventListener('click', () => { probeTarget = 'validator'; renderProbe(); });
	originSameBtn?.addEventListener('click', () => { probeOrigin = 'same'; renderProbe(); });
	originOtherBtn?.addEventListener('click', () => { probeOrigin = 'other'; renderProbe(); });

	renderProbe();

	// Slide 6: rules checklist toggles
	const ruleToggles = document.querySelectorAll<HTMLButtonElement>('.pn-rule-toggle');
	ruleToggles.forEach((toggle) => {
		toggle.addEventListener('click', () => {
			const example = toggle.nextElementSibling as HTMLElement | null;
			const isOpen = toggle.classList.toggle('is-open');
			toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
			if (example) example.hidden = !isOpen;
		});
	});
</script>
