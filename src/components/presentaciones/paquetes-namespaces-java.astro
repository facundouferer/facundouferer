---
interface Props {
	lang?: string;
}

const { lang = 'es' } = Astro.props;
const isEs = lang === 'es';
---

<div class="pn-screen" data-presentation="paquetes-namespaces-java" data-lang={lang}>
	<div class="pn-shell">
		<nav class="pn-nav" aria-label={isEs ? 'Controles de navegación' : 'Navigation controls'}>
			<button class="pn-btn" id="pnPrevBtn" aria-label={isEs ? 'Diapositiva anterior' : 'Previous slide'} disabled>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
					<path d="m15 18-6-6 6-6" />
				</svg>
				<span>{isEs ? 'Anterior' : 'Previous'}</span>
			</button>
			<span class="pn-counter" id="pnSlideCounter" aria-live="polite">1 / 6</span>
			<button class="pn-btn" id="pnNextBtn" aria-label={isEs ? 'Siguiente diapositiva' : 'Next slide'}>
				<span>{isEs ? 'Siguiente' : 'Next'}</span>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
					<path d="m9 18 6-6-6-6" />
				</svg>
			</button>
		</nav>

		<main class="pn-viewport">
			<!-- Slide 1: El problema — colisiones de nombres -->
			<section class="pn-slide is-active" data-slide="1">
				<div class="pn-header">
					<span class="pn-kicker">{isEs ? 'El problema' : 'The problem'}</span>
					<h2 class="pn-title">{isEs ? 'Colisiones de nombres en un espacio global' : 'Name collisions in a flat global scope'}</h2>
					<p class="pn-lead">
						{isEs
							? 'Un namespace es un contenedor lógico que agrupa clases e interfaces para darles un contexto único y evitar colisiones de nombres. Sin namespaces, dos clases Usuario o dos clases Date compiten por el mismo nombre simple en un único espacio global plano.'
							: 'A namespace is a logical container that groups classes and interfaces to give them a unique context and prevent name collisions. Without namespaces, two Usuario classes or two Date classes compete for the same short name in a single flat global scope.'}
					</p>
				</div>

				<div class="pn-card">
					<div class="pn-collision-toolbar">
						<button class="pn-action-btn" id="pnCollisionToggle">{isEs ? 'Activar namespaces' : 'Enable namespaces'}</button>
						<span class="pn-hint">{isEs ? 'Mismo nombre, mismo espacio: el compilador no puede elegir.' : 'Same name, same scope: the compiler cannot choose.'}</span>
					</div>

					<div class="pn-collision-stage">
						<div class="pn-flat-space" id="pnFlatSpace">
							<span class="pn-space-label">{isEs ? 'Espacio global (sin namespaces)' : 'Global scope (no namespaces)'}</span>
							<div class="pn-collide-row">
								<div class="pn-collide-group">
									<span class="pn-chip pn-chip-collide">Usuario</span>
									<span class="pn-chip pn-chip-collide pn-chip-offset">Usuario</span>
								</div>
								<div class="pn-collide-group">
									<span class="pn-chip pn-chip-collide">Date</span>
									<span class="pn-chip pn-chip-collide pn-chip-offset">Date</span>
								</div>
							</div>
						</div>

						<div class="pn-split-space" id="pnSplitSpace" hidden>
							<div class="pn-namespace-box">
								<span class="pn-namespace-label">com.tienda.dominio</span>
								<span class="pn-chip pn-chip-ok">Usuario</span>
							</div>
							<div class="pn-namespace-box">
								<span class="pn-namespace-label">com.crm.dominio</span>
								<span class="pn-chip pn-chip-ok">Usuario</span>
							</div>
							<div class="pn-namespace-box">
								<span class="pn-namespace-label">java.util</span>
								<span class="pn-chip pn-chip-ok">Date</span>
							</div>
							<div class="pn-namespace-box">
								<span class="pn-namespace-label">java.sql</span>
								<span class="pn-chip pn-chip-ok">Date</span>
							</div>
						</div>
					</div>

					<p class="pn-collision-status" id="pnCollisionStatus">
						<svg class="pn-status-icon" id="pnCollisionStatusIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
							<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
							<path d="M12 9v4" />
							<path d="M12 17h.01" />
						</svg>
						<span id="pnCollisionStatusText">{isEs ? 'Colisión: el compilador no sabe qué clase Usuario (o Date) estás pidiendo.' : 'Collision: the compiler cannot tell which Usuario (or Date) class you mean.'}</span>
					</p>
				</div>
			</section>

			<!-- Slide 2: package <-> carpeta -->
			<section class="pn-slide" data-slide="2">
				<div class="pn-header">
					<span class="pn-kicker">{isEs ? 'Namespace físico' : 'Physical namespace'}</span>
					<h2 class="pn-title">{isEs ? 'La carpeta tiene que coincidir con el package' : 'The folder must match the package line'}</h2>
					<p class="pn-lead">
						{isEs
							? 'A diferencia de otros lenguajes, Java impone una correspondencia estricta: el namespace declarado en package debe coincidir exactamente con la ruta de carpetas en el classpath. Elegí un archivo del árbol para ver su declaración obligatoria.'
							: 'Unlike other languages, Java enforces a strict rule: the namespace declared in package must match the directory path on the classpath exactly. Pick a file from the tree to see its required declaration.'}
					</p>
				</div>

				<div class="pn-card">
					<div class="pn-tree-grid">
						<div class="pn-tree-panel">
							<span class="pn-panel-label">{isEs ? 'Árbol de carpetas' : 'Folder tree'}</span>
							<ul class="pn-tree" role="tree">
								<li class="pn-tree-node">
									<span class="pn-tree-folder-row">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" /></svg>
										<span>com</span>
									</span>
									<ul class="pn-tree-nest">
										<li class="pn-tree-node">
											<span class="pn-tree-folder-row">
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" /></svg>
												<span>facundouferer</span>
											</span>
											<ul class="pn-tree-nest">
												<li class="pn-tree-node">
													<span class="pn-tree-folder-row">
														<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" /></svg>
														<span>tienda</span>
													</span>
													<ul class="pn-tree-nest">
														<li>
															<button class="pn-tree-file" data-package="com.facundouferer.tienda" data-class="Main" data-folder="tienda/">
																<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /></svg>
																<span>Main.java</span>
															</button>
														</li>
														<li class="pn-tree-node">
															<span class="pn-tree-folder-row">
																<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" /></svg>
																<span>dominio</span>
															</span>
															<ul class="pn-tree-nest">
																<li>
																	<button class="pn-tree-file is-active" data-package="com.facundouferer.tienda.dominio" data-class="Producto" data-folder="tienda/dominio/">
																		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /></svg>
																		<span>Producto.java</span>
																	</button>
																</li>
																<li>
																	<button class="pn-tree-file" data-package="com.facundouferer.tienda.dominio" data-class="Cliente" data-folder="tienda/dominio/">
																		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /></svg>
																		<span>Cliente.java</span>
																	</button>
																</li>
															</ul>
														</li>
														<li class="pn-tree-node">
															<span class="pn-tree-folder-row">
																<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" /></svg>
																<span>servicio</span>
															</span>
															<ul class="pn-tree-nest">
																<li>
																	<button class="pn-tree-file" data-package="com.facundouferer.tienda.servicio" data-class="CarritoServicio" data-folder="tienda/servicio/">
																		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /></svg>
																		<span>CarritoServicio.java</span>
																	</button>
																</li>
															</ul>
														</li>
													</ul>
												</li>
											</ul>
										</li>
									</ul>
								</li>
							</ul>
						</div>

						<div class="pn-decl-panel">
							<span class="pn-panel-label">{isEs ? 'Declaración requerida' : 'Required declaration'}</span>
							<code class="pn-decl-line" id="pnDeclLine">package com.facundouferer.tienda.dominio;</code>
							<span class="pn-decl-fqcn" id="pnDeclFqcn">FQCN: com.facundouferer.tienda.dominio.Producto</span>

							<button class="pn-ghost-btn" id="pnMismatchBtn">{isEs ? 'Simular carpeta incorrecta' : 'Simulate wrong folder'}</button>

							<div class="pn-compile-result is-ok" id="pnCompileResult">
								<svg class="pn-status-icon" id="pnCompileIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="10" />
									<path d="m9 12 2 2 4-4" />
								</svg>
								<span id="pnCompileText">{isEs ? 'Compila: el package coincide exactamente con la carpeta tienda/dominio/.' : 'Compiles: the package matches the folder tienda/dominio/ exactly.'}</span>
							</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Slide 3: FQCN pieza por pieza -->
			<section class="pn-slide" data-slide="3">
				<div class="pn-header">
					<span class="pn-kicker">{isEs ? 'Identidad de clase' : 'Class identity'}</span>
					<h2 class="pn-title">{isEs ? 'El FQCN se arma pieza por pieza' : 'The FQCN is built piece by piece'}</h2>
					<p class="pn-lead">
						{isEs
							? 'Para la JVM, Producto es solo una etiqueta local. Su identidad formal ante el ClassLoader es el Fully Qualified Class Name (FQCN): dominio invertido, proyecto, capa y clase, unidos por puntos.'
							: 'To the JVM, Producto is only a local label. Its formal identity to the ClassLoader is the Fully Qualified Class Name (FQCN): reversed domain, project, layer and class, joined by dots.'}
					</p>
				</div>

				<div class="pn-card">
					<div class="pn-fqcn-track" id="pnFqcnTrack">
						<span class="pn-fqcn-piece" data-piece="1">com.facundouferer</span>
						<span class="pn-fqcn-piece" data-piece="2">.tienda</span>
						<span class="pn-fqcn-piece" data-piece="3">.dominio</span>
						<span class="pn-fqcn-piece pn-fqcn-piece-class" data-piece="4">.Producto</span>
					</div>

					<div class="pn-fqcn-controls">
						<button class="pn-action-btn" id="pnFqcnNextBtn">{isEs ? 'Agregar siguiente pieza' : 'Add next piece'}</button>
						<button class="pn-ghost-btn" id="pnFqcnResetBtn">{isEs ? 'Reiniciar' : 'Reset'}</button>
					</div>

					<p class="pn-fqcn-explain" id="pnFqcnExplain">
						{isEs ? 'Tocá "Agregar siguiente pieza" para empezar a construir el FQCN.' : 'Tap "Add next piece" to start building the FQCN.'}
					</p>

					<div class="pn-fqcn-final" id="pnFqcnFinal" hidden>
						<span class="pn-panel-label">{isEs ? 'Dos clases, mismo nombre simple, sin colisión' : 'Two classes, same short name, no collision'}</span>
						<div class="pn-fqcn-coexist-row">
							<code class="pn-decl-fqcn">com.facundouferer.tienda.dominio.Producto</code>
							<span class="pn-hint">{isEs ? 'entidad de dominio propia' : 'your own domain entity'}</span>
						</div>
						<div class="pn-fqcn-coexist-row">
							<code class="pn-decl-fqcn">com.proveedor.catalogo.Producto</code>
							<span class="pn-hint">{isEs ? 'DTO importado de un catálogo externo' : 'DTO imported from an external catalog'}</span>
						</div>
					</div>
				</div>
			</section>

			<!-- Slide 4: import como alias -->
			<section class="pn-slide" data-slide="4">
				<div class="pn-header">
					<span class="pn-kicker">{isEs ? 'Alias léxico' : 'Lexical alias'}</span>
					<h2 class="pn-title">{isEs ? 'import no carga código: registra un alias' : 'import does not load code: it registers an alias'}</h2>
					<p class="pn-lead">
						{isEs
							? 'La sentencia import es un atajo léxico para no escribir el FQCN cada vez. Java prohíbe importar dos clases con el mismo nombre simple en el mismo archivo: probá los tres escenarios.'
							: 'The import statement is a lexical shortcut so you never have to type the FQCN each time. Java forbids importing two classes with the same short name in one file: try the three scenarios.'}
					</p>
				</div>

				<div class="pn-card">
					<div class="pn-import-tabs" role="tablist">
						<button class="pn-tab is-active" id="pnImportTabOnly" role="tab" aria-selected="true">{isEs ? 'Solo java.util.Date' : 'Only java.util.Date'}</button>
						<button class="pn-tab" id="pnImportTabBoth" role="tab" aria-selected="false">{isEs ? 'Importar ambos → error' : 'Import both → error'}</button>
						<button class="pn-tab" id="pnImportTabResolved" role="tab" aria-selected="false">{isEs ? 'Resuelto con FQCN inline' : 'Resolved with inline FQCN'}</button>
					</div>

					<div class="pn-import-panel is-active" id="pnImportPanelOnly">
						<pre class="pn-code-block"><code>package com.facundouferer.tienda.servicio;

import java.util.Date;

public class AuditoriaServicio &#123;
    private Date fechaOperacion = new Date();
&#125;</code></pre>
						<div class="pn-resolve-list">
							<div class="pn-resolve-row"><code>Date</code><span class="pn-resolve-arrow">→</span><code>java.util.Date</code></div>
						</div>
						<div class="pn-import-result is-ok">
							<svg class="pn-status-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
							<span>{isEs ? 'Compila: Date se resuelve sin ambigüedad al único import presente.' : 'Compiles: Date resolves unambiguously to the only import present.'}</span>
						</div>
					</div>

					<div class="pn-import-panel" id="pnImportPanelBoth" hidden>
						<pre class="pn-code-block"><code>package com.facundouferer.tienda.servicio;

import java.util.Date;
<span class="pn-code-line-error">import java.sql.Date; // ← Date is already defined</span></code></pre>
						<div class="pn-resolve-list">
							<div class="pn-resolve-row is-error"><code>java.sql.Date</code><span class="pn-resolve-arrow">→</span><span>{isEs ? 'colisión con el import anterior' : 'collision with the previous import'}</span></div>
						</div>
						<div class="pn-import-result is-error">
							<svg class="pn-status-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="m15 9-6 6" /><path d="m9 9 6 6" /></svg>
							<span>{isEs
								? "No compila: 'Date is already defined in a single-type import'."
								: "Does not compile: 'Date is already defined in a single-type import'."}</span>
						</div>
					</div>

					<div class="pn-import-panel" id="pnImportPanelResolved" hidden>
						<pre class="pn-code-block"><code>package com.facundouferer.tienda.servicio;

import java.util.Date; // Date sin calificar = java.util.Date

public class AuditoriaServicio &#123;
    private Date fechaOperacion = new Date();
    private java.sql.Date fechaPersistenciaBD = new java.sql.Date(System.currentTimeMillis());
&#125;</code></pre>
						<div class="pn-resolve-list">
							<div class="pn-resolve-row"><code>Date</code><span class="pn-resolve-arrow">→</span><code>java.util.Date</code></div>
							<div class="pn-resolve-row"><code>java.sql.Date</code><span class="pn-resolve-arrow">→</span><code>java.sql.Date</code> <span class="pn-hint">{isEs ? '(FQCN inline, sin import)' : '(inline FQCN, no import)'}</span></div>
						</div>
						<div class="pn-import-result is-ok">
							<svg class="pn-status-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" /></svg>
							<span>{isEs ? 'Compila: las dos clases Date conviven porque una usa el nombre simple y la otra el FQCN explícito.' : 'Compiles: both Date classes coexist because one uses the short name and the other the explicit FQCN.'}</span>
						</div>
					</div>
				</div>
			</section>

			<!-- Slide 5: visibilidad public vs package-private -->
			<section class="pn-slide" data-slide="5">
				<div class="pn-header">
					<span class="pn-kicker">{isEs ? 'Encapsulamiento de namespace' : 'Namespace encapsulation'}</span>
					<h2 class="pn-title">{isEs ? 'public vs package-private: fronteras de confianza' : 'public vs package-private: trust boundaries'}</h2>
					<p class="pn-lead">
						{isEs
							? 'Los namespaces no son solo carpetas cosméticas: también son límites de visibilidad. El modificador por defecto (package-private) restringe el acceso exclusivamente a clases del mismo paquete. Elegí una clase y un punto de acceso para probarlo.'
							: 'Namespaces are not just cosmetic folders: they are also visibility boundaries. The default modifier (package-private) restricts access strictly to classes in the same package. Pick a class and an access point to test it.'}
					</p>
				</div>

				<div class="pn-card">
					<div class="pn-package-diagram">
						<div class="pn-package-box">
							<span class="pn-namespace-label">com.tienda.dominio</span>
							<div class="pn-class-chip pn-class-chip-public" id="pnChipProducto">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 9.9-1" /></svg>
								<span>public class Producto</span>
							</div>
							<div class="pn-class-chip pn-class-chip-private" id="pnChipValidator">
								<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
								<span>class ProductoValidator</span>
							</div>
						</div>
						<div class="pn-probe-arrow">
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6" /></svg>
						</div>
						<div class="pn-package-box pn-package-box-outline" id="pnProbeOrigin">
							<span class="pn-namespace-label" id="pnProbeOriginLabel">com.tienda.dominio</span>
							<span class="pn-hint">{isEs ? 'punto de acceso' : 'access point'}</span>
						</div>
					</div>

					<div class="pn-probe-controls">
						<div class="pn-probe-group">
							<span class="pn-probe-group-label">{isEs ? 'Clase objetivo' : 'Target class'}</span>
							<div class="pn-probe-buttons">
								<button class="pn-tab is-active" id="pnTargetProductoBtn">Producto <span class="pn-tag-mini">public</span></button>
								<button class="pn-tab" id="pnTargetValidatorBtn">ProductoValidator <span class="pn-tag-mini">package-private</span></button>
							</div>
						</div>
						<div class="pn-probe-group">
							<span class="pn-probe-group-label">{isEs ? 'Origen del acceso' : 'Access origin'}</span>
							<div class="pn-probe-buttons">
								<button class="pn-tab is-active" id="pnOriginSameBtn">{isEs ? 'Desde el mismo paquete' : 'From the same package'}</button>
