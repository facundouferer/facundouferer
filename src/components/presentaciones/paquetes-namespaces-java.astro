	.pn-space-label {
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-weight: 700;
		color: color-mix(in srgb, var(--color-text) 55%, transparent);
	}

	.pn-collide-row { display: flex; gap: var(--space-6); flex-wrap: wrap; }

	.pn-collide-group { position: relative; display: flex; align-items: center; height: 40px; min-width: 100px; }

	.pn-chip {
