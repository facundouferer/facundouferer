		color: var(--color-accent-800);
		position: absolute;
		left: 0;
	}

	.pn-chip-offset { left: 30px; opacity: 0.8; }

	.pn-split-space {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-3);
