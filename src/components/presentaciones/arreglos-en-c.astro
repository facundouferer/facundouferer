---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="ac-screen">
	<div class="ac-shell">
		<header class="ac-header">
			<span class="ac-badge">{isEs ? 'Estructuras de Datos' : 'Data Structures'}</span>
			<h1 class="ac-title">
				{isEs ? 'Arreglos y Vectores Paso a Paso' : 'Arrays & Vectors Step by Step'}
			</h1>
			<p class="ac-sub">
				{isEs 
					? 'Contigüidad en memoria, indexación cero y tipos de arrays en C, Java, JavaScript y Python.' 
					: 'Memory contiguity, zero-indexing, and array models in C, Java, JS, and Python.'}
			</p>
		</header>

		<div class="ac-deck-card">
			<div class="ac-nav-bar">
				<div class="ac-slide-indicator">
					<span class="ac-step-dot"></span>
					<span id="ac-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="ac-pills">
					<button class="ac-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="ac-pill-btn" data-target-slide="2">2. C</button>
					<button class="ac-pill-btn" data-target-slide="3">3. Java</button>
					<button class="ac-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="ac-pill-btn" data-target-slide="5">5. Python</button>
					<button class="ac-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="ac-viewport">
				<div class="ac-slide active" data-slide="1">
					<div class="ac-slide-grid">
						<div class="ac-col">
							<h2 class="ac-slide-title">1. {isEs ? 'Contigüidad e Indexación Base Cero' : 'Contiguity & Zero Indexing'}</h2>
							<p class="ac-text">
								{isEs 
									? 'Un arreglo almacena una secuencia fija de elementos en posiciones consecutivas de memoria RAM. Su dirección base se calcula con el índice multiplicando por el tamaño en bytes del tipo de dato.'
									: 'An array stores elements in consecutive RAM locations. The address is derived from base_addr + index * element_size.'}
							</p>
						</div>
						<div class="ac-col">
							<div class="ac-card-box">
								<div class="ac-card-head">{isEs ? 'ESTRUCTURA DE CELDAS EN RAM' : 'RAM CELL STRUCTURE'}</div>
								<div class="ac-cell"><span>arr[0]</span><span class="ac-tag">Valor: 10 (0x1000)</span></div>
								<div class="ac-cell"><span>arr[1]</span><span class="ac-tag">Valor: 20 (0x1004)</span></div>
								<div class="ac-cell"><span>arr[2]</span><span class="ac-tag">Valor: 30 (0x1008)</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="ac-slide" data-slide="2">
					<div class="ac-slide-grid">
						<div class="ac-col">
							<h2 class="ac-slide-title">2. C: Arrays Fijos e Índices</h2>
							<p class="ac-text">En C el tamaño del arreglo es fijo en tiempo de compilación (salvo VLA/malloc). No hay chequeo de límites (out-of-bounds).</p>
						</div>
						<div class="ac-col">
							<div class="ac-code-card">
								<div class="ac-code-title">array.c</div>
								<pre class="ac-code-block"><code><span class="token-type">int</span> numeros[<span class="token-number">5</span>] = &#123;<span class="token-number">10</span>, <span class="token-number">20</span>, <span class="token-number">30</span>, <span class="token-number">40</span>, <span class="token-number">50</span>&#125;;
<span class="token-type">int</span> primer = numeros[<span class="token-number">0</span>]; <span class="token-comment">// 10</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="ac-slide" data-slide="3">
					<div class="ac-slide-grid">
						<div class="ac-col">
							<h2 class="ac-slide-title">3. Java: Arrays como Objetos (.length)</h2>
							<p class="ac-text">En Java los arrays son objetos en el Heap con una propiedad fija `.length` y lanzan `ArrayIndexOutOfBoundsException` si el índice es inválido.</p>
						</div>
						<div class="ac-col">
							<div class="ac-code-card">
								<div class="ac-code-title">ArrayTest.java</div>
								<pre class="ac-code-block"><code><span class="token-type">int</span>[] nums = <span class="token-keyword">new</span> <span class="token-type">int</span>[]&#123;<span class="token-number">1</span>, <span class="token-number">2</span>, <span class="token-number">3</span>&#125;;
System.out.println(nums.length); <span class="token-comment">// 3</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="ac-slide" data-slide="4">
					<div class="ac-slide-grid">
						<div class="ac-col">
							<h2 class="ac-slide-title">4. JavaScript: Arrays Dinámicos y Heterogéneos</h2>
							<p class="ac-text">JS ofrece arrays dinámicos que pueden cambiar de tamaño automáticamente y contener tipos mixtos.</p>
						</div>
						<div class="ac-col">
							<div class="ac-code-card">
								<div class="ac-code-title">array.js</div>
								<pre class="ac-code-block"><code><span class="token-keyword">const</span> lista = [<span class="token-number">10</span>, <span class="token-string">"Hola"</span>, <span class="token-keyword">true</span>];
lista.push(<span class="token-number">99</span>); <span class="token-comment">// Crecimiento dinámico</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="ac-slide" data-slide="5">
					<div class="ac-slide-grid">
						<div class="ac-col">
							<h2 class="ac-slide-title">5. Python: Listas y Slicing</h2>
							<p class="ac-text">Las listas en Python son arrays dinámicos de referencias a objetos y soportan slicing avanzado `list[start:stop:step]`.</p>
						</div>
						<div class="ac-col">
							<div class="ac-code-card">
								<div class="ac-code-title">lists.py</div>
								<pre class="ac-code-block"><code>nums = [<span class="token-number">10</span>, <span class="token-number">20</span>, <span class="token-number">30</span>, <span class="token-number">40</span>, <span class="token-number">50</span>]
sub = nums[<span class="token-number">1</span>:<span class="token-number">4</span>] <span class="token-comment"># [20, 30, 40]</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="ac-slide" data-slide="6">
					<div class="ac-sim-container">
						<h2 class="ac-slide-title center">{isEs ? '6. Inspector Interactivo de Arreglos' : '6. Array Inspector'}</h2>
						<p class="ac-sub center">{isEs ? 'Visualizá la búsqueda por índice:' : 'Visualize indexing by location:'}</p>

						<div class="ac-inspector-grid">
							<div class="ac-lang-box"><span class="ac-lang-name">Índice arr[0]</span><div class="ac-exp-res">Dirección Base ➔ 0x1000 ➔ Valor: 10</div></div>
							<div class="ac-lang-box"><span class="ac-lang-name">Índice arr[2]</span><div class="ac-exp-res">Dirección Base + (2 × 4 bytes) ➔ 0x1008 ➔ Valor: 30</div></div>
						</div>
					</div>
				</div>
			</div>

			<div class="ac-footer">
				<button class="btn btn-secondary" id="btn-prev-ac" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="ac-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-ac">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.ac-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.ac-shell { max-width: var(--container-max); margin: 0 auto; }
	.ac-header { margin-bottom: 1.5rem; }
	.ac-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.ac-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.ac-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.ac-sub.center { text-align: center; }
	.ac-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.ac-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.ac-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.ac-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.ac-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.ac-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.ac-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.ac-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.ac-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.ac-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.ac-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.ac-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.ac-col { grid-column: span 12; }
	@media (min-width: 900px) { .ac-col { grid-column: span 6; } }
	.ac-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.ac-slide-title.center { text-align: center; }
	.ac-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.ac-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.ac-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.ac-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.ac-tag { color: var(--color-accent-700); font-weight: 600; }
	.ac-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.ac-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.ac-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.ac-sim-container { max-width: 800px; margin: 0 auto; }
	.ac-inspector-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
	@media (max-width: 600px) { .ac-inspector-grid { grid-template-columns: repeat(1, minmax(0, 1fr)); } }
	.ac-lang-box { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.8rem; }
	.ac-lang-name { font-family: 'Fira Code', monospace; font-size: 0.75rem; font-weight: 700; color: #e59866; display: block; margin-bottom: 0.4rem; }
	.ac-exp-res { font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #f9f4ed; background: #141210; padding: 0.5rem 0.7rem; border-radius: var(--radius-sm); }
	.ac-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.ac-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.ac-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.ac-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('ac-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-ac') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-ac') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.ac-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-ac')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-ac')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	goToSlide(1);
</script>
