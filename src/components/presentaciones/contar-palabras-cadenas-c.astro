---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="cw-screen">
	<div class="cw-shell">
		<header class="cw-header">
			<span class="cw-badge">{isEs ? 'Tokenización' : 'Tokenization'}</span>
			<h1 class="cw-title">
				{isEs ? 'Conteo de Palabras en Cadenas' : 'Word Count in Strings'}
			</h1>
			<p class="cw-sub">
				{isEs 
					? 'Máquinas de estado, strtok, split() y tokenizadores en C, Java, JavaScript y Python.' 
					: 'State machines, strtok, split(), and tokenizers in C, Java, JS, and Python.'}
			</p>
		</header>

		<div class="cw-deck-card">
			<div class="cw-nav-bar">
				<div class="cw-slide-indicator">
					<span class="cw-step-dot"></span>
					<span id="cw-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="cw-pills">
					<button class="cw-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="cw-pill-btn" data-target-slide="2">2. C</button>
					<button class="cw-pill-btn" data-target-slide="3">3. Java</button>
					<button class="cw-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="cw-pill-btn" data-target-slide="5">5. Python</button>
					<button class="cw-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="cw-viewport">
				<div class="cw-slide active" data-slide="1">
					<div class="cw-slide-grid">
						<div class="cw-col">
							<h2 class="cw-slide-title">1. {isEs ? 'Estrategia de Tokenización' : 'Tokenization Strategy'}</h2>
							<p class="cw-text">
								{isEs 
									? 'Contar palabras requiere detectar transiciones entre espacios/delimitadores y caracteres imprimibles (Máquina de Estados).'
									: 'Word counting requires detecting transitions between spaces/delimiters and printable characters (Finite State Machine).'}
							</p>
						</div>
						<div class="cw-col">
							<div class="cw-card-box">
								<div class="cw-card-head">{isEs ? 'ESTADOS DE LA MÁQUINA' : 'MACHINE STATES'}</div>
								<div class="cw-cell"><span>OUT_WORD (Fuera de Palabra)</span><span class="cw-tag">En espacio / tab / \\n</span></div>
								<div class="cw-cell"><span>IN_WORD (Dentro de Palabra)</span><span class="cw-tag">Sumar +1 en transición</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="cw-slide" data-slide="2">
					<div class="cw-slide-grid">
						<div class="cw-col">
							<h2 class="cw-slide-title">2. C: Algoritmo con Máquina de Estados o strtok</h2>
							<p class="cw-text">En C se puede usar `strtok(str, " ")` o recorrer byte a byte con un flag `in_word`.</p>
						</div>
						<div class="cw-col">
							<div class="cw-code-card">
								<div class="cw-code-title">count_words.c</div>
								<pre class="cw-code-block"><code><span class="token-type">int</span> countWords(<span class="token-keyword">const</span> <span class="token-type">char</span> *s) &#123;
    <span class="token-type">int</span> count = <span class="token-number">0</span>, in_word = <span class="token-number">0</span>;
    <span class="token-keyword">while</span> (*s) &#123;
        <span class="token-keyword">if</span> (isspace(*s)) in_word = <span class="token-number">0</span>;
        <span class="token-keyword">else if</span> (!in_word) &#123; in_word = <span class="token-number">1</span>; count++; &#125;
        s++;
    &#125;
    <span class="token-keyword">return</span> count;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="sc-slide" data-slide="3">
					<div class="cw-slide-grid">
						<div class="cw-col">
							<h2 class="cw-slide-title">3. Java: split("\\s+")</h2>
							<p class="cw-text">Java utiliza expresiones regulares `\\s+` para dividir por cualquier secuencia de espacios blancos.</p>
						</div>
						<div class="cw-col">
							<div class="cw-code-card">
								<div class="cw-code-title">WordCount.java</div>
								<pre class="cw-code-block"><code>String text = <span class="token-string">"Hola  Mundo Java"</span>;
String[] words = text.trim().split(<span class="token-string">"\\s+"</span>);
<span class="token-type">int</span> total = words.length; <span class="token-comment">// 3</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="cw-slide" data-slide="4">
					<div class="cw-slide-grid">
						<div class="cw-col">
							<h2 class="cw-slide-title">4. JavaScript: split(/\\s+/) y filter(Boolean)</h2>
							<p class="cw-text">JS combina `split` con `filter(Boolean)` para eliminar tokens vacíos causados por espacios múltiples.</p>
						</div>
						<div class="cw-col">
							<div class="cw-code-card">
								<div class="cw-code-title">count.js</div>
								<pre class="cw-code-block"><code><span class="token-keyword">const</span> text = <span class="token-string">"  Hola  JS  "</span>;
<span class="token-keyword">const</span> words = text.trim().split(/\s+/).filter(Boolean);
console.log(words.length); <span class="token-comment">// 2</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="cw-slide" data-slide="5">
					<div class="cw-slide-grid">
						<div class="cw-col">
							<h2 class="cw-slide-title">5. Python: len(text.split())</h2>
							<p class="cw-text">En Python `text.split()` sin argumentos elimina automáticamente espacios continuos en los extremos e intermedios.</p>
						</div>
						<div class="cw-col">
							<div class="cw-code-card">
								<div class="cw-code-title">count.py</div>
								<pre class="cw-code-block"><code>text = <span class="token-string">"  Hola   Python  "</span>
words = text.split()
count = len(words) <span class="token-comment"># 2</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="cw-slide" data-slide="6">
					<div class="cw-sim-container">
						<h2 class="cw-slide-title center">{isEs ? '6. Inspector de Tokenización' : '6. Tokenization Inspector'}</h2>
						<div class="cw-inspector-grid">
							<div class="cw-lang-box"><span class="cw-lang-name">Entrada: "  Hola   Mundo  "</span><div class="cw-exp-res">C (in_word): 2 palabras | Java: 2 tokens | JS: 2 tokens | Python: ['Hola', 'Mundo'] (len=2)</div></div>
						</div>
					</div>
				</div>
			</div>

			<div class="cw-footer">
				<button class="btn btn-secondary" id="btn-prev-cw" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="cw-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-cw">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.cw-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.cw-shell { max-width: var(--container-max); margin: 0 auto; }
	.cw-header { margin-bottom: 1.5rem; }
	.cw-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.cw-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.cw-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.cw-sub.center { text-align: center; }
	.cw-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.cw-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.cw-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.cw-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.cw-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.cw-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.cw-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.cw-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.cw-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.cw-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.cw-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.cw-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.cw-col { grid-column: span 12; }
	@media (min-width: 900px) { .cw-col { grid-column: span 6; } }
	.cw-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.cw-slide-title.center { text-align: center; }
	.cw-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.cw-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.cw-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.cw-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.cw-tag { color: var(--color-accent-700); font-weight: 600; }
	.cw-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.cw-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.cw-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.cw-sim-container { max-width: 800px; margin: 0 auto; }
	.cw-inspector-grid { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 0.8rem; }
	.cw-lang-box { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.8rem; }
	.cw-lang-name { font-family: 'Fira Code', monospace; font-size: 0.75rem; font-weight: 700; color: #e59866; display: block; margin-bottom: 0.4rem; }
	.cw-exp-res { font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #f9f4ed; background: #141210; padding: 0.5rem 0.7rem; border-radius: var(--radius-sm); }
	.cw-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.cw-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.cw-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.cw-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('cw-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-cw') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-cw') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.cw-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-cw')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-cw')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	goToSlide(1);
</script>
