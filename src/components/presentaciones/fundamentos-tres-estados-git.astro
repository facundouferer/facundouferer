	function updateSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;
		slides.forEach((s) => s.classList.remove('is-active'));
		document.querySelector(`.gt-slide[data-slide="${currentSlide}"]`)?.classList.add('is-active');

		if (counter) counter.textContent = `${currentSlide} / ${totalSlides}`;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	prevBtn?.addEventListener('click', () => updateSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => updateSlide(currentSlide + 1));

	window.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') updateSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') updateSlide(currentSlide - 1);
	});

	// Slide 1: Model toggle
	const modelToggle = document.getElementById('gtModelToggle');
	const manualChaos = document.getElementById('gtManualChaos');
	const gitModel = document.getElementById('gtGitModel');
	let isGitView = false;

	modelToggle?.addEventListener('click', () => {
		isGitView = !isGitView;
		if (manualChaos) manualChaos.hidden = isGitView;
		if (gitModel) gitModel.hidden = !isGitView;
		if (modelToggle) {
			modelToggle.textContent = isGitView
				? (pageLang === 'es' ? 'Ver copias arcaicas' : 'View manual copies')
				: (pageLang === 'es' ? 'Ver modelo Git' : 'View Git model');
		}
	});

	// Slide 2: Three-State simulator
	const btnModify = document.getElementById('gtBtnModify') as HTMLButtonElement;
	const btnAdd = document.getElementById('gtBtnAdd') as HTMLButtonElement;
	const btnCommit = document.getElementById('gtBtnCommit') as HTMLButtonElement;
	const btnReset = document.getElementById('gtBtnReset') as HTMLButtonElement;

	const badgeWorking = document.getElementById('gtBadgeWorking');
	const descWorking = document.getElementById('gtDescWorking');
	const stagingPlaceholder = document.getElementById('gtStagingPlaceholder');
	const fileStaging = document.getElementById('gtFileStaging');
	const commitHashDisplay = document.getElementById('gtCommitHashDisplay');
	const repoDesc = document.getElementById('gtRepoDesc');
	const feedbackText = document.getElementById('gtFeedbackText');

	let state = 'clean'; // 'clean' -> 'modified' -> 'staged' -> 'committed'

	btnModify?.addEventListener('click', () => {
		state = 'modified';
		if (badgeWorking) {
			badgeWorking.textContent = pageLang === 'es' ? 'Modificado' : 'Modified';
			badgeWorking.className = 'gt-badge is-danger';
		}
		if (descWorking) {
			descWorking.textContent = pageLang === 'es' ? 'Cambios sin indexar en disco.' : 'Unstaged changes on disk.';
		}
		btnModify.disabled = true;
		if (btnAdd) btnAdd.disabled = false;
		if (feedbackText) {
			feedbackText.textContent = pageLang === 'es'
				? 'Archivo modificado en el Working Tree. Ejecuta "git add index.html" para pasarlo al Staging Area.'
				: 'File modified in Working Tree. Run "git add index.html" to stage it.';
		}
	});

	btnAdd?.addEventListener('click', () => {
		state = 'staged';
		if (stagingPlaceholder) stagingPlaceholder.hidden = true;
		if (fileStaging) fileStaging.hidden = false;
		if (btnAdd) btnAdd.disabled = true;
		if (btnCommit) btnCommit.disabled = false;
		if (feedbackText) {
			feedbackText.textContent = pageLang === 'es'
				? 'Archivo indexado en Staging Area (preparado). Ejecuta "git commit" para sellar el snapshot.'
				: 'File staged in index. Run "git commit" to seal the snapshot.';
		}
	});

	btnCommit?.addEventListener('click', () => {
		state = 'committed';
		if (badgeWorking) {
			badgeWorking.textContent = pageLang === 'es' ? 'Limpio' : 'Clean';
			badgeWorking.className = 'gt-badge';
		}
		if (descWorking) {
			descWorking.textContent = pageLang === 'es' ? 'Sin cambios pendientes.' : 'No pending changes.';
		}
		if (stagingPlaceholder) stagingPlaceholder.hidden = false;
		if (fileStaging) fileStaging.hidden = true;
		if (commitHashDisplay) commitHashDisplay.textContent = 'Commit e719b4';
		if (repoDesc) {
			repoDesc.textContent = pageLang === 'es'
				? 'Snapshot inmutable registrado por Facundo.'
				: 'Immutable snapshot recorded by Facundo.';
		}
		if (btnCommit) btnCommit.disabled = true;
		if (btnModify) btnModify.disabled = false;
		if (feedbackText) {
			feedbackText.textContent = pageLang === 'es'
				? '¡Snapshot completado! El archivo se guardó inmutablemente en el historial (.git).'
				: 'Snapshot completed! File is permanently recorded in repository history (.git).';
		}
	});

	btnReset?.addEventListener('click', () => {
		state = 'clean';
		if (badgeWorking) {
			badgeWorking.textContent = pageLang === 'es' ? 'Limpio' : 'Clean';
			badgeWorking.className = 'gt-badge';
		}
		if (descWorking) descWorking.textContent = pageLang === 'es' ? 'Sin cambios pendientes.' : 'No pending changes.';
		if (stagingPlaceholder) stagingPlaceholder.hidden = false;
		if (fileStaging) fileStaging.hidden = true;
		if (btnModify) btnModify.disabled = false;
		if (btnAdd) btnAdd.disabled = true;
		if (btnCommit) btnCommit.disabled = true;
		if (feedbackText) {
			feedbackText.textContent = pageLang === 'es' ? 'Simulador reiniciado a estado limpio.' : 'Simulator reset to clean state.';
		}
	});

	// Slide 3: Commit Inspector
	const inspectBtns = document.querySelectorAll<HTMLButtonElement>('.gt-commit-btn');
	const inspectSha = document.getElementById('gtInspectSha');
	const inspectTree = document.getElementById('gtInspectTree');
	const inspectParent = document.getElementById('gtInspectParent');
	const inspectMsg = document.getElementById('gtInspectMsg');

	const commitsData: Record<string, { sha: string; tree: string; parent: string; msg: string }> = {
		c1: {
			sha: '4b71e09c12a78f3d4b6890123456789abcdef10',
			tree: 'tree 87e1a3b (src/, index.html, styles.css)',
			parent: 'parent 1c028ea (initial commit)',
			msg: 'feat: add header navigation and semantic landmarks',
		},
		c2: {
			sha: '9a23f81e6b829c4d5e6f7a8b9c0d1e2f3a4b5c6d',
			tree: 'tree f902c4e (src/styles/global.css)',
			parent: 'parent 4b71e09 (feat: add header navigation)',
			msg: 'fix: responsive layout spacing on mobile screens',
		},
	};

	inspectBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			const id = btn.getAttribute('data-inspect') || 'c1';
			inspectBtns.forEach((b) => b.classList.remove('is-active'));
			btn.classList.add('is-active');

			const data = commitsData[id];
			if (data) {
				if (inspectSha) inspectSha.textContent = data.sha;
				if (inspectTree) inspectTree.textContent = data.tree;
				if (inspectParent) inspectParent.textContent = data.parent;
				if (inspectMsg) inspectMsg.textContent = data.msg;
			}
		});
	});

	// Slide 4: HEAD and branches
	const btnNewCommit = document.getElementById('gtBtnNewCommit');
	const btnSwitchBranch = document.getElementById('gtBtnSwitchBranch');
	const headRefText = document.getElementById('gtHeadRefText');
	const featureRow = document.getElementById('gtFeatureRow');
	const headStatusText = document.getElementById('gtHeadStatusText');
	let branchActive = 'main';
	let mainCommits = 2;

	btnNewCommit?.addEventListener('click', () => {
		mainCommits++;
		if (headStatusText) {
			headStatusText.textContent = pageLang === 'es'
				? `Nuevo commit C${mainCommits} creado. La rama ${branchActive} y HEAD avanzaron juntos.`
				: `New commit C${mainCommits} created. Branch ${branchActive} and HEAD advanced together.`;
		}
	});

	btnSwitchBranch?.addEventListener('click', () => {
		branchActive = branchActive === 'main' ? 'feature' : 'main';
		if (featureRow) featureRow.hidden = false;
		if (headRefText) headRefText.textContent = `refs/heads/${branchActive}`;
		if (headStatusText) {
			headStatusText.textContent = pageLang === 'es'
				? `HEAD ahora apunta a la rama "${branchActive}". Los próximos commits pertenecerán a esta rama.`
				: `HEAD now points to branch "${branchActive}". Next commits will belong to this branch.`;
		}
	});

	// Slide 5: Terminal switch
	const termBtns = document.querySelectorAll<HTMLButtonElement>('.gt-term-btn');
	const terminalOutput = document.getElementById('gtTerminalOutput');

	const termContent: Record<string, string> = {
		status: `<span class="gt-tc-green">On branch main</span>\nYour branch is up to date with 'origin/main'.\n\n<span class="gt-tc-bold">Changes to be committed:</span>\n  (use "git restore --staged &lt;file&gt;..." to unstage)\n\t<span class="gt-tc-green">new file:   src/components/Navbar.astro</span>\n\n<span class="gt-tc-bold">Changes not staged for commit:</span>\n  (use "git add &lt;file&gt;..." to update what will be committed)\n\t<span class="gt-tc-red">modified:   src/pages/index.astro</span>\n\n<span class="gt-tc-bold">Untracked files:</span>\n  (use "git add &lt;file&gt;..." to include in what will be committed)\n\t<span class="gt-tc-red">temp-notes.txt</span>`,
		log: `<span class="gt-tc-green">* 3d8b12c</span> (HEAD -> main, origin/main) fix: responsive layout spacing\n<span class="gt-tc-green">* 8e40f1a</span> feat: add navbar navigation\n<span class="gt-tc-green">* c1a93b2</span> feat: initial project scaffolding\n\n<span class="gt-tc-bold">3 commits in history · Directed DAG</span>`,
	};

	termBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			const cmd = btn.getAttribute('data-cmd') || 'status';
			termBtns.forEach((b) => b.classList.remove('is-active'));
			btn.classList.add('is-active');
			if (terminalOutput) {
				terminalOutput.innerHTML = `<code>${termContent[cmd]}</code>`;
			}
		});
	});
</script>
