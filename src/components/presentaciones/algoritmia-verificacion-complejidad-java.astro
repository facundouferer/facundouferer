	@media (min-width: 1440px) { .av-viewport { zoom: 1.08; } }
	@media (min-width: 1680px) { .av-viewport { zoom: 1.16; } }
	@media (min-width: 1920px) { .av-viewport { zoom: 1.25; } }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 5;

	const screenEl = document.querySelector('.av-screen');
	const pageLang = screenEl?.getAttribute('data-lang') === 'en' ? 'en' : 'es';
	const locale = pageLang === 'es' ? 'es-AR' : 'en-US';

	const prevBtn = document.getElementById('avPrevBtn') as HTMLButtonElement;
	const nextBtn = document.getElementById('avNextBtn') as HTMLButtonElement;
	const counter = document.getElementById('avSlideCounter') as HTMLElement;
	const slides = document.querySelectorAll<HTMLElement>('.av-slide');

	function updateSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;
		slides.forEach((s) => s.classList.remove('is-active'));
		document.querySelector(`.av-slide[data-slide="${currentSlide}"]`)?.classList.add('is-active');

		if (counter) counter.textContent = `${currentSlide} / ${totalSlides}`;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	prevBtn?.addEventListener('click', () => updateSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => updateSlide(currentSlide + 1));

	window.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') updateSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') updateSlide(currentSlide - 1);
	});

	// Slide 1: Hoare triple simulator
	const gateP = document.getElementById('avGateP');
	const gateQ = document.getElementById('avGateQ');
	const chamberC = document.getElementById('avChamberC');
	const gatePIcon = document.getElementById('avGatePIcon');
	const gateQIcon = document.getElementById('avGateQIcon');
	const gatePStatus = document.getElementById('avGatePStatus');
	const gateQStatus = document.getElementById('avGateQStatus');
	const chamberStatus = document.getElementById('avChamberStatus');
	const hoareResult = document.getElementById('avHoareResult');
	const testValidBtn = document.getElementById('avTestValidBtn');
	const testInvalidBtn = document.getElementById('avTestInvalidBtn');

	const ICON_CHECK = '<circle cx="12" cy="12" r="10" /><path d="m9 12 2 2 4-4" />';
	const ICON_X = '<circle cx="12" cy="12" r="10" /><path d="m15 9-6 6" /><path d="m9 9 6 6" />';
	const ICON_NEUTRAL = '<circle cx="12" cy="12" r="10" stroke-dasharray="4 3" />';

	function runHoareTest(valid: boolean) {
		gateP?.classList.remove('is-valid', 'is-blocked');
		gateQ?.classList.remove('is-valid', 'is-blocked');
		chamberC?.classList.remove('is-running', 'is-skipped');

		if (valid) {
			gateP?.classList.add('is-valid');
			if (gatePIcon) gatePIcon.innerHTML = ICON_CHECK;
			if (gatePStatus) {
				gatePStatus.textContent = pageLang === 'es'
					? '✓ Se cumple: [4, 9, 2, 7] no es null ni vacío'
					: '✓ Holds: [4, 9, 2, 7] is neither null nor empty';
			}

			chamberC?.classList.add('is-running');
			if (chamberStatus) {
				chamberStatus.textContent = pageLang === 'es'
					? 'Ejecutado: recorre el array comparando cada valor'
					: 'Executed: scans the array comparing each value';
			}

			gateQ?.classList.add('is-valid');
			if (gateQIcon) gateQIcon.innerHTML = ICON_CHECK;
			if (gateQStatus) {
				gateQStatus.textContent = pageLang === 'es'
					? '✓ Se cumple: 9 ≥ todos los demás valores'
					: '✓ Holds: 9 ≥ every other value';
			}

			if (hoareResult) {
				hoareResult.innerHTML = `
					<span class="av-code-sample">maximoActual == 9</span>
					<span class="av-tag-ok">${pageLang === 'es' ? '✓ Postcondición Q verificada' : '✓ Postcondition Q verified'}</span>
				`;
			}
		} else {
			gateP?.classList.add('is-blocked');
			if (gatePIcon) gatePIcon.innerHTML = ICON_X;
			if (gatePStatus) {
				gatePStatus.textContent = pageLang === 'es'
					? '✗ No se cumple: el array está vacío'
					: '✗ Fails: the array is empty';
			}

			chamberC?.classList.add('is-skipped');
			if (chamberStatus) {
				chamberStatus.textContent = pageLang === 'es'
					? 'Nunca se ejecuta: la compuerta P se cerró antes'
					: 'Never runs: gate P closed beforehand';
			}

			if (gateQIcon) gateQIcon.innerHTML = ICON_NEUTRAL;
			if (gateQStatus) {
				gateQStatus.textContent = pageLang === 'es'
					? 'No evaluada: C nunca corrió'
					: 'Not evaluated: C never ran';
			}

			if (hoareResult) {
				hoareResult.innerHTML = `
					<span class="av-code-sample">IllegalArgumentException</span>
					<span class="av-tag-err">${pageLang === 'es' ? '✗ valores debe contener al menos un elemento' : '✗ valores must contain at least one element'}</span>
				`;
			}
		}
	}

	testValidBtn?.addEventListener('click', () => runHoareTest(true));
	testInvalidBtn?.addEventListener('click', () => runHoareTest(false));

	// Slide 2: Loop invariant stepper
	const arrayValues = [4, 9, 2, 7, 5, 1, 8, 3];
	const invariantN = arrayValues.length;
	let invariantI = 0;
	let runningMax: number | null = null;

	const invariantCells = document.querySelectorAll<HTMLElement>('#avArrayViz .av-cell');
	const advanceBtn = document.getElementById('avAdvanceBtn') as HTMLButtonElement;
	const resetInvariantBtn = document.getElementById('avResetInvariantBtn');
	const invariantReadout = document.getElementById('avInvariantReadout');
	const invariantStatus = document.getElementById('avInvariantStatus');

	function renderInvariant() {
		invariantCells.forEach((cell, idx) => {
			cell.classList.remove('is-processed', 'is-active', 'is-pending');
			if (idx < invariantI) cell.classList.add('is-processed');
			else if (idx === invariantI && invariantI < invariantN) cell.classList.add('is-active');
			else cell.classList.add('is-pending');
		});

		if (advanceBtn) advanceBtn.disabled = invariantI >= invariantN;

		if (invariantReadout) {
			invariantReadout.textContent = `i = ${invariantI} · maximoActual = ${runningMax === null ? '—' : runningMax}`;
		}

		if (invariantStatus) {
			if (invariantI === 0) {
				invariantStatus.textContent = pageLang === 'es'
					? 'Antes de empezar: el segmento [0..-1] está vacío, el invariante se cumple trivialmente.'
					: 'Before starting: segment [0..-1] is empty, the invariant holds trivially.';
			} else if (invariantI < invariantN) {
				invariantStatus.textContent = pageLang === 'es'
					? `Tras ${invariantI} iteración(es): valores[0..${invariantI - 1}] ya fue recorrido. maximoActual = ${runningMax} sigue siendo el máximo de ese segmento.`
					: `After ${invariantI} iteration(s): valores[0..${invariantI - 1}] has been scanned. maximoActual = ${runningMax} remains the maximum of that segment.`;
			} else {
				invariantStatus.textContent = pageLang === 'es'
					? `✓ Bucle terminado: el segmento cubre todo el arreglo. La postcondición se cumple: maximoActual = ${runningMax} es el máximo global.`
					: `✓ Loop finished: the segment covers the whole array. The postcondition holds: maximoActual = ${runningMax} is the global maximum.`;
			}
		}
	}

	advanceBtn?.addEventListener('click', () => {
		if (invariantI >= invariantN) return;
		const value = arrayValues[invariantI];
		runningMax = runningMax === null ? value : Math.max(runningMax, value);
		invariantI++;
		renderInvariant();
	});

	resetInvariantBtn?.addEventListener('click', () => {
		invariantI = 0;
		runningMax = null;
		renderInvariant();
	});

	renderInvariant();

	// Slide 3: Bound function stepper
	const boundN = 8;
	let boundI = 0;

	const boundIEl = document.getElementById('avBoundI');
	const boundVEl = document.getElementById('avBoundV');
	const boundFill = document.getElementById('avBoundFill');
	const boundStepBtn = document.getElementById('avBoundStepBtn') as HTMLButtonElement;
	const boundResetBtn = document.getElementById('avBoundResetBtn');
	const boundStatus = document.getElementById('avBoundStatus');

	function renderBound() {
		const v = boundN - boundI;
		if (boundIEl) boundIEl.textContent = String(boundI);
		if (boundVEl) boundVEl.textContent = String(v);
		if (boundFill) boundFill.style.width = `${(v / boundN) * 100}%`;
		if (boundStepBtn) boundStepBtn.disabled = v <= 0;

		if (boundStatus) {
			if (v > 0) {
				boundStatus.textContent = pageLang === 'es'
					? `V = ${v}. Función cota positiva: todavía quedan ${v} iteración(es) antes de llegar a 0.`
					: `V = ${v}. Positive bound function: ${v} iteration(s) remain before reaching 0.`;
				boundStatus.classList.remove('is-done');
			} else {
				boundStatus.textContent = pageLang === 'es'
					? '✓ V llegó a 0: el bucle se detiene físicamente. Terminación garantizada, sin loops infinitos.'
					: '✓ V reached 0: the loop stops physically. Termination is guaranteed, no infinite loops.';
				boundStatus.classList.add('is-done');
			}
		}
	}

	boundStepBtn?.addEventListener('click', () => {
		if (boundN - boundI <= 0) return;
		boundI++;
		renderBound();
	});

	boundResetBtn?.addEventListener('click', () => {
		boundI = 0;
		renderBound();
	});

	renderBound();

	// Slide 4: Big-O interactive chart
	const nSteps = [10, 100, 1000, 10000, 100000, 1000000];
	const markerPositions = [60, 164, 268, 372, 476, 580];

	const nSlider = document.getElementById('avNSlider') as HTMLInputElement;
	const nValueLabel = document.getElementById('avNValue');
	const chartMarker = document.getElementById('avChartMarker');
	const opsConst = document.getElementById('avOpsConst');
	const opsLog = document.getElementById('avOpsLog');
	const opsLinear = document.getElementById('avOpsLinear');
	const opsLinLog = document.getElementById('avOpsLinLog');
	const opsQuad = document.getElementById('avOpsQuad');
	const opsExp = document.getElementById('avOpsExp');

	function formatOps(value: number): string {
		if (!Number.isFinite(value)) {
			return pageLang === 'es' ? 'Inviable (crecimiento no computable)' : 'Infeasible (uncomputable growth)';
		}
		if (value >= 1e15) {
			return value.toExponential(2).replace('e+', 'e');
		}
		return Math.round(value).toLocaleString(locale);
	}

	function renderChart() {
		const stepIndex = Number(nSlider.value);
		const n = nSteps[stepIndex];

		if (nValueLabel) nValueLabel.textContent = `N = ${n.toLocaleString(locale)}`;
		if (chartMarker) {
			const x = String(markerPositions[stepIndex]);
			chartMarker.setAttribute('x1', x);
			chartMarker.setAttribute('x2', x);
		}

		const logN = Math.ceil(Math.log2(n));
		if (opsConst) opsConst.textContent = formatOps(1);
		if (opsLog) opsLog.textContent = formatOps(logN);
		if (opsLinear) opsLinear.textContent = formatOps(n);
		if (opsLinLog) opsLinLog.textContent = formatOps(n * logN);
		if (opsQuad) opsQuad.textContent = formatOps(n * n);
		if (opsExp) opsExp.textContent = formatOps(Math.pow(2, n));
	}

	nSlider?.addEventListener('input', renderChart);
	renderChart();

	// Slide 5: Best / average / worst case search
	type CaseScenario = 'best' | 'avg' | 'worst';

	const caseCells = document.querySelectorAll<HTMLElement>('#avCaseArray .av-cell');
	const caseBestBtn = document.getElementById('avCaseBestBtn');
	const caseAvgBtn = document.getElementById('avCaseAvgBtn');
	const caseWorstBtn = document.getElementById('avCaseWorstBtn');
	const caseTargetValue = document.getElementById('avCaseTargetValue');
	const caseStatus = document.getElementById('avCaseStatus');
	const caseBadge = document.getElementById('avCaseBadge');

	const caseScenarios: Record<CaseScenario, { target: number; scanned: number; foundIndex: number | null }> = {
		best: { target: 12, scanned: 1, foundIndex: 0 },
		avg: { target: 34, scanned: 5, foundIndex: 4 },
		worst: { target: 99, scanned: 9, foundIndex: null },
	};

	function renderCase(scenario: CaseScenario) {
		const data = caseScenarios[scenario];

		[caseBestBtn, caseAvgBtn, caseWorstBtn].forEach((btn) => btn?.classList.remove('is-active'));
		const activeBtn = scenario === 'best' ? caseBestBtn : scenario === 'avg' ? caseAvgBtn : caseWorstBtn;
		activeBtn?.classList.add('is-active');

		if (caseTargetValue) caseTargetValue.textContent = String(data.target);

		caseCells.forEach((cell, idx) => {
			cell.classList.remove('is-scanned', 'is-found');
			if (idx < data.scanned) cell.classList.add('is-scanned');
			if (data.foundIndex !== null && idx === data.foundIndex) cell.classList.add('is-found');
		});

		if (caseStatus) {
			if (data.foundIndex !== null) {
				caseStatus.textContent = pageLang === 'es'
					? `${data.scanned} comparación(es): el valor está en el índice ${data.foundIndex}.`
					: `${data.scanned} comparison(s): the value is at index ${data.foundIndex}.`;
			} else {
				caseStatus.textContent = pageLang === 'es'
					? `${data.scanned} comparaciones: se recorrió todo el arreglo y el valor no está.`
					: `${data.scanned} comparisons: the whole array was scanned and the value is absent.`;
			}
		}

		if (caseBadge) {
			caseBadge.textContent = scenario === 'best' ? 'O(1)' : scenario === 'avg' ? 'O(N/2) ≈ O(N)' : 'O(N)';
		}
	}

	caseBestBtn?.addEventListener('click', () => renderCase('best'));
	caseAvgBtn?.addEventListener('click', () => renderCase('avg'));
	caseWorstBtn?.addEventListener('click', () => renderCase('worst'));

	renderCase('best');
</script>
