		background: var(--color-bg);
		border-radius: var(--radius-md);
		padding: var(--space-3);
	}

	.av-case-status {
		font-size: var(--text-xs);
		color: var(--color-text);
	}

	.av-case-badge {
		font-family: monospace;
		font-weight: 700;
		font-size: var(--text-xs);
