		border-bottom: 1px solid var(--color-divider);
	}

	.dj-cursor-table th {
		font-size: 10px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-neutral-700);
	}

	.dj-cursor-row {
		font-family: monospace;
		transition: background 0.2s ease;
	}

	.dj-cursor-row.is-current {
		background: color-mix(in srgb, var(--color-accent) 16%, transparent);
		font-weight: 700;
	}

	.dj-cursor-panel {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.dj-cursor-status {
		font-family: monospace;
		font-size: 13px;
		font-weight: 700;
		color: var(--color-accent-700);
		background: var(--color-bg);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-md);
		padding: var(--space-3);
	}

	.dj-cursor-controls {
		display: flex;
		gap: var(--space-2);
	}

	/* Slide 4: ACID transactions */
	.dj-tx-accounts {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: var(--space-3);
		margin-bottom: var(--space-4);
	}

	@media (max-width: 768px) {
		.dj-tx-accounts {
			grid-template-columns: 1fr;
		}
	}

	.dj-tx-account {
		background: var(--color-bg);
		border: 2px solid var(--color-divider);
		border-radius: var(--radius-md);
		padding: var(--space-4);
		display: flex;
		flex-direction: column;
		gap: 4px;
		transition: all 0.25s ease;
	}

	.dj-tx-account.is-pending {
		border-color: var(--color-accent);
		background: color-mix(in srgb, var(--color-accent) 10%, transparent);
	}

	.dj-tx-account.is-reverted {
		border-color: var(--color-neutral-500);
	}

	.dj-tx-account.is-committed-new {
		border-color: var(--color-accent-2);
		background: color-mix(in srgb, var(--color-accent-2) 12%, transparent);
	}

	.dj-tx-account-label {
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-neutral-700);
	}

	.dj-tx-account-balance {
		font-family: monospace;
		font-size: 24px;
		color: var(--color-text);
	}

	.dj-tx-account-state {
