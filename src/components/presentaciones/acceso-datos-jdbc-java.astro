	}

	.dj-tx-controls {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	/* Slide 5: Pools and DAO */
	.dj-pool-split {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: var(--space-5, var(--space-4));
	}

	@media (max-width: 768px) {
		.dj-pool-split {
			grid-template-columns: 1fr;
		}
	}

	.dj-pool-controls {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.dj-toggle-wrap {
		background: var(--color-bg);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-md);
		padding: var(--space-3);
	}

	.dj-toggle-label {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		font-size: 13px;
		font-weight: 600;
		cursor: pointer;
	}

	.dj-perf-panel {
		background: var(--color-bg);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-md);
		padding: var(--space-3);
	}

	.dj-perf-heading {
		display: block;
		font-size: 11px;
		color: var(--color-neutral-700);
		margin-bottom: var(--space-2);
	}

	.dj-bar-track {
		height: 12px;
		background: var(--color-surface);
		border-radius: 999px;
		overflow: hidden;
		margin-bottom: var(--space-2);
		border: 1px solid var(--color-divider);
	}

	.dj-bar-fill {
		height: 100%;
		border-radius: 999px;
		transition: width 0.4s ease, background 0.4s ease;
	}

	.dj-bar-fast {
		background: var(--color-accent-2);
	}

	.dj-bar-slow {
		background: var(--color-accent);
	}

	.dj-perf-stats {
		display: flex;
		justify-content: space-between;
		font-size: 11px;
	}

	.dj-dao-viz {
		background: var(--color-bg);
		border-radius: var(--radius-md);
		padding: var(--space-3);
		display: flex;
		justify-content: center;
	}

	.dj-svg-dao {
		width: 100%;
		max-height: 220px;
	}

	.dj-dao-box {
		fill: color-mix(in srgb, var(--color-accent) 10%, transparent);
		stroke: var(--color-accent);
		stroke-width: 2;
	}

	.dj-dao-domain-box {
		fill: color-mix(in srgb, var(--color-accent-2) 14%, transparent);
		stroke: var(--color-accent-2);
		stroke-width: 2;
	}

	.dj-dao-title {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: 13px;
		fill: var(--color-text);
	}

	.dj-dao-method {
		font-family: monospace;
		font-size: 9.5px;
		fill: var(--color-neutral-800);
	}

	.dj-dao-note {
		font-family: var(--font-body);
		font-size: 9px;
		font-style: italic;
		fill: var(--color-accent-700);
	}

	@media (min-width: 1440px) { .dj-viewport { zoom: 1.08; } }
	@media (min-width: 1680px) { .dj-viewport { zoom: 1.16; } }
	@media (min-width: 1920px) { .dj-viewport { zoom: 1.25; } }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 5;

	const prevBtn = document.getElementById('djPrevBtn') as HTMLButtonElement;
	const nextBtn = document.getElementById('djNextBtn') as HTMLButtonElement;
	const counter = document.getElementById('djSlideCounter') as HTMLElement;
	const slides = document.querySelectorAll<HTMLElement>('.dj-slide');

	function updateSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;
		slides.forEach((s) => s.classList.remove('is-active'));
		document.querySelector(`.dj-slide[data-slide="${currentSlide}"]`)?.classList.add('is-active');

		if (counter) counter.textContent = `${currentSlide} / ${totalSlides}`;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	prevBtn?.addEventListener('click', () => updateSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => updateSlide(currentSlide + 1));

	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') updateSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') updateSlide(currentSlide - 1);
	});

	// Slide 1: Driver / engine selector
	const driverConfig: Record<string, { url: string; box: string }> = {
		pg: { url: 'jdbc:postgresql://localhost:5432/tienda', box: 'djDriverPgBox' },
		mysql: { url: 'jdbc:mysql://localhost:3306/tienda', box: 'djDriverMysqlBox' },
		h2: { url: 'jdbc:h2:mem:tienda;DB_CLOSE_DELAY=-1', box: 'djDriverH2Box' },
	};
	const driverButtons = document.querySelectorAll<HTMLButtonElement>('.dj-driver-buttons .dj-tab');
	const driverUrl = document.getElementById('djDriverUrl');
	const driverBoxes = document.querySelectorAll<SVGGElement>('.dj-driver-box');

	driverButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const driver = btn.dataset.driver ?? 'pg';
			const config = driverConfig[driver];
			if (!config) return;
			driverButtons.forEach((b) => b.classList.remove('is-active'));
			btn.classList.add('is-active');
			driverBoxes.forEach((box) => box.classList.remove('is-active'));
			document.getElementById(config.box)?.classList.add('is-active');
			if (driverUrl) driverUrl.textContent = config.url;
		});
	});

	// Slide 2: SQL injection console
	type PayloadResult = { statementQuery: string; statementResult: string; preparedQuery: string; preparedResult: string };
	const payloads: Record<string, PayloadResult> = {
		injection: {
			statementQuery: `SELECT * FROM usuarios WHERE email = '' OR '1'='1'`,
			statementResult: `<span class="dj-tag-err">⚠ TODOS los usuarios (fuga total)</span>`,
			preparedQuery: `SELECT * FROM usuarios WHERE email = ?  →  "' OR '1'='1"`,
			preparedResult: `<span class="dj-tag-ok">✓ 0 filas — busca ese email literal</span>`,
		},
		comment: {
			statementQuery: `SELECT * FROM usuarios WHERE email = 'admin'--'`,
			statementResult: `<span class="dj-tag-err">⚠ 'admin' autenticado, resto del SQL comentado</span>`,
			preparedQuery: `SELECT * FROM usuarios WHERE email = ?  →  "admin'--"`,
			preparedResult: `<span class="dj-tag-ok">✓ 0 filas — ningún email es literalmente ese texto</span>`,
		},
		normal: {
			statementQuery: `SELECT * FROM usuarios WHERE email = 'facundo@mail.com'`,
			statementResult: `<span class="dj-tag-ok">✓ 1 fila</span>`,
			preparedQuery: `SELECT * FROM usuarios WHERE email = ?  →  "facundo@mail.com"`,
			preparedResult: `<span class="dj-tag-ok">✓ 1 fila</span>`,
		},
	};
	const payloadButtons = document.querySelectorAll<HTMLButtonElement>('.dj-payload-buttons .dj-tab');
	const statementQueryEl = document.getElementById('djStatementQuery');
	const statementResultEl = document.getElementById('djStatementResult');
	const preparedQueryEl = document.getElementById('djPreparedQuery');
	const preparedResultEl = document.getElementById('djPreparedResult');

	payloadButtons.forEach((btn) => {
		btn.addEventListener('click', () => {
			const key = btn.dataset.payload ?? 'normal';
			const data = payloads[key];
			if (!data) return;
			payloadButtons.forEach((b) => b.classList.remove('is-active'));
			btn.classList.add('is-active');
			if (statementQueryEl) statementQueryEl.textContent = data.statementQuery;
			if (statementResultEl) statementResultEl.innerHTML = data.statementResult;
			if (preparedQueryEl) preparedQueryEl.textContent = data.preparedQuery;
			if (preparedResultEl) preparedResultEl.innerHTML = data.preparedResult;
		});
	});

	// Slide 3: ResultSet cursor stepper
	const cursorRows = [
		{ id: 'djRow1', dbId: 1, nombre: 'Teclado', precio: 45.0 },
		{ id: 'djRow2', dbId: 2, nombre: 'Mouse', precio: 20.0 },
		{ id: 'djRow3', dbId: 3, nombre: 'Monitor', precio: 220.0 },
	];
	let cursorPos = 0;
	const cursorStatus = document.getElementById('djCursorStatus');
	const cursorCode = document.getElementById('djCursorCode');
	const cursorNextBtn = document.getElementById('djCursorNextBtn') as HTMLButtonElement;
	const cursorResetBtn = document.getElementById('djCursorResetBtn');

	function renderCursor() {
		document.querySelectorAll('.dj-cursor-row').forEach((row) => row.classList.remove('is-current'));
		if (cursorPos === 0) {
			if (cursorStatus) cursorStatus.textContent = '[ANTES DE LA PRIMERA FILA]';
			if (cursorCode) cursorCode.innerHTML = `<code>while (rs.next()) { ... }
// todavía no se llamó a rs.next()</code>`;
		} else if (cursorPos >= 1 && cursorPos <= 3) {
			const row = cursorRows[cursorPos - 1];
			document.getElementById(row.id)?.classList.add('is-current');
			if (cursorStatus) cursorStatus.textContent = `Fila ${cursorPos} de 3 — rs.next() devolvió true`;
			if (cursorCode) cursorCode.innerHTML = `<code>rs.getInt("id")        → ${row.dbId}
rs.getString("nombre") → "${row.nombre}"
rs.getDouble("precio") → ${row.precio}</code>`;
		} else {
			if (cursorStatus) cursorStatus.textContent = 'rs.next() → false';
			if (cursorCode) cursorCode.innerHTML = `<code>// se recorrieron las 3 filas
// el bucle while termina</code>`;
		}
		if (cursorNextBtn) cursorNextBtn.disabled = cursorPos >= 4;
	}

	cursorNextBtn?.addEventListener('click', () => {
		cursorPos = Math.min(cursorPos + 1, 4);
		renderCursor();
	});

	cursorResetBtn?.addEventListener('click', () => {
		cursorPos = 0;
		renderCursor();
	});

	// Slide 4: ACID transaction simulator
	const INITIAL_BALANCE_1 = 500;
	const INITIAL_BALANCE_2 = 300;
	const TX_AMOUNT = 100;

	const acc1Balance = document.getElementById('djAccount1Balance');
	const acc1State = document.getElementById('djAccount1State');
	const acc1Box = document.getElementById('djAccount1Box');
	const acc2Balance = document.getElementById('djAccount2Balance');
	const acc2State = document.getElementById('djAccount2State');
	const acc2Box = document.getElementById('djAccount2Box');
	const txLog = document.getElementById('djTxLog');
	const startTxBtn = document.getElementById('djStartTxBtn') as HTMLButtonElement;
	const commitBtn = document.getElementById('djCommitBtn') as HTMLButtonElement;
	const failBtn = document.getElementById('djFailBtn') as HTMLButtonElement;
	const resetTxBtn = document.getElementById('djResetTxBtn');

	function resetTx() {
		if (acc1Balance) acc1Balance.textContent = `$${INITIAL_BALANCE_1}`;
		if (acc2Balance) acc2Balance.textContent = `$${INITIAL_BALANCE_2}`;
		if (acc1State) acc1State.textContent = 'confirmado';
		if (acc2State) acc2State.textContent = 'confirmado';
		acc1Box?.classList.remove('is-pending', 'is-reverted');
		acc2Box?.classList.remove('is-committed-new');
		if (txLog) txLog.innerHTML = `<code>conn.setAutoCommit(false);</code>`;
		if (startTxBtn) startTxBtn.disabled = false;
		if (commitBtn) commitBtn.disabled = true;
		if (failBtn) failBtn.disabled = true;
	}

	startTxBtn?.addEventListener('click', () => {
		if (acc1Balance) acc1Balance.textContent = `$${INITIAL_BALANCE_1 - TX_AMOUNT}`;
		if (acc1State) acc1State.textContent = 'pendiente (sin confirmar)';
		acc1Box?.classList.add('is-pending');
		if (txLog) txLog.innerHTML = `<code>conn.setAutoCommit(false);
UPDATE cuenta SET saldo = saldo - 100 WHERE id = 1;
// pendiente: todavía no se llamó a commit()</code>`;
		if (startTxBtn) startTxBtn.disabled = true;
		if (commitBtn) commitBtn.disabled = false;
		if (failBtn) failBtn.disabled = false;
	});

	commitBtn?.addEventListener('click', () => {
		if (acc2Balance) acc2Balance.textContent = `$${INITIAL_BALANCE_2 + TX_AMOUNT}`;
		if (acc2State) acc2State.textContent = 'confirmado';
		if (acc1State) acc1State.textContent = 'confirmado';
		acc1Box?.classList.remove('is-pending');
		acc2Box?.classList.add('is-committed-new');
		if (txLog) txLog.innerHTML = `<code>UPDATE cuenta SET saldo = saldo + 100 WHERE id = 2;
conn.commit();
// las dos operaciones quedaron permanentes en disco</code>`;
		if (commitBtn) commitBtn.disabled = true;
		if (failBtn) failBtn.disabled = true;
	});

	failBtn?.addEventListener('click', () => {
		if (acc1Balance) acc1Balance.textContent = `$${INITIAL_BALANCE_1}`;
		if (acc1State) acc1State.textContent = 'revertido (rollback)';
		acc1Box?.classList.remove('is-pending');
		acc1Box?.classList.add('is-reverted');
		if (txLog) txLog.innerHTML = `<code>// falla de red en el Paso 2
catch (SQLException e) {
    conn.rollback();
}
// la Cuenta 1 vuelve a $500: nunca pasó nada</code>`;
		if (commitBtn) commitBtn.disabled = true;
		if (failBtn) failBtn.disabled = true;
	});

	resetTxBtn?.addEventListener('click', resetTx);

	// Slide 5: Connection pool toggle
	const poolToggle = document.getElementById('djPoolToggle') as HTMLInputElement;
	const latencyBar = document.getElementById('djLatencyBar');
	const latencyStats = document.getElementById('djLatencyStats');
	const latencyExplanation = document.getElementById('djLatencyExplanation');

	poolToggle?.addEventListener('change', () => {
		const pooled = poolToggle.checked;
		if (pooled) {
			if (latencyBar) { latencyBar.className = 'dj-bar-fill dj-bar-fast'; latencyBar.style.width = '6%'; }
			if (latencyStats) {
				latencyStats.innerHTML = `<span>Conexión tomada del pool</span><strong class="dj-text-accent">2 ms</strong>`;
			}
			if (latencyExplanation) {
				latencyExplanation.textContent = 'conn.close() no destruye la conexión: la devuelve al pool para el próximo request.';
			}
		} else {
			if (latencyBar) { latencyBar.className = 'dj-bar-fill dj-bar-slow'; latencyBar.style.width = '92%'; }
			if (latencyStats) {
				latencyStats.innerHTML = `<span>Socket TCP nuevo + handshake + auth</span><strong class="dj-text-accent">180 ms</strong>`;
			}
			if (latencyExplanation) {
				latencyExplanation.textContent = 'Sin pool, cada request abre una conexión desde cero: resolución DNS, handshake TCP/TLS y autenticación.';
			}
		}
	});
</script>
