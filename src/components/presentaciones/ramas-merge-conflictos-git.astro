</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const screenEl = document.querySelector('.gm-screen');
	const pageLang = screenEl?.getAttribute('data-lang') === 'en' ? 'en' : 'es';

	const prevBtn = document.getElementById('gmPrevBtn') as HTMLButtonElement;
	const nextBtn = document.getElementById('gmNextBtn') as HTMLButtonElement;
	const counter = document.getElementById('gmSlideCounter') as HTMLElement;
	const slides = document.querySelectorAll<HTMLElement>('.gm-slide');

	function updateSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;
		slides.forEach((s) => s.classList.remove('is-active'));
		document.querySelector(`.gm-slide[data-slide="${currentSlide}"]`)?.classList.add('is-active');

		if (counter) counter.textContent = `${currentSlide} / ${totalSlides}`;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	prevBtn?.addEventListener('click', () => updateSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => updateSlide(currentSlide + 1));

	window.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') updateSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') updateSlide(currentSlide - 1);
	});

	// Slide 1: Branch pointers selector
	const branchBtns = document.querySelectorAll<HTMLButtonElement>('.gm-branch-btn');
	const headFileContent = document.getElementById('gmHeadFileContent');
	const branchFileContent = document.getElementById('gmBranchFileContent');
	const headTag = document.getElementById('gmHeadTag');

	const branchData: Record<string, { ref: string; sha: string; label: string }> = {
		main: {
			ref: 'ref: refs/heads/main',
			sha: '3a8f91c78490a1b2c3d4e5f6a7b8c9d0e1f2a3b4',
			label: 'HEAD → main (C3)',
		},
		login: {
			ref: 'ref: refs/heads/feature/login',
			sha: '9f02e4d5c6b7a891011121314151617181920212',
			label: 'HEAD → feature/login (C4)',
		},
		nav: {
			ref: 'ref: refs/heads/bugfix/nav',
			sha: '1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c',
			label: 'HEAD → bugfix/nav (C2)',
		},
	};

	branchBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			const branch = btn.getAttribute('data-branch') || 'main';
			branchBtns.forEach((b) => b.classList.remove('is-active'));
			btn.classList.add('is-active');

			const data = branchData[branch];
			if (data) {
				if (headFileContent) headFileContent.textContent = data.ref;
				if (branchFileContent) branchFileContent.textContent = data.sha;
				if (headTag) headTag.textContent = data.label;
			}
		});
	});

	// Slide 2: Fast-Forward vs 3-Way Merge
	const toggleMergeMode = document.getElementById('gmToggleMergeMode');
	const viewFF = document.getElementById('gmViewFF');
	const view3Way = document.getElementById('gmView3Way');
	const mergeHint = document.getElementById('gmMergeHint');
	let is3Way = false;

	toggleMergeMode?.addEventListener('click', () => {
		is3Way = !is3Way;
		if (viewFF) viewFF.hidden = is3Way;
		if (view3Way) view3Way.hidden = !is3Way;
		if (toggleMergeMode) {
			toggleMergeMode.textContent = is3Way
				? (pageLang === 'es' ? 'Ver Fast-Forward (sin divergencia)' : 'View Fast-Forward (no divergence)')
				: (pageLang === 'es' ? 'Ver 3-Way Merge (con divergencia)' : 'View 3-Way Merge (with divergence)');
		}
		if (mergeHint) {
			mergeHint.textContent = is3Way
				? (pageLang === 'es' ? 'Modo actual: 3-Way Merge (commit M con 2 padres).' : 'Current mode: 3-Way Merge (commit M with 2 parents).')
				: (pageLang === 'es' ? 'Modo actual: Fast-Forward (historia lineal, sin commit extra).' : 'Current mode: Fast-Forward (linear history, zero extra commits).');
		}
	});

	// Slide 4: Interactive Conflict Resolver
	const btnKeepHead = document.getElementById('gmBtnKeepHead');
	const btnKeepIncoming = document.getElementById('gmBtnKeepIncoming');
	const btnCombine = document.getElementById('gmBtnCombine');
	const btnResetConflict = document.getElementById('gmBtnResetConflict');

	const tabStatus = document.getElementById('gmTabStatus');
	const editorCode = document.getElementById('gmEditorCode');
	const resolverFeedback = document.getElementById('gmResolverFeedback');

	const ORIGINAL_CONFLICT = `<span class="gm-tc-dim">// src/config.ts</span>\n<span class="gm-tc-conflict-head">&lt;&lt;&lt;&lt;&lt;&lt;&lt; HEAD</span>\n<span class="gm-tc-main-code">export const discount = 0.15; // Versión en main</span>\n<span class="gm-tc-conflict-sep">=======</span>\n<span class="gm-tc-feat-code">export const discount = 0.20; // Versión en feature</span>\n<span class="gm-tc-conflict-end">&gt;&gt;&gt;&gt;&gt;&gt;&gt; feature/login</span>\n<span class="gm-tc-dim">export const currency = 'USD';</span>`;

	btnKeepHead?.addEventListener('click', () => {
		if (editorCode) {
			editorCode.innerHTML = `<code><span class="gm-tc-dim">// src/config.ts</span>\n<span class="gm-tc-main-code">export const discount = 0.15; // Versión aceptada de main</span>\n<span class="gm-tc-dim">export const currency = 'USD';</span></code>`;
		}
		if (tabStatus) {
			tabStatus.textContent = pageLang === 'es' ? '✓ RESUELTO' : '✓ RESOLVED';
			tabStatus.style.background = 'rgb(16, 185, 129)';
		}
		if (resolverFeedback) {
			resolverFeedback.innerHTML = `<span>✓ ${pageLang === 'es' ? 'Marcadores eliminados. Se conservó el 15% de HEAD. Ejecuta "git add src/config.ts" para indexar.' : 'Markers removed. Kept 15% from HEAD. Run "git add src/config.ts" to stage.'}</span>`;
		}
	});

	btnKeepIncoming?.addEventListener('click', () => {
		if (editorCode) {
			editorCode.innerHTML = `<code><span class="gm-tc-dim">// src/config.ts</span>\n<span class="gm-tc-feat-code">export const discount = 0.20; // Versión aceptada de feature</span>\n<span class="gm-tc-dim">export const currency = 'USD';</span></code>`;
		}
		if (tabStatus) {
			tabStatus.textContent = pageLang === 'es' ? '✓ RESUELTO' : '✓ RESOLVED';
			tabStatus.style.background = 'rgb(16, 185, 129)';
		}
		if (resolverFeedback) {
			resolverFeedback.innerHTML = `<span>✓ ${pageLang === 'es' ? 'Marcadores eliminados. Se aceptó el 20% entrante. Listo para git add.' : 'Markers removed. Accepted 20% incoming. Ready for git add.'}</span>`;
		}
	});

	btnCombine?.addEventListener('click', () => {
		if (editorCode) {
			editorCode.innerHTML = `<code><span class="gm-tc-dim">// src/config.ts</span>\n// Lógica combinada por el desarrollador\nexport const discount = isBlackFriday ? 0.20 : 0.15;\n<span class="gm-tc-dim">export const currency = 'USD';</span></code>`;
		}
		if (tabStatus) {
			tabStatus.textContent = pageLang === 'es' ? '✓ RESUELTO' : '✓ RESOLVED';
			tabStatus.style.background = 'rgb(16, 185, 129)';
		}
		if (resolverFeedback) {
			resolverFeedback.innerHTML = `<span>✓ ${pageLang === 'es' ? '¡Excelente decisión técnica! Se combinaron ambas necesidades en una regla de negocio limpia.' : 'Excellent technical decision! Both business requirements combined cleanly.'}</span>`;
		}
	});

	btnResetConflict?.addEventListener('click', () => {
		if (editorCode) editorCode.innerHTML = `<code>${ORIGINAL_CONFLICT}</code>`;
		if (tabStatus) {
			tabStatus.textContent = pageLang === 'es' ? '⚠️ CONFLICTO' : '⚠️ CONFLICT';
			tabStatus.style.background = 'rgb(225, 29, 72)';
		}
		if (resolverFeedback) {
			resolverFeedback.innerHTML = `<span>${pageLang === 'es' ? 'Marcadores restaurados a estado de colisión.' : 'Markers restored to collision state.'}</span>`;
		}
	});
</script>
