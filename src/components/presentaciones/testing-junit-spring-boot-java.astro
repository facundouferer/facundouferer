	@media (min-width: 1440px) { .ju-viewport { zoom: 1.08; } }
	@media (min-width: 1680px) { .ju-viewport { zoom: 1.16; } }
	@media (min-width: 1920px) { .ju-viewport { zoom: 1.25; } }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 5;

	const prevBtn = document.getElementById('juPrevBtn') as HTMLButtonElement;
	const nextBtn = document.getElementById('juNextBtn') as HTMLButtonElement;
	const counter = document.getElementById('juSlideCounter') as HTMLElement;
	const slides = document.querySelectorAll<HTMLElement>('.ju-slide');

	function updateSlide(target: number) {
		if (target < 1 || target > totalSlides) return;
		currentSlide = target;
		slides.forEach((s) => s.classList.remove('is-active'));
		document.querySelector(`.ju-slide[data-slide="${currentSlide}"]`)?.classList.add('is-active');

		if (counter) counter.textContent = `${currentSlide} / ${totalSlides}`;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	}

	prevBtn?.addEventListener('click', () => updateSlide(currentSlide - 1));
	nextBtn?.addEventListener('click', () => updateSlide(currentSlide + 1));

	document.addEventListener('keydown', (e: KeyboardEvent) => {
		const target = e.target as HTMLElement | null;
		if (target && ['INPUT', 'TEXTAREA'].includes(target.tagName)) return;
		if (e.key === 'ArrowRight') updateSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') updateSlide(currentSlide - 1);
	});

	// Slide 1: Feedback cost calculator
	const unitSuiteBtn = document.getElementById('juUnitSuiteBtn');
	const integrationSuiteBtn = document.getElementById('juIntegrationSuiteBtn');
	const feedbackResult = document.getElementById('juFeedbackResult');

	unitSuiteBtn?.addEventListener('click', () => {
		unitSuiteBtn.classList.add('is-active');
		integrationSuiteBtn?.classList.remove('is-active');
		if (feedbackResult) {
			feedbackResult.innerHTML = `
				<span class="ju-code-sample">500 × 5 ms</span>
				<span class="ju-tag-ok">✓ 2.5 segundos — feedback casi instantáneo</span>
			`;
		}
	});

	integrationSuiteBtn?.addEventListener('click', () => {
		integrationSuiteBtn.classList.add('is-active');
		unitSuiteBtn?.classList.remove('is-active');
		if (feedbackResult) {
			feedbackResult.innerHTML = `
				<span class="ju-code-sample">500 × 4 s (contexto Spring + BD)</span>
				<span class="ju-tag-warn">⚠ 33 minutos — nadie corre esto antes de cada commit</span>
			`;
		}
	});

	// Slide 2: @BeforeEach isolation demo
	const beforeEachBtn = document.getElementById('juBeforeEachBtn');
	const lifecycleSteps = document.querySelectorAll<HTMLElement>('.ju-lifecycle-step');
	const lifecycleLog = document.getElementById('juLifecycleLog');

	beforeEachBtn?.addEventListener('click', () => {
		lifecycleSteps.forEach((step) => {
			step.classList.remove('is-active');
			const status = step.querySelector('[data-status]');
			if (status) status.textContent = '—';
		});
		if (lifecycleLog) lifecycleLog.textContent = 'Ejecutando suite...';

		lifecycleSteps.forEach((step, index) => {
			setTimeout(() => {
				lifecycleSteps.forEach((s) => s.classList.remove('is-active'));
				step.classList.add('is-active');
				const status = step.querySelector('[data-status]');
				if (status) status.textContent = '✓ instancia nueva';
				if (index === lifecycleSteps.length - 1 && lifecycleLog) {
					lifecycleLog.textContent = 'Cada instancia fue nueva: sin estado compartido entre tests.';
				}
			}, 450 * (index + 1));
		});
	});

	// Slide 3: Mockito scenario simulator
	const scenarioOkBtn = document.getElementById('juScenarioOkBtn');
	const scenarioFundsBtn = document.getElementById('juScenarioFundsBtn');
	const scenarioTimeoutBtn = document.getElementById('juScenarioTimeoutBtn');
	const scenarioResult = document.getElementById('juScenarioResult');
	const scenarioButtons = [scenarioOkBtn, scenarioFundsBtn, scenarioTimeoutBtn];

	function activateScenario(active: HTMLElement | null) {
		scenarioButtons.forEach((btn) => btn?.classList.remove('is-active'));
		active?.classList.add('is-active');
	}

	scenarioOkBtn?.addEventListener('click', () => {
		activateScenario(scenarioOkBtn);
		if (scenarioResult) {
			scenarioResult.innerHTML = `
				<span class="ju-code-sample">when(pasarela.cobrar(pedido)).thenReturn(true);</span>
				<span class="ju-tag-ok">✓ Pedido CONFIRMADO — verify(pasarela, times(1)).cobrar(...) pasa</span>
			`;
		}
	});

	scenarioFundsBtn?.addEventListener('click', () => {
		activateScenario(scenarioFundsBtn);
		if (scenarioResult) {
			scenarioResult.innerHTML = `
				<span class="ju-code-sample">when(pasarela.cobrar(pedido)).thenReturn(false);</span>
				<span class="ju-tag-warn">✗ Pedido RECHAZADO — el stock no se descuenta, la transacción no se confirma</span>
			`;
		}
	});

	scenarioTimeoutBtn?.addEventListener('click', () => {
		activateScenario(scenarioTimeoutBtn);
		if (scenarioResult) {
			scenarioResult.innerHTML = `
				<span class="ju-code-sample">when(pasarela.cobrar(pedido)).thenThrow(new TimeoutException());</span>
				<span class="ju-tag-warn">⚠ Excepción controlada — PedidoService hace rollback y responde 503</span>
			`;
		}
	});

	// Slide 5: REST sequence playback
	const playSequenceBtn = document.getElementById('juPlaySequenceBtn');
	const seqSteps = document.querySelectorAll<HTMLElement>('.ju-seq-step');

	playSequenceBtn?.addEventListener('click', () => {
		seqSteps.forEach((step) => step.classList.remove('is-active'));

		seqSteps.forEach((step, index) => {
			setTimeout(() => {
				seqSteps.forEach((s) => s.classList.remove('is-active'));
				step.classList.add('is-active');
			}, 350 * (index + 1));
		});
	});
</script>
