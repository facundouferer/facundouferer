---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="sc-screen">
	<div class="sc-shell">
		<header class="sc-header">
			<span class="sc-badge">{isEs ? 'Búsqueda de Caracteres' : 'Character Search'}</span>
			<h1 class="sc-title">
				{isEs ? 'Búsqueda strchr / indexOf Paso a Paso' : 'Character Search Step by Step'}
			</h1>
			<p class="sc-sub">
				{isEs 
					? 'Localización de caracteres, punteros e índices en C, Java, JavaScript y Python.' 
					: 'Character lookup, pointers, and indices in C, Java, JS, and Python.'}
			</p>
		</header>

		<div class="sc-deck-card">
			<div class="sc-nav-bar">
				<div class="sc-slide-indicator">
					<span class="sc-step-dot"></span>
					<span id="sc-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="sc-pills">
					<button class="sc-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="sc-pill-btn" data-target-slide="2">2. C</button>
					<button class="sc-pill-btn" data-target-slide="3">3. Java</button>
					<button class="sc-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="sc-pill-btn" data-target-slide="5">5. Python</button>
					<button class="sc-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="sc-viewport">
				<div class="sc-slide active" data-slide="1">
					<div class="sc-slide-grid">
						<div class="sc-col">
							<h2 class="sc-slide-title">1. {isEs ? 'Búsqueda de la Primera Ocurrencia' : 'First Occurrence Search'}</h2>
							<p class="sc-text">
								{isEs 
									? 'Localizar un carácter en una cadena es una operación O(N) que retorna la primera coincidencia o indicador nulo/inválido.'
									: 'Locating a character in a string is an O(N) lookup returning the first match or null/invalid indicator.'}
							</p>
						</div>
						<div class="sc-col">
							<div class="sc-card-box">
								<div class="sc-card-head">{isEs ? 'VALORES DE RETORNO' : 'RETURN VALUES'}</div>
								<div class="sc-cell"><span>En C (strchr)</span><span class="sc-tag">Puntero `char*` a la celda o NULL</span></div>
								<div class="sc-cell"><span>En Java / JS / Python</span><span class="sc-tag">Índice int (o -1 / ValueError)</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="sc-slide" data-slide="2">
					<div class="sc-slide-grid">
						<div class="sc-col">
							<h2 class="sc-slide-title">2. C: strchr(str, ch)</h2>
							<p class="sc-text">`strchr` pertenece a `&lt;string.h&gt;` y devuelve un puntero a la primera aparición del carácter en la memoria.</p>
						</div>
						<div class="sc-col">
							<div class="sc-code-card">
								<div class="sc-code-title">strchr_demo.c</div>
								<pre class="sc-code-block"><code><span class="token-type">char</span> text[] = <span class="token-string">"Programacion"</span>;
<span class="token-type">char</span> *ptr = strchr(text, <span class="token-string">'g'</span>);
<span class="token-keyword">if</span> (ptr != NULL) &#123;
    printf(<span class="token-string">"Encontrado en offset: %ld\n"</span>, ptr - text);
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="sc-slide" data-slide="3">
					<div class="sc-slide-grid">
						<div class="sc-col">
							<h2 class="sc-slide-title">3. Java: str.indexOf('c')</h2>
							<p class="sc-text">Java retorna el índice entero de la primera aparición o `-1` si no existe.</p>
						</div>
						<div class="sc-col">
							<div class="sc-code-card">
								<div class="sc-code-title">IndexOfTest.java</div>
								<pre class="sc-code-block"><code>String text = <span class="token-string">"Java"</span>;
<span class="token-type">int</span> idx = text.indexOf(<span class="token-string">'v'</span>); <span class="token-comment">// 2</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="sc-slide" data-slide="4">
					<div class="sc-slide-grid">
						<div class="sc-col">
							<h2 class="sc-slide-title">4. JavaScript: str.indexOf('c') e includes()</h2>
							<p class="sc-text">JS ofrece `indexOf()` e `includes()` para verificar existencia booleana.</p>
						</div>
						<div class="sc-col">
							<div class="sc-code-card">
								<div class="sc-code-title">search.js</div>
								<pre class="sc-code-block"><code><span class="token-keyword">const</span> str = <span class="token-string">"JavaScript"</span>;
<span class="token-keyword">const</span> pos = str.indexOf(<span class="token-string">"S"</span>); <span class="token-comment">// 4</span>
<span class="token-keyword">const</span> existe = str.includes(<span class="token-string">"Script"</span>); <span class="token-comment">// true</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="sc-slide" data-slide="5">
					<div class="sc-slide-grid">
						<div class="sc-col">
							<h2 class="sc-slide-title">5. Python: str.find() vs str.index()</h2>
							<p class="sc-text">`find()` retorna `-1` si no encuentra; `index()` lanza una excepción `ValueError`.</p>
						</div>
						<div class="sc-col">
							<div class="sc-code-card">
								<div class="sc-code-title">find_demo.py</div>
								<pre class="sc-code-block"><code>texto = <span class="token-string">"Python"</span>
pos = texto.find(<span class="token-string">"h"</span>) <span class="token-comment"># 3</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="sc-slide" data-slide="6">
					<div class="sc-sim-container">
						<h2 class="sc-slide-title center">{isEs ? '6. Inspector de Búsqueda de Caracteres' : '6. Character Search Inspector'}</h2>
						<div class="sc-inspector-grid">
							<div class="sc-lang-box"><span class="sc-lang-name">Buscando 'g' en "Programacion"</span><div class="sc-exp-res">C: Puntero (offset 3) | Java: idx=3 | JS: idx=3 | Python: idx=3</div></div>
						</div>
					</div>
				</div>
			</div>

			<div class="sc-footer">
				<button class="btn btn-secondary" id="btn-prev-sc" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="sc-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-sc">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.sc-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.sc-shell { max-width: var(--container-max); margin: 0 auto; }
	.sc-header { margin-bottom: 1.5rem; }
	.sc-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.sc-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.sc-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.sc-sub.center { text-align: center; }
	.sc-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.sc-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.sc-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.sc-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.sc-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.sc-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.sc-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.sc-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.sc-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.sc-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.sc-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.sc-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.sc-col { grid-column: span 12; }
	@media (min-width: 900px) { .sc-col { grid-column: span 6; } }
	.sc-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.sc-slide-title.center { text-align: center; }
	.sc-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.sc-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.sc-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.sc-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.sc-tag { color: var(--color-accent-700); font-weight: 600; }
	.sc-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.sc-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.sc-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.sc-sim-container { max-width: 800px; margin: 0 auto; }
	.sc-inspector-grid { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 0.8rem; }
	.sc-lang-box { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.8rem; }
	.sc-lang-name { font-family: 'Fira Code', monospace; font-size: 0.75rem; font-weight: 700; color: #e59866; display: block; margin-bottom: 0.4rem; }
	.sc-exp-res { font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #f9f4ed; background: #141210; padding: 0.5rem 0.7rem; border-radius: var(--radius-sm); }
	.sc-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.sc-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.sc-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.sc-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('sc-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-sc') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-sc') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.sc-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-sc')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-sc')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	goToSlide(1);
</script>
