---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="fn-screen">
	<div class="fn-shell">
		<header class="fn-header">
			<span class="fn-badge">{isEs ? 'Iteración Multidimensional' : 'Multidimensional Iteration'}</span>
			<h1 class="fn-title">
				{isEs ? 'For Anidado y Tabla de Multiplicar' : 'Nested For & Multiplication Table'}
			</h1>
			<p class="fn-sub">
				{isEs 
					? 'Bucles anidados, complejidad O(N²) y matrices en C, Java, JavaScript y Python.' 
					: 'Nested loops, O(N²) complexity, and matrices in C, Java, JS, and Python.'}
			</p>
		</header>

		<div class="fn-deck-card">
			<div class="fn-nav-bar">
				<div class="fn-slide-indicator">
					<span class="fn-step-dot"></span>
					<span id="fn-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="fn-pills">
					<button class="fn-pill-btn active" data-target-slide="1">1. {isEs ? 'Concepto' : 'Concept'}</button>
					<button class="fn-pill-btn" data-target-slide="2">2. C</button>
					<button class="fn-pill-btn" data-target-slide="3">3. Java</button>
					<button class="fn-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="fn-pill-btn" data-target-slide="5">5. Python</button>
					<button class="fn-pill-btn" data-target-slide="6">6. {isEs ? 'Matriz' : 'Matrix'}</button>
				</div>
			</div>

			<div class="fn-viewport">
				<div class="fn-slide active" data-slide="1">
					<div class="fn-slide-grid">
						<div class="fn-col">
							<h2 class="fn-slide-title">1. {isEs ? 'Mecánica de los Bucles Anidados' : 'Nested Loop Mechanics'}</h2>
							<p class="fn-text">
								{isEs 
									? 'Por cada iteración del bucle externo (i), el bucle interno (j) se ejecuta completamente desde su inicio hasta el final.'
									: 'For each iteration of the outer loop (i), the inner loop (j) completes all its iterations.'}
							</p>
						</div>
						<div class="fn-col">
							<div class="fn-card-box">
								<div class="fn-card-head">{isEs ? 'COMPLEJIDAD TEMPORAL' : 'TIME COMPLEXITY'}</div>
								<div class="fn-cell"><span>Bucle Externo (N veces)</span><span class="fn-tag">Filas (i)</span></div>
								<div class="fn-cell"><span>Bucle Interno (M veces)</span><span class="fn-tag">Columnas (j)</span></div>
								<div class="fn-cell"><span>Total Pasos: N × M</span><span class="fn-tag">O(N²) si N=M</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="fn-slide" data-slide="2">
					<div class="fn-slide-grid">
						<div class="fn-col">
							<h2 class="fn-slide-title">2. C: Tabla de Multiplicar</h2>
							<p class="fn-text">Uso clásico de for anidado para imprimir filas y columnas tabuladas con `\t` y saltos `\n`.</p>
						</div>
						<div class="fn-col">
							<div class="fn-code-card">
								<div class="fn-code-title">table.c</div>
								<pre class="fn-code-block"><code><span class="token-keyword">for</span> (<span class="token-type">int</span> i = <span class="token-number">1</span>; i &lt;= <span class="token-number">5</span>; i++) &#123;
    <span class="token-keyword">for</span> (<span class="token-type">int</span> j = <span class="token-number">1</span>; j &lt;= <span class="token-number">5</span>; j++) &#123;
        printf(<span class="token-string">"%d\t"</span>, i * j);
    &#125;
    printf(<span class="token-string">"\n"</span>);
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="fn-slide" data-slide="3">
					<div class="fn-slide-grid">
						<div class="fn-col">
							<h2 class="fn-slide-title">3. Java: Recorrido de Matrices 2D</h2>
							<p class="fn-text">Iteración sobre un array bidimensional `matrix[row][col]` mediante dos índices acoplados.</p>
						</div>
						<div class="fn-col">
							<div class="fn-code-card">
								<div class="fn-code-title">Matrix2D.java</div>
								<pre class="fn-code-block"><code><span class="token-type">int</span>[][] grid = <span class="token-keyword">new</span> <span class="token-type">int</span>[<span class="token-number">3</span>][<span class="token-number">3</span>];
<span class="token-keyword">for</span> (<span class="token-type">int</span> r = <span class="token-number">0</span>; r &lt; grid.length; r++) &#123;
    <span class="token-keyword">for</span> (<span class="token-type">int</span> c = <span class="token-number">0</span>; c &lt; grid[r].length; c++) &#123;
        grid[r][c] = r * c;
    &#125;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="fn-slide" data-slide="4">
					<div class="fn-slide-grid">
						<div class="fn-col">
							<h2 class="fn-slide-title">4. JavaScript: Generación de Grillas</h2>
							<p class="fn-text">JS usa for anidado para construir layouts bidimensionales, mapas de tiles o matrices de píxeles.</p>
						</div>
						<div class="fn-col">
							<div class="fn-code-card">
								<div class="fn-code-title">grid.js</div>
								<pre class="fn-code-block"><code><span class="token-keyword">for</span> (<span class="token-keyword">let</span> x = <span class="token-number">0</span>; x &lt; <span class="token-number">3</span>; x++) &#123;
    <span class="token-keyword">for</span> (<span class="token-keyword">let</span> y = <span class="token-number">0</span>; y &lt; <span class="token-number">3</span>; y++) &#123;
        console.log(<span class="token-string">`Point: ($&#123;x&#125;, $&#123;y&#125;)`</span>);
    &#125;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="fn-slide" data-slide="5">
					<div class="fn-slide-grid">
						<div class="fn-col">
							<h2 class="fn-slide-title">5. Python: List Comprehension Anidada</h2>
							<p class="fn-text">Python permite expresar matrices bidimensionales concisamente mediante sintaxis de comprehensions.</p>
						</div>
						<div class="fn-col">
							<div class="fn-code-card">
								<div class="fn-code-title">matrix.py</div>
								<pre class="fn-code-block"><code>matrix = [[i * j <span class="token-keyword">for</span> j <span class="token-keyword">in</span> range(<span class="token-number">1</span>, <span class="token-number">4</span>)] <span class="token-keyword">for</span> i <span class="token-keyword">in</span> range(<span class="token-number">1</span>, <span class="token-number">4</span>)]
<span class="token-comment"># [[1, 2, 3], [2, 4, 6], [3, 6, 9]]</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="fn-slide" data-slide="6">
					<div class="fn-sim-container">
						<h2 class="fn-slide-title center">{isEs ? '6. Simulador Interactivo de Matriz de Multiplicación' : '6. Matrix Simulator'}</h2>
						<p class="fn-sub center">{isEs ? 'Visualizá la grilla 3x3 generada por los loops anidados:' : 'Visualize the 3x3 grid generated by nested loops:'}</p>

						<div class="fn-grid-display">
							<div class="fn-row-grid">
								<span class="fn-cell-val">1×1=1</span><span class="fn-cell-val">1×2=2</span><span class="fn-cell-val">1×3=3</span>
							</div>
							<div class="fn-row-grid">
								<span class="fn-cell-val">2×1=2</span><span class="fn-cell-val">2×2=4</span><span class="fn-cell-val">2×3=6</span>
							</div>
							<div class="fn-row-grid">
								<span class="fn-cell-val">3×1=3</span><span class="fn-cell-val">3×2=6</span><span class="fn-cell-val">3×3=9</span>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="fn-footer">
				<button class="btn btn-secondary" id="btn-prev-fn" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="fn-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-fn">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.fn-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.fn-shell { max-width: var(--container-max); margin: 0 auto; }
	.fn-header { margin-bottom: 1.5rem; }
	.fn-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.fn-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.fn-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.fn-sub.center { text-align: center; }
	.fn-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.fn-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.fn-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.fn-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.fn-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.fn-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.fn-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.fn-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.fn-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.fn-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.fn-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.fn-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.fn-col { grid-column: span 12; }
	@media (min-width: 900px) { .fn-col { grid-column: span 6; } }
	.fn-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.fn-slide-title.center { text-align: center; }
	.fn-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.fn-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.fn-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.fn-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.fn-tag { color: var(--color-accent-700); font-weight: 600; }
	.fn-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.fn-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.fn-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.fn-sim-container { max-width: 500px; margin: 0 auto; }
	.fn-grid-display { display: flex; flex-direction: column; gap: 0.5rem; background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.fn-row-grid { display: flex; justify-content: space-around; }
	.fn-cell-val { font-family: 'Fira Code', monospace; font-size: 0.85rem; color: #76d7c4; background: #141210; padding: 0.4rem 0.8rem; border-radius: var(--radius-sm); border: 1px solid #2b2722; }
	.fn-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.fn-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.fn-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.fn-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('fn-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-fn') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-fn') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.fn-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-fn')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-fn')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	goToSlide(1);
</script>
