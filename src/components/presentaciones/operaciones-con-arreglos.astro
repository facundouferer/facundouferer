---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="oa-screen">
	<div class="oa-shell">
		<header class="oa-header">
			<span class="oa-badge">{isEs ? 'Operaciones Algorítmicas' : 'Algorithmic Operations'}</span>
			<h1 class="oa-title">
				{isEs ? 'Operaciones con Arreglos Paso a Paso' : 'Array Operations Step by Step'}
			</h1>
			<p class="oa-sub">
				{isEs 
					? 'Recorrido, búsqueda lineal, inserción y borrado en C, Java, JavaScript y Python.' 
					: 'Traversal, linear search, insertion, and deletion in C, Java, JS, and Python.'}
			</p>
		</header>

		<div class="oa-deck-card">
			<div class="oa-nav-bar">
				<div class="oa-slide-indicator">
					<span class="oa-step-dot"></span>
					<span id="oa-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="oa-pills">
					<button class="oa-pill-btn active" data-target-slide="1">1. {isEs ? 'Recorrido' : 'Traversal'}</button>
					<button class="oa-pill-btn" data-target-slide="2">2. C</button>
					<button class="oa-pill-btn" data-target-slide="3">3. Java</button>
					<button class="oa-pill-btn" data-target-slide="4">4. JavaScript</button>
					<button class="oa-pill-btn" data-target-slide="5">5. Python</button>
					<button class="oa-pill-btn" data-target-slide="6">6. {isEs ? 'Simulador' : 'Simulator'}</button>
				</div>
			</div>

			<div class="oa-viewport">
				<div class="oa-slide active" data-slide="1">
					<div class="oa-slide-grid">
						<div class="oa-col">
							<h2 class="oa-slide-title">1. {isEs ? 'Operaciones Fundamentales sobre Arreglos' : 'Fundamental Array Operations'}</h2>
							<p class="oa-text">
								{isEs 
									? 'Las operaciones básicas incluyen Recorrido O(N), Búsqueda Lineal O(N), Inserción O(N) y Eliminación O(N).'
									: 'Basic operations include Traversal O(N), Linear Search O(N), Insertion O(N), and Deletion O(N).'}
							</p>
						</div>
						<div class="oa-col">
							<div class="oa-card-box">
								<div class="oa-card-head">{isEs ? 'COMPLEJIDAD TEMPORAL' : 'TIME COMPLEXITIES'}</div>
								<div class="oa-cell"><span>Acceso directo por índice</span><span class="oa-tag">O(1)</span></div>
								<div class="oa-cell"><span>Búsqueda Lineal</span><span class="oa-tag">O(N)</span></div>
								<div class="oa-cell"><span>Desplazamiento por Inserción</span><span class="oa-tag">O(N)</span></div>
							</div>
						</div>
					</div>
				</div>

				<div class="oa-slide" data-slide="2">
					<div class="oa-slide-grid">
						<div class="oa-col">
							<h2 class="oa-slide-title">2. C: Búsqueda Lineal y Desplazamiento</h2>
							<p class="oa-text">En C la inserción requiere desplazar manualmente los elementos hacia la derecha para hacer espacio.</p>
						</div>
						<div class="oa-col">
							<div class="oa-code-card">
								<div class="oa-code-title">search.c</div>
								<pre class="oa-code-block"><code><span class="token-type">int</span> buscar(<span class="token-type">int</span> arr[], <span class="token-type">int</span> n, <span class="token-type">int</span> target) &#123;
    <span class="token-keyword">for</span> (<span class="token-type">int</span> i = <span class="token-number">0</span>; i &lt; n; i++) &#123;
        <span class="token-keyword">if</span> (arr[i] == target) <span class="token-keyword">return</span> i; <span class="token-comment">// Match</span>
    &#125;
    <span class="token-keyword">return</span> -<span class="token-number">1</span>;
&#125;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="oa-slide" data-slide="3">
					<div class="oa-slide-grid">
						<div class="oa-col">
							<h2 class="oa-slide-title">3. Java: ArrayList y Operaciones API</h2>
							<p class="oa-text">`ArrayList&lt;T&gt;` encapsula un array redimensionable dinámicamente (`.add()`, `.remove()`, `.indexOf()`).</p>
						</div>
						<div class="oa-col">
							<div class="oa-code-card">
								<div class="oa-code-title">ArrayOps.java</div>
								<pre class="oa-code-block"><code>List&lt;Integer&gt; list = <span class="token-keyword">new</span> ArrayList&lt;&gt;();
list.add(<span class="token-number">10</span>);
list.add(<span class="token-number">0</span>, <span class="token-number">5</span>); <span class="token-comment">// Inserción en índice 0</span>
<span class="token-type">boolean</span> existe = list.contains(<span class="token-number">10</span>);</code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="oa-slide" data-slide="4">
					<div class="oa-slide-grid">
						<div class="oa-col">
							<h2 class="oa-slide-title">4. JavaScript: push, pop, shift, unshift, splice</h2>
							<p class="oa-text">JS cuenta con métodos nativos integrados para modificar el arreglo (`splice(index, deleteCount, item)`).</p>
						</div>
						<div class="oa-col">
							<div class="oa-code-card">
								<div class="oa-code-title">ops.js</div>
								<pre class="oa-code-block"><code><span class="token-keyword">const</span> nums = [<span class="token-number">10</span>, <span class="token-number">30</span>];
nums.splice(<span class="token-number">1</span>, <span class="token-number">0</span>, <span class="token-number">20</span>); <span class="token-comment">// Inserta 20 en pos 1 -> [10, 20, 30]</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="oa-slide" data-slide="5">
					<div class="oa-slide-grid">
						<div class="oa-col">
							<h2 class="oa-slide-title">5. Python: insert(), remove(), index()</h2>
							<p class="oa-text">Las listas de Python ofrecen métodos expresivos para búsqueda e inserción en cualquier posición.</p>
						</div>
						<div class="oa-col">
							<div class="oa-code-card">
								<div class="oa-code-title">list_ops.py</div>
								<pre class="oa-code-block"><code>data = [<span class="token-number">10</span>, <span class="token-number">30</span>]
data.insert(<span class="token-number">1</span>, <span class="token-number">20</span>) <span class="token-comment"># Inserta en índice 1</span>
idx = data.index(<span class="token-number">20</span>) <span class="token-comment"># Búsqueda</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<div class="oa-slide" data-slide="6">
					<div class="oa-sim-container">
						<h2 class="oa-slide-title center">{isEs ? '6. Simulador Interactivo de Búsqueda Lineal' : '6. Linear Search Simulator'}</h2>
						<p class="oa-sub center">{isEs ? 'Buscando el elemento 30 en [10, 20, 30, 40]:' : 'Searching for 30 in [10, 20, 30, 40]:'}</p>

						<div class="oa-sim-console">
							<div class="oa-sim-head"><span class="oa-console-label">Search Trace: target = 30</span></div>
							<div class="oa-sim-body">
								<div class="oa-trace-step" id="oa-sim-step">Paso 1: Evaluar arr[0] == 10 ➔ No coincide. Avanzar.</div>
								<div class="oa-stack-display" id="oa-sim-state">Índice actual: 0</div>
							</div>
							<div class="oa-sim-actions">
								<button class="btn btn-primary" id="btn-next-oa-step">▶ {isEs ? 'Siguiente Paso' : 'Next Step'}</button>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="oa-footer">
				<button class="btn btn-secondary" id="btn-prev-oa" disabled>← {isEs ? 'Anterior' : 'Previous'}</button>
				<div class="oa-footer-meta"><span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span></div>
				<button class="btn btn-primary" id="btn-next-oa">{isEs ? 'Siguiente' : 'Next'} →</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');
	.oa-screen { min-height: 80vh; font-family: var(--font-body); color: var(--color-text); padding: 1.5rem 1rem 4rem; }
	.oa-shell { max-width: var(--container-max); margin: 0 auto; }
	.oa-header { margin-bottom: 1.5rem; }
	.oa-badge { display: inline-flex; align-items: center; border: 1px solid var(--color-accent-2-300); background: var(--color-accent-2-100); color: var(--color-accent-2-700); border-radius: 999px; padding: 0.25rem 0.8rem; font-size: 0.75rem; font-family: 'Fira Code', monospace; font-weight: 600; }
	.oa-title { font-family: var(--font-heading); font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 400; line-height: 1.15; color: var(--color-text); margin: 0.5rem 0 0.25rem; }
	.oa-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.oa-sub.center { text-align: center; }
	.oa-deck-card { background: var(--color-surface); border: 1px solid var(--color-divider); border-radius: var(--radius-lg); box-shadow: var(--shadow-md); overflow: hidden; }
	.oa-nav-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 0.8rem 1.2rem; border-bottom: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.oa-slide-indicator { display: flex; align-items: center; gap: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.78rem; font-weight: 700; color: var(--color-accent-700); }
	.oa-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.oa-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.oa-pill-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.3rem 0.75rem; font-size: 0.78rem; font-family: var(--font-body); font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
	.oa-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.oa-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }
	.oa-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.oa-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.oa-slide.active { display: block; opacity: 1; transform: translateY(0); }
	.oa-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.oa-col { grid-column: span 12; }
	@media (min-width: 900px) { .oa-col { grid-column: span 6; } }
	.oa-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.oa-slide-title.center { text-align: center; }
	.oa-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.oa-card-box { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.oa-card-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.oa-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.oa-tag { color: var(--color-accent-700); font-weight: 600; }
	.oa-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.oa-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.oa-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }
	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }
	.oa-sim-container { max-width: 800px; margin: 0 auto; }
	.oa-sim-console { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-md); }
	.oa-sim-head { background: #2b2722; padding: 0.5rem 0.8rem; }
	.oa-console-label { color: #c0b6a5; font-family: 'Fira Code', monospace; font-size: 0.75rem; }
	.oa-sim-body { padding: 1rem; display: flex; flex-direction: column; gap: 0.8rem; }
	.oa-trace-step { font-size: 0.88rem; line-height: 1.5; color: #f9f4ed; background: #2a2520; padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); }
	.oa-stack-display { font-family: 'Fira Code', monospace; font-size: 0.8rem; color: #76d7c4; background: #141210; padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); }
	.oa-sim-actions { padding: 0.8rem 1rem; background: #25211d; display: flex; justify-content: flex-end; border-top: 1px solid #3a352e; }
	.oa-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.oa-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;
	let oaStep = 0;

	const oaSteps = [
		{ step: 'Paso 1: Evaluar arr[0] == 10 ➔ No coincide. Avanzar a pos 1.', state: 'Índice actual: 0 (Valor: 10)' },
		{ step: 'Paso 2: Evaluar arr[1] == 20 ➔ No coincide. Avanzar a pos 2.', state: 'Índice actual: 1 (Valor: 20)' },
		{ step: 'Paso 3: Evaluar arr[2] == 30 ➔ Match verdadero! Retornar índice 2.', state: 'Índice encontrado: 2' }
	];

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;
		document.querySelectorAll('.oa-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});
		document.querySelectorAll('.oa-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});
		const labelEl = document.getElementById('oa-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;
		const prevBtn = document.getElementById('btn-prev-oa') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-oa') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.oa-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-oa')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-oa')?.addEventListener('click', () => goToSlide(currentSlide + 1));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	document.getElementById('btn-next-oa-step')?.addEventListener('click', () => {
		oaStep = (oaStep + 1) % oaSteps.length;
		const stepEl = document.getElementById('oa-sim-step');
		const stateEl = document.getElementById('oa-sim-state');
		if (stepEl) stepEl.textContent = oaSteps[oaStep].step;
		if (stateEl) stateEl.textContent = oaSteps[oaStep].state;
	});

	goToSlide(1);
</script>
