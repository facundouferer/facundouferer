---
type Props = {
	lang: 'es' | 'en';
};

const { lang } = Astro.props;
const isEs = lang === 'es';
---

<div class="tj-screen">
	<div class="tj-shell">
		<header class="tj-header">
			<span class="tj-badge">{isEs ? 'Sistemas de Tipos' : 'Type Systems'}</span>
			<h1 class="tj-title">
				{isEs ? 'Tipos de Datos y Coherción' : 'Data Types & Type Systems'}
			</h1>
			<p class="tj-sub">
				{isEs 
					? 'Estudio comparativo: C, JavaScript, Python y Java.' 
					: 'Comparative study across C, JavaScript, Python, and Java.'}
			</p>
		</header>

		<div class="tj-deck-card">
			<div class="tj-nav-bar">
				<div class="tj-slide-indicator">
					<span class="tj-step-dot"></span>
					<span id="tj-slide-label">SLIDE 1 / 6</span>
				</div>
				<div class="tj-pills">
					<button class="tj-pill-btn active" data-target-slide="1">1. {isEs ? 'Clasificación' : 'Taxonomy'}</button>
					<button class="tj-pill-btn" data-target-slide="2">2. {isEs ? 'Primitivos' : 'Primitives'}</button>
					<button class="tj-pill-btn" data-target-slide="3">3. {isEs ? 'Referencias' : 'References'}</button>
					<button class="tj-pill-btn" data-target-slide="4">4. {isEs ? 'Estático vs Dinámico' : 'Static vs Dynamic'}</button>
					<button class="tj-pill-btn" data-target-slide="5">5. {isEs ? 'Coherción' : 'Coercion'}</button>
					<button class="tj-pill-btn" data-target-slide="6">6. {isEs ? 'Inspector' : 'Inspector'}</button>
				</div>
			</div>

			<div class="tj-viewport">
				<!-- SLIDE 1: TAXONOMY -->
				<div class="tj-slide active" data-slide="1">
					<div class="tj-slide-grid">
						<div class="tj-col">
							<h2 class="tj-slide-title">1. {isEs ? 'Clasificación de los Tipos de Datos' : 'Data Types Classification'}</h2>
							<p class="tj-text">
								{isEs 
									? 'Los tipos de datos le informan al compilador o intérprete cómo interpretar los secuencias de bits en la memoria RAM.'
									: 'Data types tell the compiler or interpreter how to interpret RAM bit sequences.'}
							</p>
							<div class="tj-concept-box">
								<div class="tj-concept-item">
									<strong class="tj-accent-text">{isEs ? 'Tipos Primitivos:' : 'Primitive Types:'}</strong>
									<span>{isEs ? 'Valores atómicos almacenados directamente (números, caracteres, booleanos).' : 'Atomic values stored directly (numbers, chars, booleans).'}</span>
								</div>
								<div class="tj-concept-item">
									<strong class="tj-accent-text">{isEs ? 'Tipos de Referencia / Compuestos:' : 'Reference / Composite Types:'}</strong>
									<span>{isEs ? 'Estructuras compuestas (arreglos, objetos, clases) almacenadas en el Heap.' : 'Composite structures (arrays, objects, classes) stored in Heap.'}</span>
								</div>
							</div>
						</div>
						<div class="tj-col">
							<div class="tj-type-card">
								<div class="tj-type-head">{isEs ? 'REPRESENTACIÓN EN MEMORIA' : 'MEMORY REPRESENTATION'}</div>
								<div class="tj-cell">
									<span>int age = 25</span>
									<span class="tj-tag">[Primitive: 4 Bytes]</span>
								</div>
								<div class="tj-cell">
									<span>String name = "Ana"</span>
									<span class="tj-tag">[Reference: Heap Addr]</span>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 2: PRIMITIVES -->
				<div class="tj-slide" data-slide="2">
					<div class="tj-slide-grid">
						<div class="tj-col">
							<h2 class="tj-slide-title">2. {isEs ? 'Primitivos entre Lenguajes' : 'Primitives Across Languages'}</h2>
							<ul class="tj-list">
								<li><strong>C:</strong> char (8-bit), int (32-bit), float (32-bit IEEE), double.</li>
								<li><strong>JavaScript:</strong> number (64-bit float), bigint, string, boolean, symbol, null, undefined.</li>
								<li><strong>Python:</strong> int (precisión arbitraria), float, bool, str, NoneType.</li>
								<li><strong>Java:</strong> byte, short, int, long, float, double, boolean, char.</li>
							</ul>
						</div>
						<div class="tj-col">
							<div class="tj-code-card">
								<div class="tj-code-title">primitives.ts</div>
								<pre class="tj-code-block"><code><span class="token-comment">// JS/TS: number abarca enteros y flotantes</span>
<span class="token-keyword">let</span> cantidad = <span class="token-number">42</span>; 
<span class="token-keyword">let</span> precio = <span class="token-number">19.99</span>;

<span class="token-comment">// C / Java: Explicitez estricta</span>
<span class="token-type">int</span> c_cantidad = <span class="token-number">42</span>;
<span class="token-type">double</span> c_precio = <span class="token-number">19.99</span>;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 3: REFERENCES -->
				<div class="tj-slide" data-slide="3">
					<div class="tj-slide-grid">
						<div class="tj-col">
							<h2 class="tj-slide-title">3. {isEs ? 'Tipos Compuestos y de Referencia' : 'Composite & Reference Types'}</h2>
							<p class="tj-text">
								{isEs 
									? 'Almacenan colecciones de datos o estructuras complejas mediante direcciones que apuntan al Heap.'
									: 'Store complex structures or data collections via addresses pointing to the Heap.'}
							</p>
							<div class="tj-concept-box">
								<div class="tj-concept-item"><strong class="tj-accent-text">Arreglos / Arrays:</strong> Secuencias contiguas de elementos.</div>
								<div class="tj-concept-item"><strong class="tj-accent-text">Objetos / Structs:</strong> Agrupaciones de pares clave-valor o atributos.</div>
							</div>
						</div>
						<div class="tj-col">
							<div class="tj-code-card">
								<div class="tj-code-title">structures.py</div>
								<pre class="tj-code-block"><code><span class="token-comment"># Python List (Doble puntero a Heap)</span>
items = [<span class="token-number">1</span>, <span class="token-string">"dos"</span>, <span class="token-number">3.0</span>]

<span class="token-comment"># C Struct (Bloque continuo contiguo)</span>
<span class="token-keyword">struct</span> Point &#123; <span class="token-type">int</span> x; <span class="token-type">int</span> y; &#125;;</code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 4: STATIC VS DYNAMIC -->
				<div class="tj-slide" data-slide="4">
					<div class="tj-slide-grid">
						<div class="tj-col">
							<h2 class="tj-slide-title">4. {isEs ? 'Estático vs Dinámico & Fuerte vs Débil' : 'Static vs Dynamic & Strong vs Weak'}</h2>
							<div class="tj-concept-box">
								<div class="tj-concept-item">
									<strong class="tj-accent-text">Java (Estático / Fuerte):</strong> Chequeo en compilación; prohíbe operaciones incompatibles.
								</div>
								<div class="tj-concept-item">
									<strong class="tj-accent-text">C (Estático / Nivel Medio):</strong> Chequeo en compilación; permite reinterpretación de punteros.
								</div>
								<div class="tj-concept-item">
									<strong class="tj-accent-text">JavaScript (Dinámico / Débil):</strong> Chequeo en tiempo de ejecución con coherción implícita automática.
								</div>
								<div class="tj-concept-item">
									<strong class="tj-accent-text">Python (Dinámico / Fuerte):</strong> Chequeo en tiempo de ejecución; rechaza conversiones implícitas no válidas.
								</div>
							</div>
						</div>
						<div class="tj-col">
							<div class="tj-code-card">
								<div class="tj-code-title">typing_comparison.js</div>
								<pre class="tj-code-block"><code><span class="token-comment">// JS (Débil): "5" + 2 === "52"</span>
console.log(<span class="token-string">"5"</span> + <span class="token-number">2</span>);

<span class="token-comment"># Python (Fuerte): TypeError!</span>
<span class="token-comment"># print("5" + 2) </span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 5: COERCION -->
				<div class="tj-slide" data-slide="5">
					<div class="tj-slide-grid">
						<div class="tj-col">
							<h2 class="tj-slide-title">5. {isEs ? 'Coherción de Tipos y Casting' : 'Type Coercion & Casting'}</h2>
							<p class="tj-text">
								{isEs 
									? 'La conversión de tipo puede ser explícita (Casting) o implícita (Coherción en runtime).'
									: 'Type conversion can be explicit (Casting) or implicit (Runtime Coercion).'}
							</p>
							<ul class="tj-list">
								<li><strong>{isEs ? 'Casting Explícito:' : 'Explicit Casting:'}</strong> `(int) 3.14` (C/Java), `int("5")` (Python).</li>
								<li><strong>{isEs ? 'Coherción Implícita:' : 'Implicit Coercion:'}</strong> Ocurre automáticamente en JS al usar operadores binarios como `+` o `==`.</li>
							</ul>
						</div>
						<div class="tj-col">
							<div class="tj-code-card">
								<div class="tj-code-title">casting.c</div>
								<pre class="tj-code-block"><code><span class="token-type">double</span> pi = <span class="token-number">3.14159</span>;
<span class="token-type">int</span> entero_pi = (<span class="token-type">int</span>) pi; <span class="token-comment">// Trunca a 3</span>

<span class="token-type">char</span> c = <span class="token-string">'A'</span>;
<span class="token-type">int</span> ascii = (<span class="token-type">int</span>) c; <span class="token-comment">// 65</span></code></pre>
							</div>
						</div>
					</div>
				</div>

				<!-- SLIDE 6: INSPECTOR SIMULATOR -->
				<div class="tj-slide" data-slide="6">
					<div class="tj-sim-container">
						<h2 class="tj-slide-title center">{isEs ? '6. Inspector Interactivo de Tipos' : '6. Interactive Type Inspector'}</h2>
						<p class="tj-sub center">{isEs ? 'Seleccioná una expresión para evaluar la respuesta de cada lenguaje:' : 'Select an expression to evaluate each language result:'}</p>

						<div class="tj-sim-selector">
							<button class="tj-exp-btn active" data-exp="num_str">"10" + 5</button>
							<button class="tj-exp-btn" data-exp="div_zero">10 / 0</button>
							<button class="tj-exp-btn" data-exp="bool_arr">[] == false</button>
						</div>

						<div class="tj-inspector-grid">
							<div class="tj-lang-box">
								<span class="tj-lang-name">JavaScript</span>
								<div class="tj-exp-res" id="res-js">"105" (string)</div>
							</div>
							<div class="tj-lang-box">
								<span class="tj-lang-name">Python</span>
								<div class="tj-exp-res" id="res-py">TypeError: can't concat str to int</div>
							</div>
							<div class="tj-lang-box">
								<span class="tj-lang-name">C</span>
								<div class="tj-exp-res" id="res-c">Error de Compilación (Tipos incompatibles)</div>
							</div>
							<div class="tj-lang-box">
								<span class="tj-lang-name">Java</span>
								<div class="tj-exp-res" id="res-java">"105" (String via StringBuilder)</div>
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="tj-footer">
				<button class="btn btn-secondary" id="btn-prev-tj" disabled>
					← {isEs ? 'Anterior' : 'Previous'}
				</button>
				<div class="tj-footer-meta">
					<span>{isEs ? 'Navegación: Flechas Izq / Der' : 'Navigation: Left / Right Arrows'}</span>
				</div>
				<button class="btn btn-primary" id="btn-next-tj">
					{isEs ? 'Siguiente' : 'Next'} →
				</button>
			</div>
		</div>
	</div>
</div>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap');

	.tj-screen {
		min-height: 80vh;
		font-family: var(--font-body);
		color: var(--color-text);
		padding: 1.5rem 1rem 4rem;
	}

	.tj-shell { max-width: var(--container-max); margin: 0 auto; }
	.tj-header { margin-bottom: 1.5rem; }

	.tj-badge {
		display: inline-flex;
		align-items: center;
		border: 1px solid var(--color-accent-2-300);
		background: var(--color-accent-2-100);
		color: var(--color-accent-2-700);
		border-radius: 999px;
		padding: 0.25rem 0.8rem;
		font-size: 0.75rem;
		font-family: 'Fira Code', monospace;
		font-weight: 600;
	}

	.tj-title {
		font-family: var(--font-heading);
		font-size: clamp(1.8rem, 3.5vw, 2.5rem);
		font-weight: 400;
		line-height: 1.15;
		color: var(--color-text);
		margin: 0.5rem 0 0.25rem;
	}

	.tj-sub { color: color-mix(in srgb, var(--color-text) 75%, transparent); font-size: 0.95rem; margin: 0; }
	.tj-sub.center { text-align: center; }

	.tj-deck-card {
		background: var(--color-surface);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-md);
		overflow: hidden;
	}

	.tj-nav-bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		padding: 0.8rem 1.2rem;
		border-bottom: 1px solid var(--color-divider);
		background: color-mix(in srgb, var(--color-bg) 60%, transparent);
	}

	.tj-slide-indicator {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: 'Fira Code', monospace;
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--color-accent-700);
	}

	.tj-step-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-accent); }
	.tj-pills { display: flex; flex-wrap: wrap; gap: 0.4rem; }

	.tj-pill-btn {
		border: 1px solid var(--color-divider);
		background: var(--color-bg);
		color: var(--color-text);
		border-radius: 999px;
		padding: 0.3rem 0.75rem;
		font-size: 0.78rem;
		font-family: var(--font-body);
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.tj-pill-btn:hover { background: var(--color-accent-100); border-color: var(--color-accent); color: var(--color-accent-700); }
	.tj-pill-btn.active { background: var(--color-accent); border-color: var(--color-accent); color: #ffffff; }

	.tj-viewport { padding: 1.5rem 1.25rem; min-height: 420px; }
	.tj-slide { display: none; opacity: 0; transform: translateY(8px); transition: opacity 0.35s ease, transform 0.35s ease; }
	.tj-slide.active { display: block; opacity: 1; transform: translateY(0); }

	.tj-slide-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem; align-items: start; }
	.tj-col { grid-column: span 12; }
	@media (min-width: 900px) { .tj-col { grid-column: span 6; } }

	.tj-slide-title { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 400; color: var(--color-text); margin: 0 0 0.8rem; }
	.tj-slide-title.center { text-align: center; }

	.tj-text { font-size: 0.95rem; line-height: 1.6; color: color-mix(in srgb, var(--color-text) 85%, transparent); margin-bottom: 1.2rem; }
	.tj-concept-box { display: flex; flex-direction: column; gap: 0.6rem; }
	.tj-concept-item { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.65rem 0.9rem; font-size: 0.88rem; line-height: 1.5; }
	.tj-accent-text { color: var(--color-accent-700); }

	.tj-list { padding-left: 1.2rem; margin: 0 0 1.2rem; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.9rem; }

	.tj-type-card { background: var(--color-bg); border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 1rem; }
	.tj-type-head { font-family: 'Fira Code', monospace; font-size: 0.72rem; font-weight: 700; color: var(--color-accent-2-700); margin-bottom: 0.75rem; }
	.tj-cell { display: flex; justify-content: space-between; align-items: center; border: 1px solid var(--color-divider); background: var(--color-surface); border-radius: var(--radius-sm); padding: 0.6rem 0.8rem; margin-bottom: 0.5rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; }
	.tj-tag { color: var(--color-accent-700); font-weight: 600; }

	.tj-code-card { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); overflow: hidden; box-shadow: var(--shadow-sm); }
	.tj-code-title { background: #2b2722; color: #c0b6a5; padding: 0.4rem 0.8rem; font-family: 'Fira Code', monospace; font-size: 0.75rem; border-bottom: 1px solid #3a352e; }
	.tj-code-block { margin: 0; padding: 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; line-height: 1.6; color: #f9f4ed; overflow-x: auto; }

	.token-keyword { color: #e59866; font-weight: 600; }
	.token-type { color: #76d7c4; }
	.token-number { color: #f8c471; }
	.token-string { color: #abebc6; }
	.token-comment { color: #85929e; font-style: italic; }

	/* Simulator */
	.tj-sim-container { max-width: 800px; margin: 0 auto; }
	.tj-sim-selector { display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 1.2rem; flex-wrap: wrap; }
	.tj-exp-btn { border: 1px solid var(--color-divider); background: var(--color-bg); color: var(--color-text); border-radius: 999px; padding: 0.35rem 0.9rem; font-family: 'Fira Code', monospace; font-size: 0.82rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease; }
	.tj-exp-btn:hover { background: var(--color-accent-100); color: var(--color-accent-700); }
	.tj-exp-btn.active { background: var(--color-accent-700); border-color: var(--color-accent-700); color: #ffffff; }

	.tj-inspector-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.8rem; }
	@media (max-width: 600px) { .tj-inspector-grid { grid-template-columns: repeat(1, minmax(0, 1fr)); } }

	.tj-lang-box { background: #1e1b18; border: 1px solid var(--color-divider); border-radius: var(--radius-md); padding: 0.8rem; }
	.tj-lang-name { font-family: 'Fira Code', monospace; font-size: 0.75rem; font-weight: 700; color: #e59866; display: block; margin-bottom: 0.4rem; }
	.tj-exp-res { font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #f9f4ed; background: #141210; padding: 0.5rem 0.7rem; border-radius: var(--radius-sm); }

	.tj-footer { display: flex; align-items: center; justify-content: space-between; padding: 0.8rem 1.2rem; border-top: 1px solid var(--color-divider); background: color-mix(in srgb, var(--color-bg) 60%, transparent); }
	.tj-footer-meta { font-size: 0.78rem; color: color-mix(in srgb, var(--color-text) 60%, transparent); }
	.btn:disabled { opacity: 0.45; cursor: not-allowed; }
</style>

<script>
	let currentSlide = 1;
	const totalSlides = 6;

	const inspectorData = {
		num_str: {
			js: '"105" (string)',
			py: 'TypeError: can\'t concat str to int',
			c: 'Error de Compilación (Tipos incompatibles)',
			java: '"105" (String via StringBuilder)'
		},
		div_zero: {
			js: 'Infinity (number)',
			py: 'ZeroDivisionError: division by zero',
			c: 'Comportamiento Indefinido / Warning (Zero Div)',
			java: 'ArithmeticException: / by zero (en enteros)'
		},
		bool_arr: {
			js: 'true (Coherción implícita: [] -> "" -> 0, false -> 0)',
			py: 'False (Comparación estricta de identidad/valor)',
			c: 'Error de Sintaxis (Tipos no comparables)',
			java: 'Error de Compilación (boolean vs Object)'
		}
	};

	const goToSlide = (slideNum: number) => {
		if (slideNum < 1 || slideNum > totalSlides) return;
		currentSlide = slideNum;

		document.querySelectorAll('.tj-slide').forEach(s => {
			const el = s as HTMLElement;
			el.classList.remove('active');
			if (parseInt(el.dataset.slide || '0') === currentSlide) el.classList.add('active');
		});

		document.querySelectorAll('.tj-pill-btn').forEach(b => {
			const btn = b as HTMLElement;
			btn.classList.remove('active');
			if (parseInt(btn.dataset.targetSlide || '0') === currentSlide) btn.classList.add('active');
		});

		const labelEl = document.getElementById('tj-slide-label');
		if (labelEl) labelEl.textContent = `SLIDE ${currentSlide} / ${totalSlides}`;

		const prevBtn = document.getElementById('btn-prev-tj') as HTMLButtonElement;
		const nextBtn = document.getElementById('btn-next-tj') as HTMLButtonElement;
		if (prevBtn) prevBtn.disabled = currentSlide === 1;
		if (nextBtn) nextBtn.disabled = currentSlide === totalSlides;
	};

	document.querySelectorAll('.tj-pill-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			const target = (e.currentTarget as HTMLElement).dataset.targetSlide;
			if (target) goToSlide(parseInt(target));
		});
	});

	document.getElementById('btn-prev-tj')?.addEventListener('click', () => goToSlide(currentSlide - 1));
	document.getElementById('btn-next-tj')?.addEventListener('click', () => goToSlide(currentSlide + 1));

	document.addEventListener('keydown', (e) => {
		if (e.key === 'ArrowRight') goToSlide(currentSlide + 1);
		if (e.key === 'ArrowLeft') goToSlide(currentSlide - 1);
	});

	document.querySelectorAll('.tj-exp-btn').forEach(btn => {
		btn.addEventListener('click', (e) => {
			document.querySelectorAll('.tj-exp-btn').forEach(b => b.classList.remove('active'));
			const targetBtn = e.currentTarget as HTMLElement;
			targetBtn.classList.add('active');

			const expKey = targetBtn.dataset.exp as keyof typeof inspectorData;
			const data = inspectorData[expKey];
			if (data) {
				const resJs = document.getElementById('res-js');
				const resPy = document.getElementById('res-py');
				const resC = document.getElementById('res-c');
				const resJava = document.getElementById('res-java');

				if (resJs) resJs.textContent = data.js;
				if (resPy) resPy.textContent = data.py;
				if (resC) resC.textContent = data.c;
				if (resJava) resJava.textContent = data.java;
			}
		});
	});

	goToSlide(1);
</script>
