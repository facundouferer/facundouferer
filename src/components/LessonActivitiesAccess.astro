---
import { useTranslations } from '../i18n/utils';
import { withBase } from '../utils/withBase';

type Props = {
	course: string;
	lesson: string;
	count: number;
	locale: 'es' | 'en';
};

const { course, lesson, count, locale } = Astro.props;

if (!count || count <= 0) {
	return null;
}

const t = useTranslations(locale);
const countLabel =
	count === 1
		? t('courses.activities.badge.one')
		: t('courses.activities.badge.other').replace('{count}', String(count));
const label = `${t('courses.activities.accessLabel')} (${countLabel})`;
const href =
	locale === 'es'
		? `/cursos/${course}/${lesson}/actividades`
		: `/en/courses/${course}/${lesson}/actividades`;
---

<a
	href={withBase(href)}
	class="btn btn-secondary lesson-activities-access"
	aria-label={label}
	title={label}
>
	<svg
		aria-hidden="true"
		xmlns="http://www.w3.org/2000/svg"
		width="18"
		height="18"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2.75"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		<path d="m3 17 2 2 4-4" />
		<path d="m3 7 2 2 4-4" />
		<path d="M13 6h8" />
		<path d="M13 12h8" />
		<path d="M13 18h8" />
	</svg>
	<span>{t('courses.activities.heading')}</span>
	<span class="lesson-activities-count-badge" aria-hidden="true">{count}</span>
</a>

<style>
	.lesson-activities-access {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: calc(var(--space-1) * 1.2) var(--space-3);
		color: var(--color-accent-700);
		vertical-align: middle;
	}

	.lesson-activities-count-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 11px;
		font-weight: 700;
		line-height: 1;
		padding: 2px 6px;
		border-radius: 999px;
		background: var(--color-accent);
		color: var(--color-bg);
	}
</style>
