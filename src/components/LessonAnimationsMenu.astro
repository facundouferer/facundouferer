---
import type { Animation } from '../data/animations';
import { useTranslations } from '../i18n/utils';
import { withBase } from '../utils/withBase';

type Props = {
	animations: Animation[];
	locale: 'es' | 'en';
};

const { animations, locale } = Astro.props;

if (!animations || animations.length === 0) {
	return null;
}

const t = useTranslations(locale);
const count = animations.length;
const countLabel =
	count === 1
		? t('courses.lessonAnimations.badge.one')
		: t('courses.lessonAnimations.badge.other').replace('{count}', String(count));

const triggerLabel = `${t('courses.lessonAnimations.menuButtonLabel')} (${countLabel})`;
---

<div class="lesson-animations-menu-wrapper">
	<button
		type="button"
		class="btn btn-secondary lesson-animations-trigger"
		aria-haspopup="dialog"
		aria-expanded="false"
		aria-controls="lesson-animations-panel"
		aria-label={triggerLabel}
		title={triggerLabel}
		data-lesson-animations-trigger
	>
		<svg
			aria-hidden="true"
			xmlns="http://www.w3.org/2000/svg"
			width="18"
			height="18"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2.75"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1.1-.3 2.2.3 2.5 1.3Z" />
			<path d="m6.2 5.3 3.1 3.9" />
			<path d="m12.4 3.4 3.1 4" />
			<path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
		</svg>
		<span class="trigger-count-badge" aria-hidden="true">{count}</span>
	</button>

	<div
		id="lesson-animations-panel"
		class="lesson-animations-panel card elev-md"
		role="dialog"
		aria-label={t('courses.lessonAnimations.menuHeading')}
		data-lesson-animations-panel
		hidden
	>
		<div class="panel-header">
			<span class="panel-title">{t('courses.lessonAnimations.menuHeading')}</span>
			<span class="tag tag-accent">{count}</span>
		</div>
		<ul class="animations-list" role="list">
			{
				animations.map((animation) => {
					const href = locale === 'es' ? `/animaciones/${animation.slug}` : `/en/animaciones/${animation.slug}`;
					const title = animation.title[locale];
					const tag = animation.tag[locale];

					return (
						<li class="animation-item">
							<a href={withBase(href)} class="animation-link">
								<span class="tag tag-accent animation-tag">{tag}</span>
								<span class="animation-title">{title}</span>
								<span class="animation-arrow" aria-hidden="true">
									→
								</span>
							</a>
						</li>
					);
				})
			}
		</ul>
	</div>
</div>

<script>
	function setupLessonAnimationsMenu() {
		const trigger = document.querySelector<HTMLButtonElement>('[data-lesson-animations-trigger]');
		const panel = document.querySelector<HTMLElement>('[data-lesson-animations-panel]');
		if (!trigger || !panel) return;
		if (trigger.dataset.ready === 'true') return;
		trigger.dataset.ready = 'true';

		function toggleMenu(open: boolean) {
			if (!trigger || !panel) return;
			panel.hidden = !open;
			trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
			if (open) {
				const firstLink = panel.querySelector<HTMLAnchorElement>('a');
				firstLink?.focus();
			}
		}

		trigger.addEventListener('click', () => {
			toggleMenu(panel.hidden);
		});

		document.addEventListener('click', (event) => {
			const target = event.target as Node | null;
			if (!panel.hidden && target && !panel.contains(target) && !trigger.contains(target)) {
				toggleMenu(false);
			}
		});

		window.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !panel.hidden) {
				toggleMenu(false);
				trigger.focus();
			}
		});
	}

	setupLessonAnimationsMenu();
	document.addEventListener('astro:page-load', setupLessonAnimationsMenu);
</script>

<style>
	.lesson-animations-menu-wrapper {
		position: relative;
		display: inline-block;
		vertical-align: middle;
	}

	.lesson-animations-trigger {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: calc(var(--space-1) * 1.2) var(--space-3);
		border-radius: 999px;
		color: var(--color-accent-700);
		background: var(--color-surface);
		border: 1px solid var(--color-divider);
		cursor: pointer;
		font-family: var(--font-body);
		font-size: 13px;
		line-height: 1;
		transition: background-color 0.15s ease, border-color 0.15s ease;
	}

	.lesson-animations-trigger:hover {
		background: color-mix(in srgb, var(--color-accent) 10%, var(--color-surface));
		border-color: var(--color-accent);
	}

	.lesson-animations-trigger[aria-expanded='true'] {
		background: color-mix(in srgb, var(--color-accent) 15%, var(--color-surface));
		border-color: var(--color-accent);
	}

	.trigger-count-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 11px;
		font-weight: 700;
		line-height: 1;
		padding: 2px 6px;
		border-radius: 999px;
		background: var(--color-accent);
		color: var(--color-bg);
	}

	/* .card sets display: flex, which would override the native [hidden]. */
	.lesson-animations-panel[hidden] {
		display: none !important;
	}

	.lesson-animations-panel {
		position: absolute;
		top: calc(100% + var(--space-2));
		right: 0;
		min-width: 280px;
		max-width: 360px;
		background: var(--color-surface);
		border: 1px solid var(--color-divider);
		border-radius: var(--radius-md);
		padding: var(--space-3);
		z-index: 50;
	}

	.panel-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		margin-bottom: var(--space-3);
		padding-bottom: var(--space-2);
		border-bottom: 1px solid var(--color-divider);
	}

	.panel-title {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: 0.95rem;
		color: var(--color-text);
	}

	.animations-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.animation-item {
		margin: 0;
	}

	.animation-link {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2);
		border-radius: var(--radius-sm);
		text-decoration: none;
		color: var(--color-text);
		transition: background-color 0.15s ease;
	}

	.animation-link:hover {
		background: color-mix(in srgb, var(--color-accent) 8%, transparent);
	}

	.animation-tag {
		font-size: 11px;
		padding: 2px 6px;
		flex-shrink: 0;
	}

	.animation-title {
		flex: 1;
		font-size: 13px;
		font-weight: 600;
		line-height: 1.3;
	}

	.animation-arrow {
		color: var(--color-accent-700);
		font-weight: 700;
		transition: transform 0.15s ease;
	}

	.animation-link:hover .animation-arrow {
		transform: translateX(2px);
	}

	@media (width <= 480px) {
		.lesson-animations-panel {
			right: auto;
			left: 0;
			max-width: calc(100vw - 48px);
		}
	}
</style>
