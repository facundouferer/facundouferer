---
import type { Animation } from '../data/animations';
import { useTranslations } from '../i18n/utils';
import { withBase } from '../utils/withBase';

type Props = {
	animations: Animation[];
	locale: 'es' | 'en';
};

const { animations, locale } = Astro.props;
const t = useTranslations(locale);
---

{
	animations.length > 0 && (
		<section class="lesson-animations">
			<h2 class="lesson-animations-heading">{t('courses.lessonAnimations.heading')}</h2>
			<ul class="lesson-animations-grid">
				{animations.map((animation) => {
					const href = locale === 'es' ? `/animaciones/${animation.slug}` : `/en/animaciones/${animation.slug}`;
					const title = animation.title[locale];
					const description = animation.description[locale];
					const tag = animation.tag[locale];
					const minutes = t('animations.card.minutes').replace('{minutes}', String(animation.minutes));
					return (
						<li class="lesson-animation-item">
							<a class="card card-hover elev-sm lesson-animation-card" href={withBase(href)}>
								<div class="lesson-animation-image">
									<img src={withBase(animation.image)} alt={title} loading="lazy" />
								</div>
								<span class="lesson-animation-tags">
									<span class="tag tag-accent">{tag}</span>
									<span class="badge">
										<svg
											aria-hidden="true"
											xmlns="http://www.w3.org/2000/svg"
											width="13"
											height="13"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2.75"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d="M20.2 6 3 11l-.9-2.4c-.3-1.1.3-2.2 1.3-2.5l13.5-4c1.1-.3 2.2.3 2.5 1.3Z" />
											<path d="m6.2 5.3 3.1 3.9" />
											<path d="m12.4 3.4 3.1 4" />
											<path d="M3 11h18v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
										</svg>
										{minutes}
									</span>
								</span>
								<h3 class="card-title">{title}</h3>
								<p class="card-body">{description}</p>
								<span class="card-meta lesson-animation-open">{t('animations.card.open')} →</span>
							</a>
						</li>
					);
				})}
			</ul>
		</section>
	)
}

<style>
	.lesson-animations {
		margin-top: var(--space-8);
		padding-top: var(--space-6);
		border-top: 1px dashed var(--color-divider);
	}

	.lesson-animations-heading {
		font-family: var(--font-heading);
		font-weight: var(--font-heading-weight);
		font-size: 1.3rem;
		margin: 0 0 var(--space-4);
	}

	.lesson-animations-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
	}

	@media (min-width: 640px) {
		.lesson-animations-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	.lesson-animation-item {
		margin: 0;
		display: flex;
	}

	.lesson-animation-card {
		width: 100%;
		text-decoration: none;
		color: var(--color-text);
		border: 1px solid var(--color-divider);
	}

	.lesson-animation-image {
		border-radius: var(--radius-md);
		overflow: hidden;
	}

	.lesson-animation-image img {
		display: block;
		width: 100%;
		height: 140px;
		object-fit: cover;
	}

	.lesson-animation-tags {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
	}

	.lesson-animation-open {
		margin-top: auto;
		font-weight: 600;
		color: var(--color-accent-700);
	}
</style>
