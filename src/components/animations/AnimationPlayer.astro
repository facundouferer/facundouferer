---
/**
 * Generic engine for step-by-step explanatory animations.
 *
 * The parent animation component resolves its script for one locale and
 * passes the steps here, plus the diagram scenes through the `scene` slot.
 * Every step is server-rendered (narration, code and terminal panels) so no
 * UI string is ever written by the client script; the script only toggles
 * classes, moves between steps and drives autoplay.
 */
import { getCollection } from 'astro:content';
import { getLessonForAnimation } from '../../data/animations';
import { useTranslations, type Locale } from '../../i18n/utils';
import { highlightCode } from '../../utils/highlightCode';
import { renderInlineCode } from '../../utils/renderInlineCode';
import { withBase } from '../../utils/withBase';
import type { ResolvedStep } from '../../utils/animations';

type Props = {
	lang: Locale;
	slug: string;
	title: string;
	steps: ResolvedStep[];
};

const { lang, slug, title, steps } = Astro.props;
const t = useTranslations(lang);

const total = steps.length;

// The lesson that owns the animation: the controls link back to it.
const lessonRef = getLessonForAnimation(slug);
const lesson = lessonRef
	? (await getCollection('lessons')).find(
			(entry) =>
				entry.data.course === lessonRef.course &&
				entry.data.slug === lessonRef.slug &&
				entry.data.lang === lang &&
				entry.data.published,
		)
	: undefined;
const lessonHref = lessonRef
	? withBase(
			lang === 'en'
				? `/en/courses/${lessonRef.course}/${lessonRef.slug}`
				: `/cursos/${lessonRef.course}/${lessonRef.slug}`,
		)
	: undefined;
---

<section class="anim-player" data-anim-player data-slug={slug} data-total={total}>
	<!-- The visible chrome is kept to the animation itself; the title stays for assistive tech and the outline. -->
	<h1 class="anim-visually-hidden">{title}</h1>

	<div class="anim-board">
		<div class="anim-stage card elev-sm" data-anim-stage role="group" aria-label={t('animations.stage')}>
			<slot name="scene" />
		</div>

		{
			steps.map((step) => {
				const show = step.show === '*' ? '*' : step.show.join(' ');
				const focus = (step.focus ?? []).join(' ');
				const codeLines = step.code ? highlightCode(step.code.source, step.code.language) : [];
				const focusLines = new Set(step.code?.focusLines ?? []);
				return (
					<div
						class="anim-step"
						data-anim-step={step.index}
						data-step-chapter={step.chapter}
						data-step-scene={step.scene}
						data-show={show}
						data-focus={focus}
						data-cues={step.motion ? JSON.stringify(step.motion.cues) : undefined}
						data-duration={step.duration}
						aria-hidden="true"
					>
						<div class="anim-subtitles" aria-hidden="true">
							<div class="anim-subtitle-track">
								{step.subtitles.map((sub) => (
									<p class="anim-subtitle" data-sub-at={sub.at} set:html={renderInlineCode(sub.text)} />
								))}
							</div>
						</div>
						<article class="anim-narration">
							<h2 class="anim-step-title">{step.title}</h2>
							<p class="anim-step-text" set:html={renderInlineCode(step.text)} />
						</article>

						{(step.code || step.shell) && (
							<div class:list={['anim-panels', { 'anim-panels--two': !!(step.code && step.shell) }]}>
								{step.code && (
									<div class="anim-terminal anim-terminal--code">
										<div class="anim-terminal-bar">
											<span class="anim-terminal-dots" aria-hidden="true">
												<i />
												<i />
												<i />
											</span>
											<span class="anim-terminal-title">{step.code.title}</span>
											<span class="anim-terminal-lang">{step.code.language}</span>
										</div>
										<pre class="anim-terminal-body" data-has-focus={focusLines.size > 0 ? 'true' : undefined}><code class="anim-lines">{codeLines.map((html, index) => {
											const indent = html.match(/^ */)?.[0].length ?? 0;
											return (
												<span class:list={['anim-line', { 'is-focus': focusLines.has(index + 1) }]} style={`--i:${index};--indent:${indent}ch`}><span class="anim-code" set:html={html.slice(indent) || ' '} /></span>
											);
										})}</code></pre>
									</div>
								)}
								{step.shell && (
									<div class="anim-terminal anim-terminal--shell">
										<div class="anim-terminal-bar">
											<span class="anim-terminal-dots" aria-hidden="true">
												<i />
												<i />
												<i />
											</span>
											<span class="anim-terminal-title">{step.shell.title ?? t('animations.terminal')}</span>
											<span class="anim-terminal-lang">bash</span>
										</div>
										<pre class="anim-terminal-body"><code class="anim-lines">{step.shell.lines.map((line, index) => (
											<span class={`anim-line anim-line--${line.kind}`} style={`--i:${index}`}><span class="anim-code" set:html={highlightCode(line.text, line.kind === 'cmd' ? 'bash' : 'text')[0] || ' '} /></span>
										))}<span class="anim-line anim-line--cursor" style={`--i:${step.shell.lines.length}`} aria-hidden="true" /></code></pre>
									</div>
								)}
							</div>
						)}
					</div>
				);
			})
		}
	</div>

	<div class="anim-controls" role="group" aria-label={t('animations.controls.region')}>
		<div class="anim-buttons">
			<button type="button" class="btn btn-secondary" data-anim-prev aria-label={t('animations.controls.prev')}>
				<svg
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.75"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="m15 18-6-6 6-6" />
				</svg>
				<span class="anim-btn-label">{t('animations.controls.prev')}</span>
			</button>

			<button type="button" class="btn btn-primary anim-play" data-anim-play aria-pressed="false">
				<svg
					class="anim-icon-play"
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="currentColor"
					stroke="currentColor"
					stroke-width="2.75"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<polygon points="6 3 20 12 6 21 6 3" />
				</svg>
				<svg
					class="anim-icon-pause"
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="currentColor"
					stroke="currentColor"
					stroke-width="2.75"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<rect x="14" y="4" width="4" height="16" rx="1" />
					<rect x="6" y="4" width="4" height="16" rx="1" />
				</svg>
				<span class="anim-label-play">{t('animations.controls.play')}</span>
				<span class="anim-label-pause">{t('animations.controls.pause')}</span>
			</button>

			<button type="button" class="btn btn-secondary" data-anim-next aria-label={t('animations.controls.next')}>
				<span class="anim-btn-label">{t('animations.controls.next')}</span>
				<svg
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.75"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="m9 18 6-6-6-6" />
				</svg>
			</button>

			<button type="button" class="btn btn-ghost" data-anim-restart>
				<svg
					aria-hidden="true"
					xmlns="http://www.w3.org/2000/svg"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.75"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
					<path d="M3 3v5h5" />
				</svg>
				<span class="anim-btn-label">{t('animations.controls.restart')}</span>
			</button>
		</div>

		<div class="anim-meta">
			<p class="anim-counter text-muted" aria-live="polite" aria-atomic="true">
				{t('animations.stepCounter.label')} <span data-anim-current>1</span> {t('animations.stepCounter.of')} {total}
			</p>
			{
				lessonHref && (
					<a class="btn btn-ghost anim-back" href={lessonHref} title={lesson?.data.title} data-anim-back>
						<svg
							aria-hidden="true"
							xmlns="http://www.w3.org/2000/svg"
							width="18"
							height="18"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2.75"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M12 7v14" />
							<path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z" />
						</svg>
						<span class="anim-btn-label">{t('animations.controls.backToLesson')}</span>
					</a>
				)
			}
		</div>
		<p class="anim-visually-hidden" aria-live="polite" aria-atomic="true" data-anim-announce></p>

		<div class="anim-progress" aria-hidden="true">
			<span class="anim-progress-fill" data-anim-progress></span>
		</div>
	</div>
</section>

<script>
	import { MOTION_CUE_DEFAULT_MS } from '../../utils/animations';
	import type { MotionCue } from '../../data/animations/types';

	type Point = { x: number; y: number };
	type ElementState = { opacity: number; x: number; y: number; scale: number; flow: boolean };
	type Camera = { x: number; y: number; s: number };

	/** Live state of a motion scene: what every element and the camera look like right now. */
	interface MotionModel {
		sceneId: string;
		stepIndex: number;
		svg: SVGSVGElement;
		camera: SVGGElement | null;
		els: Map<string, SVGGraphicsElement>;
		state: Map<string, ElementState>;
		cam: Camera;
	}

	const EASE_OUT = 'cubic-bezier(0.2, 0.8, 0.2, 1)';
	const EASE_IN_OUT = 'cubic-bezier(0.65, 0, 0.35, 1)';
	const EASE_POP = 'cubic-bezier(0.34, 1.56, 0.64, 1)';
	const IDENTITY: Camera = { x: 0, y: 0, s: 1 };

	const cameraTransform = (cam: Camera) => `translate(${cam.x}px, ${cam.y}px) scale(${cam.s})`;
	const translateOf = (point: Point) => `${point.x}px ${point.y}px`;
	const percent = (value: number) => `${Math.max(0, Math.min(1, value)) * 100}%`;

	/** Keyframes along a soft upward arc, so travelling objects glide instead of sliding. */
	function arcFrames(from: Point, to: Point): Keyframe[] {
		const lift = Math.min(90, Math.hypot(to.x - from.x, to.y - from.y) * 0.22);
		const control = { x: (from.x + to.x) / 2, y: Math.min(from.y, to.y) - lift };
		const frames: Keyframe[] = [];
		for (let i = 0; i <= 12; i += 1) {
			const t = i / 12;
			const u = 1 - t;
			frames.push({
				translate: translateOf({
					x: u * u * from.x + 2 * u * t * control.x + t * t * to.x,
					y: u * u * from.y + 2 * u * t * control.y + t * t * to.y,
				}),
			});
		}
		return frames;
	}

	function setupAnimationPlayer(root: HTMLElement) {
		if (root.dataset.ready === 'true') return;
		root.dataset.ready = 'true';

		const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-anim-step]'));
		const scenes = Array.from(root.querySelectorAll<HTMLElement>('[data-anim-stage] [data-scene]'));
		const prevBtn = root.querySelector<HTMLButtonElement>('[data-anim-prev]');
		const nextBtn = root.querySelector<HTMLButtonElement>('[data-anim-next]');
		const playBtn = root.querySelector<HTMLButtonElement>('[data-anim-play]');
		const restartBtn = root.querySelector<HTMLButtonElement>('[data-anim-restart]');
		const counter = root.querySelector<HTMLElement>('[data-anim-current]');
		const announcer = root.querySelector<HTMLElement>('[data-anim-announce]');
		const progress = root.querySelector<HTMLElement>('[data-anim-progress]');
		const total = steps.length;
		if (total === 0) return;

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let current = -1;
		let playing = false;
		// One clock per step: it drives autoplay and freezes with everything else on pause.
		let clock: Animation | null = null;
		let progressRun: Animation | null = null;
		let motion: MotionModel | null = null;
		let running: Animation[] = [];

		// ── Slide steps: reveal and emphasize elements of a static diagram ──────
		function applyScene(step: HTMLElement) {
			const sceneId = step.dataset.stepScene;
			const show = step.dataset.show ?? '';
			const showAll = show === '*';
			const showList = showAll ? [] : show.split(' ').filter(Boolean);
			const focus = (step.dataset.focus ?? '').split(' ').filter(Boolean);

			for (const scene of scenes) {
				const active = scene.dataset.scene === sceneId;
				scene.classList.toggle('is-active', active);
				if (!active) continue;

				let order = 0;
				for (const el of Array.from(scene.querySelectorAll<HTMLElement>('[data-el]'))) {
					const id = el.dataset.el ?? '';
					const shown = showAll || showList.includes(id);
					if (shown && !el.classList.contains('is-shown')) {
						el.style.setProperty('--i', String(order));
						order += 1;
					}
					el.classList.toggle('is-shown', shown);
					el.classList.toggle('is-lit', shown && focus.includes(id));
				}
				scene.classList.toggle('has-focus', focus.length > 0);
			}
		}

		// ── Motion steps: a persistent canvas choreographed by timed cues ───────
		function cuesOf(step: HTMLElement): MotionCue[] {
			if (!step.dataset.cues) return [];
			try {
				return JSON.parse(step.dataset.cues) as MotionCue[];
			} catch {
				return [];
			}
		}

		function buildMotion(sceneId: string): MotionModel | null {
			const scene = scenes.find((candidate) => candidate.dataset.scene === sceneId);
			const svg = scene?.querySelector<SVGSVGElement>('svg.mg-canvas');
			if (!svg) return null;
			const els = new Map<string, SVGGraphicsElement>();
			const state = new Map<string, ElementState>();
			for (const el of Array.from(svg.querySelectorAll<SVGGraphicsElement>('[data-el]'))) {
				const id = el.dataset.el ?? '';
				els.set(id, el);
				state.set(id, {
					opacity: el.dataset.base === 'shown' ? 1 : 0,
					x: Number(el.dataset.x ?? 0),
					y: Number(el.dataset.y ?? 0),
					scale: 1,
					flow: false,
				});
			}
			return {
				sceneId,
				stepIndex: -1,
				svg,
				camera: svg.querySelector<SVGGElement>('[data-camera]'),
				els,
				state,
				cam: { ...IDENTITY },
			};
		}

		/** Writes the model as inline styles: the resting state between animations. */
		function commit(m: MotionModel) {
			for (const [id, el] of m.els) {
				const s = m.state.get(id);
				if (!s) continue;
				el.style.opacity = String(s.opacity);
				el.style.setProperty('translate', s.x || s.y ? translateOf(s) : '');
				el.style.setProperty('scale', s.scale === 1 ? '' : String(s.scale));
				el.classList.toggle('is-flowing', s.flow);
			}
			if (m.camera) m.camera.style.transform = cameraTransform(m.cam);
		}

		function lookup(m: MotionModel, id: string): SVGGraphicsElement | null {
			return m.els.get(id) ?? m.svg.querySelector<SVGGraphicsElement>(`[data-anchor="${id}"]`);
		}

		function centerOf(m: MotionModel, id: string): Point | null {
			const el = lookup(m, id);
			if (!el) return null;
			const box = el.getBBox();
			return { x: box.x + box.width / 2, y: box.y + box.height / 2 };
		}

		/** Camera that centers the given elements and zooms until they fill the canvas. */
		function frame(m: MotionModel, ids: string[] | 'all', pad: number): Camera {
			if (ids === 'all') return { ...IDENTITY };
			const view = m.svg.viewBox.baseVal;
			let minX = Infinity;
			let minY = Infinity;
			let maxX = -Infinity;
			let maxY = -Infinity;
			for (const id of ids) {
				const el = lookup(m, id);
				if (!el) continue;
				const box = el.getBBox();
				minX = Math.min(minX, box.x);
				minY = Math.min(minY, box.y);
				maxX = Math.max(maxX, box.x + box.width);
				maxY = Math.max(maxY, box.y + box.height);
			}
			if (!Number.isFinite(minX)) return { ...m.cam };
			const fit = Math.min(view.width / (maxX - minX + pad * 2), view.height / (maxY - minY + pad * 2));
			const s = Math.min(3, Math.max(0.5, fit));
			return {
				x: view.x + view.width / 2 - s * ((minX + maxX) / 2),
				y: view.y + view.height / 2 - s * ((minY + maxY) / 2),
				s,
			};
		}

		/**
		 * Applies one cue to the model and, when `animate` is set, schedules the Web
		 * Animations that play it. Without `animate` it only fast-forwards the model,
		 * which is how earlier steps are replayed when jumping into a scene.
		 */
		function runCue(m: MotionModel, cue: MotionCue, animate: boolean) {
			const reduced = reducedMotion.matches;
			const duration = reduced ? 1 : (cue.dur ?? MOTION_CUE_DEFAULT_MS[cue.do]);
			const schedule = (target: Element, frames: Keyframe[], options: KeyframeAnimationOptions = {}) => {
				if (!animate) return;
				running.push(target.animate(frames, { duration, delay: cue.at, fill: 'forwards', easing: EASE_OUT, ...options }));
			};
			const transient = (target: Element, frames: Keyframe[], options: KeyframeAnimationOptions = {}) => {
				if (!animate || reduced) return;
				running.push(target.animate(frames, { duration, delay: cue.at, easing: EASE_IN_OUT, ...options }));
			};

			if (cue.do === 'camera') {
				const from = m.cam;
				m.cam = frame(m, cue.to, cue.pad ?? 40);
				if (m.camera) {
					schedule(m.camera, [{ transform: cameraTransform(from) }, { transform: cameraTransform(m.cam) }], { easing: EASE_IN_OUT });
				}
				return;
			}

			const el = m.els.get(cue.el);
			const s = m.state.get(cue.el);
			if (!el || !s) return;

			switch (cue.do) {
				case 'enter': {
					const from = s.opacity;
					s.opacity = 1;
					s.scale = 1;
					schedule(el, [{ opacity: from, scale: from < 1 ? 0.8 : 1 }, { opacity: 1, scale: 1 }], { easing: EASE_POP });
					break;
				}
				case 'exit': {
					s.opacity = 0;
					schedule(el, [{ opacity: 1, scale: 1 }, { opacity: 0, scale: 0.8 }]);
					break;
				}
				case 'draw': {
					s.opacity = 1;
					schedule(el, [{ opacity: 1 }, { opacity: 1 }]);
					for (const path of Array.from(el.querySelectorAll('.mg-stroke'))) {
						schedule(path, [{ strokeDasharray: '1 1', strokeDashoffset: '1' }, { strokeDasharray: '1 1', strokeDashoffset: '0' }], { easing: EASE_IN_OUT });
					}
					for (const head of Array.from(el.querySelectorAll('.mg-head'))) {
						schedule(head, [{ opacity: 0 }, { opacity: 0, offset: 0.7 }, { opacity: 1 }]);
					}
					break;
				}
				case 'type': {
					s.opacity = 1;
					const characters = Math.max(1, (el.textContent ?? '').trim().length);
					schedule(el, [{ opacity: 1, clipPath: 'inset(0 100% 0 0)' }, { opacity: 1, clipPath: 'inset(0 0% 0 0)' }], {
						easing: `steps(${characters}, end)`,
					});
					break;
				}
				case 'flow': {
					s.flow = true;
					if (!animate || reduced) break;
					for (const path of Array.from(el.querySelectorAll('.mg-stroke'))) {
						running.push(
							path.animate(
								[{ strokeDasharray: '0.03 0.025', strokeDashoffset: '0' }, { strokeDasharray: '0.03 0.025', strokeDashoffset: '-0.055' }],
								{ duration: 1100, delay: cue.at, iterations: Infinity, easing: 'linear' },
							),
						);
					}
					break;
				}
				case 'pulse': {
					transient(el, [{ scale: 1 }, { scale: 1.08, offset: 0.4 }, { scale: 1 }]);
					break;
				}
				case 'spin': {
					for (const part of Array.from(el.querySelectorAll('.mg-spin'))) {
						transient(part, [{ rotate: '0deg' }, { rotate: '720deg' }]);
					}
					break;
				}
				case 'move': {
					const target = centerOf(m, cue.to);
					if (!target) break;
					const from = { x: s.x, y: s.y };
					s.x = target.x + (cue.dx ?? 0);
					s.y = target.y + (cue.dy ?? 0);
					schedule(el, reduced ? [{ translate: translateOf(from) }, { translate: translateOf(s) }] : arcFrames(from, s), {
						easing: EASE_IN_OUT,
					});
					break;
				}
			}
		}

		/** Captions take turns in the same spot, each one until the next starts. */
		function runSubtitles(step: HTMLElement) {
			const subs = Array.from(step.querySelectorAll<HTMLElement>('[data-sub-at]'));
			const fade = reducedMotion.matches ? 1 : 320;
			const rise = reducedMotion.matches ? '0 0' : '0 10px';
			subs.forEach((sub, index) => {
				const at = Number(sub.dataset.subAt ?? 0);
				const next = subs[index + 1];
				if (!next) {
					running.push(
						sub.animate([{ opacity: 0, translate: rise }, { opacity: 1, translate: '0 0' }], {
							duration: fade,
							delay: at,
							fill: 'forwards',
							easing: EASE_OUT,
						}),
					);
					return;
				}
				const span = Math.max(Number(next.dataset.subAt ?? 0) - at, fade * 2 + 1);
				running.push(
					sub.animate(
						[
							{ opacity: 0, translate: rise },
							{ opacity: 1, translate: '0 0', offset: fade / span },
							{ opacity: 1, translate: '0 0', offset: 1 - fade / span },
							{ opacity: 0, translate: '0 0' },
						],
						{ duration: span, delay: at, fill: 'forwards' },
					),
				);
			});
		}

		/** Jumps the running step to its end state and drops its animations. */
		function settle() {
			for (const animation of running) animation.cancel();
			running = [];
			if (motion) commit(motion);
		}

		function enterMotionStep(index: number) {
			const step = steps[index];
			const sceneId = step.dataset.stepScene ?? '';
			for (const scene of scenes) scene.classList.toggle('is-active', scene.dataset.scene === sceneId);

			let m = motion;
			if (!m || m.sceneId !== sceneId || m.stepIndex !== index - 1) {
				// Arriving out of order: rebuild the scene and fast-forward the earlier
				// motion steps that share it, so the canvas looks as if they had played.
				m = buildMotion(sceneId);
				if (!m) return;
				let first = index;
				while (first > 0 && steps[first - 1].dataset.cues && steps[first - 1].dataset.stepScene === sceneId) first -= 1;
				for (let j = first; j < index; j += 1) {
					for (const cue of cuesOf(steps[j])) runCue(m, cue, false);
				}
				commit(m);
				motion = m;
			}

			m.stepIndex = index;
			for (const cue of cuesOf(step)) runCue(m, cue, true);
		}

		// ── Playback ─────────────────────────────────────────────────────────────
		function startClock(durationMs: number) {
			clock?.cancel();
			progressRun?.cancel();
			clock = root.animate(null, { duration: durationMs });
			clock.onfinish = () => {
				if (playing) advance();
			};
			if (progress) {
				progressRun = progress.animate([{ width: percent(current / total) }, { width: percent((current + 1) / total) }], {
					duration: reducedMotion.matches ? 1 : durationMs,
					fill: 'forwards',
				});
			}
		}

		function goTo(index: number, force = false) {
			const next = Math.max(0, Math.min(total - 1, index));
			if (next === current && !force) return;
			current = next;
			settle();

			steps.forEach((step, i) => {
				const active = i === current;
				step.classList.toggle('is-active', active);
				step.setAttribute('aria-hidden', active ? 'false' : 'true');
			});

			const step = steps[current];
			if (step.dataset.cues) {
				root.dataset.mode = 'motion';
				enterMotionStep(current);
			} else {
				root.dataset.mode = 'slides';
				applyScene(step);
			}
			root.dataset.panels = step.querySelector('.anim-panels') ? 'true' : 'false';
			runSubtitles(step);

			if (prevBtn) prevBtn.disabled = current === 0;
			if (nextBtn) nextBtn.disabled = current === total - 1;
			if (counter) counter.textContent = String(current + 1);
			if (announcer) announcer.textContent = step.querySelector('.anim-step-title')?.textContent ?? '';

			startClock(Number(step.dataset.duration ?? '6000'));
		}

		function advance() {
			if (current >= total - 1) {
				stop();
				return;
			}
			goTo(current + 1);
		}

		/** Pauses or resumes the step clock, the progress bar and every running cue. */
		function freeze(frozen: boolean) {
			for (const animation of [clock, progressRun, ...running]) {
				if (!animation) continue;
				if (frozen && animation.playState === 'running') animation.pause();
				if (!frozen && animation.playState === 'paused') animation.play();
			}
		}

		function setPlaying(value: boolean) {
			playing = value;
			root.classList.toggle('is-playing', playing);
			if (playBtn) playBtn.setAttribute('aria-pressed', playing ? 'true' : 'false');
		}

		function play() {
			if (playing) return;
			setPlaying(true);
			if (clock?.playState === 'finished') {
				if (current >= total - 1) goTo(0);
				else advance();
				return;
			}
			freeze(false);
		}

		function stop() {
			setPlaying(false);
			freeze(true);
		}

		prevBtn?.addEventListener('click', () => goTo(current - 1));
		nextBtn?.addEventListener('click', () => goTo(current + 1));
		restartBtn?.addEventListener('click', () => {
			stop();
			goTo(0, true);
		});
		playBtn?.addEventListener('click', () => (playing ? stop() : play()));

		window.addEventListener('keydown', (event) => {
			const target = event.target as HTMLElement | null;
			const tag = target?.tagName ?? '';
			if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || target?.isContentEditable) return;
			if (event.key === 'ArrowRight') {
				event.preventDefault();
				goTo(current + 1);
			} else if (event.key === 'ArrowLeft') {
				event.preventDefault();
				goTo(current - 1);
			} else if (event.key === ' ' && (tag === 'BODY' || target === root)) {
				event.preventDefault();
				playing ? stop() : play();
			}
		});

		document.addEventListener('visibilitychange', () => {
			if (document.hidden && playing) stop();
		});

		goTo(0);
	}

	function setupAll() {
		document.querySelectorAll<HTMLElement>('[data-anim-player]').forEach(setupAnimationPlayer);
	}

	setupAll();
	document.addEventListener('astro:page-load', setupAll);
</script>

<style>
	/* The player takes whatever height the page column leaves it: the board fills the
