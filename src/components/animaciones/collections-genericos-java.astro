---
/**
 * Scenes for the "Java Collections Framework and generics, step by step" animation
 * (lesson java/15). The captions, code and terminal panels live in
 * `src/data/animations/collections-genericos-java.ts`; this component only draws the
 * diagrams the steps point to. Slide scenes are HTML blocks (`[data-scene]` with
 * `[data-el]` elements); the `hier`, `gen`, `lset`, `ll`, `map`, `hash`, `box`,
 * `bound` and `erase` scenes are SVG canvases (`data-motion`) choreographed by the
 * cues of their motion steps.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/collections-genericos-java';
import { resolveScript } from '../../utils/animations';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── Motion canvas data ────────────────────────────────────────────────────
// Hierarchy: implementation chips under each interface.
const impls = [
	{ id: 'hi-arraylist', cx: 170, y: 370, name: 'ArrayList', note: t('índice O(1) · el default', 'index O(1) · the default') },
	{ id: 'hi-linkedlist', cx: 170, y: 450, name: 'LinkedList', note: t('extremos O(1)', 'ends O(1)') },
	{ id: 'hi-hashset', cx: 450, y: 370, name: 'HashSet', note: t('sin orden · O(1)', 'no order · O(1)') },
	{ id: 'hi-treeset', cx: 450, y: 450, name: 'TreeSet', note: t('ordenado · O(log n)', 'sorted · O(log n)') },
	{ id: 'hi-arraydeque', cx: 730, y: 370, name: 'ArrayDeque', note: t('pila y cola · O(1)', 'stack and queue · O(1)') },
	{ id: 'hi-pq', cx: 730, y: 450, name: 'PriorityQueue', note: t('sale el menor primero', 'smallest comes out first') },
	{ id: 'hi-hashmap', cx: 1260, y: 370, name: 'HashMap', note: t('sin orden · O(1)', 'no order · O(1)') },
	{ id: 'hi-treemap', cx: 1260, y: 450, name: 'TreeMap', note: t('ordenado por clave', 'sorted by key') },
];

// Marks (a cross on a red dot, a check on a sage dot) drawn over the canvases.
const marks = [
	{ id: 'gt-x', cx: 828, cy: 485, ok: false },
	{ id: 'sb-x', cx: 275, cy: 540, ok: false },
	{ id: 'bx-x', cx: 935, cy: 345, ok: false },
	{ id: 'bd-x', cx: 640, cy: 330, ok: false },
	{ id: 'ha-no', cx: 715, cy: 470, ok: false },
	{ id: 'ha-ok', cx: 715, cy: 555, ok: true },
	{ id: 'er-x', cx: 1440, cy: 525, ok: false },
];

// Invisible points the moving elements glide to.
const anchors = [
	{ id: 'gr-s0', x: 180, y: 135 },
	{ id: 'gr-s1', x: 400, y: 135 },
	{ id: 'gt-s0', x: 180, y: 485 },
	{ id: 'gt-home', x: 1220, y: 485 },
	{ id: 'la-s0', x: 195, y: 135 },
	{ id: 'la-s1', x: 445, y: 135 },
	{ id: 'la-s2', x: 695, y: 135 },
	{ id: 'sb-s0', x: 195, y: 485 },
	{ id: 'sb-s1', x: 445, y: 485 },
	{ id: 'sb-home', x: 1250, y: 485 },
	{ id: 'mp-a0', x: 60, y: 210 },
	{ id: 'mp-a1', x: 60, y: 325 },
	{ id: 'mp-a2', x: 60, y: 440 },
	{ id: 'ha-bk5', x: 563, y: 355 },
	{ id: 'ha-bk9', x: 947, y: 355 },
	{ id: 'ha-n1', x: 563, y: 470 },
	{ id: 'ha-n2', x: 563, y: 555 },
	{ id: 'bx-sA', x: 830, y: 205 },
	{ id: 'bx-sB', x: 1330, y: 205 },
	{ id: 'bx-rej', x: 830, y: 370 },
	{ id: 'bx-home42', x: 1330, y: 470 },
	{ id: 'bd-p1', x: 880, y: 200 },
	{ id: 'bd-p2', x: 880, y: 290 },
	{ id: 'bd-stop', x: 560, y: 330 },
	{ id: 'bd-home', x: 200, y: 330 },
	{ id: 'bd-c0', x: 865, y: 230 },
	{ id: 'bd-c1', x: 1025, y: 230 },
	{ id: 'bd-c2', x: 1185, y: 230 },
	...Array.from({ length: 8 }, (_, i) => ({ id: `ll-c-${i}`, x: 120 + i * 150, y: 150 })),
	...Array.from({ length: 8 }, (_, i) => ({ id: `ll-n-${i}`, x: 120 + i * 150, y: 480 })),
];

const marksFor = (...prefixes: string[]) => marks.filter((mark) => prefixes.some((prefix) => mark.id.startsWith(`${prefix}-`)));
const anchorsFor = (...prefixes: string[]) => anchors.filter((anchor) => prefixes.some((prefix) => anchor.id.startsWith(`${prefix}-`)));

const letters = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
const buckets = Array.from({ length: 16 }, (_, i) => ({ i, x: 40 + i * 96 }));
const listSlots = [80, 330, 580];

// ── Slide scene data ──────────────────────────────────────────────────────
const chooseRows = [
	{ id: 'ch-1', need: t('Orden de inserción y acceso por índice', 'Insertion order and access by index'), use: 'ArrayList' },
	{ id: 'ch-2', need: t('Insertar y borrar mucho en los extremos', 'Lots of inserts and removals at the ends'), use: 'ArrayDeque' },
	{ id: 'ch-3', need: t('Elementos únicos, sin importar el orden', 'Unique elements, order does not matter'), use: 'HashSet' },
	{ id: 'ch-4', need: t('Elementos únicos, siempre ordenados', 'Unique elements, always sorted'), use: 'TreeSet' },
	{ id: 'ch-5', need: t('Clave → valor, acceso rapidísimo', 'Key → value, very fast access'), use: 'HashMap' },
	{ id: 'ch-6', need: t('Clave → valor, recorrido en orden de clave', 'Key → value, walked in key order'), use: 'TreeMap' },
	{ id: 'ch-7', need: t('Clave → valor, en orden de inserción', 'Key → value, in insertion order'), use: 'LinkedHashMap' },
	{ id: 'ch-8', need: t('Sacar siempre el de mayor prioridad', 'Always take the highest priority'), use: 'PriorityQueue' },
];
const mistakes = [
	{ id: 'e15-1', text: t('ArrayList<T> x = new ArrayList<>()', 'ArrayList<T> x = new ArrayList<>()') },
	{ id: 'e15-2', text: t('Sin equals/hashCode en HashSet/HashMap', 'No equals/hashCode in HashSet/HashMap') },
	{ id: 'e15-3', text: t('Modificar mientras se recorre con for-each', 'Modifying while walking with for-each') },
	{ id: 'e15-4', text: t('mapa.get(k) sin contemplar null', 'mapa.get(k) without handling null') },
	{ id: 'e15-5', text: t('LinkedList "porque insertar es más rápido"', 'LinkedList "because inserting is faster"') },
	{ id: 'e15-6', text: t('Clave mutable en un HashMap', 'Mutable key in a HashMap') },
	{ id: 'e15-7', text: t('Modificar una lista de List.of(...)', 'Modifying a List.of(...) list') },
];
const exercises = [
	{ id: 'ex-1', n: 1, name: t('Normalizar el texto', 'Normalize the text'), note: t('Minúsculas, sin puntuación', 'Lowercase, no punctuation') },
	{ id: 'ex-2', n: 2, name: t('Contar con un Map', 'Count with a Map'), note: 'Map<String, Integer>' },
	{ id: 'ex-3', n: 3, name: t('Ordenar por frecuencia', 'Sort by frequency'), note: t('Descendente y luego alfabético', 'Descending, then alphabetical') },
	{ id: 'ex-4', n: 4, name: t('Palabras distintas', 'Distinct words'), note: t('Las claves, como Set', 'The keys, as a Set') },
	{ id: 'ex-5', n: 5, name: t('Ignorar las vacías', 'Skip the stop words'), note: t('de, la, el, y, que…', 'de, la, el, y, que…') },
];
const takeaways = [
	t('Declará con la interfaz', 'Declare with the interface'),
	t('Map no extiende Collection', 'Map does not extend Collection'),
	t('Genéricos: el error llega antes', 'Generics: the error comes earlier'),
	t('Borrado de tipos', 'Type erasure'),
	t('hashCode elige el bucket', 'hashCode picks the bucket'),
	t('equals elige el elemento', 'equals picks the element'),
	t('merge · computeIfAbsent · getOrDefault', 'merge · computeIfAbsent · getOrDefault'),
	t('Elegir bien es rendimiento', 'Choosing well is performance'),
];
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<!-- INTRO: write it by hand later, Java already ships it -->
	<div slot="scene" data-scene="intro15" class="scene-intro15">
		<div class="dg-box dg-box--accent" data-el="in-hand">
			<p class="dg-label">{t('Lo vas a implementar a mano', 'You will build it by hand')}</p>
			<div class="dg-chips">
				<code class="dg-chip">TAD Lista</code><code class="dg-chip">TAD Pila</code><code class="dg-chip">TAD Cola</code>
			</div>
			<p class="dg-sub">{t('En las próximas lecciones, para ver cómo funcionan por dentro', 'In the next lessons, to see how they work inside')}</p>
		</div>
		<div class="dg-box dg-box--sage" data-el="in-lib">
			<p class="dg-label dg-label--sage">{t('Java ya lo trae', 'Java already ships it')}</p>
			<div class="dg-chips">
				<code class="dg-chip dg-chip--sage">ArrayList</code><code class="dg-chip dg-chip--sage">HashMap</code><code class="dg-chip dg-chip--sage">ArrayDeque</code>
			</div>
			<p class="dg-sub">{t('Treinta años de optimización y millones de aplicaciones', 'Thirty years of tuning and millions of applications')}</p>
		</div>
		<div class="dg-box dg-box--ink dg-box--center" data-el="in-know">
			<p class="dg-title">{t('Usar una herramienta no es lo mismo que entenderla', 'Using a tool is not the same as understanding it')}</p>
		</div>
	</div>

	<!-- 1. The JCF hierarchy (motion canvas) -->
	<div slot="scene" data-scene="hier" data-motion class="scene-canvas">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<g data-el="hi-iterable">
					<rect class="mg-card" x="340" y="30" width="220" height="60" rx="16" />
					<text class="mg-heading" x="450" y="68" text-anchor="middle">Iterable</text>
				</g>
				<g data-el="hi-a1" class="mg-arrow">
					<path class="mg-stroke" d="M450 92L450 130" pathLength="1" />
					<path class="mg-head" d="M441 120L450 132L459 120" />
				</g>
				<g data-el="hi-collection">
					<rect class="mg-card mg-card--accent" x="340" y="140" width="220" height="60" rx="16" />
					<text class="mg-heading" x="450" y="178" text-anchor="middle">Collection</text>
				</g>

				<g data-el="hi-a-list" class="mg-arrow">
					<path class="mg-stroke" d="M450 202C450 245 170 225 170 262" pathLength="1" />
					<path class="mg-head" d="M161 252L170 264L179 252" />
				</g>
				<g data-el="hi-a-set" class="mg-arrow">
					<path class="mg-stroke" d="M450 202L450 262" pathLength="1" />
					<path class="mg-head" d="M441 252L450 264L459 252" />
				</g>
				<g data-el="hi-a-queue" class="mg-arrow">
					<path class="mg-stroke" d="M450 202C450 245 730 225 730 262" pathLength="1" />
					<path class="mg-head" d="M721 252L730 264L739 252" />
				</g>
				<g data-el="hi-list">
					<rect class="mg-card mg-card--accent" x="70" y="270" width="200" height="60" rx="16" />
					<text class="mg-heading" x="170" y="308" text-anchor="middle">List</text>
				</g>
				<g data-el="hi-set">
					<rect class="mg-card mg-card--accent" x="350" y="270" width="200" height="60" rx="16" />
					<text class="mg-heading" x="450" y="308" text-anchor="middle">Set</text>
				</g>
				<g data-el="hi-queue">
					<rect class="mg-card mg-card--accent" x="630" y="270" width="200" height="60" rx="16" />
					<text class="mg-heading" x="730" y="308" text-anchor="middle">Queue</text>
				</g>

				{
					impls.map((impl) => (
						<g data-el={impl.id}>
							<rect class="mg-chip mg-chip--sage" x={impl.cx - 130} y={impl.y} width="260" height="64" rx="18" />
							<text class="mg-chip-text mg-chip-text--sage" x={impl.cx} y={impl.y + 28} text-anchor="middle">{impl.name}</text>
							<text class="mg-text mg-text--muted mg-note" x={impl.cx} y={impl.y + 50} text-anchor="middle">{impl.note}</text>
						</g>
					))
				}

				<g data-el="hi-no">
					<rect class="mg-chip" x="1080" y="170" width="360" height="52" rx="26" />
					<text class="mg-chip-text mg-chip-text--lg" x="1260" y="203" text-anchor="middle">{t('NO extiende Collection', 'Does NOT extend Collection')}</text>
				</g>
				<g data-el="hi-map">
					<rect class="mg-card mg-card--accent" x="1140" y="270" width="240" height="60" rx="16" />
					<text class="mg-heading" x="1260" y="308" text-anchor="middle">Map</text>
				</g>

				<g data-el="hi-note">
					<rect class="mg-card mg-card--sage" x="60" y="550" width="1480" height="90" rx="22" />
					<text class="mg-text mg-text--strong" x="92" y="588">{t('Todo lo que cuelga de Collection guarda elementos sueltos y se recorre con for-each.', 'Everything under Collection stores loose elements and can be walked with for-each.')}</text>
					<text class="mg-text" x="92" y="620">{t('Map guarda asociaciones clave → valor: por eso su interfaz es distinta.', 'Map stores key → value associations: that is why its interface is different.')}</text>
				</g>
			</g>
		</svg>
	</div>

	<!-- Program against interfaces -->
	<div slot="scene" data-scene="iface" class="scene-iface">
		<div class="dg-box dg-box--sage" data-el="if-good">
			<p class="dg-label dg-label--sage">{t('Bien: el tipo es la interfaz', 'Good: the type is the interface')}</p>
			<code class="dg-code">{'List<String> nombres = new ArrayList<>();'}</code>
			<code class="dg-code">{'Map<String, Integer> stock = new HashMap<>();'}</code>
		</div>
		<div class="dg-box dg-box--accent" data-el="if-bad">
			<p class="dg-label">{t('Mal: te atás a la implementación', 'Bad: you tie yourself to the implementation')}</p>
			<code class="dg-code">{'ArrayList<String> nombres = new ArrayList<>();'}</code>
		</div>
		<div class="dg-box dg-box--ink dg-box--center" data-el="if-swap">
			<p class="dg-title">{t('Cambiar a LinkedList es tocar una palabra', 'Switching to LinkedList means touching one word')}</p>
			<code class="dg-code">{'List<String> nombres = new LinkedList<>();'}</code>
		</div>
	</div>

	<!-- 2. Generics against Object (motion canvas, two lanes) -->
	<div slot="scene" data-scene="gen" data-motion class="scene-canvas">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<!-- Lane 1: without generics -->
				<text class="mg-mono mg-mono--dark" x="60" y="50" data-el="gr-decl">List lista = new ArrayList();</text>
				<g data-el="gr-list">
					<rect class="mg-card" x="60" y="75" width="720" height="120" rx="20" />
					{listSlots.slice(0, 3).map((_, i) => <rect class="mg-card" x={80 + i * 220} y="95" width="200" height="80" rx="14" style="stroke-dasharray: 8 6" />)}
				</g>
				<text class="mg-mono mg-mono--dark" x="890" y="62" data-el="gr-add1">{'lista.add("hola");'}</text>
				<text class="mg-mono mg-mono--dark" x="1130" y="62" data-el="gr-add2">lista.add(42);</text>
				<g data-el="gr-hola" data-x="980" data-y="135">
					<rect class="mg-card mg-card--accent mg-token" x="-90" y="-35" width="180" height="70" rx="16" />
					<text class="mg-mono mg-mono--dark" x="0" y="6" text-anchor="middle">{'"hola"'}</text>
				</g>
				<g data-el="gr-42" data-x="1220" data-y="135">
					<rect class="mg-card mg-card--sage mg-token" x="-90" y="-35" width="180" height="70" rx="16" />
					<text class="mg-mono mg-mono--dark" x="0" y="6" text-anchor="middle">42</text>
				</g>
				<g data-el="gr-ok">
					<rect class="mg-chip mg-chip--sage" x="1130" y="182" width="210" height="38" rx="19" />
					<text class="mg-chip-text mg-chip-text--sage" x="1235" y="207" text-anchor="middle">{t('compila perfecto', 'compiles perfectly')}</text>
				</g>
				<text class="mg-mono mg-mono--dark" x="60" y="262" data-el="gr-cast">String s = (String) lista.get(1);</text>
				<g data-el="gr-boom">
					<rect class="mg-card mg-card--ink" x="900" y="235" width="640" height="72" rx="16" />
					<text class="mg-mono mg-err" x="1220" y="268" text-anchor="middle">ClassCastException</text>
					<text class="mg-text mg-text--dim" x="1220" y="295" text-anchor="middle">{t('en EJECUCIÓN, con usuarios', 'at RUNTIME, with users')}</text>
				</g>

				<!-- Lane 2: with generics -->
				<text class="mg-mono mg-mono--dark" x="60" y="400" data-el="gt-decl">{'List<String> lista = new ArrayList<>();'}</text>
				<g data-el="gt-dia">
					<rect class="mg-chip mg-chip--sage" x="470" y="377" width="330" height="40" rx="20" />
					<text class="mg-chip-text mg-chip-text--sage" x="635" y="403" text-anchor="middle">{t('<> diamante: el mismo tipo', '<> diamond: the same type')}</text>
				</g>
				<g data-el="gt-list">
					<rect class="mg-card mg-card--sage" x="60" y="430" width="720" height="120" rx="20" />
					{listSlots.slice(0, 3).map((_, i) => <rect class="mg-card" x={80 + i * 220} y="445" width="200" height="80" rx="14" style="stroke-dasharray: 8 6" />)}
				</g>
				<g data-el="gt-gate">
					<rect class="mg-bar" x="815" y="425" width="26" height="120" rx="10" />
					<text class="mg-text mg-text--strong mg-text--muted mg-note" x="828" y="414" text-anchor="middle">{t('solo String', 'String only')}</text>
				</g>
				<text class="mg-mono mg-mono--dark" x="890" y="420" data-el="gt-add1">{'lista.add("hola");'}</text>
				<text class="mg-mono mg-mono--dark" x="1130" y="420" data-el="gt-add2">lista.add(42);</text>
				<g data-el="gt-hola" data-x="980" data-y="485">
					<rect class="mg-card mg-card--accent mg-token" x="-90" y="-35" width="180" height="70" rx="16" />
					<text class="mg-mono mg-mono--dark" x="0" y="6" text-anchor="middle">{'"hola"'}</text>
				</g>
				<g data-el="gt-42" data-x="1220" data-y="485">
					<rect class="mg-card mg-card--sage mg-token" x="-90" y="-35" width="180" height="70" rx="16" />
					<text class="mg-mono mg-mono--dark" x="0" y="6" text-anchor="middle">42</text>
				</g>
				<g data-el="gt-err">
					<rect class="mg-card mg-card--sage" x="900" y="560" width="640" height="70" rx="16" />
					<text class="mg-heading" x="1220" y="592" text-anchor="middle">{t('Error de compilación', 'Compile error')}</text>
					<text class="mg-text mg-text--muted" x="1220" y="617" text-anchor="middle">{t('en tu IDE, antes de nada', 'in your IDE, before anything')}</text>
				</g>
				<text class="mg-mono mg-mono--dark" x="60" y="590" data-el="gt-get">{t('String s = lista.get(0);   // sin casteo', 'String s = lista.get(0);   // no cast')}</text>
				{
					marksFor('gr', 'gt').map((mark) => (
						<g data-el={mark.id}>
							<circle class:list={['mg-dot', { 'mg-dot--3': mark.ok }]} cx={mark.cx} cy={mark.cy} r="24" />
							<svg x={mark.cx - 14} y={mark.cy - 14} width="28" height="28" viewBox="0 0 24 24" class="mg-icon mg-icon--bg" aria-hidden="true">
								{mark.ok ? <path d="M20 6 9 17l-5-5" /> : (<><path d="M18 6 6 18" /><path d="m6 6 12 12" /></>)}
							</svg>
						</g>
					))
				}
				{anchorsFor('gr', 'gt').map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
			</g>
		</svg>
	</div>

	<!-- 3a. List and Set (motion canvas, two lanes) -->
	<div slot="scene" data-scene="lset" data-motion class="scene-canvas">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<!-- Lane 1: List -->
				<text class="mg-mono mg-mono--dark" x="60" y="50" data-el="la-decl">{'List<String> tareas = new ArrayList<>();'}</text>
				<g data-el="la-box">
					<rect class="mg-card" x="60" y="75" width="780" height="120" rx="20" />
					{[80, 330, 580].map((x) => <rect class="mg-card" x={x} y="95" width="230" height="80" rx="14" style="stroke-dasharray: 8 6" />)}
				</g>
				<g data-el="la-t1" data-x="1010" data-y="135">
					<rect class="mg-card mg-card--accent mg-token" x="-105" y="-35" width="210" height="70" rx="16" />
					<text class="mg-mono mg-mono--dark" x="0" y="6" text-anchor="middle">{'"Estudiar POO"'}</text>
				</g>
				<g data-el="la-t2" data-x="1010" data-y="135">
					<rect class="mg-card mg-card--sage mg-token" x="-105" y="-35" width="210" height="70" rx="16" />
					<text class="mg-mono mg-mono--dark" x="0" y="6" text-anchor="middle">{'"Practicar listas"'}</text>
				</g>
				<g data-el="la-t3" data-x="1010" data-y="135">
					<rect class="mg-card mg-card--accent mg-token" x="-105" y="-35" width="210" height="70" rx="16" />
					<text class="mg-mono mg-mono--dark" x="0" y="6" text-anchor="middle">{'"Estudiar POO"'}</text>
