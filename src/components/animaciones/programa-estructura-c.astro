---
/**
 * Scene for "The parts of a C program" (lesson c/introduccion-y-estructura,
 * order: 1), a short film played on one persistent motion canvas. The captions and
 * cues live in `src/data/animations/programa-estructura-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: it holds the
 * lesson's first program, a bar slides over the line being executed, comments are
 * dimmed as it passes, and the terminal below types the real commands and output.
 * The viewport on the right holds the camera: the program seen as a machine of parts
 * (the standard library shelf, the program with one module per instruction, and the
 * operating system with its screen). Each module is labelled with its editor line.
 * Light blue is the execution flow and the data that travels, magenta marks what the
 * compiler ignores (comments) and violet marks what hands the result over (the exit
 * status that `return 0;` gives back to the system).
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/programa-estructura-c';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── The program shown in the editor ───────────────────────────────────────
// The lesson's "ejemplo completo", localized like the lesson does.
const names = {
	src: t('hola.c', 'hello.c'),
	bin: t('hola', 'hello'),
};
const text = {
	first: t('Hola, mundo', 'Hello, world'),
	second: t('Bienvenida al curso de C', 'Welcome to the C course'),
};

const source = [
	'#include <stdio.h>',
	'',
	'/*',
	`   ${t('Muestra un saludo de bienvenida al curso.', 'Shows a welcome greeting for the course.')}`,
	'*/',
	'int main(void) {',
	`    // ${t('Muestra el mensaje en dos líneas', 'Show the message on two lines')}`,
	`    printf("${text.first}\\n");`,
	`    printf("${text.second}\\n");`,
	'',
	`    // ${t('Finaliza el programa indicando que todo salió bien', 'End the program, reporting that everything went fine')}`,
	'    return 0;',
	'}',
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const lines = highlightCode(source, 'c').map((html, index) => ({
	n: index + 1,
	html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
}));

// The terminal session of the course: compile, run, read the exit status. Real output.
const consoleRows = [
	`$ gcc -std=c23 -Wall -Wextra -Wpedantic ${names.src} -o ${names.bin}`,
	`$ ./${names.bin}`,
	text.first,
	text.second,
	'$ echo $?',
	'0',
];
const rowClass = (row: string) => (row.startsWith('$ ') ? 'xj-out xj-out--cmd' : row === '0' ? 'xj-out xj-out--ok' : 'xj-out');

// Comments are dimmed as the bar passes: lines 3 to 5, 7 and 11.
const veils = [
	{ id: 'dim-3', top: 3, rows: 3 },
	{ id: 'dim-7', top: 7, rows: 1 },
	{ id: 'dim-11', top: 11, rows: 1 },
];

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 74;
const LINE_H = 23;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 5;
const CONSOLE_TOP = 414;
const outY = (row: number) => 464 + row * 22;

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up. The three places lie on the
// horizontal diagonal (u = k, v = -k); the instruction modules stand in a row in front.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 56;
const EY = 32;
const ORIGIN = { x: 440, y: 250 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');

/** A box standing on the floor at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
	};
}
type Slab = ReturnType<typeof slab>;
type Tone = 'flow' | 'violet' | 'magenta';

const area = (k: number) => slab(k, -k, 0.8, 0.8, 14, -14);
const ROW = 2.3;
const COLS = [-1.6, -0.8, 0, 0.8, 1.6];
const block = (k: number) => slab(k + ROW, -k + ROW, 0.2, 0.2, 16);
const LABEL_Y = 345;

const areas = [
	{ id: 'z-lib', lit: { id: 'lib-on' }, tone: 'flow' as Tone, g: area(-2), label: t('Biblioteca estándar', 'Standard library') },
	{ id: 'z-prog', lit: { id: 'prog-on' }, tone: 'violet' as Tone, g: area(0), label: t('Tu programa', 'Your program') },
	{ id: 'z-os', lit: { id: 'os-on' }, tone: 'violet' as Tone, g: area(2), label: t('Sistema operativo', 'Operating system') },
];
const LIB = areas[0].g.center;
const PROG = areas[1].g.center;
const OS = areas[2].g.center;

// The shelf of the standard library: `stdio.h` is one of its headers.
const SHELF = slab(-2, 2, 0.55, 0.22, 44);

// The screen stands over the operating system; the rows of `printf` are typed on it.
const SCREEN = { x: OS.x - 120, y: 62, w: 240, h: 118 };
const SCREEN_ROW = (row: number) => SCREEN.y + 56 + row * 26;

// Modules: one per instruction, labelled with its editor line.
type Module = { line: number; g: Slab; tone: Tone };
const modules: Module[] = [
	{ line: 1, tone: 'flow', g: block(COLS[0]) },
	{ line: 6, tone: 'flow', g: block(COLS[1]) },
	{ line: 8, tone: 'flow', g: block(COLS[2]) },
	{ line: 9, tone: 'flow', g: block(COLS[3]) },
	{ line: 12, tone: 'violet', g: block(COLS[4]) },
];

// Where the particle stops (just above a module) and where packets rest.
const anchors = [
	...modules.map((module) => ({ id: `a-m${module.line}`, ...lift(module.g.center, 16) })),
	{ id: 'a-shelf', ...lift(SHELF.center, 36) },
	{ id: 'a-prog', ...lift(PROG, 36) },
	{ id: 'a-os', ...lift(OS, 36) },
	{ id: 'a-scr', x: OS.x, y: SCREEN.y + 62 },
];
const at = (id: string) => anchors.find((anchor) => anchor.id === id) ?? { x: 0, y: 0 };

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shots = [
	{ id: 'shot-all', cx: 450, cy: 285, s: 0.92 },
	{ id: 'shot-lib', cx: 300, cy: 250, s: 1.2 },
	{ id: 'shot-prog', cx: 480, cy: 280, s: 1.1 },
	{ id: 'shot-os', cx: 580, cy: 240, s: 1.12 },
	{ id: 'shot-wide', cx: 450, cy: 270, s: 0.8 },
].map((item) => ({
	id: item.id,
	x: round(item.cx - 640 / item.s),
	y: round(item.cy - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Data that travels: one visual identity for "something handed from one part to another".
type Packet = { id: string; text: string; restAt: string };
const packets: Packet[] = [
	{ id: 'pk-decl', text: t('declaración de printf', 'printf declaration'), restAt: 'a-shelf' },
	{ id: 'pk-t1', text: `"${text.first}\\n"`, restAt: 'a-m8' },
	{ id: 'pk-t2', text: `"${text.second}\\n"`, restAt: 'a-m9' },
	{ id: 'pk-st', text: '0', restAt: 'a-m12' },
];
const packetWidth = (packet: Packet) => Math.round(packet.text.length * 7.6 + 28);

// Routes: the declaration from the library, the system calling `main`, the text to the
// screen, the exit status back to the system and the track of execution.
const A = (id: string) => at(id);
const routes = [
	{ id: 'fl-inc', tone: 'flow', d: `M${A('a-shelf').x + 28} ${A('a-shelf').y - 6} Q${(LIB.x + PROG.x) / 2} ${LIB.y - 150} ${A('a-prog').x - 36} ${A('a-prog').y - 6}` },
	{ id: 'fl-call', tone: 'violet', d: `M${OS.x - 36} ${OS.y - 12} Q${(OS.x + PROG.x) / 2} ${OS.y - 70} ${PROG.x + 64} ${PROG.y - 12}` },
	{ id: 'fl-out', tone: 'flow', d: `M${A('a-m8').x + 14} ${A('a-m8').y - 10} C${A('a-m8').x + 80} ${A('a-m8').y - 65} ${OS.x - 44} ${PROG.y - 10} ${OS.x - 10} ${SCREEN.y + SCREEN.h + 6}` },
	{ id: 'fl-exit', tone: 'violet', d: `M${A('a-m12').x + 8} ${A('a-m12').y - 10} Q${OS.x + 60} ${OS.y + 50} ${OS.x + 12} ${OS.y - 18}` },
	{ id: 'fl-seq', tone: 'flow', d: `M${A('a-m1').x} ${A('a-m1').y} L${A('a-m6').x} ${A('a-m6').y} L${A('a-m8').x} ${A('a-m8').y} L${A('a-m9').x} ${A('a-m9').y} L${A('a-m12').x} ${A('a-m12').y}` },
];

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = {
	id: string;
	text: string;
	x: number;
	y: number;
	align: 'start' | 'end' | 'middle';
	tone: 'plain' | Tone;
	mono?: boolean;
};
const chips: Chip[] = [
	{ id: 'lb-ign', text: t('el compilador lo ignora', 'the compiler ignores it'), x: 560, y: 452, align: 'middle', tone: 'magenta' },
	{ id: 'lb-entry', text: t('punto de entrada', 'entry point'), x: PROG.x, y: 172, align: 'middle', tone: 'flow' },
	{ id: 'lb-int', text: t('int: devuelve un entero', 'int: returns an integer'), x: PROG.x, y: 172, align: 'middle', tone: 'violet' },
	{ id: 'lb-blk', text: t('bloque de main', 'block of main'), x: PROG.x, y: 452, align: 'middle', tone: 'violet' },
	{ id: 'lb-nl', text: t('\\n = salto de línea', '\\n = line break'), x: OS.x, y: 222, align: 'middle', tone: 'flow', mono: true },
	{ id: 'lb-order', text: t('de arriba hacia abajo', 'from top to bottom'), x: 330, y: 452, align: 'middle', tone: 'flow' },
	{ id: 'lb-ok', text: t('estado de salida 0: todo salió bien', 'exit status 0: all went well'), x: OS.x, y: 304, align: 'middle', tone: 'violet' },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + 24);
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="pe-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="pe-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="pe-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="pe-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="pe-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="pe-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the program as a machine of parts, seen through the camera -->
			<g clip-path="url(#pe-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#pe-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#pe-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- The three places, each with its lit state -->
						{
							areas.map((zone) => (
								<>
									<g data-el={zone.id}>
										<polygon class="xj-plate-shadow" points={zone.g.base} transform="translate(12 18)" />
										<polygon class="xj-plate xj-plate--l" points={zone.g.leftFace} />
										<polygon class="xj-plate xj-plate--r" points={zone.g.rightFace} />
										<polygon class="xj-plate xj-plate--t" points={zone.g.top} fill="url(#pe-g-floor)" />
										<text class="xj-area-label" x={zone.g.center.x} y={LABEL_Y} text-anchor="middle">
											{zone.label}
										</text>
									</g>
									<g data-el={zone.lit.id} class:list={['xj-lit', `xj-lit--${zone.tone}`]}>
										<polygon class="xj-lit-halo" points={zone.g.top} />
										<polygon class="xj-lit-top xj-lit-top--soft" points={zone.g.top} />
									</g>
								</>
							))
						}

						<!-- The shelf of the standard library, with the header stdio.h -->
						<g data-el="shelf">
							<polygon class="xj-shadow" points={SHELF.base} transform="translate(6 8)"></polygon>
							<polygon class="xj-face xj-face--l" points={SHELF.leftFace}></polygon>
							<polygon class="xj-face xj-face--r" points={SHELF.rightFace}></polygon>
							<polygon class="xj-face xj-face--t" points={SHELF.top} fill="url(#pe-g-top)"></polygon>
							<text class="xj-face-code" transform={SHELF.faceMatrix} text-anchor="middle" y="4">stdio.h</text>
						</g>

						<!-- The screen of the system: the rows of printf are typed here -->
						<g data-el="scr">
							<rect class="xj-screen-halo" x={SCREEN.x - 6} y={SCREEN.y - 6} width={SCREEN.w + 12} height={SCREEN.h + 12} rx="20"></rect>
							<rect class="xj-screen" x={SCREEN.x} y={SCREEN.y} width={SCREEN.w} height={SCREEN.h} rx="14"></rect>
							<text class="xj-kicker" x={SCREEN.x + 18} y={SCREEN.y + 26}>{t('PANTALLA', 'SCREEN')}</text>
							{
								[text.first, text.second].map((row, index) => (
									<text data-el={`scr-${index + 1}`} class="xj-out" x={SCREEN.x + 18} y={SCREEN_ROW(index)} xml:space="preserve">
										{row}
									</text>
								))
							}
						</g>

						<!-- Instruction modules: one per instruction, labelled with its editor line -->
						{
							modules.map((module) => (
								<>
									<g data-el={`m-${module.line}`} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#pe-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
									<g data-el={`on-${module.line}`} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
										<polygon class="xj-lit-halo" points={module.g.top} />
										<polygon class="xj-lit-top" points={module.g.top} />
										<polygon class="xj-lit-side" points={module.g.leftFace} />
										<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
								</>
							))
						}

						<!-- Routes: the declaration, the call to main, the text, the exit status and the track -->
						{
							routes.map((route) => (
								<g data-el={route.id} class:list={['xj-flowline', `xj-flowline--${route.tone}`]}>
									<path class="mg-stroke xj-flowline-halo" pathLength="1" d={route.d} />
									<path class="mg-stroke xj-flowline-core" pathLength="1" d={route.d} />
								</g>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									<text class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'} x={chipLeft(chip) + chipWidth(chip) / 2} y={chip.y + 4.5} text-anchor="middle">
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- Packets. Placement lives on the inner group: the player resets data-el transforms. -->
						{
							packets.map((packet) => (
								<g data-el={packet.id} data-x={at(packet.restAt).x} data-y={at(packet.restAt).y}>
									<g class:list={['xj-packet', packet.id === 'pk-st' && 'xj-packet--status']}>
										<rect class="xj-packet-halo" x={-packetWidth(packet) / 2 - 5} y="-18" width={packetWidth(packet) + 10} height="36" rx="18" />
										<rect class="xj-packet-card" x={-packetWidth(packet) / 2} y="-13" width={packetWidth(packet)} height="26" rx="13" />
										<text class="xj-packet-text" x="0" y="4.5" text-anchor="middle">
											{packet.text}
										</text>
									</g>
								</g>
							))
						}

						<!-- The execution flow -->
						<g data-el="p" class="xj-particle" data-x={at('a-m1').x} data-y={at('a-m1').y}>
							<circle r="20" fill="url(#pe-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="450" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<rect class="xj-legend-card" x={VP.x + 172} y={LEGEND_Y - 6} width="20" height="12" rx="6"></rect>
				<text x={VP.x + 200} y={LEGEND_Y + 4}>{t('Dato que viaja', 'Data on the move')}</text>
				<rect class="xj-legend-note" x={VP.x + 322} y={LEGEND_Y - 6} width="20" height="12" rx="6"></rect>
				<text x={VP.x + 350} y={LEGEND_Y + 4}>{t('Comentario ignorado', 'Ignored comment')}</text>
			</g>

			<!-- EDITOR: the first program, with the executing line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.src}</text>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('TERMINAL', 'TERMINAL')}</text>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(1)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<!-- The program: always on screen, it is the thing being explained -->
				<g data-el="ed" data-base="shown" class="xj-code">
					{
						lines.map((line) => (
							<g>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				<!-- Comments: dimmed once the bar has crossed them -->
				{
					veils.map((veil) => (
						<rect data-el={veil.id} class="xj-code-veil" x={BAR.x} y={lineTop(veil.top)} width={BAR.w} height={LINE_H * veil.rows}></rect>
					))
				}

				<!-- Terminal: compile, run and read the exit status -->
				{
					consoleRows.map((row, index) => (
						<text data-el={`c-${index}`} class={rowClass(row)} x={ED.x + 20} y={outY(index)} xml:space="preserve">
							{row}
						</text>
					))
				}
				{lines.map((line) => <circle data-anchor={`ln-${line.n}`} cx={BAR_CX} cy={lineMid(line.n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
