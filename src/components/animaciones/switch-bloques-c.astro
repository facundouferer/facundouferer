---
/**
 * Scene for "The switch jump and the life of a block" (lesson
 * c/sentencia-switch-y-bloques-de-codigo, order: 10), a short film played on one
 * persistent motion canvas. The captions and cues live in
 * `src/data/animations/switch-bloques-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: first the
 * lesson's `plan` program (its value on line 4 changes between runs and the two
 * `[[fallthrough]];` lines are written during the film), then its block program, with
 * a bar that slides to the running line and the real output typed in the console. The
 * viewport on the right holds the camera and two isometric floors. On the first, the
 * body of the `switch` is one plate: a row of doors (the `case` labels, entry points)
 * stands over a single lane of modules, one per instruction and labelled with its
 * editor line. The value of `plan` is a token that jumps straight to its door; a light
 * blue particle is the execution flow. Magenta marks the unannotated fall-through and
 * the shadowed variable; violet marks what resolves or handles: `break`,
 * `[[fallthrough]]`, `default` and the block. On the second floor, `main` holds an
 * outer `x` and an inner block raised like an enclosure, whose own `x` lives and dies
 * inside it.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/switch-bloques-c';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── The programs shown in the editor ──────────────────────────────────────
// Identifiers and strings are the lesson's own, localized like it does.
const names = {
	fileA: 'plan.c',
	fileB: t('bloque.c', 'block.c'),
	support: t('- soporte prioritario', '- priority support'),
	backups: t('- copias de seguridad', '- backups'),
	email: t('- correo', '- email'),
	unknown: t('- nada: plan desconocido', '- nothing: unknown plan'),
	inside: t('adentro', 'inside'),
	outside: t('afuera', 'outside'),
};
const planLine = (value: number) => `    int plan = ${value};   ${t('// 1 = completo, 2 = intermedio, 3 = básico', '// 1 = full, 2 = standard, 3 = basic')}`;
const FALL = '            [[fallthrough]];';
const sourceA = [
	'#include <stdio.h>',
	'',
	'int main(void) {',
	planLine(3),
	'',
	'    switch (plan) {',
	'        case 1:',
	`            printf("${names.support}\\n");`,
	FALL,
	'        case 2:',
	`            printf("${names.backups}\\n");`,
	FALL,
	'        case 3:',
	`            printf("${names.email}\\n");`,
	'            break;',
	'        default:',
	`            printf("${names.unknown}\\n");`,
	'            break;',
	'    }',
	'',
	'    return 0;',
	'}',
].join('\n');
const sourceB = [
	'#include <stdio.h>',
	'',
	'int main(void) {',
	'    int x = 1;',
	'',
	'    {',
	`        int x = 2;  ${t('// otra variable, que oculta a la de afuera', '// a different variable that hides the outer one')}`,
	`        printf("${names.inside}: %d\\n", x);`,
	'    }',
	'',
	`    printf("${names.outside}: %d\\n", x);`,
	'    return 0;',
	'}',
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const toSvg = (html: string) => html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>');
const source = sourceA;
const linesA = highlightCode(source, 'c').map((html, index) => ({ n: index + 1, html: toSvg(html) }));
const linesB = highlightCode(sourceB, 'c').map((html, index) => ({ n: index + 1, html: toSvg(html) }));
/** Line 4 changes between runs; lines 9 and 12 are written during the film. */
const LIVE = [4, 9, 12];
const planVersions = [3, 2, 7].map((value) => ({ id: `l4-${value}`, html: toSvg(highlightCode(planLine(value), 'c')[0]), base: value === 3 }));
const htmlOf = (n: number) => linesA.find((line) => line.n === n)?.html ?? '';

// The real output of each run (compiled with cc -std=c23 -Wall -Wextra -Wpedantic).
const outputs = [
	{ id: 'out-1', row: 0, text: names.email }, // plan = 3
	{ id: 'out-2', row: 0, text: names.backups }, // plan = 2
	{ id: 'out-3', row: 1, text: names.email },
	{ id: 'out-4', row: 0, text: names.unknown }, // plan = 7
	{ id: 'out-5', row: 0, text: `${names.inside}: 2` }, // the block program
	{ id: 'out-6', row: 1, text: `${names.outside}: 1` },
];
// What GCC says about line 11 when the fall-through is not marked (-Wextra).
const WARNING = 'warning: this statement may fall through';

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 70;
const LINE_H = 21;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 5;
const CONSOLE_TOP = 548;
const outY = (row: number) => 598 + row * 21;

/** A scope bracket in the gutter: from the first to the last line where a name is visible. */
const bracket = (from: number, to: number) => {
	const top = lineTop(from) + 3;
	const bottom = lineTop(to) + LINE_H - 3;
	return `M38 ${top} H31 V${bottom} H38`;
};

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up. The switch floor sits at the
// top; the block floor is shifted forward by (BU, BV).
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 56;
const EY = 32;
const ORIGIN = { x: 640, y: 330 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');

/** A box standing at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		front,
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
	};
}
type Slab = ReturnType<typeof slab>;
type Tone = 'flow' | 'violet' | 'magenta';

/** The outline of a scope: a dashed ring around a plate. */
const ring = (u: number, v: number, a: number, b: number, z: number) =>
	poly([pt(u - a, v - b, z), pt(u + a, v - b, z), pt(u + a, v + b, z), pt(u - a, v + b, z)]);

// ── Floor 1: main and the body of the switch ──
const MAIN = slab(0.15, 0.1, 3.65, 1.4, 16, 0);
const SW = slab(-0.35, 0, 2.95, 0.7, 12, 16);
const LANE_Z = 28;

type Module = { id: string; line: number; g: Slab; tone: Tone; u?: number };
const block = (u: number, v: number, z: number, a = 0.18) => slab(u, v, a, a, 14, z);
// One lane along +u: the code of every case, in source order.
const laneModules: Module[] = [
	{ id: 'm-8', line: 8, u: -2.45, tone: 'flow', g: block(-2.45, 0, LANE_Z) },
	{ id: 'm-9', line: 9, u: -2.0, tone: 'violet', g: block(-2.0, 0, LANE_Z, 0.14) },
	{ id: 'm-11', line: 11, u: -1.1, tone: 'flow', g: block(-1.1, 0, LANE_Z) },
	{ id: 'm-12', line: 12, u: -0.65, tone: 'violet', g: block(-0.65, 0, LANE_Z, 0.14) },
	{ id: 'm-14', line: 14, u: 0.25, tone: 'flow', g: block(0.25, 0, LANE_Z) },
	{ id: 'm-15', line: 15, u: 0.7, tone: 'violet', g: block(0.7, 0, LANE_Z) },
	{ id: 'm-17', line: 17, u: 1.6, tone: 'flow', g: block(1.6, 0, LANE_Z) },
	{ id: 'm-18', line: 18, u: 2.05, tone: 'violet', g: block(2.05, 0, LANE_Z) },
];
// On the floor of main, outside the switch: the variable, the switch itself and the return.
const floorModules: Module[] = [
	{ id: 'm-4', line: 4, tone: 'flow', g: block(-3.0, 1.05, 16) },
	{ id: 'm-6', line: 6, tone: 'flow', g: block(-2.0, 1.05, 16, 0.26) },
	{ id: 'm-21', line: 21, tone: 'flow', g: block(3.3, 0.2, 16) },
];

// The case labels: doors standing across the lane. They are entry points, not walls.
const DOOR_H = 48;
const door = (n: number, u: number, label: string, line: number, tone: Tone) => {
	const z0 = LANE_Z;
	const z1 = LANE_Z + DOOR_H;
	const band = [pt(u, -0.6, z1), pt(u, 0.6, z1), pt(u, 0.6, z1 - 15), pt(u, -0.6, z1 - 15)];
	const textAt = pt(u, 0, z1 - 7.5);
	const lineAt = pt(u, 0, z1 + 12);
	return {
		id: `d-${n}`,
		lit: `on-d${n}`,
		n,
		label,
		line,
		tone,
		posts: [
			{ from: pt(u, -0.5, z0), to: pt(u, -0.5, z1 - 15) },
			{ from: pt(u, 0.5, z0), to: pt(u, 0.5, z1 - 15) },
		],
		lintel: poly(band),
		lintelTop: poly([pt(u - 0.07, -0.6, z1), pt(u + 0.07, -0.6, z1), pt(u + 0.07, 0.6, z1), pt(u - 0.07, 0.6, z1)]),
		textMatrix: `matrix(0.868 -0.496 0 1 ${textAt.x} ${textAt.y})`,
		lineAt,
		anchor: pt(u, 0, z0 + 22),
		u,
	};
};
const doors = [
	door(1, -2.9, 'case 1', 7, 'flow'),
	door(2, -1.55, 'case 2', 10, 'flow'),
	door(3, -0.2, 'case 3', 13, 'flow'),
	door(4, 1.15, 'default', 16, 'violet'),
];
// Painter's order along the lane: doors and modules interleaved by u.
const lane = [
	...doors.map((item) => ({ kind: 'door' as const, u: item.u, door: item })),
	...laneModules.map((module) => ({ kind: 'module' as const, u: module.u ?? 0, module })),
].sort((a, b) => a.u - b.u);

// ── Floor 2: the block program ──
const BU = 1.5;
const BV = 4.2;
const slabB = (u: number, v: number, a: number, b: number, h: number, z = 0) => slab(u + BU, v + BV, a, b, h, z);
const B_MAIN = slabB(0, 0, 2.0, 1.4, 16, 0);
const BLK = slabB(0.45, -0.35, 1.05, 0.75, 12, 16);
const BLK_Z = 28;
const cellB = (u: number, v: number, z: number, a: number) => slabB(u, v, a, a, 18, z);
const CX_OUT = cellB(-1.3, -0.5, 16, 0.42);
const CX_IN = cellB(0.0, -0.6, BLK_Z, 0.36);
const blockB = (u: number, v: number, z: number) => slabB(u, v, 0.18, 0.18, 14, z);
const bFloorModules: Module[] = [
	{ id: 'mb-4', line: 4, tone: 'flow', g: blockB(-1.35, 0.85, 16) },
	{ id: 'mb-11', line: 11, tone: 'flow', g: blockB(0.45, 0.95, 16) },
	{ id: 'mb-12', line: 12, tone: 'flow', g: blockB(1.05, 0.95, 16) },
];
const bInnerModules: Module[] = [
	{ id: 'mb-7', line: 7, tone: 'violet', g: blockB(0.75, -0.05, BLK_Z) },
	{ id: 'mb-8', line: 8, tone: 'violet', g: blockB(1.2, -0.05, BLK_Z) },
];
const OUT = CX_OUT.center;
const IN = CX_IN.center;

// Where the particle stops (just above a module), where the token rests, the doorways.
const anchors = [
	...[...laneModules, ...floorModules].map((module) => ({ id: `a-m${module.line}`, ...lift(module.g.center, 16) })),
	...[...bFloorModules, ...bInnerModules].map((module) => ({ id: `a-b${module.line}`, ...lift(module.g.center, 16) })),
	{ id: 'a-k4', ...lift(floorModules[0].g.center, 40) },
	{ id: 'a-k6', ...lift(floorModules[1].g.center, 44) },
	...doors.map((item) => ({ id: `a-d${item.n}`, ...item.anchor })),
];
const at = (id: string) => anchors.find((anchor) => anchor.id === id) ?? { x: 0, y: 0 };

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shots = [
	{ id: 'shot-build', at: pt(0.15, 0.1, 40), s: 1.02 },
	{ id: 'shot-doors', at: pt(-1.9, 0.3, 40), s: 1.45 },
	{ id: 'shot-lane', at: pt(-0.4, 0, 40), s: 1.6 },
	{ id: 'shot-end', at: pt(1.9, 0, 30), s: 1.4 },
	{ id: 'shot-block', at: pt(BU, BV, 30), s: 1.45 },
	{ id: 'shot-all', at: pt(0.9, 2.1, 40), s: 0.82 },
]
	.map((item) => ({ id: item.id, cx: item.at.x, cy: item.at.y, s: item.s }))
	.map((item) => ({
	id: item.id,
	x: round(item.cx - 640 / item.s),
	y: round(item.cy - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Routes: the fall through the next label, the way out of break, and the name lookups.
const m11 = at('a-m11');
const m14 = at('a-m14');
const m15 = at('a-m15');
const m18 = at('a-m18');
const m21 = at('a-m21');
const b8 = at('a-b8');
const b11 = at('a-b11');
const fallPath = `M${m11.x + 8} ${m11.y + 4} L${m14.x - 8} ${m14.y - 4}`;
const routes = [
	{ id: 'fl-fall', tone: 'magenta', d: fallPath },
	{ id: 'fl-ok', tone: 'violet', d: fallPath },
	{ id: 'fl-break', tone: 'violet', d: `M${m15.x + 10} ${m15.y - 8} C${m15.x + 40} ${m15.y - 90} ${m21.x - 20} ${m21.y - 100} ${m21.x - 4} ${m21.y - 14}` },
	{ id: 'fl-break2', tone: 'violet', d: `M${m18.x + 10} ${m18.y - 8} Q${(m18.x + m21.x) / 2} ${m18.y - 60} ${m21.x - 4} ${m21.y - 14}` },
	{ id: 'fl-in', tone: 'violet', d: `M${b8.x - 8} ${b8.y - 6} Q${(b8.x + IN.x) / 2} ${IN.y - 70} ${IN.x + 10} ${IN.y - 12}` },
	{ id: 'fl-out', tone: 'flow', d: `M${b11.x - 8} ${b11.y - 6} Q${(b11.x + OUT.x) / 2} ${OUT.y - 20} ${OUT.x + 22} ${OUT.y}` },
];

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = {
	id: string;
	text: string;
	x: number;
	y: number;
	align: 'start' | 'end' | 'middle';
	tone: 'plain' | Tone;
	mono?: boolean;
	icon?: 'arrow' | 'door';
};
const D2 = doors[1].lineAt;
const D3 = doors[2].lineAt;
const D4 = doors[3].lineAt;
const M6 = floorModules[1].g.center;
const chips: Chip[] = [
	{ id: 'lb-entry', text: t('case = punto de entrada', 'case = entry point'), x: D2.x + 40, y: D2.y - 40, align: 'middle', tone: 'plain', icon: 'door' },
	{ id: 'lb-once', text: t('plan se evalúa una vez', 'plan is evaluated once'), x: M6.x - 20, y: M6.y + 50, align: 'middle', tone: 'flow' },
	{ id: 'lb-skip', text: t('salta directo a case 3', 'jumps straight to case 3'), x: D3.x + 20, y: D3.y - 34, align: 'middle', tone: 'flow', icon: 'arrow' },
	{ id: 'lb-break', text: t('break: sale del switch', 'break: leaves the switch'), x: m15.x - 20, y: m15.y + 56, align: 'middle', tone: 'violet' },
	{ id: 'lb-after', text: t('sigue después de }', 'continues after }'), x: m21.x, y: m21.y + 50, align: 'middle', tone: 'violet', mono: true },
	{ id: 'lb-fall', text: t('cae en case 3 sin break', 'falls into case 3, no break'), x: D3.x, y: D3.y - 34, align: 'middle', tone: 'magenta' },
	{ id: 'lb-intent', text: t('caída intencional', 'deliberate fall-through'), x: D3.x, y: D3.y - 34, align: 'middle', tone: 'violet' },
	{ id: 'lb-default', text: t('ningún case coincide', 'no case matches'), x: D4.x, y: D4.y - 34, align: 'middle', tone: 'violet' },
	{ id: 'lb-hidden', text: t('x de afuera: oculta', 'outer x: shadowed'), x: OUT.x, y: OUT.y - 52, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'lb-scope', text: t('x = 2: solo dentro de { }', 'x = 2: only inside { }'), x: IN.x + 40, y: IN.y - 92, align: 'middle', tone: 'violet', mono: true },
	{ id: 'lb-gone', text: t('la x interior ya no existe', 'the inner x no longer exists'), x: IN.x + 40, y: IN.y - 40, align: 'middle', tone: 'magenta' },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.icon ? 42 : 24));
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

// Value tokens: one visual identity for "the value of plan", one per run.
const tokens = [
	{ id: 'tk-3', text: '3' },
	{ id: 'tk-2', text: '2' },
	{ id: 'tk-7', text: '7' },
];

const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="sb-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="sb-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="sb-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="sb-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="sb-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="sb-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the switch and the block, seen through the camera -->
			<g clip-path="url(#sb-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#sb-g-pool-violet)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#sb-g-pool-flow)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- Floor 1: main, with the body of the switch as one plate -->
						<g data-el="f-main">
							<polygon class="xj-plate-shadow" points={MAIN.base} transform="translate(12 18)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={MAIN.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={MAIN.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={MAIN.top} fill="url(#sb-g-floor)"></polygon>
							<text class="xj-frame-name" transform={MAIN.faceMatrix} text-anchor="middle" y="4">main</text>
						</g>
						<g data-el="sw-body">
							<polygon class="xj-plate-shadow" points={SW.base} transform="translate(8 12)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={SW.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={SW.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t xj-plate--switch" points={SW.top} fill="url(#sb-g-floor)"></polygon>
							<text class="xj-frame-name" transform={SW.faceMatrix} text-anchor="middle" y="4">{'switch (plan) { … }'}</text>
						</g>

						<!-- The lane: doors (case labels) and modules (instructions) in source order -->
						{
							lane.map((item) =>
								item.kind === 'door' ? (
									<>
										<g data-el={item.door.id} class="xj-door">
											{item.door.posts.map((post) => (
												<path class="xj-post" d={`M${post.from.x} ${post.from.y} L${post.to.x} ${post.to.y}`} />
											))}
											<polygon class="xj-lintel-top" points={item.door.lintelTop} />
											<polygon class="xj-lintel" points={item.door.lintel} />
											<text class="xj-lintel-text" transform={item.door.textMatrix} text-anchor="middle" y="4">
												{item.door.label}
											</text>
											<text class="xj-door-line" x={item.door.lineAt.x} y={item.door.lineAt.y} text-anchor="middle">
												{item.door.line}
											</text>
										</g>
										<g data-el={item.door.lit} class:list={['xj-lit', `xj-lit--${item.door.tone}`]}>
											{item.door.posts.map((post) => (
												<path class="xj-lit-post" d={`M${post.from.x} ${post.from.y} L${post.to.x} ${post.to.y}`} />
											))}
											<polygon class="xj-lit-halo" points={item.door.lintel} />
											<polygon class="xj-lit-top" points={item.door.lintel} />
											<text class="xj-lintel-text xj-face-text--on" transform={item.door.textMatrix} text-anchor="middle" y="4">
												{item.door.label}
											</text>
										</g>
									</>
								) : (
									<>
										<g data-el={item.module.id} class:list={['xj-mod', item.module.tone === 'violet' && 'xj-mod--violet']}>
											<polygon class="xj-shadow" points={item.module.g.base} transform="translate(5 7)" />
											<polygon class="xj-face xj-face--l" points={item.module.g.leftFace} />
											<polygon class="xj-face xj-face--r" points={item.module.g.rightFace} />
											<polygon class="xj-face xj-face--t" points={item.module.g.top} fill="url(#sb-g-top)" />
											<text class="xj-face-text" transform={item.module.g.faceMatrix} text-anchor="middle" y="4">
												{item.module.line}
											</text>
										</g>
										<g data-el={`on-${item.module.line}`} class:list={['xj-lit', `xj-lit--${item.module.tone}`]}>
											<polygon class="xj-lit-halo" points={item.module.g.top} />
											<polygon class="xj-lit-top" points={item.module.g.top} />
											<polygon class="xj-lit-side" points={item.module.g.leftFace} />
											<text class="xj-face-text xj-face-text--on" transform={item.module.g.faceMatrix} text-anchor="middle" y="4">
												{item.module.line}
											</text>
										</g>
									</>
								),
							)
						}

						<!-- On the floor of main: line 4, the switch itself (line 6) and the return -->
						{
							floorModules.map((module) => (
								<>
									<g data-el={module.id} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(5 7)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#sb-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4">
											{module.line}
										</text>
									</g>
									<g data-el={`on-${module.line}`} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
										<polygon class="xj-lit-halo" points={module.g.top} />
										<polygon class="xj-lit-top" points={module.g.top} />
										<polygon class="xj-lit-side" points={module.g.leftFace} />
										<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4">
											{module.line}
										</text>
									</g>
								</>
							))
						}

						<!-- Floor 2: main of the block program, with its outer x -->
						<g data-el="b-main">
							<polygon class="xj-plate-shadow" points={B_MAIN.base} transform="translate(12 18)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={B_MAIN.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={B_MAIN.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={B_MAIN.top} fill="url(#sb-g-floor)"></polygon>
							<text class="xj-frame-name" transform={B_MAIN.faceMatrix} text-anchor="middle" y="4">main</text>
						</g>
						<g data-el="cx-out">
							<polygon class="xj-shadow" points={CX_OUT.base} transform="translate(5 7)"></polygon>
							<polygon class="xj-cell xj-cell--l" points={CX_OUT.leftFace}></polygon>
							<polygon class="xj-cell xj-cell--r" points={CX_OUT.rightFace}></polygon>
							<polygon class="xj-cell xj-cell--t" points={CX_OUT.top}></polygon>
							<text class="xj-cell-name" transform={CX_OUT.faceMatrix} text-anchor="middle" y="4">x</text>
							<text class="xj-value" x={OUT.x} y={OUT.y + 6} text-anchor="middle">1</text>
						</g>
						<!-- The outer x while the inner one shadows it -->
						<g data-el="veil" class="xj-veil">
							<polygon points={CX_OUT.top}></polygon>
							<polygon points={CX_OUT.leftFace}></polygon>
							<polygon points={CX_OUT.rightFace}></polygon>
						</g>
						{
							bFloorModules.map((module) => (
								<>
									<g data-el={module.id} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(5 7)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#sb-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4">
											{module.line}
										</text>
									</g>
									<g data-el={`onb-${module.line}`} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
										<polygon class="xj-lit-halo" points={module.g.top} />
										<polygon class="xj-lit-top" points={module.g.top} />
										<polygon class="xj-lit-side" points={module.g.leftFace} />
										<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4">
											{module.line}
										</text>
									</g>
								</>
							))
						}

						<!-- The inner block: raised over main, it lives from line 6 to line 9 -->
						<g data-el="blk">
							<polygon class="xj-plate-shadow" points={BLK.base} transform="translate(8 12)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={BLK.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={BLK.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t xj-plate--block" points={BLK.top} fill="url(#sb-g-floor)"></polygon>
							<text class="xj-frame-name" transform={BLK.faceMatrix} text-anchor="middle" y="4">{'{ }  6–9'}</text>
							{
								bInnerModules.map((module) => (
									<g data-el={module.id} data-base="shown" class="xj-mod xj-mod--violet">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(5 7)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#sb-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4">
											{module.line}
										</text>
									</g>
								))
							}
						</g>
						<g data-el="zone-in" class="xj-zone xj-zone--violet">
							<polygon points={ring(0.45 + BU, -0.35 + BV, 1.2, 0.9, BLK_Z)}></polygon>
						</g>
						{
							bInnerModules.map((module) => (
								<g data-el={`onb-${module.line}`} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
									<polygon class="xj-lit-halo" points={module.g.top} />
									<polygon class="xj-lit-top" points={module.g.top} />
									<polygon class="xj-lit-side" points={module.g.leftFace} />
									<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4">
										{module.line}
									</text>
								</g>
							))
						}
						<g data-el="cx-in">
							<polygon class="xj-shadow" points={CX_IN.base} transform="translate(5 7)"></polygon>
							<polygon class="xj-cell xj-cell--l" points={CX_IN.leftFace}></polygon>
							<polygon class="xj-cell xj-cell--r" points={CX_IN.rightFace}></polygon>
							<polygon class="xj-cell xj-cell--t xj-cell--violet" points={CX_IN.top}></polygon>
							<text class="xj-cell-name" transform={CX_IN.faceMatrix} text-anchor="middle" y="4">x</text>
							<text class="xj-value xj-value--violet" x={IN.x} y={IN.y + 6} text-anchor="middle">2</text>
						</g>

						<!-- Routes: the fall, the way out of break, and the lookups of x -->
						{
							routes.map((route) => (
								<g data-el={route.id} class:list={['xj-flowline', `xj-flowline--${route.tone}`]}>
									<path class="mg-stroke xj-flowline-halo" pathLength="1" d={route.d} />
									<path class="mg-stroke xj-flowline-core" pathLength="1" d={route.d} />
								</g>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.icon === 'arrow' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M5 12h14" />
											<path d="m12 5 7 7-7 7" />
										</svg>
									)}
									{chip.icon === 'door' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M11 20H2" />
											<path d="M11 4.562v16.157a1 1 0 0 0 1.242.97L19 20V5.562a2 2 0 0 0-1.515-1.94l-4-1A2 2 0 0 0 11 4.561z" />
											<path d="M11 4H8a2 2 0 0 0-2 2v14" />
											<path d="M14 12h.01" />
											<path d="M22 20h-3" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.icon ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- The value of plan. Placement lives on the inner group: the player resets data-el transforms. -->
						{
							tokens.map((token) => (
								<g data-el={token.id} data-x={at('a-k4').x} data-y={at('a-k4').y}>
									<g class="xj-token">
										<rect class="xj-token-halo" x="-25" y="-19" width="50" height="38" rx="19" />
										<rect class="xj-token-card" x="-20" y="-14" width="40" height="28" rx="14" />
										<text class="xj-token-text" x="0" y="5.5" text-anchor="middle">
											{token.text}
										</text>
									</g>
								</g>
							))
						}

						<!-- The execution flow -->
						<g data-el="p" class="xj-particle" data-x={at('a-m4').x} data-y={at('a-m4').y}>
							<circle r="20" fill="url(#sb-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="430" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<rect class="xj-legend-token" x={VP.x + 172} y={LEGEND_Y - 7} width="20" height="14" rx="7"></rect>
				<text x={VP.x + 200} y={LEGEND_Y + 4}>{t('Valor de plan', 'Value of plan')}</text>
				<path class="xj-legend-door" d={`M${VP.x + 318} ${LEGEND_Y + 7} V${LEGEND_Y - 7} H${VP.x + 332} V${LEGEND_Y + 7}`}></path>
				<text x={VP.x + 342} y={LEGEND_Y + 4}>{t('Etiqueta case', 'case label')}</text>
			</g>

			<!-- EDITOR: the lesson's programs, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<text data-el="file-a" data-base="shown" class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.fileA}</text>
				<text data-el="file-b" class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.fileB}</text>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>
				<text data-el="warn" class="xj-warn" x={ED.x + ED.w - 20} y={CONSOLE_TOP + 22} text-anchor="end">{WARNING}</text>

				<!-- The statement GCC flags when the fall-through is not marked -->
				<g data-el="hx-11" class="xj-hx">
					<rect x={BAR.x} y={lineTop(11)} width={BAR.w} height={LINE_H} rx="6"></rect>
				</g>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(4)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<!-- Scope bracket of the inner x: from its block's opening to its closing brace -->
				<g data-el="sc-in" class="xj-scope xj-scope--violet">
					<path class="mg-stroke" pathLength="1" d={bracket(6, 9)}></path>
				</g>

				<!-- plan.c: every line but the three that change during the film -->
				<g data-el="ed-a" data-base="shown" class="xj-code">
					{
						linesA.map((line) => (
							<g>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								{!LIVE.includes(line.n) && <text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />}
							</g>
						))
					}
				</g>
				<g class="xj-code">
					{
						planVersions.map((version) => (
							<text
								data-el={version.id}
								data-base={version.base ? 'shown' : undefined}
								class="xj-mono"
								x={CODE_X}
								y={lineBase(4)}
								xml:space="preserve"
								set:html={version.html}
							/>
						))
					}
					<text data-el="ft-9" class="xj-mono xj-attr" x={CODE_X} y={lineBase(9)} xml:space="preserve" set:html={htmlOf(9)} />
					<text data-el="ft-12" class="xj-mono xj-attr" x={CODE_X} y={lineBase(12)} xml:space="preserve" set:html={htmlOf(12)} />
				</g>

				<!-- The block program, shown in the second half -->
				<g data-el="ed-b" class="xj-code">
					{
						linesB.map((line) => (
							<g>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				<!-- Console: the real output of each run, typed as its line runs -->
				{
					outputs.map((row) => (
						<text data-el={row.id} class="xj-out" x={ED.x + 20} y={outY(row.row)} xml:space="preserve">
							{row.text}
						</text>
					))
				}
				{linesA.map((line) => <circle data-anchor={`ln-${line.n}`} cx={BAR_CX} cy={lineMid(line.n)} r="1" fill="none" />)}
				{linesB.map((line) => <circle data-anchor={`ln-b-${line.n}`} cx={BAR_CX} cy={lineMid(line.n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow and value of plan, magenta for the unmarked fall-through
	   and the shadowed variable, and violet for what resolves it (break,
	   [[fallthrough]], default, the block). Every rule below reads these tokens;
	   no other color is written in this file. */
	:global(.anim-player[data-slug='switch-bloques-c']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='switch-bloques-c'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='switch-bloques-c'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='switch-bloques-c'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-token {
		fill: var(--xj-ink);
		stroke: var(--xj-flow);
		stroke-width: 1.5;
	}

	.xj-legend-door {
		fill: none;
		stroke: var(--xj-mist);
		stroke-width: 2.5;
		stroke-linejoin: round;
