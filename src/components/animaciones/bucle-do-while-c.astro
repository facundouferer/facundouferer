/**
 * Scene for "Do first, ask later" (lesson c/13-sentencia-do-while, order: 13), a
 * short film played on one persistent motion canvas. The captions and cues live
 * in `src/data/animations/bucle-do-while-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: the
 * program being run (four programs of the lesson, one after the other), with a bar
 * that slides to the line being executed and the real output typed in the console
 * below. The viewport on the right holds the camera: every `do-while` is an
 * isometric track whose gate (the condition) stands at the END, after the body.
 * Statements are numbered cubes on the track, variables are plates with their
 * value on top, the execution flow is a particle and input values travel as
 * tokens. When the gate says true the particle goes back along the return arc;
 * when it says false it leaves. `continue` and `break` are magenta jumps; a small
 * `for` track shows where `continue` lands there.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
