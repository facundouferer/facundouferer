---
/**
 * Scenes for the "Abstract classes and interfaces, step by step" animation (lesson
 * java/11). The captions, code and terminal panels live in
 * `src/data/animations/abstractas-interfaces-java.ts`; this component only draws the
 * diagrams the steps point to. Slide scenes are HTML blocks (`[data-scene]` with
 * `[data-el]` elements); the `abs`, `contract`, `multi`, `combo`, `fqcn` and `rel`
 * scenes are SVG canvases (`data-motion`) choreographed by the cues of their motion steps.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/abstractas-interfaces-java';
import { resolveScript } from '../../utils/animations';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── Slide scene data ──────────────────────────────────────────────────────
const cmpRows = [
	{ n: 1, label: t('Relación que expresa', 'Relationship it expresses'), abs: t('«es un»: identidad compartida', '“is a”: shared identity'), iface: t('«es capaz de»: capacidad compartida', '“is capable of”: shared capability') },
	{ n: 2, label: t('Cuántas podés usar', 'How many you can use'), abs: t('Solo una (extends)', 'Only one (extends)'), iface: t('Las que quieras (implements)', 'As many as you want (implements)') },
	{ n: 3, label: t('Estado de instancia', 'Instance state'), abs: t('Sí, campos comunes', 'Yes, ordinary fields'), iface: t('No, solo constantes static final', 'No, only static final constants') },
	{ n: 4, label: t('Constructores', 'Constructors'), abs: t('Sí', 'Yes'), iface: t('No', 'No') },
	{ n: 5, label: t('Visibilidad de métodos', 'Method visibility'), abs: t('Cualquiera, incluso protected', 'Anything, including protected'), iface: t('Siempre public', 'Always public') },
	{ n: 6, label: t('Agregar un método después', 'Adding a method later'), abs: t('Rompe subclases si es abstracto', 'Breaks subclasses if abstract'), iface: t('No rompe nada si es default', 'Breaks nothing if default') },
];
const nsRules = [
	t('Dominio al revés: com.facundouferer', 'Reversed domain: com.facundouferer'),
	t('Todo en minúsculas', 'All lowercase'),
	t('Un .java por clase pública', 'One .java per public class'),
	t('Agrupar por responsabilidad', 'Group by responsibility'),
	t('import static, con moderación', 'Static imports, sparingly'),
	t('package-private: frontera de confianza', 'package-private: a trust boundary'),
];
const mistakes = [
	t('Clase abstracta donde va una interfaz', 'Abstract class where an interface belongs'),
	t('default en cada método', 'A default on every method'),
	t('Campos mutables en una interfaz', 'Mutable fields in an interface'),
	t('package distinto de la carpeta', 'Package that does not match the folder'),
	t('Choque de nombres al importar', 'Name collision when importing'),
	t('Agregación que era composición', 'Aggregation that was composition'),
	t('Un único package gigante', 'One giant package'),
];
const tasks = [
	{ n: 1, name: 'Payable', note: 'pay · isAvailable · default payIfPossible' },
	{ n: 2, name: 'CreditCard · DigitalWallet', note: 'implements Payable' },
	{ n: 3, name: 'DigitalPaymentMethod', note: t('Clase abstracta: email + active', 'Abstract class: email + active') },
	{ n: 4, name: 'DigitalWallet extends', note: t('Reutiliza super.isAvailable()', 'Reuses super.isAvailable()') },
	{ n: 5, name: 'Payable[]', note: t('Un bucle, sin instanceof ni casting', 'One loop, no instanceof and no casting') },
];
const takeaways = [
	t('Clase abstracta: molde incompleto', 'Abstract class: incomplete mold'),
	t('Interfaz: contrato puro', 'Interface: pure contract'),
	t('Interfaz primero', 'Interface first'),
	t('default: evolucionar sin romper', 'default: evolve without breaking'),
	t('Extiende una, implementa muchas', 'Extends one, implements many'),
	t('package = namespace · FQCN', 'package = namespace · FQCN'),
	t('Si destruyo el todo, ¿existe la parte?', 'If I destroy the whole, does the part exist?'),
];
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<!-- INTRO: the two problems and the two tools -->
	<div slot="scene" data-scene="intro11" class="scene-intro11">
		<div class="dg-box" data-el="p1">
			<p class="dg-label">{t('Problema 1', 'Problem 1')}</p>
			<code class="dg-code">new Vehicle("Ford")</code>
			<p class="dg-sub">{t('Compila, pero un «vehículo genérico» no existe', 'It compiles, but a “generic vehicle” does not exist')}</p>
		</div>
		<div class="dg-box" data-el="p2">
			<p class="dg-label">{t('Problema 2', 'Problem 2')}</p>
			<code class="dg-code">Vehicle.start()</code>
			<p class="dg-sub">{t('Un cuerpo inventado solo para que compile', 'A body invented just so it compiles')}</p>
		</div>
		<div class="dg-box dg-box--accent" data-el="abs">
			<p class="dg-label">{t('Clase abstracta', 'Abstract class')}</p>
			<p class="dg-title">{t('Un molde incompleto', 'An incomplete mold')}</p>
			<p class="dg-sub">{t('Trae estado y comportamiento resuelto, y deja huecos', 'Brings state and solved behavior, and leaves gaps')}</p>
		</div>
		<div class="dg-box dg-box--sage" data-el="iface">
			<p class="dg-label dg-label--sage">{t('Interfaz', 'Interface')}</p>
			<p class="dg-title">{t('Un contrato puro', 'A pure contract')}</p>
			<p class="dg-sub">{t('Dice qué debe poder hacer quien lo firma', 'Says what whoever signs it must be able to do')}</p>
		</div>
	</div>

	<!-- 1. Anatomy of an abstract class -->
	<div slot="scene" data-scene="abs-anatomy" class="scene-abs-anatomy">
		<div class="dg-box" data-el="an-state">
			<p class="dg-label">{t('Estado', 'State')}</p>
			<code class="dg-code">protected final String name;</code>
			<p class="dg-sub">{t('Campos y constructor, como cualquier clase', 'Fields and a constructor, like any class')}</p>
		</div>
		<div class="dg-box dg-box--accent" data-el="an-gap">
			<p class="dg-label">{t('Hueco', 'Gap')}</p>
			<code class="dg-code">public abstract double area();</code>
			<p class="dg-sub">{t('Sin cuerpo: la subclase debe escribirlo', 'No body: the subclass must write it')}</p>
		</div>
		<div class="dg-box dg-box--sage" data-el="an-body">
			<p class="dg-label dg-label--sage">{t('Resuelto', 'Solved')}</p>
			<code class="dg-code">public void describe()</code>
			<p class="dg-sub">{t('Con cuerpo: se hereda tal cual', 'Has a body: inherited as is')}</p>
		</div>
		<div class="dg-box dg-box--ink" data-el="an-rule">
			<p class="dg-title">{t('No se puede instanciar · una clase extiende UNA sola', 'Cannot be instantiated · a class extends ONE only')}</p>
		</div>
	</div>

	<!-- 1. The abstract mold (motion canvas) -->
	<div slot="scene" data-scene="abs" data-motion class="scene-canvas">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<text class="mg-mono mg-mono--dark mg-big" x="60" y="64" data-el="a-decl">public abstract class Shape</text>

				<g data-el="a-shape">
					<rect class="mg-card mg-card--sage" x="60" y="96" width="980" height="330" rx="22" style="stroke-dasharray: 10 7" />
					<text class="mg-text mg-text--strong mg-chip-text--sage" x="90" y="132">abstract class Shape</text>
				</g>

				<g data-el="r-state">
					<rect class="mg-card" x="80" y="150" width="720" height="52" rx="14" />
					<text class="mg-mono mg-mono--dark" x="100" y="183">protected final String name;</text>
				</g>
				<g data-el="tag-state">
					<rect class="mg-chip mg-chip--sage" x="880" y="157" width="150" height="38" rx="19" />
					<text class="mg-chip-text mg-chip-text--sage" x="955" y="182" text-anchor="middle">{t('ESTADO', 'STATE')}</text>
				</g>

				<g data-el="r-area">
					<rect class="mg-card mg-card--accent" x="80" y="215" width="720" height="52" rx="14" style="stroke-dasharray: 8 6" />
					<text class="mg-mono mg-mono--dark" x="100" y="248">public abstract double area();</text>
				</g>
				<g data-el="tag-gap1">
					<rect class="mg-chip" x="880" y="222" width="150" height="38" rx="19" />
					<text class="mg-chip-text" x="955" y="247" text-anchor="middle">{t('SIN CUERPO', 'NO BODY')}</text>
				</g>

				<g data-el="r-perim">
					<rect class="mg-card mg-card--accent" x="80" y="280" width="720" height="52" rx="14" style="stroke-dasharray: 8 6" />
					<text class="mg-mono mg-mono--dark" x="100" y="313">public abstract double perimeter();</text>
				</g>
				<g data-el="tag-gap2">
					<rect class="mg-chip" x="880" y="287" width="150" height="38" rx="19" />
					<text class="mg-chip-text" x="955" y="312" text-anchor="middle">{t('SIN CUERPO', 'NO BODY')}</text>
				</g>

				<g data-el="r-describe">
					<rect class="mg-card mg-card--sage" x="80" y="345" width="720" height="52" rx="14" />
					<text class="mg-mono mg-mono--dark" x="100" y="378">public void describe() {'{ … }'}</text>
				</g>
				<g data-el="tag-body">
					<rect class="mg-chip mg-chip--sage" x="880" y="352" width="150" height="38" rx="19" />
					<text class="mg-chip-text mg-chip-text--sage" x="955" y="377" text-anchor="middle">{t('CON CUERPO', 'HAS BODY')}</text>
				</g>

				<g data-el="call-area" class="mg-arrow">
					<path class="mg-stroke" d="M800 371C875 371 875 241 806 241" pathLength="1" />
					<path class="mg-head" d="M818 231L806 241L818 251" />
				</g>
				<g data-el="call-perim" class="mg-arrow">
					<path class="mg-stroke" d="M800 371C850 371 850 306 806 306" pathLength="1" />
					<path class="mg-head" d="M818 296L806 306L818 316" />
				</g>

				<rect class="mg-card mg-card--ink" data-el="newcard" x="1090" y="100" width="470" height="100" rx="18" />
				<text class="mg-mono mg-big" data-el="newtext" x="1115" y="160">Shape s = new Shape("x");</text>
				<g data-el="newerr">
					<rect class="mg-chip" x="1090" y="230" width="470" height="70" rx="22" />
					<text class="mg-chip-text mg-chip-text--lg" x="1325" y="259" text-anchor="middle">error: Shape is abstract;</text>
					<text class="mg-chip-text mg-chip-text--lg" x="1325" y="285" text-anchor="middle">cannot be instantiated</text>
				</g>
				<g data-el="ban" class="mg-arrow">
					<circle class="mg-stroke" cx="1325" cy="420" r="70" pathLength="1" />
					<path class="mg-stroke" d="M1275 470L1375 370" pathLength="1" />
				</g>

				<g data-el="circ">
					<rect class="mg-card mg-card--accent" x="80" y="500" width="470" height="140" rx="20" />
					<text class="mg-heading" x="110" y="543">Circle</text>
					<text class="mg-mono mg-mono--dark" x="110" y="575">extends Shape</text>
				</g>
				<g data-el="rect">
					<rect class="mg-card mg-card--accent" x="580" y="500" width="470" height="140" rx="20" />
					<text class="mg-heading" x="610" y="543">Rectangle</text>
					<text class="mg-mono mg-mono--dark" x="610" y="575">extends Shape</text>
					<text class="mg-text mg-text--muted" x="610" y="615">area() · perimeter()</text>
				</g>
				<g data-el="ext-circ" class="mg-arrow mg-arrow--sage">
					<path class="mg-stroke" d="M315 500V430" pathLength="1" />
					<path class="mg-head" d="M303 442L315 430L327 442" />
				</g>
				<g data-el="ext-rect" class="mg-arrow mg-arrow--sage">
					<path class="mg-stroke" d="M815 500V430" pathLength="1" />
					<path class="mg-head" d="M803 442L815 430L827 442" />
				</g>

				<g data-el="impl-area" data-x="200" data-y="610">
					<rect class="mg-chip mg-chip--sage" x="-90" y="-22" width="180" height="44" rx="22" />
					<text class="mg-chip-text mg-chip-text--sage" x="0" y="6" text-anchor="middle">area()</text>
				</g>
				<g data-el="impl-perim" data-x="410" data-y="610">
					<rect class="mg-chip mg-chip--sage" x="-90" y="-22" width="180" height="44" rx="22" />
					<text class="mg-chip-text mg-chip-text--sage" x="0" y="6" text-anchor="middle">perimeter()</text>
				</g>
				<g data-el="fill-area">
					<rect class="mg-card mg-card--sage" x="80" y="215" width="720" height="52" rx="14" />
					<text class="mg-mono mg-mono--dark" x="100" y="248">Circle: Math.PI * r * r</text>
				</g>
				<g data-el="fill-perim">
					<rect class="mg-card mg-card--sage" x="80" y="280" width="720" height="52" rx="14" />
					<text class="mg-mono mg-mono--dark" x="100" y="313">Circle: 2 * Math.PI * r</text>
				</g>

				<g data-el="warn">
					<rect class="mg-chip" x="1090" y="500" width="470" height="140" rx="22" />
					<text class="mg-mono mg-mono--dark" x="1325" y="548" text-anchor="middle">class Triangle extends Shape</text>
					<text class="mg-chip-text mg-chip-text--lg" x="1325" y="584" text-anchor="middle">{t('falta perimeter()', 'perimeter() is missing')}</text>
					<text class="mg-chip-text mg-chip-text--lg" x="1325" y="614" text-anchor="middle">{t('→ debe declararse abstract', '→ it must be declared abstract')}</text>
				</g>
			</g>
		</svg>
	</div>

	<!-- 2. Anatomy of an interface -->
	<div slot="scene" data-scene="iface-anatomy" class="scene-iface-anatomy">
		<div class="dg-box dg-box--sage" data-el="if-const">
			<p class="dg-label dg-label--sage">{t('Constante', 'Constant')}</p>
			<code class="dg-code">int MAX_LAYERS = 10;</code>
			<p class="dg-sub">public static final</p>
		</div>
		<div class="dg-box dg-box--accent" data-el="if-abs">
			<p class="dg-label">{t('Abstracto', 'Abstract')}</p>
			<code class="dg-code">void draw();</code>
			<p class="dg-sub">{t('Público y abstracto por defecto', 'Public and abstract by default')}</p>
		</div>
		<div class="dg-box" data-el="if-def">
			<p class="dg-label">default</p>
			<code class="dg-code">default void highlight()</code>
			<p class="dg-sub">{t('Implementación heredable (Java 8+)', 'Inheritable implementation (Java 8+)')}</p>
		</div>
		<div class="dg-box" data-el="if-static">
			<p class="dg-label">static</p>
			<code class="dg-code">static Drawable empty()</code>
			<p class="dg-sub">{t('Utilidad de la interfaz misma', 'A utility of the interface itself')}</p>
		</div>
		<div class="dg-box dg-box--ink" data-el="if-rule">
			<p class="dg-title">{t('Sin estado de instancia · implementás todas las que quieras', 'No instance state · implement as many as you want')}</p>
		</div>
	</div>

	<!-- 2. The signed contract (motion canvas) -->
	<div slot="scene" data-scene="contract" data-motion class="scene-canvas">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<g data-el="payable">
					<rect class="mg-card mg-card--accent" x="560" y="40" width="480" height="250" rx="22" />
					<text class="mg-heading" x="800" y="86" text-anchor="middle">«interface» Payable</text>
				</g>
				<g data-el="cl-pay">
					<rect class="mg-card" x="590" y="112" width="420" height="46" rx="14" />
					<text class="mg-mono mg-mono--dark" x="608" y="142">boolean pay(double amount);</text>
				</g>
				<g data-el="cl-avail">
					<rect class="mg-card" x="590" y="168" width="420" height="46" rx="14" />
					<text class="mg-mono mg-mono--dark" x="608" y="198">boolean isAvailable();</text>
				</g>
				<g data-el="cl-def">
					<rect class="mg-card mg-card--sage" x="590" y="224" width="420" height="46" rx="14" />
					<text class="mg-mono mg-mono--dark" x="608" y="254">default void payIfPossible(…)</text>
				</g>

				<g data-el="cc">
					<rect class="mg-card" x="80" y="410" width="440" height="170" rx="22" />
					<text class="mg-heading" x="110" y="458">CreditCard</text>
					<text class="mg-mono mg-mono--dark" x="110" y="496">implements Payable</text>
					<text class="mg-text mg-text--muted" x="110" y="540">{t('crédito: $50000', 'credit: $50000')}</text>
				</g>
				<g data-el="dw">
					<rect class="mg-card mg-card--sage" x="580" y="410" width="440" height="170" rx="22" />
					<text class="mg-heading" x="610" y="458">DigitalWallet</text>
					<text class="mg-mono mg-mono--dark" x="610" y="496">implements Payable</text>
					<text class="mg-mono mg-mono--dark" x="610" y="528">extends DigitalPaymentMethod</text>
					<text class="mg-text mg-text--muted" x="610" y="560">{t('saldo: $30000', 'balance: $30000')}</text>
				</g>
				<g data-el="ew">
					<rect class="mg-card" x="1080" y="410" width="440" height="170" rx="22" />
					<text class="mg-heading" x="1110" y="458">emptyWallet</text>
					<text class="mg-mono mg-mono--dark" x="1110" y="496">implements Payable</text>
					<text class="mg-text mg-text--muted" x="1110" y="540">{t('saldo: $0', 'balance: $0')}</text>
				</g>

				<g data-el="lab-impl">
					<rect class="mg-chip" x="60" y="330" width="190" height="40" rx="20" />
					<text class="mg-chip-text" x="155" y="356" text-anchor="middle">implements</text>
				</g>
				<g data-el="arr-1" class="mg-arrow mg-arrow--sage">
					<path class="mg-stroke" d="M300 410C300 350 640 360 700 296" pathLength="1" />
					<path class="mg-head" d="M698 312L700 296L684 299" />
				</g>
				<g data-el="arr-2" class="mg-arrow mg-arrow--sage">
					<path class="mg-stroke" d="M800 410V300" pathLength="1" />
					<path class="mg-head" d="M788 314L800 300L812 314" />
				</g>
				<g data-el="arr-3" class="mg-arrow mg-arrow--sage">
					<path class="mg-stroke" d="M1300 410C1300 350 960 360 900 296" pathLength="1" />
					<path class="mg-head" d="M902 312L900 296L916 299" />
				</g>

				<g data-el="sig-1">
					<circle class="mg-dot--3" cx="480" cy="450" r="24" />
					<path class="mg-check" stroke-width="2.75" transform="translate(466.2 436.8) scale(1.15)" d="M20 6 9 17l-5-5" />
				</g>
				<g data-el="sig-2">
					<circle class="mg-dot--3" cx="980" cy="450" r="24" />
					<path class="mg-check" stroke-width="2.75" transform="translate(966.2 436.8) scale(1.15)" d="M20 6 9 17l-5-5" />
				</g>
				<g data-el="sig-3">
					<circle class="mg-dot--3" cx="1480" cy="450" r="24" />
					<path class="mg-check" stroke-width="2.75" transform="translate(1466.2 436.8) scale(1.15)" d="M20 6 9 17l-5-5" />
				</g>

				<g data-el="coin" data-x="800" data-y="340">
					<rect class="mg-chip" x="-80" y="-24" width="160" height="48" rx="24" />
					<text class="mg-chip-text mg-chip-text--lg" x="0" y="6" text-anchor="middle">$12,500</text>
				</g>
				<g data-el="res-1">
					<rect class="mg-chip mg-chip--sage" x="80" y="598" width="440" height="44" rx="22" />
					<text class="mg-chip-text mg-chip-text--sage" x="300" y="627" text-anchor="middle">{t('✓ crédito restante $37500', '✓ remaining credit $37500')}</text>
				</g>
				<g data-el="res-2">
					<rect class="mg-chip mg-chip--sage" x="580" y="598" width="440" height="44" rx="22" />
					<text class="mg-chip-text mg-chip-text--sage" x="800" y="627" text-anchor="middle">{t('✓ saldo restante $17500', '✓ remaining balance $17500')}</text>
				</g>
				<g data-el="res-3">
					<rect class="mg-chip" x="1080" y="598" width="440" height="44" rx="22" />
					<text class="mg-chip-text" x="1300" y="627" text-anchor="middle">{t('✗ no disponible: cobro omitido', '✗ unavailable: charge skipped')}</text>
				</g>
			</g>
		</svg>
	</div>

	<!-- 3. default, static and adapters -->
	<div slot="scene" data-scene="evolve" class="scene-evolve">
		<div class="dg-box" data-el="ev-before">
			<p class="dg-label">{t('Antes de Java 8', 'Before Java 8')}</p>
			<p class="dg-title">{t('Agregar un método rompía todo', 'Adding a method broke everything')}</p>
			<p class="dg-sub">{t('Las mil clases que ya la implementaban dejaban de compilar', 'The thousand classes already implementing it stopped compiling')}</p>
		</div>
		<div class="dg-box dg-box--sage" data-el="ev-default">
			<p class="dg-label dg-label--sage">default</p>
			<p class="dg-title">{t('Un método con cuerpo', 'A method with a body')}</p>
			<p class="dg-sub">{t('Las clases lo heredan y pueden sobrescribirlo o no', 'Classes inherit it and may override it or not')}</p>
		</div>
		<div class="dg-box dg-box--accent" data-el="ev-warn">
