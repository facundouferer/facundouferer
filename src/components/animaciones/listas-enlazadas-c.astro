---
/**
 * Scene for "Nodes linked by pointers" (lesson c/estructuras-dinamicas-listas,
 * order: 30), a short film played on one persistent motion canvas. The captions and
 * cues live in `src/data/animations/listas-enlazadas-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: the lesson's
 * functions (four small programs, swapped as the story moves on), with a bar that
 * slides to the line being executed and the program output typed below. The viewport
 * on the right holds the camera: three floors, the heap with the nodes of the list,
 * the stack frame with the pointer variables and one module per instruction labelled
 * with its editor line. A node is two cells, `dato` and `siguiente`, with its address
 * on the front edge; `siguiente` is always an arrow to the next node (one identity for
 * "a pointer", the same for the variables on the stack). A key marks who owns a node.
 * Magenta marks the exceptional (`NULL`, uninitialized cells, a read after `free`);
 * violet marks what resolves it (the `NULL` check, `free`, the key of the owner).
 * Addresses are short and fictional; real ones vary.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/listas-enlazadas-c';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── The programs shown in the editor ──────────────────────────────────────
// The lesson's functions, condensed to fit the editor (no includes, one-line NULL
// checks), each with the few lines of `main` that call them. Identifiers are
// localized like the lesson does.
const n = {
	node: t('Nodo', 'Node'),
	value: t('dato', 'value'),
	next: t('siguiente', 'next'),
	head: t('cabeza', 'head'),
	create: t('crear_nodo', 'create_node'),
	local: t('nodo', 'node'),
	front: t('insertar_al_inicio', 'insert_front'),
	fresh: t('nuevo', 'new_node'),
	back: t('insertar_al_final', 'insert_back'),
	last: t('ultimo', 'last'),
	del: t('eliminar', 'delete_value'),
	cur: t('actual', 'current'),
	prev: t('anterior', 'previous'),
	destroy: t('destruir_lista', 'destroy_list'),
	print: t('imprimir_lista', 'print_list'),
};
const progA = [
	`typedef struct ${n.node} {`,
	`    int ${n.value};`,
	`    struct ${n.node} *${n.next};`,
	`} ${n.node};`,
	`${n.node} *${n.create}(int ${n.value}) {`,
	`    ${n.node} *${n.local} = malloc(sizeof *${n.local});`,
	`    if (${n.local} == NULL) { return NULL; }`,
	`    ${n.local}->${n.value} = ${n.value};`,
	`    ${n.local}->${n.next} = NULL;`,
	`    return ${n.local};`,
	'}',
	`bool ${n.front}(${n.node} **${n.head}, int ${n.value}) {`,
	`    ${n.node} *${n.fresh} = ${n.create}(${n.value});`,
	`    if (${n.fresh} == NULL) { return false; }`,
	`    ${n.fresh}->${n.next} = *${n.head};`,
	`    *${n.head} = ${n.fresh};`,
	'    return true;',
	'}',
	'int main(void) {',
	`    ${t('// la lista ya es 3 -> 7 -> 9', '// the list is already 3 -> 7 -> 9')}`,
	`    ${n.front}(&${n.head}, 5);`,
	`    ${n.print}(${n.head});`,
	'}',
].join('\n');
const progB = [
	`bool ${n.back}(${n.node} **${n.head}, int ${n.value}) {`,
	`    ${n.node} *${n.fresh} = ${n.create}(${n.value});`,
	`    if (${n.fresh} == NULL) { return false; }`,
	`    if (*${n.head} == NULL) {`,
	`        *${n.head} = ${n.fresh};`,
	'        return true;',
	'    }',
	`    ${n.node} *${n.last} = *${n.head};`,
	`    while (${n.last}->${n.next} != NULL) {`,
	`        ${n.last} = ${n.last}->${n.next};`,
	'    }',
	`    ${n.last}->${n.next} = ${n.fresh};`,
	'    return true;',
	'}',
	'int main(void) {',
	`    ${n.back}(&${n.head}, 11);`,
	`    ${n.print}(${n.head});`,
	'}',
].join('\n');
const progC = [
	`bool ${n.del}(${n.node} **${n.head}, int ${n.value}) {`,
	`    ${n.node} *${n.cur} = *${n.head};`,
	`    ${n.node} *${n.prev} = NULL;`,
	`    while (${n.cur} != NULL && ${n.cur}->${n.value} != ${n.value}) {`,
	`        ${n.prev} = ${n.cur};`,
	`        ${n.cur} = ${n.cur}->${n.next};`,
	'    }',
	`    if (${n.cur} == NULL) { return false; }`,
	`    if (${n.prev} == NULL) {`,
	`        *${n.head} = ${n.cur}->${n.next};`,
	'    } else {',
	`        ${n.prev}->${n.next} = ${n.cur}->${n.next};`,
	'    }',
	`    free(${n.cur});`,
	'    return true;',
	'}',
	'int main(void) {',
	`    ${n.del}(&${n.head}, 7);`,
	`    ${n.print}(${n.head});`,
	`    ${n.del}(&${n.head}, 5);`,
	`    ${n.print}(${n.head});`,
	'}',
].join('\n');
const progD = [
	`void ${n.destroy}(${n.node} **${n.head}) {`,
	`    ${n.node} *${n.cur} = *${n.head};`,
	`    while (${n.cur} != NULL) {`,
	`        ${n.node} *${n.next} = ${n.cur}->${n.next};`,
	`        free(${n.cur});`,
	`        ${n.cur} = ${n.next};`,
	'    }',
	`    *${n.head} = NULL;`,
	'}',
	'int main(void) {',
	`    ${n.destroy}(&${n.head});`,
	`    ${n.print}(${n.head});`,
	'}',
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const toLines = (source: string) =>
	highlightCode(source, 'c').map((html, index) => ({
		n: index + 1,
		html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
	}));
const programs = [
	{ id: 'ed-a', file: 'file-a', name: t('lista.c', 'list.c'), lines: toLines(progA), base: 'shown' },
	{ id: 'ed-b', file: 'file-b', name: t('al_final.c', 'append.c'), lines: toLines(progB), base: undefined },
	{ id: 'ed-c', file: 'file-c', name: t('eliminar.c', 'delete.c'), lines: toLines(progC), base: undefined },
	{ id: 'ed-d', file: 'file-d', name: t('destruir.c', 'destroy.c'), lines: toLines(progD), base: undefined },
];

// Real output, from compiling the lesson's functions with `cc -std=c23` and running
// the calls of the four programs in this order on the list 3 -> 7 -> 9.
const outputs = [
	{ id: 'o-a1', row: 0, text: '5 -> 3 -> 7 -> 9 -> NULL' },
	{ id: 'o-b1', row: 0, text: '5 -> 3 -> 7 -> 9 -> 11 -> NULL' },
	{ id: 'o-c1', row: 0, text: '5 -> 3 -> 9 -> 11 -> NULL' },
	{ id: 'o-c2', row: 1, text: '3 -> 9 -> 11 -> NULL' },
	{ id: 'o-d1', row: 0, text: 'NULL' },
];

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 66;
const LINE_H = 19;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (line: number) => CODE_TOP + (line - 1) * LINE_H;
const lineMid = (line: number) => lineTop(line) + LINE_H / 2;
const lineBase = (line: number) => lineMid(line) + 4.5;
const CONSOLE_TOP = 516;
const outY = (row: number) => 564 + row * 19;
const MAX_LINES = 23;

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up. The heap is the back floor,
// the stack frame the front-left floor and the instruction modules the front-right one.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 50;
const EY = 29;
const ORIGIN = { x: 610, y: 350 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
/** The grid coordinates of a point of the floor given by its screen position. */
const at = (x: number, y: number) => {
	const sum = (y - ORIGIN.y) / EY;
	const diff = (x - ORIGIN.x) / EX;
	return { u: round((sum + diff) / 2), v: round((sum - diff) / 2) };
};
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');

/** A box standing at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	const rightCenter = { x: round((front.x + right.x) / 2), y: round((front.y + right.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		corners: { back, right, front, left },
		bottomFront: down(front),
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
		rightMatrix: `matrix(0.866 -0.5 0 1 ${rightCenter.x} ${rightCenter.y})`,
	};
}
type Slab = ReturnType<typeof slab>;
type Tone = 'flow' | 'violet' | 'magenta';

// Floors: the heap behind, the stack frame and the program in front.
const heapAt = at(625, 230);
const stackAt = at(410, 545);
const progAt = at(790, 550);
const HEAP = slab(heapAt.u, heapAt.v, 3.2, 3.2, 14, -14);
const STACK = slab(stackAt.u, stackAt.v, 1.3, 1.3, 14, -14);
const PROG = slab(progAt.u, progAt.v, 1.9, 0.8, 10, -10);
const below = (g: Slab) => ({ x: g.bottomFront.x, y: g.bottomFront.y + 22 });
const floors = [
	{ id: 'floor-heap', g: HEAP, label: t('Montículo (heap)', 'Heap'), at: HEAP.rightMatrix, onFace: true },
	{ id: 'floor-stack', g: STACK, label: t('Pila (stack) · main', 'Stack · main'), at: below(STACK), onFace: false },
	{ id: 'floor-prog', g: PROG, label: t('Instrucciones', 'Instructions'), at: below(PROG), onFace: false },
];

// Heap nodes: two cells each (`dato`, `siguiente`), scattered along the heap floor with
// short fictional addresses that are not in order.
const CELL = 0.28;
const PITCH = 0.64;
type NodeSpec = { id: string; value: number; addr: string; sx: number; sy: number };
const nodes: NodeSpec[] = [
	{ id: 'n5', value: 5, addr: '0x5050', sx: 400, sy: 236 },
	{ id: 'n3', value: 3, addr: '0x5010', sx: 510, sy: 214 },
	{ id: 'n7', value: 7, addr: '0x5080', sx: 620, sy: 246 },
	{ id: 'n9', value: 9, addr: '0x5030', sx: 730, sy: 220 },
	{ id: 'n11', value: 11, addr: '0x50a0', sx: 840, sy: 242 },
];
const nodeSpec = (id: string) => nodes.find((item) => item.id === id) ?? nodes[0];
const cellOf = (id: string, index: number) => {
	const spec = nodeSpec(id);
	const origin = at(spec.sx, spec.sy);
	return slab(origin.u + index * PITCH, origin.v, CELL, CELL, 14, 0);
};
const cellTop = (id: string, index: number) => cellOf(id, index).center;
const nodeCells = nodes.map((spec) => ({ spec, cells: [0, 1].map((index) => ({ index, g: cellOf(spec.id, index) })) }));

// The field values: the `dato` of each node, what `siguiente` holds in each state and
// the `?` of a node that has just been reserved.
const nodeValues = nodes.map((spec) => ({ id: `dv-${spec.id}`, node: spec.id, index: 0, text: String(spec.value), tone: 'plain' as const }));
const nextValues = [
	{ id: 'sg-n5-null', node: 'n5', text: 'NULL', tone: 'magenta' as const },
	{ id: 'sg-n5-5010', node: 'n5', text: '0x5010', tone: 'flow' as const },
	{ id: 'sg-n3-5080', node: 'n3', text: '0x5080', tone: 'flow' as const },
	{ id: 'sg-n3-5030', node: 'n3', text: '0x5030', tone: 'flow' as const },
	{ id: 'sg-n7-5030', node: 'n7', text: '0x5030', tone: 'flow' as const },
	{ id: 'sg-n9-null', node: 'n9', text: 'NULL', tone: 'magenta' as const },
	{ id: 'sg-n9-50a0', node: 'n9', text: '0x50a0', tone: 'flow' as const },
	{ id: 'sg-n11-null', node: 'n11', text: 'NULL', tone: 'magenta' as const },
].map((item) => ({ ...item, index: 1 }));
const uninit = [
	{ id: 'q-n5-d', node: 'n5', index: 0, text: '?', tone: 'magenta' as const },
	{ id: 'q-n5-s', node: 'n5', index: 1, text: '?', tone: 'magenta' as const },
];
const fieldTexts = [...nodeValues, ...nextValues, ...uninit];

// Stack plates: the variables of `main` and of the function being run. Each state of
// a plate is its own text, so a change is a swap on the same plate.
type Plate = { id: string; name: string; g: Slab };
const plateAt = (du: number, dv: number) => slab(stackAt.u + du, stackAt.v + dv, 0.34, 0.34, 18, 0);
const SLOT = { back: plateAt(-0.65, -0.65), left: plateAt(-0.65, 0.65), right: plateAt(0.65, -0.65) };
const plates: Plate[] = [
	{ id: 'v-cabeza', name: n.head, g: SLOT.back },
	{ id: 'v-param', name: t('cabeza (param)', 'head (param)'), g: SLOT.right },
	{ id: 'v-nodo', name: n.local, g: SLOT.left },
	{ id: 'v-nuevo', name: n.fresh, g: SLOT.left },
	{ id: 'v-ultimo', name: n.last, g: SLOT.right },
	{ id: 'v-anterior', name: n.prev, g: SLOT.left },
	{ id: 'v-actual', name: n.cur, g: SLOT.right },
	{ id: 'v-siguiente', name: n.next, g: SLOT.left },
];
const plateOf = (id: string) => plates.find((item) => item.id === id) ?? plates[0];
const plateTop = (id: string) => plateOf(id).g.center;
const addressText = (state: string) => (state === 'null' ? 'NULL' : state === 'addr' ? `&${n.head}` : `0x${state}`);
const plateStates: [string, string[]][] = [
	['cabeza', ['5010', '5050', 'null']],
	['param', ['addr']],
	['nodo', ['5050']],
	['nuevo', ['5050', '50a0']],
	['ultimo', ['5050', '5010', '5080', '5030']],
	['anterior', ['5050', '5010', 'null']],
	['actual', ['5050', '5010', '5080', '5030', '50a0', 'null']],
	['siguiente', ['5030', '50a0', 'null']],
];
const plateValues = plateStates.flatMap(([plate, states]) =>
	states.map((state) => ({
		id: `pv-${plate}-${state}`,
		plate: `v-${plate}`,
		text: addressText(state),
		tone: state === 'null' ? ('magenta' as const) : ('flow' as const),
	})),
);

// Instruction modules: one per executed instruction, labelled with its editor line.
const COLS = 0.46;
const block = (u: number, v: number) => slab(u, v, 0.18, 0.18, 16, 0);
type Module = { id: string; lit: string; line: number; g: Slab; tone: Tone; prog: string };
const moduleSets: Record<string, [number, Tone][]> = {
	a: [[6, 'flow'], [7, 'violet'], [8, 'flow'], [9, 'flow'], [13, 'flow'], [14, 'violet'], [15, 'flow'], [16, 'flow'], [21, 'flow'], [22, 'flow']],
	b: [[2, 'flow'], [3, 'violet'], [4, 'flow'], [8, 'flow'], [9, 'flow'], [10, 'flow'], [12, 'flow'], [16, 'flow'], [17, 'flow']],
	c: [[2, 'flow'], [3, 'flow'], [4, 'flow'], [5, 'flow'], [6, 'flow'], [8, 'violet'], [9, 'flow'], [10, 'flow'], [12, 'flow'], [14, 'violet'], [18, 'flow'], [19, 'flow'], [20, 'flow'], [21, 'flow']],
	d: [[2, 'flow'], [3, 'flow'], [4, 'flow'], [5, 'violet'], [6, 'flow'], [8, 'violet'], [11, 'flow'], [12, 'flow']],
};
const modules: Module[] = Object.entries(moduleSets).flatMap(([prog, specs]) =>
	specs.map(([line, tone], index) => {
		const row = index < 7 ? 0 : 1;
		const col = index < 7 ? index : index - 7;
		const u = round(progAt.u - 1.38 + col * COLS);
		const v = round(progAt.v + (row === 0 ? -0.36 : 0.36));
		return { id: `m-${prog}${line}`, lit: `on-${prog}${line}`, line, tone, prog, g: block(u, v) };
	}),
);
const moduleOf = (id: string) => (modules.find((item) => item.id === id) ?? modules[0]).g;

// Gates: the `NULL` checks of `malloc`. Two posts on the module, a bar that lifts when the pointer is valid.
const GATE_H = 26;
const gates = [
	{ id: 'gt-a7', g: moduleOf('m-a7') },
	{ id: 'gt-a14', g: moduleOf('m-a14') },
	{ id: 'gt-b3', g: moduleOf('m-b3') },
].map((gate) => {
	const { left, right } = gate.g.corners;
	return { ...gate, left, right, leftTop: lift(left, GATE_H), rightTop: lift(right, GATE_H) };
});

// Pointers: arrows from a cell or a plate to the first cell of a node (one identity for "a pointer").
type ArrowSpec = { id: string; from: Point; to: Point };
function arrowPath(from: Point, to: Point) {
	const distance = Math.hypot(to.x - from.x, to.y - from.y);
	const arc = Math.min(90, Math.max(26, distance * 0.28));
	const control = { x: round((from.x + to.x) / 2), y: round(Math.min(from.y, to.y) - arc) };
	const d = `M${from.x} ${from.y} Q${control.x} ${control.y} ${to.x} ${to.y}`;
	const dx = to.x - control.x;
	const dy = to.y - control.y;
	const length = Math.hypot(dx, dy) || 1;
	const ux = dx / length;
	const uy = dy / length;
	const base = { x: to.x - ux * 11, y: to.y - uy * 11 };
	const head = poly([to, { x: round(base.x - uy * 6), y: round(base.y + ux * 6) }, { x: round(base.x + uy * 6), y: round(base.y - ux * 6) }]);
	const mid = { x: round(0.25 * from.x + 0.5 * control.x + 0.25 * to.x), y: round(0.25 * from.y + 0.5 * control.y + 0.25 * to.y) };
	return { d, head, mid };
}
const tip = (id: string) => lift(cellTop(id, 0), 10);
const nextTail = (id: string) => lift(cellTop(id, 1), 6);
const varTail = (plate: string) => lift(plateTop(`v-${plate}`), 12);
const links: [string, string][] = [['n5', 'n3'], ['n3', 'n7'], ['n7', 'n9'], ['n9', 'n11'], ['n3', 'n9']];
const walkers: [string, string[]][] = [
	['cabeza', ['n3', 'n5']],
	['nodo', ['n5']],
	['nuevo', ['n5', 'n11']],
	['ultimo', ['n5', 'n3', 'n7', 'n9']],
	['anterior', ['n5', 'n3']],
	['actual', ['n5', 'n3', 'n7', 'n9', 'n11']],
	['siguiente', ['n9', 'n11']],
];
const arrowSpecs: ArrowSpec[] = [
	...links.map(([from, to]) => ({ id: `lk-${from}-${to}`, from: nextTail(from), to: tip(to) })),
	...walkers.flatMap(([plate, targets]) => targets.map((target) => ({ id: `ar-${plate}-${target}`, from: varTail(plate), to: tip(target) }))),
	{ id: 'ar-param-cabeza', from: varTail('param'), to: lift(plateTop('v-cabeza'), 12) },
];
const arrows = arrowSpecs.map((arrow) => ({ ...arrow, ...arrowPath(arrow.from, arrow.to) }));
const midOf = (id: string) => (arrows.find((item) => item.id === id) ?? arrows[0]).mid;

// Where the particle stops (just above a module, or in front of a gate).
const anchors = modules.map((module) => ({ id: `a-${module.id.replace('-', '')}`, ...lift(module.g.center, 16) }));

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shots = [
	{ id: 'shot-all', c: { x: 625, y: 340 }, s: 0.92 },
	{ id: 'shot-list', c: { x: 625, y: 300 }, s: 1.0 },
	{ id: 'shot-new', c: { x: 610, y: 350 }, s: 0.95 },
	{ id: 'shot-head', c: { x: 595, y: 352 }, s: 0.97 },
	{ id: 'shot-tail', c: { x: 630, y: 348 }, s: 0.93 },
	{ id: 'shot-del', c: { x: 625, y: 350 }, s: 0.94 },
	{ id: 'shot-destroy', c: { x: 625, y: 348 }, s: 0.93 },
].map((item) => ({
	id: item.id,
	x: round(item.c.x - 640 / item.s),
	y: round(item.c.y - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = { id: string; text: string; x: number; y: number; align: 'start' | 'end' | 'middle'; tone: 'plain' | Tone; mono?: boolean };
const N3 = cellTop('n3', 0);
const N3S = cellTop('n3', 1);
const N5 = cellTop('n5', 0);
const N7 = cellTop('n7', 0);
const N9S = cellTop('n9', 1);
const PARAM = plateTop('v-param');
const L5 = midOf('lk-n5-n3');
const HEADMID = midOf('ar-cabeza-n5');
const chips: Chip[] = [
	{ id: 'lb-dato', text: n.value, x: N3.x - 34, y: N3.y - 54, align: 'middle', tone: 'plain', mono: true },
	{ id: 'lb-sig', text: n.next, x: N3S.x + 34, y: N3S.y - 54, align: 'middle', tone: 'plain', mono: true },
	{ id: 'lb-end', text: t('fin de la lista', 'end of the list'), x: N9S.x + 6, y: N9S.y - 62, align: 'middle', tone: 'magenta' },
	{ id: 'lb-sizeof', text: `sizeof *${n.local}`, x: N5.x, y: N5.y - 74, align: 'middle', tone: 'flow', mono: true },
	{ id: 'lb-uninit', text: t('sin inicializar', 'uninitialized'), x: N5.x + 16, y: N5.y - 74, align: 'middle', tone: 'magenta' },
	{ id: 'lb-addr', text: t('direcciones ficticias', 'fictional addresses'), x: N5.x + 16, y: N5.y - 74, align: 'middle', tone: 'plain' },
	{ id: 'lb-owner', text: t('dueño: el llamador', 'owner: the caller'), x: N5.x + 14, y: N5.y + 54, align: 'middle', tone: 'violet' },
	{ id: 'lb-ptrptr', text: `${n.node} **${n.head} = &${n.head}`, x: PARAM.x + 38, y: PARAM.y - 100, align: 'middle', tone: 'flow', mono: true },
	{ id: 'lb-step1', text: t('1. enlazar', '1. link'), x: L5.x, y: L5.y - 34, align: 'middle', tone: 'violet' },
	{ id: 'lb-step2', text: t('2. mover cabeza', '2. move head'), x: HEADMID.x - 88, y: HEADMID.y - 6, align: 'middle', tone: 'violet' },
	{ id: 'lb-last', text: `${n.last}->${n.next} == NULL`, x: N9S.x + 6, y: N9S.y - 62, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'lb-rel-n7', text: t('liberado', 'released'), x: N7.x + 16, y: N7.y + 46, align: 'middle', tone: 'violet' },
	{ id: 'lb-nohead', text: `${n.prev} == NULL`, x: plateTop('v-anterior').x - 6, y: plateTop('v-anterior').y - 100, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'lb-uaf', text: t('leer tras free: inválido', 'read after free: invalid'), x: N3.x + 36, y: N3.y - 66, align: 'middle', tone: 'magenta' },
	{ id: 'lb-save', text: t('guardado antes de liberar', 'saved before the free'), x: N3.x + 36, y: N3.y - 66, align: 'middle', tone: 'violet' },
	{ id: 'lb-empty', text: t('lista vacía', 'empty list'), x: plateTop('v-cabeza').x + 4, y: plateTop('v-cabeza').y - 52, align: 'middle', tone: 'violet' },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + 24);
const chipLeft = (chip: Chip) => (chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x);

// Ownership keys: one below each node, drawn with the Lucide `key` icon.
const keys = nodes.map((spec) => ({ id: `key-${spec.id}`, x: round(cellTop(spec.id, 0).x - 8), y: round(cellTop(spec.id, 0).y + 31) }));

const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="le-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="le-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="le-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="le-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="le-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="le-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the heap, the stack and the instructions, seen through the camera -->
			<g clip-path="url(#le-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#le-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#le-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- Floors: the heap, the stack frame of main and the program -->
						{
							floors.map((floor) => (
								<g data-el={floor.id}>
									<polygon class="xj-plate-shadow" points={floor.g.base} transform="translate(12 18)" />
									<polygon class="xj-plate xj-plate--l" points={floor.g.leftFace} />
									<polygon class="xj-plate xj-plate--r" points={floor.g.rightFace} />
									<polygon class="xj-plate xj-plate--t" points={floor.g.top} fill="url(#le-g-floor)" />
									{floor.onFace ? (
										<text class="xj-area-label xj-area-label--face" transform={String(floor.at)} y="4" text-anchor="middle">
											{floor.label}
										</text>
									) : (
										<text class="xj-area-label" x={(floor.at as Point).x} y={(floor.at as Point).y} text-anchor="middle">
											{floor.label}
										</text>
									)}
								</g>
							))
						}

						<!-- Heap nodes: two cells each, with the address of the node on the front edge -->
						{
							nodeCells.map(({ spec, cells }) => (
								<g data-el={`nd-${spec.id}`}>
									{cells.map((cell) => (
										<g class="xj-cell">
											<polygon class="xj-shadow" points={cell.g.base} transform="translate(5 7)" />
											<polygon class="xj-face xj-face--l" points={cell.g.leftFace} />
											<polygon class="xj-face xj-face--r" points={cell.g.rightFace} />
											<polygon class:list={['xj-cell-top', { 'xj-cell-top--ptr': cell.index === 1 }]} points={cell.g.top} />
											{cell.index === 0 && (
												<text class="xj-addr" transform={cell.g.faceMatrix} text-anchor="middle" y="3">
													{spec.addr}
												</text>
											)}
										</g>
									))}
								</g>
							))
						}

						<!-- What each cell shows -->
						{
							fieldTexts.map((value) => {
								const top = cellTop(value.node, value.index);
								return (
									<g data-el={value.id}>
										<text class:list={['xj-val', `xj-val--${value.tone}`]} x={top.x} y={top.y + 4.5} text-anchor="middle">
											{value.text}
										</text>
									</g>
								);
							})
						}

						<!-- Released nodes: the cells are dead, their contents must not be used -->
						{
							nodeCells.map(({ spec, cells }) => (
								<g data-el={`rel-${spec.id}`} class="xj-rel">
									{cells.map((cell) => (
										<polygon points={cell.g.top} />
									))}
								</g>
							))
						}

						<!-- Ownership keys: the owner is the one that must release the node -->
						{
							keys.map((key) => (
								<g data-el={key.id} class="xj-key">
									<svg class="xj-icon" x={key.x} y={key.y} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
										<path d="m15.5 7.5 3 3L22 7l-3-3" />
										<path d="m21 2-9.6 9.6" />
										<circle cx="7.5" cy="15.5" r="5.5" />
									</svg>
								</g>
							))
						}

						<!-- Stack plates: one per variable, with its name in front -->
						{
							plates.map((item) => (
								<g data-el={item.id} class="xj-var">
									<polygon class="xj-shadow" points={item.g.base} transform="translate(6 8)" />
									<polygon class="xj-face xj-face--l" points={item.g.leftFace} />
									<polygon class="xj-face xj-face--r" points={item.g.rightFace} />
									<polygon class="xj-face xj-face--t" points={item.g.top} fill="url(#le-g-top)" />
									<text class="xj-var-name" x={item.g.bottomFront.x} y={item.g.bottomFront.y + 16} text-anchor="middle">
										{item.name}
									</text>
								</g>
							))
						}
						{
							plateValues.map((value) => {
								const top = plateTop(value.plate);
								return (
									<g data-el={value.id}>
										<text class:list={['xj-val', `xj-val--${value.tone}`]} x={top.x} y={top.y + 4.5} text-anchor="middle">
											{value.text}
										</text>
									</g>
								);
							})
						}

						<!-- Instruction modules: one per instruction, labelled with its editor line -->
						{
							modules.map((module) => (
								<>
									<g data-el={module.id} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#le-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
									<g data-el={module.lit} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
										<polygon class="xj-lit-halo" points={module.g.top} />
										<polygon class="xj-lit-top" points={module.g.top} />
										<polygon class="xj-lit-side" points={module.g.leftFace} />
										<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
								</>
							))
						}

						<!-- Gates: the NULL checks; the bar lifts when the pointer is valid -->
						{
							gates.map((gate) => (
								<>
									<g data-el={gate.id} class="xj-gate">
										<path d={`M${gate.left.x} ${gate.left.y} V${gate.leftTop.y} M${gate.right.x} ${gate.right.y} V${gate.rightTop.y}`} />
										<circle cx={gate.leftTop.x} cy={gate.leftTop.y} r="3" />
										<circle cx={gate.rightTop.x} cy={gate.rightTop.y} r="3" />
									</g>
									<g data-el={`${gate.id}-bar`} class="xj-gate-bar">
										<path d={`M${gate.leftTop.x} ${gate.leftTop.y + 8} H${gate.rightTop.x}`} />
									</g>
									<g data-el={`${gate.id}-open`} class="xj-gate-open">
										<path d={`M${gate.leftTop.x} ${gate.leftTop.y - 8} H${gate.rightTop.x}`} />
										<svg x={gate.rightTop.x + 6} y={gate.rightTop.y - 16} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75" class="xj-icon">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									</g>
								</>
							))
						}

						<!-- Pointers: `siguiente` links between nodes and the variables of the stack -->
						{
							arrows.map((arrow) => (
								<g data-el={arrow.id} class="xj-ptr">
									<path class="mg-stroke" pathLength="1" d={arrow.d} />
									<polygon class="mg-head" points={arrow.head} />
								</g>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									<text class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'} x={chipLeft(chip) + chipWidth(chip) / 2} y={chip.y + 4.5} text-anchor="middle">
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- The execution flow. Placement lives on data-x/y: the player resets data-el transforms. -->
						<g data-el="p" class="xj-particle" data-x={anchors[0].x} data-y={anchors[0].y}>
							<circle r="20" fill="url(#le-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="500" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<path class="xj-legend-ptr" d={`M${VP.x + 172} ${LEGEND_Y} H${VP.x + 190}`}></path>
				<polygon class="xj-legend-head" points={`${VP.x + 196},${LEGEND_Y} ${VP.x + 188},${LEGEND_Y - 5} ${VP.x + 188},${LEGEND_Y + 5}`}></polygon>
				<text x={VP.x + 204} y={LEGEND_Y + 4}>{t('Puntero', 'Pointer')}</text>
				<rect class="xj-legend-cell" x={VP.x + 282} y={LEGEND_Y - 7} width="16" height="14" rx="3"></rect>
				<text x={VP.x + 306} y={LEGEND_Y + 4}>{t('Celda de un nodo', 'Cell of a node')}</text>
				<svg class="xj-icon xj-legend-key" x={VP.x + 432} y={LEGEND_Y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
					<path d="m15.5 7.5 3 3L22 7l-3-3" />
					<path d="m21 2-9.6 9.6" />
					<circle cx="7.5" cy="15.5" r="5.5" />
				</svg>
				<text x={VP.x + 454} y={LEGEND_Y + 4}>{t('Dueño', 'Owner')}</text>
			</g>

			<!-- EDITOR: the program, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				{
					programs.map((program) => (
						<g data-el={program.file} data-base={program.base}>
							<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>
								{program.name}
							</text>
						</g>
					))
				}
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 24}>{t('SALIDA', 'OUTPUT')}</text>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(2)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				{
					programs.map((program) => (
						<g data-el={program.id} data-base={program.base} class="xj-code">
							{program.lines.map((line) => (
								<>
									<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
										{line.n}
									</text>
									<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
								</>
							))}
						</g>
					))
				}

				<!-- Console: what the program prints -->
				{
					outputs.map((row) => (
						<g data-el={row.id}>
							<text class="xj-out" x={ED.x + 20} y={outY(row.row)} xml:space="preserve">
								{row.text}
							</text>
						</g>
					))
				}
				{Array.from({ length: MAX_LINES }, (_, index) => <circle data-anchor={`ln-${index + 1}`} cx={BAR_CX} cy={lineMid(index + 1)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow and pointers, magenta for the exceptional (NULL,
	   uninitialized cells, a read after free) and violet for what resolves it (the
	   NULL check, free, the key of the owner).
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='listas-enlazadas-c']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='listas-enlazadas-c'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='listas-enlazadas-c'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='listas-enlazadas-c'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-ptr {
		fill: none;
		stroke: var(--xj-flow);
		stroke-width: 2.5;
		stroke-linecap: round;
	}

	.xj-legend-head {
		fill: var(--xj-flow);
	}

	.xj-legend-cell {
		fill: var(--xj-steel);
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
	}

	.xj-legend .xj-legend-key {
		stroke: var(--xj-violet-soft);
	}

	/* Floors, cells, plates and modules */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
