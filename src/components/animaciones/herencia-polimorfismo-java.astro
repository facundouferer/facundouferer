---
/**
 * Scenes for the "Inheritance, polymorphism and overloading, step by step"
 * animation (lesson java/10). The captions, code and terminal panels live in
 * `src/data/animations/herencia-polimorfismo-java.ts`; this component only draws
 * the diagrams the steps point to. Slide scenes are HTML blocks (`[data-scene]`
 * with `[data-el]` elements); the `hier`, `chain`, `ovl`, `poly`, `fleet`,
 * `compose` and `obj` scenes are SVG canvases (`data-motion`) choreographed by
 * the cues of their motion steps.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/herencia-polimorfismo-java';
import { resolveScript } from '../../utils/animations';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// Identifiers follow the lesson of each language (Vehiculo/Vehicle, Auto/Car…).
const n = isEs
	? {
			V: 'Vehiculo', C: 'Auto', M: 'Moto', T: 'Camion', Tx: 'Camión', Bike: 'Bicicleta', Engine: 'Motor',
			brand: 'marca', start: 'arrancar', brake: 'frenar', trunk: 'abrirBaul', wheelie: 'hacerCaballito',
			load: 'cargar', ignite: 'encender', Garage: 'Taller', inspect: 'revisar', fleet: 'flota',
			print: 'imprimir', text: 'texto', num: 'numero', times: 'veces', compute: 'calcular', car: 'auto',
			EngineE: 'MotorElectrico', EngineF: 'MotorFalso', Emp: 'Empleado', Mgr: 'Gerente', Sales: 'Vendedor',
			calcSalary: 'calcularSalario',
		}
	: {
			V: 'Vehicle', C: 'Car', M: 'Motorcycle', T: 'Truck', Tx: 'Truck', Bike: 'Bicycle', Engine: 'Engine',
			brand: 'brand', start: 'start', brake: 'brake', trunk: 'openTrunk', wheelie: 'doWheelie',
			load: 'load', ignite: 'ignite', Garage: 'Garage', inspect: 'inspect', fleet: 'fleet',
			print: 'print', text: 'text', num: 'number', times: 'times', compute: 'compute', car: 'car',
			EngineE: 'ElectricEngine', EngineF: 'FakeEngine', Emp: 'Employee', Mgr: 'Manager', Sales: 'SalesRep',
			calcSalary: 'computeSalary',
		};

// ── Slide scene data ──────────────────────────────────────────────────────
const sharedMembers = [n.brand, `${n.start}()`, `${n.brake}()`];
const overrideRules = [
	{ id: 't1', name: t('Nombre y parámetros', 'Name and parameters'), rule: t('Idénticos: si cambian, es un método nuevo', 'Identical: if they change, it is a new method') },
	{ id: 't2', name: t('Tipo de retorno', 'Return type'), rule: t('El mismo, o un subtipo (retorno covariante)', 'The same, or a subtype (covariant return)') },
	{ id: 't3', name: t('Visibilidad', 'Visibility'), rule: t('La misma o más abierta, nunca más cerrada', 'The same or wider, never narrower') },
	{ id: 't4', name: t('Excepciones checked', 'Checked exceptions'), rule: t('Las mismas, menos, o subtipos', 'The same, fewer, or subtypes') },
	{ id: 't5', name: 'private · static · final', rule: t('No se pueden sobrescribir', 'Cannot be overridden') },
];
const mistakes = [
	{ id: 'e1', title: t('Sobrescribir cambiando parámetros', 'Overriding with other parameters'), fix: t('Método nuevo. Poné siempre @Override', 'A new method. Always write @Override') },
	{ id: 'e2', title: t('Constructor hijo sin super(...)', 'Child constructor without super(...)'), fix: t('Llamá a super(argumentos) en la primera línea', 'Call super(arguments) on the first line') },
	{ id: 'e3', title: t('Método sobrescribible en el constructor del padre', 'Overridable method in the parent’s constructor'), fix: t('Usá solo métodos private o final', 'Use only private or final methods') },
	{ id: 'e4', title: t('Castear sin instanceof', 'Casting without instanceof'), fix: t('ClassCastException. Usá if (v instanceof X x)', 'ClassCastException. Use if (v instanceof X x)') },
	{ id: 'e5', title: t('Heredar solo para reutilizar código', 'Inheriting just to reuse code'), fix: t('Sin "es un", componé: tené el objeto y delegá', 'No "is-a": compose, hold the object and delegate') },
	{ id: 'e6', title: t('Confundir sobrecarga con sobrescritura', 'Mixing up overloading and overriding'), fix: t('Misma clase y firmas distintas vs. subclase y misma firma', 'Same class, different signatures vs. subclass, same signature') },
];
const exercises = [
	{ id: 'ex1', name: n.Emp, note: t('nombre, sueldoBase y calcularSalario()', 'name, baseSalary and computeSalary()') },
	{ id: 'ex2', name: n.Mgr, note: t('suma un bono con super.calcularSalario()', 'adds a bonus via super.computeSalary()') },
	{ id: 'ex3', name: n.Sales, note: t('suma una comisión del 8 % sobre sus ventas', 'adds an 8% commission on its sales') },
	{ id: 'ex4', name: 'toString()', note: t('sobrescrito en las tres clases', 'overridden in all three classes') },
	{ id: 'ex5', name: t('Un solo bucle', 'A single loop'), note: t('sobre un Empleado[]: sin instanceof ni casteos', 'over an Employee[]: no instanceof, no casts') },
];
const takeaways = [
	t('extends si un X es un Y', 'extends if an X is a Y'),
	t('super(...) sube, la ejecución baja', 'super(...) goes up, execution comes down'),
	t('@Override siempre', 'Always @Override'),
	t('Sobrecarga: compilador', 'Overloading: compiler'),
	t('Sobrescritura: JVM', 'Overriding: JVM'),
	t('La variable define qué llamás', 'The variable defines what you call'),
	t('Código que no conoce las subclases', 'Code that ignores the subclasses'),
	t('Composición antes que herencia', 'Composition over inheritance'),
];

// ── Motion canvas data ────────────────────────────────────────────────────
const fleetItems = [
	{ i: 0, x: 60, name: n.C, detail: `${n.brand} = "Toyota"`, line: t('Auto Toyota: arranca con botón', 'Car Toyota: starts with a button') },
	{ i: 1, x: 430, name: n.M, detail: `${n.brand} = "Honda"`, line: t('Moto Honda: arranca con patada', 'Motorcycle Honda: kick start') },
	{ i: 2, x: 800, name: n.Tx, detail: `${n.brand} = "Scania"`, line: t('Camión Scania: arranca con llave', 'Truck Scania: starts with a key') },
	{ i: 3, x: 1170, name: n.Bike, detail: `${n.brand} = "Trek"`, line: t('Bicicleta Trek: arranca pedaleando', 'Bicycle Trek: starts by pedaling') },
];
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<!-- INTRO: three classes repeating the same members -->
	<div slot="scene" data-scene="intro10" class="scene-intro10">
		<div class="dg-box" data-el="auto">
			<p class="dg-label">{n.C}</p>
			<div class="dg-chips">{sharedMembers.map((member) => <code class="dg-chip">{member}</code>)}</div>
		</div>
		<div class="dg-box" data-el="moto">
			<p class="dg-label">{n.M}</p>
			<div class="dg-chips">{sharedMembers.map((member) => <code class="dg-chip">{member}</code>)}</div>
		</div>
		<div class="dg-box" data-el="camion">
			<p class="dg-label">{n.Tx}</p>
			<div class="dg-chips">{sharedMembers.map((member) => <code class="dg-chip">{member}</code>)}</div>
		</div>
		<div class="dg-box dg-box--accent scene-intro10-wide" data-el="problem">
			<p class="dg-label">{t('Copiar y pegar', 'Copy and paste')}</p>
			<p class="dg-title">{t('Cambia una regla → hay que tocar tres lugares', 'A rule changes → you must touch three places')}</p>
		</div>
		<div class="dg-box dg-box--sage scene-intro10-wide" data-el="solution">
			<p class="dg-label dg-label--sage">{t('Herencia', 'Inheritance')}</p>
			<div class="dg-chips">
				<code class="dg-chip dg-chip--sage">{n.V}</code>
				{sharedMembers.map((member) => <code class="dg-chip dg-chip--sage">{member}</code>)}
			</div>
			<p class="dg-sub">{t('Lo común vive una sola vez, arriba; las subclases lo reciben con extends.', 'What is common lives once, on top; subclasses receive it with extends.')}</p>
		</div>
	</div>

	<!-- 1. The hierarchy (motion canvas) -->
	<div slot="scene" data-scene="hier" data-motion class="scene-canvas">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<text class="mg-mono mg-mono--dark mg-big" x="60" y="70" data-el="decl">public class {n.C} extends {n.V}</text>

				<g data-el="isa-yes">
					<rect class="mg-chip mg-chip--sage" x="60" y="22" width="560" height="48" rx="24" />
					<text class="mg-chip-text mg-chip-text--sage mg-chip-text--lg" x="340" y="53" text-anchor="middle">{t(`${n.C} es un ${n.V}  ✔`, `${n.C} is a ${n.V}  ✔`)}</text>
				</g>
				<g data-el="isa-no">
					<rect class="mg-chip" x="660" y="22" width="700" height="48" rx="24" />
					<text class="mg-chip-text mg-chip-text--lg" x="1010" y="53" text-anchor="middle">{t(`${n.C} no es un ${n.Engine}: tiene uno`, `${n.C} is not an ${n.Engine}: it has one`)}</text>
				</g>
				<g data-el="iface-lbl">
					<rect class="mg-chip mg-chip--sage" x="60" y="22" width="560" height="48" rx="24" />
					<text class="mg-chip-text mg-chip-text--sage mg-chip-text--lg" x="340" y="53" text-anchor="middle">{t('Para combinar: interfaces (lección siguiente)', 'To combine: interfaces (next lesson)')}</text>
				</g>

				<g data-el="ghost">
					<rect class="mg-card" x="60" y="110" width="440" height="190" rx="22" style="stroke-dasharray: 10 6" />
					<text class="mg-heading" x="90" y="156">{t('Otra clase', 'Another class')}</text>
					<text class="mg-text mg-text--muted" x="90" y="198">{t('(un segundo padre)', '(a second parent)')}</text>
				</g>
				<g data-el="a-ghost" class="mg-arrow">
					<path class="mg-stroke" d="M200 380C200 340 250 340 260 306" pathLength="1" />
					<path class="mg-head" d="M248 318L260 304L272 318" />
				</g>
				<text class="mg-xmark" x="232" y="362" text-anchor="middle" data-el="x-mark">×</text>

				<g data-el="vehiculo">
					<rect class="mg-card mg-card--sage" x="550" y="110" width="500" height="190" rx="22" />
					<text class="mg-heading" x="580" y="156">{n.V}</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="580" y="200">protected String {n.brand};</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="580" y="234">void {n.start}()</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="580" y="268">void {n.brake}()</text>
				</g>

				<g data-el="auto">
					<rect class="mg-card mg-card--accent" x="60" y="380" width="440" height="230" rx="22" />
					<text class="mg-heading" x="90" y="426">{n.C}</text>
				</g>
				<g data-el="moto">
					<rect class="mg-card" x="580" y="380" width="440" height="230" rx="22" />
					<text class="mg-heading" x="610" y="426">{n.M}</text>
				</g>
				<g data-el="camion">
					<rect class="mg-card" x="1100" y="380" width="440" height="230" rx="22" />
					<text class="mg-heading" x="1130" y="426">{n.Tx}</text>
				</g>

				<g data-el="a-auto" class="mg-arrow">
					<path class="mg-stroke" d="M280 380C280 340 640 340 660 306" pathLength="1" />
					<path class="mg-head" d="M648 318L660 304L674 318" />
				</g>
				<g data-el="a-moto" class="mg-arrow">
					<path class="mg-stroke" d="M800 380L800 308" pathLength="1" />
					<path class="mg-head" d="M788 320L800 306L812 320" />
				</g>
				<g data-el="a-camion" class="mg-arrow">
					<path class="mg-stroke" d="M1320 380C1320 340 960 340 940 306" pathLength="1" />
					<path class="mg-head" d="M926 316L940 304L952 320" />
				</g>

				<rect data-anchor="auto-slot-a" x="80" y="470" width="180" height="40" fill="none" />
				<rect data-anchor="auto-slot-b" x="300" y="470" width="180" height="40" fill="none" />
				<g data-el="fly-marca" data-x="700" data-y="196">
					<rect class="mg-chip" x="-90" y="-20" width="180" height="40" rx="20" />
					<text class="mg-chip-text" x="0" y="6" text-anchor="middle">{n.brand}</text>
				</g>
				<g data-el="fly-frenar" data-x="700" data-y="260">
					<rect class="mg-chip" x="-90" y="-20" width="180" height="40" rx="20" />
					<text class="mg-chip-text" x="0" y="6" text-anchor="middle">{n.brake}()</text>
				</g>
				<text class="mg-text mg-text--muted" x="610" y="494" data-el="inh-moto">{t('hereda:', 'inherits:')} {n.brand}, {n.brake}()</text>
				<text class="mg-text mg-text--muted" x="1130" y="494" data-el="inh-camion">{t('hereda:', 'inherits:')} {n.brand}, {n.start}()</text>
				<text class="mg-mono mg-mono--dark mg-mono--sm" x="90" y="594" data-el="own-auto">+ {n.trunk}()</text>
				<text class="mg-mono mg-mono--dark mg-mono--sm" x="610" y="594" data-el="own-moto">+ {n.wheelie}()</text>
				<text class="mg-mono mg-mono--dark mg-mono--sm" x="1130" y="594" data-el="own-camion">+ {n.load}(kg)</text>

				<g data-el="ovr-auto">
					<rect class="mg-chip" x="80" y="522" width="260" height="38" rx="19" />
					<text class="mg-chip-text" x="210" y="547" text-anchor="middle">@Override {n.start}()</text>
				</g>
				<g data-el="ovr-moto">
					<rect class="mg-chip" x="600" y="522" width="260" height="38" rx="19" />
					<text class="mg-chip-text" x="730" y="547" text-anchor="middle">@Override {n.start}()</text>
				</g>
				<g data-el="ovr-camion">
					<rect class="mg-chip" x="1120" y="522" width="260" height="38" rx="19" />
					<text class="mg-chip-text" x="1250" y="547" text-anchor="middle">@Override {n.brake}()</text>
				</g>
			</g>
		</svg>
	</div>

	<!-- 2. The constructor chain (motion canvas) -->
	<div slot="scene" data-scene="chain" data-motion class="scene-canvas">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<text class="mg-mono mg-mono--dark mg-big" x="60" y="62" data-el="decl">{n.C} a = new {n.C}("Toyota");</text>

				<g data-el="c-object">
					<rect class="mg-card" x="500" y="96" width="600" height="120" rx="22" />
					<text class="mg-mono mg-mono--dark mg-big" x="530" y="142">Object()</text>
					<text class="mg-text mg-text--muted" x="530" y="184">{t('La raíz implícita de toda clase Java', 'The implicit root of every Java class')}</text>
				</g>
				<g data-el="c-vehiculo">
					<rect class="mg-card mg-card--sage" x="500" y="262" width="600" height="120" rx="22" />
					<text class="mg-mono mg-mono--dark mg-big" x="530" y="308">{n.V}(String {n.brand})</text>
					<text class="mg-text mg-text--muted" x="530" y="350">this.{n.brand} = {n.brand};  {t('→ el estado heredado queda listo', '→ the inherited state is ready')}</text>
				</g>
				<g data-el="c-auto">
					<rect class="mg-card mg-card--accent" x="500" y="428" width="600" height="120" rx="22" />
					<text class="mg-mono mg-mono--dark mg-big" x="530" y="474">{n.C}(String {n.brand})</text>
					<text class="mg-text mg-text--muted" x="530" y="516">{t(`El cuerpo propio de ${n.C} corre ÚLTIMO`, `The own body of ${n.C} runs LAST`)}</text>
				</g>

				<g data-el="up1" class="mg-arrow">
					<path class="mg-stroke" d="M700 428L700 390" pathLength="1" />
					<path class="mg-head" d="M688 400L700 388L712 400" />
				</g>
				<g data-el="up2" class="mg-arrow">
					<path class="mg-stroke" d="M700 262L700 224" pathLength="1" />
					<path class="mg-head" d="M688 234L700 222L712 234" />
				</g>
				<text class="mg-mono mg-mono--dark mg-mono--sm" x="730" y="412" data-el="lbl-up1">super({n.brand})</text>
				<text class="mg-mono mg-mono--dark mg-mono--sm" x="730" y="246" data-el="lbl-up2">{t('super() implícito', 'implicit super()')}</text>

				<g data-el="dn1" class="mg-arrow mg-arrow--sage">
					<path class="mg-stroke" d="M900 222L900 256" pathLength="1" />
					<path class="mg-head" d="M888 246L900 258L912 246" />
				</g>
				<g data-el="dn2" class="mg-arrow mg-arrow--sage">
					<path class="mg-stroke" d="M900 388L900 422" pathLength="1" />
					<path class="mg-head" d="M888 412L900 424L912 412" />
				</g>

				<g data-el="run1">
					<circle class="mg-dot mg-dot--3" cx="1160" cy="156" r="28" />
					<text class="mg-chip-text mg-ptr-text" x="1160" y="165" text-anchor="middle">1</text>
				</g>
				<g data-el="run2">
					<circle class="mg-dot mg-dot--3" cx="1160" cy="322" r="28" />
					<text class="mg-chip-text mg-ptr-text" x="1160" y="331" text-anchor="middle">2</text>
				</g>
				<g data-el="run3">
					<circle class="mg-dot mg-dot--3" cx="1160" cy="488" r="28" />
					<text class="mg-chip-text mg-ptr-text" x="1160" y="497" text-anchor="middle">3</text>
				</g>

				<g data-el="tok" data-x="420" data-y="488">
					<circle class="mg-dot" cx="0" cy="0" r="24" />
					<text class="mg-chip-text mg-ptr-text" x="0" y="5" text-anchor="middle">new</text>
				</g>

				<g data-el="ready">
					<rect class="mg-chip mg-chip--sage" x="440" y="582" width="720" height="50" rx="25" />
					<text class="mg-chip-text mg-chip-text--sage mg-chip-text--lg" x="800" y="614" text-anchor="middle">{t(`Cuando corre ${n.C}, la parte heredada ya está lista`, `When ${n.C} runs, the inherited part is ready`)}</text>
				</g>
			</g>
		</svg>
	</div>

	<!-- 2b. Constructor rules (slides) -->
	<div slot="scene" data-scene="ctor-rules" class="scene-ctor">
		<div class="dg-box dg-box--accent" data-el="r1">
			<p class="dg-label"><span class="dg-step-num">1</span> {t('Primera sentencia', 'First statement')}</p>
			<code class="dg-code">super(...)</code>
			<p class="dg-sub">{t('Nada corre antes de que la parte heredada esté lista', 'Nothing runs before the inherited part is ready')}</p>
		</div>
		<div class="dg-box dg-box--sage" data-el="r2">
			<p class="dg-label dg-label--sage"><span class="dg-step-num">2</span> {t('Si falta', 'If missing')}</p>
			<code class="dg-code">super()</code>
			<p class="dg-sub">{t('Java lo inserta sin argumentos, automáticamente', 'Java inserts it with no arguments, automatically')}</p>
		</div>
		<div class="dg-box dg-box--accent" data-el="r3">
			<p class="dg-label"><span class="dg-step-num">3</span> {t('Sin constructor vacío en el padre', 'No empty constructor in the parent')}</p>
			<code class="dg-code">{t('no compila', 'does not compile')}</code>
			<p class="dg-sub">{t('Hay que llamar a uno que sí exista', 'You must call one that does exist')}</p>
		</div>
		<div class="dg-box dg-box--ink scene-ctor-wide" data-el="r-err">
			<p class="dg-label" style="color: var(--color-accent-300)">{t('Error de compilación', 'Compile error')}</p>
			<code class="dg-code">constructor {n.V} in class {n.V} cannot be applied to given types</code>
			<p class="dg-sub">{t(`Al escribir un constructor con argumentos, ${n.V} dejó de tener uno vacío`, `By writing a constructor with arguments, ${n.V} no longer has an empty one`)}</p>
		</div>
		<div class="dg-box dg-box--sage scene-ctor-wide" data-el="super-m">
			<p class="dg-label dg-label--sage">super.{n.start}()</p>
			<code class="dg-code">super.{n.start}(); {t('// extiende, no reemplaza', '// extends, does not replace')}</code>
			<p class="dg-sub">{t('Llama a la versión del padre de un método sobrescrito', 'Calls the parent’s version of an overridden method')}</p>
		</div>
	</div>

	<!-- 3. Overriding (slides) -->
	<div slot="scene" data-scene="override10" class="scene-override10">
		<div class="dg-box dg-box--sage" data-el="ann-what">
			<p class="dg-label dg-label--sage">@Override</p>
			<p class="dg-title">{t('Verificación del compilador', 'A compiler check')}</p>
			<p class="dg-sub">{t('No cambia la ejecución: confirma que realmente sobrescribís algo', 'It changes nothing at runtime: it confirms you really override something')}</p>
		</div>
		<div class="dg-box dg-box--accent" data-el="ann-miss">
			<p class="dg-label">{t('Sin la anotación', 'Without the annotation')}</p>
			<code class="dg-code">{n.start}(int {isEs ? 'velocidad' : 'speed'})</code>
			<p class="dg-sub">{t(`Es un método nuevo de ${n.C}: el original sigue heredado`, `It is a new method of ${n.C}: the original stays inherited`)}</p>
		</div>
		{
			overrideRules.map((rule) => (
				<div class="dg-box scene-override-row" data-el={rule.id}>
					<p class="dg-label">{rule.name}</p>
					<p class="dg-sub">{rule.rule}</p>
				</div>
			))
		}
	</div>

	<!-- 4. Overloading vs. overriding (motion canvas) -->
	<div slot="scene" data-scene="ovl" data-motion class="scene-canvas">
