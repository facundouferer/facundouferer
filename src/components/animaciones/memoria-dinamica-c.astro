---
/**
 * Scene for "Asking for memory and giving it back" (lesson c/memoria-dinamica,
 * order: 28), a short film played on one persistent motion canvas. The captions and
 * cues live in `src/data/animations/memoria-dinamica-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: the lesson's
 * growing array (and, in the last scene, its `calloc` example), with a bar that slides
 * to the line being executed and the program output typed below. The viewport on the
 * right holds the camera: two separate floors, the stack frame of `main` with one plate
 * per variable and the heap with its blocks, plus one module per instruction labelled
 * with its editor line. A heap block is a row of cells with the address on the front
 * edge and the value on top; a pointer is always an arrow from its plate to the first
 * cell of the block it points to. Magenta marks the problem (uninitialized cells,
 * `NULL`, a dangling pointer); violet marks what resolves it (the `NULL` check, `free`,
 * the zeros of `calloc`). Addresses are short and fictional; real ones vary.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/memoria-dinamica-c';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── The programs shown in the editor ──────────────────────────────────────
// The lesson's growing array (without the includes and the sum, to fit the editor)
// and its `calloc` example. Identifiers are localized like the lesson does.
const n = {
	cap: t('capacidad', 'capacity'),
	count: t('cantidad', 'count'),
	nums: t('numeros', 'numbers'),
	value: t('valor', 'value'),
	newCap: t('nueva_capacidad', 'new_capacity'),
	tmp: t('nuevo', 'bigger'),
	days: t('dias', 'days'),
	sales: t('ventas', 'sales'),
};
const growing = [
	'int main(void) {',
	`    size_t ${n.cap} = 4, ${n.count} = 0;`,
	`    int *${n.nums} = malloc(${n.cap} * sizeof *${n.nums});`,
	`    if (${n.nums} == NULL) {`,
	'        return 1;',
	'    }',
	`    int ${n.value};`,
	`    while (scanf("%d", &${n.value}) == 1 && ${n.value} != 0) {`,
	`        if (${n.count} == ${n.cap}) {`,
	`            size_t ${n.newCap} = ${n.cap} * 2;`,
	`            int *${n.tmp} = realloc(${n.nums},`,
	`                ${n.newCap} * sizeof *${n.nums});`,
	`            if (${n.tmp} == NULL) { free(${n.nums}); return 1; }`,
	`            ${n.nums} = ${n.tmp};`,
	`            ${n.cap} = ${n.newCap};`,
	'        }',
	`        ${n.nums}[${n.count}] = ${n.value};`,
	`        ${n.count}++;`,
	'    }',
	`    printf("${t('Leidos', 'Read')}: %zu (${n.cap} %zu)\\n", ${n.count}, ${n.cap});`,
	`    free(${n.nums});`,
	`    ${n.nums} = NULL;`,
	'}',
].join('\n');
const zeroed = [
	'int main(void) {',
	`    size_t ${n.days} = 7;`,
	`    int *${n.sales} = calloc(${n.days}, sizeof *${n.sales});`,
	`    if (${n.sales} == NULL) {`,
	'        return 1;',
	'    }',
	`    ${n.sales}[2] = 15;                ${t('// el resto ya vale 0', '// the rest is already 0')}`,
	`    for (size_t i = 0; i < ${n.days}; i++) {`,
	`        printf("${t('Dia', 'Day')} %zu: %d\\n", i + 1, ${n.sales}[i]);`,
	'    }',
	`    free(${n.sales});`,
	'    return 0;',
	'}',
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const toLines = (source: string) =>
	highlightCode(source, 'c').map((html, index) => ({
		n: index + 1,
		html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
	}));
const programs = [
	{ id: 'ed-a', file: 'file-a', name: t('arreglo_dinamico.c', 'dynamic_array.c'), lines: toLines(growing), base: 'shown' },
	{ id: 'ed-b', file: 'file-b', name: t('ventas.c', 'sales.c'), lines: toLines(zeroed), base: undefined },
];

// Real output, from compiling both programs with `cc -std=c23` and the input `5 8 13 2 7 0`.
const outputs = [
	{ id: 'o-in', row: 0, text: t('entrada: 5 8 13 2 7 0', 'input: 5 8 13 2 7 0'), meta: true },
	{ id: 'o-out', row: 1, text: t('Leidos: 5 (capacidad 8)', 'Read: 5 (capacity 8)'), meta: false },
	...[0, 15, 0, 0, 0, 0].reduce(
		(rows, value, index) => [...rows, { id: `o-b${index + 2}`, row: index + 1, text: `${t('Dia', 'Day')} ${index + 2}: ${value}`, meta: false }],
		[{ id: 'o-b1', row: 0, text: `${t('Dia', 'Day')} 1: 0`, meta: false }],
	),
];

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 66;
const LINE_H = 19;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (line: number) => CODE_TOP + (line - 1) * LINE_H;
const lineMid = (line: number) => lineTop(line) + LINE_H / 2;
const lineBase = (line: number) => lineMid(line) + 4.5;
const CONSOLE_TOP = 516;
const outY = (row: number) => 564 + row * 19;
const MAX_LINES = 23;

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up. The heap is the back floor,
// the stack frame the front-left floor and the instruction modules the front-right one.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 50;
const EY = 29;
const ORIGIN = { x: 610, y: 350 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');

/** A box standing at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		corners: { back, right, front, left },
		bottomFront: down(front),
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
	};
}
type Slab = ReturnType<typeof slab>;
type Tone = 'flow' | 'violet' | 'magenta';

// Floors: the heap behind, the stack frame and the program in front.
const HEAP = slab(1.0, -1.55, 3.0, 1.5, 14, -14);
const STACK = slab(-2.3, 1.6, 1.2, 1.2, 14, -14);
const PROG = slab(1.8, 1.275, 2.25, 0.7, 10, -10);
const below = (g: Slab) => ({ x: g.bottomFront.x, y: g.bottomFront.y + 22 });
const floors = [
	{ id: 'floor-heap', g: HEAP, label: t('Montículo (heap)', 'Heap'), at: pt(4.0, -0.8, -7), onFace: true },
	{ id: 'floor-stack', g: STACK, label: t('Pila (stack) · main', 'Stack · main'), at: below(STACK), onFace: false },
	{ id: 'floor-prog', g: PROG, label: t('Instrucciones', 'Instructions'), at: below(PROG), onFace: false },
];

// Heap blocks: one row of cells each, four bytes per `int`, short fictional addresses.
const CELL = 0.3;
const PITCH = 0.66;
const U0 = -1.25;
type Block = { id: string; row: number; size: number; base: number; shift: number };
const blocks: Block[] = [
	{ id: 'a', row: -2.65, size: 4, base: 0x1000, shift: 0 },
	{ id: 'b', row: -1.55, size: 8, base: 0x2000, shift: 0 },
	{ id: 'c', row: -0.45, size: 7, base: 0x3000, shift: 1 },
];
const cellOf = (block: Block, index: number) => slab(U0 + (index + block.shift) * PITCH, block.row, CELL, CELL, 14, 0);
const address = (block: Block, index: number) => `0x${(block.base + index * 4).toString(16)}`;
const cells = blocks.map((block) => ({
	block,
	cells: Array.from({ length: block.size }, (_, index) => ({ index, g: cellOf(block, index), addr: address(block, index) })),
}));
const cellTop = (blockId: string, index: number) => {
	const block = blocks.find((item) => item.id === blockId) ?? blocks[0];
	return cellOf(block, index).center;
};

// What each cell shows: `?` is the uninitialized content, numbers are the values stored.
type Value = { id: string; block: string; index: number; text: string; tone: 'plain' | Tone };
const values: Value[] = [
	...[0, 1, 2, 3].map((index) => ({ id: `va-q${index}`, block: 'a', index, text: '?', tone: 'magenta' as const })),
	...[5, 8, 13, 2].map((value, index) => ({ id: `va-${index}`, block: 'a', index, text: String(value), tone: 'plain' as const })),
	...[4, 5, 6, 7].map((index) => ({ id: `vb-q${index}`, block: 'b', index, text: '?', tone: 'magenta' as const })),
	...[5, 8, 13, 2, 7].map((value, index) => ({ id: `vb-${index}`, block: 'b', index, text: String(value), tone: 'plain' as const })),
	...[0, 1, 2, 3, 4, 5, 6].map((index) => ({ id: `vc-${index}`, block: 'c', index, text: '0', tone: 'violet' as const })),
	{ id: 'vc-15', block: 'c', index: 2, text: '15', tone: 'plain' },
];

// Stack plates: one per variable of `main`. The second program reuses two slots.
type Plate = { id: string; name: string; g: Slab };
const plate = (u: number, v: number) => slab(u, v, 0.34, 0.34, 18, 0);
const SLOT = { back1: plate(-3.0, 0.9), back2: plate(-1.6, 0.9), front1: plate(-3.0, 2.3), front2: plate(-1.6, 2.3) };
const plates: Plate[] = [
	{ id: 'v-nuevo', name: n.tmp, g: SLOT.back1 },
	{ id: 'v-num', name: n.nums, g: SLOT.back2 },
	{ id: 'v-cap', name: n.cap, g: SLOT.front1 },
	{ id: 'v-cnt', name: n.count, g: SLOT.front2 },
	{ id: 'v-dias', name: n.days, g: SLOT.front1 },
	{ id: 'v-ventas', name: n.sales, g: SLOT.back2 },
];
const plateTop = (id: string) => (plates.find((item) => item.id === id) ?? plates[0]).g.center;

// What each plate shows, one text per state so a change is a swap on the same plate.
type PlateValue = { id: string; plate: string; text: string; tone: 'plain' | Tone };
const plateValues: PlateValue[] = [
	{ id: 'val-cap-4', plate: 'v-cap', text: '4', tone: 'plain' },
	{ id: 'val-cap-8', plate: 'v-cap', text: '8', tone: 'plain' },
	...[0, 1, 2, 3, 4, 5].map((count) => ({ id: `val-cnt-${count}`, plate: 'v-cnt', text: String(count), tone: 'plain' as const })),
	{ id: 'val-num-a', plate: 'v-num', text: '0x1000', tone: 'flow' },
	{ id: 'val-num-b', plate: 'v-num', text: '0x2000', tone: 'flow' },
	{ id: 'val-num-null', plate: 'v-num', text: 'NULL', tone: 'violet' },
	{ id: 'val-nuevo', plate: 'v-nuevo', text: '0x2000', tone: 'flow' },
	{ id: 'val-nuevo-null', plate: 'v-nuevo', text: 'NULL', tone: 'magenta' },
	{ id: 'val-dias', plate: 'v-dias', text: '7', tone: 'plain' },
	{ id: 'val-ventas', plate: 'v-ventas', text: '0x3000', tone: 'flow' },
];

// Instruction modules: one per instruction, labelled with its editor line.
const COLS = [-0.1, 0.45, 1.0, 1.55, 2.1, 2.65, 3.2, 3.75];
const ROW_1 = 0.9;
const ROW_2 = 1.65;
const block = (u: number, v: number) => slab(u, v, 0.2, 0.2, 16, 0);
type Module = { id: string; lit: string; line: number; g: Slab; tone: Tone };
const moduleRow = (prefix: string, litPrefix: string, v: number, specs: [number, Tone][]): Module[] =>
	specs.map(([line, tone], index) => ({ id: `${prefix}${line}`, lit: `${litPrefix}${line}`, line, tone, g: block(COLS[index], v) }));
const modules: Module[] = [
	...moduleRow('m-', 'on-', ROW_1, [
		[2, 'flow'],
		[3, 'violet'],
		[4, 'violet'],
		[8, 'flow'],
		[9, 'flow'],
		[10, 'flow'],
		[11, 'violet'],
		[13, 'violet'],
	]),
	...moduleRow('m-', 'on-', ROW_2, [
		[14, 'flow'],
		[15, 'flow'],
		[17, 'flow'],
		[18, 'flow'],
		[20, 'flow'],
		[21, 'violet'],
		[22, 'violet'],
	]),
	...moduleRow('mb-', 'onb-', ROW_1, [
		[2, 'flow'],
		[3, 'violet'],
		[4, 'violet'],
		[7, 'flow'],
		[8, 'flow'],
		[9, 'flow'],
		[11, 'violet'],
		[12, 'flow'],
	]),
];
const moduleOf = (id: string) => (modules.find((item) => item.id === id) ?? modules[0]).g;

// Gates: the `NULL` checks. Two posts on the module, a bar that lifts when the pointer is valid.
const GATE_H = 26;
const gates = [
	{ id: 'gt-4', g: moduleOf('m-4') },
	{ id: 'gt-13', g: moduleOf('m-13') },
	{ id: 'gtb-4', g: moduleOf('mb-4') },
].map((gate) => {
	const { left, right } = gate.g.corners;
	return { ...gate, left, right, leftTop: lift(left, GATE_H), rightTop: lift(right, GATE_H) };
});

// Pointers: arrows from a plate to the first cell of a block (one identity for "a pointer").
type ArrowSpec = { id: string; from: Point; to: Point; tone: 'flow' | 'magenta' };
function arrowPath(from: Point, to: Point) {
	const control = { x: round((from.x + to.x) / 2 - 20), y: round(Math.min(from.y, to.y) - 80) };
	const d = `M${from.x} ${from.y} Q${control.x} ${control.y} ${to.x} ${to.y}`;
	const dx = to.x - control.x;
	const dy = to.y - control.y;
	const length = Math.hypot(dx, dy) || 1;
	const ux = dx / length;
	const uy = dy / length;
	const base = { x: to.x - ux * 11, y: to.y - uy * 11 };
	const head = poly([to, { x: round(base.x - uy * 6), y: round(base.y + ux * 6) }, { x: round(base.x + uy * 6), y: round(base.y - ux * 6) }]);
	return { d, head };
}
const tip = (blockId: string) => lift(cellTop(blockId, 0), 16);
const tail = (plateId: string) => lift(plateTop(plateId), 12);
const arrowSpecs: ArrowSpec[] = [
	{ id: 'ptr-a', from: tail('v-num'), to: tip('a'), tone: 'flow' },
	{ id: 'dg-a', from: tail('v-num'), to: tip('a'), tone: 'magenta' },
	{ id: 'ptr-nb', from: tail('v-nuevo'), to: tip('b'), tone: 'flow' },
	{ id: 'ptr-b', from: tail('v-num'), to: tip('b'), tone: 'flow' },
	{ id: 'dg-b', from: tail('v-num'), to: tip('b'), tone: 'magenta' },
	{ id: 'ptr-c', from: tail('v-ventas'), to: tip('c'), tone: 'flow' },
];
const arrows = arrowSpecs.map((arrow) => ({ ...arrow, ...arrowPath(arrow.from, arrow.to) }));

// The copy that `realloc` makes: each old cell into the cell of the new block in front of it.
const copyPaths = [0, 1, 2, 3].map((index) => {
	const from = lift(cellTop('a', index), 6);
	const to = lift(cellTop('b', index), 6);
	return `M${from.x} ${from.y} Q${round((from.x + to.x) / 2 - 26)} ${round(from.y - 8)} ${to.x} ${to.y}`;
});

// Where the particle stops (just above a module, or in front of a gate).
const anchors = [
	...modules.map((module) => ({ id: `a-${module.id.replace('-', '')}`, ...lift(module.g.center, 16) })),
	{ id: 'a-gate4', ...lift(pt((COLS[1] + COLS[2]) / 2, ROW_1), 18) },
];

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shots = [
	{ id: 'shot-all', c: { x: 630, y: 345 }, s: 0.95 },
	{ id: 'shot-prog', c: { x: 520, y: 370 }, s: 1.15 },
	{ id: 'shot-malloc', c: { x: 590, y: 300 }, s: 1.05 },
	{ id: 'shot-gate', c: { x: 620, y: 350 }, s: 1.35 },
	{ id: 'shot-grow', c: { x: 610, y: 320 }, s: 0.92 },
	{ id: 'shot-heap', c: { x: 625, y: 300 }, s: 1.0 },
	{ id: 'shot-calloc', c: { x: 662, y: 340 }, s: 0.92 },
].map((item) => ({
	id: item.id,
	x: round(item.c.x - 640 / item.s),
	y: round(item.c.y - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = { id: string; text: string; x: number; y: number; align: 'start' | 'end' | 'middle'; tone: 'plain' | Tone; mono?: boolean; icon?: 'check' };
const A_NOTE = { x: cellTop('a', 3).x + 15, y: cellTop('a', 0).y - 45 };
const B_END = cellTop('b', 7);
const C_END = cellTop('c', 6);
const NUM = plateTop('v-num');
const NUEVO = plateTop('v-nuevo');
const G4 = moduleOf('m-4').center;
const chips: Chip[] = [
	{ id: 'lb-sizeof', text: `sizeof *${n.nums} == sizeof(int)`, x: 470, y: 175, align: 'middle', tone: 'flow', mono: true },
	{ id: 'lb-uninit', text: t('sin inicializar', 'uninitialized'), x: A_NOTE.x, y: A_NOTE.y, align: 'middle', tone: 'magenta' },
	{ id: 'lb-addr', text: t('direcciones ficticias', 'fictional addresses'), x: A_NOTE.x, y: A_NOTE.y, align: 'middle', tone: 'plain' },
	{ id: 'lb-null', text: 'NULL → return 1', x: G4.x, y: G4.y + 52, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'lb-full', text: `${n.count} == ${n.cap}`, x: A_NOTE.x, y: A_NOTE.y, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'lb-fail', text: `${t('si falla', 'if it fails')}: ${n.tmp} == NULL`, x: NUEVO.x + 10, y: NUEVO.y - 84, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'lb-valid', text: t('el bloque viejo sigue válido', 'the old block stays valid'), x: A_NOTE.x, y: A_NOTE.y, align: 'middle', tone: 'violet', icon: 'check' },
	{ id: 'lb-rel-a', text: t('liberado', 'released'), x: A_NOTE.x, y: A_NOTE.y, align: 'middle', tone: 'violet' },
	{ id: 'lb-rel-b', text: t('liberado', 'released'), x: B_END.x - 10, y: B_END.y + 44, align: 'middle', tone: 'violet' },
	{ id: 'lb-rel-c', text: t('liberado', 'released'), x: C_END.x + 30, y: C_END.y - 6, align: 'start', tone: 'violet' },
	{ id: 'lb-zero', text: t('todo en cero', 'all zeros'), x: C_END.x + 30, y: C_END.y - 6, align: 'start', tone: 'violet' },
	{ id: 'lb-dangling', text: t('puntero colgante', 'dangling pointer'), x: NUM.x + 30, y: NUM.y - 44, align: 'middle', tone: 'magenta' },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.icon ? 42 : 24));
const chipLeft = (chip: Chip) => (chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x);

const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="md-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="md-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="md-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="md-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="md-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="md-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the stack, the heap and the instructions, seen through the camera -->
			<g clip-path="url(#md-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#md-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#md-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- Floors: the heap, the stack frame of main and the program -->
						{
							floors.map((floor) => (
								<g data-el={floor.id}>
									<polygon class="xj-plate-shadow" points={floor.g.base} transform="translate(12 18)" />
									<polygon class="xj-plate xj-plate--l" points={floor.g.leftFace} />
									<polygon class="xj-plate xj-plate--r" points={floor.g.rightFace} />
									<polygon class="xj-plate xj-plate--t" points={floor.g.top} fill="url(#md-g-floor)" />
									{floor.onFace ? (
										<text class="xj-area-label xj-area-label--face" transform={`matrix(0.866 -0.5 0 1 ${floor.at.x} ${floor.at.y})`} y="4" text-anchor="middle">
											{floor.label}
										</text>
									) : (
										<text class="xj-area-label" x={floor.at.x} y={floor.at.y} text-anchor="middle">
											{floor.label}
										</text>
									)}
								</g>
							))
						}

						<!-- Heap blocks: cells with their address on the front edge -->
						{
							cells.map(({ block, cells: row }) => (
								<g data-el={`blk-${block.id}`}>
									{row.map((cell) => (
										<g class="xj-cell">
											<polygon class="xj-shadow" points={cell.g.base} transform="translate(5 7)" />
											<polygon class="xj-face xj-face--l" points={cell.g.leftFace} />
											<polygon class="xj-face xj-face--r" points={cell.g.rightFace} />
											<polygon class="xj-cell-top" points={cell.g.top} />
											<text class="xj-addr" transform={cell.g.faceMatrix} text-anchor="middle" y="3">
												{cell.addr}
											</text>
										</g>
									))}
								</g>
							))
						}

						<!-- The copy realloc makes from the old block into the new one -->
						<g data-el="cp-ab" class="xj-flowline xj-flowline--flow">
							{copyPaths.map((d) => <path class="mg-stroke xj-flowline-halo" pathLength="1" d={d} />)}
							{copyPaths.map((d) => <path class="mg-stroke xj-flowline-core" pathLength="1" d={d} />)}
						</g>

						<!-- Values on top of the cells -->
						{
							values.map((value) => {
								const top = cellTop(value.block, value.index);
								return (
									<g data-el={value.id}>
										<text class:list={['xj-val', `xj-val--${value.tone}`]} x={top.x} y={top.y + 4.5} text-anchor="middle">
											{value.text}
										</text>
									</g>
								);
							})
						}

						<!-- Released blocks: the cells are dead, their contents must not be used -->
						{
							cells.map(({ block, cells: row }) => (
								<g data-el={`rel-${block.id}`} class="xj-rel">
									{row.map((cell) => (
										<polygon points={cell.g.top} />
									))}
								</g>
							))
						}

						<!-- Stack plates: one per variable, with its name in front -->
						{
							plates.map((item) => (
								<g data-el={item.id} class="xj-var">
									<polygon class="xj-shadow" points={item.g.base} transform="translate(6 8)" />
									<polygon class="xj-face xj-face--l" points={item.g.leftFace} />
									<polygon class="xj-face xj-face--r" points={item.g.rightFace} />
									<polygon class="xj-face xj-face--t" points={item.g.top} fill="url(#md-g-top)" />
									<text class="xj-var-name" x={item.g.bottomFront.x} y={item.g.bottomFront.y + 16} text-anchor="middle">
										{item.name}
									</text>
								</g>
							))
						}
						{
							plateValues.map((value) => {
								const top = plateTop(value.plate);
								return (
									<g data-el={value.id}>
										<text class:list={['xj-val', `xj-val--${value.tone}`]} x={top.x} y={top.y + 4.5} text-anchor="middle">
											{value.text}
										</text>
									</g>
								);
							})
						}

						<!-- Instruction modules: one per instruction, labelled with its editor line -->
						{
							modules.map((module) => (
								<>
									<g data-el={module.id} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#md-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
									<g data-el={module.lit} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
										<polygon class="xj-lit-halo" points={module.g.top} />
										<polygon class="xj-lit-top" points={module.g.top} />
										<polygon class="xj-lit-side" points={module.g.leftFace} />
										<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
								</>
							))
						}

						<!-- Gates: the NULL checks; the bar lifts when the pointer is valid -->
						{
							gates.map((gate) => (
								<>
									<g data-el={gate.id} class="xj-gate">
										<path d={`M${gate.left.x} ${gate.left.y} V${gate.leftTop.y} M${gate.right.x} ${gate.right.y} V${gate.rightTop.y}`} />
										<circle cx={gate.leftTop.x} cy={gate.leftTop.y} r="3" />
										<circle cx={gate.rightTop.x} cy={gate.rightTop.y} r="3" />
									</g>
									<g data-el={`${gate.id}-bar`} class="xj-gate-bar">
										<path d={`M${gate.leftTop.x} ${gate.leftTop.y + 8} H${gate.rightTop.x}`} />
									</g>
									<g data-el={`${gate.id}-open`} class="xj-gate-open">
										<path d={`M${gate.leftTop.x} ${gate.leftTop.y - 8} H${gate.rightTop.x}`} />
										<svg x={gate.rightTop.x + 6} y={gate.rightTop.y - 16} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75" class="xj-icon">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									</g>
								</>
							))
						}

						<!-- Pointers: from a plate to the first cell of its block -->
						{
							arrows.map((arrow) => (
								<g data-el={arrow.id} class:list={['xj-ptr', `xj-ptr--${arrow.tone}`]}>
									<path class={arrow.tone === 'magenta' ? 'xj-ptr-dash' : 'mg-stroke'} pathLength="1" d={arrow.d} />
									<polygon class="mg-head" points={arrow.head} />
								</g>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.icon === 'check' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.icon ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- The execution flow. Placement lives on data-x/y: the player resets data-el transforms. -->
						<g data-el="p" class="xj-particle" data-x={anchors[0].x} data-y={anchors[0].y}>
							<circle r="20" fill="url(#md-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="440" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<path class="xj-legend-ptr" d={`M${VP.x + 172} ${LEGEND_Y} H${VP.x + 190}`}></path>
				<polygon class="xj-legend-head" points={`${VP.x + 196},${LEGEND_Y} ${VP.x + 188},${LEGEND_Y - 5} ${VP.x + 188},${LEGEND_Y + 5}`}></polygon>
				<text x={VP.x + 204} y={LEGEND_Y + 4}>{t('Puntero', 'Pointer')}</text>
				<rect class="xj-legend-cell" x={VP.x + 282} y={LEGEND_Y - 7} width="16" height="14" rx="3"></rect>
				<text x={VP.x + 306} y={LEGEND_Y + 4}>{t('Celda de un bloque', 'Cell of a block')}</text>
			</g>

			<!-- EDITOR: the program, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				{
					programs.map((program) => (
						<g data-el={program.file} data-base={program.base}>
							<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>
								{program.name}
							</text>
						</g>
					))
				}
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 24}>{t('SALIDA', 'OUTPUT')}</text>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(2)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				{
					programs.map((program) => (
						<g data-el={program.id} data-base={program.base} class="xj-code">
							{program.lines.map((line) => (
								<>
									<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
										{line.n}
									</text>
									<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
								</>
							))}
						</g>
					))
				}

				<!-- Console: what the program prints (the first row of the first program is its input) -->
				{
					outputs.map((row) => (
						<g data-el={row.id}>
							<text class:list={['xj-out', { 'xj-out--meta': row.meta }]} x={ED.x + 20} y={outY(row.row)} xml:space="preserve">
								{row.text}
							</text>
						</g>
					))
				}
				{Array.from({ length: MAX_LINES }, (_, index) => <circle data-anchor={`ln-${index + 1}`} cx={BAR_CX} cy={lineMid(index + 1)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow and pointers, magenta for the problem (uninitialized
	   cells, NULL, a dangling pointer) and violet for what resolves it (the NULL
	   check, free, the zeros of calloc).
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='memoria-dinamica-c']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='memoria-dinamica-c'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='memoria-dinamica-c'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='memoria-dinamica-c'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-ptr {
		fill: none;
		stroke: var(--xj-flow);
		stroke-width: 2.5;
		stroke-linecap: round;
	}

	.xj-legend-head {
		fill: var(--xj-flow);
	}

	.xj-legend-cell {
		fill: var(--xj-steel);
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
	}

	/* Floors, cells, plates and modules */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-area-label {
		font-family: var(--font-body);
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.03em;
		fill: var(--xj-mist);
	}

	.xj-area-label--face {
		font-size: 11.5px;
		fill: var(--xj-flow-soft);
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-face-text {
		font-family: var(--font-body);
		font-size: 12px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face-text--on {
		fill: var(--xj-ink);
	}

	.xj-cell-top {
		fill: var(--xj-ink);
		stroke: var(--xj-flow);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-addr {
		font-family: monospace;
		font-size: 9px;
		fill: var(--xj-flow-soft);
	}

	.xj-val {
		font-family: monospace;
		font-size: 13px;
		font-weight: 700;
		fill: var(--xj-white);
	}

	.xj-val--flow {
		fill: var(--xj-flow-soft);
		font-size: 12px;
	}

	.xj-val--magenta {
		fill: var(--xj-magenta-soft);
	}

	.xj-val--violet {
		fill: var(--xj-violet-soft);
	}

	.xj-var-name {
		font-family: monospace;
		font-size: 12px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-rel polygon {
		fill: var(--xj-ink);
		fill-opacity: 0.72;
		stroke: var(--xj-violet);
		stroke-width: 1.5;
		stroke-dasharray: 4 3;
		stroke-linejoin: round;
	}

	/* Lit states */
	.xj-lit {
		--xj-lit: var(--xj-flow);
		--xj-lit-soft: var(--xj-flow-soft);
	}

	.xj-lit--violet {
		--xj-lit: var(--xj-violet);
		--xj-lit-soft: var(--xj-violet-soft);
	}

	.xj-lit--magenta {
		--xj-lit: var(--xj-magenta);
		--xj-lit-soft: var(--xj-magenta-soft);
	}

	.xj-lit-halo {
		fill: none;
		stroke: var(--xj-lit);
		stroke-width: 12;
		stroke-opacity: 0.22;
		stroke-linejoin: round;
	}

	.xj-lit-top {
		fill: var(--xj-lit);
		fill-opacity: 0.5;
		stroke: var(--xj-lit-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-lit-side {
		fill: var(--xj-lit-soft);
		stroke: var(--xj-lit-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	/* Gates */
	.xj-gate path {
		fill: none;
		stroke: var(--xj-mist);
		stroke-width: 3;
		stroke-linecap: round;
	}

	.xj-gate circle {
		fill: var(--xj-mist);
	}

	.xj-gate-bar path {
		fill: none;
		stroke: var(--xj-mist);
		stroke-width: 4;
		stroke-linecap: round;
	}

	.xj-gate-open path {
		fill: none;
		stroke: var(--xj-violet);
		stroke-width: 4;
		stroke-linecap: round;
	}

	.xj-gate-open .xj-icon path {
		stroke: var(--xj-violet-soft);
		stroke-width: 2.75;
	}

	/* Pointers and the copy route */
	.xj-ptr {
		--xj-line: var(--xj-flow);
	}

	.xj-ptr--magenta {
		--xj-line: var(--xj-magenta);
	}

	.xj-ptr path {
		fill: none;
		stroke: var(--xj-line);
		stroke-width: 2.5;
		stroke-linecap: round;
	}

	.xj-ptr .xj-ptr-dash {
		stroke-dasharray: 0.03 0.02;
	}

	.xj-ptr polygon {
		fill: var(--xj-line);
	}

	.xj-flowline {
		--xj-line: var(--xj-flow);
	}

	.xj-flowline-halo,
	.xj-flowline-core {
		fill: none;
		stroke: var(--xj-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.xj-flowline-halo {
		stroke-width: 9;
		stroke-opacity: 0.18;
	}

	.xj-flowline-core {
		stroke-width: 2;
	}

	/* Notes */
	.xj-chip {
		--xj-chip: var(--xj-edge);
		--xj-chip-ink: var(--xj-mist);
