	.xj-hl-err rect {
		fill: var(--xj-magenta);
		fill-opacity: 0.2;
		stroke: var(--xj-magenta);
		stroke-opacity: 0.7;
		stroke-width: 1.2;
	}

	.xj-hl-err path {
		fill: var(--xj-magenta);
	}
</style>
