---
/**
 * Scene for "From one file to a multi-file project" (lesson
 * c/modularizacion-subprogramas-y-funciones, order: 15), a short film played on one
 * persistent motion canvas. The captions and cues live in
 * `src/data/animations/funciones-modulos-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: a tab strip
 * with the three files of the lesson's multi-file example (the header, its
 * implementation and `main.c`), a bar that slides to the line being read, and a
 * console below with the build commands and their real output. The viewport on the
 * right holds the camera: the sources stand on a back row (`calculadora.c`,
 * `calculadora.h`, `main.c`), the object files (`.o`) below them and the executable
 * at the bottom. Each key line of the code is a module standing on its file, labelled
 * with its editor line. A light blue card is a declaration (the prototype) that is
 * copied from the header into another file. Magenta marks what is unresolved (a call
 * with no definition) and violet what defines, guards or resolves.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/funciones-modulos-c';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── The program shown in the editor ───────────────────────────────────────
// Identifiers and messages are the lesson's own, localized like it does.
const N = {
	calc: t('calculadora', 'calculator'),
	add: t('sumar', 'add'),
	sq2: t('suma_de_cuadrados', 'sum_of_squares'),
	sq: t('cuadrado', 'square'),
};
const GUARD = N.calc.toUpperCase() + '_H';
const FILE = { h: `${N.calc}.h`, c: `${N.calc}.c`, m: 'main.c' };

// Shortened from the lesson's example (fewer operations, fixed values instead of scanf).
const sources = {
	h: [
		`#ifndef ${GUARD}`,
		`#define ${GUARD}`,
		'',
		`int ${N.add}(int a, int b);`,
		`int ${N.sq2}(int a, int b);`,
		'',
		'#endif',
	].join('\n'),
	c: [
		`#include "${N.calc}.h"`,
		'',
		`static int ${N.sq}(int x) {`,
		'    return x * x;',
		'}',
		'',
		`int ${N.add}(int a, int b) {`,
		'    return a + b;',
		'}',
		'',
		`int ${N.sq2}(int a, int b) {`,
		`    return ${N.sq}(a) + ${N.sq}(b);`,
		'}',
	].join('\n'),
	m: [
		'#include <stdio.h>',
		`#include "${N.calc}.h"`,
		'',
		'int main(void) {',
		'    int a = 5;',
		'    int b = 3;',
		'',
		`    printf("%d + %d = %d\\n", a, b, ${N.add}(a, b));`,
		`    printf("%d^2 + %d^2 = %d\\n", a, b, ${N.sq2}(a, b));`,
		'    return 0;',
		'}',
	].join('\n'),
};

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const files = (['h', 'c', 'm'] as const).map((key) => ({
	key,
	title: FILE[key],
	lines: highlightCode(sources[key], 'c').map((html, index) => ({
		n: index + 1,
		html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
	})),
}));

// What the console prints, as the compiler and linker really print it (macOS, Clang).
// The linker lists the missing symbols in the order of the calls; the last line
// ("clang: error: linker command failed...") is left out.
const GCC = 'gcc -std=c23 -Wall -Wextra -Wpedantic';
const consoles = [
	{ id: 'a', rows: [`$ ${GCC} -c ${N.calc}.c`, `$ ${GCC} -c main.c`], err: false },
	{ id: 'b', rows: [`$ gcc ${N.calc}.o main.o -o ${N.calc}`, `$ ./${N.calc}`, '5 + 3 = 8', '5^2 + 3^2 = 34'], err: false },
	{
		id: 'c',
		rows: [
			`$ gcc main.o -o ${N.calc}`,
			'Undefined symbols for architecture arm64:',
			...(isEs ? [N.sq2, N.add] : [N.add, N.sq2]).flatMap((name) => [`  "_${name}", referenced from:`, '      _main in main.o']),
			'ld: symbol(s) not found for architecture arm64',
		],
		err: true,
	},
];
const rowClass = (row: string, err: boolean, index: number) =>
	row.startsWith('$') ? 'xj-cmd' : err && index > 0 ? 'xj-out xj-out--err' : 'xj-out';

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 74;
const LINE_H = 23;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 5;
const CONSOLE_TOP = 414;
const outY = (row: number) => 464 + row * 22;
const TAB_Y = ED.y + 20;
const TAB_W = 130;
const tabs = [
	{ key: 'h', x: 112 },
	{ key: 'c', x: 262 },
	{ key: 'm', x: 396 },
].map((tab) => ({ ...tab, title: FILE[tab.key as 'h' | 'c' | 'm'] }));

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up. The sources lie on the
// horizontal diagonal (u = k, v = -k); moving (+d, +d) goes straight down on screen,
// which is where the object files and the executable stand.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 56;
const EY = 32;
const ORIGIN = { x: 440, y: 250 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');

/** A box standing on the floor at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
	};
}
type Slab = ReturnType<typeof slab>;
type Tone = 'flow' | 'violet' | 'magenta';

const K = 2.3;
const D = 2.3;
const source = (k: number) => slab(k, -k, 1.3, 0.55, 14, -14);
const object = (k: number) => slab(k + D, -k + D, 0.8, 0.5, 12, -12);
const exe = slab(2 * D, 2 * D, 1, 0.5, 12, -12);

const plates = [
	{ id: 'z-c', g: source(-K), label: FILE.c, labelY: 344 },
	{ id: 'z-h', g: source(0), label: FILE.h, labelY: 344 },
	{ id: 'z-m', g: source(K), label: FILE.m, labelY: 344 },
	{ id: 'z-oc', g: object(-K), label: `${N.calc}.o`, labelY: 470 },
	{ id: 'z-om', g: object(K), label: 'main.o', labelY: 470 },
	{ id: 'z-x', g: exe, label: N.calc, labelY: 626 },
];
const PLATE = Object.fromEntries(plates.map((plate) => [plate.id, plate.g.center]));
const C = PLATE['z-c'];
const H = PLATE['z-h'];
const M = PLATE['z-m'];
const OC = PLATE['z-oc'];
const OM = PLATE['z-om'];
const X = PLATE['z-x'];

// Modules: one per key line of the code, standing on its file, with the editor line on its face.
type Module = { id: string; file: 'h' | 'c' | 'm'; line: number; g: Slab; tone: Tone };
const standing = (file: 'h' | 'c' | 'm', k: number, specs: [number, Tone][]): Module[] =>
	specs.map(([line, tone], index) => ({
		id: `${file}${line}`,
		file,
		line,
		tone,
		g: slab(k + (index - (specs.length - 1) / 2) * 0.5, -k, 0.2, 0.2, 16),
	}));
const modules: Module[] = [
	...standing('h', 0, [
		[1, 'violet'],
		[2, 'violet'],
		[4, 'flow'],
		[5, 'flow'],
		[7, 'violet'],
	]),
	...standing('c', -K, [
		[1, 'flow'],
		[3, 'violet'],
		[7, 'violet'],
		[11, 'violet'],
	]),
	...standing('m', K, [
		[2, 'flow'],
		[8, 'magenta'],
	]),
];

// The prototype card travels from the header to `main.c`; a second #include meets the guard.
const HP = { x: H.x, y: 170 };
const MP = { x: M.x, y: 170 };
const GATE = { x: round((H.x + M.x) / 2), y: 125 };
const DUP0 = { x: round(H.x - 80), y: GATE.y };
const GATE_STOP = { x: GATE.x - 62, y: GATE.y };

// Where the particle stops (just above a module or a plate) and where cards rest.
const anchors = [
	...modules.map((module) => ({ id: `a-${module.id}`, ...lift(module.g.center, 16) })),
	{ id: 'a-pc', ...lift(C, 40) },
	{ id: 'a-hp', ...HP },
	{ id: 'a-mp', ...MP },
	{ id: 'a-dup0', ...DUP0 },
	{ id: 'a-gate', ...GATE_STOP },
	{ id: 'a-oc', ...lift(OC, 34) },
	{ id: 'a-om', ...lift(OM, 34) },
	{ id: 'a-x', ...lift(X, 34) },
];
const at = (id: string) => anchors.find((anchor) => anchor.id === id) ?? { x: 0, y: 0 };

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shots = [
	{ id: 'shot-all', cx: 440, cy: 385, s: 0.82 },
	{ id: 'shot-h', cx: 440, cy: 215, s: 1.35 },
	{ id: 'shot-hm', cx: 570, cy: 215, s: 0.95 },
	{ id: 'shot-c', cx: 230, cy: 300, s: 1.15 },
	{ id: 'shot-obj', cx: 440, cy: 440, s: 0.9 },
	{ id: 'shot-link', cx: 440, cy: 470, s: 0.85 },
].map((item) => ({
	id: item.id,
	x: round(item.cx - 640 / item.s),
	y: round(item.cy - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Declaration cards: one visual identity for "a declaration on its way".
type Packet = { id: string; text: string; restAt: string };
const packets: Packet[] = [
	{ id: 'pk-proto', text: `int ${N.add}(int a, int b);`, restAt: 'a-hp' },
	{ id: 'pk-copy', text: `int ${N.add}(int a, int b);`, restAt: 'a-hp' },
	{ id: 'pk-dup', text: '#include', restAt: 'a-dup0' },
];
const packetWidth = (packet: Packet) => Math.round(packet.text.length * 7.6 + 28);

// Routes: the header copied into the files that include it, and the linker's links.
const routes = [
	{ id: 'rt-inc', tone: 'flow', d: `M${H.x + 60} ${HP.y + 16} Q${GATE.x} ${HP.y + 62} ${M.x - 60} ${MP.y + 16}` },
	{ id: 'rt-inc-c', tone: 'violet', d: `M${H.x - 60} ${HP.y + 16} Q${round((H.x + C.x) / 2)} ${HP.y + 62} ${C.x + 60} ${HP.y + 16}` },
	{ id: 'rt-oc-x', tone: 'flow', d: `M${OC.x + 50} ${OC.y + 26} Q${round((OC.x + X.x) / 2 + 20)} ${OC.y + 80} ${X.x - 66} ${X.y - 16}` },
	{ id: 'rt-om-x', tone: 'flow', d: `M${OM.x - 50} ${OM.y + 26} Q${round((OM.x + X.x) / 2 - 20)} ${OM.y + 80} ${X.x + 66} ${X.y - 16}` },
	{ id: 'rt-res', tone: 'violet', d: `M${OC.x + 82} ${OC.y - 6} Q${H.x} ${OC.y - 66} ${OM.x - 82} ${OM.y - 6}` },
	{ id: 'rt-miss', tone: 'magenta', d: `M${OM.x - 80} ${OM.y - 4} Q${OM.x - 120} ${OM.y + 2} ${H.x + 108} ${H.y + 190}` },
];

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = {
	id: string;
	text: string;
	x: number;
	y: number;
	align: 'start' | 'end' | 'middle';
	tone: 'plain' | Tone;
	mono?: boolean;
	icon?: 'check' | 'lock';
};
const chips: Chip[] = [
	{ id: 'lb-sig', text: t('nombre · tipos · retorno', 'name · types · return'), x: H.x, y: 128, align: 'middle', tone: 'flow' },
	{ id: 'lb-nobody', text: t('sin cuerpo', 'no body'), x: H.x, y: 98, align: 'middle', tone: 'plain' },
	{ id: 'st-nodef', text: t(`¿qué es ${N.add}?`, `what is ${N.add}?`), x: M.x, y: 128, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'ch-checked', text: t('llamada comprobada', 'call checked'), x: M.x, y: 128, align: 'middle', tone: 'violet', icon: 'check' },
	{ id: 'ch-defined', text: t(`${GUARD} definido`, `${GUARD} defined`), x: H.x, y: 128, align: 'middle', tone: 'violet', mono: true },
	{ id: 'ch-skip', text: t('se salta hasta #endif', 'skipped up to #endif'), x: GATE.x, y: 80, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'ch-def', text: t(`${N.add}: definición`, `${N.add}: definition`), x: OC.x, y: 494, align: 'middle', tone: 'violet' },
	{ id: 'ch-ref', text: t(`${N.add}: pendiente`, `${N.add}: pending`), x: OM.x, y: 494, align: 'middle', tone: 'magenta' },
	{ id: 'ch-res', text: t(`${N.add}: resuelto`, `${N.add}: resolved`), x: OM.x, y: 494, align: 'middle', tone: 'violet', icon: 'check' },
	{ id: 'ch-run', text: '5 + 3 = 8', x: X.x, y: 648, align: 'middle', tone: 'flow', mono: true },
	{ id: 'ch-undef', text: t(`símbolo indefinido: ${N.add}`, `undefined symbol: ${N.add}`), x: H.x, y: 440, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'lb-iface', text: t('interfaz: lo que ofrece', 'interface: what it offers'), x: H.x, y: 128, align: 'middle', tone: 'flow' },
	{ id: 'lb-impl', text: t('implementación: cómo lo hace', 'implementation: how it is done'), x: C.x, y: 128, align: 'middle', tone: 'violet' },
	{ id: 'lb-rebuild', text: t(`solo se recompila ${N.calc}.c`, `only ${N.calc}.c is rebuilt`), x: OC.x, y: 524, align: 'middle', tone: 'violet' },
	{ id: 'ch-static', text: t('static: solo en este archivo', 'static: only in this file'), x: C.x, y: 128, align: 'middle', tone: 'violet', icon: 'lock' },
	{ id: 'ch-private', text: t('main.o no la ve', 'main.o cannot see it'), x: C.x, y: 98, align: 'middle', tone: 'magenta' },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.icon ? 42 : 24));
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

const LEGEND_Y = VP.y + VP.h - 22;
const ERR_ROW = outY(0) - 4;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="project" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="fm-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="fm-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="fm-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="fm-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="fm-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="fm-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the project, seen through the camera -->
			<g clip-path="url(#fm-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#fm-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#fm-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- Sources, object files and the executable -->
						{
							plates.map((plate) => (
								<g data-el={plate.id}>
									<polygon class="xj-plate-shadow" points={plate.g.base} transform="translate(12 18)" />
									<polygon class="xj-plate xj-plate--l" points={plate.g.leftFace} />
									<polygon class="xj-plate xj-plate--r" points={plate.g.rightFace} />
									<polygon class="xj-plate xj-plate--t" points={plate.g.top} fill="url(#fm-g-floor)" />
									<text class="xj-area-label" x={plate.g.center.x} y={plate.labelY} text-anchor="middle">
										{plate.label}
									</text>
								</g>
							))
						}

						<!-- Routes: the header copied into its includers, the linker's links -->
						{
							routes.map((route) => (
								<g data-el={route.id} class:list={['xj-flowline', `xj-flowline--${route.tone}`]}>
									<path class="mg-stroke xj-flowline-halo" pathLength="1" d={route.d} />
									<path class="mg-stroke xj-flowline-core" pathLength="1" d={route.d} />
								</g>
							))
						}

						<!-- Modules: one per key line, labelled with its editor line -->
						{
							modules.map((module) => (
								<>
									<g data-el={`m-${module.id}`} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#fm-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
									<g data-el={`on-${module.id}`} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
										<polygon class="xj-lit-halo" points={module.g.top} />
										<polygon class="xj-lit-top" points={module.g.top} />
										<polygon class="xj-lit-side" points={module.g.leftFace} />
										<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
								</>
							))
						}

						<!-- The include guard: a barrier a second copy of the header cannot cross -->
						<g data-el="gate" data-x={GATE.x} data-y={GATE.y}>
							<rect class="xj-gate-halo" x="-9" y="-34" width="18" height="68" rx="9"></rect>
							<rect class="xj-gate" x="-4" y="-28" width="8" height="56" rx="4"></rect>
						</g>

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.icon === 'check' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
									{chip.icon === 'lock' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
											<path d="M7 11V7a5 5 0 0 1 10 0v4" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.icon ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- Declaration cards. Placement lives on the inner group: the player resets data-el transforms. -->
						{
							packets.map((packet) => (
								<g data-el={packet.id} data-x={at(packet.restAt).x} data-y={at(packet.restAt).y}>
									<g class="xj-packet">
										<rect class="xj-packet-halo" x={-packetWidth(packet) / 2 - 5} y="-18" width={packetWidth(packet) + 10} height="36" rx="18" />
										<rect class="xj-packet-card" x={-packetWidth(packet) / 2} y="-13" width={packetWidth(packet)} height="26" rx="13" />
										<text class="xj-packet-text" x="0" y="4.5" text-anchor="middle">
											{packet.text}
										</text>
									</g>
								</g>
							))
						}

						<!-- The build flow -->
						<g data-el="p" class="xj-particle" data-x={at('a-pc').x} data-y={at('a-pc').y}>
							<circle r="20" fill="url(#fm-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="430" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de compilación', 'Build flow')}</text>
				<rect class="xj-legend-card" x={VP.x + 176} y={LEGEND_Y - 6} width="20" height="12" rx="6"></rect>
				<text x={VP.x + 204} y={LEGEND_Y + 4}>{t('Declaración', 'Declaration')}</text>
				<circle class="xj-legend-magenta" cx={VP.x + 316} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 328} y={LEGEND_Y + 4}>{t('Sin definición', 'Undefined')}</text>
			</g>

			<!-- EDITOR: the three files in turn, the running line marked, and the console below -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<g data-el="tabs" data-base="shown" class="xj-tab" data-x={tabs[0].x} data-y={TAB_Y}>
					<rect x={-TAB_W / 2} y="-14" width={TAB_W} height="28" rx="14"></rect>
				</g>
				{
					tabs.map((tab) => (
						<text class="xj-file" x={tab.x} y={TAB_Y + 4.5} text-anchor="middle">
							{tab.title}
						</text>
					))
				}
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('TERMINAL', 'TERMINAL')}</text>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(1)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<!-- The files: each line is typed when its file is first shown -->
				{
					files.map((file) => (
						<g data-el={`f${file.key}`} class="xj-code">
							{file.lines.map((line) => (
								<g data-el={`e${file.key}-${line.n}`}>
									<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
										{line.n}
									</text>
									<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
								</g>
							))}
						</g>
					))
				}

				<!-- Console: the build commands and what they print -->
				{
					consoles.map((block) => (
						<g data-el={`co-${block.id}`}>
							{block.rows.map((row, index) => (
								<text data-el={`r${block.id}-${index}`} class={rowClass(row, block.err, index)} x={ED.x + 20} y={outY(index)} xml:space="preserve">
									{row}
								</text>
							))}
						</g>
					))
				}
				<g data-el="hl-err" class="xj-hl-err" data-x={BAR_CX} data-y={ERR_ROW}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				{tabs.map((tab) => <circle data-anchor={`tb-${tab.key}`} cx={tab.x} cy={TAB_Y} r="1" fill="none" />)}
				{files.flatMap((file) => file.lines.map((line) => <circle data-anchor={`l${file.key}-${line.n}`} cx={BAR_CX} cy={lineMid(line.n)} r="1" fill="none" />))}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue build flow, magenta for what is unresolved (a call with no definition)
	   and violet for what defines, guards or resolves.
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='funciones-modulos-c']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='funciones-modulos-c'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='funciones-modulos-c'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='funciones-modulos-c'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-card {
		fill: var(--xj-panel);
		stroke: var(--xj-flow);
		stroke-width: 1.5;
	}

	.xj-legend-magenta {
		fill: var(--xj-magenta);
	}

	/* Plates and modules */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-area-label {
		font-family: monospace;
		font-size: 14px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-face-text {
		font-family: var(--font-body);
		font-size: 12px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face-text--on {
		fill: var(--xj-ink);
	}

	/* Lit states */
	.xj-lit {
		--xj-lit: var(--xj-flow);
		--xj-lit-soft: var(--xj-flow-soft);
	}

	.xj-lit--violet {
		--xj-lit: var(--xj-violet);
		--xj-lit-soft: var(--xj-violet-soft);
	}

	.xj-lit--magenta {
		--xj-lit: var(--xj-magenta);
		--xj-lit-soft: var(--xj-magenta-soft);
	}

	.xj-lit-halo {
		fill: none;
		stroke: var(--xj-lit);
		stroke-width: 12;
		stroke-opacity: 0.22;
		stroke-linejoin: round;
	}

	.xj-lit-top {
		fill: var(--xj-lit);
		fill-opacity: 0.5;
		stroke: var(--xj-lit-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-lit-side {
		fill: var(--xj-lit-soft);
		stroke: var(--xj-lit-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	/* The include guard */
	.xj-gate-halo {
		fill: var(--xj-violet);
		fill-opacity: 0.22;
	}

	.xj-gate {
		fill: var(--xj-violet);
		stroke: var(--xj-violet-soft);
		stroke-width: 1.5;
	}

	/* Routes */
	.xj-flowline {
		--xj-line: var(--xj-flow);
	}

	.xj-flowline--violet {
		--xj-line: var(--xj-violet);
	}

	.xj-flowline--magenta {
		--xj-line: var(--xj-magenta);
	}

	.xj-flowline-halo,
	.xj-flowline-core {
		fill: none;
		stroke: var(--xj-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.xj-flowline-halo {
		stroke-width: 11;
		stroke-opacity: 0.2;
	}

	.xj-flowline-core {
		stroke-width: 3;
	}

	/* Notes */
	.xj-chip {
		--xj-chip: var(--xj-edge);
		--xj-chip-ink: var(--xj-mist);
	}

	.xj-chip--flow {
		--xj-chip: var(--xj-flow);
		--xj-chip-ink: var(--xj-flow-soft);
	}

	.xj-chip--magenta {
		--xj-chip: var(--xj-magenta);
		--xj-chip-ink: var(--xj-magenta-soft);
	}

	.xj-chip--violet {
		--xj-chip: var(--xj-violet);
		--xj-chip-ink: var(--xj-violet-soft);
	}

	.xj-chip rect {
		fill: var(--xj-panel);
		fill-opacity: 0.94;
		stroke: var(--xj-chip);
		stroke-width: 1.5;
	}

	.xj-chip-text {
		font-family: var(--font-body);
		font-size: 12.5px;
		font-weight: 600;
		fill: var(--xj-chip-ink);
	}

	.xj-chip-mono {
		font-family: monospace;
		font-size: 12.5px;
		fill: var(--xj-chip-ink, var(--xj-white));
	}

	.xj-icon {
		fill: none;
		stroke: var(--xj-white);
		stroke-linecap: round;
		stroke-linejoin: round;
		overflow: visible;
	}

	/* Declaration cards and the flow */
	.xj-packet-halo {
		fill: var(--xj-flow);
		fill-opacity: 0.16;
	}

	.xj-packet-card {
		fill: var(--xj-ink);
		stroke: var(--xj-flow);
		stroke-width: 2;
	}

	.xj-packet-text {
		font-family: monospace;
		font-size: 12.5px;
		font-weight: 700;
		fill: var(--xj-flow-soft);
	}

	.xj-particle-core {
		fill: var(--xj-white);
	}

	/* Editor */
	.xj-panel {
		fill: var(--xj-panel);
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-rule {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-tab rect {
		fill: var(--xj-flow);
		fill-opacity: 0.16;
		stroke: var(--xj-flow);
		stroke-opacity: 0.6;
		stroke-width: 1.2;
	}

	.xj-file {
		font-family: monospace;
		font-size: 13px;
		fill: var(--xj-mist);
	}

	.xj-mono,
	.xj-out,
	.xj-cmd {
		font-family: monospace;
		font-size: 13px;
		white-space: pre;
		fill: var(--xj-mist);
	}

	.xj-cmd {
		fill: var(--xj-white);
		font-weight: 700;
	}

	.xj-out {
		fill: var(--xj-flow-soft);
	}

	.xj-out--err {
		fill: var(--xj-magenta-soft);
	}

	.xj-gutter {
		font-family: monospace;
		font-size: 12px;
		fill: var(--xj-dim);
