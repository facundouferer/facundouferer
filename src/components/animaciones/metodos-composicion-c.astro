// Plates for the variables: the parameters of the call and `stock` in main.
type Plate = { id: string; name: string; g: Slab };
const plate = (u: number, v: number) => slab(u, v, 0.34, 0.34, 18, 0);
const SLOT = { first: plate(0.1, 3.0), second: plate(1.5, 3.8), stock: plate(-2.0, 3.1) };
