const moduleOf = (id: string) => (modules.find((item) => item.id === id) ?? modules[0]).g;

// Gates: the checks that guard a path (the mistaken write, the arguments, the result of
// `realloc`). Two posts on the module, a bar that lifts when the check passes.
const GATE_H = 26;
const gates = [
	{ id: 'gtk-20', g: moduleOf('mk-20') },
	{ id: 'gtb-3', g: moduleOf('mb-3') },
	{ id: 'gtb-12', g: moduleOf('mb-12') },
].map((gate) => {
	const { left, right } = gate.g.corners;
	return { ...gate, left, right, leftTop: lift(left, GATE_H), rightTop: lift(right, GATE_H) };
});

// Pointers: arrows from a parameter plate (or a field) into the plate they point to.
type ArrowSpec = { id: string; from: Point; to: Point; hump: number };
function arrowPath(from: Point, to: Point, hump: number) {
	const control = { x: round((from.x + to.x) / 2 - 20), y: round(Math.min(from.y, to.y) - hump) };
	const d = `M${from.x} ${from.y} Q${control.x} ${control.y} ${to.x} ${to.y}`;
	const dx = to.x - control.x;
	const dy = to.y - control.y;
	const length = Math.hypot(dx, dy) || 1;
	const ux = dx / length;
	const uy = dy / length;
	const base = { x: to.x - ux * 11, y: to.y - uy * 11 };
	const head = poly([to, { x: round(base.x - uy * 6), y: round(base.y + ux * 6) }, { x: round(base.x + uy * 6), y: round(base.y - ux * 6) }]);
	return { d, head };
}
const tail = (plateId: string) => lift(plateTop(plateId), 12);
const INTO_OBJECT = pt(-1.95, 2.1, 14);
const INTO_PART = FIELD.a.center;
const arrowSpecs: ArrowSpec[] = [
	{ id: 'pt-r', from: tail('v-pr'), to: INTO_OBJECT, hump: 50 },
	{ id: 'pt-i', from: tail('v-pi'), to: INTO_OBJECT, hump: 50 },
	{ id: 'pt-p', from: tail('v-pp'), to: INTO_PART, hump: 50 },
	{ id: 'pt-s', from: tail('v-ps'), to: lift(plateTop('v-st'), 6), hump: 50 },
	{ id: 'pt-prod', from: lift(FIELD.a.center, 8), to: lift(cellTop(0), 16), hump: 80 },
];
const arrows = arrowSpecs.map((arrow) => ({ ...arrow, ...arrowPath(arrow.from, arrow.to, arrow.hump) }));

// Where the particle stops (just above a module).
const anchors = modules.map((module) => ({ id: `a${module.prog}-${module.line}`, ...lift(module.g.center, 16) }));

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shots = [
