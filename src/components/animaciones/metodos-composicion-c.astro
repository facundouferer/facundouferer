// Instruction modules: one per instruction, labelled with its editor line.
const COLS = [-0.1, 0.45, 1.0, 1.55, 2.1, 2.65, 3.2, 3.75];
const ROW_1 = 0.9;
const ROW_2 = 1.65;
const block = (u: number, v: number) => slab(u, v, 0.2, 0.2, 16, 0);
type Module = { prog: string; id: string; lit: string; line: number; g: Slab; tone: Tone };
const moduleRow = (prog: string, v: number, specs: [number, Tone][], first = 0): Module[] =>
	specs.map(([line, tone], index) => ({ prog, id: `m${prog}-${line}`, lit: `on${prog}-${line}`, line, tone, g: block(COLS[first + index], v) }));
const modules: Module[] = [
	...moduleRow('a', ROW_1, [
		[15, 'flow'],
		[16, 'flow'],
		[17, 'flow'],
		[19, 'violet'],
		[20, 'flow'],
		[12, 'flow'],
		[13, 'violet'],
		[8, 'flow'],
	]),
	...moduleRow('a', ROW_2, [
