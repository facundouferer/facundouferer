/**
 * Scene for "Functions that receive the object" (lesson
 * c/objetos-metodos-y-diseno-basado-en-struct, order: 43), a short film played on one
 * persistent motion canvas. The captions and cues live in
 * `src/data/animations/metodos-composicion-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: the rectangle's
 * operations (`escalar`, `area`, `mover`), then the inventory's `agregar`, then its `stock`
 * and `liberar`, with a bar that slides to the line being executed and the output typed
 * below. The viewport on the right holds the camera: an object is a plate whose fields sit
 * on top (a part of an object is a smaller plate on the bigger one), the parameters of the
 * call stand on their own floor, the dynamic array lives on the heap floor, and each
 * instruction is a module labelled with its editor line. A pointer is always an arrow: the
 * first parameter of every operation points into the plate of its object. Magenta marks the
 * problem (the refused write, `NULL`, the error codes); violet marks what resolves it
 * (`const`, the checks, `free`). Addresses are short and fictional; real ones vary.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/metodos-composicion-c';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── The programs shown in the editor ──────────────────────────────────────
// The lesson's own functions (without the includes and `main`, which do not fit the
// editor), with the identifiers localized like the lesson does.
const n = {
	Rect: t('Rectangulo', 'Rectangle'),
	Point: t('Punto', 'Point'),
	corner: t('esquina', 'corner'),
	width: t('base', 'width'),
	height: t('altura', 'height'),
	pm: t('punto_mover', 'point_move'),
	rm: t('rectangulo_mover', 'rectangle_move'),
	rs: t('rectangulo_escalar', 'rectangle_scale'),
	ra: t('rectangulo_area', 'rectangle_area'),
	Inv: t('Inventario', 'Inventory'),
	Prod: t('Producto', 'Product'),
	items: t('productos', 'products'),
	count: t('cantidad', 'count'),
	cap: t('capacidad', 'capacity'),
	code: t('codigo', 'code'),
	bigger: t('nueva', 'bigger'),
	more: t('mas', 'more'),
	IR: t('InvResultado', 'InvResult'),
	E_BAD: t('INV_ARGUMENTO_INVALIDO', 'INV_INVALID_ARGUMENT'),
	E_MEM: t('INV_SIN_MEMORIA', 'INV_OUT_OF_MEMORY'),
	E_NF: t('INV_NO_ENCONTRADO', 'INV_NOT_FOUND'),
	add: t('inventario_agregar', 'inventory_add'),
	stockFn: t('inventario_stock', 'inventory_stock'),
	release: t('inventario_liberar', 'inventory_release'),
	init: t('inventario_iniciar', 'inventory_init'),
};
const rectangle = [
	`struct ${n.Point} { double x; double y; };`,
	'',
	`struct ${n.Rect} {`,
	`    struct ${n.Point} ${n.corner};`,
	`    double ${n.width};`,
	`    double ${n.height};`,
	'};',
	`void ${n.pm}(struct ${n.Point} *p, double dx, double dy) {`,
	'    p->x += dx;',
	'    p->y += dy;',
	'}',
	`void ${n.rm}(struct ${n.Rect} *r, double dx, double dy) {`,
	`    ${n.pm}(&r->${n.corner}, dx, dy);`,
	'}',
	`void ${n.rs}(struct ${n.Rect} *r, double factor) {`,
	`    r->${n.width} *= factor;`,
	`    r->${n.height} *= factor;`,
	'}',
	`double ${n.ra}(const struct ${n.Rect} *r) {`,
	`    return r->${n.width} * r->${n.height};`,
	'}',
];
// The same `area` with the mistaken write: the compiler refuses it (line 20).
const mistaken = [...rectangle.slice(0, 19), `    r->${n.width} = 0;`, ...rectangle.slice(19)];
const add = [
	`enum ${n.IR} ${n.add}(struct ${n.Inv} *inv,`,
	`        const char *${n.code}, int stock) {`,
	`    if (${n.code} == NULL || stock < 0 ||`,
	`        strlen(${n.code}) >= sizeof inv->${n.items}[0].${n.code}) {`,
	`        return ${n.E_BAD};`,
	'    }',
	`    if (inv->${n.count} == inv->${n.cap}) {`,
	`        size_t ${n.bigger} =`,
	`            inv->${n.cap} == 0 ? 4 : inv->${n.cap} * 2;`,
	`        struct ${n.Prod} *${n.more} =`,
	`            realloc(inv->${n.items}, ${n.bigger} * sizeof *${n.more});`,
	`        if (${n.more} == NULL) {`,
	`            return ${n.E_MEM};`,
	'        }',
	`        inv->${n.items} = ${n.more};`,
	`        inv->${n.cap} = ${n.bigger};`,
	'    }',
	`    struct ${n.Prod} *p = &inv->${n.items}[inv->${n.count}];`,
	`    strcpy(p->${n.code}, ${n.code});`,
	'    p->stock = stock;',
	`    inv->${n.count}++;`,
	'    return INV_OK;',
	'}',
];
const query = [
	`enum ${n.IR} { INV_OK, ${n.E_BAD},`,
	`    ${n.E_MEM}, ${n.E_NF} };`,
	'',
	`enum ${n.IR} ${n.stockFn}(const struct ${n.Inv} *inv,`,
	`        const char *${n.code}, int *stock) {`,
	`    for (size_t i = 0; i < inv->${n.count}; i++) {`,
	`        if (strcmp(inv->${n.items}[i].${n.code}, ${n.code}) == 0) {`,
	`            *stock = inv->${n.items}[i].stock;`,
	'            return INV_OK;',
	'        }',
	'    }',
	`    return ${n.E_NF};`,
	'}',
	'',
	`void ${n.release}(struct ${n.Inv} *inv) {`,
	`    free(inv->${n.items});`,
	`    ${n.init}(inv);`,
	'}',
];

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const toLines = (source: string[]) =>
	highlightCode(source.join('\n'), 'c').map((html, index) => ({
		n: index + 1,
		html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
	}));
const programs = [
	{ id: 'ed-a', file: 'file-a', name: t('rectangulo.c', 'rectangle.c'), lines: toLines(rectangle), base: 'shown' },
	{ id: 'ed-k', file: undefined, name: '', lines: toLines(mistaken), base: undefined },
	{ id: 'ed-b', file: 'file-b', name: t('inventario.c', 'inventory.c'), lines: toLines(add), base: undefined },
	{ id: 'ed-c', file: 'file-c', name: t('inventario.c', 'inventory.c'), lines: toLines(query), base: undefined },
];

// Real output, from compiling the programs with `cc -std=c23` (the inventory is the lesson's
// own program; the rectangle's `main` is the one described in the first row). The error is the
// first line clang prints for the mistaken write, cut at the type.
const outputs = [
	{ id: 'oa-0', row: 0, text: t('main: escala el rectángulo x2, calcula el área y lo mueve', 'main: scales the rectangle x2, computes the area and moves it'), kind: 'meta' },
	{ id: 'oa-1', row: 1, text: 'Area: 32.0', kind: 'out' },
	{ id: 'oa-2', row: 2, text: "error: cannot assign to variable 'r' with const-qualified type …", kind: 'err' },
	{ id: 'oa-3', row: 2, text: `${t('Esquina', 'Corner')}: (2.0, 0.0)`, kind: 'out' },
	{ id: 'ob-0', row: 0, text: t('main: agrega A-100, B-200, un código largo y C-300', 'main: adds A-100, B-200, a too-long code and C-300'), kind: 'meta' },
	{ id: 'ob-1', row: 1, text: t('No se agrego codigo-demasiado-largo: argumento invalido', 'Could not add code-that-is-too-long: invalid argument'), kind: 'out' },
	{ id: 'oc-0', row: 0, text: t('main: consulta C-300 y Z-999, y luego libera el inventario', 'main: looks up C-300 and Z-999, then releases the inventory'), kind: 'meta' },
	{ id: 'oc-1', row: 1, text: t('Stock de C-300: 40', 'Stock of C-300: 40'), kind: 'out' },
	{ id: 'oc-2', row: 2, text: t('Z-999: no encontrado', 'Z-999: not found'), kind: 'out' },
];

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 66;
const LINE_H = 19;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (line: number) => CODE_TOP + (line - 1) * LINE_H;
const lineMid = (line: number) => lineTop(line) + LINE_H / 2;
const lineBase = (line: number) => lineMid(line) + 4.5;
const CONSOLE_TOP = 516;
const outY = (row: number) => 564 + row * 19;
const MAX_LINES = 23;

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up. The heap is the back floor, the
// objects of main the front-left floor, the instruction modules the front-right one and the
// parameters of the call the floor in front of them.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 50;
const EY = 29;
const ORIGIN = { x: 610, y: 350 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');

/** A box standing at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	const sideCenter = { x: round((front.x + right.x) / 2), y: round((front.y + right.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		corners: { back, right, front, left },
		bottomFront: down(front),
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
		sideMatrix: `matrix(0.866 -0.5 0 1 ${sideCenter.x} ${sideCenter.y})`,
	};
}
type Slab = ReturnType<typeof slab>;
type Tone = 'flow' | 'violet' | 'magenta';

// Floors: the heap behind, the objects of main, the program and the parameters in front.
const HEAP = slab(1.0, -1.55, 3.0, 1.5, 14, -14);
const MAIN = slab(-2.35, 1.85, 1.35, 1.7, 14, -14);
const PROG = slab(1.8, 1.275, 2.25, 0.7, 10, -10);
const CALL = slab(0.8, 3.3, 1.6, 1.0, 14, -14);
const below = (g: Slab) => ({ x: g.bottomFront.x, y: g.bottomFront.y + 22 });
const floors = [
	{ id: 'floor-heap', g: HEAP, label: t('Montículo (heap)', 'Heap'), at: pt(4.0, -0.8, -7), onFace: true },
	{ id: 'floor-main', g: MAIN, label: t('Objetos de main', 'Objects of main'), at: pt(-1.0, 1.9, -7), onFace: true },
	{ id: 'floor-prog', g: PROG, label: t('Instrucciones', 'Instructions'), at: below(PROG), onFace: false },
	{ id: 'floor-call', g: CALL, label: t('Parámetros', 'Parameters'), at: pt(2.4, 3.3, -7), onFace: true },
];

// The objects: a plate with its fields on top. The first field is a bigger plate (the
// part `esquina`, or the pointer `productos`), the other two are small cells.
const OBJ = slab(-2.35, 1.45, 1.0, 1.0, 14, 0);
const FIELD = {
	a: slab(-2.6, 1.1, 0.38, 0.38, 10, 14),
	b: slab(-1.7, 1.5, 0.3, 0.3, 10, 14),
	c: slab(-2.5, 2.1, 0.3, 0.3, 10, 14),
};
type FieldKey = keyof typeof FIELD;
const objects = [
	{
		id: 'obj-r',
		name: { id: 'nm-r', text: 'r' },
		fields: [
			{ id: 'fl-a', key: 'a' as FieldKey, name: n.corner },
			{ id: 'fl-b', key: 'b' as FieldKey, name: n.width },
			{ id: 'fl-c', key: 'c' as FieldKey, name: n.height },
		],
	},
	{
		id: 'obj-i',
		name: { id: 'nm-i', text: 'inv' },
		fields: [
