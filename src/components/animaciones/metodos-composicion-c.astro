			{ id: 'fi-b', key: 'b' as FieldKey, name: n.count },
			{ id: 'fi-c', key: 'c' as FieldKey, name: n.cap },
		],
	},
];
// What each field shows, one text per state so a change is a swap on the same field.
type FieldValue = { id: string; key: FieldKey; text: string; tone: 'plain' | Tone };
const fieldValues: FieldValue[] = [
	{ id: 'rv-a0', key: 'a', text: '(0, 0)', tone: 'plain' },
	{ id: 'rv-a1', key: 'a', text: '(2, 0)', tone: 'plain' },
	{ id: 'rv-b0', key: 'b', text: '4.0', tone: 'plain' },
	{ id: 'rv-b1', key: 'b', text: '8.0', tone: 'plain' },
	{ id: 'rv-c0', key: 'c', text: '2.0', tone: 'plain' },
	{ id: 'rv-c1', key: 'c', text: '4.0', tone: 'plain' },
	{ id: 'iv-a0', key: 'a', text: 'NULL', tone: 'violet' },
	{ id: 'iv-a1', key: 'a', text: '0x2000', tone: 'flow' },
	...[0, 1, 2, 3].map((count) => ({ id: `iv-b${count}`, key: 'b' as FieldKey, text: String(count), tone: 'plain' as const })),
	{ id: 'iv-c0', key: 'c', text: '0', tone: 'plain' },
	{ id: 'iv-c1', key: 'c', text: '4', tone: 'plain' },
