// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = { id: string; text: string; x: number; y: number; align: 'start' | 'end' | 'middle'; tone: 'plain' | Tone; mono?: boolean; icon?: 'check' | 'lock' | 'x' };
const CALL_AT = { x: 490, y: 128 };
const NOTE = { x: 420, y: 205 };
const NOTE_UP = { x: 420, y: 175 };
const HEAP_NOTE = { x: 700, y: 165 };
const OUT_NOTE = { x: 330, y: 432 };
const cell0 = cellTop(0);
const cell3 = cellTop(3);
const call = (id: string, text: string): Chip => ({ id, text, x: CALL_AT.x, y: CALL_AT.y, align: 'middle', tone: 'flow', mono: true });
const chips: Chip[] = [
	call('cl-esc', `${n.rs}(&r, 2.0)`),
	call('cl-area', `${n.ra}(&r)`),
	call('cl-mov', `${n.rm}(&r, 2.0, 0.0)`),
	call('cl-pm', `${n.pm}(&r->${n.corner}, 2.0, 0.0)`),
	call('cl-ag1', `${n.add}(&inv, "A-100", 10)`),
	call('cl-ag2', `${n.add}(&inv, "B-200", 20)`),
	call('cl-ag3', `${n.add}(&inv, "${t('codigo-demasiado-largo', 'code-that-is-too-long')}", 30)`),
	call('cl-ag4', `${n.add}(&inv, "C-300", 40)`),
	call('cl-st1', `${n.stockFn}(&inv, "C-300", &stock)`),
	call('cl-st2', `${n.stockFn}(&inv, "Z-999", &stock)`),
	call('cl-lib', `${n.release}(&inv)`),
	{ id: 'ch-first', text: t('Primer parámetro: el objeto', 'First parameter: the object'), ...NOTE, align: 'middle', tone: 'flow' },
	{ id: 'ch-const', text: t('const: solo lectura', 'const: read-only'), ...NOTE, align: 'middle', tone: 'violet', icon: 'lock' },
	{ id: 'ch-err', text: `r->${n.width} = 0`, ...NOTE_UP, align: 'middle', tone: 'magenta', mono: true, icon: 'x' },
	{ id: 'ch-part', text: t('una parte dentro de r', 'a part inside r'), ...NOTE, align: 'middle', tone: 'violet' },
	{ id: 'ch-deleg', text: t('delega en la parte', 'delegates to the part'), ...NOTE_UP, align: 'middle', tone: 'violet' },
	{ id: 'ch-own', text: t('dueño del arreglo', 'owns the array'), ...NOTE, align: 'middle', tone: 'flow' },
	{ id: 'ch-cap', text: `${n.cap}: 0 → 4`, x: cell3.x + 55, y: cell3.y - 4, align: 'start', tone: 'violet', mono: true },
	{ id: 'ch-fail', text: `${n.more} == NULL`, x: cell0.x, y: 205, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'ch-keep', text: t('productos sigue válido', 'products stays valid'), ...HEAP_NOTE, align: 'middle', tone: 'violet', icon: 'check' },
	{ id: 'ch-bad', text: n.E_BAD, ...NOTE, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'ch-ok', text: 'INV_OK', ...NOTE, align: 'middle', tone: 'violet', mono: true, icon: 'check' },
	{ id: 'ch-nf', text: n.E_NF, ...NOTE, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'ch-out', text: '*stock = 40', ...OUT_NOTE, align: 'middle', tone: 'violet', mono: true },
	{ id: 'ch-same', text: t('stock no cambia', 'stock is unchanged'), ...OUT_NOTE, align: 'middle', tone: 'violet', icon: 'check' },
	{ id: 'ch-free', text: `free(inv->${n.items})`, ...HEAP_NOTE, align: 'middle', tone: 'violet', mono: true },
	{ id: 'ch-done', text: t('el dueño libera lo que creó', 'the owner frees what it created'), ...NOTE, align: 'middle', tone: 'violet', icon: 'check' },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.icon ? 42 : 24));
const chipLeft = (chip: Chip) => (chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x);

const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="mc-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="mc-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="mc-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="mc-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="mc-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="mc-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the objects, the parameters, the heap and the instructions, seen through the camera -->
			<g clip-path="url(#mc-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#mc-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#mc-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- Floors: the heap, the objects of main, the program and the parameters -->
						{
							floors.map((floor) => (
								<g data-el={floor.id}>
									<polygon class="xj-plate-shadow" points={floor.g.base} transform="translate(12 18)" />
									<polygon class="xj-plate xj-plate--l" points={floor.g.leftFace} />
									<polygon class="xj-plate xj-plate--r" points={floor.g.rightFace} />
									<polygon class="xj-plate xj-plate--t" points={floor.g.top} fill="url(#mc-g-floor)" />
									{floor.onFace ? (
										<text class="xj-area-label xj-area-label--face" transform={`matrix(0.866 -0.5 0 1 ${floor.at.x} ${floor.at.y})`} y="4" text-anchor="middle">
											{floor.label}
										</text>
									) : (
										<text class="xj-area-label" x={floor.at.x} y={floor.at.y} text-anchor="middle">
											{floor.label}
										</text>
									)}
								</g>
							))
						}

						<!-- Heap array: cells with their address on the front edge -->
						<g data-el="blk-xa">
							{
								cells.map((cell) => (
									<g class="xj-cell">
										<polygon class="xj-shadow" points={cell.g.base} transform="translate(5 7)" />
										<polygon class="xj-face xj-face--l" points={cell.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={cell.g.rightFace} />
										<polygon class="xj-cell-top" points={cell.g.top} />
										<text class="xj-addr" transform={cell.g.faceMatrix} text-anchor="middle" y="3">
											{cell.addr}
										</text>
									</g>
								))
							}
						</g>
						{
							cells.map((cell) => {
								const top = cellTop(cell.index);
								return (
									<g data-el={`xq-${cell.index}`}>
										<text class="xj-val xj-val--magenta" x={top.x} y={top.y + 4.5} text-anchor="middle">
											?
										</text>
									</g>
								);
							})
						}
						{
							products.map((item) => {
								const top = cellTop(item.index);
								return (
									<g data-el={item.id}>
										<text class="xj-field-name" x={top.x} y={top.y - 2} text-anchor="middle">
											{item.code}
										</text>
										<text class="xj-val xj-val--small" x={top.x} y={top.y + 9} text-anchor="middle">
											{item.stock}
										</text>
									</g>
								);
							})
						}

						<!-- The old array after free: the cells are dead -->
						<g data-el="rel-xa" class="xj-rel">
							{cells.map((cell) => <polygon points={cell.g.top} />)}
						</g>

						<!-- Objects: a plate with its fields on top; the first field is a plate of its own -->
						{
							objects.map((object) => (
								<>
									<g data-el={object.id}>
										<polygon class="xj-shadow" points={OBJ.base} transform="translate(8 10)" />
										<polygon class="xj-face xj-face--l" points={OBJ.leftFace} />
										<polygon class="xj-face xj-face--r" points={OBJ.rightFace} />
										<polygon class="xj-face xj-face--t" points={OBJ.top} fill="url(#mc-g-top)" />
									</g>
									<g data-el={object.name.id}>
										<text class="xj-var-name" x={OBJ.bottomFront.x} y={OBJ.bottomFront.y + 16} text-anchor="middle">
											{object.name.text}
										</text>
									</g>
									{object.fields.map((field) => {
										const g = FIELD[field.key];
										return (
											<g data-el={field.id}>
												<polygon class="xj-shadow" points={g.base} transform="translate(4 6)" />
												<polygon class="xj-face xj-face--l" points={g.leftFace} />
												<polygon class="xj-face xj-face--r" points={g.rightFace} />
												<polygon class="xj-cell-top" points={g.top} />
												<text class="xj-field-name" x={g.center.x} y={g.center.y - 3} text-anchor="middle">
													{field.name}
												</text>
											</g>
										);
									})}
								</>
							))
						}
						{
							fieldValues.map((value) => {
								const top = FIELD[value.key].center;
								return (
									<g data-el={value.id}>
										<text class:list={['xj-val', 'xj-val--field', `xj-val--${value.tone}`]} x={top.x} y={top.y + 9} text-anchor="middle">
											{value.text}
										</text>
									</g>
								);
							})
						}

						<!-- Plates for the variables: the parameters of the call and stock in main, with their name in front -->
						{
							plates.map((item) => (
								<g data-el={item.id} class="xj-var">
									<polygon class="xj-shadow" points={item.g.base} transform="translate(6 8)" />
									<polygon class="xj-face xj-face--l" points={item.g.leftFace} />
									<polygon class="xj-face xj-face--r" points={item.g.rightFace} />
									<polygon class="xj-face xj-face--t" points={item.g.top} fill="url(#mc-g-top)" />
									<text class="xj-var-name" x={item.g.bottomFront.x} y={item.g.bottomFront.y + 16} text-anchor="middle">
										{item.name}
									</text>
								</g>
							))
						}
						{
							plateValues.map((value) => {
								const top = plateTop(value.plate);
								return (
									<g data-el={value.id}>
										<text class:list={['xj-val', `xj-val--${value.tone}`]} x={top.x} y={top.y + 4.5} text-anchor="middle">
											{value.text}
										</text>
									</g>
								);
							})
						}

						<!-- Instruction modules: one per instruction, labelled with its editor line -->
						{
							modules.map((module) => (
								<>
									<g data-el={module.id} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#mc-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
									<g data-el={module.lit} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
										<polygon class="xj-lit-halo" points={module.g.top} />
										<polygon class="xj-lit-top" points={module.g.top} />
										<polygon class="xj-lit-side" points={module.g.leftFace} />
										<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
								</>
							))
						}

						<!-- Gates: the checks; the bar lifts when the check passes -->
						{
							gates.map((gate) => (
								<>
									<g data-el={gate.id} class="xj-gate">
										<path d={`M${gate.left.x} ${gate.left.y} V${gate.leftTop.y} M${gate.right.x} ${gate.right.y} V${gate.rightTop.y}`} />
										<circle cx={gate.leftTop.x} cy={gate.leftTop.y} r="3" />
										<circle cx={gate.rightTop.x} cy={gate.rightTop.y} r="3" />
									</g>
									<g data-el={`${gate.id}-bar`} class="xj-gate-bar">
										<path d={`M${gate.leftTop.x} ${gate.leftTop.y + 8} H${gate.rightTop.x}`} />
									</g>
									<g data-el={`${gate.id}-open`} class="xj-gate-open">
										<path d={`M${gate.leftTop.x} ${gate.leftTop.y - 8} H${gate.rightTop.x}`} />
										<svg x={gate.rightTop.x + 6} y={gate.rightTop.y - 16} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75" class="xj-icon">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									</g>
								</>
							))
						}

						<!-- Pointers: always an arrow, from the parameter or the field into the thing it points to -->
						{
							arrows.map((arrow) => (
								<g data-el={arrow.id} class="xj-ptr xj-ptr--flow">
									<path class="mg-stroke" pathLength="1" d={arrow.d} />
									<polygon class="mg-head" points={arrow.head} />
								</g>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.icon === 'check' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
									{chip.icon === 'lock' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
											<path d="M7 11V7a5 5 0 0 1 10 0v4" />
										</svg>
									)}
									{chip.icon === 'x' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M18 6 6 18" />
											<path d="m6 6 12 12" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.icon ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- The execution flow. Placement lives on data-x/y: the player resets data-el transforms. -->
						<g data-el="p" class="xj-particle" data-x={anchors[0].x} data-y={anchors[0].y}>
							<circle r="20" fill="url(#mc-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="440" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<path class="xj-legend-ptr" d={`M${VP.x + 172} ${LEGEND_Y} H${VP.x + 190}`}></path>
				<polygon class="xj-legend-head" points={`${VP.x + 196},${LEGEND_Y} ${VP.x + 188},${LEGEND_Y - 5} ${VP.x + 188},${LEGEND_Y + 5}`}></polygon>
				<text x={VP.x + 204} y={LEGEND_Y + 4}>{t('Puntero', 'Pointer')}</text>
				<rect class="xj-legend-cell" x={VP.x + 282} y={LEGEND_Y - 7} width="16" height="14" rx="3"></rect>
				<text x={VP.x + 306} y={LEGEND_Y + 4}>{t('Objeto o celda', 'Object or cell')}</text>
			</g>

			<!-- EDITOR: the program, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				{
					programs.filter((program) => program.file).map((program) => (
						<g data-el={program.file} data-base={program.base}>
							<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>
								{program.name}
							</text>
						</g>
					))
				}
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 24}>{t('SALIDA', 'OUTPUT')}</text>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(15)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				{
					programs.map((program) => (
						<g data-el={program.id} data-base={program.base} class="xj-code">
							{program.lines.map((line) => (
								<>
									<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
										{line.n}
									</text>
									<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
								</>
							))}
						</g>
					))
				}

				<!-- Console: what the program prints (the first row says what main does, since main does not fit the editor) -->
				{
					outputs.map((row) => (
						<g data-el={row.id}>
							<text class:list={['xj-out', { 'xj-out--meta': row.kind === 'meta', 'xj-out--err': row.kind === 'err' }]} x={ED.x + 20} y={outY(row.row)} xml:space="preserve">
								{row.text}
							</text>
						</g>
					))
				}
				{Array.from({ length: MAX_LINES }, (_, index) => <circle data-anchor={`ln-${index + 1}`} cx={BAR_CX} cy={lineMid(index + 1)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow and pointers, magenta for the problem (the refused
	   write, NULL, the error codes) and violet for what resolves it (const, the
	   checks, free). Every rule below reads these tokens; no other color is
	   written in this file. */
	:global(.anim-player[data-slug='metodos-composicion-c']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='metodos-composicion-c'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='metodos-composicion-c'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='metodos-composicion-c'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
