// The array of products on the heap: one row of cells, twenty bytes per `Producto`
// (`char[16]` and an `int`), short fictional addresses.
const CELL = 0.3;
const PITCH = 0.66;
const U0 = -1.25;
const ROW = -2.3;
const BASE_ADDR = 0x2000;
const cellOf = (index: number) => slab(U0 + index * PITCH, ROW, CELL, CELL, 14, 0);
const cells = Array.from({ length: 4 }, (_, index) => ({ index, g: cellOf(index), addr: `0x${(BASE_ADDR + index * 20).toString(16)}` }));
