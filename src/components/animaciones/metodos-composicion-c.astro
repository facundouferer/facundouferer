	{ id: 'shot-a', c: { x: 520, y: 380 }, s: 1.15 },
	{ id: 'shot-heap', c: { x: 610, y: 310 }, s: 1.0 },
].map((item) => ({
	id: item.id,
	x: round(item.c.x - 640 / item.s),
