	{ id: 'v-ps', name: 'stock', g: SLOT.second },
	{ id: 'v-st', name: 'stock', g: SLOT.stock },
];
const plateTop = (id: string) => (plates.find((item) => item.id === id) ?? plates[0]).g.center;
type PlateValue = { id: string; plate: string; text: string; tone: 'plain' | Tone };
const plateValues: PlateValue[] = [
	{ id: 'pv-r', plate: 'v-pr', text: '0x1000', tone: 'flow' },
	{ id: 'pv-f', plate: 'v-pf', text: '2.0', tone: 'plain' },
	{ id: 'pv-p', plate: 'v-pp', text: '0x1000', tone: 'flow' },
