	ana: along(floors.ana.back, floors.ana.right, 0.5),
	remA: along(floors.rem.left, floors.rem.front, 0.3),
	remB: along(floors.rem.front, floors.rem.right, 0.5),
	beto: along(floors.beto.left, floors.beto.back, 0.4),
};
const routes = {
	anaUp: path([PORT.ana, PORT.remA]),
	anaDown: path([PORT.remA, PORT.ana]),
	betoUp: path([PORT.beto, PORT.remB]),
	betoDown: path([PORT.remB, PORT.beto]),
};

