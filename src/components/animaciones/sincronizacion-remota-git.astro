	{ id: 'ana-c3', plat: 'ana', slot: 2, row: 'main', hash: h.c3, tone: 'flow' },
	{ id: 'rem-c1', plat: 'rem', slot: 0, row: 'main', hash: h.c1, tone: 'flow' },
	{ id: 'rem-c2', plat: 'rem', slot: 1, row: 'main', hash: h.c2, tone: 'flow' },
	{ id: 'rem-c3', plat: 'rem', slot: 2, row: 'main', hash: h.c3, tone: 'flow' },
	{ id: 'rem-b', plat: 'rem', slot: 2, row: 'front', hash: h.b, tone: 'flow' },
	{ id: 'rem-m', plat: 'rem', slot: 3, row: 'main', hash: h.m, tone: 'violet' },
	{ id: 'beto-c1', plat: 'beto', slot: 0, row: 'main', hash: h.c1, tone: 'flow' },
	{ id: 'beto-c2', plat: 'beto', slot: 1, row: 'main', hash: h.c2, tone: 'flow' },
	{ id: 'beto-c3', plat: 'beto', slot: 2, row: 'main', hash: h.c3, tone: 'flow' },
	{ id: 'beto-b', plat: 'beto', slot: 2, row: 'front', hash: h.b, tone: 'flow' },
	{ id: 'beto-m', plat: 'beto', slot: 3, row: 'main', hash: h.m, tone: 'violet' },
];
const spot = (plat: Plat, slot: number, row: 'main' | 'front', dy = 0, dx = 0): Point => ({
	x: P[plat].x + SLOT_X[slot] + dx,
	y: P[plat].y + ROW[row] + dy,
});
const nodeAt = (id: string) => {
	const node = nodes.find((item) => item.id === id);
	return node ? spot(node.plat, node.slot, node.row) : { x: 0, y: 0 };
};

