// Command modules: one per editor line, on the platform of whoever runs it, in a row
// along the two front edges of the slab.
const moduleLines: Record<'ana' | 'beto', { left: number[]; right: number[] }> = {
	ana: { left: [1, 2, 7, 8, 9], right: [10, 11, 12, 13] },
	beto: { left: [3, 4, 5, 6, 14], right: [15, 16, 17, 18, 19] },
};
const LEFT_T = [0.3, 0.45, 0.6, 0.75, 0.9];
const RIGHT_T = [0.1, 0.25, 0.4, 0.55, 0.7];
const MOD = { hw: 11, hh: 6.3, h: 11 };
const modules = (['ana', 'beto'] as const)
	.flatMap((plat) => {
		const floor = floors[plat];
		const left = moduleLines[plat].left.map((n, index) => ({ n, plat, at: along(floor.left, floor.front, LEFT_T[index]) }));
		const right = moduleLines[plat].right.map((n, index) => ({ n, plat, at: along(floor.front, floor.right, RIGHT_T[index]) }));
		return [...left, ...right];
	})
	.map((module) => {
		const base = { x: module.at.x, y: round(module.at.y - 8) };
		const g = slab(base.x, round(base.y - MOD.h), MOD.hw, MOD.hh, MOD.h);
		return { ...module, base, g, top: round(base.y - MOD.h) };
	})
	.sort((a, b) => a.base.y - b.base.y);
const toneOf = (n: number) => (n === 16 ? 'magenta' : n === 17 || n === 18 ? 'violet' : 'flow');

// The pipes between each computer and the remote: from the back edge of the computer
