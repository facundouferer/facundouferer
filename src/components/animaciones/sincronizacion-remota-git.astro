// ── Isometric world (camera space) ────────────────────────────────────────
// Three platforms seen from above: the remote at the back, Ana's computer at the
// front left and Beto's at the front right. Each platform is an isometric slab
// whose long diagonal runs across the screen, so a chain of commits reads left
// to right, oldest first.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const round = (value: number) => Math.round(value * 10) / 10;
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');
const path = (points: Point[]) => 'M' + points.map((point) => `${point.x} ${point.y}`).join(' L');

/** An isometric slab: its top face is a rhombus of half-diagonals `hw` and `hh`, standing `h` tall. */
function slab(cx: number, cy: number, hw: number, hh: number, h: number) {
	const back = { x: cx, y: cy - hh };
	const right = { x: cx + hw, y: cy };
	const front = { x: cx, y: cy + hh };
	const left = { x: cx - hw, y: cy };
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		back,
		right,
		front,
		left,
	};
}

type Plat = 'ana' | 'rem' | 'beto';
const HW = 160;
const HH = 91;
const P: Record<Plat, Point> = {
	rem: { x: 640, y: 200 },
	ana: { x: 440, y: 470 },
	beto: { x: 840, y: 470 },
};
const floors = {
	ana: slab(P.ana.x, P.ana.y, HW, HH, 14),
	rem: slab(P.rem.x, P.rem.y, HW, HH, 14),
	beto: slab(P.beto.x, P.beto.y, HW, HH, 14),
};
/** A point on the segment from `a` to `b`. */
const along = (a: Point, b: Point, k: number): Point => ({ x: round(a.x + (b.x - a.x) * k), y: round(a.y + (b.y - a.y) * k) });

