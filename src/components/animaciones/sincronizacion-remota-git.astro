	{ id: 'ch-parents', text: t('merge commit: 2 padres', 'merge commit: 2 parents'), ...NOTE_BETO2, align: 'middle', tone: 'violet', icon: 'check' },
	{ id: 'ch-accepted', text: t('aceptado: fast-forward', 'accepted: fast-forward'), ...NOTE_REM, align: 'middle', tone: 'violet', icon: 'check' },
	{ id: 'r-push', text: t('push: sube commits', 'push: uploads commits'), ...NOTE_ANA, align: 'middle', tone: 'flow' },
	{ id: 'r-fetch', text: t('fetch: solo mueve origin/main', 'fetch: only moves origin/main'), ...NOTE_ANA2, align: 'middle', tone: 'flow' },
	{ id: 'r-pull', text: t('pull: fetch + merge', 'pull: fetch + merge'), ...NOTE_BETO, align: 'middle', tone: 'flow' },
	{ id: 'r-rule', text: t('push rechazado: pull y después push', 'push rejected: pull, then push'), ...SLOT, align: 'middle', tone: 'violet', icon: 'check' },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.icon ? 42 : 24));
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

// Labels under each platform.
const labels = [
	{ id: 'lb-ana', text: 'Ana', icon: 'laptop', x: P.ana.x, y: P.ana.y + HH + 40 },
	{ id: 'lb-beto', text: names.Bob, icon: 'laptop', x: P.beto.x, y: P.beto.y + HH + 40 },
	{ id: 'lb-rem', text: 'GitHub · origin', icon: 'cloud', x: P.rem.x - 10, y: P.rem.y + HH + 38 },
];
const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="xs-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="xs-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="xs-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="xs-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="xs-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="xs-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the two computers and the remote, seen through the camera -->
			<g clip-path="url(#xs-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#xs-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#xs-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- The remote on GitHub, at the back -->
						<g data-el="floor-rem">
							<polygon class="xj-plate-shadow" points={floors.rem.base} transform="translate(12 18)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={floors.rem.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={floors.rem.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t xj-plate--remote" points={floors.rem.top} fill="url(#xs-g-floor)"></polygon>
						</g>

						<!-- The pipes between each computer and the remote -->
						<g data-el="tr-ana">
							<path class="mg-stroke xj-pipe" pathLength="1" d={routes.anaUp}></path>
							<path class="mg-stroke xj-trace" pathLength="1" d={routes.anaUp}></path>
						</g>
						<g data-el="tr-beto">
							<path class="mg-stroke xj-pipe" pathLength="1" d={routes.betoUp}></path>
							<path class="mg-stroke xj-trace" pathLength="1" d={routes.betoUp}></path>
						</g>
						{
							[
								{ id: 'fl-ana-up', d: routes.anaUp, tone: 'flow' },
								{ id: 'fl-ana-down', d: routes.anaDown, tone: 'flow' },
								{ id: 'fl-beto-up', d: routes.betoUp, tone: 'flow' },
								{ id: 'fl-beto-down', d: routes.betoDown, tone: 'flow' },
								{ id: 'fl-rej', d: routes.betoUp, tone: 'magenta' },
								{ id: 'fl-merge', d: routes.betoUp, tone: 'violet' },
							].map((line) => (
								<g data-el={line.id} class:list={['xj-flowline', `xj-flowline--${line.tone}`]}>
									<path class="mg-stroke xj-flowline-halo" pathLength="1" d={line.d} />
									<path class="mg-stroke xj-flowline-core" pathLength="1" d={line.d} />
								</g>
							))
						}

						<!-- The two computers, each with one module per command it runs -->
						{
							[
								{ id: 'floor-ana', plat: 'ana' as const },
								{ id: 'floor-beto', plat: 'beto' as const },
							].map(({ id, plat }) => (
								<g data-el={id}>
									<polygon class="xj-plate-shadow" points={floors[plat].base} transform="translate(12 18)" />
									<polygon class="xj-plate xj-plate--l" points={floors[plat].leftFace} />
									<polygon class="xj-plate xj-plate--r" points={floors[plat].rightFace} />
									<polygon class="xj-plate xj-plate--t" points={floors[plat].top} fill="url(#xs-g-floor)" />
									{modules
										.filter((module) => module.plat === plat)
										.map((module) => (
											<g class="xj-mod">
												<polygon class="xj-shadow" points={module.g.base} transform="translate(4 5)" />
												<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
												<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
												<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#xs-g-top)" />
												<text class="xj-mod-text" x={module.base.x} y={module.top + 3.5} text-anchor="middle">
													{module.n}
												</text>
											</g>
										))}
								</g>
							))
						}
						{
							modules.map((module) => (
								<g data-el={`on-${module.n}`} class:list={['xj-lit', `xj-lit--${toneOf(module.n)}`]}>
									<polygon class="xj-lit-halo" points={module.g.top} />
									<polygon class="xj-lit-top" points={module.g.top} />
									<polygon class="xj-lit-side" points={module.g.leftFace} />
									<text class="xj-mod-text xj-mod-text--on" x={module.base.x} y={module.top + 3.5} text-anchor="middle">
										{module.n}
									</text>
								</g>
							))
						}

						<!-- Parent links between commits -->
						{
							links.map((link) => (
								<g data-el={link.id}>
									<path class="mg-stroke xj-link" pathLength="1" d={link.d} />
								</g>
							))
						}

						<!-- Commits: always the same rounded node with its short hash -->
						<g data-el="rem-c3-bad" class="xj-ring">
							<rect
								x={nodeAt('rem-c3').x - NODE.w / 2 - 6}
								y={nodeAt('rem-c3').y - NODE.h / 2 - 6}
								width={NODE.w + 12}
								height={NODE.h + 12}
								rx="17"></rect>
						</g>
						{
							nodes.map((node) => (
								<g data-el={node.id} class:list={['xj-node', `xj-node--${node.tone}`]}>
									<rect x={nodeAt(node.id).x - NODE.w / 2} y={nodeAt(node.id).y - NODE.h / 2} width={NODE.w} height={NODE.h} rx="11" />
									<text x={nodeAt(node.id).x} y={nodeAt(node.id).y + 4} text-anchor="middle">
										{node.hash}
									</text>
								</g>
							))
						}

						<!-- Branch tags. Placement lives on the inner group: the player resets data-el transforms. -->
						{
							tags.map((tag) => (
								<g data-el={tag.id} data-x={spotAt(tag.start).x} data-y={spotAt(tag.start).y}>
									<g class:list={['xj-tag', `xj-tag--${tag.kind}`]}>
										<rect x={-tagWidth(tag) / 2} y="-9" width={tagWidth(tag)} height="18" rx="9" />
										<text x="0" y="3.8" text-anchor="middle">
											{tag.text}
										</text>
									</g>
								</g>
							))
						}

						<!-- Labels under each platform -->
						{
							labels.map((label) => (
								<g data-el={label.id} class="xj-label">
									<svg class="xj-label-icon" x={label.x - label.text.length * 4.6 - 26} y={label.y - 11} width="20" height="20" viewBox="0 0 24 24" stroke-width="2.75">
										{label.icon === 'laptop' ? (
											<path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16" />
										) : (
											<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
										)}
									</svg>
									<text x={label.x + 12} y={label.y + 5} text-anchor="middle">
										{label.text}
									</text>
								</g>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.icon === 'check' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
									{chip.icon === 'x' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M18 6 6 18" />
											<path d="m6 6 12 12" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.icon ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- Commit copies in transit. Placement lives on the inner group. -->
						{
							packets.map((packet) => (
								<g data-el={packet.id} data-x={at(packet.startAt).x} data-y={at(packet.startAt).y}>
									<g class:list={['xj-packet', `xj-packet--${packet.tone}`]}>
										<rect class="xj-packet-halo" x={-NODE.w / 2 - 6} y={-NODE.h / 2 - 6} width={NODE.w + 12} height={NODE.h + 12} rx="17" />
										<rect class="xj-packet-card" x={-NODE.w / 2} y={-NODE.h / 2} width={NODE.w} height={NODE.h} rx="11" />
										<text class="xj-packet-text" x="0" y="4" text-anchor="middle">
											{packet.hash}
										</text>
									</g>
								</g>
							))
						}

						<!-- The execution flow -->
						<g data-el="p" class="xj-particle" data-x={at('a-m-1').x} data-y={at('a-m-1').y}>
							<circle r="18" fill="url(#xs-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="396" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Comando', 'Command')}</text>
				<rect class="xj-legend-node" x={VP.x + 112} y={LEGEND_Y - 6} width="22" height="12" rx="6"></rect>
				<text x={VP.x + 142} y={LEGEND_Y + 4}>Commit</text>
				<rect class="xj-legend-local" x={VP.x + 204} y={LEGEND_Y - 6} width="22" height="12" rx="6"></rect>
				<text x={VP.x + 234} y={LEGEND_Y + 4}>main</text>
				<rect class="xj-legend-remote" x={VP.x + 284} y={LEGEND_Y - 6} width="22" height="12" rx="6"></rect>
				<text x={VP.x + 314} y={LEGEND_Y + 4}>origin/main</text>
			</g>

			<!-- EDITOR: the terminal session, with the running command highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{t('terminal · ana y beto', 'terminal · ana and bob')}</text>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<!-- Line states sit behind the commands -->
				<rect data-el="hx-16" class="xj-bar xj-bar--trail" x={BAR.x} y={lineTop(16)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(1)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 3} -5 l7 5 l-7 5 z`}></path>
				</g>

				<g class="xj-code">
					{
						commandLines.map((line) => (
							<g data-el={`e-${line.n}`}>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class:list={['xj-prompt', `xj-prompt--${line.who}`]} x={PROMPT_X} y={lineBase(line.n)}>
									{prompts[line.who]}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				{
					outputs.map((line) => (
						<text
							data-el={line.id}
							class:list={['xj-out', { 'xj-out--err': outputFailed(line.id) }]}
							x={ED.x + 20}
							y={outY(outputRow(line.id))}
							xml:space="preserve"
						>
							{line.text}
						</text>
					))
				}
				{session.map((_, index) => <circle data-anchor={`ln-${index + 1}`} cx={BAR_CX} cy={lineMid(index + 1)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue for the normal flow, magenta for the problem (the rejected push) and
	   violet for what resolves it (the merge commit).
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='sincronizacion-remota-git']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='sincronizacion-remota-git'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='sincronizacion-remota-git'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='sincronizacion-remota-git'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-node {
		fill: var(--xj-ink);
		stroke: var(--xj-flow);
		stroke-width: 1.5;
	}

	.xj-legend-local {
		fill: var(--xj-flow-soft);
	}

	.xj-legend-remote {
		fill: none;
		stroke: var(--xj-mist);
		stroke-width: 1.5;
		stroke-dasharray: 4 3;
	}

	/* Platforms and command modules */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate--remote {
		stroke: var(--xj-steel-hi);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-mod-text {
		font-family: var(--font-body);
		font-size: 10px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-mod-text--on {
		fill: var(--xj-ink);
	}

	.xj-label text {
		font-family: var(--font-body);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.02em;
		fill: var(--xj-mist);
	}

	.xj-label-icon {
		fill: none;
		stroke: var(--xj-mist);
		stroke-linecap: round;
		stroke-linejoin: round;
		overflow: visible;
	}

	/* Lit states */
	.xj-lit {
		--xj-lit: var(--xj-flow);
