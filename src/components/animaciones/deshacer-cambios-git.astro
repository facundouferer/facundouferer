---
/**
 * Scene for "The journey of HEAD: undoing without losing work" (lesson
 * git/deshacer-cambios, order: 2), a short film played on one persistent motion
 * canvas. The captions and cues live in `src/data/animations/deshacer-cambios-git.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: it is the
 * terminal session of the lesson, one command per line, with a bar on the command
 * being run and the real Git output typed in the console below. The viewport on the
 * right holds the camera: an isometric repository where every commit is the same
 * rounded node with its short hash and `HEAD` (over `main`) is one marker that slides
 * along the chain. Commits that leave the history drop to the lane below the chain
 * and turn into ghosts. In front sit the staging area, the working tree and the
 * command deck, one module per editor line. Magenta marks the mistake or what is
 * lost, violet what fixes or recovers it.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/deshacer-cambios-git';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── Terminal session shown in the editor ──────────────────────────────────
// File names, messages and hashes are localized the same way the lesson does.
const names = {
	repo: t('practica-deshacer', 'undo-practice'),
	greeting: t('saludo.txt', 'greeting.txt'),
	signature: t('firma.txt', 'signature.txt'),
	tasks: t('tareas.txt', 'tasks.txt'),
	wrong: t('Texto borrado sin querer', 'Text deleted by mistake'),
	initial: t('Agrega saludo inicial', 'Add initial greeting'),
	typo: t('Agrega despedia', 'Add farewel'),
	farewell: t('Agrega despedida', 'Add farewell'),
	change: t('Cambia saludo a inglés', 'Change greeting to Spanish'),
	list: t('Agrega lista de tareas', 'Add task list'),
	before: t('Hola mundo', 'Hello world'),
	after: t('Hello world', 'Hola mundo'),
};
const hash = {
	init: t('426061e', '261c13d'),
	typo: t('20633b9', '77dde29'),
	am1: t('cf59d35', 'f3e279c'),
	am2: t('ad7fc4f', '9a6ac3b'),
	change: t('10fe8c7', '2f55221'),
	revert: t('946f52b', '42a3fa7'),
	t1: t('0fd046b', '21b77ad'),
	t2: t('958d100', '952ade9'),
	t3: t('6b8f501', 'bdf42a1'),
};

const session = [
	`git commit -m "${names.initial}"`,
	`echo "${names.wrong}" > ${names.greeting}`,
	`git restore ${names.greeting}`,
	`git commit -m "${names.typo}"`,
	`git commit --amend -m "${names.farewell}"`,
	`git add ${names.signature}`,
	'git commit --amend --no-edit',
	`git commit -m "${names.change}"`,
	`git revert ${hash.change}`,
	`git commit -m "${names.list}"`,
	'git reset --soft HEAD~1',
	`git commit -m "${names.list}"`,
	'git reset --mixed HEAD~1',
	`git add ${names.tasks}`,
	`git commit -m "${names.list}"`,
	'git reset --hard HEAD~1',
	'git reflog',
	`git reset --hard ${hash.t3}`,
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const commands = highlightCode(session, 'bash').map((html, index) => ({
	n: index + 1,
	html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
}));

// What Git prints for each command (from the lesson, the reflog shortened).
const revertMsg = `Revert "${names.change}"`;
const outputs = [
	{ id: 'out-1', lines: [`[main (root-commit) ${hash.init}] ${names.initial}`, ' 1 file changed, 1 insertion(+)'] },
	{ id: 'out-4', lines: [`[main ${hash.typo}] ${names.typo}`] },
	{ id: 'out-5', lines: [`[main ${hash.am1}] ${names.farewell}`] },
	{ id: 'out-7', lines: [`[main ${hash.am2}] ${names.farewell}`, ' 2 files changed, 2 insertions(+)'] },
	{ id: 'out-8', lines: [`[main ${hash.change}] ${names.change}`] },
	{ id: 'out-9', lines: [`[main ${hash.revert}] ${revertMsg}`, ' 1 file changed, 1 insertion(+), 1 deletion(-)'] },
	{ id: 'out-10', lines: [`[main ${hash.t1}] ${names.list}`] },
	{ id: 'out-12', lines: [`[main ${hash.t2}] ${names.list}`] },
	{ id: 'out-15', lines: [`[main ${hash.t3}] ${names.list}`] },
	{ id: 'out-16', lines: [`HEAD is now at ${hash.revert} ${revertMsg}`] },
	{
		id: 'out-17',
		lines: [
			`${hash.revert} HEAD@{0}: reset: moving to HEAD~1`,
			`${hash.t3} HEAD@{1}: commit: ${names.list}`,
			`${hash.revert} HEAD@{2}: reset: moving to HEAD~1`,
			`${hash.t2} HEAD@{3}: commit: ${names.list}`,
		],
	},
	{ id: 'out-18', lines: [`HEAD is now at ${hash.t3} ${names.list}`] },
];

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 74;
const LINE_H = 23;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 5;
const CONSOLE_TOP = 512;
const OUT_TOP = 544;
const outBase = (row: number) => OUT_TOP + row * LINE_H + LINE_H / 2 + 5;
const lineAnchors = commands.map((line) => ({ id: `ln-${line.n}`, n: line.n }));

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up. The chain of commits runs
// along +u at the back; the lane of commits out of the history sits just in front
// of it; then the staging area and the working tree; the command deck at the front.
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 56;
const EY = 32;
const ORIGIN = { x: 607, y: 352 };
type Point = { x: number; y: number };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');
const path = (points: Point[]) => 'M' + points.map((point) => `${point.x} ${point.y}`).join(' L');

/** A box standing on the floor at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		corners: [back, right, front, down(front), down(left), left],
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
	};
}
/** Text lying flat on a floor, reading along +u. */
const floorMatrix = (point: Point) => `matrix(0.866 0.5 -0.866 0.5 ${point.x} ${point.y})`;
/** Text lying flat on a floor, reading along -v (up its left edge). */
const floorMatrixV = (point: Point) => `matrix(0.866 -0.5 0.866 0.5 ${point.x} ${point.y})`;

const CHAIN_V = -2.0;
const LANE_V = -1.0;
const SLOT_U = [-2.2, -1.0, 0.2, 1.4, 2.6];
const LANE_U = [-1.9, -1.0, 0.8, 1.7, 2.6];
const slots = SLOT_U.map((u) => pt(u, CHAIN_V));
const lane = LANE_U.map((u) => pt(u, LANE_V));
const DECK = { u: 2.6, v: 3.75 };
const moduleAt = (n: number) => {
	const row = n <= 9 ? 0 : 1;
	const col = (n - 1) % 9;
	return slab(DECK.u - 2.2 + col * 0.55, DECK.v + (row === 0 ? -0.33 : 0.33), 0.21, 0.21, 14);
};

const G = {
	repo: slab(0.2, -1.5, 3.1, 1.2, 12, -12),
	stage: slab(-1.1, 0.75, 0.95, 0.55, 12, -12),
	work: slab(1.7, 0.75, 0.95, 0.55, 12, -12),
	deck: slab(DECK.u, DECK.v, 2.6, 0.72, 12, -12),
	modules: Array.from({ length: 18 }, (_, index) => moduleAt(index + 1)),
};
const STAGE = G.stage.center;
const WORK = G.work.center;
const LANE_BOX = [pt(-2.5, -1.45), pt(3.2, -1.45), pt(3.2, -0.55), pt(-2.5, -0.55), pt(-2.5, -1.45)];
const gridLines = [
	...[-2, -1, 0, 1, 2, 3].map((u) => path([pt(u, -2.6, 0.5), pt(u, -0.5, 0.5)])),
	...[-2.5, -2, -1.5, -1].map((v) => path([pt(-2.9, v, 0.5), pt(3.3, v, 0.5)])),
];

// Where things stop: commit slots and their tips, the lane, the zones and the modules.
const anchors = [
	...slots.map((point, k) => ({ id: `a-slot-${k}`, ...point })),
	...slots.map((point, k) => ({ id: `a-tip-${k}`, ...lift(point, 60) })),
	...lane.map((point, k) => ({ id: `a-o-${k + 1}`, ...point })),
	{ id: 'a-stage', ...lift(STAGE, 16) },
	{ id: 'a-work', ...lift(WORK, 22) },
	...G.modules.map((module, index) => ({ id: `a-m-${index + 1}`, ...lift(module.center, 16) })),
];
const at = (id: string) => anchors.find((anchor) => anchor.id === id) ?? { x: 0, y: 0 };

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shots = [
	{ id: 'shot-all', cx: 640, cy: 380, s: 0.92 },
	{ id: 'shot-main', cx: 662, cy: 372, s: 1.05 },
	{ id: 'shot-repo', cx: 745, cy: 300, s: 1.1 },
].map((item) => ({
	id: item.id,
	x: round(item.cx - 640 / item.s),
	y: round(item.cy - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));
// ── END of the world geometry ─────────────────────────────────────────────

type Tone = 'flow' | 'violet' | 'magenta';

// Commits: one visual identity, a rounded node with its short hash.
type CommitNode = { id: string; hash: string; tone: Tone; slot: number };
const nodes: CommitNode[] = [
	{ id: 'c-init', hash: hash.init, tone: 'flow', slot: 0 },
	{ id: 'c-typo', hash: hash.typo, tone: 'magenta', slot: 1 },
	{ id: 'c-am1', hash: hash.am1, tone: 'violet', slot: 1 },
	{ id: 'c-am2', hash: hash.am2, tone: 'violet', slot: 1 },
	{ id: 'c-change', hash: hash.change, tone: 'magenta', slot: 2 },
	{ id: 'c-revert', hash: hash.revert, tone: 'violet', slot: 3 },
	{ id: 'c-t1', hash: hash.t1, tone: 'flow', slot: 4 },
	{ id: 'c-t2', hash: hash.t2, tone: 'flow', slot: 4 },
	{ id: 'c-t3', hash: hash.t3, tone: 'flow', slot: 4 },
];

// Files: one visual identity, a card with the file name.
type Card = { id: string; text: string; tone: Tone; restAt: string };
const cards: Card[] = [
	{ id: 'f-saludo', text: names.greeting, tone: 'magenta', restAt: 'a-work' },
	{ id: 'f-firma', text: names.signature, tone: 'flow', restAt: 'a-stage' },
	{ id: 'f-tareas', text: names.tasks, tone: 'flow', restAt: 'a-o-3' },
];

// Modules of the command deck, with their tone when lit.
const moduleTone: Record<number, Tone> = { 2: 'magenta', 3: 'violet', 4: 'magenta', 5: 'violet', 7: 'violet', 8: 'magenta', 9: 'violet', 16: 'magenta', 17: 'violet', 18: 'violet' };
const modules = G.modules.map((g, index) => ({ n: index + 1, g, tone: moduleTone[index + 1] ?? ('flow' as Tone) }));

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = {
	id: string;
	text: string;
	x: number;
	y: number;
	align: 'start' | 'end' | 'middle';
	tone: 'plain' | Tone;
	mono?: boolean;
	icon?: 'check' | 'x';
};
const beside = (k: number) => ({ x: slots[k].x + 40, y: slots[k].y + 2 });
// Notes for the working tree sit off its front-right edge, clear of the deck.
const UNDER_WORK = { x: WORK.x + 50, y: WORK.y + 40 };
const UNDER_WORK2 = { x: WORK.x + 50, y: WORK.y + 70 };
const UNDER_STAGE = { x: STAGE.x + 12, y: STAGE.y + 76 };

const chips: Chip[] = [
	{ id: 'lb-hola', text: `${names.greeting}: ${names.before}`, ...UNDER_WORK, align: 'start', tone: 'flow', mono: true, icon: 'check' },
	{ id: 'lb-lost', text: t('cambio perdido para siempre', 'change lost for good'), ...UNDER_WORK2, align: 'start', tone: 'magenta', icon: 'x' },
	{ id: 'lb-typo', text: names.typo, ...beside(1), align: 'start', tone: 'magenta', mono: true },
	{ id: 'lb-fixed', text: names.farewell, ...beside(1), align: 'start', tone: 'violet', mono: true },
	// Stacked over the revert note, right of HEAD's arrow, so the pointer never crosses it.
	{ id: 'lb-change', text: `${names.before} → ${names.after}`, x: slots[3].x + 40, y: slots[3].y - 38, align: 'start', tone: 'magenta' },
	{ id: 'lb-revert', text: `${names.after} → ${names.before}`, ...beside(3), align: 'start', tone: 'violet' },
	{ id: 'lb-soft', text: t('--soft: al staging', '--soft: to staging'), ...UNDER_STAGE, align: 'middle', tone: 'flow', mono: true },
	{ id: 'lb-mixed', text: t('--mixed: al working tree', '--mixed: to the working tree'), ...UNDER_WORK, align: 'start', tone: 'flow', mono: true },
	{ id: 'lb-hard', text: t('--hard: todo igual a HEAD', '--hard: all matches HEAD'), ...UNDER_STAGE, align: 'middle', tone: 'magenta' },
	{ id: 'lb-gone', text: t(`${names.tasks} ya no existe`, `${names.tasks} is gone`), ...UNDER_WORK, align: 'start', tone: 'magenta', icon: 'x' },
	{ id: 'lb-back', text: t(`${names.tasks} vuelve`, `${names.tasks} is back`), ...UNDER_WORK, align: 'start', tone: 'violet', icon: 'check' },
	{ id: 'r-commit', text: t('en un commit: se recupera', 'in a commit: recoverable'), x: slots[1].x + 70, y: slots[1].y - 96, align: 'middle', tone: 'violet', icon: 'check' },
	{ id: 'r-never', text: t('sin commit: se pierde', 'never committed: lost'), ...UNDER_WORK2, align: 'start', tone: 'magenta', icon: 'x' },
	{ id: 'r-share', text: t('ya compartido: git revert', 'already shared: git revert'), x: slots[1].x + 70, y: slots[1].y - 58, align: 'middle', tone: 'violet', icon: 'check' },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.icon ? 42 : 24));
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

const cardWidth = (card: Card) => Math.round(card.text.length * 7.6 + 46);
const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="dc-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="dc-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="dc-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="dc-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="dc-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="dc-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the repository, seen through the camera -->
			<g clip-path="url(#dc-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#dc-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#dc-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- The repository: the chain of commits and, in front, the lane out of the history -->
						<g data-el="floor-repo">
							<polygon class="xj-plate-shadow" points={G.repo.base} transform="translate(14 22)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.repo.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.repo.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.repo.top} fill="url(#dc-g-floor)"></polygon>
							{gridLines.map((d) => <path class="xj-grid" d={d} />)}
							<text class="xj-floor-text" transform={floorMatrixV(pt(-2.8, -0.35))}>{t('Repositorio', 'Repository')}</text>
						</g>
						<g data-el="rf-lane" class="xj-lane">
							<path class="mg-stroke" pathLength="1" d={path(LANE_BOX)}></path>
							<text class="xj-floor-text xj-floor-text--small xj-lane-text" transform={floorMatrix(pt(-0.25, -0.4))}>git reflog</text>
						</g>
						<g data-el="lb-out">
							<text class="xj-floor-text xj-floor-text--small" transform={floorMatrix(pt(-2.4, -0.4))}>{t('fuera del historial', 'out of the history')}</text>
						</g>
						{
							[1, 2, 3, 4].map((k) => (
								<g data-el={`lk-${k}`}>
									<path class="mg-stroke xj-link" pathLength="1" d={path([slots[k], slots[k - 1]])} />
								</g>
							))
						}

						<!-- Staging area and working tree -->
						<g data-el="floor-stage">
							<polygon class="xj-plate-shadow" points={G.stage.base} transform="translate(10 14)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.stage.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.stage.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.stage.top} fill="url(#dc-g-floor)"></polygon>
							<text class="xj-floor-text xj-floor-text--small" transform={floorMatrix(pt(-0.95, 1.25))}>Staging</text>
						</g>
						<g data-el="floor-work">
							<polygon class="xj-plate-shadow" points={G.work.base} transform="translate(10 14)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.work.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.work.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.work.top} fill="url(#dc-g-floor)"></polygon>
							<text class="xj-floor-text xj-floor-text--small" transform={floorMatrix(pt(1.4, 1.25))}>Working tree</text>
						</g>

						<!-- Command deck: one module per editor line -->
						<g data-el="floor-deck">
							<polygon class="xj-plate-shadow" points={G.deck.base} transform="translate(14 22)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.deck.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.deck.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.deck.top} fill="url(#dc-g-floor)"></polygon>
							<text class="xj-floor-text xj-floor-text--small" transform={floorMatrix(pt(-1.3, 3.18))}>{t('Terminal', 'Terminal')}</text>
						</g>
						{
							modules.map((module) => (
								<>
									<g data-el={`m-${module.n}`} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(5 7)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#dc-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.n}
										</text>
									</g>
									<g data-el={`on-${module.n}`} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
										<polygon class="xj-lit-halo" points={module.g.top} />
										<polygon class="xj-lit-top" points={module.g.top} />
										<polygon class="xj-lit-side" points={module.g.leftFace} />
										<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.n}
										</text>
									</g>
								</>
							))
						}

						<!-- Commits. Placement lives in data-x/data-y: the player resets data-el transforms. -->
						{
							nodes.map((node) => (
								<g data-el={node.id} data-x={slots[node.slot].x} data-y={slots[node.slot].y}>
									<g class:list={['xj-node', `xj-node--${node.tone}`]}>
										<ellipse class="xj-node-shadow" cx="6" cy="12" rx="31" ry="17" />
										<ellipse class="xj-node-halo" cx="0" cy="-5" rx="35" ry="21" />
										<ellipse class="xj-node-side" cx="0" cy="4" rx="30" ry="17" />
										<rect class="xj-node-band" x="-30" y="-5" width="60" height="9" />
										<ellipse class="xj-node-top" cx="0" cy="-5" rx="30" ry="17" />
										<text class="xj-node-text" x="0" y="-1" text-anchor="middle">
											{node.hash}
										</text>
									</g>
									<g data-el={`${node.id}-off`} class="xj-ghost">
										<ellipse cx="0" cy="4" rx="31" ry="18" />
										<rect x="-31" y="-5" width="62" height="9" />
										<ellipse class="xj-ghost-rim" cx="0" cy="-5" rx="31" ry="18" />
									</g>
								</g>
							))
						}

						<!-- Files travelling between the zones and the commits -->
						{
							cards.map((card) => (
								<g data-el={card.id} data-x={at(card.restAt).x} data-y={at(card.restAt).y}>
									<g class:list={['xj-card', `xj-card--${card.tone}`]}>
										<rect class="xj-card-halo" x={-cardWidth(card) / 2 - 5} y="-19" width={cardWidth(card) + 10} height="38" rx="17" />
										<rect class="xj-card-body" x={-cardWidth(card) / 2} y="-14" width={cardWidth(card)} height="28" rx="12" />
										<svg class="xj-icon" x={-cardWidth(card) / 2 + 9} y="-8" width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
											<path d="M14 2v4a2 2 0 0 0 2 2h4" />
										</svg>
										<text class="xj-card-text" x="12" y="4.5" text-anchor="middle">
											{card.text}
										</text>
									</g>
								</g>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.icon === 'check' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
									{chip.icon === 'x' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M18 6 6 18" />
											<path d="m6 6 12 12" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.icon ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- HEAD: one marker that points to main, and main to a commit -->
						<g data-el="head" data-x={at('a-tip-0').x} data-y={at('a-tip-0').y}>
							<g class="xj-head">
								<rect class="xj-head-pill" x="-28" y="-40" width="56" height="20" rx="10"></rect>
								<text class="xj-head-text" x="0" y="-26" text-anchor="middle">HEAD</text>
								<path class="xj-head-joint" d="M0 -20 V-14"></path>
								<rect class="xj-main-pill" x="-26" y="-14" width="52" height="20" rx="10"></rect>
								<text class="xj-main-text" x="0" y="0" text-anchor="middle">main</text>
								<path class="xj-head-stem" d="M0 6 V30"></path>
								<path class="xj-head-tip" d="M-6 28 L0 37 L6 28 Z"></path>
							</g>
						</g>

						<!-- The execution flow -->
						<g data-el="p" class="xj-particle" data-x={at('a-m-1').x} data-y={at('a-m-1').y}>
							<circle r="20" fill="url(#dc-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="336" height="28" rx="14"></rect>
				<circle class="xj-legend-node" cx={VP.x + 28} cy={LEGEND_Y} r="7"></circle>
				<text x={VP.x + 42} y={LEGEND_Y + 4}>Commit</text>
				<rect class="xj-legend-ghost" x={VP.x + 112} y={LEGEND_Y - 7} width="18" height="14" rx="7"></rect>
				<text x={VP.x + 138} y={LEGEND_Y + 4}>{t('Fuera del historial', 'Out of the history')}</text>
				<rect class="xj-legend-card" x={VP.x + 286} y={LEGEND_Y - 6} width="20" height="12" rx="5"></rect>
				<text x={VP.x + 312} y={LEGEND_Y + 4}>{t('Archivo', 'File')}</text>
			</g>

			<!-- EDITOR: the terminal session, with the running command highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{`bash — ${names.repo}`}</text>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<!-- Line states sit behind the text -->
				<rect data-el="hv-17" class="xj-bar xj-bar--violet" x={BAR.x} y={OUT_TOP + LINE_H} width={BAR.w} height={LINE_H} rx="6"></rect>
				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(1)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<g class="xj-code">
					{
						commands.map((line) => (
							<g data-el={`e-${line.n}`}>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				{
					outputs.map((output) => (
						<g data-el={output.id}>
							{output.lines.map((text, row) => (
								<text class="xj-out" x={ED.x + 20} y={outBase(row)} xml:space="preserve">
									{text}
								</text>
							))}
						</g>
					))
				}
				{lineAnchors.map((anchor) => <circle data-anchor={anchor.id} cx={BAR_CX} cy={lineMid(anchor.n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow, magenta for the mistake or what is lost and violet for
	   what fixes or recovers it.
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='deshacer-cambios-git']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='deshacer-cambios-git'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='deshacer-cambios-git'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='deshacer-cambios-git'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-node {
		fill: var(--xj-panel);
		stroke: var(--xj-flow);
		stroke-width: 2;
	}

	.xj-legend-ghost {
		fill: var(--xj-ink);
		stroke: var(--xj-dim);
		stroke-width: 1.5;
		stroke-dasharray: 4 3;
	}

	.xj-legend-card {
		fill: var(--xj-panel);
		stroke: var(--xj-flow-soft);
		stroke-width: 1.5;
	}

	/* Floors and modules */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-grid {
		fill: none;
		stroke: var(--xj-flow);
		stroke-width: 1;
		opacity: 0.07;
	}

	.xj-floor-text {
		font-family: var(--font-body);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.04em;
		fill: var(--xj-mist);
		opacity: 0.85;
	}

	.xj-floor-text--small {
		font-size: 12.5px;
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-face-text {
		font-family: var(--font-body);
		font-size: 11px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face-text--on {
		fill: var(--xj-ink);
	}

	/* Lit states */
	.xj-lit {
		--xj-lit: var(--xj-flow);
		--xj-lit-soft: var(--xj-flow-soft);
	}

	.xj-lit--violet {
		--xj-lit: var(--xj-violet);
		--xj-lit-soft: var(--xj-violet-soft);
	}

	.xj-lit--magenta {
		--xj-lit: var(--xj-magenta);
		--xj-lit-soft: var(--xj-magenta-soft);
	}

	.xj-lit-halo {
		fill: none;
		stroke: var(--xj-lit);
		stroke-width: 12;
		stroke-opacity: 0.22;
		stroke-linejoin: round;
	}

	.xj-lit-top {
		fill: var(--xj-lit);
		fill-opacity: 0.5;
		stroke: var(--xj-lit-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-lit-side {
		fill: var(--xj-lit-soft);
		stroke: var(--xj-lit-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	/* The chain: parent links and the lane out of the history */
	.xj-link {
		fill: none;
		stroke: var(--xj-mist);
		stroke-width: 3;
		stroke-opacity: 0.6;
		stroke-linecap: round;
	}

	.xj-lane-text {
		fill: var(--xj-violet-soft);
		opacity: 1;
	}

	.xj-lane path {
		fill: none;
		stroke: var(--xj-violet);
		stroke-width: 2;
		stroke-linejoin: round;
		stroke-dasharray: 0.012 0.008;
	}

	/* Commits */
	.xj-node {
		--xj-node: var(--xj-flow);
		--xj-node-soft: var(--xj-flow-soft);
	}

	.xj-node--magenta {
		--xj-node: var(--xj-magenta);
		--xj-node-soft: var(--xj-magenta-soft);
	}

	.xj-node--violet {
		--xj-node: var(--xj-violet);
		--xj-node-soft: var(--xj-violet-soft);
	}

	.xj-node-shadow {
		fill: var(--xj-ink);
		opacity: 0.55;
	}

	.xj-node-halo {
		fill: none;
		stroke: var(--xj-node);
		stroke-width: 8;
		stroke-opacity: 0.2;
	}

	.xj-node-side {
		fill: var(--xj-steel);
		stroke: var(--xj-node);
		stroke-width: 2;
	}

	.xj-node-band {
		fill: var(--xj-steel);
	}

	.xj-node-top {
		fill: var(--xj-panel);
		stroke: var(--xj-node);
		stroke-width: 2.5;
	}

	.xj-node-text {
		font-family: monospace;
		font-size: 11.5px;
		font-weight: 700;
		fill: var(--xj-node-soft);
	}

	.xj-ghost ellipse,
	.xj-ghost rect {
		fill: var(--xj-ink);
		fill-opacity: 0.62;
	}

	.xj-ghost .xj-ghost-rim {
		stroke: var(--xj-dim);
		stroke-width: 1.5;
		stroke-dasharray: 5 4;
	}

	/* HEAD and main */
	.xj-head-pill {
		fill: var(--xj-flow);
	}

	.xj-head-text {
		font-family: monospace;
		font-size: 12px;
		font-weight: 700;
		fill: var(--xj-ink);
	}

	.xj-main-pill {
		fill: var(--xj-panel);
		stroke: var(--xj-flow-soft);
		stroke-width: 1.5;
	}

	.xj-main-text {
		font-family: monospace;
		font-size: 12px;
		font-weight: 700;
		fill: var(--xj-flow-soft);
	}

	.xj-head-joint,
	.xj-head-stem {
		fill: none;
		stroke: var(--xj-flow);
		stroke-width: 2.5;
		stroke-linecap: round;
	}

	.xj-head-tip {
		fill: var(--xj-flow);
	}

	/* Files */
	.xj-card {
		--xj-card: var(--xj-flow);
		--xj-card-ink: var(--xj-flow-soft);
	}

	.xj-card--magenta {
		--xj-card: var(--xj-magenta);
		--xj-card-ink: var(--xj-magenta-soft);
	}

	.xj-card-halo {
		fill: var(--xj-card);
		fill-opacity: 0.16;
	}

	.xj-card-body {
		fill: var(--xj-ink);
		stroke: var(--xj-card);
		stroke-width: 2;
	}

	.xj-card-text {
		font-family: monospace;
		font-size: 12.5px;
		font-weight: 700;
		fill: var(--xj-card-ink);
	}

	.xj-card .xj-icon {
		stroke: var(--xj-card-ink);
	}

	/* Notes */
	.xj-chip {
		--xj-chip: var(--xj-edge);
		--xj-chip-ink: var(--xj-mist);
	}

	.xj-chip--flow {
		--xj-chip: var(--xj-flow);
		--xj-chip-ink: var(--xj-flow-soft);
	}

	.xj-chip--magenta {
		--xj-chip: var(--xj-magenta);
		--xj-chip-ink: var(--xj-magenta-soft);
	}

	.xj-chip--violet {
		--xj-chip: var(--xj-violet);
		--xj-chip-ink: var(--xj-violet-soft);
	}

	.xj-chip rect {
		fill: var(--xj-panel);
		fill-opacity: 0.94;
		stroke: var(--xj-chip);
		stroke-width: 1.5;
	}

	.xj-chip-text {
		font-family: var(--font-body);
		font-size: 12.5px;
		font-weight: 600;
		fill: var(--xj-chip-ink);
	}

	.xj-chip-mono {
		font-family: monospace;
		font-size: 12.5px;
		fill: var(--xj-chip-ink, var(--xj-white));
	}

	.xj-icon {
		fill: none;
		stroke: var(--xj-white);
		stroke-linecap: round;
		stroke-linejoin: round;
		overflow: visible;
	}

	.xj-particle-core {
		fill: var(--xj-white);
	}

	/* Editor */
	.xj-panel {
		fill: var(--xj-panel);
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-rule {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-dot {
		fill: var(--xj-edge);
	}

	.xj-file {
		font-family: monospace;
		font-size: 13px;
		fill: var(--xj-mist);
	}

	.xj-mono,
	.xj-out {
		font-family: monospace;
		font-size: 13px;
		white-space: pre;
		fill: var(--xj-mist);
	}

	.xj-out {
		fill: var(--xj-flow-soft);
	}

	.xj-gutter {
		font-family: monospace;
		font-size: 12px;
		fill: var(--xj-dim);
	}

	.mg-canvas .xj-code :global(.tok-cmd) {
		fill: var(--xj-white);
		font-weight: 700;
	}

	.mg-canvas .xj-code :global(.tok-flag) {
		fill: var(--xj-violet-soft);
	}

	.mg-canvas .xj-code :global(.tok-str),
	.mg-canvas .xj-code :global(.tok-var) {
		fill: var(--xj-flow);
	}

	.mg-canvas .xj-code :global(.tok-op),
	.mg-canvas .xj-code :global(.tok-cmt) {
		fill: var(--xj-dim);
