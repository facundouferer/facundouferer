---
/**
 * Scene for "The journey of a private field: constructors and encapsulation"
 * (lesson java/09, slug `07-constructores-y-encapsulamiento`), a short film played
 * on one persistent motion canvas. The captions and cues live in
 * `src/data/animations/constructores-encapsulamiento-java.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: it shows
 * the Java source and the cues slide a bar over the line being executed. The
 * viewport on the right holds the camera: an isometric system where `main` is a
 * floor, `Cuenta` is the class platform below it, every line that runs is a module,
 * a light blue particle is the execution flow, and a violet object on the Heap
 * guards its private `saldo` field. Magenta marks blocked direct access and
 * rejected invalid updates.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/constructores-encapsulamiento-java';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── Source code shown in the editor ───────────────────────────────────────
// Identifiers and string literals are localized the same way the lesson does.
const names = {
	file: t('Cuenta.java', 'Account.java'),
	mainClass: t('Main', 'Main'),
	account: t('Cuenta', 'Account'),
	balance: t('saldo', 'balance'),
	owner: t('titular', 'owner'),
	getBalance: t('getSaldo', 'getBalance'),
	deposit: t('depositar', 'deposit'),
	amount: t('monto', 'amount'),
};
const strings = {
	outInit: '1000.0',
	outFinal: '1200.0',
	outOverload: 'Ana: 0.0',
};

// First program: private field, constructor with `this`, getter, and validating mutator.
const sourceA = [
	`class ${names.account} {`,
	`    private double ${names.balance};`,
	'',
	`    public ${names.account}(double ${names.balance}) {`,
	`        this.${names.balance} = ${names.balance};`,
	'    }',
	`    public double ${names.getBalance}() { return ${names.balance}; }`,
	`    public boolean ${names.deposit}(double ${names.amount}) {`,
	`        if (${names.amount} <= 0) return false;`,
	`        this.${names.balance} += ${names.amount};`,
	'        return true;',
	'    }',
	'}',
	`public class ${names.mainClass} {`,
	`    public static void main(String[] args) {`,
	`        ${names.account} c = new ${names.account}(1000);`,
	`        System.out.println(c.${names.getBalance}());`,
	`        c.${names.deposit}(-500);`,
	`        c.${names.deposit}(200);`,
	'    }',
].join('\n');

// Second program: overloaded constructors delegating with `this(owner, 0)`.
const sourceB = [
	`class ${names.account} {`,
	`    private String ${names.owner};`,
	`    private double ${names.balance};`,
	`    public ${names.account}(String ${names.owner}) {`,
	`        this(${names.owner}, 0);`,
	'    }',
	`    public ${names.account}(String ${names.owner}, double ${names.balance}) {`,
	`        this.${names.owner} = ${names.owner};`,
	`        this.${names.balance} = ${names.balance};`,
	'    }',
	`    public double ${names.getBalance}() { return ${names.balance}; }`,
	'}',
	'',
	`public class ${names.mainClass} {`,
	'    public static void main(String[] args) {',
	`        ${names.account} c = new ${names.account}("Ana");`,
	`        System.out.println("Ana: " + c.${names.getBalance}());`,
	'    }',
	'}',
	'',
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const svgLines = (source: string) =>
	highlightCode(source, 'java').map((html, index) => ({
		n: index + 1,
		html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
	}));

const pageA = svgLines(sourceA);
const pageB = svgLines(sourceB);

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 64;
const GUTTER_X = 50;
const CODE_TOP = 74;
const LINE_H = 23;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 5;
const CONSOLE_TOP = 552;
const outY = (row: number) => 597 + row * LINE_H;

// Lines the highlight bar travels to (`ln-<n>`).
const lineAnchors = [2, 5, 7, 9, 10, 15, 16, 17, 18, 19].map((n) => ({ id: `ln-${n}`, n }));

// Program output, one element per printed line of each run.
const outputs = [
	{ id: 'out-1', row: 0, text: strings.outInit },
	{ id: 'out-2', row: 1, text: strings.outFinal },
	{ id: 'out-b', row: 0, text: strings.outOverload },
];

// ── Isometric world (camera space) ────────────────────────────────────────
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 58;
const EY = 33.5;
const ORIGIN = { x: 480, y: 290 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');
const path = (points: Point[]) => 'M' + points.map((point) => `${point.x} ${point.y}`).join(' L');

/** A box standing on the floor at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		outline: poly([back, right, down(right), down(front), down(left), left]),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
	};
}
const floorMatrix = (point: Point) => `matrix(0.866 0.5 -0.866 0.5 ${point.x} ${point.y})`;

const MODULE_H = 18;
const LEVEL_CLASS = -270;
const HEAP = { u: 3.3, v: -1.1 };

const block = (u: number, v = 0, z = 0) => slab(u, v, 0.36, 0.36, MODULE_H, z);
const G = {
	floor: slab(0.8, -0.4, 2.2, 1.3, 12, -12),
	heap: slab(HEAP.u, HEAP.v, 0.85, 0.75, 12, -12),
	entry: slab(-0.9, 0, 0.2, 0.2, 6),
	create: block(0),
	getCall: block(0.9),
	badCall: block(1.8),
	okCall: block(2.7),
	end: slab(3.4, 0, 0.22, 0.22, 8),
	variable: slab(0, -1.1, 0.36, 0.3, 8),
	wall: slab(1.8, -1.1, 0.3, 0.3, 22),
	floorAcc: slab(1.35, 0, 2.1, 1.0, 10, LEVEL_CLASS - 10),
	c5: block(0, 0, LEVEL_CLASS),
	g7: block(0.9, 0, LEVEL_CLASS),
	d9: block(1.8, 0, LEVEL_CLASS),
	d10: block(2.7, 0, LEVEL_CLASS),
	floorOver: slab(0.9, 0, 1.6, 0.9, 10, LEVEL_CLASS - 10),
	o5: block(0.2, 0, LEVEL_CLASS),
	o9: block(1.5, 0, LEVEL_CLASS),
};
type Slab = typeof G.floor;
type Tone = 'flow' | 'violet' | 'magenta';

// Routes connecting `main`, `Cuenta`, and the Heap object.
const routes = {
	main: path([pt(-0.9, 0), pt(3.4, 0)]),
	entry: path([pt(-0.9, 0), pt(0, 0)]),
	step1: path([pt(0, 0), pt(0.9, 0)]),
	step2: path([pt(0.9, 0), pt(1.8, 0)]),
	step3: path([pt(1.8, 0), pt(2.7, 0)]),
	reference: path([pt(0.36, -1.1, 1), pt(HEAP.u - 0.3, HEAP.v, 1)]),
	ctor: path([pt(0, 0), G.c5.center]),
	init: path([G.c5.center, pt(HEAP.u, HEAP.v)]),
	priv: path([pt(0, 0), G.wall.center]),
	getter: path([pt(0.9, 0), G.g7.center]),
	read: path([G.g7.center, pt(HEAP.u, HEAP.v)]),
	bad: path([pt(1.8, 0), G.d9.center]),
	ok: path([pt(2.7, 0), G.d9.center]),
	upd: path([G.d10.center, pt(HEAP.u, HEAP.v)]),
	over: path([pt(0, 0), G.o5.center]),
	del: path([G.o5.center, G.o9.center]),
};
const gridLines = [
	...[-1, 0, 1, 2, 3].map((u) => path([pt(u, -1.7, 0.5), pt(u, 0.9, 0.5)])),
	...[-1.5, -1, -0.5, 0, 0.5].map((v) => path([pt(-1.3, v, 0.5), pt(3.5, v, 0.5)])),
];

type Lit = { id: string; g: Slab; tone: Tone; face?: string };
type Platform = {
	id: string;
	g: Slab;
	label: string;
	labelAt: Point;
	modules: { g: Slab; face: string }[];
	states: Lit[];
};
const platforms: Platform[] = [
	{
		id: 'floor-acc',
		g: G.floorAcc,
		label: names.account,
		labelAt: pt(-0.55, 0.85, LEVEL_CLASS),
		modules: [
			{ g: G.c5, face: '5' },
			{ g: G.g7, face: '7' },
			{ g: G.d9, face: '9' },
			{ g: G.d10, face: '10' },
		],
		states: [
			{ id: 'c5-on', g: G.c5, tone: 'violet', face: '5' },
			{ id: 'g7-on', g: G.g7, tone: 'flow', face: '7' },
			{ id: 'd9-x', g: G.d9, tone: 'magenta', face: '9' },
			{ id: 'd9-on', g: G.d9, tone: 'flow', face: '9' },
			{ id: 'd10-on', g: G.d10, tone: 'violet', face: '10' },
		],
	},
	{
		id: 'floor-over',
		g: G.floorOver,
		label: names.account,
		labelAt: pt(-0.5, 0.78, LEVEL_CLASS),
		modules: [
			{ g: G.o5, face: '5' },
			{ g: G.o9, face: '9' },
		],
		states: [
			{ id: 'o5-on', g: G.o5, tone: 'flow', face: '5' },
			{ id: 'o9-on', g: G.o9, tone: 'violet', face: '9' },
		],
	},
];

// Modules of `main`, back to front.
type Module = { id: string; g: Slab; face?: string; lit?: { id: string } };
const modules: Module[] = [
	{ id: 'm-var', g: G.variable },
	{ id: 'm-entry', g: G.entry },
	{ id: 'm-new', g: G.create, face: '16', lit: { id: 'new-on' } },
	{ id: 'm-get', g: G.getCall, face: '17', lit: { id: 'get-on' } },
	{ id: 'm-bad', g: G.badCall, face: '18', lit: { id: 'bad-on' } },
	{ id: 'm-ok', g: G.okCall, face: '19', lit: { id: 'ok-on' } },
	{ id: 'm-end', g: G.end },
];

// Where the travelling particle stops: just above the top of each module.
const hover = (g: Slab, by = 16) => lift(g.center, by);
const OBJECT = lift(pt(HEAP.u, HEAP.v), 22);
const anchors = [
	{ id: 'a-entry', ...hover(G.entry, 14) },
	{ id: 'a-new', ...hover(G.create) },
	{ id: 'a-get', ...hover(G.getCall) },
	{ id: 'a-bad', ...hover(G.badCall) },
	{ id: 'a-ok', ...hover(G.okCall) },
	{ id: 'a-wall', ...hover(G.wall, 18) },
	{ id: 'a-obj', ...lift(pt(HEAP.u - 0.45, HEAP.v), 14) },
	{ id: 'a-c5', ...hover(G.c5) },
	{ id: 'a-g7', ...hover(G.g7) },
	{ id: 'a-d9', ...hover(G.d9) },
	{ id: 'a-d10', ...hover(G.d10) },
	{ id: 'a-o5', ...hover(G.o5) },
	{ id: 'a-o9', ...hover(G.o9) },
];

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shots = [
	{ id: 'shot-class', cx: 610, cy: 520, s: 1.15 },
	{ id: 'shot-main', cx: 615, cy: 270, s: 1.2 },
	{ id: 'shot-ctor', cx: 585, cy: 430, s: 1.15 },
	{ id: 'shot-obj', cx: 690, cy: 295, s: 1.35 },
	{ id: 'shot-priv', cx: 640, cy: 275, s: 1.25 },
	{ id: 'shot-dep', cx: 645, cy: 470, s: 1.12 },
	{ id: 'shot-over', cx: 560, cy: 450, s: 1.2 },
	{ id: 'shot-all', cx: 635, cy: 430, s: 0.92 },
].map((item) => ({
	id: item.id,
	x: round(item.cx - 640 / item.s),
	y: round(item.cy - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Floating notes.
type Chip = {
	id: string;
	text: string;
	x: number;
	y: number;
	align: 'start' | 'end' | 'middle';
	tone: 'plain' | Tone;
	mono?: boolean;
	check?: boolean;
	lead?: Point;
};
const tagChip = (id: string, text: string, tone: Chip['tone'], g: Slab): Chip => ({
	id,
	text,
	x: g.center.x - 24,
	y: g.center.y + 78,
	align: 'end',
	tone,
	mono: true,
	lead: { x: g.center.x - 14, y: g.center.y + 24 },
});

const chips: Chip[] = [
	{ id: 'lb-priv', text: `private double ${names.balance}`, x: 460, y: 510, align: 'start', tone: 'violet', mono: true },
	tagChip('lb-ctor', `${names.account}(double)`, 'violet', G.c5),
	tagChip('lb-get', `${names.getBalance}()`, 'flow', G.g7),
	tagChip('lb-dep', `${names.deposit}(double)`, 'violet', G.d10),
	{
		id: 'this-chip',
		text: `this.${names.balance} = ${names.balance}`,
		x: G.c5.center.x + 28,
		y: G.c5.center.y - 36,
		align: 'start',
		tone: 'violet',
		mono: true,
		check: true,
	},
	{
		id: 'val-1000',
		text: `this.${names.balance} = 1000.0`,
		x: OBJECT.x,
		y: OBJECT.y + 72,
		align: 'middle',
		tone: 'violet',
		mono: true,
		check: true,
	},
	{
		id: 'val-1200',
		text: `this.${names.balance} = 1200.0`,
		x: OBJECT.x,
		y: OBJECT.y + 72,
		align: 'middle',
		tone: 'violet',
		mono: true,
		check: true,
	},
	{
		id: 'err-priv',
		text: t(`c.${names.balance} = -500 bloqueado (private)`, `c.${names.balance} = -500 blocked (private)`),
		x: G.wall.center.x,
		y: G.wall.center.y - 36,
		align: 'middle',
		tone: 'magenta',
		mono: true,
	},
	{
		id: 'ro-chip',
		text: t('solo lectura: 1000.0', 'read-only: 1000.0'),
		x: G.g7.center.x + 24,
		y: G.g7.center.y - 34,
		align: 'start',
		tone: 'flow',
		check: true,
	},
	{
		id: 'rej-chip',
		text: t('monto <= 0 → return false', 'amount <= 0 → return false'),
		x: G.d9.center.x,
		y: G.d9.center.y - 40,
		align: 'middle',
		tone: 'magenta',
		mono: true,
	},
	{
		id: 'ok-chip',
		text: t('validado → return true', 'validated → return true'),
		x: G.d10.center.x,
		y: G.d10.center.y - 40,
		align: 'middle',
		tone: 'violet',
		check: true,
	},
	tagChip('sg-short', `${names.account}(String)`, 'flow', G.o5),
	tagChip('sg-canon', `${names.account}(String, double)`, 'violet', G.o9),
	{
		id: 'del-chip',
		text: `this(${names.owner}, 0)`,
		x: G.o5.center.x + 24,
		y: G.o5.center.y - 36,
		align: 'start',
		tone: 'flow',
		mono: true,
	},
	{
		id: 'r-ctor',
		text: t('constructor: nace válido', 'constructor: born valid'),
		x: 470,
		y: 465,
		align: 'start',
		tone: 'flow',
		check: true,
	},
	{
		id: 'r-encap',
		text: t('private + métodos: invariante intacto', 'private + methods: invariant intact'),
		x: OBJECT.x - 60,
		y: OBJECT.y + 108,
		align: 'start',
		tone: 'violet',
		check: true,
	},
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.check ? 42 : 24));
const chipLeft = (chip: Chip) => (chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x);
const chipJoin = (chip: Chip) => (chip.align === 'end' ? chipLeft(chip) + chipWidth(chip) - 14 : chip.align === 'middle' ? chip.x : chipLeft(chip) + 14);

const VAR_LABEL = { x: 566, y: 122, w: 150, h: 40 };
const shieldRing = slab(HEAP.u, HEAP.v, 0.65, 0.58, 0, 2).top;
const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="xp-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="xp-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="xp-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="xp-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="xp-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="xp-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="xp-g-object">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.7"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the running system, seen through the camera -->
			<g clip-path="url(#xp-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + 150} cy={VP.y + 110} rx="420" ry="320" fill="url(#xp-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + VP.w - 60} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#xp-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- The class platforms below main() -->
						{
							platforms.map((platform) => (
								<>
									<g data-el={platform.id}>
										<polygon class="xj-plate-shadow" points={platform.g.base} transform="translate(10 16)" />
										<polygon class="xj-plate xj-plate--l" points={platform.g.leftFace} />
										<polygon class="xj-plate xj-plate--r" points={platform.g.rightFace} />
										<polygon class="xj-plate xj-plate--t" points={platform.g.top} fill="url(#xp-g-floor)" />
										<text class="xj-floor-text" transform={floorMatrix(platform.labelAt)}>
											{platform.label}
										</text>
										{platform.modules.map((module) => (
											<>
												<polygon class="xj-shadow" points={module.g.base} transform="translate(7 9)" />
												<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
												<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
												<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#xp-g-top)" />
												<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
													{module.face}
												</text>
											</>
										))}
									</g>
									{platform.states.map((state) => (
										<g data-el={state.id} class:list={['xj-lit', `xj-lit--${state.tone}`]}>
											<polygon class="xj-lit-halo" points={state.g.top} />
											<polygon class="xj-lit-top" points={state.g.top} />
											<polygon class="xj-lit-side" points={state.g.leftFace} />
											<text class="xj-face-text xj-face-text--on" transform={state.g.faceMatrix} text-anchor="middle" y="4.5">
												{state.face}
											</text>
										</g>
									))}
								</>
							))
						}

						<!-- Flow routes between main(), Cuenta, and the Heap object -->
						<g data-el="rt-ctor" class="xj-flowline xj-flowline--violet">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.ctor}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.ctor}></path>
						</g>
						<g data-el="fl-init" class="xj-flowline xj-flowline--violet">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.init}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.init}></path>
						</g>
						<g data-el="rt-get" class="xj-flowline">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.getter}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.getter}></path>
						</g>
						<g data-el="fl-read" class="xj-flowline">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.read}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.read}></path>
						</g>
						<g data-el="rt-bad" class="xj-flowline xj-flowline--magenta">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.bad}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.bad}></path>
						</g>
						<g data-el="rt-ok" class="xj-flowline xj-flowline--violet">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.ok}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.ok}></path>
						</g>
						<g data-el="fl-upd" class="xj-flowline xj-flowline--violet">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.upd}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.upd}></path>
						</g>
						<g data-el="rt-over" class="xj-flowline">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.over}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.over}></path>
						</g>
						<g data-el="fl-del" class="xj-flowline xj-flowline--violet">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.del}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.del}></path>
						</g>

						<!-- main() and, beside it, the heap where the object lives -->
						<g data-el="floor-main">
							<polygon class="xj-plate-shadow" points={G.floor.base} transform="translate(14 22)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.floor.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.floor.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.floor.top} fill="url(#xp-g-floor)"></polygon>
							{gridLines.map((d) => <path class="xj-grid" d={d} />)}
							<text class="xj-floor-text" transform={floorMatrix(pt(-1.15, 0.72))}>main()</text>
						</g>
						<g data-el="heap">
							<polygon class="xj-plate-shadow" points={G.heap.base} transform="translate(10 16)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.heap.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.heap.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.heap.top} fill="url(#xp-g-floor)"></polygon>
							<text class="xj-floor-text" transform={floorMatrix(pt(HEAP.u - 0.66, HEAP.v + 0.52))}>heap</text>
						</g>

						<!-- Routes on main(): the dim base first, the lit runs on top -->
						<g data-el="tr-main"><path class="mg-stroke xj-trace" pathLength="1" d={routes.main}></path></g>
						<g data-el="ref"><path class="mg-stroke xj-ref" pathLength="1" d={routes.reference}></path></g>
						<g data-el="rt-priv" class="xj-flowline xj-flowline--magenta">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.priv}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.priv}></path>
						</g>
						<g data-el="fl-0" class="xj-flowline">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.entry}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.entry}></path>
						</g>
						<g data-el="fl-1" class="xj-flowline">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.step1}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.step1}></path>
						</g>
						<g data-el="fl-2" class="xj-flowline">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.step2}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.step2}></path>
						</g>
						<g data-el="fl-3" class="xj-flowline">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.step3}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.step3}></path>
						</g>

						<!-- Blocked direct access barrier (magenta) -->
						<g data-el="priv-x" class="xj-lit xj-lit--magenta">
							<polygon class="xj-lit-halo" points={G.wall.top}></polygon>
							<polygon class="xj-lit-top" points={G.wall.top}></polygon>
							<polygon class="xj-lit-side" points={G.wall.leftFace}></polygon>
						</g>

						<!-- Modules of main(), back to front, each with its lit state -->
						{
							modules.map((module) => (
								<>
									<g data-el={module.id} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(7 9)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#xp-g-top)" />
										{module.face && (
											<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
												{module.face}
											</text>
										)}
									</g>
									{module.lit && (
										<g data-el={module.lit.id} class="xj-lit xj-lit--flow">
											<polygon class="xj-lit-halo" points={module.g.top} />
											<polygon class="xj-lit-top" points={module.g.top} />
											<polygon class="xj-lit-side" points={module.g.leftFace} />
											{module.face && (
												<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
													{module.face}
												</text>
											)}
										</g>
									)}
								</>
							))
						}

						<!-- The variable: a slot of main() holding the reference to Cuenta -->
						<g data-el="lb-var" class="xj-chip xj-chip--flow">
							<line class="xj-lead" x1={G.variable.center.x + 8} y1={G.variable.center.y - 4} x2={VAR_LABEL.x + 30} y2={VAR_LABEL.y + VAR_LABEL.h}></line>
							<rect x={VAR_LABEL.x} y={VAR_LABEL.y} width={VAR_LABEL.w} height={VAR_LABEL.h} rx="12"></rect>
							<text class="xj-chip-mono xj-chip-mono--strong" x={VAR_LABEL.x + 14} y={VAR_LABEL.y + 17}>{names.account} c</text>
							<text class="xj-chip-mono" x={VAR_LABEL.x + 14} y={VAR_LABEL.y + 32}>{t('referencia Stack', 'Stack reference')}</text>
						</g>

						<!-- Encapsulation shield around the Heap object -->
						<polygon data-el="shield" class="xj-scan" points={shieldRing}></polygon>

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									{chip.lead && <line class="xj-lead" x1={chip.lead.x} y1={chip.lead.y} x2={chipJoin(chip)} y2={chip.y - 12} />}
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.check && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.check ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- The object: one violet instance for the whole journey. The player resets
						     `transform` on `data-el` elements, so the placement lives on an inner group. -->
						<g data-el="obj">
							<g class="xj-object" transform={`translate(${OBJECT.x} ${OBJECT.y})`}>
								<circle r="36" fill="url(#xp-g-object)"></circle>
								<polygon class="xj-gem xj-gem--l" points="-15,-10.5 0,-2 0,15 -15,6.5"></polygon>
								<polygon class="xj-gem xj-gem--r" points="15,-10.5 0,-2 0,15 15,6.5"></polygon>
								<polygon class="xj-gem xj-gem--t" points="0,-19 15,-10.5 0,-2 -15,-10.5"></polygon>
								<rect class="xj-tag" x="-56" y="-56" width="112" height="22" rx="11"></rect>
								<text class="xj-tag-text" x="0" y="-40.5" text-anchor="middle">{t(`objeto ${names.account}`, `${names.account} object`)}</text>
							</g>
						</g>

						<!-- The execution flow -->
						<g data-el="p" class="xj-particle" data-x={anchors[0].x} data-y={anchors[0].y}>
							<circle r="20" fill="url(#xp-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="310" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<polygon class="xj-legend-object" points={`${VP.x + 190},${LEGEND_Y - 6} ${VP.x + 196},${LEGEND_Y} ${VP.x + 190},${LEGEND_Y + 6} ${VP.x + 184},${LEGEND_Y}`}></polygon>
				<text x={VP.x + 204} y={LEGEND_Y + 4}>{t('Estado encapsulado', 'Encapsulated state')}</text>
			</g>

			<!-- EDITOR: the source, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.file}</text>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<!-- Line states behind the code -->
				<rect data-el="hc-7" class="xj-bar xj-bar--flow" x={BAR.x} y={lineTop(7)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<rect data-el="hx-2" class="xj-bar xj-bar--trail" x={BAR.x} y={lineTop(2)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<rect data-el="hx-9" class="xj-bar xj-bar--trail" x={BAR.x} y={lineTop(9)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<rect data-el="hv-5" class="xj-bar xj-bar--violet" x={BAR.x} y={lineTop(5)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<rect data-el="hv-10" class="xj-bar xj-bar--violet" x={BAR.x} y={lineTop(10)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<rect data-el="hv-b9" class="xj-bar xj-bar--violet" x={BAR.x} y={lineTop(9)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(15)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<!-- First program: constructor, private field, getter, and validating mutator -->
				<g data-el="ea" data-base="shown" class="xj-code">
					{
						pageA.map((line) => (
							<g data-el={`ea-${line.n}`}>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				<!-- Second program: overloaded constructors delegating with this(...) -->
				<g data-el="eb" class="xj-code">
					{
						pageB.map((line) => (
							<g data-el={`eb-${line.n}`}>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				{
					outputs.map((line) => (
						<text data-el={line.id} class="xj-out" x={ED.x + 20} y={outY(line.row)} xml:space="preserve">
							{line.text}
						</text>
					))
				}
				{lineAnchors.map((anchor) => <circle data-anchor={anchor.id} cx={BAR_CX} cy={lineMid(anchor.n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow, magenta for blocked/rejected operations and violet for
	   validated state updates.
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='constructores-encapsulamiento-java']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='constructores-encapsulamiento-java'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='constructores-encapsulamiento-java'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='constructores-encapsulamiento-java'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-magenta {
		stop-color: var(--xj-magenta);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-object {
		fill: var(--xj-violet);
	}

	/* Levels and modules */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-grid {
		fill: none;
		stroke: var(--xj-flow);
		stroke-width: 1;
		opacity: 0.07;
	}

	.xj-floor-text {
		font-family: var(--font-body);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.04em;
		fill: var(--xj-mist);
		opacity: 0.85;
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-face-text {
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face-text--on {
		fill: var(--xj-ink);
	}

	/* Lit states: the module that is running, or the one that failed */
	.xj-lit {
		--xj-lit: var(--xj-flow);
		--xj-lit-soft: var(--xj-flow-soft);
	}

	.xj-lit--violet {
		--xj-lit: var(--xj-violet);
		--xj-lit-soft: var(--xj-violet-soft);
	}

	.xj-lit--magenta {
		--xj-lit: var(--xj-magenta);
		--xj-lit-soft: var(--xj-magenta-soft);
	}

	.xj-lit-halo {
		fill: none;
		stroke: var(--xj-lit);
		stroke-width: 12;
		stroke-opacity: 0.22;
		stroke-linejoin: round;
	}

	.xj-lit-top {
		fill: var(--xj-lit);
		fill-opacity: 0.5;
		stroke: var(--xj-lit-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-lit-side {
		fill: var(--xj-lit-soft);
		stroke: var(--xj-lit-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	/* Routes */
	.xj-trace {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.xj-ref {
		fill: none;
