---
/**
 * Scene for "Data in a row" (lesson c/manejo-de-estructuras-secuenciales-de-datos,
 * order: 18), a short film played on one persistent motion canvas. The captions and
 * cues live in `src/data/animations/datos-secuenciales-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: the lesson's
 * program (five separate variables and their average), with a bar that slides to the
 * running line and the real output typed in the console below. The viewport on the
 * right holds the camera and an isometric world. Each loose variable is a box of its
 * own next to the module of its line; the sum station gathers them by name. Then the
 * same values, drawn as value tokens (one identity for "a grade"), line up in a row of
 * slots under a single name, each slot numbered with its position. The light blue
 * particle is the flow that walks the row; violet marks what solves the problem (the
 * jump of direct access, the capacity, the row that grows); magenta marks the limits.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/datos-secuenciales-c';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── The program shown in the editor ───────────────────────────────────────
// The lesson's own program, identifiers localized like it does. The long sum is
// wrapped after `nota3` so it fits the editor; it is the same statement.
const names = {
	file: t('notas.c', 'grades.c'),
	grade: t('nota', 'grade'),
	average: t('promedio', 'average'),
	row: t('notas', 'grades'),
};
const grades = [8, 6, 10, 7, 9];
const g = (n: number) => `${names.grade}${n}`;
const sumHead = `    double ${names.average} = (`;
const source = [
	'#include <stdio.h>',
	'',
	'int main(void) {',
	...grades.map((value, index) => `    int ${g(index + 1)} = ${value};`),
	'',
	`${sumHead}${g(1)} + ${g(2)} + ${g(3)}`,
	`${' '.repeat(sumHead.length)}+ ${g(4)} + ${g(5)}) / 5.0;`,
	`    printf("${t('Promedio', 'Average')}: %.2f\\n", ${names.average});`,
	'    return 0;',
	'}',
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const lines = highlightCode(source, 'c').map((html, index) => ({
	n: index + 1,
	html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
}));

// The real output of the program (compiled with cc -std=c23 -Wall -Wextra -Wpedantic).
const outputs = [`${t('Promedio', 'Average')}: 8.00`];

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 72;
const LINE_H = 27;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 5;
const CONSOLE_TOP = 560;
const outY = (row: number) => 610 + row * 24;

/** A bracket in the gutter, from the first to the last line it groups. */
const bracket = (from: number, to: number) => {
	const top = lineTop(from) + 3;
	const bottom = lineTop(to) + LINE_H - 3;
	return `M38 ${top} H31 V${bottom} H38`;
};

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up. Things are placed by the
// screen point of their footprint center (`ground`), converted back to the grid.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 50;
const EY = 29;
const ORIGIN = { x: 640, y: 330 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const grid = (ground: Point) => {
	const du = (ground.x - ORIGIN.x) / EX;
	const dv = (ground.y - ORIGIN.y) / EY;
	return { u: (du + dv) / 2, v: (dv - du) / 2 };
};
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');

/** A box whose footprint is centered on `ground`: half-extents `a` (u) and `b` (v), height `h`. */
function slab(ground: Point, a: number, b: number, h: number, z = 0) {
	const { u, v } = grid(ground);
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
	};
}
type Slab = ReturnType<typeof slab>;
type Tone = 'flow' | 'violet' | 'magenta';

// Loose variables: five boxes with nothing in common, each beside the module of its line.
const CELL_GROUND: Point[] = [
	{ x: 410, y: 470 },
	{ x: 490, y: 528 },
	{ x: 570, y: 466 },
	{ x: 650, y: 524 },
	{ x: 730, y: 468 },
];
const cells = CELL_GROUND.map((ground, index) => ({
	id: `c-${index + 1}`,
	name: g(index + 1),
	value: grades[index],
	g: slab(ground, 0.42, 0.42, 22),
}));

// Modules: one per instruction, labelled with its editor line.
type Module = { line: number; g: Slab; tone: Tone };
const block = (ground: Point) => slab(ground, 0.18, 0.18, 14);
const modules: Module[] = [
	...CELL_GROUND.map((ground, index) => ({ line: index + 4, tone: 'flow' as Tone, g: block({ x: ground.x - 48, y: ground.y + 36 }) })),
	{ line: 10, tone: 'flow', g: block({ x: 800, y: 580 }) },
	{ line: 12, tone: 'flow', g: block({ x: 846, y: 607 }) },
	{ line: 13, tone: 'flow', g: block({ x: 892, y: 634 }) },
];
const moduleAt = (line: number) => modules.find((module) => module.line === line)?.g.center ?? { x: 0, y: 0 };
const SUM = moduleAt(10);

// The row: numbered slots one after another along u. Slots 5 to 7 complete the capacity.
const STEP = { x: 52, y: 30 };
const S0 = { x: 470, y: 176 };
const slotGround = (index: number): Point => ({ x: S0.x + index * STEP.x, y: S0.y + index * STEP.y });
const slots = Array.from({ length: 8 }, (_, index) => ({ id: `s-${index}`, index, g: slab(slotGround(index), 0.46, 0.46, 20) }));
const SLOT = (index: number) => slots[index].g.center;

// The growing row sits behind the fixed one; its slots are added while the program runs.
const BEHIND = { x: 130, y: -75 };
const grows = Array.from({ length: 4 }, (_, index) => {
	const ground = slotGround(index);
	return { id: `g-${index}`, index, g: slab({ x: ground.x + BEHIND.x, y: ground.y + BEHIND.y }, 0.46, 0.46, 20) };
});
const GROW = (index: number) => grows[index].g.center;

// Where the particle stops and where value tokens rest.
const START = lift(slab(slotGround(-1.15), 0.2, 0.2, 0).center, 18);
const anchors = [
	...modules.map((module) => ({ id: `a-m${module.line}`, ...lift(module.g.center, 16) })),
	...cells.map((cell, index) => ({ id: `a-c${index + 1}`, ...lift(cell.g.center, 4) })),
	...slots.map((slot) => ({ id: `a-s${slot.index}`, ...lift(slot.g.center, 4) })),
	...grows.map((slot) => ({ id: `a-g${slot.index}`, ...lift(slot.g.center, 4) })),
	{ id: 'a-sum', ...lift(SUM, 34) },
	{ id: 'a-start', ...START },
	{ id: 'a-try', x: round((cells[0].g.center.x + cells[1].g.center.x) / 2 + 6), y: round(cells[0].g.center.y + 10) },
	{ id: 'a-in', x: SLOT(7).x + 120, y: SLOT(7).y - 90 },
	{ id: 'a-full', ...lift(slab(slotGround(8.1), 0.2, 0.2, 20).center, 4) },
	{ id: 'a-in2', x: GROW(3).x + 120, y: GROW(3).y - 70 },
];
const at = (id: string) => anchors.find((anchor) => anchor.id === id) ?? { x: 0, y: 0 };

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shots = [
	{ id: 'shot-loose', cx: 580, cy: 500, s: 1.25 },
	{ id: 'shot-station', cx: 690, cy: 520, s: 1.15 },
	{ id: 'shot-gather', cx: 630, cy: 360, s: 1.0 },
	{ id: 'shot-row', cx: 560, cy: 250, s: 1.3 },
	{ id: 'shot-cap', cx: 660, cy: 300, s: 1.1 },
	{ id: 'shot-grow', cx: 690, cy: 230, s: 1.1 },
].map((item) => ({
	id: item.id,
	x: round(item.cx - 640 / item.s),
	y: round(item.cy - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Routes. Each grade read by its name on the way to the sum; the loop that cannot step
// from one name to the next; the one-step jump of direct access.
const arc = (from: Point, to: Point, rise: number) =>
	`M${from.x} ${from.y} Q${round((from.x + to.x) / 2)} ${round(Math.min(from.y, to.y) - rise)} ${to.x} ${to.y}`;
const routes = [
	...cells.map((cell, index) => ({ id: `fl-${index + 1}`, tone: 'flow', d: arc(lift(cell.g.center, 8), at('a-sum'), 60 + index * 6) })),
	{ id: 'fl-try', tone: 'magenta', d: arc(lift(cells[0].g.center, 8), at('a-try'), 46) },
	{ id: 'fl-jump', tone: 'violet', d: arc(START, at('a-s4'), 110) },
];
/** Hand-holding links: each slot only knows the next one. */
const linkPath = (from: Point, to: Point) => arc(lift(from, 14), lift(to, 14), 26);
const links = [0, 1, 2, 3].map((index) => linkPath(SLOT(index), SLOT(index + 1)));
const gLinks = [0, 1, 2].map((index) => linkPath(GROW(index), GROW(index + 1)));

/** A ring around a run of slots, at the height of their tops. */
const ringAround = (from: number, to: number, pad: number) => {
	const first = grid(slotGround(from));
	const last = grid(slotGround(to));
	return poly([pt(first.u - pad, first.v - pad, 22), pt(last.u + pad, last.v - pad, 22), pt(last.u + pad, last.v + pad, 22), pt(first.u - pad, first.v + pad, 22)]);
};
/** Slots 0 to 4 under one name; slots 0 to 7, the capacity. */
const ROW_RING = ringAround(0, 4, 0.62);
const CAP_RING = ringAround(0, 7, 0.74);

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = {
	id: string;
	text: string;
	x: number;
	y: number;
	align: 'start' | 'end' | 'middle';
	tone: 'plain' | Tone;
	mono?: boolean;
	icon?: 'arrow';
};
const chips: Chip[] = [
	{ id: 'lb-avg', text: `${names.average} = 8.0`, x: 880, y: 500, align: 'middle', tone: 'flow', mono: true },
	{ id: 'lb-30', text: t('30 notas = 30 variables', '30 grades = 30 variables'), x: 680, y: 390, align: 'middle', tone: 'magenta' },
	{ id: 'no-pass', text: t('nombres, no posiciones', 'names, not positions'), x: 440, y: 380, align: 'middle', tone: 'magenta' },
	{ id: 'lb-fixed', text: t('cantidad fija en el código', 'count fixed in the code'), x: 560, y: 628, align: 'middle', tone: 'magenta' },
	{ id: 'lb-name', text: names.row, x: 385, y: 205, align: 'middle', tone: 'flow', mono: true },
	{ id: 'pos', text: t('posición', 'position'), x: 470, y: 290, align: 'middle', tone: 'plain' },
	{ id: 'lb-start', text: t('inicio', 'start'), x: 380, y: 95, align: 'middle', tone: 'plain' },
	{ id: 'lb-k', text: t('k pasos', 'k steps'), x: SLOT(4).x + 40, y: SLOT(4).y - 58, align: 'start', tone: 'flow' },
	{ id: 'lb-one', text: t('1 paso', '1 step'), x: SLOT(2).x, y: 62, align: 'middle', tone: 'violet' },
	{ id: 'lb-cap', text: t('capacidad 8', 'capacity 8'), x: 760, y: 430, align: 'middle', tone: 'violet' },
	{ id: 'lb-used5', text: t('cantidad usada 5', 'used count 5'), x: 640, y: 400, align: 'middle', tone: 'flow' },
	{ id: 'lb-used8', text: t('cantidad usada 8', 'used count 8'), x: 640, y: 400, align: 'middle', tone: 'flow' },
	{ id: 'lb-full', text: t('sin lugar', 'no room'), x: at('a-full').x, y: at('a-full').y - 44, align: 'middle', tone: 'magenta' },
	{ id: 'lb-grow', text: t('crece en ejecución', 'grows at run time'), x: 800, y: 60, align: 'middle', tone: 'violet' },
	{ id: 'lb-mem', text: 'memoria-dinamica', x: 860, y: 246, align: 'middle', tone: 'violet', mono: true, icon: 'arrow' },
	{ id: 'map-array', text: t('arreglo: directo, estático', 'array: direct, static'), x: 650, y: 378, align: 'middle', tone: 'flow' },
	{ id: 'map-list', text: t('lista enlazada: secuencial, dinámica', 'linked list: sequential, dynamic'), x: 800, y: 60, align: 'middle', tone: 'violet' },
	{ id: 'lb-next', text: t('lección siguiente: arreglos', 'next lesson: arrays'), x: 640, y: 636, align: 'middle', tone: 'violet', icon: 'arrow' },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.icon ? 42 : 24));
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

// Value tokens: one visual identity for "a grade". The first five are the program's.
const tokens = [
	...grades.map((value, index) => ({ id: `tk-${index + 1}`, text: String(value), tone: 'flow', home: `a-c${index + 1}` })),
	{ id: 'tk-6', text: '5', tone: 'flow', home: 'a-in' },
	{ id: 'tk-7', text: '8', tone: 'flow', home: 'a-in' },
	{ id: 'tk-8', text: '7', tone: 'flow', home: 'a-in' },
	{ id: 'tk-9', text: '6', tone: 'magenta', home: 'a-in' },
	...[9, 4, 7, 10].map((value, index) => ({ id: `tg-${index}`, text: String(value), tone: 'violet', home: 'a-in2' })),
];

const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="ds-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="ds-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<radialGradient id="ds-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="ds-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="ds-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the isometric world, seen through the camera -->
			<g clip-path="url(#ds-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#ds-g-pool-violet)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#ds-g-pool-flow)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- The growing row, behind: a slot is added for each item that arrives -->
						<g data-el="g-links" class="xj-flowline xj-flowline--violet xj-links">
							{gLinks.map((d) => <path class="mg-stroke xj-flowline-core" pathLength="1" d={d} />)}
						</g>
						{
							grows.map((slot) => (
								<g data-el={slot.id}>
									<polygon class="xj-shadow" points={slot.g.base} transform="translate(6 9)" />
									<polygon class="xj-slot xj-slot--violet xj-slot--l" points={slot.g.leftFace} />
									<polygon class="xj-slot xj-slot--violet xj-slot--r" points={slot.g.rightFace} />
									<polygon class="xj-slot xj-slot--violet xj-slot--t" points={slot.g.top} />
								</g>
							))
						}

						<!-- The row: one name, numbered slots in order -->
						<g data-el="cap-ring" class="xj-zone xj-zone--violet">
							<polygon class="mg-stroke" pathLength="1" points={CAP_RING}></polygon>
						</g>
						<g data-el="row-ring" class="xj-zone xj-zone--flow">
							<polygon class="mg-stroke" pathLength="1" points={ROW_RING}></polygon>
						</g>
						{
							slots.map((slot) => (
								<g data-el={slot.id}>
									<polygon class="xj-shadow" points={slot.g.base} transform="translate(6 9)" />
									<polygon class="xj-slot xj-slot--l" points={slot.g.leftFace} />
									<polygon class="xj-slot xj-slot--r" points={slot.g.rightFace} />
									<polygon class="xj-slot xj-slot--t" points={slot.g.top} />
									<text class="xj-slot-pos" transform={slot.g.faceMatrix} text-anchor="middle" y="5">
										{slot.index}
									</text>
								</g>
							))
						}
						<g data-el="links" class="xj-flowline xj-links">
							{links.map((d) => <path class="mg-stroke xj-flowline-core" pathLength="1" d={d} />)}
						</g>

						<!-- Loose variables: one box per name, each beside the module of its line -->
						{
							cells.map((cell) => (
								<g data-el={cell.id}>
									<polygon class="xj-shadow" points={cell.g.base} transform="translate(6 9)" />
									<polygon class="xj-cell xj-cell--l" points={cell.g.leftFace} />
									<polygon class="xj-cell xj-cell--r" points={cell.g.rightFace} />
									<polygon class="xj-cell xj-cell--t" points={cell.g.top} />
									<text class="xj-cell-name" transform={cell.g.faceMatrix} text-anchor="middle" y="5">
										{cell.name}
									</text>
									<text class="xj-value" x={cell.g.center.x} y={cell.g.center.y + 6} text-anchor="middle">
										{cell.value}
									</text>
								</g>
							))
						}
						{
							modules.map((module) => (
								<>
									<g data-el={`m-${module.line}`} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(5 7)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#ds-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4">
											{module.line}
										</text>
									</g>
									<g data-el={`on-${module.line}`} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
										<polygon class="xj-lit-halo" points={module.g.top} />
										<polygon class="xj-lit-top" points={module.g.top} />
										<polygon class="xj-lit-side" points={module.g.leftFace} />
										<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4">
											{module.line}
										</text>
									</g>
								</>
							))
						}

						<!-- Routes: each grade read by name, the loop that cannot step, the direct jump -->
						{
							routes.map((route) => (
								<g data-el={route.id} class:list={['xj-flowline', `xj-flowline--${route.tone}`]}>
									<path class="mg-stroke xj-flowline-halo" pathLength="1" d={route.d} />
									<path class="mg-stroke xj-flowline-core" pathLength="1" d={route.d} />
								</g>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.icon === 'arrow' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M5 12h14" />
											<path d="m12 5 7 7-7 7" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.icon ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- Value tokens. Placement lives on the inner group: the player resets data-el transforms. -->
						{
							tokens.map((token) => (
								<g data-el={token.id} data-x={at(token.home).x} data-y={at(token.home).y}>
									<g class:list={['xj-token', `xj-token--${token.tone}`]}>
										<rect class="xj-token-halo" x="-25" y="-19" width="50" height="38" rx="19" />
										<rect class="xj-token-card" x="-20" y="-14" width="40" height="28" rx="14" />
										<text class="xj-token-text" x="0" y="5.5" text-anchor="middle">
											{token.text}
										</text>
									</g>
								</g>
							))
						}

						<!-- The execution flow, which later walks the row -->
						<g data-el="p" class="xj-particle" data-x={at('a-m4').x} data-y={at('a-m4').y}>
							<circle r="20" fill="url(#ds-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="420" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo / recorrido', 'Flow / traversal')}</text>
				<rect class="xj-legend-token" x={VP.x + 172} y={LEGEND_Y - 7} width="20" height="14" rx="7"></rect>
				<text x={VP.x + 200} y={LEGEND_Y + 4}>{t('Un dato', 'An item')}</text>
				<rect class="xj-legend-slot" x={VP.x + 290} y={LEGEND_Y - 6} width="22" height="12" rx="3"></rect>
				<text x={VP.x + 320} y={LEGEND_Y + 4}>{t('Posición', 'Position')}</text>
			</g>

			<!-- EDITOR: the lesson's program, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.file}</text>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<!-- The sum that names every variable by hand: it does not scale -->
				<g data-el="hx-sum" class="xj-hx">
					<rect x={BAR.x} y={lineTop(10)} width={BAR.w} height={LINE_H * 2} rx="6"></rect>
				</g>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(4)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<!-- Five names, five declarations -->
				<g data-el="sc-vars" class="xj-scope">
					<path class="mg-stroke" pathLength="1" d={bracket(4, 8)}></path>
				</g>

				<g data-el="ed" data-base="shown" class="xj-code">
					{
						lines.map((line) => (
							<g>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				<!-- Console: the real output, typed as its line runs -->
				{
					outputs.map((row, index) => (
						<text data-el={`out-${index + 1}`} class="xj-out" x={ED.x + 20} y={outY(index)} xml:space="preserve">
							{row}
						</text>
					))
				}
				{lines.map((line) => <circle data-anchor={`ln-${line.n}`} cx={BAR_CX} cy={lineMid(line.n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue flow and grades, magenta for the limits (the sum that does not scale,
	   the item with no room) and violet for what solves them (direct access, the
	   capacity, the row that grows). Every rule below reads these tokens; no other
	   color is written in this file. */
	:global(.anim-player[data-slug='datos-secuenciales-c']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='datos-secuenciales-c'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='datos-secuenciales-c'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='datos-secuenciales-c'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-token {
		fill: var(--xj-ink);
		stroke: var(--xj-flow);
		stroke-width: 1.5;
	}

	.xj-legend-slot {
		fill: var(--xj-deep-hi);
		stroke: var(--xj-flow);
		stroke-width: 1.5;
	}

	/* Modules */
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-face-text {
		font-family: var(--font-body);
		font-size: 11px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face-text--on {
		fill: var(--xj-ink);
	}

	/* Loose variables: a box with its name on the front and its value on top */
	.xj-cell {
		stroke: var(--xj-flow);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-cell--l {
		fill: var(--xj-steel);
	}

	.xj-cell--r {
		fill: var(--xj-deep);
	}

	.xj-cell--t {
		fill: var(--xj-ink);
	}

	.xj-cell-name {
		font-family: monospace;
		font-size: 10.5px;
		font-weight: 700;
		fill: var(--xj-white);
	}

	.xj-value {
		font-family: monospace;
		font-size: 17px;
		font-weight: 700;
		fill: var(--xj-flow-soft);
	}

	/* Slots of a row: the position on the front face */
	.xj-slot {
		--xj-slot: var(--xj-flow);
		stroke: var(--xj-slot);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-slot--violet {
		--xj-slot: var(--xj-violet);
	}

	.xj-slot--l {
		fill: var(--xj-deep-hi);
	}

	.xj-slot--r {
		fill: var(--xj-panel);
	}

	.xj-slot--t {
		fill: var(--xj-ink);
		stroke-opacity: 0.7;
	}

	.xj-slot-pos {
		font-family: monospace;
		font-size: 13px;
		font-weight: 700;
		fill: var(--xj-flow-soft);
	}

	/* Lit states */
	.xj-lit {
		--xj-lit: var(--xj-flow);
		--xj-lit-soft: var(--xj-flow-soft);
	}

	.xj-lit--violet {
		--xj-lit: var(--xj-violet);
		--xj-lit-soft: var(--xj-violet-soft);
	}

	.xj-lit--magenta {
		--xj-lit: var(--xj-magenta);
		--xj-lit-soft: var(--xj-magenta-soft);
	}

	.xj-lit-halo {
		fill: none;
		stroke: var(--xj-lit);
		stroke-width: 12;
		stroke-opacity: 0.22;
		stroke-linejoin: round;
	}

	.xj-lit-top {
		fill: var(--xj-lit);
		fill-opacity: 0.5;
		stroke: var(--xj-lit-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-lit-side {
		fill: var(--xj-lit-soft);
		stroke: var(--xj-lit-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	/* Rings: one name around the row, and the capacity */
	.xj-zone polygon {
		fill: none;
		stroke: var(--xj-zone);
		stroke-width: 2;
		stroke-dasharray: 8 7;
		stroke-linejoin: round;
	}

	.xj-zone--flow {
		--xj-zone: var(--xj-flow);
	}

	.xj-zone--violet {
		--xj-zone: var(--xj-violet-soft);
	}

	/* Routes and links */
	.xj-flowline {
		--xj-line: var(--xj-flow);
	}

	.xj-flowline--violet {
		--xj-line: var(--xj-violet);
	}

	.xj-flowline--magenta {
		--xj-line: var(--xj-magenta);
	}

	.xj-flowline-halo,
	.xj-flowline-core {
		fill: none;
		stroke: var(--xj-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.xj-flowline-halo {
		stroke-width: 11;
		stroke-opacity: 0.2;
	}

	.xj-flowline-core {
		stroke-width: 3;
	}

	.xj-links .xj-flowline-core {
		stroke-width: 2.5;
	}

	/* Notes */
	.xj-chip {
		--xj-chip: var(--xj-edge);
		--xj-chip-ink: var(--xj-mist);
	}

	.xj-chip--flow {
		--xj-chip: var(--xj-flow);
		--xj-chip-ink: var(--xj-flow-soft);
	}

	.xj-chip--magenta {
		--xj-chip: var(--xj-magenta);
		--xj-chip-ink: var(--xj-magenta-soft);
	}

	.xj-chip--violet {
		--xj-chip: var(--xj-violet);
		--xj-chip-ink: var(--xj-violet-soft);
	}

	.xj-chip rect {
		fill: var(--xj-panel);
		fill-opacity: 0.94;
		stroke: var(--xj-chip);
		stroke-width: 1.5;
	}

	.xj-chip-text {
		font-family: var(--font-body);
		font-size: 12.5px;
		font-weight: 600;
		fill: var(--xj-chip-ink);
	}

	.xj-chip-mono {
		font-family: monospace;
		font-size: 12.5px;
		fill: var(--xj-chip-ink, var(--xj-white));
	}

	.xj-icon {
		fill: none;
		stroke: var(--xj-chip-ink);
		stroke-linecap: round;
		stroke-linejoin: round;
		overflow: visible;
	}

	/* Value tokens and the flow */
	.xj-token {
		--xj-token: var(--xj-flow);
		--xj-token-ink: var(--xj-flow-soft);
	}

	.xj-token--violet {
		--xj-token: var(--xj-violet);
		--xj-token-ink: var(--xj-violet-soft);
	}

	.xj-token--magenta {
		--xj-token: var(--xj-magenta);
		--xj-token-ink: var(--xj-magenta-soft);
	}

	.xj-token-halo {
		fill: var(--xj-token);
		fill-opacity: 0.18;
	}

	.xj-token-card {
		fill: var(--xj-ink);
		stroke: var(--xj-token);
		stroke-width: 2;
	}

	.xj-token-text {
		font-family: monospace;
		font-size: 15px;
		font-weight: 700;
		fill: var(--xj-token-ink);
	}

	.xj-particle-core {
		fill: var(--xj-white);
	}

	/* Editor */
	.xj-panel {
		fill: var(--xj-panel);
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-rule {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-dot {
		fill: var(--xj-edge);
	}

	.xj-file {
		font-family: monospace;
		font-size: 13px;
		fill: var(--xj-mist);
	}

	.xj-mono,
	.xj-out {
		font-family: monospace;
		font-size: 14px;
		white-space: pre;
		fill: var(--xj-mist);
	}

	.xj-out {
		fill: var(--xj-flow-soft);
	}

	.xj-gutter {
		font-family: monospace;
		font-size: 12px;
		fill: var(--xj-dim);
	}

	.mg-canvas .xj-code :global(.tok-kw) {
		fill: var(--xj-violet-soft);
	}

	.mg-canvas .xj-code :global(.tok-type),
	.mg-canvas .xj-code :global(.tok-fn) {
		fill: var(--xj-white);
		font-weight: 400;
	}

	.mg-canvas .xj-code :global(.tok-ann) {
		fill: var(--xj-violet-soft);
	}

	.mg-canvas .xj-code :global(.tok-str),
	.mg-canvas .xj-code :global(.tok-num) {
		fill: var(--xj-flow);
	}

	.mg-canvas .xj-code :global(.tok-punct),
	.mg-canvas .xj-code :global(.tok-op),
	.mg-canvas .xj-code :global(.tok-cmt) {
		fill: var(--xj-dim);
	}

	.xj-hl rect {
		fill: var(--xj-flow);
		fill-opacity: 0.18;
		stroke: var(--xj-flow);
		stroke-opacity: 0.6;
		stroke-width: 1.2;
	}

	.xj-hl path {
		fill: var(--xj-flow);
	}

	.xj-hx rect {
		fill: var(--xj-magenta);
		fill-opacity: 0.16;
		stroke: var(--xj-magenta);
		stroke-opacity: 0.7;
		stroke-width: 1.2;
	}

	.xj-scope path {
		fill: none;
		stroke: var(--xj-magenta-soft);
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>
