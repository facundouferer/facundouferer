---
/**
 * Scenes for the "Variables, data types and operators, step by step" animation
 * (lesson java/02). The captions, code and terminal panels live in
 * `src/data/animations/variables-tipos-datos-java.ts`; this component only draws
 * the diagrams the steps point to. Every `[data-scene]` block is one diagram and
 * every `[data-el]` is an element a step can reveal, emphasize or animate. The
 * `memory` and `casting` scenes are SVG canvases driven by motion cues.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/variables-tipos-datos-java';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);

// Canvas code: SVG text needs <tspan> where the highlighter emits <span>.
const toTspans = (html: string) => html.replaceAll('<span class="', '<tspan class="').replaceAll('</span>', '</tspan>');
const tspans = (code: string) => toTspans(highlightCode(code, 'java')[0]);

const names = isEs
	? { edad: 'edad', precio: 'precio', nombre: 'nombre', entero: 'numeroEntero', decimal: 'numeroDecimal', exacto: 'precioExacto', aprox: 'precioAproximado' }
	: { edad: 'age', precio: 'price', nombre: 'name', entero: 'wholeNumber', decimal: 'decimalNumber', exacto: 'exactPrice', aprox: 'roundedPrice' };

const c = isEs
	? { cuenta: 'Cuenta', total: 'totalCuentas', saldo: 'saldo', acreditar: 'acreditar', monto: 'monto', anterior: 'saldoAnterior', mensaje: 'mensaje', permitido: 'Acceso permitido', resultado: 'resultado', seguro: 'resultadoSeguro' }
	: { cuenta: 'Account', total: 'totalAccounts', saldo: 'balance', acreditar: 'credit', monto: 'amount', anterior: 'previousBalance', mensaje: 'message', permitido: 'Access granted', resultado: 'result', seguro: 'safeResult' };

const memoryLines = [
	`int ${names.edad} = 25;`,
	`double ${names.precio} = 99.99;`,
	`String ${names.nombre} = "Facundo";`,
].map((code, index) => ({ number: index + 1, y: 160 + index * 40, html: tspans(code) }));

const codeWidening = tspans(`double ${names.decimal} = ${names.entero};`);
const codeNarrowing = tspans(`int ${names.aprox} = (int) ${names.exacto};`);
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<!-- INTRO: static typing -->
	<div slot="scene" data-scene="typing" class="scene-typing">
		<div class="dg-row dg-row--center scene-typing-decl">
			<div class="dg-box dg-box--accent dg-box--center" data-el="t-type">
				<p class="dg-label">{isEs ? 'Tipo' : 'Type'}</p>
				<code class="dg-code">int</code>
			</div>
			<div class="dg-box dg-box--center" data-el="t-name">
				<p class="dg-label">{isEs ? 'Nombre' : 'Name'}</p>
				<code class="dg-code">{names.edad}</code>
			</div>
			<div class="dg-box dg-box--sage dg-box--center" data-el="t-value">
				<p class="dg-label dg-label--sage">{isEs ? 'Valor' : 'Value'}</p>
				<code class="dg-code">= 25;</code>
			</div>
		</div>
		<div class="dg-row dg-row--center">
			<span class="dg-chip dg-chip--ink" data-el="t-lock">
				<svg class="dg-icon dg-icon--lg scene-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
				</svg>
				{isEs ? 'Tipo fijo: no cambia durante la ejecución' : 'Fixed type: it never changes while running'}
			</span>
		</div>
	</div>

	<!-- 1. Variables and constants -->
	<div slot="scene" data-scene="declare" class="scene-declare">
		<div class="dg-grid-2">
			<div class="dg-box" data-el="v-int">
				<div class="dg-row">
					<span class="dg-chip dg-chip--accent">int</span>
					<code class="dg-code">{names.edad}</code>
				</div>
				<p class="dg-title scene-var-value">25</p>
			</div>
			<div class="dg-box" data-el="v-double">
				<div class="dg-row">
					<span class="dg-chip dg-chip--accent">double</span>
					<code class="dg-code">{names.precio}</code>
				</div>
				<p class="dg-title scene-var-value">99.99</p>
			</div>
			<div class="dg-box" data-el="v-bool">
				<div class="dg-row">
					<span class="dg-chip dg-chip--accent">boolean</span>
					<code class="dg-code">{isEs ? 'esEstudiante' : 'isStudent'}</code>
				</div>
				<p class="dg-title scene-var-value">true</p>
			</div>
			<div class="dg-box" data-el="v-char">
				<div class="dg-row">
					<span class="dg-chip dg-chip--accent">char</span>
					<code class="dg-code">{isEs ? 'inicial' : 'initial'}</code>
				</div>
				<p class="dg-title scene-var-value">'F'</p>
			</div>
		</div>
		<div class="dg-box dg-box--ink scene-final" data-el="v-final">
			<div class="dg-row">
				<svg class="dg-icon scene-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--color-accent-300)">
					<rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" />
				</svg>
				<code class="dg-code">final double PI = 3.14159;</code>
			</div>
			<p class="dg-sub">{isEs ? 'Constante: asignada una vez, no se puede modificar' : 'Constant: assigned once, it cannot be modified'}</p>
		</div>
	</div>

	<!-- 2. Scope: the three terms -->
	<div slot="scene" data-scene="scopeterms" class="scene-scopeterms">
		<div class="dg-grid-3">
			<div class="dg-box dg-box--accent" data-el="sc-scope">
				<p class="dg-label">{isEs ? 'Ámbito' : 'Scope'}</p>
				<p class="dg-title">{isEs ? 'Dónde puede usarse un nombre' : 'Where a name can be used'}</p>
				<p class="dg-sub">{isEs ? 'La región del código' : 'The region of code'}</p>
			</div>
			<div class="dg-box dg-box--sage" data-el="sc-vis">
				<p class="dg-label dg-label--sage">{isEs ? 'Visibilidad' : 'Visibility'}</p>
				<p class="dg-title">{isEs ? 'Desde qué líneas se accede' : 'From which lines it is reachable'}</p>
				<p class="dg-sub">{isEs ? 'Quién lo ve' : 'Who can see it'}</p>
			</div>
			<div class="dg-box" data-el="sc-life">
				<p class="dg-label">{isEs ? 'Tiempo de vida' : 'Lifetime'}</p>
				<p class="dg-title">{isEs ? 'Cuánto existe su valor' : 'How long its value exists'}</p>
				<p class="dg-sub">{isEs ? 'Durante la ejecución' : 'During execution'}</p>
			</div>
		</div>
	</div>

	<!-- 2. Scope: lexical nesting -->
	<div slot="scene" data-scene="nesting" class="scene-nesting">
		<div class="dg-nest dg-nest--accent" data-el="n-class">
			<p class="dg-label">{isEs ? 'Clase' : 'Class'} <code>{c.cuenta}</code></p>
			<div class="dg-nest dg-nest--sage" data-el="n-method">
				<p class="dg-label dg-label--sage">{isEs ? 'Método' : 'Method'} <code>{c.acreditar}(...)</code></p>
				<div class="dg-nest dg-nest--core" data-el="n-block">
					<p class="dg-label">{isEs ? 'Bloque' : 'Block'} <code>{'{ }'}</code></p>
				</div>
			</div>
		</div>
		<div class="dg-row dg-row--center">
			<span class="dg-chip dg-chip--ink" data-el="n-noglobal">{isEs ? 'No existen variables globales libres' : 'There are no free global variables'}</span>
		</div>
	</div>

	<!-- 2. Scope: categories table -->
	<div slot="scene" data-scene="scopetable" class="scene-scopetable">
		<div class="scene-scope-row scene-scope-head">
			<span>{isEs ? 'Categoría' : 'Category'}</span>
			<span>{isEs ? 'Visibilidad' : 'Visibility'}</span>
			<span>{isEs ? 'Tiempo de vida' : 'Lifetime'}</span>
		</div>
		<div class="dg-box scene-scope-row" data-el="row-local">
			<span class="dg-chip dg-chip--accent">{isEs ? 'Variable local' : 'Local variable'}</span>
			<span>{isEs ? 'Desde su declaración hasta el fin del bloque' : 'From its declaration to the end of the block'}</span>
			<span>{isEs ? 'Esa invocación y bloque' : 'That call and block'}</span>
		</div>
		<div class="dg-box scene-scope-row" data-el="row-block">
			<span class="dg-chip dg-chip--accent">{isEs ? 'De bloque' : 'Block-scoped'}</span>
			<span>{isEs ? 'Solo dentro de ese bloque' : 'Only inside that block'}</span>
			<span>{isEs ? 'Hasta que termina el bloque' : 'Until the block ends'}</span>
		</div>
		<div class="dg-box scene-scope-row" data-el="row-param">
			<span class="dg-chip dg-chip--accent">{isEs ? 'Parámetro' : 'Parameter'}</span>
			<span>{isEs ? 'Todo el cuerpo del método' : 'The whole method body'}</span>
			<span>{isEs ? 'Durante la invocación' : 'During the call'}</span>
		</div>
		<div class="dg-box dg-box--sage scene-scope-row" data-el="row-instance">
			<span class="dg-chip dg-chip--sage">{isEs ? 'Campo de instancia' : 'Instance field'}</span>
			<span>{isEs ? 'Según su modificador de acceso' : 'Per its access modifier'}</span>
			<span>{isEs ? 'Mientras el objeto sea alcanzable' : 'While the object is reachable'}</span>
		</div>
		<div class="dg-box dg-box--sage scene-scope-row" data-el="row-class">
			<span class="dg-chip dg-chip--sage">{isEs ? 'Campo de clase (static)' : 'Class field (static)'}</span>
			<span>{isEs ? 'Según su modificador de acceso' : 'Per its access modifier'}</span>
			<span>{isEs ? 'Desde que se carga la clase' : 'From the moment the class loads'}</span>
		</div>
	</div>

	<!-- 2. Scope: field defaults -->
	<div slot="scene" data-scene="defaults" class="scene-defaults">
		<div class="dg-grid-3">
			<div class="dg-box dg-box--center" data-el="d-num">
				<p class="dg-label">{isEs ? 'Numéricos' : 'Numeric'}</p>
				<code class="dg-code">0</code>
				<p class="dg-sub">int, double…</p>
			</div>
			<div class="dg-box dg-box--center" data-el="d-bool">
				<p class="dg-label">boolean</p>
				<code class="dg-code">false</code>
				<p class="dg-sub">{isEs ? 'campo sin asignar' : 'unassigned field'}</p>
			</div>
			<div class="dg-box dg-box--center" data-el="d-null">
				<p class="dg-label">{isEs ? 'Referencias' : 'References'}</p>
				<code class="dg-code">null</code>
				<p class="dg-sub">String, Cuenta…</p>
			</div>
		</div>
		<div class="dg-banner" data-el="d-warn">{isEs ? 'Predeterminado no es lo mismo que válido para tu dominio' : 'Default is not the same as valid for your domain'}</div>
	</div>

	<!-- 2. Scope: shadowing -->
	<div slot="scene" data-scene="shadow" class="scene-shadow">
		<div class="dg-grid-2">
			<div class="dg-box dg-box--accent" data-el="sh-class">
				<p class="dg-label">{isEs ? 'Campos de' : 'Fields of'} {c.cuenta}</p>
				<code class="dg-code">static int {c.total}</code>
				<code class="dg-code scene-shadow-field">int {c.saldo}</code>
			</div>
			<div class="dg-box dg-box--sage" data-el="sh-param">
				<p class="dg-label dg-label--sage">Constructor <code>{c.cuenta}(int {c.saldo})</code></p>
				<p class="dg-sub">{isEs ? `El parámetro ${c.saldo} sombrea al campo ${c.saldo}` : `The ${c.saldo} parameter shadows the ${c.saldo} field`}</p>
			</div>
		</div>
		<div class="dg-row dg-row--center">
			<span class="dg-chip dg-chip--ink" data-el="sh-this"><code>this.{c.saldo} = {c.saldo};</code> · {isEs ? 'campo = parámetro' : 'field = parameter'}</span>
		</div>
	</div>

	<!-- 2. Scope: a method with a parameter and a local -->
	<div slot="scene" data-scene="flow" class="scene-flow">
		<div class="dg-box scene-flow-row" data-el="f-check">
			<span class="dg-step-num">1</span>
			<span><code class="dg-code">{c.monto} &lt;= 0</code> · {isEs ? 'parámetro: se rechaza y se vuelve' : 'parameter: rejected and returns'}</span>
		</div>
		<div class="dg-box dg-box--accent scene-flow-row" data-el="f-local">
			<span class="dg-step-num">2</span>
			<span><code class="dg-code">int {c.anterior} = {c.saldo};</code> · {isEs ? 'variable local' : 'local variable'}</span>
		</div>
		<div class="dg-box scene-flow-row" data-el="f-add">
			<span class="dg-step-num">3</span>
			<span><code class="dg-code">{c.saldo} += {c.monto};</code> · {isEs ? 'actualiza el campo' : 'updates the field'}</span>
		</div>
		<div class="dg-box dg-box--sage scene-flow-row" data-el="f-overflow">
			<span class="dg-step-num">4</span>
			<span><code class="dg-code">{c.saldo} &lt; {c.anterior}</code> · {isEs ? 'desbordamiento: se restaura' : 'overflow: it is restored'}</span>
		</div>
	</div>

	<!-- 2. Scope: block-scoped variable -->
	<div slot="scene" data-scene="blockscope" class="scene-blockscope">
		<div class="dg-nest dg-nest--sage" data-el="bk-outer">
			<p class="dg-label dg-label--sage">{isEs ? 'Método' : 'Method'} · <code>{names.edad}</code> visible</p>
			<div class="dg-nest dg-nest--accent" data-el="bk-inner">
				<p class="dg-label"><code>if ({names.edad} &gt;= 18) {'{'}</code></p>
				<code class="dg-code">String {c.mensaje} = "{c.permitido}";</code>
			</div>
		</div>
		<div class="dg-row dg-row--center">
			<span class="dg-chip dg-chip--ink" data-el="bk-fail">
				<svg class="dg-icon scene-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--color-accent-300)">
					<path d="M18 6 6 18" /><path d="m6 6 12 12" />
				</svg>
				{isEs ? `Fuera del bloque: ${c.mensaje} no se ve` : `Outside the block: ${c.mensaje} is not visible`}
			</span>
		</div>
	</div>

	<!-- 2. Scope: definite assignment -->
	<div slot="scene" data-scene="definite" class="scene-definite">
		<div class="dg-grid-2">
			<div class="dg-box dg-box--accent" data-el="df-bad">
				<p class="dg-label">
					<svg class="dg-icon scene-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M18 6 6 18" /><path d="m6 6 12 12" />
					</svg>
					{isEs ? 'No compila' : 'Does not compile'}
				</p>
				<code class="dg-code">int {c.resultado};</code>
				<p class="dg-sub">{isEs ? 'Leerla: quizá no fue inicializada' : 'Reading it: it may not be initialized'}</p>
			</div>
			<div class="dg-box dg-box--sage" data-el="df-good">
				<p class="dg-label dg-label--sage">
					<svg class="dg-icon dg-icon--sage scene-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M20 6 9 17l-5-5" />
					</svg>
					{isEs ? 'Compila' : 'Compiles'}
				</p>
				<code class="dg-code">int {c.seguro} = 0;</code>
				<p class="dg-sub">{isEs ? 'Solo si 0 es un valor válido' : 'Only if 0 is a valid value'}</p>
			</div>
		</div>
		<div class="dg-banner" data-el="df-note">{isEs ? 'Si falta un dato obligatorio: validalo y avisá' : 'If a required value is missing: validate and report it'}</div>
	</div>

	<!-- 3. Primitive types -->
	<div slot="scene" data-scene="primitives" class="scene-primitives">
		<div class="scene-prim-grid">
			<div class="dg-box dg-box--center" data-el="p-byte">
				<code class="dg-code">byte</code>
				<p class="dg-title">8 bits</p>
				<p class="dg-sub">-128 … 127</p>
			</div>
			<div class="dg-box dg-box--center" data-el="p-short">
				<code class="dg-code">short</code>
				<p class="dg-title">16 bits</p>
				<p class="dg-sub">-32,768 … 32,767</p>
			</div>
			<div class="dg-box dg-box--center" data-el="p-int">
				<code class="dg-code">int</code>
				<p class="dg-title">32 bits</p>
				<p class="dg-sub">±2,147,483,647</p>
			</div>
			<div class="dg-box dg-box--center" data-el="p-long">
				<code class="dg-code">long</code>
				<p class="dg-title">64 bits</p>
				<p class="dg-sub">10000000000L</p>
			</div>
			<div class="dg-box dg-box--accent dg-box--center" data-el="p-float">
				<code class="dg-code">float</code>
				<p class="dg-title">32 bits</p>
				<p class="dg-sub">3.14f</p>
			</div>
			<div class="dg-box dg-box--accent dg-box--center" data-el="p-double">
				<code class="dg-code">double</code>
				<p class="dg-title">64 bits</p>
				<p class="dg-sub">3.14159265</p>
			</div>
			<div class="dg-box dg-box--sage dg-box--center" data-el="p-boolean">
				<code class="dg-code">boolean</code>
				<p class="dg-title">true / false</p>
				<p class="dg-sub">{isEs ? 'verdadero o falso' : 'true or false'}</p>
			</div>
			<div class="dg-box dg-box--sage dg-box--center" data-el="p-char">
				<code class="dg-code">char</code>
				<p class="dg-title">16 bits</p>
				<p class="dg-sub">'A' · Unicode</p>
			</div>
		</div>
	</div>

	<!-- 3. Stack and heap (motion canvas, viewBox 1600 x 660) -->
	<div slot="scene" data-scene="memory" data-motion class="scene-memory">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<!-- Editor with the three declarations -->
				<g data-el="editor">
					<rect class="mg-card mg-card--ink" x="40" y="60" width="560" height="250" rx="18" />
					<path class="mg-bar" d="M58 60H582A18 18 0 0 1 600 78V98H40V78A18 18 0 0 1 58 60Z" />
					<circle class="mg-dot" cx="64" cy="79" r="6" />
					<circle class="mg-dot mg-dot--2" cx="84" cy="79" r="6" />
					<circle class="mg-dot mg-dot--3" cx="104" cy="79" r="6" />
					<text class="mg-text mg-text--bar" x="126" y="84">Main.java</text>
					{
						memoryLines.map((line) => (
							<>
								<text class="mg-mono mg-gutter" x="76" y={line.y} text-anchor="end">
									{line.number}
								</text>
								<text class="mg-mono" x="100" y={line.y} data-el={`code-${line.number}`} set:html={line.html} />
							</>
						))
					}
				</g>

				<!-- Stack -->
				<g data-el="stack">
					<rect class="mg-card" x="700" y="60" width="400" height="440" rx="20" />
					<text class="mg-heading" x="724" y="104">Stack</text>
					<text class="mg-text mg-text--muted" x="1076" y="104" text-anchor="end">{isEs ? 'pila' : 'call stack'}</text>
				</g>
				<g data-el="slot-edad">
					<rect class="mg-card mg-card--accent" x="720" y="130" width="360" height="100" rx="14" />
					<text class="mg-heading" x="744" y="176">{names.edad}</text>
					<text class="mg-text mg-text--muted" x="744" y="204">int</text>
				</g>
				<g data-el="slot-precio">
					<rect class="mg-card mg-card--accent" x="720" y="250" width="360" height="100" rx="14" />
					<text class="mg-heading" x="744" y="296">{names.precio}</text>
					<text class="mg-text mg-text--muted" x="744" y="324">double</text>
				</g>
				<g data-el="slot-nombre">
					<rect class="mg-card mg-card--sage" x="720" y="370" width="360" height="100" rx="14" />
					<text class="mg-heading" x="744" y="416">{names.nombre}</text>
					<text class="mg-text mg-text--muted" x="744" y="444">String</text>
				</g>
				<rect data-anchor="a-edad" x="935" y="155" width="50" height="50" fill="none" />
				<rect data-anchor="a-precio" x="935" y="275" width="50" height="50" fill="none" />

				<!-- Heap -->
				<g data-el="heap">
					<rect class="mg-card" x="1200" y="60" width="360" height="440" rx="20" />
					<text class="mg-heading" x="1224" y="104">Heap</text>
					<text class="mg-text mg-text--muted" x="1536" y="104" text-anchor="end">{isEs ? 'montón' : 'object memory'}</text>
				</g>
				<g data-el="obj-string">
					<rect class="mg-card mg-card--sage" x="1230" y="360" width="300" height="120" rx="18" />
					<text class="mg-text mg-text--muted" x="1254" y="396">String</text>
