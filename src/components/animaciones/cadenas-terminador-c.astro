---
/**
 * Scene for "The string and its terminator" (lesson c/cadenas-de-caracteres-y-operaciones,
 * order: 21), a short film played on one persistent motion canvas. The captions and
 * cues live in `src/data/animations/cadenas-terminador-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay with the five
 * programs of the lesson the film runs (capacity and length of `saludo`, reading a line
 * with `fgets`, the `strcpy` that does not fit, the safe copy with `snprintf` and the
 * comparison with `strcmp`); a bar slides to the line being executed, the failing line
 * is marked and the real output is typed in the console below. The viewport on the
 * right holds the camera: an isometric row of `char` cells with the index on the front
 * edge and the character on top. The same row holds every array of the film. The
 * terminator `'\0'` is violet, what gets in the way (the newline, the bytes written
 * past the bound) is magenta, and the light blue particle is the execution flow. One
 * module per instruction stands in front of the cells, labelled with its editor line.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/cadenas-terminador-c';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── The five programs shown in the editor ─────────────────────────────────
// They are the lesson's own examples, with its identifiers and texts localized like
// it does. Long calls are wrapped so every line fits the editor.
const id = {
	saludo: t('saludo', 'greeting'),
	hola: t('Hola', 'Code'),
	texto: t('Texto', 'Text'),
	capacidad: t('Capacidad', 'Capacity'),
	longitud: t('Longitud', 'Length'),
	linea: t('linea', 'line'),
	frase: t('Escribe una frase: ', 'Type a sentence: '),
	noLeer: t('No se pudo leer.', 'Could not read.'),
	leiste: t('Leíste', 'You typed'),
	caracteres: t('caracteres', 'characters'),
	destino: t('destino', 'destination'),
	bienvenido: t('Bienvenido', 'Welcome'),
	escritos: t('escritos', 'written'),
	noEntra: t('No entra completo; se guardó', 'It does not fit; stored'),
	clave: t('clave', 'key'),
	secreto: t('secreto', 'secret'),
	correcta: t('Clave correcta', 'Correct key'),
};

const programCapacity = [
	'#include <stdio.h>',
	'#include <string.h>',
	'',
	'int main(void) {',
	`    char ${id.saludo}[10] = "${id.hola}";`,
	'',
	`    printf("${id.texto}: %s\\n", ${id.saludo});`,
	`    printf("${id.capacidad}: %zu\\n", sizeof ${id.saludo});`,
	`    printf("${id.longitud}: %zu\\n", strlen(${id.saludo}));`,
	'    return 0;',
	'}',
].join('\n');

const programLine = [
	'#include <stdio.h>',
	'#include <string.h>',
	'',
	'int main(void) {',
	`    char ${id.linea}[50];`,
	'',
	`    printf("${id.frase}");`,
	`    if (fgets(${id.linea}, sizeof ${id.linea}, stdin) == NULL) {`,
	`        printf("${id.noLeer}\\n");`,
	'        return 1;',
	'    }',
	`    ${id.linea}[strcspn(${id.linea}, "\\n")] = '\\0';`,
	`    printf("${id.leiste} \\"%s\\" (%zu ${id.caracteres})\\n",`,
	`           ${id.linea}, strlen(${id.linea}));`,
	'    return 0;',
	'}',
].join('\n');

const programOverflow = [
	'#include <string.h>',
	'',
	'int main(void) {',
	`    char ${id.destino}[6];`,
	`    strcpy(${id.destino}, "${id.bienvenido}");`,
	'    return 0;',
	'}',
].join('\n');

const programSafe = [
	'#include <stdio.h>',
	'',
	'int main(void) {',
	`    char ${id.destino}[6];`,
	'',
	`    int ${id.escritos} = snprintf(${id.destino}, sizeof ${id.destino},`,
	`        "%s", "${id.bienvenido}");`,
	`    if (${id.escritos} < 0 || (size_t)${id.escritos} >= sizeof ${id.destino}) {`,
	`        printf("${id.noEntra} \\"%s\\"\\n",`,
	`               ${id.destino});`,
	'    }',
	'    return 0;',
	'}',
].join('\n');

const programCompare = [
	'#include <stdio.h>',
	'#include <string.h>',
	'',
	'int main(void) {',
	`    char ${id.clave}[] = "${id.secreto}";`,
	'',
	`    if (strcmp(${id.clave}, "${id.secreto}") == 0) {`,
	`        printf("${id.correcta}\\n");`,
	'    }',
	'    return 0;',
	'}',
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const linesOf = (source: string) =>
	highlightCode(source, 'c').map((html, index) => ({
		n: index + 1,
		html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
	}));
const pages = [
	{ el: 'ea', file: t('saludo.c', 'greeting.c'), lines: linesOf(programCapacity), typed: true },
	{ el: 'eb', file: t('linea.c', 'line.c'), lines: linesOf(programLine), typed: false },
	{ el: 'ec', file: t('desborde.c', 'overflow.c'), lines: linesOf(programOverflow), typed: false },
	{ el: 'ed', file: t('copia.c', 'copy.c'), lines: linesOf(programSafe), typed: false },
	{ el: 'ee', file: t('clave.c', 'key.c'), lines: linesOf(programCompare), typed: false },
];
const MAX_LINES = Math.max(...pages.map((page) => page.lines.length));

// What each program prints (compiled with cc -std=c23 -Wall -Wextra -Wpedantic). The
// line read by `fgets` is typed by the user after the prompt: `Ana Paz`.
const INPUT = 'Ana Paz';
const outputs = [
	{ id: 'oa-1', row: 0, col: 0, text: `${id.texto}: ${id.hola}` },
	{ id: 'oa-2', row: 1, col: 0, text: `${id.capacidad}: 10` },
	{ id: 'oa-3', row: 2, col: 0, text: `${id.longitud}: 4` },
	{ id: 'ob-1', row: 0, col: 0, text: id.frase.trimEnd() },
	{ id: 'ob-in', row: 0, col: id.frase.length, text: INPUT },
	{ id: 'ob-2', row: 1, col: 0, text: `${id.leiste} "${INPUT}" (${INPUT.length} ${id.caracteres})` },
	{ id: 'od-1', row: 0, col: 0, text: `${id.noEntra} "${id.bienvenido.slice(0, 5)}"` },
	{ id: 'oe-1', row: 0, col: 0, text: id.correcta },
];

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 70;
const LINE_H = 20;
const CHAR_W = 7.8;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 4.5;
const CONSOLE_TOP = lineTop(MAX_LINES + 1) + 10;
const outY = (row: number) => CONSOLE_TOP + 48 + row * 22;

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up. The cells of every array lie on
// the line v = 0; the literal compared in the last scene lies behind, on v = -1.15; the
// modules stand in a row in front of the first cells.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 56;
const EY = 32;
const ORIGIN = { x: 430, y: 250 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');
const line = (points: Point[]) => `M${poly(points).replaceAll(' ', ' L')}`;

/** A box standing at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const leftCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		left,
		faceMatrix: `matrix(0.866 0.5 0 1 ${leftCenter.x} ${leftCenter.y})`,
	};
}
type Tone = 'flow' | 'violet' | 'magenta';

// The row of char cells. Index i sits at u = cellU(i); the literal of scene 6 lies behind.
const CELL_H = 16;
const HALF = 0.36;
const ROW_K = -1.15;
const cellU = (index: number) => -4.4 + index * 0.8;
const cellAt = (index: number, v = 0) => slab(cellU(index), v, HALF, HALF, CELL_H);
const ROW = Array.from({ length: 12 }, (_, index) => ({ index, g: cellAt(index) }));
const TAIL = cellAt(12);
const NEIGHBOURS = [6, 7, 8, 9, 10].map((index) => cellAt(index));
const PLATE = slab(0.35, 0.25, 5.75, 1.95, 12, -12);
const C = (index: number) => cellAt(index).center;
const K = (index: number) => cellAt(index, ROW_K).center;

// What a cell shows on top. `\0` and `\n` are drawn as the lesson writes them.
type Kind = 'char' | 'term' | 'dim' | 'newline' | 'spill';
type Glyph = { id: string; index: number; text: string; kind: Kind; v?: number };
const shown = (ch: string) => (ch === ' ' ? '␣' : ch);
const letters = (prefix: string, text: string, from = 0): Glyph[] =>
	[...text].map((ch, offset) => ({ id: `${prefix}-${from + offset}`, index: from + offset, text: shown(ch), kind: 'char' }));

// Scene 1-2: saludo[10] = "Hola" (four letters, the terminator, and the rest also '\0').
const HOLA = id.hola;
// Scene 3: linea[50] after fgets reads "Ana Paz" and Enter.
const NL_AT = INPUT.length;
// Scene 4: strcpy writes the whole literal; scene 5: snprintf keeps 5 letters and '\0'.
const SOURCE = id.bienvenido;
const SPILL = [...SOURCE.slice(6)];
const glyphs: Glyph[] = [
	...letters('g-h', HOLA),
	{ id: 'g-h-4', index: 4, text: '\\0', kind: 'term' },
	...[5, 6, 7, 8, 9].map((index): Glyph => ({ id: `g-h-${index}`, index, text: '\\0', kind: 'dim' })),
	...letters('g-f', INPUT),
	{ id: `g-f-${NL_AT}`, index: NL_AT, text: '\\n', kind: 'newline' },
	{ id: `g-f-${NL_AT + 1}`, index: NL_AT + 1, text: '\\0', kind: 'term' },
	{ id: `g-f-${NL_AT}z`, index: NL_AT, text: '\\0', kind: 'term' },
	...letters('g-o', SOURCE.slice(0, 6)),
	...SPILL.map((ch, offset): Glyph => ({ id: `sp-${offset}`, index: 6 + offset, text: ch, kind: 'spill' })),
	{ id: 'sp-end', index: 6 + SPILL.length, text: '\\0', kind: 'spill' },
	...letters('g-s', SOURCE.slice(0, 5)),
	{ id: 'g-s-5', index: 5, text: '\\0', kind: 'term' },
];
// The script addresses four spilled letters (Spanish spills `nido`); with a shorter
// literal the missing ones are empty groups, so every cue still has its target.
const emptySpill = [0, 1, 2, 3].filter((offset) => offset >= SPILL.length).map((offset) => `sp-${offset}`);

// Scene 6: clave[] = "secreto" and the literal "secreto", compared pair by pair.
const KEY = [...id.secreto];
const keyCells = [...KEY, '\\0'].map((text, index) => ({ index, text, kind: (text === '\\0' ? 'term' : 'char') as Kind }));
const emptyPairs = [0, 1, 2, 3, 4, 5, 6].filter((index) => index >= KEY.length).map((index) => `kq-${index}`);
const MID_K = ROW_K / 2;

// Brackets: capacity behind the row, length in front of it.
type Bracket = { id: string; from: number; to: number; v: number; label: string; tone: Tone };
const brackets: Bracket[] = [
	{ id: 'cap-h', from: 0, to: 9, v: -0.62, label: `${t('capacidad', 'capacity')} 10 = sizeof ${id.saludo}`, tone: 'flow' },
	{ id: 'len-h', from: 0, to: 3, v: 0.62, label: `${t('longitud', 'length')} 4 = strlen(${id.saludo})`, tone: 'flow' },
	{ id: 'cap-d', from: 0, to: 5, v: -0.62, label: `${t('capacidad', 'capacity')} 6 = sizeof ${id.destino}`, tone: 'flow' },
];
const bracketOf = (item: Bracket) => {
	const a = pt(cellU(item.from) - HALF, item.v);
	const b = pt(cellU(item.to) + HALF, item.v);
	const side = item.v < 0 ? -0.3 : 0.32;
	return { a, b, label: pt((cellU(item.from) + cellU(item.to)) / 2, item.v + side) };
};

// Paths along the front of the cells: printf reading, strcspn searching, strcmp comparing.
const walk = (to: number, v: number) => line([pt(cellU(0) - HALF, v), pt(cellU(to), v)]);
const flowlines = [
	{ id: 'fl-read', d: walk(4, 0.5) },
	{ id: 'fl-scan', d: walk(NL_AT, 0.5) },
	{ id: 'fl-cmp', d: walk(KEY.length, MID_K) },
];

// Modules: one per instruction, in a row in front of the cells, labelled with the line.
// The ids carry the program (a to e) and the editor line.
const moduleAt = (slot: number) => slab(-4.3 + slot * 0.62, 1.7, 0.2, 0.2, 16);
const rows: [string, Tone][][] = [
	[
		['a5', 'flow'],
		['a7', 'flow'],
		['a8', 'flow'],
		['a9', 'flow'],
	],
	[
		['b5', 'flow'],
		['b7', 'flow'],
		['b8', 'flow'],
		['b12', 'violet'],
		['b13', 'flow'],
	],
	[
		['c4', 'flow'],
		['c5', 'magenta'],
	],
	[
		['d4', 'flow'],
		['d6', 'violet'],
		['d8', 'flow'],
		['d9', 'flow'],
	],
	[
		['e5', 'flow'],
		['e7', 'violet'],
		['e8', 'flow'],
	],
];
const modules = rows.flatMap((row) => row.map(([key, tone], slot) => ({ key, line: key.slice(1), tone, g: moduleAt(slot) })));

// Where the particle stops and the camera shots.
const anchors = [
	...modules.map((module) => ({ id: `a-m${module.key}`, ...lift(module.g.center, 16) })),
	...ROW.map((cell) => ({ id: `a-c${cell.index}`, ...cell.g.center })),
];
const at = (key: string) => anchors.find((anchor) => anchor.id === key) ?? { x: 0, y: 0 };

const shots = [
	{ id: 'shot-all', cx: 430, cy: 270, s: 0.74 },
	{ id: 'shot-row', cx: 330, cy: 215, s: 1.0 },
	{ id: 'shot-word', cx: 235, cy: 150, s: 1.42 },
	{ id: 'shot-line', cx: 390, cy: 250, s: 0.82 },
	{ id: 'shot-over', cx: 360, cy: 230, s: 0.92 },
	{ id: 'shot-cmp', cx: 315, cy: 160, s: 1.0 },
].map((item) => ({
	id: item.id,
	x: round(item.cx - 640 / item.s),
	y: round(item.cy - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = { id: string; text: string; x: number; y: number; align: 'start' | 'end' | 'middle'; tone: 'plain' | Tone; mono?: boolean };
const chips: Chip[] = [
	{ id: 'ch-term', text: `'\\0' = ${t('terminador', 'terminator')}`, x: C(4).x + 30, y: C(4).y - 62, align: 'start', tone: 'violet', mono: true },
	{ id: 'ch-rule', text: t('longitud 4 + 1 ≤ capacidad 10', 'length 4 + 1 ≤ capacity 10'), x: C(7).x + 20, y: C(7).y - 84, align: 'start', tone: 'flow' },
	{ id: 'ch-cap', text: t("capacidad 50: hasta 49 + '\\0'", "capacity 50: up to 49 + '\\0'"), x: TAIL.center.x, y: TAIL.center.y + 70, align: 'middle', tone: 'flow' },
	{ id: 'ch-nl', text: `'\\n' ${t('del Enter', 'from Enter')}`, x: C(NL_AT).x + 30, y: C(NL_AT).y - 62, align: 'start', tone: 'magenta', mono: true },
	{ id: 'ch-pos', text: `strcspn(${id.linea}, "\\n") = ${NL_AT}`, x: C(NL_AT).x, y: C(NL_AT).y - 104, align: 'middle', tone: 'violet', mono: true },
	{ id: 'ch-nocap', text: t('strcpy no conoce la capacidad', 'strcpy does not know the capacity'), x: C(2).x, y: C(2).y - 74, align: 'middle', tone: 'magenta' },
	{ id: 'ch-ub', text: t('fuera del límite: comportamiento indefinido', 'past the bound: undefined behavior'), x: C(8).x + 20, y: C(8).y + 78, align: 'middle', tone: 'magenta' },
	{ id: 'ch-ret', text: `${id.escritos} = ${SOURCE.length} >= sizeof ${id.destino}`, x: C(3).x, y: C(3).y - 76, align: 'middle', tone: 'violet', mono: true },
	{ id: 'ch-eq', text: t('== compara arreglos, no letras', '== compares arrays, not letters'), x: K(3).x, y: K(3).y - 60, align: 'middle', tone: 'plain' },
	{ id: 'ch-zero', text: `strcmp(${id.clave}, "${id.secreto}") == 0`, x: K(3).x, y: K(3).y - 60, align: 'middle', tone: 'violet', mono: true },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.9) + 24);
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

const labels = [
	{ id: 'lb-saludo', text: `char ${id.saludo}[10]` },
	{ id: 'lb-linea', text: `char ${id.linea}[50]` },
	{ id: 'lb-destino', text: `char ${id.destino}[6]` },
];
const LABEL = { x: ROW[0].g.left.x - 10, y: ROW[0].g.left.y + 4 };
const KEY_LABEL = { x: cellAt(0, ROW_K).left.x - 10, y: cellAt(0, ROW_K).left.y + 4 };

const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="ct-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="ct-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="ct-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="ct-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="ct-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="ct-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the char cells, seen through the camera -->
			<g clip-path="url(#ct-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#ct-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#ct-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- The memory of main: a floor plate -->
						<g data-el="plate-main">
							<polygon class="xj-plate-shadow" points={PLATE.base} transform="translate(12 18)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={PLATE.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={PLATE.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={PLATE.top} fill="url(#ct-g-floor)"></polygon>
							<text class="xj-area-label" transform={PLATE.faceMatrix} text-anchor="middle" y="4">main</text>
						</g>

						<!-- Brackets: the capacity behind the row, the length in front of it -->
						{
							brackets.map((item) => {
								const b = bracketOf(item);
								return (
									<g data-el={item.id} class:list={['xj-bracket', `xj-bracket--${item.tone}`]}>
										<path class="mg-stroke" pathLength="1" d={`M${b.a.x} ${b.a.y} L${b.b.x} ${b.b.y}`} />
										<path d={`M${b.a.x} ${b.a.y - 7} V${b.a.y + 7} M${b.b.x} ${b.b.y - 7} V${b.b.y + 7}`} />
										<text transform={`matrix(0.866 0.5 0 1 ${b.label.x} ${b.label.y})`} text-anchor="middle" y="4">
											{item.label}
										</text>
									</g>
								);
							})
						}

						<!-- Reading paths along the front of the cells -->
						{
							flowlines.map((item) => (
								<g data-el={item.id} class="xj-flowline">
									<path class="mg-stroke xj-flowline-halo" pathLength="1" d={item.d} />
									<path class="mg-stroke xj-flowline-core" pathLength="1" d={item.d} />
								</g>
							))
						}

						<!-- The literal compared in scene 6, behind the row -->
						<g data-el="arr-lit">
							{
								keyCells.map((cell) => {
									const g = cellAt(cell.index, ROW_K);
									return (
										<>
											<polygon class="xj-shadow" points={g.base} transform="translate(6 8)" />
											<polygon class="xj-face xj-face--l" points={g.leftFace} />
											<polygon class="xj-face xj-face--r" points={g.rightFace} />
											<polygon class="xj-face xj-face--t" points={g.top} fill="url(#ct-g-top)" />
											{cell.kind === 'term' && <polygon class="xj-lit-top xj-lit-top--violet" points={g.top} />}
											<text class="xj-face-text" transform={g.faceMatrix} text-anchor="middle" y="4">
												{cell.index}
											</text>
											<text class:list={['xj-glyph', `xj-glyph--${cell.kind}`]} x={g.center.x} y={g.center.y + 6} text-anchor="middle">
												{cell.text}
											</text>
										</>
									);
								})
							}
							<text class="xj-area-label" x={KEY_LABEL.x} y={KEY_LABEL.y} text-anchor="end">{`"${id.secreto}"`}</text>
						</g>

						<!-- Memory next to destino: it does not belong to the array -->
						<g data-el="nb" class="xj-ghost">
							{
								NEIGHBOURS.map((g) => (
									<>
										<polygon points={g.top} />
										<polygon points={g.leftFace} />
										<polygon points={g.rightFace} />
									</>
								))
							}
							<text class="xj-area-label xj-area-label--dim" x={NEIGHBOURS[2].center.x + 40} y={NEIGHBOURS[2].center.y + 58} text-anchor="middle">
								{t('memoria vecina', 'neighbouring memory')}
							</text>
						</g>

						<!-- The rest of linea: 50 cells, only the first ones drawn -->
						<g data-el="tail" class="xj-ghost">
							<polygon points={TAIL.top}></polygon>
							<polygon points={TAIL.leftFace}></polygon>
							<polygon points={TAIL.rightFace}></polygon>
							<text class="xj-face-text" transform={TAIL.faceMatrix} text-anchor="middle" y="4">… 49</text>
						</g>

						<!-- The cells: index on the front edge, character on top -->
						{
							ROW.map((cell) => (
								<g data-el={`c-${cell.index}`}>
									<polygon class="xj-shadow" points={cell.g.base} transform="translate(6 8)" />
									<polygon class="xj-face xj-face--l" points={cell.g.leftFace} />
									<polygon class="xj-face xj-face--r" points={cell.g.rightFace} />
									<polygon class="xj-face xj-face--t" points={cell.g.top} fill="url(#ct-g-top)" />
									<text class="xj-face-text" transform={cell.g.faceMatrix} text-anchor="middle" y="4">
										{cell.index}
									</text>
								</g>
							))
						}

						<!-- clave[] in scene 6, on the same row -->
						<g data-el="arr-clave">
							{
								keyCells.map((cell) => {
									const g = cellAt(cell.index);
									return (
										<>
											<polygon class="xj-shadow" points={g.base} transform="translate(6 8)" />
											<polygon class="xj-face xj-face--l" points={g.leftFace} />
											<polygon class="xj-face xj-face--r" points={g.rightFace} />
											<polygon class="xj-face xj-face--t" points={g.top} fill="url(#ct-g-top)" />
											{cell.kind === 'term' && <polygon class="xj-lit-top xj-lit-top--violet" points={g.top} />}
											<text class="xj-face-text" transform={g.faceMatrix} text-anchor="middle" y="4">
												{cell.index}
											</text>
											<text class:list={['xj-glyph', `xj-glyph--${cell.kind}`]} x={g.center.x} y={g.center.y + 6} text-anchor="middle">
												{cell.text}
											</text>
										</>
									);
								})
							}
							<text class="xj-area-label" x={LABEL.x} y={LABEL.y} text-anchor="end">{`char ${id.clave}[]`}</text>
						</g>

						{
							labels.map((item) => (
								<text data-el={item.id} class="xj-area-label" x={LABEL.x} y={LABEL.y} text-anchor="end">
									{item.text}
								</text>
							))
						}

						<!-- What each cell holds: one group per character, swapped by the cues -->
						{
							glyphs.map((glyph) => {
								const g = cellAt(glyph.index);
								return (
									<g data-el={glyph.id}>
										{glyph.kind === 'term' && <polygon class="xj-lit-top xj-lit-top--violet" points={g.top} />}
										{glyph.kind === 'newline' && <polygon class="xj-lit-top xj-lit-top--magenta" points={g.top} />}
										{glyph.kind === 'spill' && (
											<>
												<polygon class="xj-lit-halo xj-lit-halo--magenta" points={g.top} />
												<polygon class="xj-lit-top xj-lit-top--magenta" points={g.top} />
											</>
										)}
										<text class:list={['xj-glyph', `xj-glyph--${glyph.kind}`]} x={g.center.x} y={g.center.y + 6} text-anchor="middle">
											{glyph.text}
										</text>
									</g>
								);
							})
						}
						{emptySpill.map((key) => <g data-el={key} />)}

						<!-- Cells read or counted by the flow -->
						{
							ROW.map((cell) => (
								<g data-el={`lit-${cell.index}`} class="xj-lit">
									<polygon class="xj-lit-halo" points={cell.g.top} />
									<polygon class="xj-lit-top xj-lit-top--soft" points={cell.g.top} />
								</g>
							))
						}
						{
							[1, 2, 3, 4].map((count) => (
								<g data-el={`cnt-${count}`} class="xj-count">
									<circle cx={C(count - 1).x} cy={C(count - 1).y - 38} r="12" />
									<text x={C(count - 1).x} y={C(count - 1).y - 33.5} text-anchor="middle">
										{count}
									</text>
								</g>
							))
						}

						<!-- strcmp: each pair of characters compared, then the two terminators -->
						{
							keyCells.map((cell) => {
								const front = cellAt(cell.index);
								const back = cellAt(cell.index, ROW_K);
								const mid = pt(cellU(cell.index), MID_K, CELL_H);
								return (
									<g data-el={cell.kind === 'term' ? 'kq-end' : `kq-${cell.index}`} class:list={['xj-lit', cell.kind === 'term' && 'xj-lit--violet']}>
										<polygon class="xj-lit-halo" points={back.top} />
										<polygon class="xj-lit-top xj-lit-top--soft" points={back.top} />
										<polygon class="xj-lit-halo" points={front.top} />
										<polygon class="xj-lit-top xj-lit-top--soft" points={front.top} />
										<text class="xj-pair" x={mid.x} y={mid.y + 5} text-anchor="middle">=</text>
									</g>
								);
							})
						}
						{emptyPairs.map((key) => <g data-el={key} />)}

						<!-- Instruction modules: one per instruction, labelled with its editor line -->
						{
							modules.map((module) => (
								<>
									<g data-el={`m-${module.key}`} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#ct-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
									<g data-el={`on-${module.key}`} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
										<polygon class="xj-lit-halo" points={module.g.top} />
										<polygon class="xj-lit-top" points={module.g.top} />
										<polygon class="xj-lit-side" points={module.g.leftFace} />
										<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
								</>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									<text class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'} x={chipLeft(chip) + chipWidth(chip) / 2} y={chip.y + 4.5} text-anchor="middle">
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- The execution flow -->
						<g data-el="px" class="xj-particle" data-x={at('a-ma5').x} data-y={at('a-ma5').y}>
							<circle r="20" fill="url(#ct-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="470" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<rect class="xj-legend-term" x={VP.x + 180} y={LEGEND_Y - 7} width="20" height="14" rx="4"></rect>
				<text x={VP.x + 208} y={LEGEND_Y + 4}>{t("Terminador '\\0'", "Terminator '\\0'")}</text>
				<rect class="xj-legend-cell" x={VP.x + 340} y={LEGEND_Y - 7} width="20" height="14" rx="4"></rect>
				<text x={VP.x + 368} y={LEGEND_Y + 4}>{t('Celda char', 'Char cell')}</text>
			</g>

			<!-- EDITOR: the program, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<!-- The failing line: strcpy writes past the capacity -->
				<rect data-el="err-c5" class="xj-bar--magenta" x={BAR.x} y={lineTop(5)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(1)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<!-- The five programs: the first is typed as the film begins, the others replace it -->
				{
					pages.map((page) => (
						<g data-el={page.el} data-base={page.typed ? 'shown' : undefined} class="xj-code">
							<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>
								{page.file}
							</text>
							{page.lines.map((row) =>
								page.typed ? (
									<g data-el={`${page.el}-${row.n}`}>
										<text class="xj-gutter" x={GUTTER_X} y={lineBase(row.n)} text-anchor="end">
											{row.n}
										</text>
										<text class="xj-mono" x={CODE_X} y={lineBase(row.n)} xml:space="preserve" set:html={row.html} />
									</g>
								) : (
									<>
										<text class="xj-gutter" x={GUTTER_X} y={lineBase(row.n)} text-anchor="end">
											{row.n}
										</text>
										<text class="xj-mono" x={CODE_X} y={lineBase(row.n)} xml:space="preserve" set:html={row.html} />
									</>
								),
							)}
						</g>
					))
				}

				<!-- Console: what the program prints, and the line the user types -->
				{
					outputs.map((row) => (
						<text data-el={row.id} class:list={['xj-out', row.id === 'ob-in' && 'xj-out--in']} x={ED.x + 20 + row.col * CHAR_W} y={outY(row.row)} xml:space="preserve">
							{row.text}
						</text>
					))
				}
				{Array.from({ length: MAX_LINES }, (_, index) => <circle data-anchor={`ln-${index + 1}`} cx={BAR_CX} cy={lineMid(index + 1)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow, magenta for the problem (the newline, the bytes written
	   past the bound) and violet for the terminator that closes every string.
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='cadenas-terminador-c']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='cadenas-terminador-c'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='cadenas-terminador-c'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='cadenas-terminador-c'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-term {
		fill: var(--xj-violet);
		fill-opacity: 0.45;
		stroke: var(--xj-violet-soft);
		stroke-width: 1.5;
	}

	.xj-legend-cell {
		fill: var(--xj-steel);
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
	}

	/* Plates, cells and modules */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-area-label {
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.03em;
		fill: var(--xj-mist);
	}

	.xj-area-label--dim {
		fill: var(--xj-dim);
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-face-text {
		font-family: var(--font-body);
		font-size: 10.5px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face-text--on {
		fill: var(--xj-ink);
	}

	.xj-ghost polygon {
		fill: var(--xj-panel);
		fill-opacity: 0.6;
		stroke: var(--xj-dim);
		stroke-width: 1.5;
		stroke-dasharray: 5 5;
		stroke-linejoin: round;
	}

	/* Characters on top of the cells */
	.xj-glyph {
		font-family: monospace;
		font-size: 17px;
		font-weight: 700;
		fill: var(--xj-white);
	}

	.xj-glyph--term {
		fill: var(--xj-violet-soft);
	}

	.xj-glyph--dim {
		fill: var(--xj-dim);
	}

	.xj-glyph--newline,
	.xj-glyph--spill {
		fill: var(--xj-magenta-soft);
	}

	.xj-pair {
		font-family: monospace;
		font-size: 16px;
		font-weight: 700;
		fill: var(--xj-lit-soft);
	}

	.xj-count circle {
		fill: var(--xj-panel);
		stroke: var(--xj-flow);
		stroke-width: 2;
	}

	.xj-count text {
		font-family: monospace;
		font-size: 13px;
		font-weight: 700;
		fill: var(--xj-flow-soft);
	}

	/* Lit states */
	.xj-lit {
		--xj-lit: var(--xj-flow);
		--xj-lit-soft: var(--xj-flow-soft);
	}

	.xj-lit--violet {
		--xj-lit: var(--xj-violet);
		--xj-lit-soft: var(--xj-violet-soft);
	}

	.xj-lit--magenta {
		--xj-lit: var(--xj-magenta);
		--xj-lit-soft: var(--xj-magenta-soft);
	}

	.xj-lit-halo {
		fill: none;
		stroke: var(--xj-lit, var(--xj-flow));
		stroke-width: 12;
		stroke-opacity: 0.22;
		stroke-linejoin: round;
	}

	.xj-lit-halo--magenta {
		stroke: var(--xj-magenta);
	}

	.xj-lit-top {
		fill: var(--xj-lit, var(--xj-flow));
		fill-opacity: 0.85;
		stroke: var(--xj-lit-soft, var(--xj-flow-soft));
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-lit-top--soft {
		fill-opacity: 0.18;
	}

	.xj-lit-top--violet {
