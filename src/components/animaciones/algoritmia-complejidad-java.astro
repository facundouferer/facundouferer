---
/**
 * Scene for "The journey of an algorithm: contract, invariant and O(log n)" (lesson java/06),
 * a short film played on one persistent motion canvas. The captions and cues live in
 * `src/data/animations/algoritmia-complejidad-java.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: it shows
 * the Java source (`busquedaLineal` on page A, `busquedaBinaria` on page B) and
 * the cues slide a bar over the line being executed. The viewport on the right
 * holds the camera: an isometric system where `main` is an upper platform, the
 * sorted array `ordenados` is a row of seven indexed modules (`[2, 5, 8, 12, 16, 23, 38]`),
 * a light blue particle is the execution flow, magenta marks the linear O(n) cost
 * trail and sentinel checks, and violet marks the loop invariant and O(log n)
 * binary search halving.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/algoritmia-complejidad-java';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── Source code shown in the editor ───────────────────────────────────────
// Identifiers and string literals are localized the same way lesson 6 does.
const names = {
	file: t('Busqueda.java', 'Search.java'),
	searchClass: t('Busqueda', 'Search'),
	linearSearch: t('busquedaLineal', 'linearSearch'),
	binarySearch: t('busquedaBinaria', 'binarySearch'),
	sorted: t('ordenados', 'sorted'),
	target: t('objetivo', 'target'),
	left: t('izquierda', 'left'),
	right: t('derecha', 'right'),
	middle: t('medio', 'middle'),
};
const strings = {
	outLinear: t('Lineal O(n): índice 5 (6 pasos)', 'Linear O(n): index 5 (6 steps)'),
	outBinary: t('Binaria O(log n): índice 5 (2 pasos)', 'Binary O(log n): index 5 (2 steps)'),
};

// First program: contract validation + linear search O(n).
const sourceA = [
	`public class ${names.searchClass} {`,
	`    static int ${names.linearSearch}(int[] ${names.sorted}, int ${names.target}) {`,
	`        if (${names.sorted} == null) return -1;`,
	`        for (int i = 0; i < ${names.sorted}.length; i++) {`,
	`            if (${names.sorted}[i] == ${names.target}) {`,
	'                return i;',
	'            }',
	'        }',
	'        return -1;',
	'    }',
	'',
	'    public static void main(String[] args) {',
	`        int[] ${names.sorted} = {2, 5, 8, 12, 16, 23, 38};`,
	`        int idx = ${names.linearSearch}(${names.sorted}, 23);`,
	'        System.out.println(idx);',
	'    }',
	'}',
	'',
].join('\n');

// Second program: binary search O(log n) with loop invariant on [left..right].
const sourceB = [
	`public class ${names.searchClass} {`,
	`    static int ${names.binarySearch}(int[] ${names.sorted}, int ${names.target}) {`,
	`        if (${names.sorted} == null) return -1;`,
	`        int ${names.left} = 0;`,
	`        int ${names.right} = ${names.sorted}.length - 1;`,
	`        while (${names.left} <= ${names.right}) {`,
	`            int ${names.middle} = ${names.left} + (${names.right} - ${names.left}) / 2;`,
	`            if (${names.sorted}[${names.middle}] == ${names.target})`,
	`                return ${names.middle};`,
	`            if (${names.sorted}[${names.middle}] < ${names.target})`,
	`                ${names.left} = ${names.middle} + 1;`,
	'            else',
	`                ${names.right} = ${names.middle} - 1;`,
	'        }',
	'        return -1;',
	'    }',
	'    public static void main(String[] args) {',
	`        int[] ${names.sorted} = {2, 5, 8, 12, 16, 23, 38};`,
	`        System.out.println(${names.binarySearch}(${names.sorted}, 23));`,
	'    }',
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const svgLines = (source: string) =>
	highlightCode(source, 'java').map((html, index) => ({
		n: index + 1,
		html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
	}));

const pageA = svgLines(sourceA);
const pageB = svgLines(sourceB);

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 64;
const GUTTER_X = 50;
const CODE_TOP = 74;
const LINE_H = 23;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 5;
const CONSOLE_TOP = 552;
const outY = (row: number) => 597 + row * LINE_H;

const lineAnchors = [3, 5, 7, 8, 10, 11, 12, 14, 19].map((n) => ({ id: `ln-${n}`, n }));

const outputs = [
	{ id: 'out-1', row: 0, text: strings.outLinear },
	{ id: 'out-2', row: 1, text: strings.outBinary },
];

// ── Isometric world (camera space) ────────────────────────────────────────
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 54;
const EY = 31;
const ORIGIN = { x: 590, y: 250 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');
const path = (points: Point[]) => 'M' + points.map((point) => `${point.x} ${point.y}`).join(' L');

/** A box standing on the floor at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		outline: poly([back, right, down(right), down(front), down(left), left]),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
	};
}
const floorMatrix = (point: Point) => `matrix(0.866 0.5 -0.866 0.5 ${point.x} ${point.y})`;

const MODULE_H = 20;
const LEVEL_ARR = -195;

// Seven sorted array slots: indices 0..6 placed along u = -2.4 .. +2.4 (step 0.8)
const slotU = (idx: number) => round((idx - 3) * 0.85);
const VALUES = [2, 5, 8, 12, 16, 23, 38];

const arraySlots = VALUES.map((val, idx) => ({
	idx,
	val,
	u: slotU(idx),
	g: slab(slotU(idx), 0, 0.34, 0.36, MODULE_H, LEVEL_ARR),
}));

const G = {
	floorMain: slab(0, -0.3, 1.85, 0.95, 12, -12),
	call: slab(-0.7, -0.3, 0.38, 0.34, MODULE_H, 0),
	ret: slab(0.8, -0.3, 0.38, 0.34, MODULE_H, 0),
	floorArr: slab(0, 0, 3.15, 1.05, 12, LEVEL_ARR - 12),
};
type Slab = typeof G.floorMain;
type Tone = 'flow' | 'violet' | 'magenta';

// Invariant range rings on the array platform
const rangeFull = slab(0, 0, 2.95, 0.58, 0, LEVEL_ARR + 2).top;
const rangeRight = slab(slotU(5), 0, 1.25, 0.58, 0, LEVEL_ARR + 2).top;

// Routes
const routes = {
	main: path([G.call.center, G.ret.center]),
	linearTrail: path(arraySlots.slice(0, 6).map((s) => s.g.center)),
	mid1: path([G.call.center, arraySlots[3].g.center]),
	mid2: path([arraySlots[3].g.center, arraySlots[5].g.center]),
	retUp: path([arraySlots[5].g.center, G.ret.center]),
};

const gridLines = [
	...[-2, -1, 0, 1, 2].map((u) => path([pt(u, -0.9, LEVEL_ARR + 0.5), pt(u, 0.9, LEVEL_ARR + 0.5)])),
	...[-0.6, 0, 0.6].map((v) => path([pt(-2.9, v, LEVEL_ARR + 0.5), pt(2.9, v, LEVEL_ARR + 0.5)])),
];

const hover = (g: Slab, by = 16) => lift(g.center, by);
const TARGET_POS = lift(pt(1.95, -0.5, 0), 26);

const anchors = [
	{ id: 'a-call', ...hover(G.call) },
	{ id: 'a-ret', ...hover(G.ret) },
	...arraySlots.map((slot) => ({ id: `a-s${slot.idx}`, ...hover(slot.g) })),
];

const shots = [
	{ id: 'shot-array', cx: 590, cy: 430, s: 1.12 },
	{ id: 'shot-main', cx: 600, cy: 320, s: 1.15 },
	{ id: 'shot-linear', cx: 585, cy: 420, s: 1.08 },
	{ id: 'shot-binary', cx: 590, cy: 430, s: 1.08 },
	{ id: 'shot-mid', cx: 590, cy: 390, s: 1.12 },
	{ id: 'shot-halve', cx: 590, cy: 435, s: 1.08 },
	{ id: 'shot-found', cx: 610, cy: 380, s: 1.08 },
	{ id: 'shot-all', cx: 595, cy: 385, s: 0.98 },
].map((item) => ({
	id: item.id,
	x: round(item.cx - 640 / item.s),
	y: round(item.cy - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

type Chip = {
	id: string;
	text: string;
	x: number;
	y: number;
	align: 'start' | 'end' | 'middle';
	tone: 'plain' | Tone;
	mono?: boolean;
	check?: boolean;
	lead?: Point;
};
const S0 = arraySlots[0].g.center;
const S3 = arraySlots[3].g.center;
const S4 = arraySlots[4].g.center;
const S5 = arraySlots[5].g.center;
const S6 = arraySlots[6].g.center;

const chips: Chip[] = [
	{
		id: 'ch-pre',
		text: t('precondición: != null y ordenado', 'precondition: != null and sorted'),
		x: 590,
		y: 350,
		align: 'middle',
		tone: 'flow',
		check: true,
	},
	{
		id: 'ch-post',
		text: t('postcondición: índice o -1', 'postcondition: index or -1'),
		x: G.ret.center.x,
		y: G.ret.center.y - 44,
		align: 'middle',
		tone: 'flow',
		check: true,
		lead: { x: G.ret.center.x, y: G.ret.center.y - 6 },
	},
	{
		id: 'ch-sent',
		text: t('centinela documentado: -1', 'documented sentinel: -1'),
		x: G.call.center.x - 10,
		y: G.call.center.y - 44,
		align: 'middle',
		tone: 'magenta',
		mono: true,
		lead: { x: G.call.center.x, y: G.call.center.y - 6 },
	},
	{
		id: 'ch-on',
		text: t('búsqueda lineal: 6 pasos · O(n)', 'linear search: 6 steps · O(n)'),
		x: 470,
		y: 548,
		align: 'middle',
		tone: 'magenta',
	},
	{
		id: 'ch-inv',
		text: t('invariante: objetivo en [izq..der]', 'invariant: target in [left..right]'),
		x: 590,
		y: 348,
		align: 'middle',
		tone: 'violet',
		check: true,
	},
	{
		id: 'ch-left0',
		text: `${names.left} = 0`,
		x: S0.x - 12,
		y: S0.y + 56,
		align: 'middle',
		tone: 'flow',
		mono: true,
		lead: { x: S0.x, y: S0.y + 18 },
	},
	{
		id: 'ch-right6',
		text: `${names.right} = 6`,
		x: S6.x + 12,
		y: S6.y + 56,
		align: 'middle',
		tone: 'flow',
		mono: true,
		lead: { x: S6.x, y: S6.y + 18 },
	},
	{
		id: 'ch-mid3',
		text: `${names.middle} = 3 (12)`,
		x: S3.x,
		y: S3.y - 48,
		align: 'middle',
		tone: 'flow',
		mono: true,
		lead: { x: S3.x, y: S3.y - 8 },
	},
	{
		id: 'ch-cmp1',
		text: '12 < 23 → +',
		x: S3.x + 80,
		y: S3.y - 22,
		align: 'start',
		tone: 'violet',
		mono: true,
	},
	{
		id: 'ch-half',
		text: t('descarta mitad [0..3]', 'discards half [0..3]'),
		x: arraySlots[1].g.center.x,
		y: arraySlots[1].g.center.y - 44,
		align: 'middle',
		tone: 'violet',
	},
	{
		id: 'ch-left4',
		text: `${names.left} = 4`,
		x: S4.x,
		y: S4.y + 56,
		align: 'middle',
		tone: 'violet',
		mono: true,
		lead: { x: S4.x, y: S4.y + 18 },
	},
	{
		id: 'ch-mid5',
		text: `${names.middle} = 5 (23 == 23)`,
		x: S5.x,
		y: S5.y - 50,
		align: 'middle',
		tone: 'violet',
		mono: true,
		check: true,
		lead: { x: S5.x, y: S5.y - 8 },
	},
	{
		id: 'ch-ologn',
		text: t('búsqueda binaria: 2 pasos · O(log n)', 'binary search: 2 steps · O(log n)'),
		x: 710,
		y: 582,
		align: 'middle',
		tone: 'violet',
		check: true,
	},
];

const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.check ? 42 : 24));
const chipLeft = (chip: Chip) => (chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x);
const chipJoin = (chip: Chip) => (chip.align === 'end' ? chipLeft(chip) + chipWidth(chip) - 14 : chip.align === 'middle' ? chip.x : chipLeft(chip) + 14);

const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="xp-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="xp-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="xp-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="xp-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="xp-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="xp-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="xp-g-object">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.7"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the running system, seen through the camera -->
			<g clip-path="url(#xp-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + 150} cy={VP.y + 110} rx="420" ry="320" fill="url(#xp-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + VP.w - 60} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#xp-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- Sorted array platform -->
						<g data-el="floor-arr">
							<polygon class="xj-plate-shadow" points={G.floorArr.base} transform="translate(12 18)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.floorArr.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.floorArr.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.floorArr.top} fill="url(#xp-g-floor)"></polygon>
							{gridLines.map((d) => <path class="xj-grid" d={d} />)}
							<text class="xj-floor-text" transform={floorMatrix(pt(-2.95, 0.85, LEVEL_ARR))}>
								{names.sorted}[0..6]
							</text>
						</g>

						<!-- Loop invariant range brackets on the array floor -->
						<polygon data-el="br-full" class="xj-scan" points={rangeFull}></polygon>
						<polygon data-el="br-right" class="xj-scan" points={rangeRight}></polygon>

						<!-- The seven indexed slots of the sorted array -->
						{
							arraySlots.map((slot) => (
								<g data-el={`s-${slot.idx}`} class="xj-mod">
									<polygon class="xj-shadow" points={slot.g.base} transform="translate(6 8)" />
									<polygon class="xj-face xj-face--l" points={slot.g.leftFace} />
									<polygon class="xj-face xj-face--r" points={slot.g.rightFace} />
									<polygon class="xj-face xj-face--t" points={slot.g.top} fill="url(#xp-g-top)" />
									<text class="xj-slot-val" x={slot.g.center.x} y={slot.g.center.y + 4} text-anchor="middle">
										{slot.val}
									</text>
									<text class="xj-face-text" transform={slot.g.faceMatrix} text-anchor="middle" y="4.5">
										[{slot.idx}]
									</text>
								</g>
							))
						}

						<!-- Linear search magenta trail states (slots 0..4) -->
						{
							arraySlots.slice(0, 5).map((slot) => (
								<g data-el={`lin-${slot.idx}`} class="xj-lit xj-lit--magenta">
									<polygon class="xj-lit-halo" points={slot.g.top} />
									<polygon class="xj-lit-top" points={slot.g.top} />
									<polygon class="xj-lit-side" points={slot.g.leftFace} />
									<text class="xj-slot-val xj-slot-val--on" x={slot.g.center.x} y={slot.g.center.y + 4} text-anchor="middle">
										{slot.val}
									</text>
								</g>
							))
						}

						<!-- Slot 5 found in linear search (flow) -->
						<g data-el="s5-on" class="xj-lit xj-lit--flow">
							<polygon class="xj-lit-halo" points={arraySlots[5].g.top}></polygon>
							<polygon class="xj-lit-top" points={arraySlots[5].g.top}></polygon>
							<polygon class="xj-lit-side" points={arraySlots[5].g.leftFace}></polygon>
							<text class="xj-slot-val xj-slot-val--on" x={arraySlots[5].g.center.x} y={arraySlots[5].g.center.y + 4} text-anchor="middle">
								23
							</text>
						</g>

						<!-- Slot 3 inspected as first midpoint (flow) -->
						<g data-el="s3-mid" class="xj-lit xj-lit--flow">
							<polygon class="xj-lit-halo" points={arraySlots[3].g.top}></polygon>
							<polygon class="xj-lit-top" points={arraySlots[3].g.top}></polygon>
							<polygon class="xj-lit-side" points={arraySlots[3].g.leftFace}></polygon>
							<text class="xj-slot-val xj-slot-val--on" x={arraySlots[3].g.center.x} y={arraySlots[3].g.center.y + 4} text-anchor="middle">
								12
							</text>
						</g>

						<!-- Slot 5 found in binary search (violet) -->
						<g data-el="s5-bin" class="xj-lit xj-lit--violet">
							<polygon class="xj-lit-halo" points={arraySlots[5].g.top}></polygon>
							<polygon class="xj-lit-top" points={arraySlots[5].g.top}></polygon>
							<polygon class="xj-lit-side" points={arraySlots[5].g.leftFace}></polygon>
							<text class="xj-slot-val xj-slot-val--on" x={arraySlots[5].g.center.x} y={arraySlots[5].g.center.y + 4} text-anchor="middle">
								23
							</text>
						</g>

						<!-- Veil dimming the discarded left half [0..3] in binary search -->
						<g data-el="veil-left">
							<g class="xj-veil">
								{arraySlots.slice(0, 4).map((slot) => <polygon points={slot.g.outline} />)}
							</g>
						</g>

						<!-- main() platform above -->
						<g data-el="floor-main">
							<polygon class="xj-plate-shadow" points={G.floorMain.base} transform="translate(12 18)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.floorMain.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.floorMain.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.floorMain.top} fill="url(#xp-g-floor)"></polygon>
							<text class="xj-floor-text" transform={floorMatrix(pt(-1.65, 0.48))}>main()</text>
						</g>

						<!-- Routes -->
						<g data-el="tr-main"><path class="mg-stroke xj-trace" pathLength="1" d={routes.main}></path></g>
						<g data-el="rt-lin" class="xj-flowline xj-flowline--magenta">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.linearTrail}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.linearTrail}></path>
						</g>
						<g data-el="fl-mid1" class="xj-flowline">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.mid1}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.mid1}></path>
						</g>
						<g data-el="fl-mid2" class="xj-flowline xj-flowline--violet">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.mid2}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.mid2}></path>
						</g>
						<g data-el="fl-ret" class="xj-flowline xj-flowline--violet">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.retUp}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.retUp}></path>
						</g>

						<!-- Modules of main() -->
						<g data-el="m-call" class="xj-mod">
							<polygon class="xj-shadow" points={G.call.base} transform="translate(7 9)"></polygon>
							<polygon class="xj-face xj-face--l" points={G.call.leftFace}></polygon>
							<polygon class="xj-face xj-face--r" points={G.call.rightFace}></polygon>
							<polygon class="xj-face xj-face--t" points={G.call.top} fill="url(#xp-g-top)"></polygon>
							<text class="xj-face-text" transform={G.call.faceMatrix} text-anchor="middle" y="4.5">14</text>
						</g>
						<g data-el="m-ret" class="xj-mod">
							<polygon class="xj-shadow" points={G.ret.base} transform="translate(7 9)"></polygon>
							<polygon class="xj-face xj-face--l" points={G.ret.leftFace}></polygon>
							<polygon class="xj-face xj-face--r" points={G.ret.rightFace}></polygon>
							<polygon class="xj-face xj-face--t" points={G.ret.top} fill="url(#xp-g-top)"></polygon>
							<text class="xj-face-text" transform={G.ret.faceMatrix} text-anchor="middle" y="4.5">return</text>
						</g>
						<g data-el="ret-on" class="xj-lit xj-lit--violet">
							<polygon class="xj-lit-halo" points={G.ret.top}></polygon>
							<polygon class="xj-lit-top" points={G.ret.top}></polygon>
							<polygon class="xj-lit-side" points={G.ret.leftFace}></polygon>
							<text class="xj-face-text xj-face-text--on" transform={G.ret.faceMatrix} text-anchor="middle" y="4.5">5</text>
						</g>

						<!-- Target token (objetivo = 23) -->
						<g data-el="obj-target">
							<g class="xj-object" transform={`translate(${TARGET_POS.x} ${TARGET_POS.y})`}>
								<circle r="34" fill="url(#xp-g-object)"></circle>
								<polygon class="xj-gem xj-gem--l" points="-14,-10 0,-2 0,14 -14,6"></polygon>
								<polygon class="xj-gem xj-gem--r" points="14,-10 0,-2 0,14 14,6"></polygon>
								<polygon class="xj-gem xj-gem--t" points="0,-18 14,-10 0,-2 -14,-10"></polygon>
								<rect class="xj-tag" x="-58" y="-54" width="116" height="22" rx="11"></rect>
								<text class="xj-tag-text" x="0" y="-38.5" text-anchor="middle">{`${names.target} = 23`}</text>
							</g>
						</g>

						<!-- Floating notes / chips -->
						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									{chip.lead && <line class="xj-lead" x1={chip.lead.x} y1={chip.lead.y} x2={chipJoin(chip)} y2={chip.y - 12} />}
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.check && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.check ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- The execution flow particle -->
						<g data-el="p" class="xj-particle" data-x={anchors[0].x} data-y={anchors[0].y}>
							<circle r="20" fill="url(#xp-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="320" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<polygon class="xj-legend-object" points={`${VP.x + 186},${LEGEND_Y - 6} ${VP.x + 192},${LEGEND_Y} ${VP.x + 186},${LEGEND_Y + 6} ${VP.x + 180},${LEGEND_Y}`}></polygon>
				<text x={VP.x + 200} y={LEGEND_Y + 4}>{t('Invariante O(log n)', 'Invariant O(log n)')}</text>
			</g>

			<!-- EDITOR: the source, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.file}</text>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<rect data-el="hc-2" class="xj-bar xj-bar--flow" x={BAR.x} y={lineTop(2)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<rect data-el="hx-3" class="xj-bar xj-bar--trail" x={BAR.x} y={lineTop(3)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<rect data-el="hv-7" class="xj-bar xj-bar--violet" x={BAR.x} y={lineTop(7)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<rect data-el="hv-10" class="xj-bar xj-bar--violet" x={BAR.x} y={lineTop(9)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(14)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<!-- First program: linear search O(n) -->
				<g data-el="ea" data-base="shown" class="xj-code">
					{
						pageA.map((line) => (
							<g data-el={`ea-${line.n}`}>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				<!-- Second program: binary search O(log n) -->
				<g data-el="eb" class="xj-code">
					{
						pageB.map((line) => (
							<g data-el={`eb-${line.n}`}>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				{
					outputs.map((line) => (
						<text data-el={line.id} class="xj-out" x={ED.x + 20} y={outY(line.row)} xml:space="preserve">
							{line.text}
						</text>
					))
				}
				{lineAnchors.map((anchor) => <circle data-anchor={anchor.id} cx={BAR_CX} cy={lineMid(anchor.n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow, magenta for the linear worst-case cost and violet for
	   the loop invariant and binary search O(log n) resolution.
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='algoritmia-complejidad-java']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='algoritmia-complejidad-java'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='algoritmia-complejidad-java'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='algoritmia-complejidad-java'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-magenta {
		stop-color: var(--xj-magenta);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-object {
		fill: var(--xj-violet);
	}

	/* Levels and modules */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-grid {
		fill: none;
		stroke: var(--xj-flow);
		stroke-width: 1;
		opacity: 0.07;
	}

	.xj-floor-text {
		font-family: var(--font-body);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.04em;
		fill: var(--xj-mist);
		opacity: 0.85;
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-face-text {
		font-family: var(--font-body);
		font-size: 12px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face-text--on {
		fill: var(--xj-ink);
	}

	.xj-slot-val {
		font-family: monospace;
		font-size: 13.5px;
		font-weight: 700;
		fill: var(--xj-white);
	}

	.xj-slot-val--on {
		fill: var(--xj-white);
	}

	/* Lit states */
	.xj-lit {
		--xj-lit: var(--xj-flow);
		--xj-lit-soft: var(--xj-flow-soft);
	}

	.xj-lit--violet {
		--xj-lit: var(--xj-violet);
		--xj-lit-soft: var(--xj-violet-soft);
	}

	.xj-lit--magenta {
		--xj-lit: var(--xj-magenta);
		--xj-lit-soft: var(--xj-magenta-soft);
	}

	.xj-lit-halo {
		fill: none;
		stroke: var(--xj-lit);
		stroke-width: 12;
		stroke-opacity: 0.22;
		stroke-linejoin: round;
	}

	.xj-lit-top {
		fill: var(--xj-lit);
		fill-opacity: 0.5;
		stroke: var(--xj-lit-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-lit-side {
		fill: var(--xj-lit-soft);
		stroke: var(--xj-lit-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-veil {
		opacity: 0.68;
	}

	.xj-veil polygon {
		fill: var(--xj-ink);
		stroke: var(--xj-ink);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	/* Routes */
	.xj-trace {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.xj-flowline {
		--xj-line: var(--xj-flow);
	}

	.xj-flowline--magenta {
		--xj-line: var(--xj-magenta);
	}

	.xj-flowline--violet {
		--xj-line: var(--xj-violet);
	}

	.xj-flowline-halo,
	.xj-flowline-core {
		fill: none;
		stroke: var(--xj-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.xj-flowline-halo {
		stroke-width: 11;
		stroke-opacity: 0.2;
	}

	.xj-flowline-core {
		stroke-width: 3;
	}

	.xj-scan {
		fill: var(--xj-violet);
		fill-opacity: 0.12;
		stroke: var(--xj-violet-soft);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}

	/* Notes */
	.xj-chip {
		--xj-chip: var(--xj-edge);
		--xj-chip-ink: var(--xj-mist);
	}

	.xj-chip--flow {
		--xj-chip: var(--xj-flow);
		--xj-chip-ink: var(--xj-flow-soft);
	}

	.xj-chip--magenta {
		--xj-chip: var(--xj-magenta);
		--xj-chip-ink: var(--xj-magenta-soft);
	}

	.xj-chip--violet {
		--xj-chip: var(--xj-violet);
		--xj-chip-ink: var(--xj-violet-soft);
	}

	.xj-chip rect {
		fill: var(--xj-panel);
		fill-opacity: 0.94;
		stroke: var(--xj-chip);
		stroke-width: 1.5;
	}

	.xj-lead {
		stroke: var(--xj-chip);
		stroke-width: 1.5;
		stroke-opacity: 0.7;
	}

	.xj-chip-text {
		font-family: var(--font-body);
		font-size: 12.5px;
		font-weight: 600;
		fill: var(--xj-chip-ink);
	}

	.xj-chip-mono {
		font-family: monospace;
		font-size: 12.5px;
		fill: var(--xj-chip-ink, var(--xj-white));
	}

	.xj-icon {
		fill: none;
		stroke: var(--xj-white);
		stroke-linecap: round;
		stroke-linejoin: round;
		overflow: visible;
	}

	/* The target token and the flow */
	.xj-gem {
		stroke: var(--xj-violet-soft);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}

	.xj-gem--t {
		fill: var(--xj-violet-soft);
	}

	.xj-gem--l {
		fill: var(--xj-violet);
	}

	.xj-gem--r {
		fill: var(--xj-violet-deep);
	}

	.xj-tag {
		fill: var(--xj-violet-deep);
		stroke: var(--xj-violet);
		stroke-width: 1.5;
	}

	.xj-tag-text {
		font-family: var(--font-body);
		font-size: 12.5px;
		font-weight: 700;
		fill: var(--xj-white);
	}

	.xj-particle-core {
		fill: var(--xj-white);
	}

	/* Editor */
	.xj-panel {
		fill: var(--xj-panel);
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-rule {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-dot {
		fill: var(--xj-edge);
	}

	.xj-file {
		font-family: monospace;
		font-size: 13px;
		fill: var(--xj-mist);
	}

	.xj-mono,
	.xj-out {
		font-family: monospace;
		font-size: 13px;
		white-space: pre;
		fill: var(--xj-mist);
	}

	.xj-out {
		fill: var(--xj-flow-soft);
	}

	.xj-gutter {
		font-family: monospace;
		font-size: 12px;
		fill: var(--xj-dim);
	}

	.mg-canvas .xj-code :global(.tok-kw) {
		fill: var(--xj-violet-soft);
	}

	.mg-canvas .xj-code :global(.tok-type) {
		fill: var(--xj-white);
	}

	.mg-canvas .xj-code :global(.tok-fn) {
		fill: var(--xj-white);
		font-weight: 400;
	}

	.mg-canvas .xj-code :global(.tok-str),
	.mg-canvas .xj-code :global(.tok-num) {
		fill: var(--xj-flow);
	}

	.mg-canvas .xj-code :global(.tok-punct),
	.mg-canvas .xj-code :global(.tok-op) {
		fill: var(--xj-dim);
	}

	.xj-hl rect {
		fill: var(--xj-flow);
		fill-opacity: 0.18;
		stroke: var(--xj-flow);
		stroke-opacity: 0.6;
		stroke-width: 1.2;
	}

	.xj-hl path {
		fill: var(--xj-flow);
	}

	.xj-bar--flow {
		fill: none;
		stroke: var(--xj-flow);
		stroke-width: 1.5;
		stroke-dasharray: 6 5;
	}

	.xj-bar--trail {
