---
/**
 * Scene for "The journey of a rebase" (lesson git/rebase-y-buenas-practicas,
 * order: 6), a short film played on one persistent motion canvas. The captions,
 * cues and the terminal session live in `src/data/animations/rebase-git.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: it is the
 * terminal session, one command per line, with a bar on the command being run and
 * its output typed in the console below. The viewport on the right holds the
 * camera: two isometric floors, GitHub on top and your repository below. A commit
 * is always the same rounded node with its short hash, a branch is always the same
 * tag, HEAD is always the same white marker and the change a commit carries travels
 * as a card. Magenta marks the problem (the conflict, the rejected push, what
 * `--force` would delete), violet what resolves it (`--continue`, the lease).
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script, session } from '../../data/animations/rebase-git';
import type { OutputId } from '../../data/animations/rebase-git';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── Names and hashes, localized the same way the lesson does ──────────────
const names = {
	feature: t('feature/carrito', 'feature/cart'),
	tracking: t('origin/feature/carrito', 'origin/feature/cart'),
};
const hash = {
	base: t('10b4cc8', '1264b56'),
	main: t('7ac78ac', 'd5e72ab'),
	d: t('a39a0ac', 'a45c681'),
	e: t('780488a', 'b4c6c0a'),
	d2: t('c6d3f43', '2c8e0f3'),
	e2: t('1dfd393', '5d1dad6'),
};

// ── Terminal session shown in the editor ──────────────────────────────────
/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const commandLines = highlightCode(session.commands.join('\n'), 'bash').map((html, index) => ({
	n: index + 1,
	html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
}));
const outputs = (Object.keys(session.outputs) as OutputId[]).map((id) => ({
	id,
	lines: session.outputs[id].map((line, index) => ({ id: `out-${id}-${index + 1}`, row: index, kind: line.kind, text: line.text[lang] })),
}));

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 68;
const GUTTER_X = 54;
const CODE_TOP = 64;
const LINE_H = 26;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 5;
const CONSOLE_TOP = 290;
const outY = (row: number) => CONSOLE_TOP + 62 + row * 22;
const lineAnchors = commandLines.map((line) => ({ id: `ln-${line.n}`, n: line.n }));

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up. History runs along +u;
// your branch is a lane behind `main` (-v). GitHub floats above your repository.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 56;
const EY = 32;
const ORIGIN = { x: 300, y: 140 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const shift = (point: Point, dx: number, dy: number): Point => ({ x: round(point.x + dx), y: round(point.y + dy) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');
const path = (points: Point[]) => 'M' + points.map((point) => `${point.x} ${point.y}`).join(' L');

/** A box standing on the floor at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
	};
}
type Slab = ReturnType<typeof slab>;
/** Text lying flat on a floor, reading along +u. */
const floorMatrix = (point: Point) => `matrix(0.866 0.5 -0.866 0.5 ${point.x} ${point.y})`;

const LV_LOCAL = -300;
const COL = 1.7;
const LANE = -2.4;
/** A commit slot: column along history, lane 0 (`main`) or 1 (your branch), on a floor. */
const slot = (col: number, lane: number, z: number) => pt(col * COL, lane * LANE, z);

const FLOORS = {
	remote: slab(2.55, -1.2, 3.15, 1.9, 12, -12),
	local: slab(2.625, -0.6, 3.125, 3.1, 12, LV_LOCAL - 12),
};

// Commit nodes: one visual identity, a rounded puck with its short hash.
type Tone = 'base' | 'mine' | 'mate';
type Node = { id: string; at: Point; hash: string; tone: Tone };
const NODE = { rx: 27, ry: 15.5, h: 10 };
const nodes: Node[] = [
	{ id: 'n-rb', at: slot(0, 0, 0), hash: hash.base, tone: 'base' },
	{ id: 'n-rc', at: slot(1, 0, 0), hash: hash.main, tone: 'base' },
	{ id: 'n-rd', at: slot(1, 1, 0), hash: hash.d, tone: 'mine' },
	{ id: 'n-re', at: slot(2, 1, 0), hash: hash.e, tone: 'mine' },
	{ id: 'n-rx', at: slot(3, 1, 0), hash: '???????', tone: 'mate' },
	{ id: 'n-rd2', at: slot(2, 0, 0), hash: hash.d2, tone: 'mine' },
	{ id: 'n-re2', at: slot(3, 0, 0), hash: hash.e2, tone: 'mine' },
	{ id: 'n-lb', at: slot(0, 0, LV_LOCAL), hash: hash.base, tone: 'base' },
	{ id: 'n-lc', at: slot(1, 0, LV_LOCAL), hash: hash.main, tone: 'base' },
	{ id: 'n-ld', at: slot(1, 1, LV_LOCAL), hash: hash.d, tone: 'mine' },
	{ id: 'n-le', at: slot(2, 1, LV_LOCAL), hash: hash.e, tone: 'mine' },
	{ id: 'n-ld2', at: slot(2, 0, LV_LOCAL), hash: hash.d2, tone: 'mine' },
	{ id: 'n-le2', at: slot(3, 0, LV_LOCAL), hash: hash.e2, tone: 'mine' },
];
const N = Object.fromEntries(nodes.map((node) => [node.id.slice(2), node.at])) as Record<string, Point>;
const puckSide = (c: Point, rx = NODE.rx, ry = NODE.ry, h = NODE.h) =>
	`M${c.x - rx} ${c.y} L${c.x - rx} ${c.y + h} A${rx} ${ry} 0 0 0 ${c.x + rx} ${c.y + h} L${c.x + rx} ${c.y} Z`;

// Parent links, drawn under the nodes.
const edges = [
	{ id: 'e-rbc', from: N.rb, to: N.rc },
	{ id: 'e-rbd', from: N.rb, to: N.rd },
	{ id: 'e-rde', from: N.rd, to: N.re },
	{ id: 'e-rex', from: N.re, to: N.rx },
	{ id: 'e-rcd2', from: N.rc, to: N.rd2 },
	{ id: 'e-rd2e2', from: N.rd2, to: N.re2 },
	{ id: 'e-lbc', from: N.lb, to: N.lc },
	{ id: 'e-lbd', from: N.lb, to: N.ld },
	{ id: 'e-lde', from: N.ld, to: N.le },
	{ id: 'e-lcd2', from: N.lc, to: N.ld2 },
	{ id: 'e-ld2e2', from: N.ld2, to: N.le2 },
];

// Modules: one per command of the session, with its editor line on the face.
const block = (u: number, v: number) => slab(u, v, 0.24, 0.24, 16, LV_LOCAL);
type Lit = { id: string; tone: 'flow' | 'violet' | 'magenta' };
const moduleLits: Record<number, Lit[]> = {
	1: [{ id: 'on-1', tone: 'flow' }],
	2: [{ id: 'on-2', tone: 'flow' }],
	3: [
		{ id: 'on-3', tone: 'flow' },
		{ id: 'bad-3', tone: 'magenta' },
	],
	4: [{ id: 'on-4', tone: 'flow' }],
	5: [{ id: 'on-5', tone: 'violet' }],
	6: [{ id: 'on-6', tone: 'violet' }],
	7: [
		{ id: 'on-7', tone: 'flow' },
		{ id: 'bad-7', tone: 'magenta' },
	],
	8: [{ id: 'on-8', tone: 'violet' }],
};
const modules = commandLines.map((line) => ({
	id: `m-${line.n}`,
	n: line.n,
	g: block((line.n - 1) * 0.75, 2.2),
	lits: moduleLits[line.n] ?? [],
}));

// ── Anchors: where the particle stops, where tags and cards rest or land ──
// Tags are drawn from their left edge, so a tag anchor is the tag's left middle.
const ROW = (n: number) => -10 - n * 24;
const tagAt = (node: Point, row: number, dx = 0): Point => shift(node, -14 + dx, ROW(row));
const W_TRACK_MAIN = 'origin/main'.length * 6.9 + 18;
const anchors: { id: string; x: number; y: number }[] = [
	...modules.map((module) => ({ id: `a-m${module.n}`, ...lift(module.g.center, 16) })),
	{ id: 'a-lc', ...N.lc },
	{ id: 'a-ld2', ...N.ld2 },
	{ id: 'a-le2', ...N.le2 },
	{ id: 'a-rc-up', ...shift(N.rc, 0, 34) },
	{ id: 'a-up-ld', ...lift(N.ld, 36) },
	{ id: 'a-dn-le', ...shift(N.le, 0, 40) },
	{ id: 'a-dn-le2', ...shift(N.le2, 0, 44) },
	{ id: 'a-push', ...shift(N.re, 0, 44) },
	{ id: 'a-lease', ...shift(N.le, 0, 40) },
	{ id: 'a-lease-re', ...shift(N.re, 0, 44) },
	{ id: 'a-lease-rx', ...shift(N.rx, 0, 44) },
	{ id: 't1-lb', ...tagAt(N.lb, 1) },
	{ id: 't1-lc', ...tagAt(N.lc, 1) },
	{ id: 'h-lc', ...tagAt(N.lc, 1, W_TRACK_MAIN + 6) },
	{ id: 'h-ld2', ...tagAt(N.ld2, 1) },
	{ id: 't1-le', ...tagAt(N.le, 1) },
	{ id: 't2-le', ...tagAt(N.le, 2) },
	{ id: 'h-le', ...tagAt(N.le, 3) },
	{ id: 't1-le2', ...tagAt(N.le2, 1) },
	{ id: 'h-le2', ...tagAt(N.le2, 2) },
	{ id: 't3-le2', ...tagAt(N.le2, 3) },
	{ id: 't1-rc', ...tagAt(N.rc, 1) },
	{ id: 't1-re', ...tagAt(N.re, 1) },
	{ id: 't1-rx', ...tagAt(N.rx, 1) },
	{ id: 't1-re2', ...tagAt(N.re2, 1) },
];
const at = (id: string) => anchors.find((anchor) => anchor.id === id) ?? { x: 0, y: 0 };

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shots = [
	{ id: 'shot-all', cx: 500, cy: 400, s: 0.88 },
	{ id: 'shot-local', cx: 490, cy: 520, s: 1.0 },
	{ id: 'shot-remote', cx: 560, cy: 220, s: 1.05 },
	{ id: 'shot-push', cx: 520, cy: 360, s: 0.9 },
	{ id: 'shot-conflict', cx: 705, cy: 600, s: 0.98 },
].map((item) => ({
	id: item.id,
	x: round(item.cx - 640 / item.s),
	y: round(item.cy - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Branch tags and HEAD: they travel between anchors, the same tag for the whole film.
type Tag = { id: string; text: string; kind: 'branch' | 'track' | 'head'; start: string };
const tags: Tag[] = [
	{ id: 'tg-om', text: 'origin/main', kind: 'track', start: 't1-lb' },
	{ id: 'tg-feat', text: names.feature, kind: 'branch', start: 't1-le' },
	{ id: 'tg-ofeat', text: names.tracking, kind: 'track', start: 't2-le' },
	{ id: 'tg-head', text: 'HEAD', kind: 'head', start: 'h-le' },
	{ id: 'tg-rmain', text: 'main', kind: 'branch', start: 't1-rc' },
	{ id: 'tg-rfeat', text: names.feature, kind: 'branch', start: 't1-re' },
];
const tagWidth = (text: string) => Math.round(text.length * 6.9 + 18);

// Cards: the change a commit carries, or what a push sends.
type Packet = { id: string; text: string; tone: 'flow' | 'violet' | 'magenta'; restAt: string };
const packets: Packet[] = [
	{ id: 'pk-fetch', text: hash.main, tone: 'flow', restAt: 'a-rc-up' },
	{ id: 'pk-d', text: t('feat(carrito)', 'feat(cart)'), tone: 'flow', restAt: 'a-up-ld' },
	{ id: 'pk-e', text: t('feat(envio)', 'feat(shipping)'), tone: 'flow', restAt: 'a-dn-le' },
	{ id: 'pk-push', text: `${names.feature} ${hash.e2}`, tone: 'flow', restAt: 'a-dn-le2' },
	{ id: 'pk-lease', text: t(`última vez: ${hash.e}`, `last seen: ${hash.e}`), tone: 'violet', restAt: 'a-lease' },
];
const packetWidth = (packet: Packet) => Math.round(packet.text.length * 7.6 + 28);

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = {
	id: string;
	text: string;
	x: number;
	y: number;
	align: 'start' | 'end' | 'middle';
	tone: 'plain' | 'flow' | 'violet' | 'magenta';
	mono?: boolean;
	icon?: 'check' | 'x';
};
const chips: Chip[] = [
	{ id: 'lb-beto', text: t('cambio de Beto', "Beto's change"), x: N.rc.x - 34, y: N.rc.y + 34, align: 'end', tone: 'plain' },
	{ id: 'lb-parent', text: t(`padre nuevo: ${hash.main}`, `new parent: ${hash.main}`), x: N.ld2.x + 34, y: N.ld2.y + 20, align: 'start', tone: 'flow', mono: true },
	{ id: 'lb-conflict', text: 'CONFLICT: config.js', x: N.le2.x + 64, y: N.le2.y + 222, align: 'start', tone: 'magenta', mono: true, icon: 'x' },
	{ id: 'lb-old', text: t('commits viejos', 'old commits'), x: N.ld.x - 36, y: N.ld.y - 26, align: 'end', tone: 'plain' },
	{ id: 'lb-rejected', text: t('rechazado: non-fast-forward', 'rejected: non-fast-forward'), x: N.re.x, y: N.re.y + 80, align: 'middle', tone: 'magenta', icon: 'x' },
	{ id: 'lb-nopull', text: t('git pull traería los viejos', 'git pull brings the old ones back'), x: N.le.x + 96, y: N.le.y + 47, align: 'middle', tone: 'magenta', icon: 'x' },
	{ id: 'lb-mate', text: t('commit de un compañero', "a teammate's commit"), x: N.rx.x, y: N.rx.y + 82, align: 'middle', tone: 'plain' },
	{ id: 'lb-force', text: t('--force: lo borraría', '--force: would delete it'), x: N.rx.x, y: N.rx.y + 112, align: 'middle', tone: 'magenta', icon: 'x' },
	{ id: 'lb-stale', text: t('rechazado: stale info', 'rejected: stale info'), x: N.rx.x, y: N.rx.y + 112, align: 'middle', tone: 'violet', icon: 'check' },
	{ id: 'lb-match', text: `${hash.e} = ${hash.e}`, x: N.re.x, y: N.re.y + 80, align: 'middle', tone: 'violet', mono: true, icon: 'check' },
	{ id: 'lb-forced', text: 'forced update', x: N.re.x + 98, y: N.re.y + 44, align: 'middle', tone: 'violet', mono: true, icon: 'check' },
	{ id: 'lb-pr', text: t('Pull Request actualizado', 'Pull Request updated'), x: N.re2.x + 110, y: N.re2.y + 42, align: 'middle', tone: 'violet', icon: 'check' },
	{ id: 'r-linear', text: t('historial lineal, hashes nuevos', 'linear history, new hashes'), x: N.le2.x + 40, y: N.le2.y + 90, align: 'middle', tone: 'flow', icon: 'check' },
	{ id: 'r-gold', text: t('regla de oro: nunca en ramas compartidas', 'golden rule: never on shared branches'), x: 664, y: 76, align: 'middle', tone: 'violet' },
	{ id: 'r-lease', text: t('--force-with-lease, nunca --force', '--force-with-lease, never --force'), x: 664, y: 108, align: 'middle', tone: 'violet', icon: 'check' },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.icon ? 42 : 24));
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

// config.js while the rebase is stopped, and after resolving it.
const FILE = { x: N.le2.x + 64, y: N.le2.y - 14, w: 350, lineH: 20 };
const conflictLines = [
	'const TAX_RATE = 0.21;',
	'<<<<<<< HEAD',
	'const SHIPPING_COST = 700;',
	'=======',
	'const SHIPPING_COST = 600;',
	'const FREE_SHIPPING_FROM = 10000;',
	`>>>>>>> ${hash.e} (${t('feat(envio)', 'feat(shipping)')}: ...)`,
];
const isMarker = (line: string) => /^(<<<<<<<|=======|>>>>>>>)/.test(line);
const fixedLines = ['const TAX_RATE = 0.21;', 'const SHIPPING_COST = 700;', 'const FREE_SHIPPING_FROM = 10000;'];
const fileRow = (row: number) => FILE.y + 44 + row * FILE.lineH;
const fileHeight = (count: number) => 52 + count * FILE.lineH;
const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="rg-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="rg-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="rg-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="rg-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="rg-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the two repositories, seen through the camera -->
			<g clip-path="url(#rg-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#rg-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#rg-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- Floors: GitHub above, your repository below -->
						<g data-el="floor-local">
							<polygon class="xj-plate-shadow" points={FLOORS.local.base} transform="translate(14 20)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={FLOORS.local.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={FLOORS.local.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={FLOORS.local.top} fill="url(#rg-g-floor)"></polygon>
							<text class="xj-floor-text" transform={floorMatrix(pt(-0.2, -3.4, LV_LOCAL))}>{t('Tu repositorio', 'Your repository')}</text>
						</g>
						<g data-el="floor-remote">
							<polygon class="xj-plate-shadow" points={FLOORS.remote.base} transform="translate(14 20)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={FLOORS.remote.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={FLOORS.remote.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={FLOORS.remote.top} fill="url(#rg-g-floor)"></polygon>
							<text class="xj-floor-text" transform={floorMatrix(pt(-0.3, -2.8))}>GitHub</text>
						</g>

						<!-- Modules: one per command, with its editor line on the face -->
						{
							modules.map((module) => (
								<>
									<g data-el={module.id} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.n}
										</text>
									</g>
									{module.lits.map((lit) => (
										<g data-el={lit.id} class:list={['xj-lit', `xj-lit--${lit.tone}`]}>
											<polygon class="xj-lit-halo" points={module.g.top} />
											<polygon class="xj-lit-top" points={module.g.top} />
											<polygon class="xj-lit-side" points={module.g.leftFace} />
											<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
												{module.n}
											</text>
										</g>
									))}
								</>
							))
						}

						<!-- Parent links -->
						{
							edges.map((edge) => (
								<g data-el={edge.id}>
									<path class="mg-stroke rg-edge" pathLength="1" d={path([edge.from, edge.to])} />
								</g>
							))
						}

						<!-- Commits: the same rounded node with its short hash -->
						{
							nodes.map((node) => (
								<g data-el={node.id} class:list={['rg-node', `rg-node--${node.tone}`]}>
									<ellipse class="xj-shadow" cx={node.at.x + 6} cy={node.at.y + NODE.h + 6} rx={NODE.rx} ry={NODE.ry} />
									<path class="rg-node-side" d={puckSide(node.at)} />
									<ellipse class="rg-node-top" cx={node.at.x} cy={node.at.y} rx={NODE.rx} ry={NODE.ry} />
									<text class="rg-hash" x={node.at.x} y={node.at.y + 4} text-anchor="middle">
										{node.hash}
									</text>
								</g>
							))
						}

						<!-- States drawn over the nodes -->
						{
							[
								{ id: 'old-ld', at: N.ld },
								{ id: 'old-le', at: N.le },
							].map((item) => (
								<g data-el={item.id} class="rg-old">
									<path d={puckSide(item.at, NODE.rx + 1, NODE.ry + 1)} />
									<ellipse cx={item.at.x} cy={item.at.y} rx={NODE.rx + 1} ry={NODE.ry + 1} />
								</g>
							))
						}
						<g data-el="x-bad" class="rg-ring rg-ring--magenta">
							<ellipse class="rg-ring-halo" cx={N.rx.x} cy={N.rx.y} rx={NODE.rx + 6} ry={NODE.ry + 5}></ellipse>
							<ellipse class="rg-ring-fill" cx={N.rx.x} cy={N.rx.y} rx={NODE.rx} ry={NODE.ry}></ellipse>
						</g>
						<g data-el="cf-slot" class="rg-ring rg-ring--magenta">
							<ellipse class="rg-ring-halo" cx={N.le2.x} cy={N.le2.y} rx={NODE.rx + 10} ry={NODE.ry + 8}></ellipse>
							<ellipse class="rg-ring-dash" cx={N.le2.x} cy={N.le2.y} rx={NODE.rx + 4} ry={NODE.ry + 3}></ellipse>
						</g>
						<g data-el="ok-slot" class="rg-ring rg-ring--violet">
							<ellipse class="rg-ring-halo" cx={N.le2.x} cy={N.le2.y} rx={NODE.rx + 10} ry={NODE.ry + 8}></ellipse>
							<ellipse class="rg-ring-dash" cx={N.le2.x} cy={N.le2.y} rx={NODE.rx + 4} ry={NODE.ry + 3}></ellipse>
						</g>

						<!-- config.js while the rebase is stopped: HEAD (ours) is the new base, theirs is your commit -->
						<g data-el="f-cfg" class="rg-file rg-file--magenta">
							<rect class="rg-file-card" x={FILE.x} y={FILE.y} width={FILE.w} height={fileHeight(conflictLines.length)} rx="14"></rect>
							<text class="rg-file-name" x={FILE.x + 16} y={FILE.y + 24}>config.js</text>
							<g data-el="f-ours" class="rg-side rg-side--flow">
								<rect x={FILE.x + 8} y={fileRow(1) - 14} width={FILE.w - 16} height={FILE.lineH * 2} rx="6"></rect>
								<text class="rg-side-text" x={FILE.x + FILE.w - 14} y={fileRow(1) + 1} text-anchor="end">{t('ours: origin/main', 'ours: origin/main')}</text>
							</g>
							<g data-el="f-theirs" class="rg-side rg-side--violet">
								<rect x={FILE.x + 8} y={fileRow(4) - 14} width={FILE.w - 16} height={FILE.lineH * 3} rx="6"></rect>
								<text class="rg-side-text" x={FILE.x + FILE.w - 14} y={fileRow(4) + 1} text-anchor="end">{t('theirs: tu commit', 'theirs: your commit')}</text>
							</g>
							{
								conflictLines.map((line, row) => (
									<text class:list={['rg-file-line', { 'rg-file-line--mark': isMarker(line) }]} x={FILE.x + 16} y={fileRow(row)} xml:space="preserve">
										{line}
									</text>
								))
							}
						</g>
						<g data-el="f-fixed" class="rg-file rg-file--violet">
							<rect class="rg-file-card" x={FILE.x} y={FILE.y} width={FILE.w} height={fileHeight(fixedLines.length)} rx="14"></rect>
							<text class="rg-file-name" x={FILE.x + 16} y={FILE.y + 24}>config.js</text>
							{
								fixedLines.map((line, row) => (
									<text class="rg-file-line" x={FILE.x + 16} y={fileRow(row)} xml:space="preserve">
										{line}
									</text>
								))
							}
						</g>

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.icon === 'check' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
									{chip.icon === 'x' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M18 6 6 18" />
											<path d="m6 6 12 12" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.icon ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- Branch tags and HEAD. Placement lives on the inner group: the player resets data-el transforms. -->
						{
							tags.map((tag) => (
								<g data-el={tag.id} data-x={at(tag.start).x} data-y={at(tag.start).y}>
									<g class:list={['rg-tag', `rg-tag--${tag.kind}`]}>
										<rect x="0" y="-11" width={tagWidth(tag.text)} height="22" rx="11" />
										<text x={tagWidth(tag.text) / 2} y="4.2" text-anchor="middle">
											{tag.text}
										</text>
									</g>
								</g>
							))
						}

						<!-- Cards: the change a commit carries, or what a push sends -->
						{
							packets.map((packet) => (
								<g data-el={packet.id} data-x={at(packet.restAt).x} data-y={at(packet.restAt).y}>
									<g class:list={['xj-packet', `xj-packet--${packet.tone}`]}>
										<rect class="xj-packet-halo" x={-packetWidth(packet) / 2 - 5} y="-18" width={packetWidth(packet) + 10} height="36" rx="18" />
										<rect class="xj-packet-card" x={-packetWidth(packet) / 2} y="-13" width={packetWidth(packet)} height="26" rx="13" />
										<text class="xj-packet-text" x="0" y="4.5" text-anchor="middle">
											{packet.text}
										</text>
									</g>
								</g>
							))
						}

						<!-- The execution flow -->
						<g data-el="p" class="xj-particle" data-x={at('a-m1').x} data-y={at('a-m1').y}>
							<circle r="20" fill="url(#rg-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="390" height="28" rx="14"></rect>
				<ellipse class="rg-legend-node" cx={VP.x + 30} cy={LEGEND_Y} rx="10" ry="6"></ellipse>
				<text x={VP.x + 46} y={LEGEND_Y + 4}>Commit</text>
				<rect class="rg-legend-tag" x={VP.x + 112} y={LEGEND_Y - 7} width="24" height="14" rx="7"></rect>
				<text x={VP.x + 144} y={LEGEND_Y + 4}>{t('Rama', 'Branch')}</text>
				<rect class="xj-legend-card" x={VP.x + 210} y={LEGEND_Y - 6} width="20" height="12" rx="6"></rect>
				<text x={VP.x + 238} y={LEGEND_Y + 4}>{t('Cambio que viaja', 'Travelling change')}</text>
			</g>

			<!-- EDITOR: the terminal session, with the running command highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{session.prompt[lang]}</text>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 26}>{t('SALIDA', 'OUTPUT')}</text>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(1)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<g class="xj-code">
					{
						commandLines.map((line) => (
							<g data-el={`cmd-${line.n}`}>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				{
					outputs.map((output) => (
						<g data-el={`out-${output.id}`}>
							{output.lines.map((line) => (
								<text data-el={line.id} class:list={['xj-out', `rg-out--${line.kind}`]} x={ED.x + 20} y={outY(line.row)} xml:space="preserve">
									{line.text}
								</text>
							))}
						</g>
					))
				}
				{lineAnchors.map((anchor) => <circle data-anchor={anchor.id} cx={BAR_CX} cy={lineMid(anchor.n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue for the normal flow, magenta for the problem (the conflict, the rejected
	   push) and violet for what resolves it (--continue, --force-with-lease).
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='rebase-git']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='rebase-git'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='rebase-git'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='rebase-git'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-card {
		fill: var(--xj-panel);
		stroke: var(--xj-flow);
		stroke-width: 1.5;
	}

	.rg-legend-node {
		fill: var(--xj-steel);
		stroke: var(--xj-flow);
		stroke-width: 1.5;
	}

	.rg-legend-tag {
		fill: var(--xj-ink);
		stroke: var(--xj-flow-soft);
		stroke-width: 1.5;
	}

	/* Floors and modules */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-floor-text {
		font-family: var(--font-body);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.04em;
		fill: var(--xj-mist);
		opacity: 0.85;
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-face--t {
		fill: var(--xj-steel-hi);
	}

	.xj-face-text {
		font-family: var(--font-body);
		font-size: 12px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face-text--on {
		fill: var(--xj-ink);
	}

	/* Lit states */
	.xj-lit {
		--xj-lit: var(--xj-flow);
		--xj-lit-soft: var(--xj-flow-soft);
	}

	.xj-lit--violet {
		--xj-lit: var(--xj-violet);
		--xj-lit-soft: var(--xj-violet-soft);
	}

	.xj-lit--magenta {
		--xj-lit: var(--xj-magenta);
		--xj-lit-soft: var(--xj-magenta-soft);
	}

	.xj-lit-halo {
		fill: none;
		stroke: var(--xj-lit);
		stroke-width: 12;
		stroke-opacity: 0.22;
		stroke-linejoin: round;
	}

	.xj-lit-top {
		fill: var(--xj-lit);
		fill-opacity: 0.5;
		stroke: var(--xj-lit-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-lit-side {
		fill: var(--xj-lit-soft);
		stroke: var(--xj-lit-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	/* Commits and their parent links */
	.rg-edge {
		fill: none;
		stroke: var(--xj-mist);
		stroke-width: 3;
		stroke-opacity: 0.7;
		stroke-linecap: round;
	}

	.rg-node {
		--rg-node: var(--xj-steel-hi);
		--rg-node-top: var(--xj-steel);
		--rg-node-ink: var(--xj-mist);
	}

	.rg-node--mine {
		--rg-node: var(--xj-flow);
		--rg-node-top: var(--xj-deep-hi);
		--rg-node-ink: var(--xj-flow-soft);
	}

	.rg-node--mate {
		--rg-node: var(--xj-mist);
		--rg-node-top: var(--xj-edge);
		--rg-node-ink: var(--xj-white);
	}

	.rg-node-side {
		fill: var(--xj-panel);
		stroke: var(--rg-node);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.rg-node-top {
		fill: var(--rg-node-top);
		stroke: var(--rg-node);
		stroke-width: 2;
	}

	.rg-hash {
		font-family: monospace;
		font-size: 11px;
		font-weight: 700;
		fill: var(--rg-node-ink);
	}

	.rg-old path,
	.rg-old ellipse {
		fill: var(--xj-ink);
		fill-opacity: 0.4;
		stroke: var(--xj-dim);
		stroke-width: 1.5;
		stroke-dasharray: 5 4;
	}

	.rg-ring {
		--rg-ring: var(--xj-magenta);
	}

	.rg-ring--violet {
		--rg-ring: var(--xj-violet);
	}

	.rg-ring-halo {
		fill: none;
		stroke: var(--rg-ring);
		stroke-width: 12;
		stroke-opacity: 0.22;
	}

	.rg-ring-dash {
		fill: var(--rg-ring);
		fill-opacity: 0.14;
		stroke: var(--rg-ring);
		stroke-width: 2.5;
		stroke-dasharray: 7 5;
	}

	.rg-ring-fill {
		fill: var(--rg-ring);
		fill-opacity: 0.45;
		stroke: var(--xj-magenta-soft);
		stroke-width: 2;
	}

	/* Branch tags and HEAD */
	.rg-tag rect {
		fill: var(--xj-ink);
		stroke: var(--xj-flow-soft);
		stroke-width: 1.5;
	}

	.rg-tag text {
		font-family: monospace;
		font-size: 11.5px;
		font-weight: 700;
		fill: var(--xj-flow-soft);
	}

	.rg-tag--track rect {
		stroke: var(--xj-mist);
		stroke-dasharray: 4 3;
	}

	.rg-tag--track text {
		fill: var(--xj-mist);
	}

	.rg-tag--head rect {
		fill: var(--xj-white);
		stroke: var(--xj-white);
	}

	.rg-tag--head text {
		fill: var(--xj-ink);
	}

	/* config.js */
	.rg-file {
		--rg-file: var(--xj-magenta);
	}

	.rg-file--violet {
		--rg-file: var(--xj-violet);
	}

	.rg-file-card {
		fill: var(--xj-panel);
		fill-opacity: 0.96;
		stroke: var(--rg-file);
		stroke-width: 2;
	}

	.rg-file-name {
		font-family: monospace;
		font-size: 12.5px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.rg-file-line {
		font-family: monospace;
		font-size: 12px;
		white-space: pre;
		fill: var(--xj-white);
	}

	.rg-file-line--mark {
		fill: var(--xj-magenta-soft);
		font-weight: 700;
	}

	.rg-side {
		--rg-side: var(--xj-flow);
	}

	.rg-side--violet {
		--rg-side: var(--xj-violet);
	}

	.rg-side rect {
		fill: var(--rg-side);
		fill-opacity: 0.16;
		stroke: var(--rg-side);
		stroke-width: 1.2;
	}

	.rg-side-text {
		font-family: var(--font-body);
		font-size: 11px;
		font-weight: 700;
		fill: var(--rg-side);
	}

	/* Notes */
	.xj-chip {
		--xj-chip: var(--xj-edge);
		--xj-chip-ink: var(--xj-mist);
	}

	.xj-chip--flow {
		--xj-chip: var(--xj-flow);
