---
/**
 * Scene for "The journey of two threads: from a race condition to the lock"
 * (lesson java/19-programacion-concurrente-hilos-y-pools, order: 22), a short film
 * played on one persistent motion canvas. The captions and cues live in
 * `src/data/animations/concurrencia-hilos-java.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: it shows
 * the Java source and the cues slide a bar over the line being executed. The
 * viewport on the right holds the camera: an isometric system where `main` is a
 * floor at the back, the shared Heap sits in the middle with the one `Contador`
 * object, and each thread owns a small Stack platform on either side. Light blue
 * is the execution flow, magenta the write that erases another (the lost update),
 * and violet what resolves it: the `synchronized` lock and the pool workers.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/concurrencia-hilos-java';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── Source code shown in the editor ───────────────────────────────────────
// Identifiers and comments are localized the same way the lesson does.
const names = {
	fileA: t('Carrera.java', 'Race.java'),
	fileC: 'Pool.java',
	race: t('Carrera', 'Race'),
	counter: t('Contador', 'Counter'),
	count: t('contador', 'count'),
	increment: t('incrementar', 'increment'),
	getCount: t('getContador', 'getCount'),
	t1: t('h1', 't1'),
	t2: t('h2', 't2'),
};
const strings = {
	threeSteps: t('leer, sumar 1, escribir', 'read, add 1, write'),
	neverRun: t('nunca run()', 'never run()'),
	oneAtATime: t('un hilo a la vez', 'one thread at a time'),
};

// First program: two threads increment a shared counter without protection.
const sourceA = [
	`class ${names.counter} {`,
	`    private int ${names.count} = 0;`,
	'',
	`    public void ${names.increment}() {`,
	`        ${names.count}++; // ${strings.threeSteps}`,
	'    }',
	'}',
	'',
	`public class ${names.race} {`,
	'    public static void main(String[] args) {',
	`        ${names.counter} c = new ${names.counter}();`,
	`        Thread ${names.t1} = new Thread(() -> c.${names.increment}());`,
	`        Thread ${names.t2} = new Thread(() -> c.${names.increment}());`,
	`        ${names.t1}.start(); // ${strings.neverRun}`,
	`        ${names.t2}.start();`,
	'    }',
	'}',
].join('\n');

// The fix, written over lines 4 and 5 of the same program.
const syncLine = `    public synchronized void ${names.increment}() {`;
const syncBody = `        ${names.count}++; // ${strings.oneAtATime}`;

// Second program: the synchronized counter fed by a pool of two threads.
const sourceC = [
	'import java.util.concurrent.*;',
	'',
	`class ${names.counter} {`,
	`    private int ${names.count} = 0;`,
	`    public synchronized void ${names.increment}() { ${names.count}++; }`,
	`    public synchronized int ${names.getCount}() { return ${names.count}; }`,
	'}',
	'',
	'public class Pool {',
	'    public static void main(String[] args) throws Exception {',
	`        ${names.counter} c = new ${names.counter}();`,
	`        ExecutorService pool = Executors.newFixedThreadPool(2);`,
	'        for (int i = 0; i < 4; i++) {',
	`            pool.submit(() -> c.${names.increment}());`,
	'        }',
	`        pool.shutdown();`,
	`        pool.awaitTermination(5, TimeUnit.SECONDS);`,
	`        System.out.println(c.${names.getCount}());`,
	'    }',
	'}',
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const svgLines = (source: string, first = 1) =>
	highlightCode(source, 'java').map((html, index) => ({
		n: index + first,
		html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
	}));

const pageA = svgLines(sourceA);
const pageC = svgLines(sourceC);
const fixLines = svgLines([syncLine, syncBody].join('\n'), 4);

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 68;
const GUTTER_X = 54;
const CODE_TOP = 74;
const LINE_H = 23;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 5;
const CONSOLE_TOP = 552;
const outY = (row: number) => 597 + row * LINE_H;

// Lines the highlight bar travels to (`ln-<n>`, valid for both programs).
const lineAnchors = [2, 4, 5, 11, 12, 13, 14, 15, 16, 18].map((n) => ({ id: `ln-${n}`, n }));

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 56;
const EY = 32;
const ORIGIN = { x: 460, y: 270 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');
const path = (points: Point[]) => 'M' + points.map((point) => `${point.x} ${point.y}`).join(' L');

/** A box standing on the floor at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		front: down(front),
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
	};
}
/** Text lying flat on a floor, reading along +u. */
const floorMatrix = (point: Point) => `matrix(0.866 0.5 -0.866 0.5 ${point.x} ${point.y})`;

const MODULE_H = 18;
const MAIN_V = -2;
const POOL_V = 3.1;
const block = (u: number, v = 0, z = 0) => slab(u, v, 0.36, 0.36, MODULE_H, z);
const G = {
	floor: slab(0.1, MAIN_V, 2.25, 0.7, 12, -12),
	entry: slab(-1.75, MAIN_V, 0.18, 0.18, 6),
	new: block(-1.15, MAIN_V),
	t1: block(-0.4, MAIN_V),
	t2: block(0.35, MAIN_V),
	s1: block(1.1, MAIN_V),
	s2: block(1.85, MAIN_V),
	heap: slab(2.2, 0.2, 0.9, 0.9, 12, -12),
	st1: slab(0.6, 1.8, 0.62, 0.62, 12, -12),
	st2: slab(3.8, -1.4, 0.62, 0.62, 12, -12),
	k1: block(0.6, 1.7),
	k2: block(3.8, -1.5),
	pool: slab(5.0, POOL_V, 1.6, 0.7, 12, -12),
	w1: block(3.9, POOL_V),
	w2: block(4.7, POOL_V),
};
type Slab = typeof G.floor;
type Tone = 'flow' | 'violet' | 'magenta';

// Routes: main's trace, the shared reference, thread launches, reads and writes.
const routes = {
	main: path([pt(-1.75, MAIN_V), pt(1.85, MAIN_V)]),
	ref: path([pt(-1.15, -1.6, 1), pt(1.75, 0.45, 6)]),
	spawn1: path([pt(1.1, -1.6), pt(0.1, -1.6), pt(0.1, 1.2)]),
	spawn2: path([pt(1.85, -1.6), pt(3.3, -1.6)]),
	read1: path([pt(1.9, 0.5, 10), pt(0.95, 1.35, 10)]),
	write1: path([pt(0.95, 1.35, 10), pt(1.9, 0.5, 10)]),
	read2: path([pt(2.5, -0.1, 10), pt(3.45, -1.15, 10)]),
	write2: path([pt(3.45, -1.15, 10), pt(2.5, -0.1, 10)]),
	work1: path([pt(3.9, POOL_V, 8), pt(2.4, 0.9, 8)]),
	work2: path([pt(4.7, POOL_V, 8), pt(2.6, 0.85, 8)]),
};
const gridLines = [
	...[-1.5, -0.75, 0, 0.75, 1.5, 2.2].map((u) => path([pt(u, -2.5, 0.5), pt(u, -1.5, 0.5)])),
	...[-2.25, -1.75].map((v) => path([pt(-2.1, v, 0.5), pt(2.3, v, 0.5)])),
];

// Modules of `main`, back to front. The pool program reuses the same slots.
type Module = { id: string; g: Slab; face?: string; lit?: { id: string } };
const modules: Module[] = [
	{ id: 'm-entry', g: G.entry },
	{ id: 'm-new', g: G.new, face: '11', lit: { id: 'new-on' } },
	{ id: 'm-t1', g: G.t1, face: '12', lit: { id: 't1-on' } },
	{ id: 'm-t2', g: G.t2, face: '13', lit: { id: 't2-on' } },
	{ id: 'm-s1', g: G.s1, face: '14', lit: { id: 's1-on' } },
	{ id: 'm-s2', g: G.s2, face: '15', lit: { id: 's2-on' } },
	{ id: 'm-pool', g: G.t1, face: '12', lit: { id: 'pool-on' } },
	{ id: 'm-submit', g: G.t2, face: '14', lit: { id: 'submit-on' } },
	{ id: 'm-shut', g: G.s1, face: '16', lit: { id: 'shut-on' } },
	{ id: 'm-print', g: G.s2, face: '18', lit: { id: 'print-on' } },
];

// Thread frames (`incrementar()` running on each Stack) and pool workers, with their lit states.
type Lit = { id: string; g: Slab; tone: Tone; face: string };
const frameLits: Lit[] = [
	{ id: 'k1-on', g: G.k1, tone: 'flow', face: '5' },
	{ id: 'k2-on', g: G.k2, tone: 'flow', face: '5' },
	{ id: 'k1-v', g: G.k1, tone: 'violet', face: '5' },
	{ id: 'k2-v', g: G.k2, tone: 'violet', face: '5' },
	{ id: 'w1-on', g: G.w1, tone: 'violet', face: '1' },
	{ id: 'w2-on', g: G.w2, tone: 'violet', face: '2' },
];

// Where the travelling particles stop: just above the top of each module.
const hover = (g: Slab, by = 16) => lift(g.center, by);
const OBJ = lift(pt(2.2, 0.2), 22);
const queue = [5.45, 5.8, 6.15, 6.5].map((u) => lift(pt(u, POOL_V), 10));
const anchors = [
	{ id: 'a-entry', ...hover(G.entry, 14) },
	{ id: 'a-new', ...hover(G.new) },
	{ id: 'a-t1', ...hover(G.t1) },
	{ id: 'a-t2', ...hover(G.t2) },
	{ id: 'a-s1', ...hover(G.s1) },
	{ id: 'a-s2', ...hover(G.s2) },
	{ id: 'a-pool', ...hover(G.t1) },
	{ id: 'a-submit', ...hover(G.t2) },
	{ id: 'a-shut', ...hover(G.s1) },
	{ id: 'a-print', ...hover(G.s2) },
	{ id: 'a-st1', ...hover(G.k1) },
	{ id: 'a-st2', ...hover(G.k2) },
	{ id: 'a-obj1', ...lift(pt(1.75, 0.65), 16) },
	{ id: 'a-obj2', ...lift(pt(2.65, -0.25), 16) },
	{ id: 'a-wait2', ...lift(pt(3.25, -0.85), 16) },
	{ id: 'a-w1', ...hover(G.w1, 14) },
	{ id: 'a-w2', ...hover(G.w2, 14) },
	{ id: 'a-objp', ...lift(pt(2.2, 0.75), 14) },
];
const anchorOf = (id: string) => anchors.find((anchor) => anchor.id === id)!;

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shots = [
	{ id: 'shot-heap', cx: 572, cy: 330, s: 1.2 },
	{ id: 'shot-main', cx: 560, cy: 230, s: 1.3 },
	{ id: 'shot-threads', cx: 572, cy: 300, s: 1.05 },
	{ id: 'shot-race', cx: 572, cy: 350, s: 1.2 },
	{ id: 'shot-pool', cx: 572, cy: 420, s: 1.0 },
	{ id: 'shot-all', cx: 572, cy: 360, s: 0.88 },
].map((item) => ({
	id: item.id,
	x: round(item.cx - 640 / item.s),
	y: round(item.cy - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Floating notes, centered on `x`. Each sits in a slot: the counter value on the
// Heap, a lane under each Stack, a note under the Heap and one under the pool.
type Chip = { id: string; tone: 'plain' | Tone; text: string; x: number; y: number; mono?: boolean; check?: boolean };
const SLOT = {
	value: { x: OBJ.x, y: OBJ.y + 60 },
	lane1: { x: G.st1.front.x, y: G.st1.front.y + 16 },
	lane2: { x: G.st2.front.x, y: G.st2.front.y + 16 },
	heap: { x: OBJ.x, y: G.heap.front.y + 30 },
	pool: { x: G.pool.center.x, y: G.pool.front.y + 26 },
};
const valueChip = (chip: { id: string; tone: Chip['tone']; text: string; check?: boolean }): Chip => ({ ...chip, ...SLOT.value, mono: true });
const at = (slot: keyof typeof SLOT, chip: { id: string; tone: Chip['tone']; text: string; mono?: boolean; check?: boolean }): Chip => ({
	...chip,
	...SLOT[slot],
});
const reads = t('lee', 'reads');

const chips: Chip[] = [
	valueChip({ id: 'v-0', tone: 'plain', text: `${names.count}: 0` }),
	valueChip({ id: 'v-1', tone: 'flow', text: `${names.count}: 1` }),
	// Nudged right so the wide note clears the lane chip under h1's Stack.
	{ ...valueChip({ id: 'v-lost', tone: 'magenta', text: `${names.count}: 1 ${t('(se esperaba 2)', '(expected 2)')}` }), x: SLOT.value.x + 14 },
	valueChip({ id: 'v-s1', tone: 'violet', text: `${names.count}: 1` }),
	valueChip({ id: 'v-s2', tone: 'violet', check: true, text: `${names.count}: 2` }),
	valueChip({ id: 'v-p1', tone: 'violet', text: `${names.count}: 1` }),
	valueChip({ id: 'v-p2', tone: 'violet', text: `${names.count}: 2` }),
	valueChip({ id: 'v-p3', tone: 'violet', text: `${names.count}: 3` }),
	valueChip({ id: 'v-p4', tone: 'violet', check: true, text: `${names.count}: 4` }),

	at('lane1', { id: 'n1-new', tone: 'plain', mono: true, text: `${names.t1}: NEW` }),
	at('lane2', { id: 'n2-new', tone: 'plain', mono: true, text: `${names.t2}: NEW` }),
	at('lane1', { id: 'n1-run', tone: 'flow', mono: true, text: `${names.t1}: RUNNABLE` }),
	at('lane2', { id: 'n2-run', tone: 'flow', mono: true, text: `${names.t2}: RUNNABLE` }),
	at('lane1', { id: 'l1-0', tone: 'flow', text: `${names.t1} ${reads} 0` }),
	at('lane2', { id: 'l2-0', tone: 'flow', text: `${names.t2} ${reads} 0` }),
	at('lane1', { id: 'l1-1', tone: 'flow', mono: true, text: `${names.t1}: 0 + 1 = 1` }),
	at('lane2', { id: 'l2-1', tone: 'flow', mono: true, text: `${names.t2}: 0 + 1 = 1` }),
	at('lane2', { id: 'l2-wait', tone: 'flow', text: t('h2 espera el cerrojo', 't2 waits for the lock') }),
	at('lane1', { id: 's1-rw', tone: 'violet', text: t('h1: lee 0, escribe 1', 't1: reads 0, writes 1') }),
	at('lane2', { id: 's2-rw', tone: 'violet', text: t('h2: lee 1, escribe 2', 't2: reads 1, writes 2') }),
	at('lane2', { id: 'r-race', tone: 'magenta', text: t('sin cerrojo: actualizaciones perdidas', 'no lock: lost updates') }),

	at('heap', { id: 'lb-heap', tone: 'flow', text: t('Heap: memoria compartida', 'Heap: shared memory') }),
	at('heap', { id: 'lb-steps', tone: 'plain', text: t('contador++ = leer → sumar 1 → escribir', 'count++ = read → add 1 → write') }),
	at('heap', { id: 'lb-lost', tone: 'magenta', text: t('2 incrementos, 1 perdido', '2 increments, 1 lost') }),
	at('heap', { id: 'lb-own1', tone: 'violet', text: t('h1 tiene el cerrojo', 't1 holds the lock') }),
	at('heap', { id: 'lb-own2', tone: 'violet', text: t('h2 tiene el cerrojo', 't2 holds the lock') }),
	at('heap', { id: 'lb-mutex', tone: 'violet', check: true, text: t('exclusión mutua: un hilo a la vez', 'mutual exclusion: one thread at a time') }),
	at('heap', { id: 'r-lock', tone: 'violet', check: true, text: t('synchronized: un hilo a la vez', 'synchronized: one thread at a time') }),

	at('pool', { id: 'lb-pool', tone: 'flow', text: t('pool: 2 hilos, 4 tareas', 'pool: 2 threads, 4 tasks') }),
	at('pool', { id: 'lb-reuse', tone: 'violet', text: t('los mismos 2 hilos se reutilizan', 'the same 2 threads are reused') }),
	at('pool', { id: 'lb-shut', tone: 'plain', text: t('shutdown(): no acepta tareas nuevas', 'shutdown(): no new tasks accepted') }),
	at('pool', { id: 'r-pool', tone: 'violet', check: true, text: t('pool: pocos hilos, muchas tareas', 'pool: few threads, many tasks') }),
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.check ? 42 : 24));
const chipLeft = (chip: Chip) => chip.x - chipWidth(chip) / 2;

// Platforms that come and go with the story, each with its floor label.
type Platform = { id: string; g: Slab; label: string; labelAt: Point; inner?: { g: Slab; face: string; id?: string }[] };
const platforms: Platform[] = [
	{ id: 'heap', g: G.heap, label: 'Heap', labelAt: pt(1.45, 1.0) },
	{ id: 'st1', g: G.st1, label: `${names.t1} · Stack`, labelAt: pt(0.02, 2.36), inner: [{ g: G.k1, face: '5' }] },
	{ id: 'st2', g: G.st2, label: `${names.t2} · Stack`, labelAt: pt(3.22, -0.84), inner: [{ g: G.k2, face: '5' }] },
	{ id: 'floor-pool', g: G.pool, label: 'ExecutorService', labelAt: pt(3.5, 3.75) },
];
const workers = [
	{ id: 'w1', g: G.w1, face: '1' },
	{ id: 'w2', g: G.w2, face: '2' },
];

const LOCK = { x: OBJ.x + 58, y: OBJ.y - 11 };
const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="xh-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="xh-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="xh-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="xh-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="xh-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="xh-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="xh-g-object">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.7"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the running system, seen through the camera -->
			<g clip-path="url(#xh-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + 150} cy={VP.y + 110} rx="420" ry="320" fill="url(#xh-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + VP.w - 60} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#xh-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- main() on its own Stack, at the back -->
						<g data-el="floor-main">
							<polygon class="xj-plate-shadow" points={G.floor.base} transform="translate(14 22)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.floor.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.floor.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.floor.top} fill="url(#xh-g-floor)"></polygon>
							{gridLines.map((d) => <path class="xj-grid" d={d} />)}
							<text class="xj-floor-text" transform={floorMatrix(pt(-2.05, -1.36))}>Stack · main()</text>
						</g>
						<g data-el="tr-main"><path class="mg-stroke xj-trace" pathLength="1" d={routes.main}></path></g>

						<!-- The Heap, each thread's Stack and the pool -->
						{
							platforms.map((platform) => (
								<g data-el={platform.id}>
									<polygon class="xj-plate-shadow" points={platform.g.base} transform="translate(10 16)" />
									<polygon class="xj-plate xj-plate--l" points={platform.g.leftFace} />
									<polygon class="xj-plate xj-plate--r" points={platform.g.rightFace} />
									<polygon class="xj-plate xj-plate--t" points={platform.g.top} fill="url(#xh-g-floor)" />
									<text class="xj-floor-text" transform={floorMatrix(platform.labelAt)}>
										{platform.label}
									</text>
									{platform.inner?.map((item) => (
										<>
											<polygon class="xj-shadow" points={item.g.base} transform="translate(7 9)" />
											<polygon class="xj-face xj-face--l" points={item.g.leftFace} />
											<polygon class="xj-face xj-face--r" points={item.g.rightFace} />
											<polygon class="xj-face xj-face--t" points={item.g.top} fill="url(#xh-g-top)" />
											<text class="xj-face-text" transform={item.g.faceMatrix} text-anchor="middle" y="4.5">
												{item.face}
											</text>
										</>
									))}
								</g>
							))
						}

						<!-- Pool workers: two threads that stay alive between tasks -->
						{
							workers.map((worker) => (
								<g data-el={worker.id} class="xj-mod">
									<polygon class="xj-shadow" points={worker.g.base} transform="translate(7 9)" />
									<polygon class="xj-face xj-face--l" points={worker.g.leftFace} />
									<polygon class="xj-face xj-face--r" points={worker.g.rightFace} />
									<polygon class="xj-face xj-face--t" points={worker.g.top} fill="url(#xh-g-top)" />
									<text class="xj-face-text" transform={worker.g.faceMatrix} text-anchor="middle" y="4.5">
										{worker.face}
									</text>
								</g>
							))
						}

						<!-- Routes: the shared reference, thread launches, reads and writes -->
						<g data-el="ref-c"><path class="mg-stroke xj-ref" pathLength="1" d={routes.ref}></path></g>
						<g data-el="sp-1" class="xj-flowline">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.spawn1}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.spawn1}></path>
						</g>
						<g data-el="sp-2" class="xj-flowline">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.spawn2}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.spawn2}></path>
						</g>
						<g data-el="rd-1" class="xj-flowline">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.read1}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.read1}></path>
						</g>
						<g data-el="rd-2" class="xj-flowline">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.read2}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.read2}></path>
						</g>
						<g data-el="wr-1" class="xj-flowline">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.write1}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.write1}></path>
						</g>
						<g data-el="wr-2" class="xj-flowline xj-flowline--magenta">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.write2}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.write2}></path>
						</g>
						<g data-el="sy-1" class="xj-flowline xj-flowline--violet">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.write1}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.write1}></path>
						</g>
						<g data-el="sy-2" class="xj-flowline xj-flowline--violet">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.write2}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.write2}></path>
						</g>
						<g data-el="pw-1" class="xj-flowline xj-flowline--violet">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.work1}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.work1}></path>
						</g>
						<g data-el="pw-2" class="xj-flowline xj-flowline--violet">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={routes.work2}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={routes.work2}></path>
						</g>

						<!-- Modules of main(), back to front, each with its lit state -->
						{
							modules.map((module) => (
								<>
									<g data-el={module.id} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(7 9)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#xh-g-top)" />
										{module.face && (
											<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
												{module.face}
											</text>
										)}
									</g>
									{module.lit && (
										<g data-el={module.lit.id} class="xj-lit xj-lit--flow">
											<polygon class="xj-lit-halo" points={module.g.top} />
											<polygon class="xj-lit-top" points={module.g.top} />
											<polygon class="xj-lit-side" points={module.g.leftFace} />
											<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
												{module.face}
											</text>
										</g>
									)}
								</>
							))
						}

						<!-- Lit states of the thread frames and of the pool workers -->
						{
							frameLits.map((lit) => (
								<g data-el={lit.id} class:list={['xj-lit', `xj-lit--${lit.tone}`]}>
									<polygon class="xj-lit-halo" points={lit.g.top} />
									<polygon class="xj-lit-top" points={lit.g.top} />
									<polygon class="xj-lit-side" points={lit.g.leftFace} />
									<text class="xj-face-text xj-face-text--on" transform={lit.g.faceMatrix} text-anchor="middle" y="4.5">
										{lit.face}
									</text>
								</g>
							))
						}

						<!-- The shared counter object on the Heap. Placement lives on the inner group. -->
						<g data-el="obj">
							<g class="xj-object" transform={`translate(${OBJ.x} ${OBJ.y})`}>
								<circle r="34" fill="url(#xh-g-object)"></circle>
								<polygon class="xj-gem xj-gem--l" points="-15,-10.5 0,-2 0,15 -15,6.5"></polygon>
								<polygon class="xj-gem xj-gem--r" points="15,-10.5 0,-2 0,15 15,6.5"></polygon>
								<polygon class="xj-gem xj-gem--t" points="0,-19 15,-10.5 0,-2 -15,-10.5"></polygon>
								<rect class="xj-tag" x="-58" y="-54" width="116" height="22" rx="11"></rect>
								<text class="xj-tag-text" x="0" y="-38.5" text-anchor="middle">{names.counter} c</text>
							</g>
						</g>

						<!-- The object's lock (monitor), taken by synchronized. Lucide "lock". -->
						<g data-el="lock" class="xj-lock">
							<g transform={`translate(${LOCK.x} ${LOCK.y})`}>
								<circle class="xj-lock-ground" r="17"></circle>
								<svg class="xj-icon xj-icon--lock" x="-10" y="-10" width="20" height="20" viewBox="0 0 24 24" stroke-width="2.75">
									<rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
									<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
								</svg>
							</g>
						</g>

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.check && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chip.x + (chip.check ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- Tasks queued in the pool; each starts in its slot of the queue -->
						{
							queue.map((slot, index) => (
								<g data-el={`tk${index + 1}`} class="xj-task" data-x={slot.x} data-y={slot.y}>
									<polygon class="xj-task-t" points="0,-14 12,-7 0,0 -12,-7" />
									<polygon class="xj-task-l" points="-12,-7 0,0 0,12 -12,5" />
									<polygon class="xj-task-r" points="12,-7 0,0 0,12 12,5" />
								</g>
							))
						}

						<!-- The execution flow of main and of each thread -->
						<g data-el="p" class="xj-particle" data-x={anchorOf('a-entry').x} data-y={anchorOf('a-entry').y}>
							<circle r="20" fill="url(#xh-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>
						<g data-el="pa" class="xj-particle" data-x={anchorOf('a-s1').x} data-y={anchorOf('a-s1').y}>
							<circle r="20" fill="url(#xh-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
							<text class="xj-particle-tag" y="-16" text-anchor="middle">{names.t1}</text>
						</g>
						<g data-el="pb" class="xj-particle" data-x={anchorOf('a-s2').x} data-y={anchorOf('a-s2').y}>
							<circle r="20" fill="url(#xh-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
							<text class="xj-particle-tag" y="-16" text-anchor="middle">{names.t2}</text>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="400" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Hilo', 'Thread')}</text>
				<circle class="xj-legend-magenta" cx={VP.x + 102} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 114} y={LEGEND_Y + 4}>{t('Escritura perdida', 'Lost write')}</text>
				<circle class="xj-legend-violet" cx={VP.x + 250} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 262} y={LEGEND_Y + 4}>{t('Cerrojo / pool', 'Lock / pool')}</text>
			</g>

			<!-- EDITOR: the source, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<text data-el="fa" data-base="shown" class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.fileA}</text>
				<text data-el="fc" class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.fileC}</text>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<!-- Line states sit behind the code -->
				<rect data-el="hx-5" class="xj-bar xj-bar--magenta" x={BAR.x} y={lineTop(5)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<rect data-el="hv-4" class="xj-bar xj-bar--violet" x={BAR.x} y={lineTop(4)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(2)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<!-- First program: two threads race on an unprotected counter -->
				<g data-el="ea" data-base="shown" class="xj-code">
					{
						pageA.map((line) => (
							<g data-el={`ea-${line.n}`}>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				<!-- The fix: lines 4 and 5 rewritten with synchronized -->
				<g class="xj-code">
					{
						fixLines.map((line) => (
							<g data-el={`eb-${line.n}`}>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				<!-- Second program: the synchronized counter fed by a pool -->
				<g data-el="ec" class="xj-code">
					{
						pageC.map((line) => (
							<g data-el={`ec-${line.n}`}>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				<text data-el="out-c" class="xj-out" x={ED.x + 20} y={outY(0)} xml:space="preserve">4</text>
				{lineAnchors.map((anchor) => <circle data-anchor={anchor.id} cx={BAR_CX} cy={lineMid(anchor.n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow per thread, magenta for the lost update and violet for
	   what resolves it (the lock and the pool workers).
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='concurrencia-hilos-java']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='concurrencia-hilos-java'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='concurrencia-hilos-java'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='concurrencia-hilos-java'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-magenta {
		stop-color: var(--xj-magenta);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-magenta {
		fill: var(--xj-magenta);
	}

	.xj-legend-violet {
		fill: var(--xj-violet);
	}

	/* Levels and modules */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-grid {
		fill: none;
		stroke: var(--xj-flow);
		stroke-width: 1;
		opacity: 0.07;
	}

	.xj-floor-text {
		font-family: var(--font-body);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.04em;
		fill: var(--xj-mist);
		opacity: 0.85;
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-face-text {
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face-text--on {
		fill: var(--xj-ink);
	}

	/* Lit states */
	.xj-lit {
		--xj-lit: var(--xj-flow);
		--xj-lit-soft: var(--xj-flow-soft);
	}

	.xj-lit--violet {
		--xj-lit: var(--xj-violet);
		--xj-lit-soft: var(--xj-violet-soft);
	}

	.xj-lit--magenta {
		--xj-lit: var(--xj-magenta);
		--xj-lit-soft: var(--xj-magenta-soft);
	}

	.xj-lit-halo {
		fill: none;
		stroke: var(--xj-lit);
		stroke-width: 12;
		stroke-opacity: 0.22;
		stroke-linejoin: round;
	}

	.xj-lit-top {
		fill: var(--xj-lit);
