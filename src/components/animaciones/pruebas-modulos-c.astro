});

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = {
	id: string;
	text: string;
	x: number;
	y: number;
	align: 'start' | 'end' | 'middle';
	tone: 'plain' | 'flow' | 'magenta' | 'violet';
	mono?: boolean;
	icon?: 'check' | 'alert';
};
const FN_TOP = G.fn.center;
const TM_TOP = G.tm.center;
const RN_TOP = G.rn.center;
const MK_TOP = G.mk.center;
const g7 = gateOf('g7').g;
const g8 = gateOf('g8').g;
const g9 = gateOf('g9').g;
const v14 = gateOf('v14').g;
const v15 = gateOf('v15').g;
const MID = pt(3.8, 0, 0);
const effect = `assert(fgets(${names.line}, sizeof ${names.line}, ${names.file}) != NULL);`;
const chips: Chip[] = [
	// What the machine under test answers.
	{ id: 'r-sum', text: `${names.sum}(2, 3) → 5`, x: FN_TOP.x + 64, y: FN_TOP.y - 84, align: 'middle', tone: 'flow', mono: true },
