/**
 * Scene for "A module under test" (lesson c/pruebas-estilo-y-portabilidad), a short film
 * played on one persistent motion canvas. The captions and cues live in
 * `src/data/animations/pruebas-modulos-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: it shows the
 * file being discussed (the assert test, the test runner, the Makefile, the portable
 * types), a bar over the line being executed and, under it, the terminal with the real
 * output. The viewport on the right holds the camera: an isometric test line. The test
 * machine (`test_calculadora.c`) sends one probe through the machine under test (the
 * `calculadora` module) and on to a gate; every `assert` line is a gate that lets the
 * probe through or stops the line. Later the gates vanish (`NDEBUG`), the runner counts
 * the checks and sets the exit status, `make test` runs the whole line and two platforms
 * read the same byte.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * Its colors are the `--xj-*` tokens declared once in the style block; nothing else
 * in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
