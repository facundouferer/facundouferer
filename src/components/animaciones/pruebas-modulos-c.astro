// Routes on the floor: the belt, the lit run along it and the one from `make`.
const belt = path([pt(U.tm, 0, 1), pt(U.rn, 0, 1)]);
const mkRoute = path([pt(U.mk, 1.35, 1), pt(U.tm, 1.35, 1), pt(U.tm, 0.55, 1)]);
const gridLines = [
	...[-1, 0, 1, 2, 3, 4, 5, 6, 7].map((u) => path([pt(u, -2.9, 0.5), pt(u, 2.3, 0.5)])),
	...[-2, -1, 0, 1, 2].map((v) => path([pt(-1.1, v, 0.5), pt(7.1, v, 0.5)])),
];
