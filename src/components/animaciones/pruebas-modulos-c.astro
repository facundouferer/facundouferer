	{ id: 'all', text: names.pass, x: RN_TOP.x, y: RN_TOP.y - 96, align: 'middle', tone: 'flow', mono: true },
	{ id: 'nochk', text: t('sin comprobar nada', 'nothing was checked'), x: RN_TOP.x, y: RN_TOP.y - 68, align: 'middle', tone: 'magenta', icon: 'alert' },
	{ id: 'fg', text: effect, x: MID.x, y: MID.y - 118, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'fg-note', text: t('la lectura desaparece', 'the read disappears'), x: MID.x, y: MID.y - 88, align: 'middle', tone: 'magenta', icon: 'alert' },
	// The runner: its counters, its failure message and its exit status.
	...[0, 1, 2, 3].map((n): Chip => ({ id: `cr-${n}`, text: `${t('ejecutadas', 'run')} ${n}`, x: RN_TOP.x, y: RN_TOP.y - 60, align: 'middle', tone: 'flow' })),
	{ id: 'cf-0', text: `${t('fallidas', 'failed')} 0`, x: RN_TOP.x, y: RN_TOP.y - 88, align: 'middle', tone: 'flow' },
	{ id: 'cf-1', text: `${t('fallidas', 'failed')} 1`, x: RN_TOP.x, y: RN_TOP.y - 88, align: 'middle', tone: 'magenta' },
	{ id: 'fm', text: `${names.test}:14: ${names.failWord}: ${names.div}(7, 2) == 3`, x: v15.center.x + 40, y: v14.peak - 76, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'st-1', text: 'EXIT_FAILURE · 1', x: RN_TOP.x, y: RN_TOP.y + 50, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'st-0', text: 'EXIT_SUCCESS · 0', x: RN_TOP.x, y: RN_TOP.y + 50, align: 'middle', tone: 'flow', mono: true },
	{ id: 'mkerr', text: 'make: *** [test] Error 1', x: MK_TOP.x, y: MK_TOP.y + 46, align: 'middle', tone: 'magenta', mono: true },
	// Portability: the same byte on two platforms.
	{ id: 'rs-a1', text: 'char → -56', x: G.bayA.center.x, y: G.bayA.center.y - 70, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'rs-b1', text: 'char → 200', x: G.bayB.center.x, y: G.bayB.center.y - 70, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'rs-a2', text: 'uint8_t → 200', x: G.bayA.center.x, y: G.bayA.center.y - 98, align: 'middle', tone: 'violet', mono: true },
	{ id: 'rs-b2', text: 'uint8_t → 200', x: G.bayB.center.x, y: G.bayB.center.y - 98, align: 'middle', tone: 'violet', mono: true },
	{ id: 'szl', text: 'long: 64 bits (Linux, macOS) · 32 (Windows)', x: pt(2.2, 1.3).x, y: pt(2.2, 1.3).y + 20, align: 'start', tone: 'magenta', mono: true },
	{ id: 'szf', text: t('int32_t: 32 bits en todas partes', 'int32_t: 32 bits everywhere'), x: pt(2.2, 1.3).x, y: pt(2.2, 1.3).y + 50, align: 'start', tone: 'violet', mono: true },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.6 : 6.7) + (chip.icon ? 42 : 24));
const chipLeft = (chip: Chip) => (chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x);

const start = anchorOf('a-tm');
const byStart = anchorOf('a-by');
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="tests" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="pm-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="pm-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="pm-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="pm-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="pm-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the test line, seen through the camera -->
			<g clip-path="url(#pm-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + 150} cy={VP.y + 110} rx="420" ry="320" fill="url(#pm-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + VP.w - 60} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#pm-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- The floor of the test line -->
						<g data-el="floor" data-base="shown">
							<polygon class="xj-plate-shadow" points={G.floor.base} transform="translate(14 22)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.floor.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.floor.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.floor.top} fill="url(#pm-g-floor)"></polygon>
							{gridLines.map((d) => <path class="xj-grid" d={d} />)}
							<text class="xj-floor-text" transform={floorMatrix(pt(-0.9, -2.7))}>test</text>
						</g>

						<!-- The belt: the dim base first, the lit runs on top -->
						<g data-el="belt"><path class="mg-stroke xj-trace" pathLength="1" d={belt}></path></g>
						<g data-el="fl-belt" class="xj-flowline">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={belt}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={belt}></path>
						</g>
						<g data-el="fl-mk" class="xj-flowline xj-flowline--violet">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={mkRoute}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={mkRoute}></path>
						</g>

						<!-- The machines: test, module under test, make, runner and the two platforms -->
						{
							machines.map((item) => (
								<>
									<g data-el={item.id} class="xj-mod">
										<polygon class="xj-shadow" points={item.g.base} transform="translate(7 9)" />
										<polygon class="xj-face xj-face--l" points={item.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={item.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={item.g.top} fill="url(#pm-g-top)" />
										<text class="xj-face-text" transform={item.g.faceMatrix} text-anchor="middle" y="4.5">
											{item.face}
										</text>
										{item.tag && (
											<g class="xj-tag-group xj-tag-group--plain">
												<rect class="xj-tag" x={item.g.center.x - tagW(item.tag) / 2} y={tagY(item.g) - 11} width={tagW(item.tag)} height="22" rx="11" />
												<text class="xj-tag-text" x={item.g.center.x} y={tagY(item.g) + 4.5} text-anchor="middle">
													{item.tag}
												</text>
											</g>
										)}
									</g>
									{item.lit && (
										<g data-el={item.lit} class="xj-lit xj-lit--flow">
											<polygon class="xj-lit-halo" points={item.g.top} />
											<polygon class="xj-lit-top" points={item.g.top} />
											<polygon class="xj-lit-side" points={item.g.leftFace} />
											<text class="xj-face-text xj-face-text--on" transform={item.g.faceMatrix} text-anchor="middle" y="4.5">
												{item.face}
											</text>
										</g>
									)}
								</>
							))
						}
						{
							faulty.map((item) => (
								<g data-el={item.id} class="xj-lit xj-lit--magenta">
									<polygon class="xj-lit-halo" points={item.g.top} />
									<polygon class="xj-lit-top" points={item.g.top} />
									<polygon class="xj-lit-side" points={item.g.leftFace} />
									<text class="xj-face-text xj-face-text--on" transform={item.g.faceMatrix} text-anchor="middle" y="4.5">
										{item.face}
									</text>
								</g>
							))
						}

						<!-- The gates: each one carries its editor line number and the value it expects -->
						{
							gates.map((item) => (
								<>
									<g data-el={item.id} class:list={['xj-mod', item.kind === 'check' && 'xj-mod--violet']}>
										<polygon class="xj-shadow" points={item.g.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={item.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={item.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={item.g.top} fill="url(#pm-g-top)" />
										<text class="xj-face-text" transform={item.g.faceMatrix} text-anchor="middle" y="4.5">
											{item.line}
										</text>
										<g class="xj-tag-group xj-tag-group--plain">
											<rect class="xj-tag" x={item.g.center.x - tagW(item.tagText) / 2} y={tagY(item.g) - 11} width={tagW(item.tagText)} height="22" rx="11" />
											<text class="xj-tag-text" x={item.g.center.x} y={tagY(item.g) + 4.5} text-anchor="middle">
												{item.tagText}
											</text>
										</g>
									</g>
									<g data-el={`${item.id}-on`} class:list={['xj-lit', item.kind === 'check' ? 'xj-lit--violet' : 'xj-lit--flow']}>
										<polygon class="xj-lit-halo" points={item.g.top} />
										<polygon class="xj-lit-top" points={item.g.top} />
										<polygon class="xj-lit-side" points={item.g.leftFace} />
										<text class="xj-face-text xj-face-text--on" transform={item.g.faceMatrix} text-anchor="middle" y="4.5">
											{item.line}
										</text>
									</g>
									{item.x && (
										<g data-el={`${item.id}-x`} class="xj-lit xj-lit--magenta">
											<polygon class="xj-lit-halo" points={item.g.top} />
											<polygon class="xj-lit-top" points={item.g.top} />
											<polygon class="xj-lit-side" points={item.g.leftFace} />
											<text class="xj-face-text xj-face-text--on" transform={item.g.faceMatrix} text-anchor="middle" y="4.5">
												{item.line}
											</text>
										</g>
									)}
								</>
							))
						}

						<!-- After the failed assert: nothing past the gate runs -->
						<g data-el="veil">
							<g class="xj-veil">
								{veiled.map((item) => <polygon points={item.outline} />)}
							</g>
						</g>
						<g data-el="cut" class="xj-cut">
							{cut.map((d) => <path d={d} />)}
						</g>

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.icon === 'check' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
									{chip.icon === 'alert' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
											<path d="M12 9v4" />
											<path d="M12 17h.01" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.icon ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- The probe: one cube that visits the machines and the gates. The player moves
						     the outer group; the cube is drawn around its own base. -->
						<g data-el="pr" data-x={start.x} data-y={start.y}>
							<polygon class="xj-doc xj-doc--l" points={probe.leftFace}></polygon>
							<polygon class="xj-doc xj-doc--r" points={probe.rightFace}></polygon>
							<polygon class="xj-doc xj-doc--t" points={probe.top}></polygon>
						</g>

						<!-- The same byte, 200, written two ways: `char` and `uint8_t` -->
						<g data-el="by" data-x={byStart.x} data-y={byStart.y}>
							<polygon class="xj-bin xj-bin--l" points={byteBox.leftFace}></polygon>
							<polygon class="xj-bin xj-bin--r" points={byteBox.rightFace}></polygon>
							<polygon class="xj-bin xj-bin--t" points={byteBox.top}></polygon>
							<text class="xj-bits" transform={byteBox.faceMatrix} text-anchor="middle" y="4">200</text>
							<g class="xj-tag-group xj-tag-group--bad">
								<rect class="xj-tag" x={-tagW('(char)200') / 2} y={tagY(byteBox) - 11} width={tagW('(char)200')} height="22" rx="11"></rect>
								<text class="xj-tag-text" y={tagY(byteBox) + 4.5} text-anchor="middle">(char)200</text>
							</g>
						</g>
						<g data-el="bu" data-x={byStart.x} data-y={byStart.y}>
							<polygon class="xj-piece xj-piece--l" points={fixedBox.leftFace}></polygon>
							<polygon class="xj-piece xj-piece--r" points={fixedBox.rightFace}></polygon>
							<polygon class="xj-piece xj-piece--t" points={fixedBox.top}></polygon>
							<text class="xj-bits" transform={fixedBox.faceMatrix} text-anchor="middle" y="4">200</text>
							<g class="xj-tag-group xj-tag-group--ready">
								<rect class="xj-tag" x={-tagW('uint8_t') / 2} y={tagY(fixedBox) - 11} width={tagW('uint8_t')} height="22" rx="11"></rect>
								<text class="xj-tag-text" y={tagY(fixedBox) + 4.5} text-anchor="middle">uint8_t</text>
							</g>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-flow" x={VP.x + 20} y={VP.y + VP.h - 28} width="12" height="12" rx="3"></rect>
				<text x={VP.x + 40} y={VP.y + VP.h - 18}>{t('La prueba que pasa', 'The probe that passes')}</text>
				<rect class="xj-legend-lib" x={VP.x + 220} y={VP.y + VP.h - 28} width="12" height="12" rx="3"></rect>
				<text x={VP.x + 240} y={VP.y + VP.h - 18}>{t('Lo que lo resuelve', 'What resolves it')}</text>
				<rect class="xj-legend-exc" x={VP.x + 400} y={VP.y + VP.h - 28} width="12" height="12" rx="3"></rect>
				<text x={VP.x + 420} y={VP.y + VP.h - 18}>{t('Falla', 'Failure')}</text>
			</g>

			<!-- EDITOR: the file being discussed, with the line being executed highlighted, and the terminal -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<path class="xj-rule" d={`M${ED.x} ${TERM_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={TERM_TOP + 22}>TERMINAL</text>

				<!-- Line states sit behind the code -->
				<rect data-el="hx-7" class="xj-bar xj-bar--magenta" x={BAR.x} y={lineTop(7)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<rect data-el="hx-14" class="xj-bar xj-bar--magenta" x={BAR.x} y={lineTop(14)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(1)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				{
					pages.map((page) => (
						<g data-el={page.id} data-base={page.typed ? 'shown' : undefined} class="xj-code">
							<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>
								{page.file}
							</text>
							{page.lines.map((line) => (
								<g data-el={page.typed ? `${page.id}-${line.n}` : undefined}>
									<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
										{line.n}
									</text>
									<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
								</g>
							))}
						</g>
					))
				}

				{
					term.map((line) => (
						<text data-el={line.id} class:list={['xj-term', `xj-term--${line.kind}`]} x={ED.x + 20} y={rowY(line.row)} xml:space="preserve">
							{line.text}
						</text>
					))
				}
				{lineAnchors.map((n) => <circle data-anchor={`ln-${n}`} cx={BAR_CX} cy={lineMid(n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of the films only (DESIGN.md §8): a deep blue ground, light blue for the
	   normal flow, magenta for the problem and violet for what resolves it.
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='pruebas-modulos-c']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='pruebas-modulos-c'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='pruebas-modulos-c'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='pruebas-modulos-c'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-lib {
		fill: var(--xj-violet);
	}

	.xj-legend-exc {
		fill: var(--xj-magenta);
	}

	/* Floor, stations and shelf */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
