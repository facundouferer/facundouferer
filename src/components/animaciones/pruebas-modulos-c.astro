	{ id: 'fixc', text: 'a / b', x: FN_TOP.x + 64, y: FN_TOP.y - 112, align: 'middle', tone: 'violet', mono: true },
	{ id: 'msg', text: t('assert falló · código 134', 'assert failed · code 134'), x: g7.center.x, y: g7.peak - 60, align: 'middle', tone: 'magenta', icon: 'alert' },
	// Boundary cases.
