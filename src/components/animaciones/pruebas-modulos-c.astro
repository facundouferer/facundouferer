const cutAt = 3.4;
const cut = [path([pt(cutAt, -0.36, 2), pt(cutAt, 0.36, 2)]), path([pt(cutAt + 0.1, -0.36, 2), pt(cutAt + 0.1, 0.36, 2)])];
