const faulty: { id: string; g: Box; face: string }[] = [
	{ id: 'fn-x', g: G.fn, face: 'calc' },
	{ id: 'mk-x', g: G.mk, face: 'make' },
	{ id: 'rn-x', g: G.rn, face: t('cuenta', 'tally') },
