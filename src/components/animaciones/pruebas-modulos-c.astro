// The gates: one per `assert` line (steel) and one per `VERIFICAR` line (violet).
// `line` is the editor line number written on the gate; `tag` the expected value.
type GateKind = 'assert' | 'check';
const gateDefs: { id: string; line: number; u: number; tag: string; kind: GateKind; x?: boolean }[] = [
	{ id: 'g6', line: 6, u: 2.2, tag: '5', kind: 'assert' },
	{ id: 'g7', line: 7, u: 3.0, tag: '3', kind: 'assert', x: true },
	{ id: 'g8', line: 8, u: 3.8, tag: '-3', kind: 'assert' },
	{ id: 'g9', line: 9, u: 4.6, tag: '0', kind: 'assert' },
	{ id: 'g10', line: 10, u: 5.4, tag: 'false', kind: 'assert' },
	{ id: 'v14', line: 14, u: 3.0, tag: '3', kind: 'check', x: true },
	{ id: 'v15', line: 15, u: 4.0, tag: '-3', kind: 'check' },
	{ id: 'v16', line: 16, u: 5.0, tag: '0', kind: 'check' },
];
const gates = gateDefs.map((def) => ({ ...def, g: gate(def.u), tagText: `== ${def.tag}` }));
const gateOf = (id: string) => gates.find((item) => item.id === id) ?? gates[0];

const G = {
	floor: slab(3.0, -0.3, 4.3, 2.7, 12, -12),
	tm: slab(U.tm, 0, 0.45, 0.45, MACHINE_H),
	fn: slab(U.fn, 0, 0.45, 0.45, MACHINE_H),
	mk: slab(U.mk, 1.9, 0.4, 0.4, 18),
	rn: slab(U.rn, 0, 0.5, 0.5, 20),
	bayA: slab(U.bayA, -2.0, 0.5, 0.5, 18),
	bayB: slab(U.bayB, -2.0, 0.5, 0.5, 18),
};

// Machines: a steel body, a short face label, an optional file tag and a lit state.
const machines: { id: string; lit: string | null; g: Box; face: string; tag: string | null }[] = [
