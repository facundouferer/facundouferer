---
/**
 * Scenes for the "Iterators, sorting and equals/hashCode, step by step" animation
 * (lesson java/16). The captions, code and terminal panels live in
 * `src/data/animations/iteradores-ordenamiento-java.ts`; this component only draws the
 * diagrams the steps point to. Slide scenes are HTML blocks (`[data-scene]` with
 * `[data-el]` elements); the `iter`, `cme`, `rm`, `sort`, `eq`, `hash` and `tree`
 * scenes are SVG canvases (`data-motion`) choreographed by the cues of their motion steps.
 * Elements that travel are drawn around their own origin and placed with `data-x`/`data-y`;
 * the invisible `data-anchor` circles are the spots they glide to.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/iteradores-ordenamiento-java';
import { resolveScript } from '../../utils/animations';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── Motion canvas data ────────────────────────────────────────────────────
// iter: three wide cells, the cursor sits in the gaps between them
const iterCells = [
	{ id: 'cell-0', x: 110, name: '"Ana"' },
	{ id: 'cell-1', x: 600, name: '"Luis"' },
	{ id: 'cell-2', x: 1090, name: '"Marta"' },
];
const iterGaps = [75, 555, 1045, 1525];
const iterPills = iterCells.map((cell, i) => ({
	has: `has-${i}`,
	next: `next-${i}`,
	x: 110 + i * 490,
	name: cell.name,
}));

// cme / rm: four tasks of 290 units; slot centers and cursor gaps
const taskNames = ['"estudiar"', '"descansar"', '"practicar"', '"leer"'];
const taskCenters = [245, 615, 985, 1355];
const taskGaps = [70, 430, 800, 1170, 1530];

// sort: four books that glide between four slots
const bookSlots = [230, 610, 990, 1370];
const books = [
	{ id: 'bk0', title: 'Rayuela', author: 'Cortázar', pages: 736, tone: 'accent' },
	{ id: 'bk1', title: 'El Aleph', author: 'Borges', pages: 146, tone: 'sage' },
	{ id: 'bk2', title: '1984', author: 'Orwell', pages: 328, tone: 'accent' },
	{ id: 'bk3', title: 'Ficciones', author: 'Borges', pages: 174, tone: 'sage' },
];

// hash: twelve buckets, 116 wide
const buckets = Array.from({ length: 12 }, (_, i) => ({ id: `bk-${i}`, x: 60 + i * 124, cx: 118 + i * 124, index: i }));

// eq: the three fields compared by the overridden equals
const eqFields = [
	{ id: 'ln-t', y: 360, label: 'titulo', value: '"1984"' },
	{ id: 'ln-a', y: 420, label: 'autor', value: '"Orwell"' },
	{ id: 'ln-p', y: 480, label: 'paginas', value: '328' },
];

// ── Slide scene data ──────────────────────────────────────────────────────
const collections = ['ArrayList', 'HashSet', 'ArrayDeque', 'LinkedList', 'TreeSet'];
const rules = [
	{ id: 'ru-refl', name: t('Reflexiva', 'Reflexive'), note: 'a.equals(a) → true' },
	{ id: 'ru-sym', name: t('Simétrica', 'Symmetric'), note: t('a.equals(b) ⇒ b.equals(a)', 'a.equals(b) ⇒ b.equals(a)') },
	{ id: 'ru-trans', name: t('Transitiva', 'Transitive'), note: t('a=b y b=c ⇒ a=c', 'a=b and b=c ⇒ a=c') },
	{ id: 'ru-cons', name: t('Consistente', 'Consistent'), note: t('Mismo resultado si nada cambió', 'Same result if nothing changed') },
	{ id: 'ru-null', name: t('Contra null', 'Against null'), note: t('a.equals(null) → false', 'a.equals(null) → false') },
];
const mistakes = [
	{ id: 'e1', text: t('equals sin hashCode', 'equals without hashCode') },
	{ id: 'e2', text: t('equals(Libro o) en vez de equals(Object o)', 'equals(Libro o) instead of equals(Object o)') },
	{ id: 'e3', text: t('compareTo con a - b', 'compareTo returning a - b') },
	{ id: 'e4', text: t('== para comparar String', '== to compare String') },
	{ id: 'e5', text: t('Modificar un objeto guardado en un HashSet', 'Mutating an object stored in a HashSet') },
	{ id: 'e6', text: t('remove dentro de un for-each', 'remove inside a for-each') },
	{ id: 'e7', text: t('compareTo inconsistente con equals', 'compareTo inconsistent with equals') },
];
const challenge = [
	{ id: 'x1', n: 1, name: t('Libro inmutable', 'Immutable Libro'), note: 'titulo · autor · paginas' },
	{ id: 'x2', n: 2, name: 'equals + hashCode', note: t('Con los tres campos', 'Over the three fields') },
	{ id: 'x3', n: 3, name: 'Comparable', note: t('Orden natural por título', 'Natural order by title') },
	{ id: 'x4', n: 4, name: 'HashSet', note: t('Descarta el duplicado', 'Discards the duplicate') },
	{ id: 'x5', n: 5, name: 'Comparator', note: t('Tres órdenes distintos', 'Three different orders') },
	{ id: 'x6', n: 6, name: 'TreeSet', note: t('La trampa del compareTo', 'The compareTo trap') },
];
const takeaways = [
	t('for-each = Iterator', 'for-each = Iterator'),
	t('CME no es de hilos', 'CME is not about threads'),
	t('removeIf · it.remove()', 'removeIf · it.remove()'),
	t('Comparable vs Comparator', 'Comparable vs Comparator'),
	t('compareTo: solo el signo', 'compareTo: only the sign'),
	t('equals + hashCode juntos', 'equals + hashCode together'),
	t('equals(Object o)', 'equals(Object o)'),
	t('TreeSet decide con compareTo', 'TreeSet decides with compareTo'),
	t('record lo da gratis', 'record gives it for free'),
];
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<!-- INTRO: three debts and their common root -->
	<div slot="scene" data-scene="intro16" class="scene-intro16">
		<div class="dg-box dg-box--accent" data-el="q-iter">
			<p class="dg-label">{t('Deuda 1', 'Debt 1')}</p>
			<p class="dg-title">{t('Iteradores y for-each', 'Iterators and for-each')}</p>
			<code class="dg-code">ConcurrentModificationException</code>
		</div>
		<div class="dg-box dg-box--sage" data-el="q-sort">
			<p class="dg-label dg-label--sage">{t('Deuda 2', 'Debt 2')}</p>
			<p class="dg-title">{t('Ordenar objetos propios', 'Sorting your own objects')}</p>
			<code class="dg-code">Comparable · Comparator</code>
		</div>
		<div class="dg-box" data-el="q-eq">
			<p class="dg-label">{t('Deuda 3', 'Debt 3')}</p>
			<p class="dg-title">{t('Duplicados en un HashSet', 'Duplicates in a HashSet')}</p>
			<code class="dg-code">equals · hashCode</code>
		</div>
		<div class="dg-box dg-box--ink dg-box--center" data-el="q-root">
			<p class="dg-title">{t('Las colecciones le hacen preguntas a tus objetos', 'Collections ask your objects questions')}</p>
			<p class="dg-sub">{t('Si contestan mal, todo falla en silencio', 'If they answer wrongly, everything fails silently')}</p>
		</div>
	</div>

	<!-- 1. Behind the for-each -->
	<div slot="scene" data-scene="foreach" class="scene-foreach">
		<div class="dg-box" data-el="fe-for">
			<p class="dg-label">for-each</p>
			<code class="dg-code">for (String n : nombres)</code>
		</div>
		<span class="dg-arrow" data-el="fe-arrow" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
		</span>
		<div class="dg-box dg-box--accent" data-el="fe-it">
			<p class="dg-label">Iterator</p>
			<code class="dg-code">it = nombres.iterator()</code>
			<code class="dg-code">while (it.hasNext()) {'{'} it.next() {'}'}</code>
		</div>
		<div class="dg-box dg-box--sage scene-foreach-wide" data-el="fe-methods">
			<p class="dg-label dg-label--sage">{t('Solo tres métodos', 'Just three methods')}</p>
			<div class="dg-chips">
				<code class="dg-chip dg-chip--sage">hasNext()</code>
				<code class="dg-chip dg-chip--sage">next()</code>
				<code class="dg-chip dg-chip--sage">remove()</code>
				<span class="dg-chip dg-chip--ink">Iterable → iterator()</span>
			</div>
		</div>
		<div class="dg-box scene-foreach-wide" data-el="fe-same">
			<p class="dg-label">{t('La misma sintaxis, estructuras muy distintas', 'The same syntax, very different structures')}</p>
			<div class="dg-chips">
				{collections.map((name) => <code class="dg-chip dg-chip--accent">{name}</code>)}
			</div>
		</div>
	</div>

	<!-- 1b. Iterator cursor (motion canvas) -->
	<div slot="scene" data-scene="iter" data-motion class="scene-canvas">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<text class="mg-mono mg-mono--dark mg-big" x="60" y="80" data-el="decl">Iterator&lt;String&gt; it = nombres.iterator();</text>

				<g data-el="list">
					<rect class="mg-card" x="40" y="140" width="1520" height="240" rx="22" />
					<text class="mg-text mg-text--strong mg-text--muted" x="68" y="366">nombres</text>
				</g>
				{
					iterCells.map((cell, i) => (
						<g data-el={cell.id}>
							<rect class="mg-card mg-card--accent" x={cell.x} y="215" width="400" height="120" rx="18" />
							<text class="mg-mono mg-mono--dark mg-big" x={cell.x + 200} y="282" text-anchor="middle">{cell.name}</text>
							<text class="mg-text mg-text--strong mg-text--muted" x={cell.x + 200} y="322" text-anchor="middle">[{i}]</text>
						</g>
					))
				}
				{iterGaps.map((x, i) => <circle data-anchor={`gp-${i}`} cx={x} cy="170" r="2" fill="none" />)}

				<g data-el="cur" data-x="75" data-y="170">
					<circle class="mg-dot" cx="0" cy="0" r="24" />
					<text class="mg-chip-text mg-ptr-text" x="0" y="6" text-anchor="middle">it</text>
					<path class="mg-pin" d="M-11 20L0 42L11 20Z" />
				</g>

				{
					iterPills.map((pill) => (
						<>
							<g data-el={pill.has}>
								<rect class="mg-chip mg-chip--sage" x={pill.x} y="430" width="400" height="54" rx="27" />
								<text class="mg-chip-text mg-chip-text--sage mg-chip-text--lg" x={pill.x + 200} y="465" text-anchor="middle">hasNext()  →  true</text>
							</g>
							<g data-el={pill.next}>
								<rect class="mg-chip" x={pill.x} y="500" width="400" height="54" rx="27" />
								<text class="mg-chip-text mg-chip-text--lg" x={pill.x + 200} y="535" text-anchor="middle">next()  →  {pill.name}</text>
							</g>
						</>
					))
				}
				<g data-el="has-end">
					<rect class="mg-card mg-card--ink" x="110" y="580" width="1380" height="56" rx="28" />
					<text class="mg-text mg-text--light mg-text--strong" x="800" y="615" text-anchor="middle">hasNext()  →  false  ·  {t('el recorrido termina', 'the traversal ends')}</text>
				</g>
			</g>
		</svg>
	</div>

	<!-- 2. ConcurrentModificationException -->
	<div slot="scene" data-scene="cmefix" class="scene-cmefix">
		<div class="dg-box dg-box--ink scene-cmefix-wide" data-el="cf-bad">
			<p class="dg-label" style="color: var(--color-accent-300)">{t('Borrar dentro del for-each', 'Deleting inside the for-each')}</p>
			<code class="dg-code">tareas.remove(t)</code>
			<p class="dg-sub">{t('La lista cambia por fuera del iterador → ConcurrentModificationException', 'The list changes behind the iterator → ConcurrentModificationException')}</p>
		</div>
		<div class="dg-box dg-box--sage" data-el="cf-opt1">
			<p class="dg-label dg-label--sage">{t('Opción 1 · iterador explícito', 'Option 1 · explicit iterator')}</p>
			<code class="dg-code">it.remove()</code>
			<p class="dg-sub">{t('Borra Y mantiene el iterador consistente', 'Deletes AND keeps the iterator consistent')}</p>
		</div>
		<div class="dg-box dg-box--accent" data-el="cf-opt2">
			<p class="dg-label">{t('Opción 2 · desde Java 8', 'Option 2 · since Java 8')}</p>
			<code class="dg-code">tareas.removeIf(t -&gt; …)</code>
			<p class="dg-sub">{t('Una línea, sin iterador explícito', 'One line, no explicit iterator')}</p>
		</div>
		<div class="dg-box dg-box--center scene-cmefix-wide" data-el="cf-threads">
			<p class="dg-title">{t('Nada que ver con hilos', 'Nothing to do with threads')}</p>
			<p class="dg-sub">{t('Pasa igual en un programa de un solo hilo', 'It happens the same in a single-threaded program')}</p>
		</div>
	</div>

	<!-- 2b. modCount mismatch (motion canvas) -->
	<div slot="scene" data-scene="cme" data-motion class="scene-canvas">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<text class="mg-mono mg-mono--dark mg-big" x="60" y="80" data-el="decl">for (String t : tareas) {'{'} if (t.startsWith("d")) tareas.remove(t); {'}'}</text>

				<g data-el="list">
					<rect class="mg-card" x="40" y="130" width="1520" height="260" rx="22" />
					<text class="mg-text mg-text--strong mg-text--muted" x="68" y="372">tareas</text>
				</g>
				<g data-el="lmc0">
					<rect class="mg-chip" x="1290" y="146" width="240" height="40" rx="20" />
					<text class="mg-chip-text" x="1410" y="173" text-anchor="middle">modCount = 0</text>
				</g>
				<g data-el="lmc1">
					<rect class="mg-chip mg-chip--lost" x="1290" y="146" width="240" height="40" rx="20" />
					<text class="mg-chip-text" x="1410" y="173" text-anchor="middle">modCount = 1</text>
				</g>
				{
					taskNames.map((name, i) => (
						<g data-el={`t${i}`} data-x={taskCenters[i]} data-y="260">
							<rect class="mg-card mg-card--accent mg-token" x="-145" y="-55" width="290" height="110" rx="18" />
							<text class="mg-mono mg-mono--dark" x="0" y="8" text-anchor="middle">{name}</text>
						</g>
					))
				}
				{taskCenters.map((x, i) => <circle data-anchor={`sl-${i}`} cx={x} cy="260" r="2" fill="none" />)}
				{taskGaps.map((x, i) => <circle data-anchor={`gp-${i}`} cx={x} cy="165" r="2" fill="none" />)}

				<g data-el="it-card">
					<rect class="mg-card mg-card--sage" x="40" y="430" width="730" height="190" rx="22" />
					<text class="mg-heading" x="72" y="482">Iterator it</text>
					<text class="mg-text mg-text--muted" x="72" y="590">{t('Memorizó el contador al crearse', 'It memorized the counter when created')}</text>
				</g>
				<text class="mg-mono mg-mono--dark mg-big" x="72" y="548" data-el="iexp0">expectedModCount = 0</text>

				<g data-el="cur" data-x="70" data-y="165">
					<circle class="mg-dot" cx="0" cy="0" r="22" />
					<text class="mg-chip-text mg-ptr-text" x="0" y="6" text-anchor="middle">it</text>
					<path class="mg-pin" d="M-10 18L0 40L10 18Z" />
				</g>

				<g data-el="rmc">
					<rect class="mg-chip" x="800" y="430" width="760" height="56" rx="28" />
					<text class="mg-chip-text mg-chip-text--lg" x="1180" y="466" text-anchor="middle">tareas.remove("descansar")</text>
				</g>
				<g data-el="chk">
					<rect class="mg-chip mg-chip--sage" x="800" y="504" width="760" height="56" rx="28" />
					<text class="mg-chip-text mg-chip-text--sage mg-chip-text--lg" x="1180" y="540" text-anchor="middle">next():  modCount 1  ≠  expectedModCount 0</text>
				</g>
				<g data-el="boom">
					<rect class="mg-card mg-card--ink" x="800" y="578" width="760" height="64" rx="20" />
					<text class="mg-mono mg-big" x="1180" y="621" text-anchor="middle">ConcurrentModificationException</text>
				</g>
			</g>
		</svg>
	</div>

	<!-- 2c. it.remove() keeps the counters in sync (motion canvas) -->
	<div slot="scene" data-scene="rm" data-motion class="scene-canvas">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<text class="mg-mono mg-mono--dark mg-big" x="60" y="80" data-el="decl">while (it.hasNext()) {'{'} if (it.next().startsWith("d")) it.remove(); {'}'}</text>

				<g data-el="list" data-base="shown">
					<rect class="mg-card" x="40" y="130" width="1520" height="260" rx="22" />
					<text class="mg-text mg-text--strong mg-text--muted" x="68" y="372">tareas</text>
				</g>
				<g data-el="lmc0" data-base="shown">
					<rect class="mg-chip" x="1290" y="146" width="240" height="40" rx="20" />
					<text class="mg-chip-text" x="1410" y="173" text-anchor="middle">modCount = 0</text>
				</g>
				<g data-el="lmc1">
					<rect class="mg-chip mg-chip--sage" x="1290" y="146" width="240" height="40" rx="20" />
					<text class="mg-chip-text mg-chip-text--sage" x="1410" y="173" text-anchor="middle">modCount = 1</text>
				</g>
				{
					taskNames.map((name, i) => (
						<g data-el={`t${i}`} data-base="shown" data-x={taskCenters[i]} data-y="260">
							<rect class="mg-card mg-card--accent mg-token" x="-145" y="-55" width="290" height="110" rx="18" />
							<text class="mg-mono mg-mono--dark" x="0" y="8" text-anchor="middle">{name}</text>
						</g>
					))
				}
				{taskCenters.map((x, i) => <circle data-anchor={`sl-${i}`} cx={x} cy="260" r="2" fill="none" />)}
				{taskGaps.map((x, i) => <circle data-anchor={`gp-${i}`} cx={x} cy="165" r="2" fill="none" />)}

				<g data-el="it-card" data-base="shown">
					<rect class="mg-card mg-card--sage" x="40" y="430" width="730" height="190" rx="22" />
					<text class="mg-heading" x="72" y="482">Iterator it</text>
					<text class="mg-text mg-text--muted" x="72" y="590">{t('it.remove() actualiza su contador', 'it.remove() updates its counter')}</text>
				</g>
				<text class="mg-mono mg-mono--dark mg-big" x="72" y="548" data-el="iexp0" data-base="shown">expectedModCount = 0</text>
				<text class="mg-mono mg-mono--sage mg-big" x="72" y="548" data-el="iexp1">expectedModCount = 1</text>

				<g data-el="cur" data-x="70" data-y="165">
					<circle class="mg-dot" cx="0" cy="0" r="22" />
					<text class="mg-chip-text mg-ptr-text" x="0" y="6" text-anchor="middle">it</text>
					<path class="mg-pin" d="M-10 18L0 40L10 18Z" />
				</g>

				<g data-el="itrm">
					<rect class="mg-chip" x="800" y="430" width="760" height="56" rx="28" />
					<text class="mg-chip-text mg-chip-text--lg" x="1180" y="466" text-anchor="middle">it.remove()</text>
				</g>
				<g data-el="okc">
					<rect class="mg-chip mg-chip--sage" x="800" y="504" width="760" height="56" rx="28" />
					<text class="mg-chip-text mg-chip-text--sage mg-chip-text--lg" x="1180" y="540" text-anchor="middle">modCount 1  =  expectedModCount 1  ·  {t('sigue válido', 'still valid')}</text>
				</g>
			</g>
		</svg>
	</div>

	<!-- 3. Comparable -->
	<div slot="scene" data-scene="sign" class="scene-sign">
		<div class="dg-box dg-box--ink scene-sign-wide" data-el="sg-error">
			<p class="dg-label" style="color: var(--color-accent-300)">{t('Error de compilación', 'Compile error')}</p>
			<code class="dg-code">Collections.sort(libros)</code>
			<p class="dg-sub">{t('Libro no implementa Comparable: ¿ordenar por título, autor, páginas?', 'Libro does not implement Comparable: sort by title, author, pages?')}</p>
		</div>
		<div class="dg-box dg-box--accent dg-box--center" data-el="sg-neg">
			<p class="dg-title">{t('negativo', 'negative')}</p>
			<p class="dg-sub">{t('a va ANTES que b', 'a goes BEFORE b')}</p>
		</div>
		<div class="dg-box dg-box--center" data-el="sg-zero">
			<p class="dg-title">{t('cero', 'zero')}</p>
			<p class="dg-sub">{t('son equivalentes', 'they are equivalent')}</p>
		</div>
		<div class="dg-box dg-box--sage dg-box--center" data-el="sg-pos">
			<p class="dg-title">{t('positivo', 'positive')}</p>
			<p class="dg-sub">{t('a va DESPUÉS que b', 'a goes AFTER b')}</p>
		</div>
		<div class="dg-box dg-box--ink scene-sign-wide" data-el="sg-trap">
			<p class="dg-label" style="color: var(--color-accent-300)">{t('La trampa clásica', 'The classic trap')}</p>
			<code class="dg-code">return this.edad - otro.edad;</code>
			<p class="dg-sub">{t('Con valores grandes desborda el int y el signo sale mal. Usá Integer.compare.', 'With large values it overflows the int and the sign is wrong. Use Integer.compare.')}</p>
		</div>
	</div>

	<!-- 4. Comparable vs Comparator -->
	<div slot="scene" data-scene="cmpvs" class="scene-cmpvs">
		<div class="dg-box dg-box--sage" data-el="cv-comparable">
			<p class="dg-label dg-label--sage">Comparable</p>
