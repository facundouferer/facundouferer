---
/**
 * Scene for "An address that points" (lesson c/punteros-y-direcciones), a short
 * film played on one persistent motion canvas. The captions and cues live in
 * `src/data/animations/punteros-direcciones-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: the
 * program, with a bar that slides to the line being executed and the program
 * output typed below it. The viewport on the right holds the camera: memory as a
 * row of numbered cells (the value on top, the address on the front edge), one
 * module per instruction labelled with its editor line, and pointers drawn as
 * arrows from the cell that stores an address to the cell that lives there.
 * Light blue is the execution flow and the values it carries; violet is a pointer
 * and what it reaches; magenta is the null pointer and the invalid dereference.
 *
 * Addresses are illustrative (0x1000, 0x1004, 0x2000...): real ones are longer
 * and change on every run, as the narration says.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/punteros-direcciones-c';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── The program shown in the editor ───────────────────────────────────────
// The lesson's `intercambiar` (`swap` in English), localized like the lesson does.
const names = {
	swap: t('intercambiar', 'swap'),
	tmp: t('aux', 'tmp'),
	file: t('punteros.c', 'pointers.c'),
};
const program = [
	'#include <stdio.h>',
	'',
	`void ${names.swap}(int *a, int *b) {`,
	`    int ${names.tmp} = *a;`,
	'    *a = *b;',
	`    *b = ${names.tmp};`,
	'}',
	'',
	'int main(void) {',
	'    int x = 10;',
	'    printf("&x = %p\\n", (void *)&x);',
	'    int *p = &x;',
	'    printf("x = %d, *p = %d\\n", x, *p);',
	'    *p = 20;',
	'    int y = 3;',
	`    ${names.swap}(&x, &y);`,
	'    printf("x = %d, y = %d\\n", x, y);',
	`    p = NULL;   /* ${t('ahora *p sería inválido', 'now *p would be invalid')} */`,
	'    return 0;',
	'}',
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const lines = highlightCode(program, 'c').map((html, index) => ({
	n: index + 1,
	html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
}));

// What the program prints. The address is illustrative: real ones vary per run.
const outputs = ['&x = 0x1000', 'x = 10, *p = 10', 'x = 3, y = 20'];

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 72;
const LINE_H = 21;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 5;
const CONSOLE_TOP = 512;
const outY = (row: number) => 562 + row * 26;

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up. Memory lies on the line
// v = 0; the cells of the called function on a row in front; the instruction
// modules of `main` stand in a row behind.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 56;
const EY = 32;
const ORIGIN = { x: 602, y: 350 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');

/** A box standing on the floor at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		face: faceCenter,
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
	};
}
type Slab = ReturnType<typeof slab>;
type Tone = 'flow' | 'violet' | 'magenta';

// Memory cells: the value sits on top, the address of the first byte on the front edge.
const CELL = { a: 0.44, h: 16 };
const MEM_V = 0;
const FN_V = 2.5;
type Cell = { id: string; u: number; v: number; addr: string; name?: string; g: Slab };
const cell = (id: string, u: number, v: number, addr: string, name?: string): Cell => ({
	id,
	u,
	v,
	addr,
	name,
	g: slab(u, v, CELL.a, CELL.a, CELL.h),
});
const memCells: Cell[] = [
	cell('ffc', -2.9, MEM_V, '0x0ffc'),
	cell('x', -1.9, MEM_V, '0x1000', 'x'),
	cell('y', -0.9, MEM_V, '0x1004', 'y'),
	cell('1008', 0.1, MEM_V, '0x1008'),
	cell('p', 1.8, MEM_V, '0x2000', 'p'),
	cell('2008', 2.8, MEM_V, '0x2008'),
];
const fnCells: Cell[] = [cell('a', -0.6, FN_V, '0x3000', 'a'), cell('b', 0.4, FN_V, '0x3008', 'b'), cell('aux', 1.4, FN_V, '0x3010', names.tmp)];
const cellOf = (id: string) => [...memCells, ...fnCells].find((item) => item.id === id) as Cell;
const DOTS = pt(0.95, MEM_V, 10);

// Floor plates: the row of memory and, in front, the cells of the called function.
const plates = [
	{ id: 'plate-main', g: slab(-0.05, MEM_V, 3.3, 0.7, 8, -8), label: t('memoria de main', "main's memory"), at: pt(-3.0, 0.7, -8) },
	{ id: 'plate-fn', g: slab(1.15, FN_V, 2.25, 0.6, 8, -8), label: `${names.swap}(a, b)`, at: pt(-0.6, FN_V + 0.6, -8) },
];

// Values: each state of a cell is its own text, swapped in place on the same cell.
type Value = { id: string; cell: string; text: string; tone: Tone | 'plain' };
const values: Value[] = [
	{ id: 'v-x-10', cell: 'x', text: '10', tone: 'plain' },
	{ id: 'v-x-20', cell: 'x', text: '20', tone: 'flow' },
	{ id: 'v-x-3', cell: 'x', text: '3', tone: 'flow' },
	{ id: 'v-y-3', cell: 'y', text: '3', tone: 'plain' },
	{ id: 'v-y-20', cell: 'y', text: '20', tone: 'flow' },
	{ id: 'v-p-1000', cell: 'p', text: '0x1000', tone: 'violet' },
	{ id: 'v-p-null', cell: 'p', text: 'NULL', tone: 'magenta' },
	{ id: 'v-a', cell: 'a', text: '0x1000', tone: 'violet' },
	{ id: 'v-b', cell: 'b', text: '0x1004', tone: 'violet' },
	{ id: 'v-aux', cell: 'aux', text: '20', tone: 'flow' },
];

// Instruction modules: one per instruction, labelled with its editor line.
type Module = { line: number; g: Slab; tone: Tone };
const MAIN_LINES: [number, Tone][] = [
	[10, 'flow'],
	[11, 'flow'],
	[12, 'violet'],
	[13, 'violet'],
	[14, 'violet'],
	[15, 'flow'],
	[16, 'violet'],
	[17, 'flow'],
	[18, 'magenta'],
	[19, 'flow'],
];
const FN_LINES: [number, Tone][] = [
	[4, 'violet'],
	[5, 'violet'],
	[6, 'violet'],
];
const block = (u: number, v: number) => slab(u, v, 0.2, 0.2, 16);
const modules: Module[] = [
	...MAIN_LINES.map(([line, tone], index) => ({ line, tone, g: block(-3.7 + index * 0.64, -2.6) })),
	...FN_LINES.map(([line, tone], index) => ({ line, tone, g: block(2.2 + index * 0.45, FN_V) })),
];

// Pointers: one visual identity, an arrow from the cell that stores the address to
// the object that lives there (or, for NULL, to nowhere).
const VOID = pt(2.75, 2.1);
function arrow(from: Point, to: Point, rise: number) {
	const control = { x: round((from.x + to.x) / 2), y: round(Math.min(from.y, to.y) - rise) };
	const dx = to.x - control.x;
	const dy = to.y - control.y;
	const length = Math.hypot(dx, dy);
	const ux = dx / length;
	const uy = dy / length;
	const base = { x: to.x - ux * 13, y: to.y - uy * 13 };
	const head = [to, { x: round(base.x - uy * 7), y: round(base.y + ux * 7) }, { x: round(base.x + uy * 7), y: round(base.y - ux * 7) }];
	const end = { x: round(to.x - ux * 9), y: round(to.y - uy * 9) };
	return {
		d: `M${from.x} ${from.y} Q${control.x} ${control.y} ${end.x} ${end.y}`,
		head: poly(head),
	};
}
const tail = (id: string) => {
	const item = cellOf(id);
	return pt(item.u - 0.2, item.v - 0.2, CELL.h);
};
const tip = (id: string) => lift(cellOf(id).g.center, 16);
const arrows = [
	{ id: 'ar-p', tone: 'violet', ...arrow(tail('p'), tip('x'), 120) },
	{ id: 'ar-a', tone: 'violet', ...arrow(tail('a'), tip('x'), 50) },
	{ id: 'ar-b', tone: 'violet', ...arrow(tail('b'), tip('y'), 50) },
	{ id: 'ar-null', tone: 'magenta', ...arrow(tail('p'), lift(VOID, 4), 60) },
];

// Where things stop: above a module, on top of a cell, on an address, beside a cell.
const anchors = [
	...modules.map((module) => ({ id: `a-m${module.line}`, ...lift(module.g.center, 16) })),
	...[...memCells, ...fnCells].map((item) => ({ id: `a-top-${item.id}`, ...lift(item.g.center, 2) })),
	{ id: 'a-face-x', ...cellOf('x').g.face },
	{ id: 'a-face-y', ...cellOf('y').g.face },
	{ id: 'a-above-x', ...lift(cellOf('x').g.center, 70) },
	{ id: 'a-void', ...lift(VOID, 4) },
];
const at = (id: string) => anchors.find((anchor) => anchor.id === id) ?? { x: 0, y: 0 };

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shotAt = (id: string, center: Point, s: number) => ({
	id,
	x: round(center.x - 640 / s),
	y: round(center.y - 360 / s),
	w: round(1280 / s),
	h: round(720 / s),
});
const shots = [
	shotAt('shot-mem', lift(pt(-0.05, MEM_V), 30), 1.05),
	shotAt('shot-x', lift(pt(-1.5, MEM_V), 30), 1.4),
	shotAt('shot-ptr', lift(pt(-0.05, MEM_V), 60), 1.2),
	shotAt('shot-call', lift(pt(-0.3, 1.3), 40), 1.08),
	shotAt('shot-null', lift(pt(1.6, 1.1), 40), 1.25),
];

// Travelling chips: one identity for "a value or an address on its way".
type Packet = { id: string; text: string; from: string; tone: Tone };
const packets: Packet[] = [
	{ id: 'cp-x', text: '&x = 0x1000', from: 'a-face-x', tone: 'flow' },
	{ id: 'pr', text: '*p', from: 'a-top-p', tone: 'violet' },
	{ id: 'rd', text: '10', from: 'a-top-x', tone: 'flow' },
	{ id: 'wr', text: '20', from: 'a-m14', tone: 'flow' },
	{ id: 'cp-a', text: '&x = 0x1000', from: 'a-face-x', tone: 'violet' },
	{ id: 'cp-b', text: '&y = 0x1004', from: 'a-face-y', tone: 'violet' },
	{ id: 'k1', text: '20', from: 'a-top-x', tone: 'flow' },
	{ id: 'k2', text: '3', from: 'a-top-y', tone: 'flow' },
	{ id: 'k3', text: '20', from: 'a-top-aux', tone: 'flow' },
	{ id: 'pn', text: '*p', from: 'a-top-p', tone: 'magenta' },
];
const packetWidth = (packet: Packet) => Math.round(packet.text.length * 7.8 + 24);

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = { id: string; text: string; x: number; y: number; align: 'start' | 'end' | 'middle'; tone: 'plain' | Tone; mono?: boolean };
const X = cellOf('x').g;
const P = cellOf('p').g;
const chips: Chip[] = [
	{ id: 'lb-addr', text: t('dirección (primer byte)', 'address (first byte)'), x: X.face.x + 24, y: X.face.y + 46, align: 'middle', tone: 'flow' },
	{ id: 'lb-val', text: t('valor', 'value'), x: X.center.x - 40, y: X.center.y - 37, align: 'end', tone: 'plain' },
	{ id: 'lb-ptr', text: t('p apunta a x', 'p points to x'), x: P.center.x, y: P.center.y + 60, align: 'middle', tone: 'violet' },
	{ id: 'lb-same', text: t('p sigue valiendo 0x1000', 'p is still 0x1000'), x: P.center.x, y: P.center.y + 60, align: 'middle', tone: 'violet' },
	{
		id: 'lb-copy',
		text: t('copias de las direcciones', 'copies of the addresses'),
		x: cellOf('b').g.center.x,
		y: cellOf('b').g.center.y + 70,
		align: 'middle',
		tone: 'violet',
	},
	{ id: 'lb-void', text: t('no apunta a nada', 'points to nothing'), x: VOID.x, y: VOID.y + 40, align: 'middle', tone: 'magenta' },
	{ id: 'lb-ub', text: t('comportamiento indefinido', 'undefined behavior'), x: VOID.x, y: VOID.y - 62, align: 'middle', tone: 'magenta' },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.9) + 26);
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

// Lit states of the cells that the cues highlight.
const litCells: { id: string; cell: string; tone: Tone }[] = [
	{ id: 'lit-x', cell: 'x', tone: 'flow' },
	{ id: 'lit-y', cell: 'y', tone: 'flow' },
	{ id: 'lit-p', cell: 'p', tone: 'violet' },
	{ id: 'lit-pn', cell: 'p', tone: 'magenta' },
];

const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="pd-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="pd-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="pd-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="pd-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="pd-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="pd-g-void">
					<stop offset="0" class="xj-stop-magenta" stop-opacity="0.28"></stop>
					<stop offset="1" class="xj-stop-magenta" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="pd-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: memory as numbered cells, seen through the camera -->
			<g clip-path="url(#pd-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#pd-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#pd-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- Floor plates -->
						{
							plates.map((plate) => (
								<g data-el={plate.id}>
									<polygon class="xj-plate-shadow" points={plate.g.base} transform="translate(12 18)" />
									<polygon class="xj-plate xj-plate--l" points={plate.g.leftFace} />
									<polygon class="xj-plate xj-plate--r" points={plate.g.rightFace} />
									<polygon class="xj-plate xj-plate--t" points={plate.g.top} fill="url(#pd-g-floor)" />
									<text class="xj-area-label" x={plate.at.x} y={plate.at.y + 34} text-anchor="middle">
										{plate.label}
									</text>
								</g>
							))
						}

						<!-- Instruction modules: one per instruction, labelled with its editor line -->
						{
							modules.map((module) => (
								<>
									<g data-el={`m-${module.line}`} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#pd-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
									<g data-el={`on-${module.line}`} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
										<polygon class="xj-lit-halo" points={module.g.top} />
										<polygon class="xj-lit-top" points={module.g.top} />
										<polygon class="xj-lit-side" points={module.g.leftFace} />
										<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
								</>
							))
						}

						<!-- The void a null pointer aims at -->
						<g data-el="void" class="xj-void">
							<ellipse cx={VOID.x} cy={VOID.y} rx="62" ry="36" fill="url(#pd-g-void)"></ellipse>
							<ellipse class="xj-void-ring" cx={VOID.x} cy={VOID.y} rx="40" ry="23"></ellipse>
						</g>

						<!-- Memory cells: value on top, address of the first byte on the front edge -->
						{
							[...memCells, ...fnCells].map((item) => (
								<g data-el={`c-${item.id}`} class:list={['xj-cell', !item.name && 'xj-cell--free']}>
									<polygon class="xj-shadow" points={item.g.base} transform="translate(6 8)" />
									<polygon class="xj-face xj-face--l" points={item.g.leftFace} />
									<polygon class="xj-face xj-face--r" points={item.g.rightFace} />
									<polygon class="xj-face xj-face--t" points={item.g.top} fill="url(#pd-g-top)" />
									<text class="xj-addr" transform={item.g.faceMatrix} text-anchor="middle" y="4">
										{item.addr}
									</text>
								</g>
							))
						}
						<text data-el="dots" class="xj-dots" x={DOTS.x} y={DOTS.y} text-anchor="middle">
							···
						</text>

						<!-- The address of x, ringed when & reads it -->
						<g data-el="ad-x" class="xj-ring">
							<polygon points={cellOf('x').g.leftFace}></polygon>
						</g>

						{
							litCells.map((lit) => (
								<g data-el={lit.id} class:list={['xj-lit', `xj-lit--${lit.tone}`]}>
									<polygon class="xj-lit-halo" points={cellOf(lit.cell).g.top} />
									<polygon class="xj-lit-top xj-lit-top--soft" points={cellOf(lit.cell).g.top} />
								</g>
							))
						}

						<!-- Names, above the cells they label -->
						{
							[...memCells, ...fnCells]
								.filter((item) => item.name)
								.map((item) => (
									<g data-el={`n-${item.id}`} class="xj-name">
										<rect x={item.g.center.x - 22} y={item.g.center.y - 48} width="44" height="22" rx="11" />
										<text x={item.g.center.x} y={item.g.center.y - 32.5} text-anchor="middle">
											{item.name}
										</text>
									</g>
								))
						}

						<!-- Pointers: arrows from the stored address to the object it locates -->
						{
							arrows.map((item) => (
								<g data-el={item.id} class:list={['xj-arrow', `xj-arrow--${item.tone}`]}>
									<path class="mg-stroke xj-arrow-halo" pathLength="1" d={item.d} />
									<path class="mg-stroke xj-arrow-core" pathLength="1" d={item.d} />
									<polygon class="mg-head xj-arrow-head" points={item.head} />
								</g>
							))
						}

						<!-- Values: each state is swapped in place on the same cell -->
						{
							values.map((value) => (
								<text
									data-el={value.id}
									class:list={['xj-val', `xj-val--${value.tone}`]}
									x={cellOf(value.cell).g.center.x}
									y={cellOf(value.cell).g.center.y + 5}
									text-anchor="middle"
								>
									{value.text}
								</text>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									<text class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'} x={chipLeft(chip) + chipWidth(chip) / 2} y={chip.y + 4.5} text-anchor="middle">
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- The invalid dereference of a null pointer -->
						<g data-el="bad" class="xj-bad">
							<circle cx={VOID.x} cy={VOID.y - 4} r="16"></circle>
							<svg x={VOID.x - 10} y={VOID.y - 14} width="20" height="20" viewBox="0 0 24 24" stroke-width="2.75">
								<path d="M18 6 6 18"></path>
								<path d="m6 6 12 12"></path>
							</svg>
						</g>

						<!-- Travelling chips. Placement lives on the inner group: the player resets data-el transforms. -->
						{
							packets.map((packet) => (
								<g data-el={packet.id} data-x={at(packet.from).x} data-y={at(packet.from).y}>
									<g class:list={['xj-packet', `xj-packet--${packet.tone}`]}>
										<rect class="xj-packet-halo" x={-packetWidth(packet) / 2 - 5} y="-18" width={packetWidth(packet) + 10} height="36" rx="18" />
										<rect class="xj-packet-card" x={-packetWidth(packet) / 2} y="-13" width={packetWidth(packet)} height="26" rx="13" />
										<text class="xj-packet-text" x="0" y="4.5" text-anchor="middle">
											{packet.text}
										</text>
									</g>
								</g>
							))
						}

						<!-- The execution flow -->
						<g data-el="fx" class="xj-particle" data-x={at('a-m10').x} data-y={at('a-m10').y}>
							<circle r="20" fill="url(#pd-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="470" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<path class="xj-legend-arrow" d={`M${VP.x + 178} ${LEGEND_Y} h20`}></path>
				<path class="xj-legend-head" d={`M${VP.x + 198} ${LEGEND_Y - 5} l7 5 l-7 5 z`}></path>
				<text x={VP.x + 214} y={LEGEND_Y + 4}>{t('Puntero', 'Pointer')}</text>
				<rect class="xj-legend-cell" x={VP.x + 290} y={LEGEND_Y - 7} width="18" height="14" rx="3"></rect>
				<text x={VP.x + 316} y={LEGEND_Y + 4}>{t('Celda con su dirección', 'Cell and its address')}</text>
			</g>

			<!-- EDITOR: the program, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.file}</text>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<g data-el="mark-18" class="xj-mark">
					<rect x={BAR.x} y={lineTop(18)} width={BAR.w} height={LINE_H} rx="6"></rect>
				</g>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(10)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<g data-el="ed" data-base="shown" class="xj-code">
					{
						lines.map((line) => (
							<g>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				<!-- Console: what the program prints -->
				{
					outputs.map((row, index) => (
						<text data-el={`o-${index + 1}`} class="xj-out" x={ED.x + 20} y={outY(index)} xml:space="preserve">
							{row}
						</text>
					))
				}
				{lines.map((line) => <circle data-anchor={`ln-${line.n}`} cx={BAR_CX} cy={lineMid(line.n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
