		program,
		line,
		tone: (MODULE_TONE[`${program}-${line}`] ?? 'flow') as Tone,
		g: blockAt({ x: round(RAIL_CENTER[program] + (index - (all.length - 1) / 2) * RAIL_GAP), y: RAIL_Y }),
	})),
);

