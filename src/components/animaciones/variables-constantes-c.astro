	{ id: 'tk-precio', world: 'main', text: '1500.0', tone: 'flow', home: 'a-m-main-8' },
	{ id: 'tk-inicial', world: 'main', text: "'F'", tone: 'flow', home: 'a-m-main-9' },
	{ id: 'tx-src', world: 'main', text: n.months, tone: 'violet', home: 'a-m-main-16', dashed: true },
	{ id: 'tx-out', world: 'main', text: '12', tone: 'violet', home: 'a-st', dashed: true },
	{ id: 'lo-1', world: 'bug', text: '7', tone: 'dim', home: 'a-lo-1' },
	{ id: 'lo-2', world: 'bug', text: '-3', tone: 'dim', home: 'a-lo-2' },
	{ id: 'lo-3', world: 'bug', text: '91', tone: 'dim', home: 'a-lo-3' },
	{ id: 'tk-q', world: 'bug', text: '?', tone: 'magenta', home: 'a-b-total' },
	{ id: 'tk-zero', world: 'bug', text: '0', tone: 'violet', home: 'a-m-bug-4' },
	{ id: 'tk-dec', world: 'lit', text: '255', tone: 'flow', home: 'a-m-lit-4' },
	{ id: 'tk-n', world: 'lit', text: '100', suffix: 'u', tone: 'flow', home: 'a-m-lit-5' },
	{ id: 'tk-pi', world: 'lit', text: '3.14159', tone: 'flow', home: 'a-m-lit-6' },
	{ id: 'tk-g', world: 'lit', text: '9.81', suffix: 'f', tone: 'flow', home: 'a-m-lit-7' },
	{ id: 'tk-days', world: 'const', text: '7', tone: 'violet', home: 'a-m-const-2' },
	{ id: 'tk-try', world: 'const', text: '8', tone: 'magenta', home: 'a-m-const-3' },
];
const tokenWidth = (token: Token) => Math.max(44, Math.round((token.text.length + (token.suffix?.length ?? 0)) * 9.2 + 26));

// Failing lines of the editor are marked with a magenta bar.
const marks = [
	{ id: 'hx-bug-5', program: 'bug' as Program, line: 5 },
	{ id: 'hx-const-3', program: 'const' as Program, line: 3 },
	{ id: 'hx-macro-6', program: 'macro' as Program, line: 6 },
];

const LEGEND_Y = VP.y + VP.h - 22;
const firstLine = (program: Program) => (program === 'main' ? 6 : SHAPE[program].modules[0]);
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="vc-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="vc-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<radialGradient id="vc-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="vc-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="vc-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the isometric world, seen through the camera -->
			<g clip-path="url(#vc-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#vc-g-pool-violet)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#vc-g-pool-flow)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- The rail the instructions sit on -->
						<path class="xj-track" d={`M380 ${RAIL_Y} H980`}></path>

						<!-- The preprocessor: where the text of a #define is swapped -->
						<g data-el="st-pp">
							<polygon class="xj-shadow" points={STATION.base} transform="translate(8 11)" />
							<polygon class="xj-station xj-station--l" points={STATION.leftFace} />
							<polygon class="xj-station xj-station--r" points={STATION.rightFace} />
							<polygon class="xj-station xj-station--t" points={STATION.top} fill="url(#vc-g-top)" />
							<text class="xj-face-text" transform={STATION.faceMatrix} text-anchor="middle" y="4">#define</text>
						</g>
						<g data-el="on-st" class="xj-lit xj-lit--violet">
							<polygon class="xj-lit-halo" points={STATION.top} />
							<polygon class="xj-lit-top" points={STATION.top} />
							<polygon class="xj-lit-side" points={STATION.leftFace} />
							<text class="xj-face-text xj-face-text--on" transform={STATION.faceMatrix} text-anchor="middle" y="4">#define</text>
						</g>
						<g data-el={PP_CHIP.id} class:list={['xj-chip', `xj-chip--${PP_CHIP.tone}`]}>
							<rect x={chipLeft(PP_CHIP)} y={PP_CHIP.y - 12} width={chipWidth(PP_CHIP)} height="24" rx="12" />
							<text class="xj-chip-text" x={PP_CHIP.x} y={PP_CHIP.y + 4.5} text-anchor="middle">{PP_CHIP.text}</text>
						</g>

						<!-- One world per program: its boxes, modules, routes, notes and values -->
						{
							PROGRAMS.map((program) => (
								<g data-el={`w-${program}`}>
									{
										program === 'main' && (
											<g data-el="gh-def" class="xj-ghost">
												<polygon class="xj-ghost-plate" points={GHOST.base} />
												<rect class="xj-tag-box xj-tag-box--ghost" x={GHOST_GROUND.x - GHOST_TAG.w / 2} y={GHOST_TAG.y - 18} width={GHOST_TAG.w} height="36" rx="9" />
												<text class="xj-tag-type" x={GHOST_GROUND.x} y={GHOST_TAG.y - 3} text-anchor="middle">{t('sin tipo', 'no type')}</text>
												<text class="xj-tag-name" x={GHOST_GROUND.x} y={GHOST_TAG.y + 12} text-anchor="middle">{n.months}</text>
											</g>
										)
									}
									{
										boxes
											.filter((box) => box.world === program)
											.map((box) => (
												<g data-el={box.id} class={`xj-box xj-box--${box.tone}`}>
													<polygon class="xj-shadow" points={box.g.base} transform="translate(6 9)" />
													<polygon class="xj-cell xj-cell--l" points={box.g.leftFace} />
													<polygon class="xj-cell xj-cell--r" points={box.g.rightFace} />
													<polygon class="xj-cell xj-cell--t" points={box.g.top} />
													<rect class="xj-tag-box" x={box.ground.x - box.tagWidth / 2} y={box.tagY - 18} width={box.tagWidth} height="36" rx="9" />
													<text class="xj-tag-type" x={box.ground.x} y={box.tagY - 3} text-anchor="middle">{box.type}</text>
													<text class="xj-tag-name" x={box.ground.x} y={box.tagY + 12} text-anchor="middle">{box.name}</text>
												</g>
											))
									}
									{
										modules
											.filter((module) => module.program === program)
											.map((module) => (
												<>
													<g data-el={`m-${program}-${module.line}`} class="xj-mod">
														<polygon class="xj-shadow" points={module.g.base} transform="translate(5 7)" />
														<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
														<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
														<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#vc-g-top)" />
														<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4">
															{module.line}
														</text>
													</g>
													<g data-el={`on-${program}-${module.line}`} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
														<polygon class="xj-lit-halo" points={module.g.top} />
														<polygon class="xj-lit-top" points={module.g.top} />
														<polygon class="xj-lit-side" points={module.g.leftFace} />
														<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4">
															{module.line}
														</text>
													</g>
												</>
											))
									}
									{
										routes
											.filter((route) => route.world === program)
											.map((route) => (
												<g data-el={route.id} class:list={['xj-flowline', `xj-flowline--${route.tone}`]}>
													<path class="mg-stroke xj-flowline-halo" pathLength="1" d={route.d} />
													<path class="mg-stroke xj-flowline-core" pathLength="1" d={route.d} />
												</g>
											))
									}
									{
										icons
											.filter((icon) => icon.world === program)
											.map((icon) => (
												<g data-el={icon.id} class:list={['xj-sign', `xj-sign--${icon.tone}`]}>
													<svg class="xj-sign-icon" x={icon.x - icon.size / 2} y={icon.y - icon.size / 2} width={icon.size} height={icon.size} viewBox="0 0 24 24" stroke-width="2.75">
														{
															icon.kind === 'lock' ? (
																<>
																	<rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
																	<path d="M7 11V7a5 5 0 0 1 10 0v4" />
																</>
															) : (
																<>
																	<circle cx="12" cy="12" r="10" />
																	<path d="m4.9 4.9 14.2 14.2" />
																</>
															)
														}
													</svg>
												</g>
											))
									}
									{
										chips
											.filter((chip) => chip.world === program)
											.map((chip) => (
												<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
													<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
													{chip.icon === 'arrow' && (
														<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
															<path d="M5 12h14" />
															<path d="m12 5 7 7-7 7" />
														</svg>
													)}
													<text
														class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
														x={chip.x + (chip.icon ? 9 : 0)}
														y={chip.y + 4.5}
														text-anchor="middle"
													>
														{chip.text}
													</text>
												</g>
											))
									}
									<!-- Value tokens. Placement lives on the inner group: the player resets data-el transforms. -->
									{
										tokens
											.filter((token) => token.world === program)
											.map((token) => {
												const w = tokenWidth(token);
												return (
													<g data-el={token.id} data-x={at(token.home).x} data-y={at(token.home).y}>
														<g class:list={['xj-token', `xj-token--${token.tone}`, token.dashed && 'xj-token--text']}>
															<rect class="xj-token-halo" x={-w / 2 - 5} y="-19" width={w + 10} height="38" rx="19" />
															<rect class="xj-token-card" x={-w / 2} y="-14" width={w} height="28" rx="14" />
															<text class={token.dashed ? 'xj-token-text xj-token-text--mono' : 'xj-token-text'} x="0" y="5.5" text-anchor="middle">
																{token.text}{token.suffix && <tspan class="xj-token-suffix">{token.suffix}</tspan>}
															</text>
														</g>
													</g>
												);
											})
									}
								</g>
							))
						}

						<!-- The execution flow: it goes from module to module -->
						<g data-el="p" class="xj-particle" data-x={moduleAt('main', 6).x} data-y={moduleAt('main', 6).y}>
							<circle r="20" fill="url(#vc-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="420" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo / ejecución', 'Flow / execution')}</text>
				<rect class="xj-legend-token" x={VP.x + 172} y={LEGEND_Y - 7} width="20" height="14" rx="7"></rect>
				<text x={VP.x + 200} y={LEGEND_Y + 4}>{t('Un valor', 'A value')}</text>
				<rect class="xj-legend-slot" x={VP.x + 290} y={LEGEND_Y - 6} width="22" height="12" rx="3"></rect>
				<text x={VP.x + 320} y={LEGEND_Y + 4}>{t('Una caja', 'A box')}</text>
			</g>

			<!-- EDITOR: the lesson's programs, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(firstLine('main'))}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				{
					PROGRAMS.map((program) => (
						<>
							<g data-el={`ed-${program}`} class="xj-code">
								<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{files[program]}</text>
								{
									marks
										.filter((mark) => mark.program === program)
										.map((mark) => (
											<g data-el={mark.id} class="xj-hx">
												<rect x={BAR.x} y={lineTop(mark.line)} width={BAR.w} height={LINE_H} rx="6"></rect>
											</g>
										))
								}
								{
									listing(program).map((line) => (
										<g>
											<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
												{line.n}
											</text>
											<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
										</g>
									))
								}
							</g>
							<g data-el={`co-${program}`}>
								{
									outputs[program].map((row, index) => (
										<text data-el={`out-${program}-${index + 1}`} class="xj-out" x={ED.x + 20} y={outY(index)} xml:space="preserve">
											{row}
										</text>
									))
								}
							</g>
						</>
					))
				}
				{PROGRAMS.flatMap((program) => Array.from({ length: SHAPE[program].lines }, (_, index) => <circle data-anchor={`ln-${program}-${index + 1}`} cx={BAR_CX} cy={lineMid(index + 1)} r="1" fill="none" />))}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue flow and values, magenta for the bug and the refusal (the indeterminate
	   value, the assignment to a constant, the wrong result) and violet for what
	   handles it (the lock, the preprocessor, the fix). Every rule below reads these
	   tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='variables-constantes-c']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='variables-constantes-c'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='variables-constantes-c'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='variables-constantes-c'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-track {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 3;
		stroke-dasharray: 3 9;
		stroke-linecap: round;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-token {
		fill: var(--xj-ink);
		stroke: var(--xj-flow);
		stroke-width: 1.5;
	}

	.xj-legend-slot {
		fill: var(--xj-deep-hi);
		stroke: var(--xj-flow);
		stroke-width: 1.5;
	}

	/* Modules */
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-face-text {
		font-family: var(--font-body);
		font-size: 11px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face-text--on {
		fill: var(--xj-ink);
	}

	/* The preprocessor */
	.xj-station {
		stroke: var(--xj-violet);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-station--l {
		fill: var(--xj-violet-deep);
	}

	.xj-station--r {
		fill: var(--xj-deep);
	}

	/* Variables: a box with its tag (type and name); the value rests on top */
	.xj-box {
		--xj-box: var(--xj-flow);
	}

	.xj-box--violet {
		--xj-box: var(--xj-violet);
	}

	.xj-box--magenta {
		--xj-box: var(--xj-magenta);
	}

	.xj-cell {
		stroke: var(--xj-box);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-cell--l {
		fill: var(--xj-steel);
	}

	.xj-cell--r {
		fill: var(--xj-deep);
	}

	.xj-cell--t {
		fill: var(--xj-ink);
	}

