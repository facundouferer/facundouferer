];
const BOX_H = 24;
const boxes = boxDefs.map((box) => {
	const tagWidth = Math.round(Math.max(box.type.length, box.name.length) * 7.2 + 22);
	return { ...box, g: slab(box.ground, 0.55, 0.55, BOX_H), tagWidth, tagY: box.ground.y - 86 };
});
