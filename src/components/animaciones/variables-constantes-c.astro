	bug: { lines: 8, modules: [4, 5, 6], outputs: 2 },
	lit: { lines: 11, modules: [4, 5, 6, 7, 8, 9], outputs: 2 },
	const: { lines: 5, modules: [2, 3], outputs: 2 },
	macro: { lines: 9, modules: [3, 6, 7], outputs: 1 },
