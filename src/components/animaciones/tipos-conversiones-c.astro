---
/**
 * Scene for "Boxes of bits: types, sizes and conversions" (lesson
 * c/05-tipos-de-datos, order: 5), a short film played on one persistent motion
 * canvas. The captions and cues live in `src/data/animations/tipos-conversiones-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: the C
 * program, with a bar that slides to the line being executed and the real output
 * typed in the console below. The viewport on the right holds the camera: every
 * value lives in an isometric box made of bytes (one cell per byte), labelled with
 * its name and type. Declarations build their box (its editor line on the front
 * face); statements run on numbered machines. Values travel as tokens. `sizeof`
 * measures boxes with violet rulers; the `int` at `INT_MAX` refuses one more
 * behind a magenta wall; the `unsigned int` wraps around to 0; `7 / 2` drops a
 * magenta fraction; the `(double)` cast converts first; and the -1 of `-1 < 1u`
 * becomes a huge unsigned value.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/tipos-conversiones-c';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── The program shown in the editor ───────────────────────────────────────
// Identifiers are the lesson's own, localized like it does.
const names = {
	alt: t('altura', 'height'),
	cnt: t('contador', 'counter'),
	neg: t('menosUno', 'minusOne'),
	one: t('uno', 'one'),
	file: t('tipos.c', 'types.c'),
};

const program = [
	'#include <stdio.h>',
	'#include <limits.h>',
	'',
	'int main(void) {',
	`    double ${names.alt} = 1.75;`,
	'    size_t bytes = sizeof(int);',
	`    printf("%zu %zu %zu\\n", sizeof(char), bytes, sizeof ${names.alt});`,
	`    printf("%d\\n", INT_MAX);   // INT_MAX + 1: ${t('indefinido', 'undefined')}`,
	`    unsigned int ${names.cnt} = UINT_MAX;`,
	`    ${names.cnt} = ${names.cnt} + 1u;`,
	`    printf("%u\\n", ${names.cnt});`,
	'    int a = 7, b = 2;',
	'    printf("%d %f\\n", a / b, (double)a / b);',
	`    int ${names.neg} = -1;`,
	`    unsigned int ${names.one} = 1u;`,
	`    printf("%d\\n", ${names.neg} < ${names.one});`,
	'    return 0;',
	'}',
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const lines = highlightCode(program, 'c').map((html, index) => ({
	n: index + 1,
	html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
}));

// The real output of the program (cc -std=c23 on a 64-bit machine), one piece per print.
const outputs = [
	{ id: 'o-7', row: 0, text: '1 4 8' },
	{ id: 'o-8', row: 1, text: '2147483647' },
	{ id: 'o-11', row: 2, text: '0' },
	{ id: 'o-13a', row: 3, text: '3' },
	{ id: 'o-13b', row: 3, text: '  3.500000' },
	{ id: 'o-16', row: 4, text: '0' },
];

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 70;
const LINE_H = 22;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 4.5;
const CONSOLE_TOP = 482;
const outY = (row: number) => 534 + row * 26;
const WARN_LINES = [8, 16];

// ── Isometric world (camera space) ────────────────────────────────────────
// A box is a row of byte cells: one cell steps `DU` along its length, `DV` is its
// depth and `BH` its height. `O` is the back corner of its top face.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const DU = { x: 20, y: 11.5 };
const DV = { x: -20, y: 11.5 };
const BH = 20;
const round = (value: number) => Math.round(value * 10) / 10;
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const SKEW = (point: Point) => `matrix(0.866 0.5 0 1 ${point.x} ${point.y})`;

function box(ox: number, oy: number, n: number) {
	/** Point `k` cells along, `d` deep, `z` below the top face. */
	const P = (k: number, d = 0, z = 0): Point => ({
		x: round(ox + k * DU.x + d * DV.x),
		y: round(oy + k * DU.y + d * DV.y + z),
	});
	return {
		n,
		top: poly([P(0), P(n), P(n, 1), P(0, 1)]),
		front: poly([P(0, 1), P(n, 1), P(n, 1, BH), P(0, 1, BH)]),
		end: poly([P(n), P(n, 1), P(n, 1, BH), P(n, 0, BH)]),
		base: poly([P(0, 0, BH), P(n, 0, BH), P(n, 1, BH), P(0, 1, BH)]),
		cells: Array.from({ length: n - 1 }, (_, index) => {
			const a = P(index + 1);
			const b = P(index + 1, 1);
			const c = P(index + 1, 1, BH);
			return `M${a.x} ${a.y} L${b.x} ${b.y} L${c.x} ${c.y}`;
		}).join(' '),
		wall: poly([P(n, -0.3, -12), P(n, 1.3, -12), P(n, 1.3, BH + 6), P(n, -0.3, BH + 6)]),
		ruler: (() => {
			const a = P(0, 1, BH + 6);
			const b = P(n, 1, BH + 6);
			return `M${a.x} ${round(a.y - 5)} L${a.x} ${a.y} L${b.x} ${b.y} L${b.x} ${round(b.y - 5)}`;
		})(),
		topCenter: P(n / 2, 0.5),
		valueAt: { x: P(n / 2, 0.5).x, y: round(P(n / 2, 0).y - 6) },
		labelAt: { x: round(P(0, 1).x - 10), y: round(P(0, 1).y + 4) },
		badge: SKEW(P(0.5, 1, BH / 2 + 4)),
		endAt: { x: round(P(n, 0.5, BH / 2).x + 14), y: round(P(n, 0.5, BH / 2).y + 4) },
		wrapArc: (() => {
			const e = P(n, 0.5);
			const s = P(0, 0.5);
			return {
				d: `M${e.x} ${e.y - 4} C${e.x + 26} ${e.y - 96} ${s.x - 36} ${s.y - 84} ${s.x - 2} ${s.y - 12}`,
				head: poly([
					{ x: round(s.x - 8), y: round(s.y - 16) },
					{ x: round(s.x + 4), y: round(s.y - 16) },
					{ x: round(s.x - 1), y: round(s.y - 5) },
				]),
			};
		})(),
	};
}
type Box = ReturnType<typeof box>;
type Tone = 'flow' | 'violet' | 'magenta';

/** A numbered machine: a cube whose top-face center is (cx, cy). */
const CS = 22;
const CH = 24;
const CY = round(CS * 0.575);
function cube(cx: number, cy: number) {
	return {
		top: poly([
			{ x: cx, y: cy - CY },
			{ x: cx + CS, y: cy },
			{ x: cx, y: cy + CY },
			{ x: cx - CS, y: cy },
		]),
		left: poly([
			{ x: cx - CS, y: cy },
			{ x: cx, y: cy + CY },
			{ x: cx, y: cy + CY + CH },
			{ x: cx - CS, y: cy + CH },
		]),
		right: poly([
			{ x: cx, y: cy + CY },
			{ x: cx + CS, y: cy },
			{ x: cx + CS, y: cy + CH },
			{ x: cx, y: cy + CY + CH },
		]),
		base: poly([
			{ x: cx, y: cy - CY + CH },
			{ x: cx + CS, y: cy + CH },
			{ x: cx, y: cy + CY + CH },
			{ x: cx - CS, y: cy + CH },
		]),
		face: SKEW({ x: round(cx - CS / 2), y: round(cy + CY / 2 + CH / 2 + 4) }),
		center: { x: cx, y: cy },
	};
}
type Cube = ReturnType<typeof cube>;

// Boxes. Type boxes (char, int) only show their type; variables show name, type and value.
type BoxSpec = { id: string; g: Box; name: string; type?: string; value?: string; line?: number };
const B = {
	char: box(190, 80, 1),
	int: box(190, 152, 4),
	alt: box(190, 224, 8),
	bytes: box(190, 296, 8),
	cnt: box(500, 152, 4),
	a: box(190, 460, 4),
	b: box(190, 532, 4),
	neg: box(620, 460, 4),
	one: box(620, 532, 4),
};
const typeBoxes: BoxSpec[] = [
	{ id: 'b-char', g: B.char, name: 'char' },
	{ id: 'b-int', g: B.int, name: 'int' },
];
// Declarations: the box is the module of its line (line 12 declares two boxes).
const declarations: { line: number; tone: Tone; boxes: BoxSpec[] }[] = [
	{ line: 5, tone: 'flow', boxes: [{ id: 'alt', g: B.alt, name: names.alt, type: 'double', value: '1.75', line: 5 }] },
	{ line: 6, tone: 'violet', boxes: [{ id: 'bytes', g: B.bytes, name: 'bytes', type: 'size_t', line: 6 }] },
	{ line: 9, tone: 'flow', boxes: [{ id: 'cnt', g: B.cnt, name: names.cnt, type: 'unsigned int', line: 9 }] },
	{
		line: 12,
		tone: 'flow',
		boxes: [
			{ id: 'a', g: B.a, name: 'a', type: 'int', value: '7', line: 12 },
			{ id: 'b', g: B.b, name: 'b', type: 'int', value: '2', line: 12 },
		],
	},
	{ line: 14, tone: 'flow', boxes: [{ id: 'neg', g: B.neg, name: names.neg, type: 'int', value: '-1', line: 14 }] },
	{ line: 15, tone: 'flow', boxes: [{ id: 'one', g: B.one, name: names.one, type: 'unsigned int', value: '1', line: 15 }] },
];

// Machines: one per statement, labelled with its editor line; `op` is drawn on top.
type Machine = { line: number; g: Cube; tone: Tone; op?: string };
const machines: Machine[] = [
	{ line: 7, g: cube(450, 300), tone: 'violet' },
	{ line: 8, g: cube(370, 112), tone: 'magenta' },
	{ line: 10, g: cube(650, 118), tone: 'flow', op: '+' },
	{ line: 11, g: cube(700, 175), tone: 'flow' },
	{ line: 13, g: cube(400, 575), tone: 'violet', op: '/' },
	{ line: 16, g: cube(790, 585), tone: 'magenta', op: '<' },
	{ line: 17, g: cube(570, 330), tone: 'flow' },
];

// Where the particle stops (above a module) and where tokens start and land.
const anchors = [
	...declarations.map((decl) => ({ id: `a-m${decl.line}`, ...lift(decl.boxes[0].g.topCenter, 46) })),
	...machines.map((machine) => ({ id: `a-m${machine.line}`, ...lift(machine.g.center, 30) })),
	{ id: 'a-int', ...B.int.topCenter },
	{ id: 'a-bytes', ...B.bytes.topCenter },
	{ id: 'a-wall', x: B.int.endAt.x + 4, y: B.int.endAt.y - 6 },
	{ id: 'a-plus', x: 345, y: 214 },
	{ id: 'a-plusu', x: 640, y: 240 },
	{ id: 'a-cnt', ...B.cnt.topCenter },
	{ id: 'a-a', ...B.a.topCenter },
	{ id: 'a-b', ...B.b.topCenter },
	{ id: 'a-cast', x: 320, y: 486 },
	{ id: 'a-conv', x: 320, y: 572 },
	{ id: 'a-res1', x: 490, y: 548 },
	{ id: 'a-res2', x: 490, y: 606 },
	{ id: 'a-drop', x: 470, y: 652 },
	{ id: 'a-neg', ...B.neg.topCenter },
	{ id: 'a-one', ...B.one.topCenter },
	{ id: 'a-conv2', x: 752, y: 470 },
	{ id: 'a-res3', x: 790, y: 656 },
];
const at = (id: string) => anchors.find((anchor) => anchor.id === id) ?? { x: 0, y: 0 };

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shots = [
	{ id: 'shot-all', cx: 480, cy: 350, s: 0.8 },
	{ id: 'shot-sizes', cx: 300, cy: 250, s: 1.4 },
	{ id: 'shot-edge', cx: 420, cy: 200, s: 0.97 },
	{ id: 'shot-div', cx: 330, cy: 565, s: 1.45 },
	{ id: 'shot-trap', cx: 650, cy: 540, s: 1.5 },
].map((item) => ({
	id: item.id,
	x: round(item.cx - 640 / item.s),
	y: round(item.cy - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Value tokens: one visual identity for "a value on its way through an expression".
type Token = { id: string; text: string; from: string; tone: Tone };
const tokens: Token[] = [
	{ id: 't-4', text: '4', from: 'a-int', tone: 'violet' },
	{ id: 't-plus', text: '+1', from: 'a-plus', tone: 'magenta' },
	{ id: 't-plusu', text: '+1u', from: 'a-plusu', tone: 'flow' },
	{ id: 't-7', text: '7', from: 'a-a', tone: 'flow' },
	{ id: 't-2', text: '2', from: 'a-b', tone: 'flow' },
	{ id: 't-3', text: '3', from: 'a-m13', tone: 'flow' },
	{ id: 't-frac', text: '.5', from: 'a-m13', tone: 'magenta' },
	{ id: 't-7d', text: '7.0', from: 'a-cast', tone: 'violet' },
	{ id: 't-2d', text: '2.0', from: 'a-conv', tone: 'flow' },
	{ id: 't-35', text: '3.5', from: 'a-m13', tone: 'violet' },
	{ id: 't-m1', text: '-1', from: 'a-neg', tone: 'flow' },
	{ id: 't-huge', text: '4294967295', from: 'a-conv2', tone: 'magenta' },
	{ id: 't-one', text: '1', from: 'a-one', tone: 'flow' },
	{ id: 't-0', text: '0', from: 'a-m16', tone: 'magenta' },
];
const tokenWidth = (token: Token) => Math.round(token.text.length * 7.9 + 22);

// Values that change inside a box: shown, replaced or added by the cues.
const values = [
	{ id: 'v-bytes', text: '4', at: B.bytes.valueAt },
	{ id: 'v-int', text: '2147483647', at: B.int.valueAt },
	{ id: 'v-cmax', text: '4294967295', at: B.cnt.valueAt },
	{ id: 'v-c0', text: '0', at: B.cnt.valueAt },
];

// sizeof rulers: a bracket along the box and its size at the end.
const rulers = [
	{ id: 'r-char', g: B.char, text: '1 byte' },
	{ id: 'r-int', g: B.int, text: '4 bytes' },
	{ id: 'r-alt', g: B.alt, text: '8 bytes' },
];

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = { id: string; text: string; x: number; y: number; align: 'start' | 'end' | 'middle'; tone: 'plain' | Tone; mono?: boolean };
const chips: Chip[] = [
	{ id: 'lb-sizet', text: t('size_t: sin signo', 'size_t: unsigned'), x: B.bytes.endAt.x, y: B.bytes.endAt.y - 4, align: 'start', tone: 'violet', mono: true },
	{ id: 'lb-min', text: t('mínimo: 16 bits', 'minimum: 16 bits'), x: 340, y: B.int.endAt.y - 4, align: 'start', tone: 'plain' },
	{ id: 'lb-ub', text: t('comportamiento indefinido', 'undefined behavior'), x: 292, y: 248, align: 'start', tone: 'magenta' },
	{ id: 'lb-wrap', text: t('da la vuelta: módulo 2ⁿ', 'wraps around: modulo 2ⁿ'), x: 530, y: 96, align: 'middle', tone: 'flow' },
	{ id: 'lb-intdiv', text: 'int / int → int', x: 400, y: 516, align: 'middle', tone: 'flow', mono: true },
	{ id: 'lb-cast', text: '(double)', x: 320, y: 456, align: 'middle', tone: 'violet', mono: true },
	{ id: 'lb-implicit', text: t('conversión implícita', 'implicit conversion'), x: 300, y: 640, align: 'middle', tone: 'flow' },
	{ id: 'lb-warn', text: 'comparison of integers of different signs', x: 670, y: 425, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'lb-sum', text: t('tipo → tamaño · rango · resultado', 'type → size · range · result'), x: 480, y: 40, align: 'middle', tone: 'violet' },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + 24);
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="types" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="tc-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="tc-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<radialGradient id="tc-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="tc-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="tc-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: memory as boxes of bytes, seen through the camera -->
			<g clip-path="url(#tc-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#tc-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#tc-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- Type boxes: char and int, measured by sizeof -->
						{
							typeBoxes.map((spec) => (
								<g data-el={spec.id}>
									<polygon class="xj-shadow" points={spec.g.base} transform="translate(6 8)" />
									<polygon class="xj-face xj-face--l" points={spec.g.front} />
									<polygon class="xj-face xj-face--r" points={spec.g.end} />
									<polygon class="xj-face xj-face--t" points={spec.g.top} fill="url(#tc-g-top)" />
									{spec.g.cells && <path class="xj-cells" d={spec.g.cells} />}
									<text class="xj-name" x={spec.g.labelAt.x} y={spec.g.labelAt.y} text-anchor="end">
										{spec.name}
									</text>
								</g>
							))
						}
						<!-- The int at INT_MAX: full to the brim -->
						<g data-el="full-int" class="xj-lit xj-lit--magenta">
							<polygon class="xj-lit-halo" points={B.int.top} />
							<polygon class="xj-lit-top" points={B.int.top} />
							<polygon class="xj-lit-side" points={B.int.front} />
							<path class="xj-cells xj-cells--on" d={B.int.cells} />
						</g>

						<!-- Declarations: each box is the module of its line, with the line on its front face -->
						{
							declarations.map((decl) => (
								<>
									<g data-el={`m-${decl.line}`} class="xj-mod">
										{decl.boxes.map((spec) => (
											<g>
												<polygon class="xj-shadow" points={spec.g.base} transform="translate(6 8)" />
												<polygon class="xj-face xj-face--l" points={spec.g.front} />
												<polygon class="xj-face xj-face--r" points={spec.g.end} />
												<polygon class="xj-face xj-face--t" points={spec.g.top} fill="url(#tc-g-top)" />
												<path class="xj-cells" d={spec.g.cells} />
												<text class="xj-badge" transform={spec.g.badge} text-anchor="middle">
													{decl.line}
												</text>
												<text class="xj-name" x={spec.g.labelAt.x} y={spec.g.labelAt.y} text-anchor="end">
													{spec.name}
												</text>
												<text class="xj-type" x={spec.g.labelAt.x} y={spec.g.labelAt.y + 15} text-anchor="end">
													{spec.type}
												</text>
												{spec.value && (
													<text class="xj-value" x={spec.g.valueAt.x} y={spec.g.valueAt.y} text-anchor="middle">
														{spec.value}
													</text>
												)}
											</g>
										))}
									</g>
									<g data-el={`on-${decl.line}`} class:list={['xj-lit', `xj-lit--${decl.tone}`]}>
										{decl.boxes.map((spec) => (
											<g>
												<polygon class="xj-lit-halo" points={spec.g.top} />
												<polygon class="xj-lit-top xj-lit-top--soft" points={spec.g.top} />
												<polygon class="xj-lit-side xj-lit-side--soft" points={spec.g.front} />
											</g>
										))}
									</g>
								</>
							))
						}

						<!-- Values that change inside a box -->
						{
							values.map((value) => (
								<text data-el={value.id} class="xj-value" x={value.at.x} y={value.at.y} text-anchor="middle">
									{value.text}
								</text>
							))
						}

						<!-- Machines: one per statement, labelled with its editor line -->
						{
							machines.map((machine) => (
								<>
									<g data-el={`m-${machine.line}`} class="xj-mod">
										<polygon class="xj-shadow" points={machine.g.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={machine.g.left} />
										<polygon class="xj-face xj-face--r" points={machine.g.right} />
										<polygon class="xj-face xj-face--t" points={machine.g.top} fill="url(#tc-g-top)" />
										<text class="xj-face-text" transform={machine.g.face} text-anchor="middle">
											{machine.line}
										</text>
										{machine.op && (
											<text class="xj-op" x={machine.g.center.x} y={machine.g.center.y + 5} text-anchor="middle">
												{machine.op}
											</text>
										)}
									</g>
									<g data-el={`on-${machine.line}`} class:list={['xj-lit', `xj-lit--${machine.tone}`]}>
										<polygon class="xj-lit-halo" points={machine.g.top} />
										<polygon class="xj-lit-top" points={machine.g.top} />
										<polygon class="xj-lit-side" points={machine.g.left} />
										<text class="xj-face-text xj-face-text--on" transform={machine.g.face} text-anchor="middle">
											{machine.line}
										</text>
										{machine.op && (
											<text class="xj-op xj-op--on" x={machine.g.center.x} y={machine.g.center.y + 5} text-anchor="middle">
												{machine.op}
											</text>
										)}
									</g>
								</>
							))
						}

						<!-- sizeof rulers -->
						{
							rulers.map((ruler) => (
								<g data-el={ruler.id} class="xj-ruler">
									<path class="mg-stroke" pathLength="1" d={ruler.g.ruler} />
									<text class="xj-ruler-text" x={ruler.g.endAt.x} y={ruler.g.endAt.y}>
										{ruler.text}
									</text>
								</g>
							))
						}

						<!-- The int refuses one more: a wall at its end -->
						<g data-el="wall" class="xj-wall">
							<polygon class="xj-wall-halo" points={B.int.wall}></polygon>
							<polygon class="xj-wall-core" points={B.int.wall}></polygon>
						</g>

						<!-- The unsigned wraps around: from its end back to its start -->
						<g data-el="arc-wrap" class="xj-flowline xj-flowline--flow">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={B.cnt.wrapArc.d}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={B.cnt.wrapArc.d}></path>
							<polygon class="mg-head xj-arrowhead" points={B.cnt.wrapArc.head}></polygon>
						</g>

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									<text class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'} x={chipLeft(chip) + chipWidth(chip) / 2} y={chip.y + 4.5} text-anchor="middle">
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- Value tokens. Placement lives on the inner group: the player resets data-el transforms. -->
						{
							tokens.map((token) => (
								<g data-el={token.id} data-x={at(token.from).x} data-y={at(token.from).y}>
									<g class:list={['xj-token', `xj-token--${token.tone}`]}>
										<rect class="xj-token-halo" x={-tokenWidth(token) / 2 - 5} y="-18" width={tokenWidth(token) + 10} height="36" rx="18" />
										<rect class="xj-token-card" x={-tokenWidth(token) / 2} y="-13" width={tokenWidth(token)} height="26" rx="13" />
										<text class="xj-token-text" x="0" y="4.5" text-anchor="middle">
											{token.text}
										</text>
									</g>
								</g>
							))
						}

						<!-- The execution flow -->
						<g data-el="p" class="xj-particle" data-x={at('a-m5').x} data-y={at('a-m5').y}>
							<circle r="20" fill="url(#tc-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="400" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<rect class="xj-legend-cell" x={VP.x + 172} y={LEGEND_Y - 7} width="14" height="14" rx="3"></rect>
				<text x={VP.x + 194} y={LEGEND_Y + 4}>{t('1 celda = 1 byte', '1 cell = 1 byte')}</text>
				<rect class="xj-legend-token" x={VP.x + 316} y={LEGEND_Y - 6} width="20" height="12" rx="6"></rect>
				<text x={VP.x + 344} y={LEGEND_Y + 4}>{t('Valor', 'Value')}</text>
			</g>

			<!-- EDITOR: the program, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.file}</text>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(5)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<!-- Lines whose result is a problem: undefined behavior and the signed/unsigned warning -->
				{
					WARN_LINES.map((n) => (
						<g data-el={`warn-${n}`} class="xj-warn">
							<rect x={ED.x + 4} y={lineTop(n) + 2} width="4" height={LINE_H - 4} rx="2" />
							<svg class="xj-icon" x={ED.x + ED.w - 30} y={lineMid(n) - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
								<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
								<path d="M12 9v4" />
								<path d="M12 17h.01" />
							</svg>
						</g>
					))
				}

				<!-- The program: written before it runs, so every line is visible -->
				<g class="xj-code">
					{
						lines.map((line) => (
							<g>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				<!-- Console: what each printf prints -->
				{
					outputs.map((out) => (
						<text data-el={out.id} class="xj-out" x={ED.x + 20} y={outY(out.row)} xml:space="preserve">
							{out.text}
						</text>
					))
				}
				{lines.map((line) => <circle data-anchor={`ln-${line.n}`} cx={BAR_CX} cy={lineMid(line.n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow, magenta for the problem (a full int, a lost fraction,
	   the converted -1) and violet for what measures or resolves it (sizeof, the cast).
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='tipos-conversiones-c']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='tipos-conversiones-c'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='tipos-conversiones-c'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='tipos-conversiones-c'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-cell {
		fill: var(--xj-steel);
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
	}

	.xj-legend-token {
		fill: var(--xj-panel);
		stroke: var(--xj-flow);
		stroke-width: 1.5;
	}

	/* Boxes and machines */
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-cells {
		fill: none;
		stroke: var(--xj-steel-hi);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}

	.xj-cells--on {
		stroke: var(--xj-magenta-soft);
	}

	.xj-name {
		font-family: monospace;
		font-size: 13px;
		font-weight: 700;
		fill: var(--xj-white);
	}

	.xj-type {
		font-family: monospace;
		font-size: 11px;
		fill: var(--xj-dim);
	}

	.xj-value {
		font-family: monospace;
		font-size: 13px;
		font-weight: 700;
		fill: var(--xj-flow-soft);
	}

	.xj-badge,
	.xj-face-text {
		font-family: var(--font-body);
		font-size: 11px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face-text {
		font-size: 12px;
	}

	.xj-face-text--on {
		fill: var(--xj-ink);
	}

	.xj-op {
		font-family: monospace;
		font-size: 15px;
		font-weight: 700;
		fill: var(--xj-white);
	}

	.xj-op--on {
		fill: var(--xj-ink);
	}

	/* Lit states */
	.xj-lit {
		--xj-lit: var(--xj-flow);
		--xj-lit-soft: var(--xj-flow-soft);
	}

	.xj-lit--violet {
		--xj-lit: var(--xj-violet);
		--xj-lit-soft: var(--xj-violet-soft);
	}

	.xj-lit--magenta {
		--xj-lit: var(--xj-magenta);
		--xj-lit-soft: var(--xj-magenta-soft);
	}

	.xj-lit-halo {
		fill: none;
		stroke: var(--xj-lit);
		stroke-width: 12;
		stroke-opacity: 0.22;
		stroke-linejoin: round;
	}

	.xj-lit-top {
		fill: var(--xj-lit);
		fill-opacity: 0.5;
		stroke: var(--xj-lit-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-lit-top--soft {
		fill-opacity: 0.18;
	}

	.xj-lit-side {
		fill: var(--xj-lit-soft);
		stroke: var(--xj-lit-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-lit-side--soft {
		fill: var(--xj-lit);
		fill-opacity: 0.25;
	}

	/* sizeof rulers */
	.xj-ruler path {
		fill: none;
		stroke: var(--xj-violet-soft);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.xj-ruler-text {
		font-family: monospace;
		font-size: 12.5px;
		font-weight: 700;
		fill: var(--xj-violet-soft);
	}

	/* The limit of the int */
	.xj-wall-halo {
		fill: none;
		stroke: var(--xj-magenta);
		stroke-width: 12;
		stroke-opacity: 0.25;
		stroke-linejoin: round;
	}

	.xj-wall-core {
		fill: var(--xj-magenta);
		fill-opacity: 0.55;
		stroke: var(--xj-magenta-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	/* Routes */
	.xj-flowline {
		--xj-line: var(--xj-flow);
	}

	.xj-flowline-halo,
	.xj-flowline-core {
		fill: none;
