	.xj-hl rect {
		fill: var(--xj-flow);
		fill-opacity: 0.18;
		stroke: var(--xj-flow);
		stroke-opacity: 0.6;
		stroke-width: 1.2;
	}

	.xj-hl path {
		fill: var(--xj-flow);
	}
</style>
