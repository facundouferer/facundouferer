		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.xj-flowline-halo {
		stroke-width: 11;
		stroke-opacity: 0.2;
	}

	.xj-flowline-core {
		stroke-width: 3;
	}

	.xj-arrowhead {
		fill: var(--xj-line);
	}

	/* Notes */
	.xj-chip {
		--xj-chip: var(--xj-edge);
		--xj-chip-ink: var(--xj-mist);
