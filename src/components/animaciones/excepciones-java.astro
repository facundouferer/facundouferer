---
/**
 * Scenes for the "Exceptions and error handling, step by step" animation (lesson java/12).
 * The captions, code and terminal panels live in
 * `src/data/animations/excepciones-java.ts`; this component only draws the
 * diagrams the steps point to. Slide scenes are HTML blocks (`[data-scene]` with
 * `[data-el]` elements). The `gap`, `hier`, `obj`, `flow`, `check`, `stack`, `catches`,
 * `res`, `exits`, `chain` and `anti` scenes are SVG canvases (`data-motion`) choreographed
 * by the cues of their motion steps: an exception object is thrown, travels up the call
 * stack and is caught.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/excepciones-java';
import { resolveScript } from '../../utils/animations';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── Slide scene data ──────────────────────────────────────────────────────
const failures = [
	{ id: 'if1', label: t('El archivo no está', 'The file is missing'), code: 'FileNotFoundException' },
	{ id: 'if2', label: t('La red se cae', 'The network drops'), code: 'SocketException' },
	{ id: 'if3', label: t('El usuario escribe "veintidós"', 'The user types "twenty-two"'), code: 'NumberFormatException' },
	{ id: 'if4', label: t('La base rechaza la conexión', 'The database refuses the connection'), code: 'SQLException' },
];
const mistakes = [
	{ id: 'm1', text: t('catch vacío', 'Empty catch') },
	{ id: 'm2', text: 'catch (Exception e) ' + t('primero', 'first') },
	{ id: 'm3', text: t('catch general antes del específico', 'General catch before the specific one') },
	{ id: 'm4', text: t('Relanzar sin la causa', 'Rethrowing without the cause') },
	{ id: 'm5', text: t('try de cincuenta líneas', 'Fifty-line try') },
	{ id: 'm6', text: t('Cerrar recursos a mano', 'Closing resources by hand') },
	{ id: 'm7', text: t('Excepciones para casos normales', 'Exceptions for normal cases') },
];
const exercise = [
	{ id: 'ex1', n: 1, name: 'EdadInvalidaException', note: t('extends RuntimeException + edad rechazada', 'extends RuntimeException + rejected age') },
	{ id: 'ex2', n: 2, name: 'registrar(nombre, edad)', note: t('La regla del rango, en un solo lugar', 'The range rule, in a single place') },
	{ id: 'ex3', n: 3, name: 'registrarDesdeTexto(…)', note: t('Traduce NumberFormatException, conserva la causa', 'Translates NumberFormatException, keeps the cause') },
	{ id: 'ex4', n: 4, name: 'main', note: t('Caso válido, fuera de rango y texto inválido', 'Valid case, out of range and invalid text') },
	{ id: 'ex5', n: 5, name: 'finally', note: t('Constancia de que el intento terminó', 'A record that the attempt finished') },
];
const takeaways = [
	t('Una excepción es un objeto', 'An exception is an object'),
	t('Unchecked se evita, checked te obliga', 'Unchecked is avoided, checked forces you'),
	t('El try se corta; el finally corre siempre', 'The try is cut; the finally always runs'),
	t('Sube por la pila hasta un catch', 'Travels up the stack to a catch'),
	t('De lo específico a lo general', 'From specific to general'),
	t('try-with-resources para cerrar', 'try-with-resources to close'),
	t('Al relanzar, pasá la causa', 'When rethrowing, pass the cause'),
	t('Un catch vacío es peor que nada', 'An empty catch is worse than nothing'),
];
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<!-- INTRO (motion): the boolean that can be ignored vs. the exception that cannot -->
	<div slot="scene" data-scene="gap" data-motion class="scene-canvas">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<rect class="mg-card" data-el="pl" data-base="shown" x="40" y="40" width="740" height="580" rx="22" />
				<rect class="mg-card mg-card--accent" data-el="pr" data-base="shown" x="820" y="40" width="740" height="580" rx="22" />
				<text class="mg-heading" x="70" y="96">{t('boolean: se puede ignorar', 'boolean: it can be ignored')}</text>
				<text class="mg-heading" x="850" y="96">{t('excepción: no se puede ignorar', 'exception: it cannot be ignored')}</text>

				<g data-el="b-call">
					<rect class="mg-card" x="90" y="150" width="300" height="110" rx="18" />
					<text class="mg-mono mg-mono--dark" x="115" y="196">producto.</text>
					<text class="mg-mono mg-mono--dark" x="115" y="228">setPrecio(-500);</text>
				</g>
				<g data-el="b-meth">
					<rect class="mg-card mg-card--sage" x="470" y="150" width="270" height="110" rx="18" />
					<text class="mg-text mg-text--strong" x="492" y="184">setPrecio</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="492" y="212">if (precio &lt; 0)</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="492" y="238">  return false;</text>
				</g>
				<g data-el="b-arg" data-x="400" data-y="205">
					<rect class="mg-chip" x="-45" y="-20" width="90" height="40" rx="20" />
					<text class="mg-chip-text" x="0" y="6" text-anchor="middle">-500</text>
				</g>
				<g data-el="b-false" data-x="605" data-y="290">
					<rect class="mg-chip mg-chip--sage" x="-50" y="-20" width="100" height="40" rx="20" />
					<text class="mg-chip-text mg-chip-text--sage" x="0" y="6" text-anchor="middle">false</text>
				</g>
				<circle data-anchor="b-back" cx="240" cy="320" r="1" fill="none" />
				<g data-el="b-silent">
					<rect class="mg-card mg-card--dashed" x="90" y="380" width="650" height="190" rx="20" />
					<text class="mg-heading" x="120" y="430">{t('El resultado se ignora', 'The result is ignored')}</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="120" y="470">producto.setPrecio(-500);   // ¿y el false?</text>
					<text class="mg-text mg-text--muted" x="120" y="510">{t('Precio sin cambios, sin aviso.', 'Price unchanged, no warning.')}</text>
					<text class="mg-text mg-text--muted" x="120" y="540">{t('El programa sigue como si nada.', 'The program carries on as if nothing happened.')}</text>
				</g>

				<g data-el="x-call">
					<rect class="mg-card" x="850" y="150" width="300" height="110" rx="18" />
					<text class="mg-mono mg-mono--dark" x="875" y="196">producto.</text>
					<text class="mg-mono mg-mono--dark" x="875" y="228">setPrecio(-500);</text>
				</g>
				<g data-el="x-meth">
					<rect class="mg-card mg-card--accent" x="1230" y="150" width="280" height="110" rx="18" />
					<text class="mg-text mg-text--strong" x="1252" y="184">setPrecio</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="1252" y="212">throw new</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="1252" y="238">IllegalArgumentException</text>
				</g>
				<g data-el="x-exc" data-x="1370" data-y="290">
					<rect class="mg-exc" x="-130" y="-20" width="260" height="40" rx="20" />
					<text class="mg-exc-text" x="0" y="6" text-anchor="middle">IllegalArgumentException</text>
				</g>
				<circle data-anchor="x-back" cx="1000" cy="300" r="1" fill="none" />
				<g data-el="x-stop">
					<rect class="mg-card mg-card--ink" x="850" y="380" width="660" height="190" rx="20" />
					<text class="mg-mono mg-out" x="880" y="428">Exception in thread "main"</text>
					<text class="mg-mono" x="880" y="460">java.lang.IllegalArgumentException: precio &lt; 0</text>
					<text class="mg-mono" x="880" y="492">    at Producto.setPrecio(Producto.java:14)</text>
					<text class="mg-text mg-text--light mg-text--strong" x="880" y="540">{t('El programa se detiene.', 'The program stops.')}</text>
				</g>
			</g>
		</svg>
	</div>

	<!-- INTRO (slide): programs fail all the time -->
	<div slot="scene" data-scene="intro12" class="scene-intro12">
		{
			failures.map((f) => (
				<div class="dg-box" data-el={f.id}>
					<p class="dg-label">{f.label}</p>
					<code class="dg-code">{f.code}</code>
				</div>
			))
		}
		<div class="dg-box dg-box--ink dg-box--center" data-el="iq">
			<p class="dg-title">{t('¿Qué hace tu código cuando falla?', 'What does your code do when it fails?')}</p>
		</div>
	</div>

	<!-- 1. The Throwable hierarchy (motion) -->
	<div slot="scene" data-scene="hier" data-motion class="scene-canvas">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<g data-el="h-c1" class="mg-arrow">
					<path class="mg-stroke" d="M800 110C800 170 310 170 310 226" pathLength="1" />
					<path class="mg-head" d="M298 214L310 228L322 214" />
				</g>
				<g data-el="h-c2" class="mg-arrow mg-arrow--sage">
					<path class="mg-stroke" d="M800 110C800 170 1190 170 1190 226" pathLength="1" />
					<path class="mg-head" d="M1178 214L1190 228L1202 214" />
				</g>
				<g data-el="h-c3" class="mg-arrow">
					<path class="mg-stroke" d="M1190 370L1190 476" pathLength="1" />
					<path class="mg-head" d="M1178 464L1190 478L1202 464" />
				</g>
				<g data-el="h-thr">
					<rect class="mg-card mg-card--ink" x="650" y="40" width="300" height="70" rx="20" />
					<text class="mg-heading mg-text--light" x="800" y="86" text-anchor="middle">Throwable</text>
				</g>
				<g data-el="h-err">
					<rect class="mg-card" x="100" y="230" width="420" height="140" rx="20" />
					<text class="mg-heading" x="130" y="274">Error</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="130" y="306">OutOfMemoryError</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="130" y="330">StackOverflowError</text>
					<text class="mg-text mg-text--strong mg-text--muted" x="130" y="356">{t('Fallas de la JVM', 'JVM failures')}</text>
				</g>
				<g data-el="h-exc">
					<rect class="mg-card mg-card--sage" x="880" y="230" width="620" height="140" rx="20" />
					<text class="mg-heading" x="910" y="274">Exception</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="910" y="308">IOException · SQLException</text>
					<text class="mg-text mg-text--muted" x="910" y="346">{t('Condiciones esperables del entorno', 'Expected environment conditions')}</text>
				</g>
				<g data-el="h-run">
					<rect class="mg-card mg-card--accent" x="880" y="480" width="620" height="110" rx="20" />
					<text class="mg-heading" x="910" y="523">RuntimeException</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="910" y="552">NullPointerException · ArithmeticException</text>
					<text class="mg-text mg-text--muted" x="910" y="578">{t('Errores de programación', 'Programming errors')}</text>
				</g>
				<g data-el="h-checked">
					<rect class="mg-chip mg-chip--sage" x="880" y="396" width="440" height="44" rx="22" />
					<text class="mg-chip-text mg-chip-text--sage" x="1100" y="424" text-anchor="middle">CHECKED · {t('el compilador te obliga', 'the compiler forces you')}</text>
				</g>
				<g data-el="h-unchecked">
					<rect class="mg-chip" x="880" y="602" width="500" height="44" rx="22" />
					<text class="mg-chip-text" x="1130" y="630" text-anchor="middle">UNCHECKED · {t('el compilador no dice nada', 'the compiler says nothing')}</text>
				</g>
				<g data-el="h-why">
					<rect class="mg-card mg-card--dashed" x="100" y="420" width="420" height="200" rx="20" />
					<text class="mg-text mg-text--strong" x="130" y="466">{t('¿Por qué no capturar un Error?', 'Why not catch an Error?')}</text>
					<text class="mg-text mg-text--muted" x="130" y="508">{t('Si la JVM se quedó sin memoria,', 'If the JVM ran out of memory,')}</text>
					<text class="mg-text mg-text--muted" x="130" y="534">{t('tu catch tampoco va a poder', 'your catch will not be able')}</text>
					<text class="mg-text mg-text--muted" x="130" y="560">{t('ejecutarse.', 'to run either.')}</text>
				</g>
			</g>
		</svg>
	</div>

	<!-- 1b. An exception is an object (motion) -->
	<div slot="scene" data-scene="obj" data-motion class="scene-canvas">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<g data-el="o-card">
					<rect class="mg-card mg-card--accent" x="470" y="40" width="620" height="330" rx="22" />
					<text class="mg-heading" x="500" y="94">ArithmeticException</text>
					<text class="mg-text mg-text--muted" x="500" y="124">{t('una instancia de una clase', 'an instance of a class')}</text>
					<g data-el="o-r1" data-base="shown">
						<rect class="mg-card" x="490" y="145" width="580" height="48" rx="14" />
						<text class="mg-text mg-text--strong" x="510" y="175">message</text>
						<text class="mg-mono mg-mono--dark" x="660" y="175">"/ by zero"</text>
					</g>
					<g data-el="o-r2" data-base="shown">
						<rect class="mg-card" x="490" y="205" width="580" height="48" rx="14" />
						<text class="mg-text mg-text--strong" x="510" y="235">cause</text>
						<text class="mg-mono mg-mono--dark" x="660" y="235">null</text>
					</g>
					<g data-el="o-r3" data-base="shown">
						<rect class="mg-card" x="490" y="265" width="580" height="48" rx="14" />
						<text class="mg-text mg-text--strong" x="510" y="295">stackTrace</text>
						<text class="mg-mono mg-mono--dark" x="660" y="295">[Main.main(Main.java:5)]</text>
					</g>
				</g>
				<g data-el="o-note">
					<rect class="mg-card mg-card--sage" x="1130" y="40" width="400" height="210" rx="22" />
					<text class="mg-heading" x="1160" y="92">{t('Es un objeto', 'It is an object')}</text>
					<text class="mg-text" x="1160" y="132">{t('Tiene jerarquía, atributos', 'It has a hierarchy, attributes')}</text>
					<text class="mg-text" x="1160" y="160">{t('y métodos, como todo lo', 'and methods, like everything')}</text>
					<text class="mg-text" x="1160" y="188">{t('que venís viendo.', 'you have seen so far.')}</text>
				</g>

				<g data-el="o-m1"><rect class="mg-chip" x="60" y="145" width="340" height="48" rx="24" /><text class="mg-mono mg-mono--dark mg-mono--sm" x="230" y="175" text-anchor="middle">getMessage()</text></g>
				<g data-el="o-m2"><rect class="mg-chip" x="60" y="205" width="340" height="48" rx="24" /><text class="mg-mono mg-mono--dark mg-mono--sm" x="230" y="235" text-anchor="middle">getCause()</text></g>
				<g data-el="o-m3"><rect class="mg-chip" x="60" y="265" width="340" height="48" rx="24" /><text class="mg-mono mg-mono--dark mg-mono--sm" x="230" y="295" text-anchor="middle">getStackTrace()</text></g>
				<g data-el="o-m4"><rect class="mg-chip" x="60" y="325" width="340" height="48" rx="24" /><text class="mg-mono mg-mono--dark mg-mono--sm" x="230" y="355" text-anchor="middle">printStackTrace()</text></g>
				<g data-el="o-a1" class="mg-arrow"><path class="mg-stroke" d="M400 169L462 169" pathLength="1" /><path class="mg-head" d="M452 159L464 169L452 179" /></g>
				<g data-el="o-a2" class="mg-arrow"><path class="mg-stroke" d="M400 229L462 229" pathLength="1" /><path class="mg-head" d="M452 219L464 229L452 239" /></g>
				<g data-el="o-a3" class="mg-arrow"><path class="mg-stroke" d="M400 289L462 289" pathLength="1" /><path class="mg-head" d="M452 279L464 289L452 299" /></g>
				<g data-el="o-a4" class="mg-arrow mg-arrow--sage"><path class="mg-stroke" d="M400 349C440 349 420 480 462 480" pathLength="1" /><path class="mg-head" d="M451 470L464 480L450 489" /></g>

				<g data-el="o-out">
					<rect class="mg-card mg-card--ink" x="470" y="410" width="620" height="200" rx="22" />
					<text class="mg-mono mg-text--dim mg-mono--sm" x="500" y="448">System.err</text>
					<text class="mg-mono mg-out" x="500" y="500" data-el="o-l1">java.lang.ArithmeticException: / by zero</text>
					<text class="mg-mono" x="500" y="540" data-el="o-l2">    at Main.main(Main.java:5)</text>
				</g>
			</g>
		</svg>
	</div>

	<!-- 2. try, catch, finally (motion) -->
	<div slot="scene" data-scene="flow" data-motion class="scene-canvas">
		<svg class="mg-canvas" viewBox="0 0 1600 660" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<g class="mg-camera" data-camera>
				<g data-el="f-try">
					<rect class="mg-card" x="50" y="130" width="330" height="330" rx="22" />
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="90" y="210">try {'{'}</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="90" y="250">  println("A");</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="90" y="350">  println("B");</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="90" y="400">{'}'}</text>
				</g>
				<text class="mg-mono mg-mono--dark mg-mono--sm" x="90" y="300" data-el="l-div-ok">  int x = 10 / 2;</text>
				<text class="mg-mono mg-mono--dark mg-mono--sm" x="90" y="300" data-el="l-div-bad">  int x = 10 / 0;</text>
				<text class="mg-mono mg-mono--dark mg-mono--sm" x="90" y="300" data-el="l-ret">  return;</text>
				<g data-el="f-strike" class="mg-arrow"><path class="mg-stroke" d="M95 345L300 345" pathLength="1" /></g>

				<g data-el="f-ar1" class="mg-arrow"><path class="mg-stroke" d="M386 295L460 295" pathLength="1" /><path class="mg-head" d="M450 285L462 295L450 305" /></g>
				<g data-el="f-catch">
					<rect class="mg-card mg-card--accent" x="470" y="130" width="330" height="330" rx="22" />
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="510" y="210">catch (ArithmeticException e) {'{'}</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="510" y="250">  println("C");</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="510" y="400">{'}'}</text>
				</g>
				<g data-el="f-ar2" class="mg-arrow"><path class="mg-stroke" d="M806 295L880 295" pathLength="1" /><path class="mg-head" d="M870 285L882 295L870 305" /></g>
				<g data-el="f-fin">
					<rect class="mg-card mg-card--sage" x="890" y="130" width="330" height="330" rx="22" />
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="930" y="210">finally {'{'}</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="930" y="250">  println("F");</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="930" y="400">{'}'}</text>
				</g>
				<g data-el="f-ar3" class="mg-arrow"><path class="mg-stroke" d="M1226 295L1300 295" pathLength="1" /><path class="mg-head" d="M1290 285L1302 295L1290 305" /></g>
				<g data-el="f-next">
					<rect class="mg-card" x="1310" y="130" width="240" height="330" rx="22" />
					<text class="mg-text mg-text--muted" x="1350" y="210">{t('// lo que sigue', '// what follows')}</text>
					<text class="mg-mono mg-mono--dark mg-mono--sm" x="1350" y="250">println("D");</text>
				</g>

				<g data-el="o-strip">
					<rect class="mg-card mg-card--ink" x="50" y="520" width="1500" height="100" rx="22" />
					<text class="mg-mono mg-prompt" x="90" y="578">&gt; {t('salida', 'output')}</text>
				</g>
				<text class="mg-mono mg-out mg-big" x="330" y="580" data-el="o-a">A</text>
				<text class="mg-mono mg-out mg-big" x="420" y="580" data-el="o-b">B</text>
				<text class="mg-mono mg-out mg-big" x="420" y="580" data-el="o-c">C</text>
				<text class="mg-mono mg-out mg-big" x="420" y="580" data-el="o-f2">F</text>
				<text class="mg-mono mg-out mg-big" x="510" y="580" data-el="o-f">F</text>
				<text class="mg-mono mg-out mg-big" x="600" y="580" data-el="o-d">D</text>

				<circle data-anchor="ta2" cx="70" cy="300" r="1" fill="none" />
				<circle data-anchor="ta3" cx="70" cy="350" r="1" fill="none" />
				<circle data-anchor="ta1" cx="70" cy="250" r="1" fill="none" />
				<circle data-anchor="ca1" cx="490" cy="250" r="1" fill="none" />
				<circle data-anchor="fa1" cx="910" cy="250" r="1" fill="none" />
				<circle data-anchor="na1" cx="1330" cy="250" r="1" fill="none" />
				<circle data-anchor="fp-catch" cx="635" cy="92" r="1" fill="none" />

				<g data-el="f-skip" data-x="635" data-y="92">
