---
/**
 * Scene for "The journey of a node: static lists versus linked lists"
 * (lesson java/11-tad-listas-estaticas-y-dinamicas, order: 16), a short film played
 * on one persistent motion canvas. The captions and cues live in
 * `src/data/animations/tad-listas-java.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: it shows
 * the Java source (first the static list and the node class, then the linked list)
 * and the cues slide a bar over the line being executed. The viewport on the right
 * holds the camera: an isometric system with a contiguous array platform at the
 * back, where inserting at the front shifts every value one cell, and the Heap
 * platform in front, where scattered nodes are linked by `siguiente` references.
 * Magenta marks the wrong insertion order that loses the list; violet marks the
 * correct rewiring (`nuevo.siguiente = cabeza`, `cabeza = nuevo`, the removal jump).
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/tad-listas-java';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── Source code shown in the editor ───────────────────────────────────────
// Identifiers are localized the same way the lesson does.
const names = {
	fileA: t('ListaEstatica.java', 'StaticList.java'),
	fileB: t('ListaEnlazada.java', 'LinkedList.java'),
	staticList: t('ListaEstatica', 'StaticList'),
	items: t('datos', 'items'),
	count: t('cantidad', 'count'),
	get: t('obtener', 'get'),
	addFirst: t('agregarAlInicio', 'addFirst'),
	data: t('dato', 'data'),
	node: t('Nodo', 'Node'),
	next: t('siguiente', 'next'),
	linkedList: t('ListaEnlazada', 'LinkedList'),
	head: t('cabeza', 'head'),
	fresh: t('nuevo', 'fresh'),
	print: t('mostrar', 'print'),
	current: t('actual', 'current'),
	removeAfter: t('eliminarDespuesDe', 'removeAfter'),
	prev: t('anterior', 'previous'),
};

// First page: the static list over a fixed array, and the node class.
const sourceA = [
	`class ${names.staticList} {`,
	`    int[] ${names.items} = new int[5];`,
	`    int ${names.count};`,
	'',
	`    int ${names.get}(int i) { return ${names.items}[i]; }`,
	'',
	`    void ${names.addFirst}(int ${names.data}) {`,
	`        for (int i = ${names.count}; i > 0; i--) {`,
	`            ${names.items}[i] = ${names.items}[i - 1];`,
	'        }',
	`        ${names.items}[0] = ${names.data};`,
	`        ${names.count}++;`,
	'    }',
	'}',
	'',
	`class ${names.node} {`,
	`    int ${names.data};`,
	`    ${names.node} ${names.next};`,
	`    ${names.node}(int ${names.data}) { this.${names.data} = ${names.data}; }`,
	'}',
].join('\n');

// Second page: the singly linked list (insert at the front, walk, remove after).
const sourceB = [
	`class ${names.linkedList} {`,
	`    ${names.node} ${names.head};`,
	'',
	`    void ${names.addFirst}(int ${names.data}) {`,
	`        ${names.node} ${names.fresh} = new ${names.node}(${names.data});`,
	`        ${names.fresh}.${names.next} = ${names.head};`,
	`        ${names.head} = ${names.fresh};`,
	'    }',
	`    void ${names.print}() {`,
	`        ${names.node} ${names.current} = ${names.head};`,
	`        while (${names.current} != null) {`,
	`            System.out.print(${names.current}.${names.data} + " → ");`,
	`            ${names.current} = ${names.current}.${names.next};`,
	'        }',
	'        System.out.println("null");',
	'    }',
	`    void ${names.removeAfter}(${names.node} ${names.prev}) {`,
	`        ${names.prev}.${names.next} = ${names.prev}.${names.next}.${names.next};`,
	'    }',
	'}',
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const svgLines = (source: string) =>
	highlightCode(source, 'java').map((html, index) => ({
		n: index + 1,
		html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
	}));

const pageA = svgLines(sourceA);
const pageB = svgLines(sourceB);

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 64;
const GUTTER_X = 50;
const CODE_TOP = 74;
const LINE_H = 23;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 5;
const CONSOLE_TOP = 552;
const outY = (row: number) => 597 + row * LINE_H;

// Lines the highlight bar travels to (`ln-<n>`, valid for both pages).
const lineAnchors = [5, 6, 7, 9, 10, 11, 12, 13, 15, 16, 17, 18].map((n) => ({ n }));

// Program output, one element per call to the print method.
const outputs = [
	{ id: 'out-1', row: 0, text: '10 → 20 → 30 → null' },
	{ id: 'out-2', row: 1, text: '10 → 30 → null' },
];

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 56;
const EY = 32;
const ORIGIN = { x: 460, y: 300 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');
const path = (points: Point[]) => 'M' + points.map((point) => `${point.x} ${point.y}`).join(' L');
const arc = (from: Point, control: Point, to: Point) => `M${from.x} ${from.y} Q${control.x} ${control.y} ${to.x} ${to.y}`;
const mid = (a: Point, b: Point): Point => ({ x: round((a.x + b.x) / 2), y: round((a.y + b.y) / 2) });

/** A box standing on the floor at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		outline: poly([back, right, down(right), down(front), down(left), left]),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
	};
}
type Slab = ReturnType<typeof slab>;
/** Text lying flat on a floor, reading along +u. */
const floorMatrix = (point: Point) => `matrix(0.866 0.5 -0.866 0.5 ${point.x} ${point.y})`;

/** Arrowhead whose tip sits on `tip`, pointing away from `from`. */
function arrowHead(tip: Point, from: Point, size = 11) {
	const angle = Math.atan2(tip.y - from.y, tip.x - from.x);
	const back = { x: tip.x - size * Math.cos(angle), y: tip.y - size * Math.sin(angle) };
	const side = { x: -Math.sin(angle) * size * 0.55, y: Math.cos(angle) * size * 0.55 };
	return poly([tip, { x: round(back.x + side.x), y: round(back.y + side.y) }, { x: round(back.x - side.x), y: round(back.y - side.y) }]);
}

// The contiguous array: five cells touching each other along u.
const ARR_V = -2.2;
const CELL_H = 14;
const cellU = (i: number) => -0.6 + i * 0.8;
const cells = [0, 1, 2, 3, 4].map((i) => ({ i, g: slab(cellU(i), ARR_V, 0.4, 0.4, CELL_H) }));
/** Top of cell `i`: where a value cube rests. */
const slot = (i: number) => pt(cellU(i), ARR_V, CELL_H);
const START = lift(pt(-1.55, ARR_V), 34);

// A value cube drawn around its own origin (the middle of its base), so it can travel.
const VAL_A = 0.24;
const VAL_H = 12;
const valTop = [
	{ x: 0, y: round(-2 * VAL_A * EY - VAL_H) },
	{ x: round(2 * VAL_A * EX), y: -VAL_H },
	{ x: 0, y: round(2 * VAL_A * EY - VAL_H) },
	{ x: round(-2 * VAL_A * EX), y: -VAL_H },
];
const valDown = (point: Point): Point => ({ x: point.x, y: point.y + VAL_H });
const valCube = {
	top: poly(valTop),
	leftFace: poly([valTop[3], valTop[2], valDown(valTop[2]), valDown(valTop[3])]),
	rightFace: poly([valTop[2], valTop[1], valDown(valTop[1]), valDown(valTop[2])]),
};
const values = [
	{ id: 'val-10', text: '10', at: slot(0) },
	{ id: 'val-20', text: '20', at: slot(0) },
	{ id: 'val-30', text: '30', at: slot(1) },
];

// The Heap: the head reference, three scattered nodes and the null end.
const NODE_A = 0.55;
const NODE_B = 0.3;
const NODE_H = 18;
const HEAD = { u: -1.7, v: 0.3 };
const NUL = { u: 3.7, v: 1.1 };
const nodePlaces = [
	{ id: 'n0', value: '10', u: -1.3, v: 2.0 },
	{ id: 'n1', value: '20', u: 0.5, v: 0.9 },
	{ id: 'n2', value: '30', u: 2.3, v: 1.5 },
];
const nodes = nodePlaces.map((node) => ({
	...node,
	g: slab(node.u, node.v, NODE_A, NODE_B, NODE_H),
	divider: path([pt(node.u, node.v - NODE_B, NODE_H), pt(node.u, node.v + NODE_B, NODE_H)]),
	valueAt: pt(node.u - NODE_A / 2, node.v, NODE_H),
	dotAt: pt(node.u + NODE_A / 2, node.v, NODE_H),
	in: pt(node.u - NODE_A, node.v, NODE_H),
}));
const [N0, N1, N2] = nodes;

const G = {
	floorArr: slab(1.0, ARR_V, 2.1, 0.75, 12, -12),
	floorHeap: slab(1.05, 1.25, 3.25, 1.45, 12, -12),
	head: slab(HEAD.u, HEAD.v, 0.3, 0.3, 12),
	nul: slab(NUL.u, NUL.v, 0.32, 0.32, 4),
};
type Tone = 'flow' | 'violet' | 'magenta';

// References between the pieces of the list; each route ends in an arrowhead.
// A reference leaves the dot of the `next` half (or the head block) and lands on the back edge of the target.
const headOut = G.head.center;
const nulIn = pt(NUL.u - 0.32, NUL.v, 4);
type Route = { id: string; tone: Tone; d: string; head: string };
const line = (from: Point, to: Point) => ({ d: path([from, to]), head: arrowHead(to, from) });
const bend = (from: Point, control: Point, to: Point) => ({ d: arc(from, control, to), head: arrowHead(to, control) });
const routes: Route[] = [
	{ id: 'rt-head-n1', tone: 'flow', ...line(headOut, N1.in) },
	{ id: 'rt-n1-n2', tone: 'flow', ...line(N1.dotAt, N2.in) },
	{ id: 'rt-n2-null', tone: 'flow', ...line(N2.dotAt, nulIn) },
	{ id: 'rt-new-n1', tone: 'violet', ...line(N0.dotAt, N1.in) },
	{ id: 'rt-head-new', tone: 'violet', ...line(headOut, N0.in) },
	{ id: 'rt-lost', tone: 'magenta', ...line(headOut, N0.in) },
	{ id: 'rt-skip', tone: 'violet', ...bend(N0.dotAt, lift(mid(N0.dotAt, N2.in), 100), N2.in) },
	{ id: 'sh-30', tone: 'flow', ...bend(lift(slot(1), 30), lift(mid(slot(1), slot(2)), 78), lift(slot(2), 30)) },
	{ id: 'sh-20', tone: 'flow', ...bend(lift(slot(0), 30), lift(mid(slot(0), slot(1)), 78), lift(slot(1), 30)) },
	{ id: 'rd-jump', tone: 'flow', ...bend(START, lift(mid(START, slot(1)), 70), lift(slot(1), 30)) },
];
const routeLayer = (ids: string[]) => routes.filter((route) => ids.includes(route.id));
const groundRoutes = routeLayer(['rt-head-n1', 'rt-n1-n2', 'rt-n2-null', 'rt-new-n1', 'rt-head-new', 'rt-lost']);
const airRoutes = routeLayer(['rt-skip', 'sh-30', 'sh-20', 'rd-jump']);

// Where the travelling particle stops: anchors are fixed points, never travelling elements.
const hover = (g: Slab, by = 18) => lift(g.center, by);
const anchors = [
	...[0, 1, 2, 3, 4].map((i) => ({ id: `a-s${i}`, ...slot(i) })),
	{ id: 'a-head', ...hover(G.head, 16) },
	{ id: 'a-n0', ...hover(N0.g) },
	{ id: 'a-n1', ...hover(N1.g) },
	{ id: 'a-n2', ...hover(N2.g) },
	{ id: 'a-null', ...hover(G.nul, 16) },
];

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shots = [
	{ id: 'shot-arr', cx: 640, cy: 245, s: 1.45 },
	{ id: 'shot-heap', cx: 440, cy: 360, s: 1.2 },
	{ id: 'shot-insert', cx: 405, cy: 345, s: 1.3 },
	{ id: 'shot-trav', cx: 440, cy: 360, s: 1.18 },
	{ id: 'shot-remove', cx: 410, cy: 360, s: 1.3 },
	{ id: 'shot-all', cx: 500, cy: 330, s: 0.95 },
].map((item) => ({
	id: item.id,
	x: round(item.cx - 640 / item.s),
	y: round(item.cy - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = {
	id: string;
	text: string;
	x: number;
	y: number;
	align: 'start' | 'end' | 'middle';
	tone: 'plain' | Tone;
	mono?: boolean;
	check?: boolean;
	lead?: Point;
};
const S1 = slot(1);
const chips: Chip[] = [
	{ id: 'cnt-2', text: `${names.count} = 2`, x: 760, y: 380, align: 'middle', tone: 'plain', mono: true },
	{ id: 'cnt-3', text: `${names.count} = 3`, x: 760, y: 380, align: 'middle', tone: 'flow', mono: true, check: true },
	{
		id: 'lb-read',
		text: t(`${names.get}(1): un salto directo · O(1)`, `${names.get}(1): one direct jump · O(1)`),
		x: S1.x + 20,
		y: S1.y - 96,
		align: 'middle',
		tone: 'flow',
	},
	{
		id: 'lb-shift',
		text: t('n desplazamientos · O(n)', 'n shifts · O(n)'),
		x: slot(2).x,
		y: slot(2).y - 112,
		align: 'middle',
		tone: 'plain',
	},
	{
		id: 'lb-node',
		text: `${names.node}: ${names.data} | ${names.next}`,
		x: 320,
		y: 404,
		align: 'middle',
		tone: 'plain',
		mono: true,
		lead: { x: N1.g.center.x - 10, y: N1.g.center.y + 26 },
	},
	{ id: 'n0-null', text: `${names.next} = null`, x: 262, y: 374, align: 'middle', tone: 'plain', mono: true },
	{
		id: 'lost-warn',
		text: t('sin referencia: el recolector se lleva 20 y 30', 'unreferenced: the garbage collector takes 20 and 30'),
		x: 370,
		y: 474,
		align: 'middle',
		tone: 'magenta',
	},
	{
		id: 'lb-ins',
		text: t('dos asignaciones · O(1)', 'two assignments · O(1)'),
		x: 268,
		y: 374,
		align: 'middle',
		tone: 'violet',
		check: true,
	},
	{ id: 'lb-cur', text: `${names.current} = ${names.head}`, x: 348, y: 178, align: 'middle', tone: 'flow', mono: true },
	{ id: 'lb-prev', text: names.prev, x: 262, y: 374, align: 'middle', tone: 'violet', mono: true },
	{
		id: 'r-arr',
		text: t('arreglo: lectura O(1) · inserción al inicio O(n)', 'array: reading O(1) · inserting at the front O(n)'),
		x: 640,
		y: 136,
		align: 'middle',
		tone: 'flow',
	},
	{
		id: 'r-list',
		text: t('enlazada: lectura O(n) · inserción al inicio O(1)', 'linked: reading O(n) · inserting at the front O(1)'),
		x: 370,
		y: 486,
		align: 'middle',
		tone: 'violet',
		check: true,
	},
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.check ? 42 : 24));
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;
const chipJoin = (chip: Chip) =>
	chip.align === 'end' ? chipLeft(chip) + chipWidth(chip) - 14 : chip.align === 'middle' ? chip.x : chipLeft(chip) + 14;

const HEAD_TAG = lift(G.head.center, 26);
const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="tl-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="tl-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="tl-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="tl-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="tl-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="tl-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the running system, seen through the camera -->
			<g clip-path="url(#tl-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 110} rx="420" ry="300" fill="url(#tl-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + 120} cy={VP.y + VP.h - 60} rx="420" ry="300" fill="url(#tl-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- The static list: a fixed array of contiguous cells -->
						<g data-el="floor-arr">
							<polygon class="xj-plate-shadow" points={G.floorArr.base} transform="translate(10 16)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.floorArr.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.floorArr.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.floorArr.top} fill="url(#tl-g-floor)"></polygon>
							<text class="xj-floor-text" transform={floorMatrix(pt(-1.0, -1.52))}>
								{t(`int[] ${names.items} · memoria contigua`, `int[] ${names.items} · contiguous memory`)}
							</text>
							{
								cells.map((cell) => (
									<>
										<polygon class="xj-face xj-face--l" points={cell.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={cell.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={cell.g.top} fill="url(#tl-g-top)" />
										<text class="xj-face-text" transform={cell.g.faceMatrix} text-anchor="middle" y="4.5">
											{cell.i}
										</text>
									</>
								))
							}
						</g>
						<g data-el="slot-in" class="xj-lit xj-lit--flow">
							<polygon class="xj-lit-halo" points={cells[0].g.top}></polygon>
							<polygon class="xj-lit-top" points={cells[0].g.top}></polygon>
							<polygon class="xj-lit-side" points={cells[0].g.leftFace}></polygon>
						</g>

						<!-- The Heap, where the nodes of the linked list live -->
						<g data-el="floor-heap">
							<polygon class="xj-plate-shadow" points={G.floorHeap.base} transform="translate(14 22)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.floorHeap.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.floorHeap.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.floorHeap.top} fill="url(#tl-g-floor)"></polygon>
							<text class="xj-floor-text" transform={floorMatrix(pt(-1.9, 2.62))}>Heap</text>
						</g>

						<!-- The null end of the chain -->
						<g data-el="nul">
							<polygon class="xj-null" points={G.nul.top}></polygon>
							<text class="xj-null-text" x={G.nul.center.x} y={G.nul.center.y + 4.5} text-anchor="middle">null</text>
						</g>

						<!-- The head reference -->
						<g data-el="m-head">
							<polygon class="xj-shadow" points={G.head.base} transform="translate(7 9)"></polygon>
							<polygon class="xj-face xj-face--l" points={G.head.leftFace}></polygon>
							<polygon class="xj-face xj-face--r" points={G.head.rightFace}></polygon>
							<polygon class="xj-face xj-face--t" points={G.head.top} fill="url(#tl-g-top)"></polygon>
							<rect class="xj-tag xj-tag--flow" x={HEAD_TAG.x - 40} y={HEAD_TAG.y - 13} width="80" height="22" rx="11"></rect>
							<text class="xj-tag-text" x={HEAD_TAG.x} y={HEAD_TAG.y + 2.5} text-anchor="middle">{names.head}</text>
						</g>

						<!-- Nodes: a data half and a next half, each with its value and reference dot -->
						{
							nodes.map((node) => (
								<g data-el={node.id}>
									<polygon class="xj-shadow" points={node.g.base} transform="translate(7 9)" />
									<polygon class="xj-face xj-face--l" points={node.g.leftFace} />
									<polygon class="xj-face xj-face--r" points={node.g.rightFace} />
									<polygon class="xj-face xj-face--t" points={node.g.top} fill="url(#tl-g-top)" />
									<path class="xj-divider" d={node.divider} />
									<text class="xj-node-value" x={node.valueAt.x} y={node.valueAt.y + 5} text-anchor="middle">
										{node.value}
									</text>
									<circle class="xj-node-dot" cx={node.dotAt.x} cy={node.dotAt.y} r="4" />
								</g>
							))
						}

						<!-- Magenta: the chain left without any reference -->
						<g data-el="chain-lost" class="xj-lit xj-lit--magenta">
							<polygon class="xj-lit-halo" points={N1.g.top}></polygon>
							<polygon class="xj-lit-top" points={N1.g.top}></polygon>
							<polygon class="xj-lit-halo" points={N2.g.top}></polygon>
							<polygon class="xj-lit-top" points={N2.g.top}></polygon>
						</g>
						<!-- The unhooked middle node, waiting for the garbage collector -->
						<g data-el="n1-off">
							<polygon class="xj-off" points={N1.g.outline}></polygon>
						</g>

						<!-- References between the pieces, drawn over the blocks they leave -->
						{
							groundRoutes.map((route) => (
								<g data-el={route.id} class:list={['xj-flowline', `xj-flowline--${route.tone}`]}>
									<path class="mg-stroke xj-flowline-halo" pathLength="1" d={route.d} />
									<path class="mg-stroke xj-flowline-core" pathLength="1" d={route.d} />
									<polygon class="mg-head xj-flowline-head" points={route.head} />
								</g>
							))
						}

						<!-- Routes that travel through the air: shifts, the direct read and the removal jump -->
						{
							airRoutes.map((route) => (
								<g data-el={route.id} class:list={['xj-flowline', `xj-flowline--${route.tone}`]}>
									<path class="mg-stroke xj-flowline-halo" pathLength="1" d={route.d} />
									<path class="mg-stroke xj-flowline-core" pathLength="1" d={route.d} />
									<polygon class="mg-head xj-flowline-head" points={route.head} />
								</g>
							))
						}

						<!-- Values in the array cells; each one is drawn around its own origin so it can travel -->
						{
							values.map((value) => (
								<g data-el={value.id} class="xj-val" data-x={value.at.x} data-y={value.at.y}>
									<polygon class="xj-val-l" points={valCube.leftFace} />
									<polygon class="xj-val-r" points={valCube.rightFace} />
									<polygon class="xj-val-t" points={valCube.top} />
									<text class="xj-val-text" x="0" y={-VAL_H + 4.5} text-anchor="middle">
										{value.text}
									</text>
								</g>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									{chip.lead && <line class="xj-lead" x1={chip.lead.x} y1={chip.lead.y} x2={chipJoin(chip)} y2={chip.y - 12} />}
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.check && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.check ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- The execution flow: the reader of the array, then `actual` walking the chain -->
						<g data-el="p" class="xj-particle" data-x={START.x} data-y={START.y}>
							<circle r="20" fill="url(#tl-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="390" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo / Referencia', 'Flow / Reference')}</text>
				<circle class="xj-legend-violet" cx={VP.x + 196} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 208} y={LEGEND_Y + 4}>{t('Reenganche', 'Rewiring')}</text>
				<circle class="xj-legend-magenta" cx={VP.x + 300} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 312} y={LEGEND_Y + 4}>{t('Pérdida', 'Loss')}</text>
			</g>

			<!-- EDITOR: the source, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<!-- Line states sit behind the code -->
				<rect data-el="hx-lost" class="xj-bar xj-bar--trail" x={BAR.x} y={lineTop(7)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(5)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<!-- First page: the static list and the node class -->
				<g data-el="ea" data-base="shown" class="xj-code">
					<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.fileA}</text>
					{
						pageA.map((code) => (
							<g data-el={`ea-${code.n}`}>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(code.n)} text-anchor="end">
									{code.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(code.n)} xml:space="preserve" set:html={code.html} />
							</g>
						))
					}
				</g>

				<!-- Second page: the linked list -->
				<g data-el="eb" class="xj-code">
					<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.fileB}</text>
					{
						pageB.map((code) => (
							<g data-el={`eb-${code.n}`}>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(code.n)} text-anchor="end">
									{code.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(code.n)} xml:space="preserve" set:html={code.html} />
							</g>
						))
					}
				</g>

				{
					outputs.map((output) => (
						<text data-el={output.id} class="xj-out" x={ED.x + 20} y={outY(output.row)} xml:space="preserve">
							{output.text}
						</text>
					))
				}
				{lineAnchors.map((anchor) => <circle data-anchor={`ln-${anchor.n}`} cx={BAR_CX} cy={lineMid(anchor.n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow, magenta for the lost list and violet for the rewiring.
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='tad-listas-java']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='tad-listas-java'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='tad-listas-java'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='tad-listas-java'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-violet {
		fill: var(--xj-violet);
	}

	.xj-legend-magenta {
		fill: var(--xj-magenta);
	}

	/* Platforms, cells and nodes */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-floor-text {
		font-family: var(--font-body);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.04em;
		fill: var(--xj-mist);
		opacity: 0.85;
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-face-text {
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-divider {
		fill: none;
		stroke: var(--xj-mist);
		stroke-width: 1.5;
		stroke-opacity: 0.7;
	}

	.xj-node-value {
		font-family: monospace;
		font-size: 14px;
		font-weight: 700;
		fill: var(--xj-white);
	}

	.xj-node-dot {
		fill: var(--xj-flow);
	}

	.xj-null {
		fill: var(--xj-panel);
		stroke: var(--xj-dim);
		stroke-width: 1.5;
		stroke-dasharray: 4 4;
	}

	.xj-null-text {
		font-family: monospace;
		font-size: 12.5px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-off {
		fill: var(--xj-ink);
		fill-opacity: 0.66;
		stroke: var(--xj-dim);
		stroke-width: 1.5;
		stroke-dasharray: 5 4;
		stroke-linejoin: round;
	}

	/* Values travelling between array cells */
	.xj-val-t {
		fill: var(--xj-flow-soft);
		stroke: var(--xj-flow);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}

	.xj-val-l {
		fill: var(--xj-flow);
	}

	.xj-val-r {
		fill: var(--xj-steel-hi);
	}

	.xj-val-text {
		font-family: monospace;
		font-size: 13px;
		font-weight: 700;
		fill: var(--xj-ink);
	}

	/* Lit states */
	.xj-lit {
		--xj-lit: var(--xj-flow);
		--xj-lit-soft: var(--xj-flow-soft);
	}

	.xj-lit--magenta {
		--xj-lit: var(--xj-magenta);
		--xj-lit-soft: var(--xj-magenta-soft);
	}

	.xj-lit-halo {
		fill: none;
		stroke: var(--xj-lit);
		stroke-width: 12;
		stroke-opacity: 0.22;
		stroke-linejoin: round;
	}

	.xj-lit-top {
		fill: var(--xj-lit);
		fill-opacity: 0.5;
		stroke: var(--xj-lit-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-lit-side {
		fill: var(--xj-lit-soft);
		stroke: var(--xj-lit-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	/* References */
	.xj-flowline {
		--xj-line: var(--xj-flow);
	}

	.xj-flowline--magenta {
		--xj-line: var(--xj-magenta);
	}

	.xj-flowline--violet {
		--xj-line: var(--xj-violet);
	}

	.xj-flowline-halo,
	.xj-flowline-core {
		fill: none;
		stroke: var(--xj-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.xj-flowline-halo {
		stroke-width: 11;
		stroke-opacity: 0.2;
	}

	.xj-flowline-core {
		stroke-width: 3;
	}

	.xj-flowline-head {
		fill: var(--xj-line);
		stroke: var(--xj-line);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	/* Notes */
	.xj-chip {
		--xj-chip: var(--xj-edge);
		--xj-chip-ink: var(--xj-mist);
	}

	.xj-chip--flow {
		--xj-chip: var(--xj-flow);
		--xj-chip-ink: var(--xj-flow-soft);
	}

	.xj-chip--magenta {
		--xj-chip: var(--xj-magenta);
		--xj-chip-ink: var(--xj-magenta-soft);
	}

	.xj-chip--violet {
		--xj-chip: var(--xj-violet);
		--xj-chip-ink: var(--xj-violet-soft);
	}

	.xj-chip rect {
		fill: var(--xj-panel);
		fill-opacity: 0.94;
		stroke: var(--xj-chip);
		stroke-width: 1.5;
	}

	.xj-lead {
		stroke: var(--xj-chip);
		stroke-width: 1.5;
		stroke-opacity: 0.7;
	}

	.xj-chip-text {
		font-family: var(--font-body);
		font-size: 12.5px;
		font-weight: 600;
		fill: var(--xj-chip-ink);
	}

	.xj-chip-mono {
		font-family: monospace;
		font-size: 12.5px;
		fill: var(--xj-chip-ink, var(--xj-white));
	}

	.xj-icon {
		fill: none;
		stroke: var(--xj-white);
		stroke-linecap: round;
		stroke-linejoin: round;
		overflow: visible;
	}

	.xj-tag {
		fill: var(--xj-violet-deep);
		stroke: var(--xj-violet);
		stroke-width: 1.5;
	}

	.xj-tag--flow {
		fill: var(--xj-panel);
		stroke: var(--xj-flow);
	}

	.xj-tag-text {
		font-family: monospace;
		font-size: 12.5px;
		font-weight: 700;
		fill: var(--xj-white);
	}

	.xj-particle-core {
		fill: var(--xj-white);
	}

	/* Editor */
	.xj-panel {
		fill: var(--xj-panel);
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-rule {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-dot {
		fill: var(--xj-edge);
	}

	.xj-file {
		font-family: monospace;
		font-size: 13px;
		fill: var(--xj-mist);
	}

	.xj-mono,
	.xj-out {
		font-family: monospace;
		font-size: 13px;
		white-space: pre;
		fill: var(--xj-mist);
	}

	.xj-out {
		fill: var(--xj-flow-soft);
	}

	.xj-gutter {
		font-family: monospace;
		font-size: 12px;
		fill: var(--xj-dim);
	}

	.mg-canvas .xj-code :global(.tok-kw) {
		fill: var(--xj-violet-soft);
	}

	.mg-canvas .xj-code :global(.tok-type) {
		fill: var(--xj-white);
	}

	.mg-canvas .xj-code :global(.tok-fn) {
		fill: var(--xj-white);
		font-weight: 400;
	}

	.mg-canvas .xj-code :global(.tok-str),
	.mg-canvas .xj-code :global(.tok-num) {
		fill: var(--xj-flow);
	}

	.mg-canvas .xj-code :global(.tok-punct),
	.mg-canvas .xj-code :global(.tok-op) {
		fill: var(--xj-dim);
	}

	.xj-hl rect {
		fill: var(--xj-flow);
		fill-opacity: 0.18;
		stroke: var(--xj-flow);
		stroke-opacity: 0.6;
		stroke-width: 1.2;
	}

	.xj-hl path {
		fill: var(--xj-flow);
	}

	.xj-bar--trail {
		fill: none;
		stroke: var(--xj-magenta);
		stroke-width: 1.5;
		stroke-dasharray: 6 5;
	}
</style>
