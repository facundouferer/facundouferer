// Modules: one per instruction, labelled with its editor line.
type Module = { view: string; line: number; id: string; on: string; tone: Tone; g: Slab; frame: boolean };
const modTone = (view: string, line: number): Tone => {
	if (view === 'b') return line === 7 || line === 8 ? 'magenta' : line === 9 ? 'violet' : 'flow';
	if (view === 'c') return line >= 12 && line <= 14 ? 'violet' : 'flow';
	return 'flow';
};
const modulePlace = (view: string, index: number): { st: Station; u: number; v: number; z: number; frame: boolean } => {
	if (view === 'a') return { st: SA, u: -2.0 + index * 0.8, v: -3.5, z: 0, frame: false };
	if (view === 'b') {
		return index < 3
			? { st: SF, u: -0.9 + index * 0.7, v: -0.8, z: FZ + 12, frame: true }
			: { st: SF, u: -3.4 + (index - 3) * 0.7, v: -1.4, z: 0, frame: false };
	}
	if (view === 'c') return { st: SE, u: -2.2 + index * 0.9, v: -4.0, z: 0, frame: false };
	return { st: SP, u: -1.2 + index * 0.8, v: -4.0, z: 0, frame: false };
};
const modules: Module[] = Object.entries(MOD_LINES).flatMap(([view, lines]) =>
	lines.map((line, index) => {
		const place = modulePlace(view, index);
		return {
			view,
			line,
			id: `m-${view}-${line}`,
			on: `on-${view}-${line}`,
			tone: modTone(view, line),
			g: place.st.slab(place.u, place.v, 0.18, 0.18, 14, place.z),
			frame: place.frame,
		};
	}),
);
const looseModules = modules.filter((module) => !module.frame);
const frameModules = modules.filter((module) => module.frame);

// Byte strips of the padding scene: one segment per field or per gap.
const BU = 0.25;
const U0 = -3.0;
type Seg = { id: string; off: number; len: number; pad: boolean };
const SEGS_1: Seg[] = [
	{ id: 'seg-1-0', off: 0, len: 1, pad: false },
	{ id: 'seg-1-1', off: 1, len: 7, pad: true },
	{ id: 'seg-1-2', off: 8, len: 8, pad: false },
	{ id: 'seg-1-3', off: 16, len: 1, pad: false },
	{ id: 'seg-1-4', off: 17, len: 3, pad: true },
	{ id: 'seg-1-5', off: 20, len: 4, pad: false },
];
const SEGS_2: Seg[] = [
	{ id: 'seg-2-0', off: 0, len: 8, pad: false },
	{ id: 'seg-2-1', off: 8, len: 4, pad: false },
	{ id: 'seg-2-2', off: 12, len: 1, pad: false },
	{ id: 'seg-2-3', off: 13, len: 1, pad: false },
	{ id: 'seg-2-4', off: 14, len: 2, pad: true },
];
const V1 = -0.9;
const V2 = 2.3;
const stripSegs = (segs: Seg[], v: number) =>
	segs.map((seg) => ({ ...seg, g: SP.slab(U0 + (seg.off + seg.len / 2) * BU, v, (seg.len * BU) / 2 - 0.012, 0.42, 14, 6) }));
const strips = [
	{ id: 'st-1', floor: SP.slab(0, V1, 3.0, 0.5, 6, 0), segs: stripSegs(SEGS_1, V1), ticks: [8, 16], v: V1 },
	{ id: 'st-2', floor: SP.slab(-1.0, V2, 2.0, 0.5, 6, 0), segs: stripSegs(SEGS_2, V2), ticks: [8], v: V2 },
];
/** A point above (or on) the strip at a byte position. */
const byteAt = (v: number, byte: number, z = 20) => SP.pt(U0 + byte * BU, v, z);

// Anchors: where the particle stops (just above a module) and where plates rest.
const anchors = [
	...modules.map((module) => ({ id: `at-${module.view}-${module.line}`, ...lift(module.g.center, 16) })),
