	{ id: 'a-pa', ...recPA.center },
	{ id: 'a-pb', ...recPB.center },
	{ id: 'a-pp', ...recPP.center },
];
const at = (id: string) => anchors.find((anchor) => anchor.id === id) ?? { x: 0, y: 0 };

