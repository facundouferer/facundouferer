// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 68;
const LINE_H = 22;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 5;
const CONSOLE_TOP = 500;
const outY = (row: number) => 548 + row * 22;

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up. The world has four stations
// that the camera visits: the records (top left), the function call (top right),
// the enum and the union (bottom left) and the byte strips (bottom right).
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 56;
const EY = 32;
const ORIGIN = { x: 560, y: 470 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0, o: Point = ORIGIN): Point => ({
	x: round(o.x + (u - v) * EX),
	y: round(o.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');

/** A box standing at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0, o: Point = ORIGIN) {
	const top = z + h;
	const back = pt(u - a, v - b, top, o);
	const right = pt(u + a, v - b, top, o);
	const front = pt(u + a, v + b, top, o);
	const left = pt(u - a, v + b, top, o);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceC = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top, o),
		front,
		faceC,
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceC.x} ${faceC.y})`,
	};
}
type Slab = ReturnType<typeof slab>;
type Tone = 'flow' | 'violet' | 'magenta';

/** A station: a local (u, v) frame placed somewhere in the world by a screen shift. */
function station(sx: number, sy: number) {
	const U = (sx / EX + sy / EY) / 2;
	const V = (sy / EY - sx / EX) / 2;
	return {
		slab: (u: number, v: number, a: number, b: number, h: number, z = 0) => slab(U + u, V + v, a, b, h, z),
		pt: (u: number, v: number, z = 0) => pt(U + u, V + v, z),
		ring: (u0: number, u1: number, v0: number, v1: number, z = 0) =>
			poly([pt(U + u0, V + v0, z), pt(U + u1, V + v0, z), pt(U + u1, V + v1, z), pt(U + u0, V + v1, z)]),
	};
}
type Station = ReturnType<typeof station>;
const SA = station(0, 0);
const SF = station(620, 40);
const SE = station(0, 540);
const SP = station(560, 560);

// Records: a plate (the floor) with one cell per field laid out along u, in order.
// Each cell has its name on the front edge and its value on top.
type Field = { key: string; label: string; u: number; a: number; cellId?: string };
type Floor = { a: number; b: number; h: number };
const CELL_H = 16;
function makeRecord(st: Station, u0: number, v: number, z: number, floor: Floor, fields: Field[], cellB = 0.5) {
	return {
		floor,
		fields,
		cellB,
		floorSlab: st.slab(u0, v, floor.a, floor.b, floor.h, z),
		cells: fields.map((field) => ({ ...field, g: st.slab(u0 + field.u, v, field.a, cellB, CELL_H, z + floor.h) })),
		center: st.pt(u0, v, z + floor.h + CELL_H),
	};
}
type Rec = ReturnType<typeof makeRecord>;

// struct alumno: int, char[40], double (cell widths hint at their sizes).
