// A ghost is the whole plate on the move: the copy a call makes.
function ghostOf(rec: Rec) {
	const o = { x: 0, y: rec.floor.h + CELL_H };
	return {
		floor: slab(0, 0, rec.floor.a, rec.floor.b, rec.floor.h, 0, o),
		cells: rec.fields.map((field) => slab(field.u, 0, field.a, rec.cellB, CELL_H, rec.floor.h, o)),
	};
}
const ghostA = ghostOf(recA);
