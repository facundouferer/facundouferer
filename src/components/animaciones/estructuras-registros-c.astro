	{ id: 'shot-arr', c: { x: 540, y: 470 }, s: 0.85 },
	{ id: 'shot-fn', c: SF.pt(0, 0.3, 85), s: 0.95 },
	{ id: 'shot-en', c: SE.pt(0, -1.6, 10), s: 1.05 },
	{ id: 'shot-val', c: { x: 575, y: 1015 }, s: 1.3 },
	{ id: 'shot-pad', c: SP.pt(0.6, 0.5, 10), s: 0.85 },
	{ id: 'shot-all', c: { x: 840, y: 739 }, s: 0.5 },
].map((item) => ({
	id: item.id,
	x: round(item.c.x - 640 / item.s),
	y: round(item.c.y - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Routes: the copy going up into the frame, the returned copy coming down, and the
// short arrows of the union.
const PP = recPP.center;
const PA = recPA.center;
const PB = recPB.center;
const DAT = recVal.cells[1].g.center;
const TAG = recVal.cells[0].g.center;
const routes = [
	{
		id: 'fl-cp',
		tone: 'flow',
		d: `M${PA.x + 40} ${PA.y - 18} C${PA.x + 100} ${PA.y - 100} ${PP.x - 130} ${PP.y + 70} ${PP.x - 46} ${PP.y + 12}`,
	},
	{
		id: 'fl-ret',
		tone: 'violet',
		d: `M${PP.x + 46} ${PP.y + 12} C${PP.x + 140} ${PP.y + 70} ${PB.x - 110} ${PB.y - 130} ${PB.x - 30} ${PB.y - 28}`,
	},
	{ id: 'fl-int', tone: 'flow', d: `M${DAT.x + 114} ${DAT.y - 20} L${DAT.x + 36} ${DAT.y - 4}` },
	{ id: 'fl-real', tone: 'violet', d: `M${DAT.x + 114} ${DAT.y + 14} L${DAT.x + 36} ${DAT.y + 4}` },
	{ id: 'fl-tag', tone: 'violet', d: `M${TAG.x + 46} ${TAG.y + 6} L${DAT.x - 74} ${DAT.y - 6}` },
	{ id: 'fl-bad', tone: 'magenta', d: `M${DAT.x} ${DAT.y + 66} L${DAT.x} ${DAT.y + 16}` },
];

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = {
	id: string;
	text: string;
	x: number;
	y: number;
	align: 'start' | 'end' | 'middle';
	tone: 'plain' | Tone;
	mono?: boolean;
	big?: boolean;
	icon?: 'copy';
};
const cellTop = (rec: Rec, index: number) => rec.cells[index].g.center;
const nameChip = (id: string, text: string, p: Point, dy = -34): Chip => ({ id, text, x: p.x, y: p.y + dy, align: 'middle', tone: 'plain' });
const END_1 = byteAt(V1, 24, 6);
const END_2 = byteAt(V2, 16, 6);
const RET_MID = { x: (PP.x + PB.x) / 2 + 34, y: (PP.y + PB.y) / 2 + 24 };
const chips: Chip[] = [
	// The record `a` and its types.
	{ id: 'ty-int', text: 'int', x: cellTop(recA, 0).x, y: cellTop(recA, 0).y - 44, align: 'middle', tone: 'flow', mono: true },
	{ id: 'ty-str', text: 'char[40]', x: cellTop(recA, 1).x, y: cellTop(recA, 1).y - 56, align: 'middle', tone: 'flow', mono: true },
	{ id: 'ty-dbl', text: 'double', x: cellTop(recA, 2).x, y: cellTop(recA, 2).y - 44, align: 'middle', tone: 'flow', mono: true },
	{ id: 'dot-leg', text: `a.${names.id}`, x: recA.cells[0].g.faceC.x, y: recA.cells[0].g.faceC.y + 30, align: 'middle', tone: 'violet', mono: true },
	{ id: 'dot-nom', text: `a.${names.name}`, x: recA.cells[1].g.faceC.x, y: recA.cells[1].g.faceC.y + 30, align: 'middle', tone: 'violet', mono: true },
	{ id: 'dot-pro', text: `a.${names.average}`, x: recA.cells[2].g.faceC.x, y: recA.cells[2].g.faceC.y + 30, align: 'middle', tone: 'violet', mono: true },
	// The array.
	{ id: 'ix-0', text: `${names.group}[0]`, x: SA.pt(-2.5, 1.25, 12).x - 10, y: SA.pt(-2.5, 1.25, 12).y, align: 'end', tone: 'plain', mono: true },
	{ id: 'ix-1', text: `${names.group}[1]`, x: SA.pt(-2.5, 2.9, 12).x - 10, y: SA.pt(-2.5, 2.9, 12).y, align: 'end', tone: 'plain', mono: true },
	{ id: 'arr-tag', text: t('arreglo de registros', 'array of records'), x: SA.pt(0, 3.9, 0).x, y: SA.pt(0, 3.9, 0).y, align: 'middle', tone: 'violet' },
	// The call.
	{ id: 'tag-main', text: 'main', x: SF.pt(-3.7, -1.4, 0).x - 8, y: SF.pt(-3.7, -1.4, 0).y, align: 'end', tone: 'plain', mono: true },
	{ id: 'lb-copy', text: t('copia completa', 'a whole copy'), x: PP.x, y: PP.y - 64, align: 'middle', tone: 'flow', icon: 'copy' },
	{ id: 'lb-same', text: 'a: (1.0, 2.0)', x: PA.x, y: PA.y + 66, align: 'middle', tone: 'flow', mono: true },
	{ id: 'lb-ret', text: 'return', x: RET_MID.x, y: RET_MID.y, align: 'start', tone: 'violet', mono: true },
	{ id: 'lb-cost', text: t('copiar cuesta: cada byte', 'copying costs: every byte'), x: PB.x, y: PB.y - 72, align: 'middle', tone: 'magenta' },
	// The enum and the union.
	{ id: 'tag-en', text: `enum ${names.kindType}`, x: recEn.center.x - 50, y: recEn.center.y - 62, align: 'middle', tone: 'flow', mono: true },
	{ id: 'tag-chk', text: `${names.kind} == REAL`, x: TAG.x - 10, y: TAG.y + 70, align: 'middle', tone: 'violet', mono: true },
	{ id: 'alt-int', text: names.integer, x: DAT.x + 118, y: DAT.y - 20, align: 'start', tone: 'flow', mono: true },
	{ id: 'alt-real', text: 'real', x: DAT.x + 118, y: DAT.y + 14, align: 'start', tone: 'violet', mono: true },
	{ id: 'bad', text: t(`leer ${names.integer}: sin sentido`, `reading ${names.integer}: no sense`), x: DAT.x, y: DAT.y + 80, align: 'middle', tone: 'magenta' },
	{ id: 'sz-val', text: `sizeof(${names.valueType}) = 16`, x: DAT.x, y: DAT.y + 116, align: 'middle', tone: 'flow', mono: true },
	// The strips.
	nameChip('ch1-activo', names.active, byteAt(V1, 0.5)),
	nameChip('ch1-saldo', names.balance, byteAt(V1, 12)),
	nameChip('ch1-tipo', names.kind, byteAt(V1, 16.5)),
	nameChip('ch1-numero', names.number, byteAt(V1, 22)),
	{ id: 'al-8', text: t('múltiplo de 8', 'multiple of 8'), x: byteAt(V1, 8, 20).x, y: byteAt(V1, 8, 20).y - 70, align: 'middle', tone: 'violet', mono: true },
	{ id: 'ch1-pad7', text: t('relleno: 7', 'padding: 7'), x: byteAt(V1, 4.5, 6).x, y: byteAt(V1, 4.5, 6).y + 32, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'ch1-pad3', text: t('relleno: 3', 'padding: 3'), x: byteAt(V1, 18.5, 6).x, y: byteAt(V1, 18.5, 6).y + 32, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'tot-sum', text: t('campos: 14 bytes', 'fields: 14 bytes'), x: END_1.x + 14, y: END_1.y - 26, align: 'start', tone: 'flow', mono: true },
	{ id: 'tot-1', text: t('24 bytes', '24 bytes'), x: END_1.x + 14, y: END_1.y + 4, align: 'start', tone: 'magenta', mono: true },
	nameChip('ch2-saldo', names.balance, byteAt(V2, 4)),
	nameChip('ch2-numero', names.number, byteAt(V2, 10)),
	nameChip('ch2-chars', `${names.active}, ${names.kind}`, byteAt(V2, 13.2)),
	{ id: 'ch2-pad2', text: t('relleno: 2', 'padding: 2'), x: byteAt(V2, 15, 6).x, y: byteAt(V2, 15, 6).y + 32, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'tot-2', text: t('16 bytes', '16 bytes'), x: END_2.x + 14, y: END_2.y + 4, align: 'start', tone: 'violet', mono: true },
	// The summary, read from far away.
	{ id: 'sum-a', text: t('struct y campos', 'struct and fields'), x: SA.pt(1.4, 4.6, 0).x, y: SA.pt(1.4, 4.6, 0).y, align: 'middle', tone: 'flow', big: true },
	{ id: 'sum-f', text: t('copia al pasar', 'copy on call'), x: SF.pt(0, 3.1, 0).x, y: SF.pt(0, 3.1, 0).y, align: 'middle', tone: 'violet', big: true },
	{ id: 'sum-e', text: t('enum y union', 'enum and union'), x: SE.pt(0, 3.6, 0).x, y: SE.pt(0, 3.6, 0).y, align: 'middle', tone: 'flow', big: true },
	{ id: 'sum-p', text: t('relleno', 'padding'), x: SP.pt(-1.0, 4.6, 0).x, y: SP.pt(-1.0, 4.6, 0).y, align: 'middle', tone: 'magenta', big: true },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.big ? 13.4 : chip.mono ? 7.9 : 6.7) + (chip.big ? 40 : chip.icon ? 42 : 24));
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="er-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="er-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="er-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="er-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="er-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="er-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the world of records, seen through the camera -->
			<g clip-path="url(#er-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#er-g-pool-violet)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#er-g-pool-flow)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- Modules of the programs that run in the stations without a frame -->
						{
							looseModules.map((module) => (
								<>
									<g data-el={module.id} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(5 7)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#er-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4">
											{module.line}
										</text>
									</g>
									<g data-el={module.on} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
										<polygon class="xj-lit-halo" points={module.g.top} />
										<polygon class="xj-lit-top" points={module.g.top} />
										<polygon class="xj-lit-side" points={module.g.leftFace} />
										<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4">
											{module.line}
										</text>
									</g>
								</>
							))
						}

						<!-- The zone of the array: a dashed ring around its elements -->
						<g data-el="zone-arr" class="xj-zone xj-zone--violet">
							<polygon points={SA.ring(-2.8, 2.8, -0.4, 3.1, 0)}></polygon>
						</g>

						<!-- Records: plates with one cell per field, name on the front and value on top -->
						{
							records.slice(0, 5).map((entry) => (
								<g data-el={entry.id}>
									<polygon class="xj-plate-shadow" points={entry.rec.floorSlab.base} transform="translate(10 15)" />
									<polygon class="xj-plate xj-plate--l" points={entry.rec.floorSlab.leftFace} />
									<polygon class="xj-plate xj-plate--r" points={entry.rec.floorSlab.rightFace} />
									<polygon class="xj-plate xj-plate--t" points={entry.rec.floorSlab.top} fill="url(#er-g-floor)" />
									{entry.rec.cells.map((cell) => (
										<g data-el={cell.cellId} data-base={cell.cellId ? 'shown' : undefined}>
											<polygon class="xj-cell xj-cell--l" points={cell.g.leftFace} />
											<polygon class="xj-cell xj-cell--r" points={cell.g.rightFace} />
											<polygon class="xj-cell xj-cell--t" points={cell.g.top} />
											<text class="xj-cell-name" transform={cell.g.faceMatrix} text-anchor="middle" y="4">
												{cell.label}
											</text>
										</g>
									))}
									{entry.values.map((value) => (
										<text
											data-el={value.id}
											class:list={['xj-value', value.text.length > 5 && 'xj-value--sm', value.tone && `xj-value--${value.tone}`]}
											x={entry.rec.cells[value.f].g.center.x}
											y={entry.rec.cells[value.f].g.center.y + 6}
											text-anchor="middle"
										>
											{value.text}
										</text>
									))}
								</g>
							))
						}

						<!-- The cells of `a`, lit while the dot reaches them -->
						{
							litCells.map((cell) => (
								<g data-el={cell.id} class="xj-lit xj-lit--violet">
									<polygon class="xj-lit-halo" points={cell.g.top} />
									<polygon class="xj-lit-top" points={cell.g.top} />
									<polygon class="xj-lit-side" points={cell.g.leftFace} />
								</g>
							))
						}

						<!-- The frame of the called function, raised above `main` and popped on return -->
						<g data-el="f-fn">
							<polygon class="xj-plate-shadow" points={FRAME.base} transform="translate(12 18)" />
							<polygon class="xj-plate xj-plate--l" points={FRAME.leftFace} />
							<polygon class="xj-plate xj-plate--r" points={FRAME.rightFace} />
							<polygon class="xj-plate xj-plate--t xj-plate--frame" points={FRAME.top} fill="url(#er-g-floor)" />
							<text class="xj-frame-name" transform={FRAME.faceMatrix} text-anchor="middle" y="4">{`${names.translate}(struct ${names.point} p)`}</text>
							{
								frameModules.map((module) => (
									<>
										<g data-el={module.id} data-base="shown" class="xj-mod">
											<polygon class="xj-shadow" points={module.g.base} transform="translate(5 7)" />
											<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
											<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
											<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#er-g-top)" />
											<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4">
												{module.line}
											</text>
										</g>
										<g data-el={module.on} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
											<polygon class="xj-lit-halo" points={module.g.top} />
											<polygon class="xj-lit-top" points={module.g.top} />
											<polygon class="xj-lit-side" points={module.g.leftFace} />
											<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4">
												{module.line}
											</text>
										</g>
									</>
								))
							}
						</g>

						<!-- The plate inside the frame: the copy the function works on -->
						{
							records.slice(5, 6).map((entry) => (
								<g data-el={entry.id}>
									<polygon class="xj-plate xj-plate--l" points={entry.rec.floorSlab.leftFace} />
									<polygon class="xj-plate xj-plate--r" points={entry.rec.floorSlab.rightFace} />
									<polygon class="xj-plate xj-plate--t" points={entry.rec.floorSlab.top} fill="url(#er-g-floor)" />
									{entry.rec.cells.map((cell) => (
										<>
											<polygon class="xj-cell xj-cell--l" points={cell.g.leftFace} />
											<polygon class="xj-cell xj-cell--r" points={cell.g.rightFace} />
											<polygon class="xj-cell xj-cell--t" points={cell.g.top} />
											<text class="xj-cell-name" transform={cell.g.faceMatrix} text-anchor="middle" y="4">
												{cell.label}
											</text>
										</>
									))}
									{entry.values.map((value) => (
										<text
											data-el={value.id}
											class:list={['xj-value', value.tone && `xj-value--${value.tone}`]}
											x={entry.rec.cells[value.f].g.center.x}
											y={entry.rec.cells[value.f].g.center.y + 6}
											text-anchor="middle"
										>
											{value.text}
										</text>
									))}
								</g>
							))
						}

						<!-- The enum: a shelf of named integers -->
						{
							records.slice(6, 7).map((entry) => (
								<g data-el={entry.id}>
									<polygon class="xj-plate-shadow" points={entry.rec.floorSlab.base} transform="translate(10 15)" />
									<polygon class="xj-plate xj-plate--l" points={entry.rec.floorSlab.leftFace} />
									<polygon class="xj-plate xj-plate--r" points={entry.rec.floorSlab.rightFace} />
									<polygon class="xj-plate xj-plate--t" points={entry.rec.floorSlab.top} fill="url(#er-g-floor)" />
									{entry.rec.cells.map((cell) => (
										<>
											<polygon class="xj-cell xj-cell--l" points={cell.g.leftFace} />
											<polygon class="xj-cell xj-cell--r" points={cell.g.rightFace} />
											<polygon class="xj-cell xj-cell--t" points={cell.g.top} />
											<text class="xj-cell-name" transform={cell.g.faceMatrix} text-anchor="middle" y="4">
												{cell.label}
											</text>
										</>
									))}
									{entry.values.map((value) => (
										<text
											data-el={value.id}
											class="xj-value"
											x={entry.rec.cells[value.f].g.center.x}
											y={entry.rec.cells[value.f].g.center.y + 6}
											text-anchor="middle"
										>
											{value.text}
										</text>
									))}
								</g>
							))
						}

						<!-- The tagged union: a tag cell and one cell that two names share -->
						{
							records.slice(7, 8).map((entry) => (
								<g data-el={entry.id}>
									<polygon class="xj-plate-shadow" points={entry.rec.floorSlab.base} transform="translate(10 15)" />
									<polygon class="xj-plate xj-plate--l" points={entry.rec.floorSlab.leftFace} />
									<polygon class="xj-plate xj-plate--r" points={entry.rec.floorSlab.rightFace} />
									<polygon class="xj-plate xj-plate--t" points={entry.rec.floorSlab.top} fill="url(#er-g-floor)" />
									{entry.rec.cells.map((cell) => (
										<g data-el={cell.cellId} data-base={cell.cellId ? 'shown' : undefined}>
											<polygon class="xj-cell xj-cell--l" points={cell.g.leftFace} />
											<polygon class="xj-cell xj-cell--r" points={cell.g.rightFace} />
											<polygon class:list={['xj-cell xj-cell--t', cell.cellId && 'xj-cell--violet']} points={cell.g.top} />
											<text class="xj-cell-name" transform={cell.g.faceMatrix} text-anchor="middle" y="4">
												{cell.label}
											</text>
										</g>
									))}
									{entry.values.map((value) => (
										<text
											data-el={value.id}
											class:list={['xj-value', value.tone && `xj-value--${value.tone}`]}
											x={entry.rec.cells[value.f].g.center.x}
											y={entry.rec.cells[value.f].g.center.y + 6}
											text-anchor="middle"
										>
											{value.text}
										</text>
									))}
								</g>
							))
						}

						<!-- Byte strips: one segment per field, magenta for the gaps the compiler leaves -->
						{
							strips.map((strip) => (
								<>
									<g data-el={strip.id}>
										<polygon class="xj-plate-shadow" points={strip.floor.base} transform="translate(8 12)" />
										<polygon class="xj-plate xj-plate--l" points={strip.floor.leftFace} />
										<polygon class="xj-plate xj-plate--r" points={strip.floor.rightFace} />
										<polygon class="xj-plate xj-plate--t" points={strip.floor.top} fill="url(#er-g-floor)" />
										{strip.ticks.map((tick) => (
											<path class="xj-tick" d={`M${byteAt(strip.v - 0.5, tick, 6).x} ${byteAt(strip.v - 0.5, tick, 6).y} L${byteAt(strip.v + 0.5, tick, 6).x} ${byteAt(strip.v + 0.5, tick, 6).y}`} />
										))}
									</g>
									{strip.segs.map((segment) => (
										<g data-el={segment.id}>
											<polygon class:list={['xj-seg xj-seg--l', segment.pad && 'xj-seg--pad']} points={segment.g.leftFace} />
											<polygon class:list={['xj-seg xj-seg--r', segment.pad && 'xj-seg--pad']} points={segment.g.rightFace} />
											<polygon class:list={['xj-seg xj-seg--t', segment.pad && 'xj-seg--pad']} points={segment.g.top} />
										</g>
									))}
								</>
							))
						}

						<!-- Routes: the copy that goes up, the copy that comes back, the arrows of the union -->
						{
							routes.map((route) => (
								<g data-el={route.id} class:list={['xj-flowline', `xj-flowline--${route.tone}`]}>
									<path class="mg-stroke xj-flowline-halo" pathLength="1" d={route.d} />
									<path class="mg-stroke xj-flowline-core" pathLength="1" d={route.d} />
								</g>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - (chip.big ? 22 : 12)} width={chipWidth(chip)} height={chip.big ? 44 : 24} rx={chip.big ? 22 : 12} />
									{chip.icon === 'copy' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
											<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
										</svg>
									)}
									<text
										class={chip.big ? 'xj-chip-big' : chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.icon ? 9 : 0)}
										y={chip.y + (chip.big ? 8.5 : 4.5)}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- Ghosts: the whole plate on the move. Placement lives on the inner group: the player resets data-el transforms. -->
						{
							ghosts.map((ghost) => (
								<g data-el={ghost.id} data-x={ghost.from.x} data-y={ghost.from.y}>
									<g class:list={['xj-ghost', `xj-ghost--${ghost.tone}`]}>
										<polygon class="xj-ghost-side" points={ghost.g.floor.leftFace} />
										<polygon class="xj-ghost-side" points={ghost.g.floor.rightFace} />
										<polygon class="xj-ghost-top" points={ghost.g.floor.top} />
										{ghost.g.cells.map((cell) => <polygon class="xj-ghost-cell" points={cell.top} />)}
									</g>
								</g>
							))
						}

						<!-- The execution flow -->
						<g data-el="p" class="xj-particle" data-x={at('at-a-8').x} data-y={at('at-a-8').y}>
							<circle r="20" fill="url(#er-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="400" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<rect class="xj-legend-frame" x={VP.x + 172} y={LEGEND_Y - 6} width="22" height="12" rx="3"></rect>
				<text x={VP.x + 202} y={LEGEND_Y + 4}>{t('Registro', 'Record')}</text>
				<rect class="xj-legend-pad" x={VP.x + 282} y={LEGEND_Y - 6} width="22" height="12" rx="3"></rect>
				<text x={VP.x + 312} y={LEGEND_Y + 4}>{t('Relleno', 'Padding')}</text>
			</g>

			<!-- EDITOR: the lesson's programs, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<!-- Ranges that a scene is talking about -->
				{
					ranges.map((range) => (
						<g data-el={range.id} class:list={['xj-range', range.kind === 'hx' && 'xj-range--magenta']}>
							<rect x={BAR.x} y={lineTop(range.from)} width={BAR.w} height={(range.to - range.from + 1) * LINE_H} rx="6"></rect>
						</g>
					))
				}

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(8)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				{
					views.map((view) => (
						<g data-el={`ed-${view.id}`} data-base={view.id === 'a' ? 'shown' : undefined} class="xj-code">
							<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{view.file}</text>
							{view.lines.map((line) => (
								<g>
									<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
										{line.n}
									</text>
									<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
								</g>
							))}
						</g>
					))
				}

				<!-- Console: the real output, typed as each line runs -->
				{
					outputs.map((row) => (
						<text data-el={row.id} class="xj-out" x={ED.x + 20} y={outY(row.row)} xml:space="preserve">
							{row.text}
						</text>
					))
				}
				{Array.from({ length: 18 }, (_, index) => index + 1).map((n) => <circle data-anchor={`ln-${n}`} cx={BAR_CX} cy={lineMid(n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow and plain data, magenta for what is lost or wasted (the
	   change on the copy, the padding), and violet for what resolves it (the tag,
	   the returned copy). Every rule below reads these tokens; no other color is
	   written in this file. */
	:global(.anim-player[data-slug='estructuras-registros-c']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='estructuras-registros-c'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='estructuras-registros-c'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='estructuras-registros-c'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-frame {
		fill: var(--xj-deep-hi);
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend-pad {
		fill: var(--xj-magenta-deep);
		stroke: var(--xj-magenta);
		stroke-width: 1.5;
	}

	/* Plates, frames and modules */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate--frame {
		stroke: var(--xj-violet);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-frame-name {
		font-family: monospace;
		font-size: 11px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-face-text {
		font-family: var(--font-body);
		font-size: 11px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face-text--on {
		fill: var(--xj-ink);
	}

	/* Fields: a cell with its name on the front and its value on top */
	.xj-cell {
		stroke: var(--xj-flow);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-cell--l {
		fill: var(--xj-steel);
	}

	.xj-cell--r {
		fill: var(--xj-deep);
	}

	.xj-cell--t {
		fill: var(--xj-ink);
	}

	.xj-cell--violet {
		stroke: var(--xj-violet);
	}

	.xj-cell-name {
		font-family: monospace;
		font-size: 11px;
		font-weight: 700;
		fill: var(--xj-white);
	}

	.xj-value {
		font-family: monospace;
		font-size: 17px;
		font-weight: 700;
		fill: var(--xj-flow-soft);
	}

	.xj-value--sm {
		font-size: 13px;
	}

	.xj-value--violet {
		fill: var(--xj-violet-soft);
	}

	.xj-value--magenta {
		fill: var(--xj-magenta-soft);
	}

	/* Byte strips */
	.xj-seg {
		stroke: var(--xj-flow);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}

	.xj-seg--l {
		fill: var(--xj-steel);
	}

	.xj-seg--r {
		fill: var(--xj-deep);
	}

	.xj-seg--t {
		fill: var(--xj-ink);
	}

	.xj-seg--pad {
		stroke: var(--xj-magenta);
	}

	.xj-seg--pad.xj-seg--l,
	.xj-seg--pad.xj-seg--r,
	.xj-seg--pad.xj-seg--t {
		fill: var(--xj-magenta-deep);
	}

	.xj-tick {
		fill: none;
		stroke: var(--xj-violet-soft);
		stroke-width: 1.5;
		stroke-dasharray: 4 4;
	}

	/* Lit states */
	.xj-lit {
		--xj-lit: var(--xj-flow);
		--xj-lit-soft: var(--xj-flow-soft);
	}

	.xj-lit--violet {
		--xj-lit: var(--xj-violet);
		--xj-lit-soft: var(--xj-violet-soft);
	}

	.xj-lit--magenta {
		--xj-lit: var(--xj-magenta);
		--xj-lit-soft: var(--xj-magenta-soft);
	}

	.xj-lit-halo {
		fill: none;
		stroke: var(--xj-lit);
		stroke-width: 12;
		stroke-opacity: 0.22;
		stroke-linejoin: round;
	}

	.xj-lit-top {
		fill: var(--xj-lit);
		fill-opacity: 0.5;
		stroke: var(--xj-lit-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-lit-side {
		fill: var(--xj-lit-soft);
		stroke: var(--xj-lit-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	/* The array's zone */
	.xj-zone polygon {
		fill: none;
		stroke: var(--xj-zone);
		stroke-width: 2;
		stroke-dasharray: 8 7;
		stroke-linejoin: round;
	}

	.xj-zone--violet {
		--xj-zone: var(--xj-violet-soft);
	}

	/* Routes */
	.xj-flowline {
		--xj-line: var(--xj-flow);
	}

	.xj-flowline--violet {
		--xj-line: var(--xj-violet);
	}

	.xj-flowline--magenta {
		--xj-line: var(--xj-magenta);
	}

	.xj-flowline-halo,
	.xj-flowline-core {
		fill: none;
		stroke: var(--xj-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.xj-flowline-halo {
		stroke-width: 11;
		stroke-opacity: 0.2;
	}

	.xj-flowline-core {
		stroke-width: 3;
	}

	/* Notes */
	.xj-chip {
		--xj-chip: var(--xj-edge);
		--xj-chip-ink: var(--xj-mist);
	}

	.xj-chip--flow {
		--xj-chip: var(--xj-flow);
		--xj-chip-ink: var(--xj-flow-soft);
	}

	.xj-chip--magenta {
		--xj-chip: var(--xj-magenta);
		--xj-chip-ink: var(--xj-magenta-soft);
	}

	.xj-chip--violet {
		--xj-chip: var(--xj-violet);
		--xj-chip-ink: var(--xj-violet-soft);
	}

	.xj-chip rect {
		fill: var(--xj-panel);
		fill-opacity: 0.94;
		stroke: var(--xj-chip);
		stroke-width: 1.5;
	}

	.xj-chip-text {
		font-family: var(--font-body);
		font-size: 12.5px;
		font-weight: 600;
		fill: var(--xj-chip-ink);
	}

	.xj-chip-mono {
		font-family: monospace;
		font-size: 12.5px;
		fill: var(--xj-chip-ink, var(--xj-white));
	}

	.xj-icon {
		fill: none;
		stroke: var(--xj-chip-ink);
		stroke-linecap: round;
		stroke-linejoin: round;
		overflow: visible;
	}

	.xj-chip-big {
		font-family: var(--font-body);
		font-size: 24px;
		font-weight: 700;
		fill: var(--xj-chip-ink);
	}

	/* Ghosts: the plate that travels */
	.xj-ghost {
		--xj-ghost: var(--xj-flow);
		--xj-ghost-soft: var(--xj-flow-soft);
	}

	.xj-ghost--violet {
		--xj-ghost: var(--xj-violet);
		--xj-ghost-soft: var(--xj-violet-soft);
	}

	.xj-ghost-side,
	.xj-ghost-top {
		fill: var(--xj-ghost);
		fill-opacity: 0.22;
		stroke: var(--xj-ghost-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-ghost-cell {
		fill: var(--xj-ghost);
		fill-opacity: 0.5;
		stroke: var(--xj-ghost-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-particle-core {
		fill: var(--xj-white);
	}

	/* Editor */
	.xj-panel {
		fill: var(--xj-panel);
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-rule {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
