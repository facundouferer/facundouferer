			{ id: '5l', kind: 'op', text: '-', x: 510, y: 164 },
			{ id: '5c', kind: 'leaf', text: '3', x: 630, y: 164 },
			{ id: '5a', kind: 'leaf', text: '10', x: 450, y: 248 },
			{ id: '5b', kind: 'leaf', text: '4', x: 570, y: 248 },
