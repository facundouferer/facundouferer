	},
	{
		line: 12,
		root: '12r',
		nodes: [
			{ id: '12r', kind: 'op', text: '%', x: 190, y: 760 },
			{ id: '12a', kind: 'leaf', text: '-7', x: 130, y: 844 },
			{ id: '12b', kind: 'leaf', text: '3', x: 250, y: 844 },
		],
		edges: [['12r', '12a'], ['12r', '12b']],
		target: B.rest,
		targetName: names.rest,
	},
];

const cubes = new Map<string, Cube>();
const plates = new Map<string, Plate>();
for (const tree of trees) {
	for (const node of tree.nodes) {
		if (node.kind === 'op') cubes.set(node.id, cube(node.x, node.y));
		else plates.set(node.id, node.kind === 'wide' ? plate(node.x, node.y, 100, 22) : plate(node.x, node.y));
	}
}
const tipOf = (id: string): Point => cubes.get(id)?.topTip ?? plates.get(id)!.tip;
const treeParts = trees.map((tree) => ({
	tree,
	wires: tree.edges.map(([parent, child]) => wire(cubes.get(parent)!.bottom, tipOf(child))),
}));

