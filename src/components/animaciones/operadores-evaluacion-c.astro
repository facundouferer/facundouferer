	{ id: 'rs-14', text: '6 6 6 5 -1', x: 462, y: 848, align: 'start', tone: 'flow', mono: true },
	{ id: 'lb-prec', text: t('precedencia: * antes que +', 'precedence: * before +'), x: 150, y: 12, align: 'middle', tone: 'flow' },
	{ id: 'lb-no9', text: t('no es 10 - (4 - 3) = 9', 'not 10 - (4 - 3) = 9'), x: 570, y: 288, align: 'middle', tone: 'magenta' },
	{ id: 'lb-skip7', text: t('no se evalúa: dividiría por cero', 'not evaluated: it would divide by zero'), x: 335, y: 468, align: 'middle', tone: 'magenta' },
	{ id: 'lb-skip8', text: t('no se evalúa', 'not evaluated'), x: 775, y: 468, align: 'middle', tone: 'magenta' },
	{ id: 'lb-order', text: t('el orden importa', 'order matters'), x: 500, y: 562, align: 'middle', tone: 'violet' },
	{ id: 'lb-div', text: '-7 / 3 = -2', x: 130, y: 712, align: 'middle', tone: 'flow', mono: true },
	{ id: 'lb-ident', text: '-2 * 3 + (-1) = -7', x: 190, y: 892, align: 'middle', tone: 'violet', mono: true },
	{ id: 'lb-ub1', text: t('dos modificaciones sin orden', 'two modifications, no order'), x: 820, y: 772, align: 'middle', tone: 'magenta' },
	{ id: 'lb-ub2', text: t('desborda un int con signo', 'signed int overflow'), x: 790, y: 935, align: 'middle', tone: 'magenta' },
	{ id: 'lb-ok', text: t('la precedencia agrupa; no ordena', 'precedence groups; it does not order'), x: 480, y: 12, align: 'middle', tone: 'violet' },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + 24);
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

// Operands that are sealed because they are never evaluated, and the boxes that refuse a value.
const sealedPlates = [
	{ id: 'seal-7', p: plates.get('7w')! },
	{ id: 'seal-8', p: plates.get('8w')! },
];
const sealedBoxes = [
	{ id: 'seal-15', top: B.i.top, icon: { x: B.i.leftC.x + 12, y: B.i.leftC.y - 16 } },
	{ id: 'seal-16', top: B.big.top, icon: { x: B.big.leftC.x + 12, y: B.big.leftC.y - 16 } },
];

const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="eval" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="oe-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="oe-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<radialGradient id="oe-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="oe-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="oe-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: every expression as a tree, seen through the camera -->
			<g clip-path="url(#oe-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#oe-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#oe-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- Declarations: each box is the module of its line -->
						{
							declarations.map((decl) => (
								<>
									<g data-el={`m-${decl.line}`} class="xj-mod">
										{decl.boxes.map((spec) => (
											<g>
												<polygon class="xj-shadow" points={spec.g.base} transform="translate(6 8)" />
												<polygon class="xj-face xj-face--l" points={spec.g.front} />
												<polygon class="xj-face xj-face--r" points={spec.g.end} />
												<polygon class="xj-face xj-face--t" points={spec.g.top} fill="url(#oe-g-top)" />
												<text class="xj-name" x={spec.g.labelAt.x} y={spec.g.labelAt.y}>
													{spec.name}
													<tspan class="xj-type"> · {spec.type}</tspan>
													<tspan class="xj-line"> · {decl.line}</tspan>
												</text>
												{spec.value && (
													<text class="xj-value" x={spec.g.valueAt.x} y={spec.g.valueAt.y} text-anchor="middle">
														{spec.value}
													</text>
												)}
											</g>
										))}
									</g>
									<g data-el={`on-${decl.line}`} class="xj-lit xj-lit--flow">
										{decl.boxes.map((spec) => (
											<g>
												<polygon class="xj-lit-halo" points={spec.g.top} />
												<polygon class="xj-lit-top xj-lit-top--soft" points={spec.g.top} />
												<polygon class="xj-lit-side xj-lit-side--soft" points={spec.g.front} />
											</g>
										))}
									</g>
								</>
							))
						}

						<!-- Trees: operators as cubes, operands as plates, the box that receives the result -->
						{
							treeParts.map((part) => (
								<g data-el={`m-${part.tree.line}`} class="xj-mod">
									{part.wires.map((d) => <path class="xj-wire" d={d} />)}
									{
										part.tree.nodes.map((node) => {
											if (node.kind === 'op') {
												const g = cubes.get(node.id)!;
												return (
													<g data-el={`c-${node.id}`} data-base="shown">
														<g>
															<polygon class="xj-shadow" points={g.base} transform="translate(6 8)" />
															<polygon class="xj-face xj-face--l" points={g.left} />
															<polygon class="xj-face xj-face--r" points={g.right} />
															<polygon class="xj-face xj-face--t" points={g.top} fill="url(#oe-g-top)" />
															<text class="xj-face-text" transform={g.face} text-anchor="middle">
																{part.tree.line}
															</text>
															<text class="xj-op" x={g.center.x} y={g.center.y + 5} text-anchor="middle">
																{node.text}
															</text>
														</g>
													</g>
												);
											}
											const p = plates.get(node.id)!;
											return (
												<g data-el={`lf-${node.id}`} data-base="shown">
													<g>
														<polygon class="xj-plate-side" points={p.side} />
														<polygon class="xj-plate" points={p.top} />
														<text class="xj-branch" x={p.center.x} y={p.center.y + 4.5} text-anchor="middle">
															{node.text}
														</text>
														{node.sub && (
															<text class="xj-sub" x={p.subAt.x} y={p.subAt.y} text-anchor="middle">
																{node.sub}
															</text>
														)}
													</g>
												</g>
											);
										})
									}
									<g>
										<polygon class="xj-shadow" points={part.tree.target.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={part.tree.target.front} />
										<polygon class="xj-face xj-face--r" points={part.tree.target.end} />
										<polygon class="xj-face xj-face--t" points={part.tree.target.top} fill="url(#oe-g-top)" />
										<text class="xj-name" x={part.tree.target.labelAt.x} y={part.tree.target.labelAt.y}>
											{part.tree.targetName}
											<tspan class="xj-type"> · int</tspan>
											<tspan class="xj-line"> · {part.tree.line}</tspan>
										</text>
									</g>
								</g>
							))
						}

						<!-- ++a and b++: the variable, one operator cube and the box that receives the value -->
						{
							unaries.map((unary) => (
								<g data-el={`m-${unary.line}`} class="xj-mod">
									<path class="xj-wire" d={link(unary.from.rightC, unary.g.leftMid)} />
									<path class="xj-wire" d={link(unary.g.rightMid, unary.into.leftC)} />
									<g data-el={`c-${unary.id}`} data-base="shown">
										<g>
											<polygon class="xj-shadow" points={unary.g.base} transform="translate(6 8)" />
											<polygon class="xj-face xj-face--l" points={unary.g.left} />
											<polygon class="xj-face xj-face--r" points={unary.g.right} />
											<polygon class="xj-face xj-face--t" points={unary.g.top} fill="url(#oe-g-top)" />
											<text class="xj-face-text" transform={unary.g.face} text-anchor="middle">
												{unary.line}
											</text>
											<text class="xj-op" x={unary.g.center.x} y={unary.g.center.y + 5} text-anchor="middle">
												++
											</text>
											<text class="xj-cond" x={unary.g.center.x} y={unary.g.topTip.y - 14} text-anchor="middle">
												{unary.label}
											</text>
										</g>
									</g>
									<g>
										<polygon class="xj-shadow" points={unary.into.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={unary.into.front} />
										<polygon class="xj-face xj-face--r" points={unary.into.end} />
										<polygon class="xj-face xj-face--t" points={unary.into.top} fill="url(#oe-g-top)" />
										<text class="xj-name" x={unary.into.labelAt.x} y={unary.into.labelAt.y}>
											{unary.name}
											<tspan class="xj-type"> · int</tspan>
											<tspan class="xj-line"> · {unary.line}</tspan>
										</text>
									</g>
								</g>
							))
						}

						<!-- Lit operators: the one being evaluated. Violet marks the verdict that stops && and || -->
						{
							[...cubes.entries()].map(([id, g]) => (
								<g data-el={`nd-${id}`} class:list={['xj-lit', ['7r', '8r'].includes(id) ? 'xj-lit--violet' : 'xj-lit--flow']}>
									<polygon class="xj-lit-halo" points={g.top} />
									<polygon class="xj-lit-top" points={g.top} />
									<polygon class="xj-lit-side" points={g.left} />
									<text class="xj-face-text xj-face-text--on" transform={g.face} text-anchor="middle">
										{id.replace(/\D/g, '')}
									</text>
								</g>
							))
						}

						<!-- Machines: printf and return -->
						{
							machines.map((machine) => (
								<>
									<g data-el={`m-${machine.line}`} class="xj-mod">
										<polygon class="xj-shadow" points={machine.g.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={machine.g.left} />
										<polygon class="xj-face xj-face--r" points={machine.g.right} />
										<polygon class="xj-face xj-face--t" points={machine.g.top} fill="url(#oe-g-top)" />
										<text class="xj-face-text" transform={machine.g.face} text-anchor="middle">
											{machine.line}
										</text>
										<text class="xj-machine" x={machine.g.center.x} y={machine.g.topTip.y - 12} text-anchor="middle">
											{machine.label}
										</text>
									</g>
									<g data-el={`on-${machine.line}`} class="xj-lit xj-lit--flow">
										<polygon class="xj-lit-halo" points={machine.g.top} />
										<polygon class="xj-lit-top" points={machine.g.top} />
										<polygon class="xj-lit-side" points={machine.g.left} />
										<text class="xj-face-text xj-face-text--on" transform={machine.g.face} text-anchor="middle">
											{machine.line}
										</text>
									</g>
								</>
							))
						}

						<!-- Undefined behavior, line 15: two modifications of `i`, no order -->
						<g data-el="m-15" class="xj-mod">
							{
								[
									{ id: 'c-15a', g: U.iInc, label: 'i++', sym: '++' },
									{ id: 'c-15b', g: U.iSet, label: 'i = …', sym: '=' },
								].map((item) => (
									<g data-el={item.id} data-base="shown">
										<g>
											<polygon class="xj-shadow" points={item.g.base} transform="translate(6 8)" />
											<polygon class="xj-face xj-face--l" points={item.g.left} />
											<polygon class="xj-face xj-face--r" points={item.g.right} />
											<polygon class="xj-face xj-face--t" points={item.g.top} fill="url(#oe-g-top)" />
											<text class="xj-face-text" transform={item.g.face} text-anchor="middle">
												15
											</text>
											<text class="xj-op" x={item.g.center.x} y={item.g.center.y + 5} text-anchor="middle">
												{item.sym}
											</text>
											<text class="xj-cond" x={item.g.center.x} y={item.g.topTip.y - 14} text-anchor="middle">
												{item.label}
											</text>
										</g>
									</g>
								))
							}
							<g>
								<polygon class="xj-shadow" points={B.i.base} transform="translate(6 8)" />
								<polygon class="xj-face xj-face--l" points={B.i.front} />
								<polygon class="xj-face xj-face--r" points={B.i.end} />
								<polygon class="xj-face xj-face--t" points={B.i.top} fill="url(#oe-g-top)" />
								<text class="xj-name" x={B.i.leftC.x - 8} y={B.i.leftC.y + 8} text-anchor="end">
									i<tspan class="xj-type"> · int</tspan>
									<tspan class="xj-line"> · 15</tspan>
								</text>
							</g>
						</g>
						<g data-el="bw-15" class="xj-bad">
							<g>
								{
									ubWires.one.map((d) => (
										<>
											<path class="mg-stroke xj-bad-halo" pathLength="1" d={d} />
											<path class="mg-stroke xj-bad-core" pathLength="1" d={d} />
										</>
									))
								}
							</g>
						</g>

						<!-- Undefined behavior, line 16: INT_MAX + 1 -->
						<g data-el="m-16" class="xj-mod">
							<path class="xj-wire" d={ubWires.two} />
							<g data-el="c-16u" data-base="shown">
								<g>
									<polygon class="xj-shadow" points={U.plus.base} transform="translate(6 8)" />
									<polygon class="xj-face xj-face--l" points={U.plus.left} />
									<polygon class="xj-face xj-face--r" points={U.plus.right} />
									<polygon class="xj-face xj-face--t" points={U.plus.top} fill="url(#oe-g-top)" />
									<text class="xj-face-text" transform={U.plus.face} text-anchor="middle">
										16
									</text>
									<text class="xj-op" x={U.plus.center.x} y={U.plus.center.y + 5} text-anchor="middle">
										+
									</text>
									<text class="xj-cond" x={U.plus.center.x} y={U.plus.topTip.y - 14} text-anchor="middle">
										+ 1
									</text>
								</g>
							</g>
							<g>
								<polygon class="xj-shadow" points={B.big.base} transform="translate(6 8)" />
								<polygon class="xj-face xj-face--l" points={B.big.front} />
								<polygon class="xj-face xj-face--r" points={B.big.end} />
								<polygon class="xj-face xj-face--t" points={B.big.top} fill="url(#oe-g-top)" />
								<text class="xj-name" x={B.big.labelAt.x} y={B.big.labelAt.y}>
									{names.big}
									<tspan class="xj-type"> · int</tspan>
									<tspan class="xj-line"> · 16</tspan>
								</text>
							</g>
						</g>
						<g data-el="bw-16" class="xj-bad">
							<g>
								<path class="mg-stroke xj-bad-halo" pathLength="1" d={ubWires.two} />
								<path class="mg-stroke xj-bad-core" pathLength="1" d={ubWires.two} />
							</g>
						</g>

						<!-- Sealed: the operand that never runs, and the boxes that refuse a value -->
						{
							sealedPlates.map((seal) => (
								<g data-el={seal.id} class="xj-seal">
									<g>
										<polygon class="xj-seal-ring" points={seal.p.top} />
										<svg class="xj-icon" x={seal.p.center.x + 52} y={seal.p.tip.y - 14} width="22" height="22" viewBox="0 0 24 24" stroke-width="2.75">
											<rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
											<path d="M7 11V7a5 5 0 0 1 10 0v4" />
										</svg>
									</g>
								</g>
							))
						}
						{
							sealedBoxes.map((seal) => (
								<g data-el={seal.id} class="xj-seal">
									<g>
										<polygon class="xj-seal-ring" points={seal.top} />
										<svg class="xj-icon" x={seal.icon.x} y={seal.icon.y} width="22" height="22" viewBox="0 0 24 24" stroke-width="2.75">
											<rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
											<path d="M7 11V7a5 5 0 0 1 10 0v4" />
										</svg>
									</g>
								</g>
							))
						}

						<!-- Values -->
						{
							values.map((value) => (
								<text data-el={value.id} class:list={['xj-value', value.bad && 'xj-value--bad']} x={value.at.x} y={value.at.y} text-anchor="middle">
									{value.text}
								</text>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									<text class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'} x={chipLeft(chip) + chipWidth(chip) / 2} y={chip.y + 4.5} text-anchor="middle">
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- Value tokens. Placement lives on the inner group: the player resets data-el transforms. -->
						{
							tokens.map((token) => (
								<g data-el={token.id} data-x={at(token.from).x} data-y={at(token.from).y}>
									<g class:list={['xj-token', `xj-token--${token.tone}`]}>
										<rect class="xj-token-halo" x={-tokenWidth(token) / 2 - 5} y="-18" width={tokenWidth(token) + 10} height="36" rx="18" />
										<rect class="xj-token-card" x={-tokenWidth(token) / 2} y="-13" width={tokenWidth(token)} height="26" rx="13" />
										<text class="xj-token-text" x="0" y="4.5" text-anchor="middle">
											{token.text}
										</text>
									</g>
								</g>
							))
						}

						<!-- The execution flow -->
						<g data-el="p" class="xj-particle" data-x={at('a-m4').x} data-y={at('a-m4').y}>
							<circle r="20" fill="url(#oe-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="440" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<rect class="xj-legend-pick" x={VP.x + 172} y={LEGEND_Y - 6} width="20" height="12" rx="3"></rect>
				<text x={VP.x + 200} y={LEGEND_Y + 4}>{t('Operador evaluado', 'Evaluated operator')}</text>
				<rect class="xj-legend-token" x={VP.x + 350} y={LEGEND_Y - 6} width="20" height="12" rx="6"></rect>
				<text x={VP.x + 378} y={LEGEND_Y + 4}>{t('Valor', 'Value')}</text>
			</g>

			<!-- EDITOR: the program, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.file}</text>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(4)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<!-- Marked lines: the two examples of undefined behavior -->
				{
					WARN_LINES.map((mark) => (
						<g data-el={mark.id} class="xj-warn">
							<rect x={ED.x + 4} y={lineTop(mark.from) + 2} width="4" height={(mark.to - mark.from + 1) * LINE_H - 4} rx="2" />
							<svg class="xj-icon" x={ED.x + ED.w - 30} y={lineMid(mark.from) - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
								<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3" />
								<path d="M12 9v4" />
								<path d="M12 17h.01" />
							</svg>
						</g>
					))
				}

				<!-- The program: written before it runs, so every line is visible -->
				<g class="xj-code">
					{
						lines.map((line) => (
							<g>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				<!-- Console: what each printf prints -->
				{
					outputs.map((out) => (
						<text data-el={out.id} class="xj-out" x={ED.x + 20} y={outY(out.row)} xml:space="preserve">
							{out.text}
						</text>
					))
				}
				{lines.map((line) => <circle data-anchor={`ln-${line.n}`} cx={BAR_CX} cy={lineMid(line.n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
