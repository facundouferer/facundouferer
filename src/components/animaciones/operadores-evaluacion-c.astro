/**
 * Scene for "The order an expression is evaluated in" (lesson c/07-operadores,
 * order: 7), a short film played on one persistent motion canvas. The captions
 * and cues live in `src/data/animations/operadores-evaluacion-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: the C
 * program, with a bar that slides to the line being executed and the real output
 * typed in the console below. The viewport on the right holds the camera. Every
 * expression is drawn as the same tree: an operator is a cube (its editor line on
 * the face), an operand is a flat plate, a wire joins a node to its operands. The
 * tree is evaluated bottom-up: the operator lights up, its result appears and
 * travels on as a token to the operator above it or into the variable box. The
 * right operand of `&&` and `||` that never runs is sealed in magenta; the two
 * lines that are undefined behavior end in a refused state (sealed box, `?`),
 * never an explosion.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/operadores-evaluacion-c';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── The program shown in the editor ───────────────────────────────────────
// Identifiers are the lesson's own, localized like it does. The two commented
// lines are the lesson's undefined-behavior examples: shown, never executed.
const names = {
	value: t('valor', 'value'),
	diff: t('resta', 'diff'),
	total: 'total',
	people: t('personas', 'people'),
	costly: t('esCaro', 'isExpensive'),
	rest: t('resto', 'rest'),
	big: t('grande', 'big'),
	file: t('operadores.c', 'operators.c'),
};

const program = [
	'#include <stdio.h>',
	'',
	'int main(void) {',
	`    int ${names.value} = 2 + 3 * 4;`,
	`    int ${names.diff} = 10 - 4 - 3;`,
	`    int total = 50, ${names.people} = 0;`,
	`    int ${names.costly} = ${names.people} != 0 && total / ${names.people} > 20;`,
	`    int ok = ${names.people} == 0 || total / ${names.people} > 20;`,
	'    int a = 5, b = 5;',
	'    int x = ++a;',
	'    int y = b++;',
	`    int ${names.rest} = -7 % 3;`,
	`    printf("%d %d %d %d\\n", ${names.value}, ${names.diff}, ${names.costly}, ok);`,
	`    printf("a=%d x=%d b=%d y=%d r=%d\\n", a, x, b, y, ${names.rest});`,
	'    // i = i++ + 1;',
	`    // ${names.big} = INT_MAX + 1;`,
	'    return 0;',
	'}',
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const lines = highlightCode(program, 'c').map((html, index) => ({
	n: index + 1,
	html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
}));

// The real output of the program (cc -std=c23 -Wall -Wextra -Wpedantic), one line per print.
const outputs = [
	{ id: 'o-13', row: 0, text: '14 3 0 1' },
	{ id: 'o-14', row: 1, text: 'a=6 x=6 b=6 y=5 r=-1' },
];

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 70;
const LINE_H = 22;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 4.5;
const CONSOLE_TOP = 482;
const outY = (row: number) => 534 + row * 26;
// The two lines of undefined behavior, marked together.
const WARN_LINES = [{ id: 'warn-15', from: 15, to: 16 }];

// ── Isometric world (camera space) ────────────────────────────────────────
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const DU = { x: 20, y: 11.5 };
const DV = { x: -20, y: 11.5 };
const BH = 20;
const round = (value: number) => Math.round(value * 10) / 10;
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const SKEW = (point: Point) => `matrix(0.866 0.5 0 1 ${point.x} ${point.y})`;

/** A variable box: an isometric slab `n` units long whose top-face back corner is (ox, oy). */
function box(ox: number, oy: number, n = 3) {
	const P = (k: number, d = 0, z = 0): Point => ({
		x: round(ox + k * DU.x + d * DV.x),
		y: round(oy + k * DU.y + d * DV.y + z),
	});
	return {
		top: poly([P(0), P(n), P(n, 1), P(0, 1)]),
		front: poly([P(0, 1), P(n, 1), P(n, 1, BH), P(0, 1, BH)]),
		end: poly([P(n), P(n, 1), P(n, 1, BH), P(n, 0, BH)]),
		base: poly([P(0, 0, BH), P(n, 0, BH), P(n, 1, BH), P(0, 1, BH)]),
		topCenter: P(n / 2, 0.5),
		valueAt: { x: P(n / 2, 0.5).x, y: round(P(n / 2, 0.5).y + 4.5) },
		labelAt: { x: P(0, 1).x, y: round(P(0).y - 10) },
		leftC: P(0, 1),
		rightC: P(n),
	};
}
type Box = ReturnType<typeof box>;

/** A cube whose top-face center is (cx, cy): an operator, or a machine. */
const CS = 22;
const CH = 24;
const CY = round(CS * 0.575);
function cube(cx: number, cy: number) {
	return {
		top: poly([
			{ x: cx, y: cy - CY },
			{ x: cx + CS, y: cy },
			{ x: cx, y: cy + CY },
			{ x: cx - CS, y: cy },
		]),
		left: poly([
			{ x: cx - CS, y: cy },
			{ x: cx, y: cy + CY },
			{ x: cx, y: cy + CY + CH },
			{ x: cx - CS, y: cy + CH },
		]),
		right: poly([
			{ x: cx, y: cy + CY },
			{ x: cx + CS, y: cy },
			{ x: cx + CS, y: cy + CH },
			{ x: cx, y: cy + CY + CH },
		]),
		base: poly([
			{ x: cx, y: cy - CY + CH },
			{ x: cx + CS, y: cy + CH },
			{ x: cx, y: cy + CY + CH },
			{ x: cx - CS, y: cy + CH },
		]),
		face: SKEW({ x: round(cx - CS / 2), y: round(cy + CY / 2 + CH / 2 + 4) }),
		center: { x: cx, y: cy },
		bottom: { x: cx, y: round(cy + CY + CH) },
		topTip: { x: cx, y: round(cy - CY) },
		leftMid: { x: cx - CS, y: cy + CH / 2 },
		rightMid: { x: cx + CS, y: cy + CH / 2 },
	};
}
type Cube = ReturnType<typeof cube>;

/** An operand plate: a flat isometric tile centered on (cx, cy). Wide ones hold an expression. */
const PT = 6;
function plate(cx: number, cy: number, pw = 30, ph = 17) {
	return {
		top: poly([
			{ x: cx, y: cy - ph },
			{ x: cx + pw, y: cy },
			{ x: cx, y: cy + ph },
			{ x: cx - pw, y: cy },
		]),
		side: poly([
			{ x: cx - pw, y: cy },
			{ x: cx, y: cy + ph },
			{ x: cx + pw, y: cy },
			{ x: cx + pw, y: cy + PT },
			{ x: cx, y: cy + ph + PT },
			{ x: cx - pw, y: cy + PT },
		]),
		center: { x: cx, y: cy },
		tip: { x: cx, y: cy - ph },
		subAt: { x: cx, y: cy + ph + PT + 13 },
		half: { w: pw, h: ph },
	};
}
type Plate = ReturnType<typeof plate>;
const wire = (from: Point, to: Point) => `M${from.x} ${from.y} C${from.x} ${round(from.y + 26)} ${to.x} ${round(to.y - 30)} ${to.x} ${to.y}`;
const link = (from: Point, to: Point) => `M${from.x} ${from.y} C${round(from.x + 46)} ${from.y} ${round(to.x - 46)} ${to.y} ${to.x} ${to.y}`;

// ── Expression trees ──────────────────────────────────────────────────────
