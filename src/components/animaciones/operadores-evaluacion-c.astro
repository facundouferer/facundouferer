	total: box(740, 70),
	people: box(740, 140),
	costly: box(315, 306),
	ok: box(755, 306),
	a: box(50, 640),
	x: box(270, 640),
	b: box(400, 640),
	y: box(620, 640),
	rest: box(255, 736),
	i: box(800, 690),
	big: box(730, 820, 5),
};

const wideText = `total / ${names.people} > 20`;
