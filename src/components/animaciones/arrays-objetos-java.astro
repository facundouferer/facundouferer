---
/**
 * Scene for "The journey through an array of objects: from null to instances"
 * (lesson java/09-arrays-de-objetos, order: 10), a short film played on one
 * persistent motion canvas. The captions and cues live in
 * `src/data/animations/arrays-objetos-java.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: it shows
 * the Java source (first the class `Persona`, then `main`) and the cues slide a bar
 * over the line being executed. The viewport on the right holds the camera: an
 * isometric system where the class is a blueprint plate in front, `main()` is a
 * floor of modules on the Stack, and the Heap behind it holds the array `equipo`
 * (a rack of three reference slots) and the violet `Persona` instances. Magenta
 * marks the problem: the `NullPointerException` on a `null` slot, and slot `[2]`
 * sharing the object of slot `[0]` after `equipo[2] = equipo[0]`.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/arrays-objetos-java';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── Source code shown in the editor ───────────────────────────────────────
// Identifiers are localized the same way the lesson does.
const names = {
	fileA: t('Persona.java', 'Person.java'),
	fileB: t('MainEquipo.java', 'MainTeam.java'),
	mainClass: t('MainEquipo', 'MainTeam'),
	person: t('Persona', 'Person'),
	team: t('equipo', 'team'),
	name: t('nombre', 'name'),
	age: t('edad', 'age'),
	getName: t('getNombre', 'getName'),
	getAge: t('getEdad', 'getAge'),
};

// First page: the class, the blueprint of every object the array will point to.
const sourceA = [
	`public class ${names.person} {`,
	`    private final String ${names.name};`,
	`    private final int ${names.age};`,
	'',
	`    public ${names.person}(String ${names.name}, int ${names.age}) {`,
	`        this.${names.name} = ${names.name};`,
	`        this.${names.age} = ${names.age};`,
	'    }',
	'',
	`    public String ${names.getName}() { return ${names.name}; }`,
	`    public int ${names.getAge}() { return ${names.age}; }`,
	'}',
].join('\n');

// Second page: main creates the array, fills two slots, walks it and copies a slot.
const sourceB = [
	`public class ${names.mainClass} {`,
	'    public static void main(String[] args) {',
	`        ${names.person}[] ${names.team} = new ${names.person}[3];`,
	`        ${names.team}[0] = new ${names.person}("Laura", 28);`,
	`        ${names.team}[1] = new ${names.person}("Carlos", 35);`,
	'',
	`        for (${names.person} p : ${names.team}) {`,
	`            if (p != null) {`,
	`                System.out.println(p.${names.getName}());`,
	'            }',
	'        }',
	`        ${names.team}[2] = ${names.team}[0];`,
	`        System.out.println(${names.team}[0] == ${names.team}[2]);`,
	'    }',
	'}',
].join('\n');

// The first draft of line 4: calling a method on a slot that is still null.
const trapLine = `        System.out.println(${names.team}[0].${names.getName}());`;

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const svgLines = (source: string) =>
	highlightCode(source, 'java').map((html, index) => ({
		n: index + 1,
		html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
	}));

const pageA = svgLines(sourceA);
const pageB = svgLines(sourceB);
const trapHtml = svgLines(trapLine)[0].html;

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 64;
const GUTTER_X = 50;
const CODE_TOP = 74;
const LINE_H = 23;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 5;
const CONSOLE_TOP = 552;
const outY = (row: number) => 597 + row * LINE_H;

// Lines the highlight bar travels to (`ln-<n>`, lines of the `main` page).
const lineAnchors = [3, 4, 5, 7, 8, 9, 12, 13].map((n) => ({ id: `ln-${n}`, n }));

// Program output, one element per printed line.
const outputs = [
	{ id: 'out-npe', row: 0, text: 'Exception in thread "main" java.lang.NullPointerException', err: true },
	{ id: 'out-1', row: 0, text: 'Laura' },
	{ id: 'out-2', row: 1, text: 'Carlos' },
	{ id: 'out-3', row: 2, text: 'true' },
];

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right (the order of execution), +v down-left, z is up.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 56;
const EY = 32;
const ORIGIN = { x: 460, y: 270 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');
const path = (points: Point[]) => 'M' + points.map((point) => `${point.x} ${point.y}`).join(' L');

/** A box standing on the floor at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
	};
}
/** Text lying flat on a floor, reading along +u. */
const floorMatrix = (point: Point) => `matrix(0.866 0.5 -0.866 0.5 ${point.x} ${point.y})`;

const MODULE_H = 18;
const MAIN_V = 0.1;
const CLS_V = 1.9;
const RACK_V = -1.85;
const RACK_Z = 6;
const OBJ_V = -3.3;
const SLOT_U = [-0.2, 0.8, 1.8];
const OBJ_U = [-0.4, 1.4];

const block = (u: number, v: number) => slab(u, v, 0.34, 0.34, MODULE_H);
const slot = (u: number) => slab(u, RACK_V, 0.32, 0.3, 14, RACK_Z);
const G = {
	floorMain: slab(0.85, MAIN_V, 2.25, 0.6, 12, -12),
	heap: slab(0.6, -2.55, 1.7, 1.25, 12, -12),
	cls: slab(0.4, CLS_V, 1.35, 0.7, 10, -10),
	rack: slab(0.8, RACK_V, 1.35, 0.42, RACK_Z),
	entry: slab(-1.0, MAIN_V, 0.2, 0.2, 6),
	arr: block(-0.3, MAIN_V),
	p0: block(0.45, MAIN_V),
	p1: block(1.2, MAIN_V),
	loop: block(1.95, MAIN_V),
	alias: block(2.7, MAIN_V),
	fields: block(-0.6, CLS_V),
	ctor: block(0.4, CLS_V),
	getter: block(1.4, CLS_V),
	s0: slot(SLOT_U[0]),
	s1: slot(SLOT_U[1]),
	s2: slot(SLOT_U[2]),
};
type Slab = typeof G.floorMain;
type Tone = 'flow' | 'violet' | 'magenta';

const OBJ = OBJ_U.map((u) => lift(pt(u, OBJ_V), 22));
/** The top of a slot, where its reference leaves from. */
const slotTop = (g: Slab) => lift(g.center, 2);

// Routes along main(), and from main() and the slots into the Heap.
const routes = {
	main: path([pt(-1.0, MAIN_V), pt(2.7, MAIN_V)]),
	entry: path([pt(-1.0, MAIN_V), pt(-0.3, MAIN_V)]),
	step1: path([pt(-0.3, MAIN_V), pt(0.45, MAIN_V)]),
	step2: path([pt(0.45, MAIN_V), pt(1.2, MAIN_V)]),
	step3: path([pt(1.2, MAIN_V), pt(1.95, MAIN_V)]),
	step4: path([pt(1.95, MAIN_V), pt(2.7, MAIN_V)]),
	arr: path([G.arr.center, lift(pt(0.8, RACK_V + 0.42), RACK_Z)]),
	err: path([G.p0.center, slotTop(G.s0)]),
	new0: path([G.p0.center, OBJ[0]]),
	new1: path([G.p1.center, OBJ[1]]),
	loop: path([G.loop.center, lift(pt(1.8, RACK_V + 0.42), RACK_Z)]),
	ref0: path([slotTop(G.s0), lift(OBJ[0], -14)]),
	ref1: path([slotTop(G.s1), lift(OBJ[1], -14)]),
	ref2: path([slotTop(G.s2), lift(OBJ[0], -14)]),
};
const gridLines = [
	...[-1, 0, 1, 2, 3].map((u) => path([pt(u, -0.45, 0.5), pt(u, 0.65, 0.5)])),
	...[-0.3, 0.1, 0.5].map((v) => path([pt(-1.35, v, 0.5), pt(3.05, v, 0.5)])),
];

// Modules of main(), back to front, each with its lit state and editor line.
type Module = { id: string; g: Slab; face?: string; lit?: { id: string } };
const modules: Module[] = [
	{ id: 'm-entry', g: G.entry },
	{ id: 'm-arr', g: G.arr, face: '3', lit: { id: 'arr-on' } },
	{ id: 'm-p0', g: G.p0, face: '4', lit: { id: 'p0-on' } },
	{ id: 'm-p1', g: G.p1, face: '5', lit: { id: 'p1-on' } },
	{ id: 'm-loop', g: G.loop, face: '7', lit: { id: 'loop-on' } },
	{ id: 'm-alias', g: G.alias, face: '12', lit: { id: 'alias-on' } },
];
const blueprint = [
	{ g: G.fields, face: '2' },
	{ g: G.ctor, face: '5' },
	{ g: G.getter, face: '10' },
];
const slots = [G.s0, G.s1, G.s2];

// Where the travelling particle stops: just above a module, a slot or an object.
const hover = (g: Slab, by = 16) => lift(g.center, by);
const anchors = [
	{ id: 'a-entry', ...hover(G.entry, 14) },
	{ id: 'a-arr', ...hover(G.arr) },
	{ id: 'a-p0', ...hover(G.p0) },
	{ id: 'a-p1', ...hover(G.p1) },
	{ id: 'a-loop', ...hover(G.loop) },
	{ id: 'a-alias', ...hover(G.alias) },
	{ id: 'a-rack', ...hover(G.s1, 14) },
	{ id: 'a-s0', ...hover(G.s0, 14) },
	{ id: 'a-s1', ...hover(G.s1, 14) },
	{ id: 'a-s2', ...hover(G.s2, 14) },
	{ id: 'a-o0', ...lift(OBJ[0], 4) },
	{ id: 'a-o1', ...lift(OBJ[1], 4) },
];

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shots = [
	{ id: 'shot-class', cx: 395, cy: 345, s: 1.3 },
	{ id: 'shot-slots', cx: 560, cy: 270, s: 1.02 },
	{ id: 'shot-trap', cx: 525, cy: 245, s: 1.3 },
	{ id: 'shot-heap', cx: 590, cy: 235, s: 1.18 },
	{ id: 'shot-loop', cx: 610, cy: 250, s: 1.1 },
	{ id: 'shot-alias', cx: 620, cy: 245, s: 1.12 },
	{ id: 'shot-all', cx: 545, cy: 265, s: 0.95 },
].map((item) => ({
	id: item.id,
	x: round(item.cx - 640 / item.s),
	y: round(item.cy - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = {
	id: string;
	text: string;
	x: number;
	y: number;
	align: 'start' | 'end' | 'middle';
	tone: 'plain' | Tone;
	mono?: boolean;
	check?: boolean;
	lead?: Point;
};
/** A note to the right of a blueprint module, tied to it by a lead line. */
const sideChip = (id: string, text: string, g: Slab): Chip => ({
	id,
	text,
	x: g.center.x + 44,
	y: g.center.y - 22,
	align: 'start',
	tone: 'plain',
	mono: true,
	lead: { x: g.center.x + 8, y: g.center.y - 4 },
});
const S2 = G.s2.center;
const S0 = G.s0.center;

const chips: Chip[] = [
	sideChip('lb-fields', `${names.name}, ${names.age}`, G.fields),
	sideChip('lb-ctor', `${names.person}(${names.name}, ${names.age})`, G.ctor),
	sideChip('lb-get', `${names.getName}()`, G.getter),
	{
		id: 'lb-no-obj',
		text: t('Heap: todavía 0 objetos', 'Heap: still 0 objects'),
		x: 615,
		y: 108,
		align: 'end',
		tone: 'flow',
	},
	{ id: 'chip-len', text: `${names.team}.length == 3`, x: S2.x + 96, y: S2.y + 54, align: 'end', tone: 'flow', mono: true },
	{
		id: 'chip-npe',
		text: 'NullPointerException',
		x: S0.x - 34,
		y: S0.y - 6,
		align: 'end',
		tone: 'magenta',
		mono: true,
		lead: { x: S0.x - 14, y: S0.y },
	},
	{ id: 'chip-gap', text: t('[2] sigue en null', '[2] is still null'), x: S2.x + 34, y: S2.y + 34, align: 'start', tone: 'plain', mono: true },
	{
		id: 'chip-skip',
		text: 'p != null → false',
		x: S2.x + 34,
		y: S2.y + 34,
		align: 'start',
		tone: 'violet',
		mono: true,
		check: true,
	},
	{
		id: 'chip-alias',
		text: t('[0] y [2] → mismo objeto', '[0] and [2] → same object'),
		x: OBJ[0].x - 62,
		y: OBJ[0].y + 14,
		align: 'end',
		tone: 'magenta',
	},
	{
		id: 'r-step1',
		text: t(`Paso 1: new ${names.person}[3] → casillas null`, `Step 1: new ${names.person}[3] → null slots`),
		x: 420,
		y: 470,
		align: 'start',
		tone: 'flow',
	},
	{
		id: 'r-step2',
		text: t(`Paso 2: new ${names.person}(...) → objeto en el Heap`, `Step 2: new ${names.person}(...) → object on the Heap`),
		x: 420,
		y: 502,
		align: 'start',
		tone: 'violet',
	},
	{
		id: 'r-guard',
		text: t('Antes de usar: p != null', 'Before use: p != null'),
		x: 420,
		y: 534,
		align: 'start',
		tone: 'violet',
		check: true,
	},
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.check ? 42 : 24));
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;
const chipJoin = (chip: Chip) =>
	chip.align === 'end' ? chipLeft(chip) + chipWidth(chip) - 14 : chip.align === 'middle' ? chip.x : chipLeft(chip) + 14;

const objects = [
	{ id: 'obj-0', at: OBJ[0], label: 'Laura (28)' },
	{ id: 'obj-1', at: OBJ[1], label: 'Carlos (35)' },
];
const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="xa-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="xa-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="xa-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="xa-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="xa-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="xa-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="xa-g-object">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.7"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: the running system, seen through the camera -->
			<g clip-path="url(#xa-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + 150} cy={VP.y + 110} rx="420" ry="320" fill="url(#xa-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + VP.w - 60} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#xa-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- The Heap: where the array and the objects live -->
						<g data-el="heap">
							<polygon class="xj-plate-shadow" points={G.heap.base} transform="translate(10 16)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.heap.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.heap.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.heap.top} fill="url(#xa-g-floor)"></polygon>
							<text class="xj-floor-text" transform={floorMatrix(pt(-1.08, -3.0))}>Heap</text>
						</g>

						<!-- The array: a rack of three reference slots -->
						<g data-el="floor-arr">
							<polygon class="xj-shadow" points={G.rack.base} transform="translate(6 8)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.rack.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.rack.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.rack.top} fill="url(#xa-g-floor)"></polygon>
							<text class="xj-floor-text xj-floor-text--sm" transform={floorMatrix(pt(-0.5, RACK_V + 0.72))}>
								{names.person}[] {names.team}
							</text>
						</g>
						{
							slots.map((g, index) => (
								<g data-el={`s-${index}`} class="xj-mod">
									<polygon class="xj-shadow" points={g.base} transform="translate(5 7)" />
									<polygon class="xj-face xj-face--l" points={g.leftFace} />
									<polygon class="xj-face xj-face--r" points={g.rightFace} />
									<polygon class="xj-face xj-face--t" points={g.top} fill="url(#xa-g-top)" />
									<text class="xj-face-text" transform={g.faceMatrix} text-anchor="middle" y="4.5">
										[{index}]
									</text>
								</g>
							))
						}
						{
							[
								{ id: 's0-err', g: G.s0, n: 0, tone: 'magenta' },
								{ id: 's0-ok', g: G.s0, n: 0, tone: 'violet' },
								{ id: 's1-ok', g: G.s1, n: 1, tone: 'violet' },
								{ id: 's2-alias', g: G.s2, n: 2, tone: 'magenta' },
							].map((lit) => (
								<g data-el={lit.id} class:list={['xj-lit', `xj-lit--${lit.tone}`]}>
									<polygon class="xj-lit-halo" points={lit.g.top} />
									<polygon class="xj-lit-top" points={lit.g.top} />
									<polygon class="xj-lit-side" points={lit.g.leftFace} />
									<text class="xj-face-text xj-face-text--on" transform={lit.g.faceMatrix} text-anchor="middle" y="4.5">
										[{lit.n}]
									</text>
								</g>
							))
						}
						{
							slots.map((g, index) => (
								<g data-el={`null-${index}`} class="xj-null">
									<g transform={`translate(${g.center.x} ${g.center.y - 20})`}>
										<rect x="-24" y="-10" width="48" height="20" rx="10" />
										<text x="0" y="4.5" text-anchor="middle">
											null
										</text>
									</g>
								</g>
							))
						}

						<!-- The class blueprint, in front of main() -->
						<g data-el="floor-cls">
							<polygon class="xj-plate-shadow" points={G.cls.base} transform="translate(10 16)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.cls.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.cls.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.cls.top} fill="url(#xa-g-floor)"></polygon>
							<text class="xj-floor-text" transform={floorMatrix(pt(-0.95, CLS_V + 0.62))}>class {names.person}</text>
							{
								blueprint.map((module) => (
									<>
										<polygon class="xj-shadow" points={module.g.base} transform="translate(7 9)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#xa-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.face}
										</text>
									</>
								))
							}
						</g>

						<!-- main() on the Stack -->
						<g data-el="floor-main">
							<polygon class="xj-plate-shadow" points={G.floorMain.base} transform="translate(14 22)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={G.floorMain.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={G.floorMain.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={G.floorMain.top} fill="url(#xa-g-floor)"></polygon>
							{gridLines.map((d) => <path class="xj-grid" d={d} />)}
							<text class="xj-floor-text" transform={floorMatrix(pt(-1.3, MAIN_V + 0.52))}>Stack · main()</text>
						</g>

						<!-- Routes: base trace, the way into the Heap, and references -->
						<g data-el="tr-main"><path class="mg-stroke xj-trace" pathLength="1" d={routes.main}></path></g>
						{
							[
								{ id: 'fl-0', d: routes.entry, tone: '' },
								{ id: 'fl-1', d: routes.step1, tone: '' },
								{ id: 'fl-2', d: routes.step2, tone: '' },
								{ id: 'fl-3', d: routes.step3, tone: '' },
								{ id: 'fl-4', d: routes.step4, tone: '' },
								{ id: 'rt-arr', d: routes.arr, tone: '' },
								{ id: 'rt-loop', d: routes.loop, tone: '' },
								{ id: 'rt-err', d: routes.err, tone: 'xj-flowline--magenta' },
								{ id: 'rt-new0', d: routes.new0, tone: 'xj-flowline--violet' },
								{ id: 'rt-new1', d: routes.new1, tone: 'xj-flowline--violet' },
								{ id: 'ref-0', d: routes.ref0, tone: 'xj-flowline--violet' },
								{ id: 'ref-1', d: routes.ref1, tone: 'xj-flowline--violet' },
								{ id: 'ref-2', d: routes.ref2, tone: 'xj-flowline--magenta' },
							].map((line) => (
								<g data-el={line.id} class:list={['xj-flowline', line.tone]}>
									<path class="mg-stroke xj-flowline-halo" pathLength="1" d={line.d} />
									<path class="mg-stroke xj-flowline-core" pathLength="1" d={line.d} />
								</g>
							))
						}

						<!-- Modules of main(), back to front, each with its lit state -->
						{
							modules.map((module) => (
								<>
									<g data-el={module.id} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(7 9)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#xa-g-top)" />
										{module.face && (
											<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
												{module.face}
											</text>
										)}
									</g>
									{module.lit && (
										<g data-el={module.lit.id} class="xj-lit xj-lit--flow">
											<polygon class="xj-lit-halo" points={module.g.top} />
											<polygon class="xj-lit-top" points={module.g.top} />
											<polygon class="xj-lit-side" points={module.g.leftFace} />
											<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
												{module.face}
											</text>
										</g>
									)}
								</>
							))
						}
						<!-- Line 4 as first written: a method call on a null slot -->
						<g data-el="npe-on" class="xj-lit xj-lit--magenta">
							<polygon class="xj-lit-halo" points={G.p0.top}></polygon>
							<polygon class="xj-lit-top" points={G.p0.top}></polygon>
							<polygon class="xj-lit-side" points={G.p0.leftFace}></polygon>
							<text class="xj-face-text xj-face-text--on" transform={G.p0.faceMatrix} text-anchor="middle" y="4.5">4</text>
						</g>

						<!-- Heap instances. Placement lives on an inner group so player resets don't move them. -->
						{
							objects.map((object) => (
								<g data-el={object.id}>
									<g class="xj-object" transform={`translate(${object.at.x} ${object.at.y})`}>
										<circle r="34" fill="url(#xa-g-object)" />
										<polygon class="xj-gem xj-gem--l" points="-15,-10.5 0,-2 0,15 -15,6.5" />
										<polygon class="xj-gem xj-gem--r" points="15,-10.5 0,-2 0,15 15,6.5" />
										<polygon class="xj-gem xj-gem--t" points="0,-19 15,-10.5 0,-2 -15,-10.5" />
										<rect class="xj-tag" x="-54" y="-54" width="108" height="22" rx="11" />
										<text class="xj-tag-text" x="0" y="-38.5" text-anchor="middle">
											{object.label}
										</text>
									</g>
								</g>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									{chip.lead && <line class="xj-lead" x1={chip.lead.x} y1={chip.lead.y} x2={chipJoin(chip)} y2={chip.lead.y > chip.y ? chip.y + 12 : chip.y - 12} />}
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.check && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.check ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- The execution flow -->
						<g data-el="p" class="xj-particle" data-x={anchors[0].x} data-y={anchors[0].y}>
							<circle r="20" fill="url(#xa-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="420" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo', 'Flow')}</text>
				<polygon class="xj-legend-object" points={`${VP.x + 98},${LEGEND_Y - 6} ${VP.x + 104},${LEGEND_Y} ${VP.x + 98},${LEGEND_Y + 6} ${VP.x + 92},${LEGEND_Y}`}></polygon>
				<text x={VP.x + 112} y={LEGEND_Y + 4}>{t('Objeto / referencia', 'Object / reference')}</text>
				<circle class="xj-legend-magenta" cx={VP.x + 268} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 280} y={LEGEND_Y + 4}>{t('null / problema', 'null / problem')}</text>
			</g>

			<!-- EDITOR: the source, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<!-- Line states sit behind the code -->
				<rect data-el="hx-4" class="xj-bar xj-bar--trail" x={BAR.x} y={lineTop(4)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<rect data-el="hv-4" class="xj-bar xj-bar--violet" x={BAR.x} y={lineTop(4)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<rect data-el="hv-5" class="xj-bar xj-bar--violet" x={BAR.x} y={lineTop(5)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<rect data-el="hc-8" class="xj-bar xj-bar--flow" x={BAR.x} y={lineTop(8)} width={BAR.w} height={LINE_H} rx="6"></rect>
				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(3)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<!-- First page: the class Persona -->
				<g data-el="ea" data-base="shown" class="xj-code">
					<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.fileA}</text>
					{
						pageA.map((line) => (
							<g data-el={`ea-${line.n}`}>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
				</g>

				<!-- Second page: main, the array and its slots -->
				<g data-el="eb" class="xj-code">
					<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>{names.fileB}</text>
					{
						pageB.map((line) => (
							<g data-el={`eb-${line.n}`}>
								<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
									{line.n}
								</text>
								<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
							</g>
						))
					}
					<g data-el="eb-x4">
						<text class="xj-gutter" x={GUTTER_X} y={lineBase(4)} text-anchor="end">4</text>
						<text class="xj-mono" x={CODE_X} y={lineBase(4)} xml:space="preserve" set:html={trapHtml} />
					</g>
				</g>

				{
					outputs.map((line) => (
						<text data-el={line.id} class:list={['xj-out', { 'xj-out--err': line.err }]} x={ED.x + 20} y={outY(line.row)} xml:space="preserve">
							{line.text}
						</text>
					))
				}
				{lineAnchors.map((anchor) => <circle data-anchor={anchor.id} cx={BAR_CX} cy={lineMid(anchor.n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow, magenta for null slots and shared references, violet for Heap
	   instances and the references that reach them.
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='arrays-objetos-java']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='arrays-objetos-java'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='arrays-objetos-java'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='arrays-objetos-java'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-magenta {
		stop-color: var(--xj-magenta);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-object {
		fill: var(--xj-violet);
	}

	/* Levels and modules */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-grid {
		fill: none;
		stroke: var(--xj-flow);
		stroke-width: 1;
		opacity: 0.07;
	}

	.xj-floor-text {
		font-family: var(--font-body);
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.04em;
		fill: var(--xj-mist);
		opacity: 0.85;
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-face-text {
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face-text--on {
		fill: var(--xj-ink);
	}

	/* Lit states */
	.xj-lit {
		--xj-lit: var(--xj-flow);
		--xj-lit-soft: var(--xj-flow-soft);
	}

	.xj-lit--violet {
		--xj-lit: var(--xj-violet);
		--xj-lit-soft: var(--xj-violet-soft);
	}

	.xj-lit--magenta {
		--xj-lit: var(--xj-magenta);
		--xj-lit-soft: var(--xj-magenta-soft);
	}

	.xj-lit-halo {
		fill: none;
		stroke: var(--xj-lit);
		stroke-width: 12;
		stroke-opacity: 0.22;
		stroke-linejoin: round;
	}

	.xj-lit-top {
		fill: var(--xj-lit);
		fill-opacity: 0.5;
		stroke: var(--xj-lit-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-lit-side {
		fill: var(--xj-lit-soft);
		stroke: var(--xj-lit-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	/* Routes */
	.xj-trace {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.xj-ref {
		fill: none;
		stroke: var(--xj-mist);
		stroke-width: 2;
		stroke-opacity: 0.7;
		stroke-linecap: round;
	}

	.xj-flowline {
		--xj-line: var(--xj-flow);
	}

	.xj-flowline--magenta {
		--xj-line: var(--xj-magenta);
	}

	.xj-flowline--violet {
		--xj-line: var(--xj-violet);
	}

	.xj-flowline-halo,
	.xj-flowline-core {
		fill: none;
		stroke: var(--xj-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.xj-flowline-halo {
		stroke-width: 11;
		stroke-opacity: 0.2;
	}

	.xj-flowline-core {
		stroke-width: 3;
	}

	/* Notes */
	.xj-chip {
		--xj-chip: var(--xj-edge);
		--xj-chip-ink: var(--xj-mist);
	}

	.xj-chip--flow {
		--xj-chip: var(--xj-flow);
		--xj-chip-ink: var(--xj-flow-soft);
	}

	.xj-chip--magenta {
		--xj-chip: var(--xj-magenta);
		--xj-chip-ink: var(--xj-magenta-soft);
	}

	.xj-chip--violet {
		--xj-chip: var(--xj-violet);
		--xj-chip-ink: var(--xj-violet-soft);
	}

	.xj-chip rect {
		fill: var(--xj-panel);
		fill-opacity: 0.94;
		stroke: var(--xj-chip);
		stroke-width: 1.5;
	}

	.xj-lead {
		stroke: var(--xj-chip);
		stroke-width: 1.5;
		stroke-opacity: 0.7;
	}

	.xj-chip-text {
		font-family: var(--font-body);
		font-size: 12.5px;
		font-weight: 600;
		fill: var(--xj-chip-ink);
	}

	.xj-chip-mono {
		font-family: monospace;
		font-size: 12.5px;
		fill: var(--xj-chip-ink, var(--xj-white));
	}

	.xj-chip-mono--strong {
		font-weight: 700;
		fill: var(--xj-white);
	}

	.xj-icon {
		fill: none;
		stroke: var(--xj-white);
		stroke-linecap: round;
		stroke-linejoin: round;
		overflow: visible;
	}

	/* The object and the flow */
	.xj-gem {
		stroke: var(--xj-violet-soft);
		stroke-width: 1.2;
		stroke-linejoin: round;
	}

	.xj-gem--t {
		fill: var(--xj-violet-soft);
	}

	.xj-gem--l {
		fill: var(--xj-violet);
	}

	.xj-gem--r {
		fill: var(--xj-violet-deep);
	}

	.xj-tag {
		fill: var(--xj-violet-deep);
		stroke: var(--xj-violet);
		stroke-width: 1.5;
	}

	.xj-tag-text {
		font-family: var(--font-body);
		font-size: 12.5px;
		font-weight: 700;
		fill: var(--xj-white);
