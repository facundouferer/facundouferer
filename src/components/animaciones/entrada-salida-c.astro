---
/**
 * Scene for "Reading without trusting" (lesson c/entrada-y-salida, order: 6), a short
 * film played on one persistent motion canvas. The captions and cues live in
 * `src/data/animations/entrada-salida-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay: the lesson's
 * programs, one page at a time, with a bar that slides to the running line and the
 * real output typed in the console below. The viewport on the right holds the camera:
 * one isometric district per run of a program. A light blue particle is the flow of
 * execution and every instruction is a module labelled with its editor line. The
 * keyboard feeds the input buffer, a queue of character tiles that `scanf` consumes
 * from the front into the cell of its variable; `getchar` drains the queue one tile at
 * a time; `printf` turns values into text strips with the specifier on top of each
 * module. Violet marks what decides (the fork and the specifiers) and magenta what goes
 * wrong: the read that fails, the characters left in the buffer and `%f` in `scanf`.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/entrada-salida-c';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── The programs shown in the editor ──────────────────────────────────────
// The lesson's own examples, with its identifiers and strings localized like it does.
// The film runs the same program of page `a` three times, with three different inputs.
const names = {
	age: t('edad', 'age'),
	quantity: t('cantidad', 'quantity'),
	height: t('altura', 'height'),
};

type PageId = 'a' | 'c' | 'e' | 'f';
const programs: Record<PageId, { file: string; lines: string[] }> = {
	a: {
		file: t('edad.c', 'age.c'),
		lines: [
			'#include <stdio.h>',
			'',
			'int main(void) {',
			`    int ${names.age} = 0;`,
			'',
			`    printf("${t('Ingrese su edad: ', 'Enter your age: ')}");`,
			`    if (scanf("%d", &${names.age}) != 1) {`,
			`        printf("${t('Error: se esperaba un número entero.', 'Error: an integer was expected.')}\\n");`,
			'        return 1;',
			'    }',
			'',
			`    printf("${t('Usted tiene %d años', 'You are %d years old')}\\n", ${names.age});`,
			'    return 0;',
			'}',
		],
	},
	c: {
		file: t('cantidad.c', 'quantity.c'),
		lines: [
			'#include <stdio.h>',
			'',
			'int main(void) {',
			`    int ${names.quantity} = 0;`,
			'    int c;',
			`    printf("${t('Cantidad: ', 'Quantity: ')}");`,
			`    if (scanf("%d", &${names.quantity}) != 1) {`,
			"        while ((c = getchar()) != '\\n' && c != EOF) {",
			`            // ${t('descartar el resto de la línea inválida', 'discard the rest of the invalid line')}`,
			'        }',
			`        printf("${t('No es un número. Intente otra vez: ', 'Not a number. Try again: ')}");`,
			`        if (scanf("%d", &${names.quantity}) != 1) {`,
			`            printf("${t('Entrada inválida.', 'Invalid input.')}\\n");`,
			'            return 1;',
			'        }',
			'    }',
			`    printf("${t('Cantidad: %d', 'Quantity: %d')}\\n", ${names.quantity});`,
			'    return 0;',
			'}',
		],
	},
	e: {
		file: 'printf.c',
		lines: [
			'#include <stdio.h>',
			'',
			'int main(void) {',
			'    printf("[%5d]\\n", 42);',
			'    printf("[%-5d]\\n", 42);',
			'    printf("[%05d]\\n", 42);',
			'    printf("[%.2f]\\n", 3.14159);',
			'    printf("[%8.2f]\\n", 3.14159);',
			'    printf("[%zu]\\n", sizeof(double));',
			'    return 0;',
			'}',
		],
	},
	f: {
		file: t('altura.c', 'height.c'),
		lines: [
			'#include <stdio.h>',
			'',
			'int main(void) {',
			`    double ${names.height} = 0.0;`,
			'',
			`    printf("${t('Altura en metros: ', 'Height in meters: ')}");`,
			`    if (scanf("%lf", &${names.height}) != 1) {`,
			`        printf("${t('Altura inválida.', 'Invalid height.')}\\n");`,
			'        return 1;',
			'    }',
			'',
			`    printf("%.2f m\\n", ${names.height});`,
			'    return 0;',
			'}',
		],
	},
};

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const svgLines = (lines: string[]) =>
	highlightCode(lines.join('\n'), 'c').map((html, index) => ({
		n: index + 1,
		html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
	}));
const pages = (Object.keys(programs) as PageId[]).map((id) => ({ id, file: programs[id].file, lines: svgLines(programs[id].lines) }));
const MAX_LINES = Math.max(...pages.map((page) => page.lines.length));

// The real output of each run (cc -std=c23 -Wall -Wextra -Wpedantic, Apple clang, with the
// input piped in). A row repeats what the previous piece of the same row already shows,
// so typing the longer text only reveals the new characters.
const consoleRows: { id: string; row: number; text: string }[] = [
	{ id: 'out-a1', row: 0, text: t('Ingrese su edad: ', 'Enter your age: ') },
	{ id: 'out-a2', row: 0, text: t('Ingrese su edad: Usted tiene 25 años', 'Enter your age: You are 25 years old') },
	{ id: 'out-b1', row: 0, text: t('Ingrese su edad: ', 'Enter your age: ') },
	{
		id: 'out-b2',
		row: 0,
		text: t('Ingrese su edad: Error: se esperaba un número entero.', 'Enter your age: Error: an integer was expected.'),
	},
	{ id: 'out-c1', row: 0, text: t('Cantidad: ', 'Quantity: ') },
	{
		id: 'out-c2',
		row: 0,
		text: t('Cantidad: No es un número. Intente otra vez: ', 'Quantity: Not a number. Try again: '),
	},
	{
		id: 'out-c3',
		row: 0,
		text: t('Cantidad: No es un número. Intente otra vez: Cantidad: 7', 'Quantity: Not a number. Try again: Quantity: 7'),
	},
	{ id: 'out-d1', row: 0, text: t('Ingrese su edad: ', 'Enter your age: ') },
	{ id: 'out-d2', row: 0, text: t('Ingrese su edad: Usted tiene 12 años', 'Enter your age: You are 12 years old') },
	{ id: 'out-e1', row: 0, text: '[   42]' },
	{ id: 'out-e2', row: 1, text: '[42   ]' },
	{ id: 'out-e3', row: 2, text: '[00042]' },
	{ id: 'out-e4', row: 3, text: '[3.14]' },
	{ id: 'out-e5', row: 4, text: '[    3.14]' },
	{ id: 'out-e6', row: 5, text: '[8]' },
	{ id: 'out-f1', row: 0, text: t('Altura en metros: ', 'Height in meters: ') },
	{ id: 'out-f2', row: 0, text: t('Altura en metros: 1.75 m', 'Height in meters: 1.75 m') },
];

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 70;
const LINE_H = 22;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 5;
const CONSOLE_TOP = 496;
const outY = (row: number) => 546 + row * 22;

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up. Every run is a district: a
// floor plate with the execution track along +u (v = 0). At the `if` fork, the branch
// where `scanf` failed leaves along -v. The input buffer is a lane of slots in front
// (v = LANE_V): the keyboard sits at its far end and `scanf` reads from its front.
type Point = { x: number; y: number };
type UV = [number, number];
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 44;
const EY = 25;
const FLOOR = 10;
const round = (value: number) => Math.round(value * 10) / 10;
const iso = (o: Point, u: number, v: number, z = 0): Point => ({
	x: round(o.x + (u - v) * EX),
	y: round(o.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');

/** A box standing at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(o: Point, u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = iso(o, u - a, v - b, top);
	const right = iso(o, u + a, v - b, top);
	const front = iso(o, u + a, v + b, top);
	const left = iso(o, u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const faceCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: iso(o, u, v, top),
		faceMatrix: `matrix(0.866 0.5 0 1 ${faceCenter.x} ${faceCenter.y})`,
	};
}
type Slab = ReturnType<typeof slab>;
type Tone = 'flow' | 'violet' | 'magenta';

type StationKind = 'step' | 'fork';
type StationSpec = { key: string; line: number; at: UV; kind: StationKind; tone?: Tone };
type CellSpec = {
	id: string;
	name: string;
	at: UV;
	half?: UV;
	values: { id: string; text: string; tone: Tone }[];
};
type TileSpec = { id: string; ch: string; slot: number };
type DistrictSpec = {
	id: string;
	page: PageId;
	origin: Point;
	tag: string;
	points: Record<string, UV>;
	stations: StationSpec[];
	rails: string[][];
	runs: { id: string; via: string[]; tone?: Tone }[];
	cells: CellSpec[];
	/** The input buffer: how many slots, and the tiles the keyboard types into them. */
	lane?: { slots: number; tiles: TileSpec[] };
	/** Dashed rings around the characters that stay unread, by slot range. */
	zone?: [number, number];
};

const LANE_V = 2.1;
const slotU = (slot: number) => 0.9 + 0.55 * (slot - 1);
const KB_U = 4.6;

/** The `scanf` program of page a / f: station keys are editor lines. */
const readStations = (): StationSpec[] => [
	{ key: '4', line: 4, at: [0, 0], kind: 'step' },
	{ key: '6', line: 6, at: [1.0, 0], kind: 'step' },
	{ key: '7', line: 7, at: [2.0, 0], kind: 'fork' },
	{ key: '8', line: 8, at: [2.0, -1.0], kind: 'step', tone: 'magenta' },
	{ key: '9', line: 9, at: [2.0, -2.0], kind: 'step', tone: 'magenta' },
	{ key: '12', line: 12, at: [3.2, 0], kind: 'step' },
	{ key: '13', line: 13, at: [4.2, 0], kind: 'step' },
];
const readRails = () => [
	['4', '6', '7', '12', '13'],
	['7', '8', '9'],
];
const readRuns = (d: string) => [
	{ id: `run-${d}-1`, via: ['4', '6'] },
	{ id: `run-${d}-2`, via: ['6', '7'] },
	{ id: `run-${d}-3`, via: ['7', '12'] },
	{ id: `run-${d}-4`, via: ['12', '13'] },
	{ id: `run-${d}-e`, via: ['7', '8', '9'], tone: 'magenta' as Tone },
];
const tiles = (d: string, chars: string[]): TileSpec[] => chars.map((ch, index) => ({ id: `t-${d}${index + 1}`, ch, slot: index + 1 }));

const districts: DistrictSpec[] = [
	{
		// scanf reads `25`: it returns 1 and the newline stays in the buffer.
		id: 'a',
		page: 'a',
		origin: { x: 200, y: 140 },
		tag: 'scanf → 1',
		points: {},
		stations: readStations(),
		rails: readRails(),
		runs: readRuns('a'),
		cells: [{ id: 'c-a', name: names.age, at: [0, 1.15], values: [{ id: 'v-a0', text: '0', tone: 'flow' }, { id: 'v-a25', text: '25', tone: 'flow' }] }],
		lane: { slots: 5, tiles: tiles('a', ['2', '5', '\\n']) },
	},
	{
		// scanf finds `abc`: it returns 0, changes nothing and consumes nothing.
		id: 'b',
		page: 'a',
		origin: { x: 900, y: 140 },
		tag: 'scanf → 0',
		points: {},
		stations: readStations(),
		rails: readRails(),
		runs: readRuns('b'),
		cells: [{ id: 'c-b', name: names.age, at: [0, 1.15], values: [{ id: 'v-b0', text: '0', tone: 'flow' }] }],
		lane: { slots: 5, tiles: tiles('b', ['a', 'b', 'c', '\\n']) },
		zone: [1, 4],
	},
	{
		// The recipe: fail, discard the line with getchar, read again.
		id: 'c',
		page: 'c',
		origin: { x: 200, y: 500 },
		tag: 'getchar',
		points: {},
		stations: [
			{ key: '4', line: 4, at: [0, 0], kind: 'step' },
			{ key: '5', line: 5, at: [0.9, 0], kind: 'step' },
			{ key: '6', line: 6, at: [1.8, 0], kind: 'step' },
			{ key: '7', line: 7, at: [2.7, 0], kind: 'fork' },
			{ key: '8', line: 8, at: [3.6, 0], kind: 'fork', tone: 'violet' },
			{ key: '11', line: 11, at: [4.5, 0], kind: 'step' },
			{ key: '12', line: 12, at: [5.4, 0], kind: 'fork' },
			{ key: '13', line: 13, at: [5.4, -1.0], kind: 'step', tone: 'magenta' },
			{ key: '14', line: 14, at: [5.4, -2.0], kind: 'step', tone: 'magenta' },
			{ key: '17', line: 17, at: [6.3, 0], kind: 'step' },
			{ key: '18', line: 18, at: [7.2, 0], kind: 'step' },
		],
		rails: [
			['4', '5', '6', '7', '8', '11', '12', '17', '18'],
			['12', '13', '14'],
		],
		runs: [
			{ id: 'run-c-1', via: ['4', '5'] },
			{ id: 'run-c-2', via: ['5', '6'] },
			{ id: 'run-c-3', via: ['6', '7'] },
			{ id: 'run-c-4', via: ['7', '8'] },
			{ id: 'run-c-5', via: ['8', '11'] },
			{ id: 'run-c-6', via: ['11', '12'] },
			{ id: 'run-c-7', via: ['12', '17'] },
			{ id: 'run-c-8', via: ['17', '18'] },
		],
		cells: [
			{ id: 'c-c', name: names.quantity, at: [0, 1.15], values: [{ id: 'v-c0', text: '0', tone: 'flow' }, { id: 'v-c7', text: '7', tone: 'flow' }] },
			{ id: 'c-cc', name: 'c', at: [0.95, 1.15], values: [] },
		],
		lane: { slots: 6, tiles: tiles('c', ['a', 'b', 'c', '\\n', '7', '\\n']) },
		zone: [1, 4],
	},
	{
		// scanf reads `12` out of `12abc`: success, but `abc` stays pending.
		id: 'd',
		page: 'a',
		origin: { x: 900, y: 500 },
		tag: '12abc',
		points: {},
		stations: readStations(),
		rails: readRails(),
		runs: readRuns('d'),
		cells: [{ id: 'c-d', name: names.age, at: [0, 1.15], values: [{ id: 'v-d0', text: '0', tone: 'flow' }, { id: 'v-d12', text: '12', tone: 'flow' }] }],
		lane: { slots: 6, tiles: tiles('d', ['1', '2', 'a', 'b', 'c', '\\n']) },
		zone: [3, 6],
	},
	{
		// printf: six lines, six specifiers, six strips of text.
		id: 'e',
		page: 'e',
		origin: { x: 200, y: 930 },
		tag: 'printf',
		points: {},
		stations: [
			{ key: '4', line: 4, at: [0, 0], kind: 'step' },
			{ key: '5', line: 5, at: [1.2, 0], kind: 'step' },
			{ key: '6', line: 6, at: [2.4, 0], kind: 'step' },
			{ key: '7', line: 7, at: [3.6, 0], kind: 'step' },
			{ key: '8', line: 8, at: [4.8, 0], kind: 'step' },
			{ key: '9', line: 9, at: [6.0, 0], kind: 'step' },
			{ key: '10', line: 10, at: [7.2, 0], kind: 'step' },
		],
		rails: [['4', '5', '6', '7', '8', '9', '10']],
		runs: [
			{ id: 'run-e-4', via: ['4', '5'] },
			{ id: 'run-e-5', via: ['5', '6'] },
			{ id: 'run-e-6', via: ['6', '7'] },
			{ id: 'run-e-7', via: ['7', '8'] },
			{ id: 'run-e-8', via: ['8', '9'] },
			{ id: 'run-e-9', via: ['9', '10'] },
		],
		cells: [],
	},
	{
		// A double: `%lf` in scanf, `%f` in printf.
		id: 'f',
		page: 'f',
		origin: { x: 900, y: 930 },
		tag: '%lf',
		points: {},
		stations: readStations(),
		rails: readRails(),
		runs: readRuns('f'),
		cells: [
			{
				id: 'c-f',
				name: names.height,
				at: [0.3, 1.15],
				half: [0.62, 0.36],
				values: [{ id: 'v-f0', text: '0.0', tone: 'flow' }, { id: 'v-f175', text: '1.75', tone: 'flow' }],
			},
		],
		lane: { slots: 5, tiles: tiles('f', ['1', '.', '7', '5', '\\n']) },
	},
];

const district = (id: string) => districts.find((item) => item.id === id) ?? districts[0];
const uvOf = (d: DistrictSpec, key: string): UV => d.stations.find((s) => s.key === key)?.at ?? d.points[key] ?? [0, 0];
const railPoint = (d: DistrictSpec, key: string) => iso(d.origin, ...uvOf(d, key), FLOOR);
const railPath = (d: DistrictSpec, keys: string[]) =>
	keys.map((key, index) => `${index === 0 ? 'M' : 'L'}${railPoint(d, key).x} ${railPoint(d, key).y}`).join(' ');

// Floor plates: a margin around every point of the district.
const plates = districts.map((d) => {
	const lane = d.lane ? [[slotU(1), LANE_V] as UV, [KB_U, LANE_V] as UV] : [];
	const chipsBand: UV[] = d.id === 'e' ? [[0, -1.5], [0, 1.5]] : [];
	const all = [...d.stations.map((s) => s.at), ...Object.values(d.points), ...d.cells.map((c) => c.at), ...lane, ...chipsBand];
	const us = all.map(([u]) => u);
	const vs = all.map(([, v]) => v);
	const [u0, u1, v0, v1] = [Math.min(...us) - 0.6, Math.max(...us) + 0.6, Math.min(...vs) - 0.6, Math.max(...vs) + 0.6];
	return { id: d.id, g: slab(d.origin, (u0 + u1) / 2, (v0 + v1) / 2, (u1 - u0) / 2, (v1 - v0) / 2, FLOOR, 0), u0, u1, v0, v1 };
});

// Modules: one per instruction, labelled with its editor line; forks are larger.
type Module = { id: string; line: number; g: Slab; kind: StationKind; tone: Tone };
const modules: Module[] = districts.flatMap((d) =>
	d.stations.map((s) => {
		const size = s.kind === 'step' ? 0.2 : 0.27;
		return {
			id: `${d.id}${s.key}`,
			line: s.line,
			kind: s.kind,
			tone: s.tone ?? (s.kind === 'step' ? 'flow' : 'violet'),
			g: slab(d.origin, s.at[0], s.at[1], size, size, s.kind === 'step' ? 14 : 18, FLOOR),
		};
	}),
);

// Cells: a variable is a box with its name on the front and its value on top.
const cells = districts.flatMap((d) =>
	d.cells.map((c) => ({ ...c, g: slab(d.origin, c.at[0], c.at[1], c.half?.[0] ?? 0.36, c.half?.[1] ?? 0.36, 16, FLOOR) })),
);

// The input buffer: slots on the floor, a keyboard at the far end, tiles drawn around (0, 0).
const lanes = districts.flatMap((d) => {
	if (!d.lane) return [];
	const slots = Array.from({ length: d.lane.slots }, (_, index) => ({
		n: index + 1,
		g: slab(d.origin, slotU(index + 1), LANE_V, 0.25, 0.25, 2, FLOOR),
		at: iso(d.origin, slotU(index + 1), LANE_V, FLOOR),
	}));
	const keyboard = slab(d.origin, KB_U, LANE_V, 0.5, 0.3, 9, FLOOR);
	const keys = [-0.3, 0, 0.3].flatMap((du) => [-0.12, 0.12].map((dv) => slab(d.origin, KB_U + du, LANE_V + dv, 0.07, 0.07, 1.5, FLOOR + 9)));
	const zone = d.zone
		? poly([
				iso(d.origin, slotU(d.zone[0]) - 0.32, LANE_V - 0.32, FLOOR),
				iso(d.origin, slotU(d.zone[1]) + 0.32, LANE_V - 0.32, FLOOR),
				iso(d.origin, slotU(d.zone[1]) + 0.32, LANE_V + 0.32, FLOOR),
				iso(d.origin, slotU(d.zone[0]) - 0.32, LANE_V + 0.32, FLOOR),
			])
		: undefined;
	const tileG = slab({ x: 0, y: 0 }, 0, 0, 0.2, 0.2, 12, 0);
	return [
		{
			id: d.id,
			slots,
			keyboard,
			keys,
			zone,
			tileG,
			tiles: d.lane.tiles.map((tile) => ({ ...tile, at: slots[tile.slot - 1].at })),
			labelBuf: iso(d.origin, 0.65, LANE_V + 0.62, FLOOR),
			labelKb: iso(d.origin, KB_U, LANE_V + 0.62, FLOOR),
		},
	];
});

// Where the particle and the tiles stop: above a module, a cell or a slot.
const anchors = [
	...modules.map((module) => ({ id: `a-${module.id}`, ...lift(module.g.center, 14) })),
	...cells.map((c) => ({ id: `k-${c.id.slice(2) === 'cc' ? 'c-cc' : `${c.id.slice(2)}-cell`}`, ...lift(c.g.center, 2) })),
	...districts.flatMap((d) => (d.lane ? lanes.find((lane) => lane.id === d.id)?.slots.map((slot) => ({ id: `s-${d.id}-${slot.n}`, ...slot.at })) ?? [] : [])),
];
const at = (id: string) => anchors.find((anchor) => anchor.id === id) ?? { x: 0, y: 0 };
const mod = (id: string) => modules.find((module) => module.id === id) ?? modules[0];

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shotRect = (id: string, cx: number, cy: number, s: number) => ({
	id,
	x: round(cx - 640 / s),
	y: round(cy - 360 / s),
	w: round(1280 / s),
	h: round(720 / s),
});
const plateBox = (id: string) => {
	const p = plates.find((item) => item.id === id) ?? plates[0];
	const d = district(id);
	const corners = [iso(d.origin, p.u0, p.v0), iso(d.origin, p.u1, p.v0), iso(d.origin, p.u1, p.v1), iso(d.origin, p.u0, p.v1)];
	const xs = corners.map((c) => c.x);
	const ys = corners.map((c) => c.y);
	return { x0: Math.min(...xs), x1: Math.max(...xs), y0: Math.min(...ys) - 70, y1: Math.max(...ys) + 40 };
};
const fitShot = (id: string, boxes: ReturnType<typeof plateBox>[], max = 1.6) => {
	const x0 = Math.min(...boxes.map((b) => b.x0));
	const x1 = Math.max(...boxes.map((b) => b.x1));
	const y0 = Math.min(...boxes.map((b) => b.y0));
	const y1 = Math.max(...boxes.map((b) => b.y1));
	const s = Math.round(Math.min(max, (VP.w - 40) / (x1 - x0), (VP.h - 60) / (y1 - y0)) * 100) / 100;
	return shotRect(id, (x0 + x1) / 2, (y0 + y1) / 2, s);
};
const focus = (id: string, point: Point, s: number) => shotRect(id, point.x, point.y, s);
const shots = [
	...districts.map((d) => fitShot(`shot-${d.id}`, [plateBox(d.id)])),
	// The cell, the front of the buffer and the `scanf` module in one frame.
	...['a', 'b', 'c', 'd', 'f'].map((id) => focus(`shot-${id}-buf`, iso(district(id).origin, 1.85, 0.95, FLOOR), 1.7)),
	fitShot(
		'shot-all',
		districts.map((d) => plateBox(d.id)),
		1,
	),
];

// Floating notes, placed relative to a module or an anchor point.
type Chip = {
	id: string;
	text: string;
	x: number;
	y: number;
	align: 'start' | 'end' | 'middle';
	tone: 'plain' | Tone;
	mono?: boolean;
	icon?: 'x' | 'lock' | 'check';
};
const top = (id: string) => mod(id).g.center;
const slotTop = (d: string, slot: number) => at(`s-${d}-${slot}`);
const cellTop = (d: string) => at(`k-${d}-cell`);
const falseText = t('falso', 'false');
const trueText = t('verdadero', 'true');
const stuckText = t('siguen en el búfer', 'still in the buffer');
const chips: Chip[] = [
	// scanf reads 25
	{ id: 'r-a7', text: 'scanf → 1', x: top('a7').x, y: top('a7').y - 56, align: 'middle', tone: 'violet', mono: true },
	{ id: 'q-a7', text: `1 != 1 → ${falseText}`, x: top('a7').x, y: top('a7').y - 30, align: 'middle', tone: 'violet', mono: true },
	{ id: 'rest-a', text: t("el '\\n' queda", "the '\\n' stays"), x: slotTop('a', 3).x, y: slotTop('a', 3).y + 28, align: 'middle', tone: 'plain' },
	{ id: 'skip-a8', text: t('se salta', 'skipped'), x: top('a8').x + 18, y: top('a8').y - 30, align: 'start', tone: 'plain', icon: 'x' },
	// scanf finds abc
	{ id: 'r-b7', text: 'scanf → 0', x: top('b7').x, y: top('b7').y - 56, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'q-b7', text: `0 != 1 → ${trueText}`, x: top('b7').x, y: top('b7').y - 30, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'stuck-b', text: stuckText, x: slotTop('b', 3).x, y: slotTop('b', 3).y + 32, align: 'middle', tone: 'magenta' },
	// the discard loop
	{ id: 'r-c7', text: 'scanf → 0', x: top('c7').x, y: top('c7').y - 56, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'stuck-c', text: stuckText, x: slotTop('c', 3).x, y: slotTop('c', 3).y + 32, align: 'middle', tone: 'magenta' },
	{ id: 'lp-c8', text: t('getchar: un carácter por vuelta', 'getchar: one character per turn'), x: top('c8').x, y: top('c8').y - 56, align: 'middle', tone: 'violet' },
	{ id: 'r-c12', text: 'scanf → 1', x: top('c12').x, y: top('c12').y - 56, align: 'middle', tone: 'violet', mono: true },
	{ id: 'skip-c13', text: t('se salta', 'skipped'), x: top('c13').x + 18, y: top('c13').y - 30, align: 'start', tone: 'plain', icon: 'x' },
	// 12abc
	{ id: 'r-d7', text: 'scanf → 1', x: top('d7').x, y: top('d7').y - 56, align: 'middle', tone: 'violet', mono: true },
	{ id: 'q-d7', text: `1 != 1 → ${falseText}`, x: top('d7').x, y: top('d7').y - 30, align: 'middle', tone: 'violet', mono: true },
	{ id: 'left-d', text: t('abc quedó pendiente', 'abc is still pending'), x: slotTop('d', 4).x, y: slotTop('d', 4).y + 32, align: 'middle', tone: 'magenta' },
	{ id: 'skip-d8', text: t('se salta', 'skipped'), x: top('d8').x + 18, y: top('d8').y - 30, align: 'start', tone: 'plain', icon: 'x' },
	// double
	{ id: 'lf-scan', text: t('scanf: double → %lf', 'scanf: double → %lf'), x: top('f7').x, y: top('f7').y - 56, align: 'middle', tone: 'violet', mono: true },
	{ id: 'lf-wrong', text: t('%f escribe un float', '%f writes a float'), x: cellTop('f').x - 8, y: cellTop('f').y - 46, align: 'middle', tone: 'magenta', mono: true, icon: 'x' },
	{ id: 'r-f7', text: 'scanf → 1', x: top('f7').x, y: top('f7').y - 30, align: 'middle', tone: 'violet', mono: true },
	{ id: 'lf-print', text: t('printf: double → %f', 'printf: double → %f'), x: top('f12').x, y: top('f12').y - 40, align: 'middle', tone: 'flow', mono: true },
	{ id: 'skip-f8', text: t('se salta', 'skipped'), x: top('f8').x + 18, y: top('f8').y - 30, align: 'start', tone: 'plain', icon: 'x' },
];

// printf: the specifier above one side of each module, the text it prints on the other.
const printfRows: { line: number; spec: string; out: string }[] = [
	{ line: 4, spec: '%5d', out: '[   42]' },
	{ line: 5, spec: '%-5d', out: '[42   ]' },
	{ line: 6, spec: '%05d', out: '[00042]' },
	{ line: 7, spec: '%.2f', out: '[3.14]' },
	{ line: 8, spec: '%8.2f', out: '[    3.14]' },
	{ line: 9, spec: '%zu', out: '[8]' },
];
printfRows.forEach((row, index) => {
	const up = index % 2 === 0;
	const base = top(`e${row.line}`);
	chips.push({ id: `sp-e${row.line}`, text: row.spec, x: base.x, y: base.y + (up ? 34 : -38), align: 'middle', tone: 'violet', mono: true });
	chips.push({ id: `o-e${row.line}`, text: row.out, x: base.x, y: base.y + (up ? -38 : 34), align: 'middle', tone: 'flow', mono: true });
});

const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.icon ? 42 : 24));
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

// District tags, revealed when the camera pulls back over the whole map.
const tags = districts.map((d) => {
	const p = plates.find((item) => item.id === d.id) ?? plates[0];
	const corner = iso(d.origin, p.u0, p.v1, 0);
	return { id: `tag-${d.id}`, text: d.tag, x: corner.x + 40, y: corner.y + 30 };
});

const LEGEND_Y = VP.y + VP.h - 22;
const START = at('a-a4');
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="es-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="es-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="es-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="es-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="es-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="es-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: one district per run, seen through the camera -->
			<g clip-path="url(#es-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#es-g-pool-violet)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#es-g-pool-flow)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						{
							districts.map((d) => {
								const plate = plates.find((item) => item.id === d.id) ?? plates[0];
								const lane = lanes.find((item) => item.id === d.id);
								return (
									<g data-el={`dist-${d.id}`}>
										<polygon class="xj-plate-shadow" points={plate.g.base} transform="translate(12 18)" />
										<polygon class="xj-plate xj-plate--l" points={plate.g.leftFace} />
										<polygon class="xj-plate xj-plate--r" points={plate.g.rightFace} />
										<polygon class="xj-plate xj-plate--t" points={plate.g.top} fill="url(#es-g-floor)" />

										{/* The input buffer: slots on the floor and the keyboard that fills them */}
										{lane && (
											<>
												{lane.slots.map((slot) => <polygon class="xj-slot" points={slot.g.top} />)}
												<g data-el={`kb-${d.id}`} data-base="shown" class="xj-kb">
													<polygon class="xj-shadow" points={lane.keyboard.base} transform="translate(5 7)" />
													<polygon class="xj-face xj-face--l" points={lane.keyboard.leftFace} />
													<polygon class="xj-face xj-face--r" points={lane.keyboard.rightFace} />
													<polygon class="xj-face xj-face--t" points={lane.keyboard.top} fill="url(#es-g-top)" />
													{lane.keys.map((key) => <polygon class="xj-key" points={key.top} />)}
												</g>
												<text class="xj-floor-label" x={lane.labelBuf.x} y={lane.labelBuf.y} text-anchor="start">
													{t('búfer de entrada', 'input buffer')}
												</text>
												<text class="xj-floor-label" x={lane.labelKb.x} y={lane.labelKb.y} text-anchor="middle">
													{t('teclado', 'keyboard')}
												</text>
												{lane.zone && (
													<g data-el={`zone-${d.id}`} class="xj-zone xj-zone--bad">
														<polygon points={lane.zone} />
													</g>
												)}
											</>
										)}

										{/* The track: every path the program could take */}
										{d.rails.map((rail) => (
											<g class="xj-rail">
												<path class="xj-rail-bed" d={railPath(d, rail)} />
												<path class="xj-rail-line" d={railPath(d, rail)} />
											</g>
										))}

										{/* The route actually taken lights up behind the particle */}
										{d.runs.map((run) => (
											<g data-el={run.id} class:list={['xj-run', `xj-run--${run.tone ?? 'flow'}`]}>
												<path class="mg-stroke xj-run-halo" pathLength="1" d={railPath(d, run.via)} />
												<path class="mg-stroke xj-run-core" pathLength="1" d={railPath(d, run.via)} />
											</g>
										))}

										{modules
											.filter((module) => module.id.startsWith(d.id) && d.stations.some((s) => `${d.id}${s.key}` === module.id))
											.map((module) => (
												<>
													<g data-el={`m-${module.id}`} data-base="shown" class:list={['xj-mod', `xj-mod--${module.kind}`, `xj-mod--${module.tone}`]}>
														<polygon class="xj-shadow" points={module.g.base} transform="translate(5 7)" />
														<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
														<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
														<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#es-g-top)" />
														<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4">
															{module.line}
														</text>
													</g>
													<g data-el={`on-${module.id}`} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
														<polygon class="xj-lit-halo" points={module.g.top} />
														<polygon class="xj-lit-top" points={module.g.top} />
														<polygon class="xj-lit-side" points={module.g.leftFace} />
														<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4">
															{module.line}
														</text>
													</g>
												</>
											))}

										{cells
											.filter((c) => d.cells.some((spec) => spec.id === c.id))
											.map((c) => (
												<g data-el={c.id} data-base="shown">
													<polygon class="xj-shadow" points={c.g.base} transform="translate(5 7)" />
													<polygon class="xj-cell xj-cell--l" points={c.g.leftFace} />
													<polygon class="xj-cell xj-cell--r" points={c.g.rightFace} />
													<polygon class="xj-cell xj-cell--t" points={c.g.top} />
													<text class="xj-cell-name" transform={c.g.faceMatrix} text-anchor="middle" y="4">
														{c.name}
													</text>
													{c.values.map((value) => (
														<text data-el={value.id} class:list={['xj-value', `xj-value--${value.tone}`]} x={c.g.center.x} y={c.g.center.y + 6} text-anchor="middle">
															{value.text}
														</text>
													))}
												</g>
											))}

										{/* The characters typed at the keyboard, one tile per character, drawn around (0, 0) */}
										{lane?.tiles.map((tile) => (
											<g data-el={tile.id} class="xj-tile" data-x={tile.at.x} data-y={tile.at.y}>
												<polygon class="xj-shadow" points={lane.tileG.base} transform="translate(3 5)" />
												<polygon class="xj-cell xj-cell--l" points={lane.tileG.leftFace} />
												<polygon class="xj-cell xj-cell--r" points={lane.tileG.rightFace} />
												<polygon class="xj-cell xj-cell--t" points={lane.tileG.top} />
												<text class="xj-tile-ch" x={lane.tileG.center.x} y={lane.tileG.center.y + 5} text-anchor="middle">
													{tile.ch}
												</text>
											</g>
										))}
									</g>
								);
							})
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.icon === 'x' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M18 6 6 18" />
											<path d="m6 6 12 12" />
										</svg>
									)}
									{chip.icon === 'lock' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
											<path d="M7 11V7a5 5 0 0 1 10 0v4" />
										</svg>
									)}
									{chip.icon === 'check' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.icon ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
										xml:space="preserve"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						{
							tags.map((tag) => (
								<g data-el={tag.id} class="xj-tag">
									<text x={tag.x} y={tag.y} text-anchor="middle">
										{tag.text}
									</text>
								</g>
							))
						}

						<!-- The execution flow. Placement lives in data-x/data-y: the player resets data-el transforms. -->
						<g data-el="p" class="xj-particle" data-x={START.x} data-y={START.y}>
							<circle r="20" fill="url(#es-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="440" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<rect class="xj-legend-fork" x={VP.x + 176} y={LEGEND_Y - 6} width="12" height="12" rx="3"></rect>
				<text x={VP.x + 196} y={LEGEND_Y + 4}>{t('Decide', 'Decides')}</text>
				<rect class="xj-legend-bug" x={VP.x + 270} y={LEGEND_Y - 6} width="12" height="12" rx="3"></rect>
				<text x={VP.x + 290} y={LEGEND_Y + 4}>{t('Falla o queda sin leer', 'Fails or stays unread')}</text>
			</g>

			<!-- EDITOR: the lesson's programs, one page at a time, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(4)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				{
					pages.map((page) => (
						<g data-el={`pg-${page.id}`} data-base={page.id === 'a' ? 'shown' : undefined} class="xj-code">
							<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>
								{page.file}
							</text>
							{page.lines.map((line) => (
								<>
									<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
										{line.n}
									</text>
									<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
								</>
							))}
						</g>
					))
				}

				<!-- Console: the real output, typed as each line runs -->
				{
					consoleRows.map((row) => (
						<text data-el={row.id} class="xj-out" x={ED.x + 20} y={outY(row.row)} xml:space="preserve">
							{row.text}
						</text>
					))
				}
				{Array.from({ length: MAX_LINES }, (_, index) => index + 1).map((n) => <circle data-anchor={`ln-${n}`} cx={BAR_CX} cy={lineMid(n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow, violet for what decides (the fork and the specifiers), and magenta for
	   what goes wrong: the failed read, the unread characters and %f in scanf.
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='entrada-salida-c']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
