---
/**
 * Scene for "Walking an array with a pointer" (lesson c/punteros-arreglos-y-estructuras,
 * order: 26), a short film played on one persistent motion canvas. The captions and
 * cues live in `src/data/animations/punteros-arreglos-c.ts`.
 *
 * The canvas has two halves. The editor on the left is a fixed overlay with the three
 * programs of the lesson the film runs (the loop over `notas`, `promedio` and
 * `struct Punto`); a bar slides to the line being executed and the real output is
 * typed in the console below. The viewport on the right holds the camera: an
 * isometric model of memory. `notas` is a row of five contiguous cells 4 bytes apart,
 * with the address on the front edge and the value on top; one past the end there is
 * a dashed cell that holds nothing. A pointer is always a violet pin whose arrow tip
 * rests on the cell it points to, or a violet arrow drawn from the cell that stores
 * it. The function being called is a raised plate with its own variables. One module
 * per instruction stands in front of memory, labelled with its editor line.
 *
 * Palette: films are the approved exception to the Organic palette (DESIGN.md §8).
 * The colors are the `--xj-*` tokens declared once in the style block; nothing
 * else in the file uses a raw color.
 */
import AnimationPlayer from '../animations/AnimationPlayer.astro';
import type { Animation } from '../../data/animations';
import { script } from '../../data/animations/punteros-arreglos-c';
import { resolveScript } from '../../utils/animations';
import { highlightCode } from '../../utils/highlightCode';

type Props = {
	lang: 'es' | 'en';
	animation: Animation;
};

const { lang, animation } = Astro.props;
const isEs = lang === 'es';
const resolved = resolveScript(script, lang);
const t = (es: string, en: string) => (isEs ? es : en);

// ── The three programs shown in the editor ────────────────────────────────
// They are the lesson's own examples, with its identifiers localized like it does.
// Trailing comments are left out so every line fits the editor.
const id = {
	notas: t('notas', 'grades'),
	suma: t('suma', 'sum'),
	promedio: t('promedio', 'average'),
	punto: t('Punto', 'Point'),
	mover: t('mover', 'move'),
	mostrar: t('mostrar', 'show'),
};

const programLoop = [
	'#include <stdio.h>',
	'',
	'int main(void) {',
	`    int ${id.notas}[5] = {7, 4, 9, 6, 8};`,
	`    int ${id.suma} = 0;`,
	'',
	`    for (int *p = ${id.notas}; p < ${id.notas} + 5; p++) {`,
	`        ${id.suma} += *p;`,
	'    }',
	`    printf("${id.suma} = %d\\n", ${id.suma});`,
	'',
	'    return 0;',
	'}',
].join('\n');

const programAverage = [
	'#include <stddef.h>',
	'#include <stdio.h>',
	'',
	`double ${id.promedio}(const int *v, size_t n) {`,
	`    int ${id.suma} = 0;`,
	'    for (size_t i = 0; i < n; i++) {',
	`        ${id.suma} += v[i];`,
	'    }',
	`    return n > 0 ? (double)${id.suma} / (double)n : 0.0;`,
	'}',
	'',
	'int main(void) {',
	`    int ${id.notas}[] = {7, 4, 9, 6, 8};`,
	`    size_t n = sizeof ${id.notas} / sizeof ${id.notas}[0];`,
	'',
	`    printf("${id.promedio} = %.2f\\n", ${id.promedio}(${id.notas}, n));`,
	'',
	'    return 0;',
	'}',
].join('\n');

const programPoint = [
	'#include <stdio.h>',
	'',
	`struct ${id.punto} {`,
	'    int x;',
	'    int y;',
	'};',
	'',
	`void ${id.mover}(struct ${id.punto} *p, int dx, int dy) {`,
	'    p->x += dx;',
	'    p->y += dy;',
	'}',
	'',
	`void ${id.mostrar}(const struct ${id.punto} *p) {`,
	'    printf("(%d, %d)\\n", p->x, p->y);',
	'}',
	'',
	'int main(void) {',
	`    struct ${id.punto} a = {1, 2};`,
	`    ${id.mover}(&a, 3, -1);`,
	`    ${id.mostrar}(&a);`,
	`    struct ${id.punto} *pa = &a;`,
	'    (*pa).x = 0;',
	`    ${id.mostrar}(pa);`,
	'    return 0;',
	'}',
].join('\n');

/** The tokenizer renders HTML spans; inside an SVG <text> they must be tspans. */
const linesOf = (source: string) =>
	highlightCode(source, 'c').map((html, index) => ({
		n: index + 1,
		html: html.replaceAll('<span', '<tspan').replaceAll('</span>', '</tspan>'),
	}));
const pages = [
	{ el: 'ea', file: t('notas.c', 'grades.c'), lines: linesOf(programLoop), typed: true },
	{ el: 'eb', file: t('promedio.c', 'average.c'), lines: linesOf(programAverage), typed: false },
	{ el: 'ec', file: t('punto.c', 'point.c'), lines: linesOf(programPoint), typed: false },
];
const MAX_LINES = Math.max(...pages.map((page) => page.lines.length));

// What each program prints (compiled with cc -std=c23 -Wall -Wextra -Wpedantic).
const outputs = [
	{ id: 'oa-1', row: 0, text: `${id.suma} = 34` },
	{ id: 'ob-1', row: 0, text: `${id.promedio} = 6.80` },
	{ id: 'oc-1', row: 0, text: '(4, 1)' },
	{ id: 'oc-2', row: 1, text: '(0, 1)' },
];

// ── Editor geometry (canvas units, outside the camera) ────────────────────
const ED = { x: 20, y: 20, w: 580, h: 680 };
const CODE_X = 72;
const GUTTER_X = 59;
const CODE_TOP = 70;
const LINE_H = 20;
const BAR = { x: 28, w: 564 };
const BAR_CX = BAR.x + BAR.w / 2;
const lineTop = (n: number) => CODE_TOP + (n - 1) * LINE_H;
const lineMid = (n: number) => lineTop(n) + LINE_H / 2;
const lineBase = (n: number) => lineMid(n) + 4.5;
const CONSOLE_TOP = lineTop(MAX_LINES + 1) + 10;
const outY = (row: number) => CONSOLE_TOP + 48 + row * 22;

// ── Isometric world (camera space) ────────────────────────────────────────
// Grid axes: +u runs down-right, +v down-left, z is up. The cells of `notas` lie on
// the line v = 0; the modules stand in a row in front of them; the function that is
// called is a raised plate behind.
type Point = { x: number; y: number };
const VP = { x: 616, y: 20, w: 644, h: 680 };
/** The camera centers its target on the canvas; this shift moves that center to the viewport. */
const VIEW_SHIFT = VP.x + VP.w / 2 - 640;
const EX = 56;
const EY = 32;
const ORIGIN = { x: 430, y: 250 };
const round = (value: number) => Math.round(value * 10) / 10;
const pt = (u: number, v: number, z = 0): Point => ({
	x: round(ORIGIN.x + (u - v) * EX),
	y: round(ORIGIN.y + (u + v) * EY - z),
});
const lift = (point: Point, by: number): Point => ({ x: point.x, y: round(point.y - by) });
const poly = (points: Point[]) => points.map((point) => `${point.x},${point.y}`).join(' ');

/** A box standing at height `z`: half-extents `a` (along u) and `b` (along v), height `h`. */
function slab(u: number, v: number, a: number, b: number, h: number, z = 0) {
	const top = z + h;
	const back = pt(u - a, v - b, top);
	const right = pt(u + a, v - b, top);
	const front = pt(u + a, v + b, top);
	const left = pt(u - a, v + b, top);
	const down = (point: Point): Point => ({ x: point.x, y: round(point.y + h) });
	const leftCenter = { x: round((left.x + front.x) / 2), y: round((left.y + front.y) / 2 + h / 2) };
	const rightCenter = { x: round((front.x + right.x) / 2), y: round((front.y + right.y) / 2 + h / 2) };
	return {
		top: poly([back, right, front, left]),
		base: poly([back, right, front, left].map(down)),
		leftFace: poly([left, front, down(front), down(left)]),
		rightFace: poly([front, right, down(right), down(front)]),
		center: pt(u, v, top),
		left,
		front,
		faceMatrix: `matrix(0.866 0.5 0 1 ${leftCenter.x} ${leftCenter.y})`,
		sideMatrix: `matrix(0.866 -0.5 0 1 ${rightCenter.x} ${rightCenter.y})`,
	};
}
type Slab = ReturnType<typeof slab>;
type Tone = 'flow' | 'violet' | 'magenta';

// The cells of `notas`, 4 bytes apart, and the position one past the end.
const CELL_H = 16;
const cellU = (index: number) => -2.4 + index * 0.95;
const cellAt = (index: number) => slab(cellU(index), 0, 0.42, 0.42, CELL_H);
const values = [7, 4, 9, 6, 8];
const hex = (value: number) => `0x${value.toString(16)}`;
const cells = values.map((value, index) => ({ index, value, address: hex(0x1000 + index * 4), g: cellAt(index) }));
const GHOST = cellAt(5);
const PLATE = slab(-0.1, 0.9, 3.0, 1.55, 12, -12);

// Variables that are not part of the array: a cell with the name on its face.
type Variable = { id: string; name: string; value?: string; g: Slab };
const FN_Z = 80;
const variables: Variable[] = [
	{ id: 'v-suma', name: id.suma, g: slab(0.2, 1.25, 0.36, 0.36, CELL_H) },
	{ id: 'v-n', name: 'n', value: '5', g: slab(1.15, 1.25, 0.36, 0.36, CELL_H) },
	{ id: 'v-v', name: 'v', value: '0x1000', g: slab(0.6, -2.6, 0.38, 0.38, CELL_H, FN_Z) },
	{ id: 'v-n2', name: 'n', value: '5', g: slab(1.8, -2.6, 0.38, 0.38, CELL_H, FN_Z) },
	{ id: 'v-mp', name: 'p', value: '0x2000', g: slab(0.6, -2.6, 0.38, 0.38, CELL_H, FN_Z) },
];
const variable = (key: string) => variables.find((item) => item.id === key) ?? variables[0];
const SUMA = variable('v-suma').g;
const N2 = variable('v-n2').g;

// The value shown on top of a cell changes by swapping one text for another.
const shownValues = [
	...[0, 7, 11, 20, 26, 34].map((value) => ({ id: `sv-${value}`, text: String(value), at: SUMA.center })),
	{ id: 'sx-1', text: '1', at: cellAt(1).center },
	{ id: 'sx-4', text: '4', at: cellAt(1).center },
	{ id: 'sx-0', text: '0', at: cellAt(1).center },
	{ id: 'sy-2', text: '2', at: cellAt(2).center },
	{ id: 'sy-1', text: '1', at: cellAt(2).center },
];

// The function called: a raised plate behind memory, with its own variables.
const FN = slab(1.2, -2.6, 1.3, 0.75, 10, FN_Z - 10);
const plates = [
	{ id: 'fn-prom', label: id.promedio },
	{ id: 'fn-mov', label: id.mover },
];

// The struct `a`: two contiguous members, x and y.
const STRUCT = [
	{ name: 'x', address: '0x2000', g: cellAt(1) },
	{ name: 'y', address: '0x2004', g: cellAt(2) },
];
const STRUCT_RING = slab((cellU(1) + cellU(2)) / 2, 0, 0.95, 0.5, CELL_H);

// Modules: one per instruction, in a row in front of memory, labelled with the line.
// The ids carry the program (a, b, c) and the editor line.
const moduleAt = (slot: number) => slab(-2.75 + slot * 0.6, 1.95, 0.2, 0.2, 16);
const rows: [string, Tone][][] = [
	[
		['a4', 'flow'],
		['a5', 'flow'],
		['a7', 'violet'],
		['a8', 'flow'],
		['a10', 'flow'],
	],
	[
		['b13', 'flow'],
		['b14', 'flow'],
		['b16', 'violet'],
		['b4', 'violet'],
		['b7', 'flow'],
		['b9', 'flow'],
	],
	[
		['c18', 'flow'],
		['c19', 'violet'],
		['c9', 'violet'],
		['c10', 'violet'],
		['c20', 'flow'],
		['c21', 'violet'],
		['c22', 'violet'],
		['c23', 'flow'],
	],
];
const modules = rows.flatMap((row) => row.map(([key, tone], slot) => ({ key, line: key.slice(1), tone, g: moduleAt(slot) })));

// Where the particle stops, where pins rest (their tip on a cell) and the camera shots.
const anchors = [
	...modules.map((module) => ({ id: `a-m${module.key}`, ...lift(module.g.center, 16) })),
	...[0, 1, 2, 3, 4, 5].map((index) => ({ id: `a-c${index}`, ...cellAt(index).center })),
	{ id: 'a-sx', ...cellAt(1).center },
];
const at = (key: string) => anchors.find((anchor) => anchor.id === key) ?? { x: 0, y: 0 };

const shots = [
	{ id: 'shot-all', cx: 400, cy: 260, s: 1.0 },
	{ id: 'shot-cells', cx: 372, cy: 225, s: 1.28 },
	{ id: 'shot-walk', cx: 400, cy: 240, s: 1.25 },
	{ id: 'shot-start', cx: 326, cy: 175, s: 1.45 },
	{ id: 'shot-fn', cx: 455, cy: 175, s: 1.0 },
	{ id: 'shot-struct', cx: 440, cy: 200, s: 1.1 },
	{ id: 'shot-end', cx: 540, cy: 320, s: 1.35 },
].map((item) => ({
	id: item.id,
	x: round(item.cx - 640 / item.s),
	y: round(item.cy - 360 / item.s),
	w: round(1280 / item.s),
	h: round(720 / item.s),
}));

// Pointers: one visual identity, a violet pin whose arrow tip rests on the target.
// Placement lives on the inner group: the player resets data-el transforms.
type Pin = { id: string; text: string; stem: number; restAt: string };
const pins: Pin[] = [
	{ id: 'pin-p', text: 'p', stem: 26, restAt: 'a-c0' },
	{ id: 'pin-p1', text: 'p + 1', stem: 62, restAt: 'a-c0' },
	{ id: 'pin-ix', text: `${id.notas} + 2`, stem: 62, restAt: 'a-c0' },
	{ id: 'pin-pa', text: 'pa', stem: 26, restAt: 'a-sx' },
];
const pinWidth = (pin: Pin) => Math.round(pin.text.length * 7.9 + 22);

// Arrows drawn from a pointer variable to the cell it points to.
const V = variable('v-v').g.center;
const C0 = cellAt(0).center;
const SX = cellAt(1).center;
const arrows = [
	{ id: 'ar-v', from: V, to: C0, d: `M${V.x} ${V.y - 10} C${V.x - 50} ${V.y - 90} ${C0.x + 34} ${C0.y - 140} ${C0.x + 1} ${C0.y - 16}` },
	{ id: 'ar-mp', from: V, to: SX, d: `M${V.x} ${V.y - 10} C${V.x - 40} ${V.y - 80} ${SX.x + 30} ${SX.y - 150} ${SX.x + 1} ${SX.y - 16}` },
];

// The bracket that measures one element, and the path the pointer walks.
const edge = (index: number) => pt(cellU(index), 0.75, 0);
const RULE_A = edge(0);
const RULE_B = edge(1);
const RULE_LABEL = pt((cellU(0) + cellU(1)) / 2, 1.02, 0);
const WALK = [0, 1, 2, 3, 4, 5].map((index) => pt(cellU(index), 0.62, 0));

// Floating notes. `x` is the left edge, the right edge or the middle, as `align` says.
type Chip = { id: string; text: string; x: number; y: number; align: 'start' | 'end' | 'middle'; tone: 'plain' | Tone; mono?: boolean };
const GH = GHOST.center;
const chips: Chip[] = [
	{ id: 'ch-sz', text: 'sizeof(int) = 4', x: C0.x - 30, y: C0.y - 70, align: 'end', tone: 'plain', mono: true },
	{ id: 'ch-decay', text: `p = ${id.notas} = &${id.notas}[0]`, x: C0.x, y: C0.y - 112, align: 'middle', tone: 'violet', mono: true },
	{ id: 'ch-p1', text: 'p + 1 = 0x1004', x: cellAt(1).center.x + 48, y: cellAt(1).center.y - 74, align: 'start', tone: 'violet', mono: true },
	{ id: 'ch-ix', text: `${id.notas}[2] == *(${id.notas} + 2) == 9`, x: cellAt(2).center.x + 60, y: cellAt(2).center.y - 74, align: 'start', tone: 'violet', mono: true },
	{ id: 'ch-zero', text: `${id.notas}[0] == *(${id.notas} + 0)`, x: C0.x + 30, y: C0.y - 60, align: 'start', tone: 'violet', mono: true },
	{ id: 'ch-past', text: `${id.notas} + 5`, x: GH.x, y: GH.y + 50, align: 'middle', tone: 'violet', mono: true },
	{ id: 'ch-szn', text: `sizeof ${id.notas} = 20`, x: variable('v-n').g.center.x, y: variable('v-n').g.center.y + 56, align: 'middle', tone: 'flow', mono: true },
	{ id: 'ch-recv', text: `v = &${id.notas}[0] = 0x1000`, x: 447, y: 6, align: 'middle', tone: 'violet', mono: true },
	{ id: 'ch-szv', text: 'sizeof v = 8', x: N2.center.x, y: N2.center.y - 74, align: 'middle', tone: 'magenta', mono: true },
	{ id: 'ch-len', text: 'size_t n = 5', x: N2.center.x, y: N2.center.y + 82, align: 'middle', tone: 'violet', mono: true },
	{ id: 'ch-arrow', text: 'p->x  ==  (*p).x', x: round((SX.x + cellAt(2).center.x) / 2), y: cellAt(2).center.y + 60, align: 'middle', tone: 'violet', mono: true },
	{ id: 'ch-end', text: t(`${id.notas} + 5: se puede calcular y comparar`, `${id.notas} + 5: may be computed and compared`), x: GH.x, y: GH.y + 66, align: 'middle', tone: 'violet' },
	{ id: 'ch-ub', text: t(`*(${id.notas} + 5): comportamiento indefinido`, `*(${id.notas} + 5): undefined behavior`), x: GH.x, y: GH.y + 98, align: 'middle', tone: 'magenta' },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.9) + 24);
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

const LEGEND_Y = VP.y + VP.h - 22;
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="pa-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="pa-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="pa-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="pa-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="pa-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="pa-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: memory, seen through the camera -->
			<g clip-path="url(#pa-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#pa-g-pool-flow)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#pa-g-pool-violet)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						<!-- The memory of main: a floor plate -->
						<g data-el="plate-main">
							<polygon class="xj-plate-shadow" points={PLATE.base} transform="translate(12 18)"></polygon>
							<polygon class="xj-plate xj-plate--l" points={PLATE.leftFace}></polygon>
							<polygon class="xj-plate xj-plate--r" points={PLATE.rightFace}></polygon>
							<polygon class="xj-plate xj-plate--t" points={PLATE.top} fill="url(#pa-g-floor)"></polygon>
							<text class="xj-area-label" transform={PLATE.faceMatrix} text-anchor="middle" y="4">main</text>
						</g>

						<!-- The function being called: a raised plate behind -->
						{
							plates.map((plate) => (
								<g data-el={plate.id}>
									<polygon class="xj-plate-shadow" points={FN.base} transform="translate(12 18)" />
									<polygon class="xj-plate xj-plate--l" points={FN.leftFace} />
									<polygon class="xj-plate xj-plate--r" points={FN.rightFace} />
									<polygon class="xj-plate xj-plate--t" points={FN.top} fill="url(#pa-g-floor)" />
									<text class="xj-area-label" transform={FN.faceMatrix} text-anchor="middle" y="4">
										{plate.label}
									</text>
								</g>
							))
						}

						<!-- The path the pointer walks, along the front of the cells -->
						<g data-el="fl-walk" class="xj-flowline xj-flowline--violet">
							<path class="mg-stroke xj-flowline-halo" pathLength="1" d={`M${poly(WALK).replaceAll(' ', ' L')}`}></path>
							<path class="mg-stroke xj-flowline-core" pathLength="1" d={`M${poly(WALK).replaceAll(' ', ' L')}`}></path>
						</g>

						<!-- One element, measured: from one address to the next -->
						<g data-el="rule" class="xj-rule-mark">
							<path class="mg-stroke" pathLength="1" d={`M${RULE_A.x} ${RULE_A.y} L${RULE_B.x} ${RULE_B.y}`}></path>
							<path d={`M${RULE_A.x} ${RULE_A.y - 7} V${RULE_A.y + 7} M${RULE_B.x} ${RULE_B.y - 7} V${RULE_B.y + 7}`}></path>
						</g>
						<g data-el="ch-4b" class="xj-rule-label">
							<text transform={`matrix(0.866 0.5 0 1 ${RULE_LABEL.x} ${RULE_LABEL.y})`} text-anchor="middle" y="4">+4 bytes</text>
						</g>

						<!-- One past the end: a position that may be computed, never read -->
						<g data-el="ghost" class="xj-ghost">
							<polygon points={GHOST.top}></polygon>
							<polygon points={GHOST.leftFace}></polygon>
							<polygon points={GHOST.rightFace}></polygon>
							<text class="xj-face-text" transform={GHOST.faceMatrix} text-anchor="middle" y="4">0x1014</text>
						</g>
						<g data-el="ghost-x" class="xj-lit xj-lit--magenta">
							<polygon class="xj-lit-halo" points={GHOST.top}></polygon>
							<polygon class="xj-lit-top xj-lit-top--soft" points={GHOST.top}></polygon>
							<path class="xj-cross" d={`M${GH.x - 12} ${GH.y - 8} L${GH.x + 12} ${GH.y + 8} M${GH.x + 12} ${GH.y - 8} L${GH.x - 12} ${GH.y + 8}`}></path>
						</g>

						<!-- The cells of the array: address on the front edge, value on top, index on the side -->
						{
							cells.map((cell) => (
								<>
									<g data-el={`c-${cell.index}`}>
										<polygon class="xj-shadow" points={cell.g.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={cell.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={cell.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={cell.g.top} fill="url(#pa-g-top)" />
										<text class="xj-face-text" transform={cell.g.faceMatrix} text-anchor="middle" y="4">
											{cell.address}
										</text>
										<text class="xj-value" x={cell.g.center.x} y={cell.g.center.y + 6} text-anchor="middle">
											{cell.value}
										</text>
										{cell.index === 0 && (
											<text class="xj-area-label" x={cell.g.left.x - 8} y={cell.g.left.y + 4} text-anchor="end">
												{`${id.notas}[5]`}
											</text>
										)}
									</g>
									<g data-el={`lit-c${cell.index}`} class="xj-lit xj-lit--flow">
										<polygon class="xj-lit-halo" points={cell.g.top} />
										<polygon class="xj-lit-top" points={cell.g.top} />
										<text class="xj-value xj-value--on" x={cell.g.center.x} y={cell.g.center.y + 6} text-anchor="middle">
											{cell.value}
										</text>
									</g>
								</>
							))
						}

						<!-- The struct a: two contiguous members -->
						<g data-el="st-a">
							<polygon class="xj-struct-ring" points={STRUCT_RING.top}></polygon>
							{
								STRUCT.map((member) => (
									<>
										<polygon class="xj-shadow" points={member.g.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={member.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={member.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={member.g.top} fill="url(#pa-g-top)" />
										<text class="xj-face-text" transform={member.g.faceMatrix} text-anchor="middle" y="4">
											{member.address}
										</text>
										<text class="xj-face-text xj-face-text--dim" transform={member.g.sideMatrix} text-anchor="middle" y="4">
											{member.name}
										</text>
									</>
								))
							}
							<text class="xj-area-label" x={SX.x - 56} y={SX.y - 6} text-anchor="end">{`struct ${id.punto} a`}</text>
						</g>
						<g data-el="on-sx" class="xj-lit xj-lit--violet">
							<polygon class="xj-lit-halo" points={cellAt(1).top}></polygon>
							<polygon class="xj-lit-top xj-lit-top--soft" points={cellAt(1).top}></polygon>
						</g>

						<!-- Variables: a cell with the name on its face -->
						{
							variables.map((item) => (
								<g data-el={item.id}>
									<polygon class="xj-shadow" points={item.g.base} transform="translate(6 8)" />
									<polygon class="xj-face xj-face--l" points={item.g.leftFace} />
									<polygon class="xj-face xj-face--r" points={item.g.rightFace} />
									<polygon class="xj-face xj-face--t" points={item.g.top} fill="url(#pa-g-top)" />
									<text class="xj-face-text" transform={item.g.faceMatrix} text-anchor="middle" y="4">
										{item.name}
									</text>
									{item.value && (
										<text class:list={['xj-value', item.value.length > 2 && 'xj-value--addr']} x={item.g.center.x} y={item.g.center.y + 5} text-anchor="middle">
											{item.value}
										</text>
									)}
								</g>
							))
						}
						<g data-el="on-n2" class="xj-lit xj-lit--violet">
							<polygon class="xj-lit-halo" points={N2.top}></polygon>
							<polygon class="xj-lit-top xj-lit-top--soft" points={N2.top}></polygon>
						</g>

						<!-- Values that change: one text per value, swapped by the cues -->
						{
							shownValues.map((item) => (
								<text data-el={item.id} class="xj-value" x={item.at.x} y={item.at.y + 6} text-anchor="middle">
									{item.text}
								</text>
							))
						}

						<!-- Instruction modules: one per instruction, labelled with its editor line -->
						{
							modules.map((module) => (
								<>
									<g data-el={`m-${module.key}`} class="xj-mod">
										<polygon class="xj-shadow" points={module.g.base} transform="translate(6 8)" />
										<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
										<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
										<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#pa-g-top)" />
										<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
									<g data-el={`on-${module.key}`} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
										<polygon class="xj-lit-halo" points={module.g.top} />
										<polygon class="xj-lit-top" points={module.g.top} />
										<polygon class="xj-lit-side" points={module.g.leftFace} />
										<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4.5">
											{module.line}
										</text>
									</g>
								</>
							))
						}

						<!-- Pointer variables that live elsewhere reach their target with an arrow -->
						{
							arrows.map((item) => (
								<g data-el={item.id} class="xj-arrow">
									<path class="mg-stroke" pathLength="1" d={item.d} />
									<polygon class="mg-head" points={`${item.to.x - 6},${item.to.y - 17} ${item.to.x + 7},${item.to.y - 15} ${item.to.x + 1},${item.to.y - 3}`} />
								</g>
							))
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									<text class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'} x={chipLeft(chip) + chipWidth(chip) / 2} y={chip.y + 4.5} text-anchor="middle">
										{chip.text}
									</text>
								</g>
							))
						}

						<!-- Pointers: a pin whose arrow tip rests on the cell it points to -->
						{
							pins.map((pin) => (
								<g data-el={pin.id} data-x={at(pin.restAt).x} data-y={at(pin.restAt).y}>
									<g class="xj-pin">
										<path class="xj-pin-stem" d={`M0 -8 V${-pin.stem}`} />
										<path class="xj-pin-tip" d="M-6 -10 L6 -10 L0 -1 Z" />
										<rect x={-pinWidth(pin) / 2} y={-pin.stem - 24} width={pinWidth(pin)} height="24" rx="12" />
										<text class="xj-chip-mono" x="0" y={-pin.stem - 7.5} text-anchor="middle">
											{pin.text}
										</text>
									</g>
								</g>
							))
						}

						<!-- The execution flow -->
						<g data-el="px" class="xj-particle" data-x={at('a-ma4').x} data-y={at('a-ma4').y}>
							<circle r="20" fill="url(#pa-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="430" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<path class="xj-legend-pin" d={`M${VP.x + 180} ${LEGEND_Y - 7} L${VP.x + 192} ${LEGEND_Y - 7} L${VP.x + 186} ${LEGEND_Y + 5} Z`}></path>
				<text x={VP.x + 200} y={LEGEND_Y + 4}>{t('Puntero', 'Pointer')}</text>
				<rect class="xj-legend-cell" x={VP.x + 282} y={LEGEND_Y - 7} width="20" height="14" rx="4"></rect>
				<text x={VP.x + 310} y={LEGEND_Y + 4}>{t('Celda de memoria', 'Memory cell')}</text>
			</g>

			<!-- EDITOR: the program, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(1)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				<!-- The three programs: the first is typed as the film begins, the others replace it -->
				{
					pages.map((page) => (
						<g data-el={page.el} data-base={page.typed ? 'shown' : undefined} class="xj-code">
							<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>
								{page.file}
							</text>
							{page.lines.map((line) =>
								page.typed ? (
									<g data-el={`${page.el}-${line.n}`}>
										<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
											{line.n}
										</text>
										<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
									</g>
								) : (
									<>
										<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
											{line.n}
										</text>
										<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
									</>
								),
							)}
						</g>
					))
				}

				<!-- Console: what the program prints -->
				{
					outputs.map((row) => (
						<text data-el={row.id} class="xj-out" x={ED.x + 20} y={outY(row.row)} xml:space="preserve">
							{row.text}
						</text>
					))
				}
				{Array.from({ length: MAX_LINES }, (_, index) => <circle data-anchor={`ln-${index + 1}`} cx={BAR_CX} cy={lineMid(index + 1)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow, magenta for the problem (the size lost inside the
	   function, the cell past the end) and violet for pointers and what resolves it.
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='punteros-arreglos-c']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='punteros-arreglos-c'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='punteros-arreglos-c'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='punteros-arreglos-c'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
	}

	.xj-stop-white {
		stop-color: var(--xj-white);
	}

	/* Viewport */
	.xj-view {
		fill: var(--xj-deep);
	}

	.xj-frame {
		fill: none;
		stroke: var(--xj-edge);
		stroke-width: 1.5;
	}

	.xj-legend text,
	.xj-kicker {
		font-family: var(--font-body);
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.08em;
		fill: var(--xj-dim);
	}

	.xj-legend text {
		font-size: 12.5px;
		letter-spacing: 0;
		fill: var(--xj-mist);
	}

	.xj-legend-ground {
		fill: var(--xj-panel);
		fill-opacity: 0.88;
	}

	.xj-legend-flow {
		fill: var(--xj-flow);
	}

	.xj-legend-pin {
		fill: var(--xj-violet);
	}

	.xj-legend-cell {
		fill: var(--xj-steel);
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
	}

	/* Plates, cells and modules */
	.xj-plate {
		stroke: var(--xj-edge);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-plate--l {
		fill: var(--xj-panel);
	}

	.xj-plate--r {
		fill: var(--xj-ink);
	}

	.xj-plate-shadow,
	.xj-shadow {
		fill: var(--xj-ink);
		opacity: 0.5;
	}

	.xj-area-label {
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.03em;
		fill: var(--xj-mist);
	}

	.xj-face {
		stroke: var(--xj-steel-hi);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	.xj-face--l {
		fill: var(--xj-steel);
	}

	.xj-face--r {
		fill: var(--xj-deep);
	}

	.xj-face-text {
		font-family: var(--font-body);
		font-size: 10.5px;
		font-weight: 700;
		fill: var(--xj-mist);
	}

	.xj-face-text--dim {
		fill: var(--xj-dim);
	}

	.xj-face-text--on {
		fill: var(--xj-ink);
	}

	.xj-value {
		font-family: monospace;
		font-size: 16px;
		font-weight: 700;
		fill: var(--xj-white);
	}

	.xj-value--addr {
		font-size: 12px;
		fill: var(--xj-violet-soft);
	}

	.xj-value--on {
		fill: var(--xj-ink);
	}

	.xj-struct-ring {
		fill: none;
		stroke: var(--xj-violet-soft);
		stroke-width: 1.5;
		stroke-dasharray: 5 5;
		stroke-linejoin: round;
	}

	.xj-ghost polygon {
		fill: var(--xj-panel);
		fill-opacity: 0.6;
		stroke: var(--xj-dim);
		stroke-width: 1.5;
		stroke-dasharray: 5 5;
		stroke-linejoin: round;
	}

	.xj-cross {
		fill: none;
		stroke: var(--xj-magenta);
		stroke-width: 4;
		stroke-linecap: round;
	}

	/* Lit states */
	.xj-lit {
		--xj-lit: var(--xj-flow);
		--xj-lit-soft: var(--xj-flow-soft);
	}

	.xj-lit--violet {
		--xj-lit: var(--xj-violet);
		--xj-lit-soft: var(--xj-violet-soft);
	}

	.xj-lit--magenta {
		--xj-lit: var(--xj-magenta);
		--xj-lit-soft: var(--xj-magenta-soft);
	}

	.xj-lit-halo {
		fill: none;
		stroke: var(--xj-lit);
		stroke-width: 12;
		stroke-opacity: 0.22;
		stroke-linejoin: round;
	}

	.xj-lit-top {
		fill: var(--xj-lit);
		fill-opacity: 0.85;
		stroke: var(--xj-lit-soft);
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.xj-lit-top--soft {
		fill-opacity: 0.18;
	}

	.xj-lit-side {
		fill: var(--xj-lit-soft);
		stroke: var(--xj-lit-soft);
		stroke-width: 1.5;
		stroke-linejoin: round;
	}

	/* Paths: the walk, the measured element and the pointer arrows */
	.xj-flowline {
		--xj-line: var(--xj-flow);
	}

	.xj-flowline--violet {
		--xj-line: var(--xj-violet);
	}

	.xj-flowline-halo,
	.xj-flowline-core {
		fill: none;
		stroke: var(--xj-line);
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.xj-flowline-halo {
		stroke-width: 11;
		stroke-opacity: 0.2;
	}

	.xj-flowline-core {
		stroke-width: 3;
	}

	.xj-rule-mark path {
		fill: none;
		stroke: var(--xj-flow);
		stroke-width: 2.5;
		stroke-linecap: round;
	}

	.xj-rule-label text {
		font-family: monospace;
		font-size: 12.5px;
		font-weight: 700;
		fill: var(--xj-flow-soft);
	}

	.xj-arrow path {
		fill: none;
		stroke: var(--xj-violet-soft);
		stroke-width: 2.5;
		stroke-linecap: round;
	}

	.xj-arrow polygon {
		fill: var(--xj-violet-soft);
	}

	/* Pointers */
	.xj-pin rect {
		fill: var(--xj-panel);
		stroke: var(--xj-violet);
		stroke-width: 2;
	}

	.xj-pin-stem {
		fill: none;
		stroke: var(--xj-violet-soft);
		stroke-width: 2.5;
		stroke-linecap: round;
	}

	.xj-pin-tip {
		fill: var(--xj-violet-soft);
	}

	.xj-pin .xj-chip-mono {
		fill: var(--xj-violet-soft);
		font-weight: 700;
	}

	/* Notes */
	.xj-chip {
		--xj-chip: var(--xj-edge);
		--xj-chip-ink: var(--xj-mist);
	}

	.xj-chip--flow {
		--xj-chip: var(--xj-flow);
		--xj-chip-ink: var(--xj-flow-soft);
	}

	.xj-chip--magenta {
		--xj-chip: var(--xj-magenta);
		--xj-chip-ink: var(--xj-magenta-soft);
	}

	.xj-chip--violet {
		--xj-chip: var(--xj-violet);
