	.xj-gutter {
		font-family: monospace;
		font-size: 12px;
		fill: var(--xj-dim);
	}

	.mg-canvas .xj-code :global(.tok-kw) {
		fill: var(--xj-violet-soft);
	}

	.mg-canvas .xj-code :global(.tok-type) {
		fill: var(--xj-white);
	}

	.mg-canvas .xj-code :global(.tok-fn) {
		fill: var(--xj-white);
		font-weight: 400;
	}

	.mg-canvas .xj-code :global(.tok-str),
	.mg-canvas .xj-code :global(.tok-num) {
		fill: var(--xj-flow);
	}

	.mg-canvas .xj-code :global(.tok-cmt) {
		fill: var(--xj-dim);
		font-style: italic;
	}

	.mg-canvas .xj-code :global(.tok-punct),
	.mg-canvas .xj-code :global(.tok-op) {
		fill: var(--xj-dim);
	}

	.xj-hl rect {
		fill: var(--xj-flow);
		fill-opacity: 0.18;
		stroke: var(--xj-flow);
		stroke-opacity: 0.6;
		stroke-width: 1.2;
	}

	.xj-hl path {
		fill: var(--xj-flow);
	}

	.xj-bar--flow {
		fill: none;
		stroke: var(--xj-flow);
		stroke-width: 1.5;
		stroke-dasharray: 6 5;
	}

	.xj-bar--violet {
		fill: var(--xj-violet);
		fill-opacity: 0.24;
		stroke: var(--xj-violet);
		stroke-width: 1.2;
	}
</style>
