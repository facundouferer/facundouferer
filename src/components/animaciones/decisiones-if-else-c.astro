			{ key: '8', line: 8, at: [2.3, 0], kind: 'fork' },
			{ key: '9', line: 9, at: [2.3, -1.0], kind: 'step' },
			{ key: '10', line: 10, at: [3.5, 0], kind: 'fork' },
			{ key: '11', line: 11, at: [3.5, -1.0], kind: 'step' },
			{ key: '13', line: 13, at: [4.7, 0], kind: 'step' },
