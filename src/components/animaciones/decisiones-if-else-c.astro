		],
		rails: [
			['4', '6', '8', '10', '13', '16'],
			['6', '7', 'k7'],
			['8', '9', 'k9'],
			['10', '11', 'k11'],
			['k7', 'kend', '16'],
		],
		runs: [
			{ id: 'run-b-1', via: ['4', '6'] },
			{ id: 'run-b-2', via: ['6', '8'] },
			{ id: 'run-b-3', via: ['8', '10'] },
			{ id: 'run-b-t', via: ['10', '11'] },
			{ id: 'run-b-out', via: ['11', 'k11', 'kend', '16'] },
		],
		cells: [{ id: 'c-b', name: names.grade, at: [0, 1.05], values: [{ id: 'v-b8', text: '8', tone: 'flow' }] }],
	},
	{
		// Nested: the inner fork sits on the true branch of the outer one.
		id: 'c',
		origin: { x: 300, y: 450 },
		tag: t('if anidado', 'nested if'),
		points: { k8: [3.5, -2.2], kj: [3.5, -1.1], kj2: [4.8, -1.1] },
		stations: [
			{ key: '4', line: 4, at: [0, 0], kind: 'step' },
			{ key: '6', line: 6, at: [1.1, 0], kind: 'fork' },
