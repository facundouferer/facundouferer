	},
	{
		// Two bugs on one if: the assignment and the empty statement.
		id: 'd',
		origin: { x: 760, y: 590 },
		tag: '=  ·  ;',
		points: { s: [1.1, -1.0], ks: [2.2, -1.0], m: [2.2, 0] },
		stations: [
			{ key: '4', line: 4, at: [0, 0], kind: 'step' },
			{ key: '6', line: 6, at: [1.1, 0], kind: 'fork', tone: 'magenta' },
			{ key: '8', line: 8, at: [3.2, 0], kind: 'step', tone: 'magenta' },
			{ key: '11', line: 11, at: [4.4, 0], kind: 'step' },
		],
		rails: [
			['4', '6', 'm', '8', '11'],
			['6', 's', 'ks', 'm'],
		],
		runs: [
			{ id: 'run-d-in', via: ['4', '6'] },
			{ id: 'run-d-t', via: ['6', 's'], tone: 'magenta' },
			{ id: 'run-d-t2', via: ['s', 'ks', 'm', '8'], tone: 'magenta' },
			{ id: 'run-d-f', via: ['6', 'm'], tone: 'magenta', dashed: true },
			{ id: 'run-d-end', via: ['8', '11'] },
		],
		cells: [
			{
				id: 'c-d',
				name: names.age,
				at: [0, 1.05],
				values: [
					{ id: 'v-d12', text: '12', tone: 'flow' },
					{ id: 'v-d16', text: '16', tone: 'magenta' },
				],
			},
		],
	},
	{
		// The && guard: two gates in series; the second never runs if the first is false.
		id: 'e',
		origin: { x: 330, y: 760 },
		tag: '&&',
		points: { k8: [5.0, -2.0], kf: [3.0, -1.0], mf: [3.0, 0] },
		stations: [
			{ key: '4', line: 4, at: [0, 0], kind: 'step' },
			{ key: '5', line: 5, at: [0.9, 0], kind: 'step' },
			{ key: '7', line: 7, at: [2.0, 0], kind: 'fork' },
			{ key: '7b', line: 7, at: [2.0, -1.0], kind: 'gate', tone: 'magenta' },
			{ key: '8', line: 8, at: [2.0, -2.0], kind: 'step' },
			{ key: '10', line: 10, at: [3.9, 0], kind: 'step' },
			{ key: '13', line: 13, at: [5.0, 0], kind: 'step' },
		],
		rails: [
			['4', '5', '7', 'mf', '10', '13'],
			['7', '7b', '8', 'k8', '13'],
			['7b', 'kf', 'mf'],
		],
		runs: [
			{ id: 'run-e-1', via: ['4', '5'] },
			{ id: 'run-e-2', via: ['5', '7'] },
			{ id: 'run-e-f', via: ['7', 'mf', '10'] },
			{ id: 'run-e-end', via: ['10', '13'] },
		],
		cells: [
			{ id: 'c-e1', name: 'total', at: [0, 1.05], values: [{ id: 'v-e120', text: '120', tone: 'flow' }] },
			{ id: 'c-e2', name: names.people, at: [0.9, 1.05], values: [{ id: 'v-e0', text: '0', tone: 'flow' }] },
		],
	},
];

const district = (id: PageId) => districts.find((item) => item.id === id) ?? districts[0];
const uvOf = (d: DistrictSpec, key: string): UV => d.stations.find((s) => s.key === key)?.at ?? d.points[key] ?? [0, 0];
const railPoint = (d: DistrictSpec, key: string) => iso(d.origin, ...uvOf(d, key), FLOOR);
const railPath = (d: DistrictSpec, keys: string[]) =>
	keys.map((key, index) => `${index === 0 ? 'M' : 'L'}${railPoint(d, key).x} ${railPoint(d, key).y}`).join(' ');

// Floor plates: a margin around every point of the district.
const plates = districts.map((d) => {
	const all = [...d.stations.map((s) => s.at), ...Object.values(d.points), ...d.cells.map((c) => c.at)];
	const us = all.map(([u]) => u);
	const vs = all.map(([, v]) => v);
	const [u0, u1, v0, v1] = [Math.min(...us) - 0.6, Math.max(...us) + 0.6, Math.min(...vs) - 0.6, Math.max(...vs) + 0.6];
	return { id: d.id, g: slab(d.origin, (u0 + u1) / 2, (v0 + v1) / 2, (u1 - u0) / 2, (v1 - v0) / 2, FLOOR, 0), u0, u1, v0, v1 };
});

// Modules: one per instruction, labelled with its editor line; forks are larger.
type Module = { id: string; line: number; g: Slab; kind: StationKind; tone: Tone };
const modules: Module[] = districts.flatMap((d) =>
	d.stations.map((s) => {
		const size = s.kind === 'step' ? 0.2 : 0.27;
		return {
			id: `${d.id}${s.key}`,
			line: s.line,
			kind: s.kind,
			tone: s.tone ?? (s.kind === 'step' ? 'flow' : 'violet'),
			g: slab(d.origin, s.at[0], s.at[1], size, size, s.kind === 'step' ? 14 : 18, FLOOR),
		};
	}),
);
const SEMI = slab(district('d').origin, 1.1, -1.0, 0.18, 0.18, 10, FLOOR);

// Cells: a variable is a box with its name on the front and its value on top.
const cells = districts.flatMap((d) => d.cells.map((c) => ({ ...c, g: slab(d.origin, c.at[0], c.at[1], 0.36, 0.36, 16, FLOOR) })));

// Where the particle stops: above a module, or on a rail corner.
const anchors = [
	...modules.map((module) => ({ id: `a-${module.id}`, ...lift(module.g.center, 14) })),
	...districts.flatMap((d) => Object.keys(d.points).map((key) => ({ id: `k-${d.id}-${key}`, ...lift(railPoint(d, key), 12) }))),
	{ id: 'a-ds', ...lift(SEMI.center, 14) },
];
const at = (id: string) => anchors.find((anchor) => anchor.id === id) ?? { x: 0, y: 0 };
const mod = (id: string) => modules.find((module) => module.id === id) ?? modules[0];

// Camera shots: a rectangle the size of the canvas at zoom `s`, centered on a point.
const shotRect = (id: string, cx: number, cy: number, s: number) => ({
	id,
	x: round(cx - 640 / s),
	y: round(cy - 360 / s),
	w: round(1280 / s),
	h: round(720 / s),
});
const plateBox = (id: PageId) => {
	const p = plates.find((item) => item.id === id) ?? plates[0];
	const d = district(id);
	const corners = [iso(d.origin, p.u0, p.v0), iso(d.origin, p.u1, p.v0), iso(d.origin, p.u1, p.v1), iso(d.origin, p.u0, p.v1)];
	const xs = corners.map((c) => c.x);
	const ys = corners.map((c) => c.y);
	return { x0: Math.min(...xs), x1: Math.max(...xs), y0: Math.min(...ys) - 60, y1: Math.max(...ys) + 20 };
};
const fitShot = (id: string, boxes: ReturnType<typeof plateBox>[], max = 1.6) => {
	const x0 = Math.min(...boxes.map((b) => b.x0));
	const x1 = Math.max(...boxes.map((b) => b.x1));
	const y0 = Math.min(...boxes.map((b) => b.y0));
	const y1 = Math.max(...boxes.map((b) => b.y1));
	const s = Math.round(Math.min(max, (VP.w - 40) / (x1 - x0), (VP.h - 60) / (y1 - y0)) * 100) / 100;
	return shotRect(id, (x0 + x1) / 2, (y0 + y1) / 2, s);
};
const focus = (id: string, point: Point, s: number) => shotRect(id, point.x, point.y, s);
const shots = [
	fitShot('shot-a', [plateBox('a')]),
	fitShot('shot-b', [plateBox('b')]),
	fitShot('shot-c', [plateBox('c')]),
	fitShot('shot-d', [plateBox('d')]),
	fitShot('shot-e', [plateBox('e')]),
	focus('shot-a-fork', mod('a6').g.center, 2.1),
	focus('shot-c-in', mod('c7').g.center, 1.9),
	focus('shot-d-fork', { x: (mod('d6').g.center.x + mod('d8').g.center.x) / 2, y: mod('d6').g.center.y }, 1.9),
	focus('shot-e-gate', { x: mod('e7').g.center.x, y: mod('e7b').g.center.y }, 1.9),
	fitShot(
		'shot-all',
		districts.map((d) => plateBox(d.id)),
		1,
	),
];

// The nested if's own platform: a dashed ring around the inner fork and its branches.
const NEST = (() => {
	const o = district('c').origin;
	return poly([iso(o, 0.6, -2.7, FLOOR), iso(o, 3.9, -2.7, FLOOR), iso(o, 3.9, -0.6, FLOOR), iso(o, 0.6, -0.6, FLOOR)]);
})();

// The assignment writes back into the variable: a route from the fork to the cell.
const ASSIGN = (() => {
	const from = mod('d6').g.center;
	const cell = cells.find((c) => c.id === 'c-d')?.g.center ?? from;
	return `M${from.x - 10} ${from.y + 8} Q${(from.x + cell.x) / 2 - 10} ${from.y + 60} ${cell.x + 20} ${cell.y - 6}`;
})();

// Floating notes, placed relative to a module or an anchor point.
type Chip = {
	id: string;
	text: string;
	x: number;
	y: number;
	align: 'start' | 'end' | 'middle';
	tone: 'plain' | Tone;
	mono?: boolean;
	icon?: 'x' | 'lock' | 'check';
};
const below = (d: PageId, u: number, v: number) => iso(district(d).origin, u, v, FLOOR);
const top = (id: string) => mod(id).g.center;
const falseText = t('0 → falso', '0 → false');
const trueText = t('1 → verdadero', '1 → true');
const chips: Chip[] = [
	// if-else
	{ id: 'q-a6', text: `${names.number} % 2 == 0`, x: top('a6').x, y: top('a6').y - 62, align: 'middle', tone: 'violet', mono: true },
	{ id: 'r-a6', text: falseText, x: top('a6').x, y: top('a6').y - 34, align: 'middle', tone: 'violet', mono: true },
	{ id: 'skip-a7', text: t('se salta', 'skipped'), x: top('a7').x + 18, y: top('a7').y - 30, align: 'start', tone: 'plain', icon: 'x' },
	// else-if chain
	{ id: 'r-b6', text: falseText, x: below('b', 1.1, 0.9).x, y: below('b', 1.1, 0.9).y, align: 'middle', tone: 'violet', mono: true },
	{ id: 'r-b8', text: falseText, x: below('b', 2.3, 0.9).x, y: below('b', 2.3, 0.9).y, align: 'middle', tone: 'violet', mono: true },
	{ id: 'r-b10', text: trueText, x: below('b', 3.5, 0.9).x, y: below('b', 3.5, 0.9).y, align: 'middle', tone: 'violet', mono: true },
	{ id: 'skip-b13', text: t('no se evalúa', 'not evaluated'), x: top('b13').x, y: top('b13').y - 30, align: 'middle', tone: 'plain', icon: 'x' },
	// nested
	{ id: 'lb-nest', text: t('if interno', 'inner if'), x: below('c', 3.9, -2.7).x, y: below('c', 3.9, -2.7).y - 16, align: 'middle', tone: 'violet', mono: true },
	{ id: 'r-c6', text: trueText, x: below('c', 1.1, 0.9).x, y: below('c', 1.1, 0.9).y, align: 'middle', tone: 'violet', mono: true },
	{ id: 'r-c7', text: trueText, x: top('c7').x - 30, y: top('c7').y + 4, align: 'end', tone: 'violet', mono: true },
	{ id: 'skip-c13', text: t('no se ejecuta', 'does not run'), x: top('c13').x, y: top('c13').y - 30, align: 'middle', tone: 'plain', icon: 'x' },
	// bugs
	{ id: 'q-d6', text: `${names.age} = 16`, x: below('d', 1.1, 0.95).x + 20, y: below('d', 1.1, 0.95).y, align: 'start', tone: 'magenta', mono: true },
	{ id: 'r-d6', text: t('16 → siempre verdadero', '16 → always true'), x: below('d', 1.1, 0.95).x + 20, y: below('d', 1.1, 0.95).y + 30, align: 'start', tone: 'magenta', mono: true, icon: 'lock' },
	{ id: 'lb-d-empty', text: t('sentencia vacía', 'empty statement'), x: top('d6').x + 10, y: SEMI.center.y - 36, align: 'end', tone: 'magenta' },
	{ id: 'lb-d-always', text: t('se ejecuta siempre', 'always runs'), x: top('d8').x, y: top('d8').y - 32, align: 'middle', tone: 'magenta' },
	{ id: 'fix-d', text: `if (${names.age} >= 16)`, x: top('d11').x, y: below('d', 4.4, 0.9).y + 6, align: 'middle', tone: 'violet', mono: true, icon: 'check' },
	// guard
	{ id: 'q-e7', text: `${names.people} != 0`, x: below('e', 2.0, 0.95).x + 24, y: below('e', 2.0, 0.95).y, align: 'start', tone: 'violet', mono: true },
	{ id: 'r-e7', text: falseText, x: below('e', 2.0, 0.95).x + 24, y: below('e', 2.0, 0.95).y + 30, align: 'start', tone: 'violet', mono: true },
	{ id: 'hz-e', text: `total / ${names.people}`, x: top('e7b').x - 30, y: top('e7b').y - 8, align: 'end', tone: 'magenta', mono: true },
	{ id: 'skip-e', text: t('no se evalúa', 'not evaluated'), x: top('e7b').x - 30, y: top('e7b').y + 22, align: 'end', tone: 'plain', icon: 'x' },
	// the whole map
	{ id: 'lb-wall', text: '-Wall -Wextra', x: top('d11').x, y: below('d', 4.4, 0.9).y + 36, align: 'middle', tone: 'violet', mono: true },
];
const chipWidth = (chip: Chip) => Math.round(chip.text.length * (chip.mono ? 7.9 : 6.7) + (chip.icon ? 42 : 24));
const chipLeft = (chip: Chip) =>
	chip.align === 'end' ? chip.x - chipWidth(chip) : chip.align === 'middle' ? chip.x - chipWidth(chip) / 2 : chip.x;

// District tags, revealed when the camera pulls back over the whole map.
const tags = districts.map((d) => {
	const p = plates.find((item) => item.id === d.id) ?? plates[0];
	const corner = iso(d.origin, p.u0, p.v1, 0);
	return { id: `tag-${d.id}`, text: d.tag, x: corner.x, y: corner.y + 30 };
});

const LEGEND_Y = VP.y + VP.h - 22;
const START = at('a-a4');
---

<AnimationPlayer lang={lang} slug={animation.slug} title={animation.title[lang]} steps={resolved.steps}>
	<div slot="scene" data-scene="journey" data-motion class="scene-canvas">
		<svg class="mg-canvas xj-canvas" viewBox="0 0 1280 720" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
			<defs>
				<clipPath id="ie-clip-view">
					<rect x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
				</clipPath>
				<linearGradient id="ie-g-top" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-steel-hi"></stop>
					<stop offset="1" class="xj-stop-steel"></stop>
				</linearGradient>
				<linearGradient id="ie-g-floor" x1="0" y1="0" x2="1" y2="1">
					<stop offset="0" class="xj-stop-deep-hi"></stop>
					<stop offset="1" class="xj-stop-panel"></stop>
				</linearGradient>
				<radialGradient id="ie-g-pool-flow">
					<stop offset="0" class="xj-stop-flow" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="ie-g-pool-violet">
					<stop offset="0" class="xj-stop-violet" stop-opacity="0.2"></stop>
					<stop offset="1" class="xj-stop-violet" stop-opacity="0"></stop>
				</radialGradient>
				<radialGradient id="ie-g-particle">
					<stop offset="0" class="xj-stop-white"></stop>
					<stop offset="0.28" class="xj-stop-flow"></stop>
					<stop offset="1" class="xj-stop-flow" stop-opacity="0"></stop>
				</radialGradient>
			</defs>

			<!-- VIEWPORT: one district of track per program, seen through the camera -->
			<g clip-path="url(#ie-clip-view)">
				<rect class="xj-view" x={VP.x} y={VP.y} width={VP.w} height={VP.h}></rect>
				<ellipse cx={VP.x + VP.w - 120} cy={VP.y + 120} rx="420" ry="320" fill="url(#ie-g-pool-violet)"></ellipse>
				<ellipse cx={VP.x + 80} cy={VP.y + VP.h - 40} rx="400" ry="300" fill="url(#ie-g-pool-flow)"></ellipse>

				<g transform={`translate(${VIEW_SHIFT} 0)`}>
					<g class="mg-camera" data-camera>
						{
							districts.map((d) => {
								const plate = plates.find((item) => item.id === d.id) ?? plates[0];
								return (
									<g data-el={`dist-${d.id}`}>
										<polygon class="xj-plate-shadow" points={plate.g.base} transform="translate(12 18)" />
										<polygon class="xj-plate xj-plate--l" points={plate.g.leftFace} />
										<polygon class="xj-plate xj-plate--r" points={plate.g.rightFace} />
										<polygon class="xj-plate xj-plate--t" points={plate.g.top} fill="url(#ie-g-floor)" />

										{d.id === 'c' && (
											<g data-el="nest-c" class="xj-zone">
												<polygon points={NEST} />
											</g>
										)}

										{/* The track: every path the program could take */}
										{d.rails.map((rail) => (
											<g class="xj-rail">
												<path class="xj-rail-bed" d={railPath(d, rail)} />
												<path class="xj-rail-line" d={railPath(d, rail)} />
											</g>
										))}

										{/* The route actually taken lights up behind the particle */}
										{d.runs.map((run) => (
											<g data-el={run.id} class:list={['xj-run', `xj-run--${run.tone ?? 'flow'}`, { 'xj-run--dashed': run.dashed }]}>
												<path class="mg-stroke xj-run-halo" pathLength="1" d={railPath(d, run.via)} />
												<path class="mg-stroke xj-run-core" pathLength="1" d={railPath(d, run.via)} />
											</g>
										))}

										{d.id === 'd' && (
											<>
												<polygon class="xj-slot" points={SEMI.top} />
												<g data-el="fl-d-assign" class="xj-assign">
													<path class="mg-stroke" pathLength="1" d={ASSIGN} />
												</g>
											</>
										)}

										{modules
											.filter((module) => module.id.startsWith(d.id))
											.map((module) => (
												<>
													<g data-el={`m-${module.id}`} data-base="shown" class:list={['xj-mod', `xj-mod--${module.kind}`, `xj-mod--${module.tone}`]}>
														<polygon class="xj-shadow" points={module.g.base} transform="translate(5 7)" />
														<polygon class="xj-face xj-face--l" points={module.g.leftFace} />
														<polygon class="xj-face xj-face--r" points={module.g.rightFace} />
														<polygon class="xj-face xj-face--t" points={module.g.top} fill="url(#ie-g-top)" />
														<text class="xj-face-text" transform={module.g.faceMatrix} text-anchor="middle" y="4">
															{module.line}
														</text>
													</g>
													<g data-el={`on-${module.id}`} class:list={['xj-lit', `xj-lit--${module.tone}`]}>
														<polygon class="xj-lit-halo" points={module.g.top} />
														<polygon class="xj-lit-top" points={module.g.top} />
														<polygon class="xj-lit-side" points={module.g.leftFace} />
														<text class="xj-face-text xj-face-text--on" transform={module.g.faceMatrix} text-anchor="middle" y="4">
															{module.line}
														</text>
													</g>
												</>
											))}

										{d.id === 'd' && (
											<g data-el="semi-d" class="xj-semi">
												<polygon class="xj-shadow" points={SEMI.base} transform="translate(4 5)" />
												<polygon class="xj-face xj-face--l" points={SEMI.leftFace} />
												<polygon class="xj-face xj-face--r" points={SEMI.rightFace} />
												<polygon class="xj-face xj-face--t" points={SEMI.top} />
												<text class="xj-semi-text" x={SEMI.center.x} y={SEMI.center.y + 5} text-anchor="middle">
													;
												</text>
											</g>
										)}

										{cells
											.filter((c) => c.id.startsWith(`c-${d.id}`))
											.map((c) => (
												<g data-el={c.id} data-base="shown">
													<polygon class="xj-shadow" points={c.g.base} transform="translate(5 7)" />
													<polygon class="xj-cell xj-cell--l" points={c.g.leftFace} />
													<polygon class="xj-cell xj-cell--r" points={c.g.rightFace} />
													<polygon class="xj-cell xj-cell--t" points={c.g.top} />
													<text class="xj-cell-name" transform={c.g.faceMatrix} text-anchor="middle" y="4">
														{c.name}
													</text>
													{c.values.map((value) => (
														<text data-el={value.id} class:list={['xj-value', `xj-value--${value.tone}`]} x={c.g.center.x} y={c.g.center.y + 6} text-anchor="middle">
															{value.text}
														</text>
													))}
												</g>
											))}
									</g>
								);
							})
						}

						{
							chips.map((chip) => (
								<g data-el={chip.id} class:list={['xj-chip', `xj-chip--${chip.tone}`]}>
									<rect x={chipLeft(chip)} y={chip.y - 12} width={chipWidth(chip)} height="24" rx="12" />
									{chip.icon === 'x' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M18 6 6 18" />
											<path d="m6 6 12 12" />
										</svg>
									)}
									{chip.icon === 'lock' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
											<path d="M7 11V7a5 5 0 0 1 10 0v4" />
										</svg>
									)}
									{chip.icon === 'check' && (
										<svg class="xj-icon" x={chipLeft(chip) + 10} y={chip.y - 8} width="16" height="16" viewBox="0 0 24 24" stroke-width="2.75">
											<path d="M20 6 9 17l-5-5" />
										</svg>
									)}
									<text
										class={chip.mono ? 'xj-chip-mono' : 'xj-chip-text'}
										x={chipLeft(chip) + chipWidth(chip) / 2 + (chip.icon ? 9 : 0)}
										y={chip.y + 4.5}
										text-anchor="middle"
									>
										{chip.text}
									</text>
								</g>
							))
						}

						{
							tags.map((tag) => (
								<g data-el={tag.id} class="xj-tag">
									<text x={tag.x} y={tag.y} text-anchor="middle">
										{tag.text}
									</text>
								</g>
							))
						}

						<!-- The execution flow. Placement lives in data-x/data-y: the player resets data-el transforms. -->
						<g data-el="p" class="xj-particle" data-x={START.x} data-y={START.y}>
							<circle r="20" fill="url(#ie-g-particle)"></circle>
							<circle class="xj-particle-core" r="4.5"></circle>
						</g>

						{anchors.map((anchor) => <circle data-anchor={anchor.id} cx={anchor.x} cy={anchor.y} r="1" fill="none" />)}
						{shots.map((item) => <rect data-anchor={item.id} x={item.x} y={item.y} width={item.w} height={item.h} fill="none" />)}
					</g>
				</g>
			</g>
			<rect class="xj-frame" x={VP.x} y={VP.y} width={VP.w} height={VP.h} rx="18"></rect>
			<g class="xj-legend">
				<rect class="xj-legend-ground" x={VP.x + 10} y={LEGEND_Y - 14} width="420" height="28" rx="14"></rect>
				<circle class="xj-legend-flow" cx={VP.x + 26} cy={LEGEND_Y} r="5"></circle>
				<text x={VP.x + 38} y={LEGEND_Y + 4}>{t('Flujo de ejecución', 'Execution flow')}</text>
				<rect class="xj-legend-fork" x={VP.x + 176} y={LEGEND_Y - 6} width="12" height="12" rx="3"></rect>
				<text x={VP.x + 196} y={LEGEND_Y + 4}>{t('Bifurcación', 'Fork')}</text>
				<rect class="xj-legend-bug" x={VP.x + 300} y={LEGEND_Y - 6} width="12" height="12" rx="3"></rect>
				<text x={VP.x + 320} y={LEGEND_Y + 4}>{t('Error', 'Bug')}</text>
			</g>

			<!-- EDITOR: the lesson's programs, one page at a time, with the running line highlighted -->
			<g class="xj-editor">
				<rect class="xj-panel" x={ED.x} y={ED.y} width={ED.w} height={ED.h} rx="18"></rect>
				<path class="xj-rule" d={`M${ED.x} ${ED.y + 40} H${ED.x + ED.w}`}></path>
				<circle class="xj-dot" cx={ED.x + 22} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 38} cy={ED.y + 20} r="4.5"></circle>
				<circle class="xj-dot" cx={ED.x + 54} cy={ED.y + 20} r="4.5"></circle>
				<path class="xj-rule" d={`M${ED.x} ${CONSOLE_TOP} H${ED.x + ED.w}`}></path>
				<text class="xj-kicker" x={ED.x + 20} y={CONSOLE_TOP + 22}>{t('SALIDA', 'OUTPUT')}</text>

				<!-- The failing line of the buggy program -->
				<g data-el="hx-d6" class="xj-hx">
					<rect x={BAR.x} y={lineTop(6)} width={BAR.w} height={LINE_H} rx="6"></rect>
				</g>

				<g data-el="hl" class="xj-hl" data-x={BAR_CX} data-y={lineMid(4)}>
					<rect x={-BAR.w / 2} y={-LINE_H / 2} width={BAR.w} height={LINE_H} rx="6"></rect>
					<path d={`M${-BAR.w / 2 + 5} -5 l7 5 l-7 5 z`}></path>
				</g>

				{
					pages.map((page) => (
						<g data-el={`pg-${page.id}`} data-base={page.id === 'a' ? 'shown' : undefined} class="xj-code">
							<text class="xj-file" x={ED.x + 76} y={ED.y + 25}>
								{page.file}
							</text>
							{page.lines.map((line) => (
								<>
									<text class="xj-gutter" x={GUTTER_X} y={lineBase(line.n)} text-anchor="end">
										{line.n}
									</text>
									<text class="xj-mono" x={CODE_X} y={lineBase(line.n)} xml:space="preserve" set:html={line.html} />
								</>
							))}
						</g>
					))
				}

				<!-- Console: the real output, typed as each line runs -->
				{
					consoleRows.map((row) => (
						<text data-el={row.id} class:list={['xj-out', `xj-out--${row.kind}`]} x={ED.x + 20} y={outY(row.row)} xml:space="preserve">
							{row.text}
						</text>
					))
				}
				{Array.from({ length: MAX_LINES }, (_, index) => index + 1).map((n) => <circle data-anchor={`ln-${n}`} cx={BAR_CX} cy={lineMid(n)} r="1" fill="none" />)}
			</g>
		</svg>
	</div>
</AnimationPlayer>

<style>
	@import '../../styles/animation-scene.css';

	/* Palette of this animation only (DESIGN.md §8): a deep blue ground, a light
	   blue execution flow, violet for the forks that decide, and magenta for the
	   bugs: the assignment, the empty statement and the guarded division.
	   Every rule below reads these tokens; no other color is written in this file. */
	:global(.anim-player[data-slug='decisiones-if-else-c']) {
		--xj-ink: #000d1a;
		--xj-panel: #011627;
		--xj-deep: #00203a;
		--xj-deep-hi: #063356;
		--xj-edge: #124568;
		--xj-steel: #0e3c60;
		--xj-steel-hi: #1c6394;
		--xj-flow: #5fd4ff;
		--xj-flow-soft: #bdeeff;
		--xj-magenta: #f7038a;
		--xj-magenta-soft: #ff8fcb;
		--xj-magenta-deep: #7d0447;
		--xj-violet: #8b5cf6;
		--xj-violet-soft: #c9b8ff;
		--xj-violet-deep: #35257a;
		--xj-white: #ffffff;
		--xj-mist: #b4c9db;
		--xj-dim: #6787a1;
	}

	/* The stage becomes the screen of the film; captions over it turn light. */
	:global(.anim-player[data-slug='decisiones-if-else-c'] .anim-stage.card) {
		background: var(--xj-ink);
		border-color: var(--xj-edge);
	}

	@media (width >= 900px) {
		:global(.anim-player[data-slug='decisiones-if-else-c'] .anim-subtitle) {
			color: var(--xj-white);
		}

		:global(.anim-player[data-slug='decisiones-if-else-c'] .anim-subtitle code) {
			background: color-mix(in srgb, var(--xj-flow) 18%, transparent);
			color: var(--xj-flow-soft);
		}
	}

	/* Gradient stops */
	.xj-stop-steel {
		stop-color: var(--xj-steel);
	}

	.xj-stop-steel-hi {
		stop-color: var(--xj-steel-hi);
	}

	.xj-stop-deep-hi {
		stop-color: var(--xj-deep-hi);
	}

	.xj-stop-panel {
		stop-color: var(--xj-panel);
	}

	.xj-stop-flow {
		stop-color: var(--xj-flow);
	}

	.xj-stop-violet {
		stop-color: var(--xj-violet);
